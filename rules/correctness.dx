# rules:correctness: code that is almost certainly wrong. Turns on every
# such rule of the imported languages, at its defaults; rules of languages
# not imported are skipped. `rule name off` after the import takes one back.

rule es-constructor-super
rule es-for-direction
rule es-no-async-promise-executor
rule es-no-compare-neg-zero
rule es-no-cond-assign
rule es-no-constant-condition*
rule es-no-control-regex
rule es-no-debugger
rule es-no-dupe-else-if
rule es-no-duplicate-case
rule es-no-empty-character-class
rule es-no-empty-pattern*
rule es-no-ex-assign
rule es-no-fallthrough
rule es-no-invalid-regexp
rule es-no-irregular-whitespace
rule es-no-loss-of-precision
rule es-no-misleading-character-class*
rule es-no-self-assign
rule es-no-sparse-arrays
rule es-no-unexpected-multiline*
rule es-no-unsafe-finally*
rule es-no-unsafe-optional-chaining*
rule es-no-unused-private-class-members
rule es-no-unused-vars*
rule es-no-useless-assignment
rule es-no-useless-backreference*
rule es-use-isnan
rule es-valid-typeof
