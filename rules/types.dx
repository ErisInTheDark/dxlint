# rules:types: rules that read declared types (dxlint's own type evaluator:
# no TypeScript needed). Turns on every such rule of the imported languages,
# at its defaults.

rule es-await-thenable*
rule es-no-deprecated
rule es-no-floating-promises
rule es-no-for-in-array
rule es-no-misused-promises
rule es-no-unnecessary-boolean-literal-compare
rule es-no-unnecessary-template-expression
rule es-no-unnecessary-type-arguments
rule es-no-unsafe-unary-minus
rule es-unbound-method
rule es-prefer-find*
rule es-prefer-includes
rule es-prefer-optional-chain
rule es-prefer-readonly*
rule es-prefer-string-starts-ends-with*
rule es-restrict-plus-operands*
rule es-restrict-template-expressions
