# rules:format: layout and spacing, as eslint's and @stylistic's defaults
# lay code out (and topiary's for Rust). Turns on every such rule of the
# imported languages; rules whose port cannot follow the upstream default
# yet are left out (comma-dangle, object-curly-spacing, arrow-parens,
# dot-location, quote-props, operator-linebreak, one-var,
# generator-star-spacing, lines-between-class-members,
# padding-line-between-statements).

rule es-array-bracket-spacing
rule es-arrow-spacing*
rule es-block-spacing*
rule es-brace-style* {
  set style "1tbs"
}
rule es-check-alignment*
rule es-comma-spacing*
rule es-comma-style
rule es-computed-property-spacing
rule shared-eol-last
rule es-key-spacing
rule es-keyword-spacing*
rule es-member-delimiter-style* {
  set delimiter "semi"
}
rule es-new-parens
rule es-no-floating-decimal*
rule es-no-mixed-operators*
rule es-no-multi-spaces
rule es-no-multiple-empty-lines
rule es-no-whitespace-before-property
rule es-padded-blocks:always-top
rule es-padded-blocks:always-bottom
rule es-quotes* {
  set style "double"
}
rule es-rest-spread-spacing
rule es-semi
rule es-semi-spacing*
rule es-space-before-blocks
rule es-space-before-function-paren*
rule es-space-in-parens
rule es-space-infix-ops
rule es-spaced-comment*
rule es-template-curly-spacing
rule es-template-tag-spacing
rule es-type-annotation-spacing
rule es-yield-star-spacing

rule rs-*
