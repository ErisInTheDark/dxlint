# rules:bugs: code that is wrong: it throws, never runs, or cannot do what it
# says. On as errors. Part of rules:recommended; no rule is in two rulesets.

rule es-await-thenable* error
rule es-constructor-super error
rule es-for-direction error
rule es-getter-return error
rule es-no-array-delete error
rule es-no-async-promise-executor error
rule es-no-base-to-string error
rule es-no-class-assign error
rule es-no-compare-neg-zero error
rule es-no-const-assign error
rule es-no-constant-binary-expression error
rule es-no-dupe-args error
rule es-no-dupe-class-members error
rule es-no-dupe-else-if error
rule es-no-dupe-keys error
rule es-no-duplicate-case error
rule es-no-duplicate-enum-values error
rule es-no-empty-character-class error
rule es-no-ex-assign error
rule es-no-floating-promises error
rule es-no-for-in-array error
rule es-no-func-assign error
rule es-no-import-assign error
rule es-no-invalid-regexp error
rule es-no-loss-of-precision error
rule es-no-misleading-character-class* error
rule es-no-misused-promises error
rule es-no-new-native-nonconstructor error
rule es-no-non-null-asserted-optional-chain error
rule es-no-obj-calls error
rule es-no-redeclare error
rule es-no-self-assign error
rule es-no-setter-return error
rule es-no-sparse-arrays error
rule es-no-this-before-super error
rule es-no-unassigned-vars error
rule es-no-undef error
rule es-no-unexpected-multiline* error
rule es-no-unreachable error
rule es-no-unsafe-declaration-merging error
rule es-no-unsafe-finally* error
rule es-no-unsafe-negation error
rule es-no-unsafe-optional-chaining* error
rule es-unbound-method error
rule es-use-isnan error
rule es-valid-typeof error
