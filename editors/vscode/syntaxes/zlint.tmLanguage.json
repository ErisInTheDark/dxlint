{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "zlint",
  "scopeName": "source.zlint",
  "patterns": [
    { "include": "#comment" },
    { "include": "#definitions" },
    { "include": "#expression" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.zlint"
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(match)\\s+([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "keyword.other.zlint" }, "2": { "name": "entity.name.function.zlint" } }
        },
        {
          "match": "\\b(rule)\\s+([A-Za-z_][\\w:-]*)",
          "captures": { "1": { "name": "keyword.other.zlint" }, "2": { "name": "entity.name.type.zlint" } }
        },
        {
          "match": "\\b(group)\\s+([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "keyword.other.zlint" }, "2": { "name": "entity.name.namespace.zlint" } }
        },
        {
          "match": "\\b(lang)\\s+([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "keyword.other.zlint" }, "2": { "name": "entity.name.namespace.zlint" } }
        },
        {
          "match": "\\b(macro)\\s+([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "keyword.other.zlint" }, "2": { "name": "entity.name.function.macro.zlint" } }
        },
        {
          "match": "\\b(set)\\s+([\\w*:-]+)(?:(\\.)([A-Za-z_]\\w*))?",
          "captures": {
            "1": { "name": "keyword.other.zlint" },
            "2": { "name": "entity.name.type.zlint" },
            "3": { "name": "punctuation.accessor.zlint" },
            "4": { "name": "variable.other.property.zlint" }
          }
        },
        {
          "match": "\\b(let)\\s+([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "keyword.other.zlint" }, "2": { "name": "variable.other.property.zlint" } }
        },
        {
          "match": "\\b(option)\\s+([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "keyword.other.zlint" }, "2": { "name": "variable.parameter.zlint" } }
        }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#block-string" },
        { "include": "#string" },
        { "include": "#sstring" },
        { "include": "#regex" },
        {
          "match": "\\b(import|macro|lang|group|match|in|over|rule|indent|like|set|ignore|option|when|fix|files|report|let|native)\\b",
          "name": "keyword.other.zlint"
        },
        { "match": "\\b(until|or)\\b", "name": "keyword.operator.word.zlint" },
        { "match": "\\b(if|then|else|as)\\b", "name": "keyword.control.zlint" },
        { "match": "\\b(true|false|null)\\b", "name": "constant.language.zlint" },
        { "match": "\\b(off|hint|info|warn|error)\\b", "name": "support.constant.severity.zlint" },
        { "match": "\\.(?:[A-Za-z_]\\w*|\\*)", "name": "entity.name.namespace.zlint" },
        { "match": "\\b([A-Za-z_]\\w*)(:)(?!\\s)", "captures": { "1": { "name": "variable.parameter.label.zlint" }, "2": { "name": "punctuation.separator.label.zlint" } } },
        { "match": "(:)([A-Za-z_]\\w*)", "captures": { "1": { "name": "punctuation.separator.label.zlint" }, "2": { "name": "variable.parameter.label.zlint" } } },
        { "match": "\\b([A-Za-z_]\\w*)(?=\\()", "name": "support.function.zlint" },
        { "match": "\\b\\d+(?:\\.\\d+)?\\b", "name": "constant.numeric.zlint" },
        { "match": "==|!=|<=|>=|&&|\\|\\||[<>!~+\\-%*]", "name": "keyword.operator.zlint" }
      ]
    },
    "block-string": {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.zlint",
      "patterns": [
        { "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.|$)", "name": "constant.character.escape.zlint" },
        { "match": "\\{\\{|\\}\\}", "name": "constant.character.escape.zlint" },
        { "include": "#hole" }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.zlint",
      "patterns": [
        { "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)", "name": "constant.character.escape.zlint" },
        { "match": "\\{\\{|\\}\\}", "name": "constant.character.escape.zlint" },
        { "include": "#hole" }
      ]
    },
    "sstring": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.zlint",
      "patterns": [
        { "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)", "name": "constant.character.escape.zlint" },
        { "include": "#hole" }
      ]
    },
    "hole": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.zlint" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.zlint" } },
      "contentName": "meta.embedded.expression.zlint",
      "patterns": [{ "include": "#expression" }]
    },
    "regex": {
      "begin": "/",
      "end": "/|$",
      "name": "string.regexp.zlint",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.regexp.zlint" },
        {
          "begin": "\\[",
          "end": "\\]",
          "name": "constant.other.character-class.set.regexp.zlint",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.regexp.zlint" }]
        },
        { "match": "\\(\\?(?::|<[A-Za-z_]\\w*>|i\\))", "name": "punctuation.definition.group.regexp.zlint" },
        { "match": "[*+?]\\??|\\{\\d+(?:,\\d*)?\\}\\??", "name": "keyword.operator.quantifier.regexp.zlint" },
        { "match": "[\\^$|()]", "name": "keyword.control.regexp.zlint" }
      ]
    }
  }
}
