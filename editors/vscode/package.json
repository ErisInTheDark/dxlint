{
  "name": "dxlint",
  "displayName": "dxlint",
  "description": "let you and your agents own your linter",
  "version": "0.1.2",
  "publisher": "ErisInTheDark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErisInTheDark/dxlint.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "lint",
    "eslint",
    "typescript",
    "dx"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/.dx",
    "onLanguage:dx"
  ],
  "scripts": {
    "test": "node --test extension.test.js",
    "package": "vsce package --out dxlint.vsix"
  },
  "contributes": {
    "languages": [
      {
        "id": "dx",
        "aliases": [
          "dx",
          "dxlint config"
        ],
        "extensions": [
          ".dx"
        ],
        "filenames": [
          ".dx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dx",
        "scopeName": "source.dx",
        "path": "./syntaxes/dx.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "dxlint",
      "properties": {
        "dxlint.path": {
          "type": "string",
          "default": "",
          "description": "Path to the dxlint binary, or a command on PATH. Relative paths resolve against the first workspace folder. Empty: the project's @inthedark/dxlint package."
        },
        "dxlint.scanWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Lint every file in the workspace in the background, streaming results as files finish. When off, only open files are linted."
        },
        "dxlint.inspectHover": {
          "type": "boolean",
          "default": false,
          "description": "For writing rules: hovering in a linted file shows the dxlint layers at the cursor, the field each sits in, and the native facts (type, resolved, ...) there."
        }
      }
    },
    "commands": [
      {
        "command": "dxlint.restart",
        "title": "dxlint: Restart language server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
