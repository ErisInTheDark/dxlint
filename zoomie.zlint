# zoomie-lint lints itself with this file.

import "std/rust"
import "std/zlint"
import "std/markdown"
import "std/toml"
import "std/whitespace"

# Examples are deliberately broken; they have their own configs.
ignore "examples"

# Long lines are a judgement call here, not a rule.
set max-line-length off
set tab-indent warn

# ---- rust ---------------------------------------------------------------

in rs_code {
  match rs_dbg /\bdbg!/ {
    rule no-dbg error "remove `dbg!` before committing"
  }
  match rs_unfinished /\b(?:todo|unimplemented)!/ {
    rule no-unfinished error "`{text}` panics at runtime; finish this code"
  }
}

# Test modules are a layer, so rules can ask whether they are inside one.
in .rust or brace match rs_test_mod /#\[cfg\(test\)\]\s*mod\s+\w+\s*/ body:brace
in rs_code match rs_unwrap /\.unwrap\(\)/ {
  rule no-unwrap {
    when rs_test_mod == null
    warn "`.unwrap()` outside tests; use `?` or `.expect(\"why\")`"
    ignore "tests.rs" or "tests/**"
  }
}

in rs_code match rs_fn /\bfn[ \t]+/ name:ident
in rs_fn.name rule fn-snake-case warn "function names are snake_case" fix snake_case(text)

in rs_line_comment or rs_block_comment match todo_note /\b(?:TODO|FIXME|XXX)\b/ {
  rule todo-comment info "{text} left in a comment"
}

# ---- zlint --------------------------------------------------------------

in zl_code {
  match zl_rule /\brule[ \t]+/ name:/[\w-]+/
  match zl_matcher /\bmatch[ \t]+/ name:/\w+/
}
in zl_rule.name rule rule-names warn "rule names are kebab-case" fix kebab_case(text)
in zl_matcher.name rule matcher-names warn "matcher names are snake_case" fix snake_case(text)
