# Example: Rust rules showing fields, lists and nested layers.
# Try it: cd examples/rust && zlint

import .rs

# Flat `use a::{c, b}` lists stay sorted. Repeated fields are lists.
in .rust, braces match rs_flat_use_list /\buse\s+/ path:/(?:\w+::)+/ /\{\s*/ item:/[\w:]+/ (/,\s*/ item:/[\w:]+/)* /,?\s*\}/ {
  rule sorted-use-lists {
    let sorted { value item; sort; join ", " }
    warn "keep `use` lists sorted"
    fix as "use {path}{{{sorted}}}"
  }
}

# `.expect("...")` messages start lowercase. `msg` is a whole string layer,
# escapes and all.
in rs_code match rs_expect /\.expect\(\s*/ msg:rs_string /\s*\)/
in rs_expect.msg rule expect-lowercase warn "`expect` messages start lowercase" {
  when slice(text, 1, 2) ~ /[A-Z]/
  fix as slice(text, 0, 1) { value text; slice 1 2; lower } slice(text, 2)
}

# Type annotations are written `name: Type`. Only the separator is a
# target, so the fix touches nothing else.
in rs_code match rs_annotation name:identifier sep:/[ \t]*:[ \t]*/ ty:/[A-Z]\w*/
in rs_annotation.sep rule annotation-colon warn "write `{rs_annotation.name}: {rs_annotation.ty}`" fix as ": "
