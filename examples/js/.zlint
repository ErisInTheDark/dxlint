# Example: a few JavaScript/TypeScript rules.
# Try it: cd examples/js && zlint

import .js

# Built-in rules are defined but off: turn on the ones you want.
rule arrow-parens {
  set style "as-needed"
}

in js_code {
  # `==` -> `===`. The operator is a field, so the fix only touches it.
  match js_loose_eq /[^=!<>]/ op:/[!=]=/ /[^=]/

  # console.log anywhere except in scripts/: our own take on the built-in
  # no-console, so it replaces it.
  match js_console_log /\bconsole\.(?:log|debug)\b/ {
    override rule no-console warn "remove `{text}`" {
      ignore "scripts/**"
    }
  }
}
in js_loose_eq.op rule strict-equality warn "use `{text}=` instead of `{text}`" fix as text "="

# Searched only inside comments.
in js_line_comment, js_block_comment match js_todo /\bTODO\b/ {
  rule todo info "TODO left in a comment"
}
