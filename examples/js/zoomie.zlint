# Example: a few JavaScript/TypeScript rules.
# Try it: cd examples/js && zlint

import "std/js"
import "std/whitespace"

in js_code {
  # `==` -> `===`. The operator is a field, so the fix only touches it.
  match js_loose_eq /[^=!<>]/ op:/[!=]=/ /[^=]/

  # console.log anywhere except in scripts/.
  match js_console /\bconsole\.(?:log|debug)\b/ {
    rule no-console warn "remove `{text}`" {
      ignore "scripts/**"
    }
  }

  # Arrow functions with one plain parameter drop the parens: (x) => x
  match js_arrow params:paren /\s*=>/
}
in js_loose_eq.op rule strict-equality warn "use `{text}=` instead of `{text}`" fix text + "="
in js_arrow.params rule arrow-parens warn "no parens around a single arrow parameter" {
  when text ~ /\(\s*[A-Za-z_$][\w$]*\s*\)/
  fix trim(slice(text, 1, -1))
}

# Searched only inside comments.
in js_line_comment or js_block_comment match js_todo /\bTODO\b/ {
  rule todo info "TODO left in a comment"
}
