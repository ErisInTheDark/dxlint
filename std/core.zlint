# std/core: building blocks shared by every language.
#
# Brackets are layers whose `until` middle lets their children eat nested
# content, so `(a, f(")"))` closes at the right parenthesis. Languages attach
# the brackets to their root and add their own strings and comments to them:
#
#   in .mylang match parentheses
#   in .mylang, parentheses, brackets, braces match my_string /"/ until /"/

match parentheses /\(/ until /\)/
match brackets /\[/ until /\]/
match braces /\{/ until /\}/
in parentheses, brackets, braces {
  match parentheses
  match brackets
  match braces
}

match whitespace /[ \t]+/
match space /\s+/
match identifier /\b[A-Za-z_]\w*/
match number /\b\d[\d_]*(?:\.\d+)?/

# The line break this file uses, for fixes that add lines.
macro newline (if contains(source, "\r\n") then "\r\n" else "\n")
