# std/core: building blocks shared by every language.
#
# Brackets are layers whose `until` middle lets their children eat nested
# content, so `(a, f(")"))` closes at the right paren. Languages attach the
# brackets to their root and add their own strings and comments to them:
#
#   in .mylang match paren
#   in .mylang or paren or brack or brace match my_string /"/ until /"/

match paren /\(/ until /\)/
match brack /\[/ until /\]/
match brace /\{/ until /\}/
in paren or brack or brace {
  match paren
  match brack
  match brace
}

match ws /[ \t]+/
match space /\s+/
match ident /\b[A-Za-z_]\w*/
match number /\b\d[\d_]*(?:\.\d+)?/
