# std/c: the C family (C, C++, Java, C#, Go, Kotlin, Swift, Scala, Dart).
# Close enough for structure: // and /* */ comments, "strings", 'chars',
# `raw` (Go) and """text blocks""".

import "std/core"

lang c "*.c" "*.h" "*.cc" "*.cpp" "*.cxx" "*.hpp" "*.hh" "*.java" "*.cs" "*.go" "*.kt" "*.kts" "*.swift" "*.scala" "*.dart" {
  match paren
  match brack
  match brace
}

group c_code .c or paren or brack or brace

in c_code {
  match c_line_comment /\/\// until /$/
  match c_block_comment /\/\*/ until /\*\//
  match c_string3 /"""/ until /"""/
  match c_string /"/ until /"|$/
  match c_char /'(?:\\.[^'\n]{0,8}|[^\\'\n])'/
  match c_raw /`/ until /`/
}
in c_string or c_string3 match c_escape /\\(?:.|\n)/
