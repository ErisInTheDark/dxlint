# .ts/restrictions: eslint core rules that limit or forbid things by
# configuration: sizes (max-*, complexity), restricted names, imports,
# properties and syntax, identifier shapes, sort orders, comment and
# operator bans.

import .ts/restrictions/comments
import .ts/helpers

define {

schema restriction_import_path {
  name: string
  message?: string
  importNames?: string[]
  allowImportNames?: string[]
  allowTypeImports: boolean = false
}
schema restriction_import_pattern {
  group?: string[]
  regex?: js_regex
  message?: string
  caseSensitive: boolean = false
  importNames?: string[]
  allowImportNames?: string[]
  importNamePattern?: js_regex
  allowImportNamePattern?: js_regex
  allowTypeImports: boolean = false
}
@macro restriction_import_options {
  option paths restriction_import_path[] = [] "restricted import paths"
  option patterns restriction_import_pattern[] = [] "restricted import pattern groups"
}
@macro restriction_import_list(xs) (if len(xs) < 2 then { value xs; map (x) "'" x "'"; join "" } else if len(xs) == 2 then { value xs; map (x) "'" x "'"; join " and " } else {
  value result: len(xs) - 1
  value slice(xs, 0, result)
  map (x) "'" x "'"
  join ", "
} ", and '" last(xs) "'")
@macro restriction_import_plural(xs) (if len(xs) == 1 then "is" else "are")
@macro restriction_import_custom(entry) (if entry.message != null && entry.message != "" then " " entry.message else "")
@macro restriction_import_glob(path, glob, sensitive) (!starts_with(glob, "#") && {
  value result: (if sensitive then "" else "(?i)") (if { value glob; trim_start "!"; contains "/" } then "^" else "(?:^|/)") {
  value glob
  trim_start "!/"
  replace "\\#" "#"
  replace "\\!" "!"
  re_escape
  replace "\\*\\*/" "(?:.*/)?"
  replace "\\*" "[^/]*"
  replace "\\?" "[^/]"
} "(?:/|$)"
  value re_test(path, result)
})
@macro restriction_import_group(path, entry) ({
  value entry.group.nonempty ?? []
  find_last (import_glob_pattern) @restriction_import_glob(path, import_glob_pattern, entry.caseSensitive)
})
@macro restriction_import_group_blocked(path, entry) ((@restriction_import_group(path, entry)) != null && !{ value @restriction_import_group(path, entry); starts_with "!" })
@macro restriction_import_pattern_matches(entry) (if entry.regex != null then { value result: if entry.caseSensitive then "u" else "iu"; value js_re_test(info.source, entry.regex, result) } else @restriction_import_group_blocked(info.source, entry) || any(info.parents, p => @restriction_import_group_blocked(p, entry)))
fn restriction_import_parent(path) = {
  value path
  split: split "/"
  value result: { value path; split "/"; len } - 1
  value slice(split, 0, result)
  join "/"
}
fn restriction_import_parents(path) = {
  value path
  walk (current) if contains(current, "/") && restriction_import_parent(current) != "" then restriction_import_parent(current) else null
  drop 1
}
fn restriction_import_source(value) = if type_of(value) == "str" then trim(value) else null
in ts_import_specifier, ts_export_specifier let restriction_import_all_members_type kind == "type" && (previous == null || previous.restriction_import_all_members_type == true)
in ts_call let restriction_import_argument first([] argument.static_name)
in ts_import {
  let restriction_import_source restriction_import_source(from.static_name)
  let restriction_import_type kind == "type"
  let restriction_import_all_type kind == "type" || default_import == null && namespace == null && count(specifier) > 0 && last([] specifier.restriction_import_all_members_type) == true
  let restriction_import_name ""
  let restriction_import_item false
  let restriction_import_offset offset
  let restriction_import_end end_offset
  let restriction_import_star_offset offset + {
    value text
    split "*"
    first
    byte_len
  }
}
in ts_export {
  let restriction_import_source restriction_import_source(from.static_name)
  let restriction_import_type kind == "type"
  let restriction_import_all_type kind == "type" || namespace == null && count(specifier) > 0 && last([] specifier.restriction_import_all_members_type) == true
  let restriction_import_star count(specifier) == 0 && declaration == null
  let restriction_import_name if restriction_import_star then "*" else ""
  let restriction_import_item restriction_import_star
  let restriction_import_star_offset offset + {
    value text
    split "*"
    first
    byte_len
  }
  let restriction_import_offset if restriction_import_star then restriction_import_star_offset else offset
  let restriction_import_end if restriction_import_star then restriction_import_star_offset + 1 else end_offset
}
in ts_import_equals {
  let restriction_import_source restriction_import_source(value.restriction_import_argument)
  let restriction_import_type kind == "type"
  let restriction_import_all_type kind == "type"
  let restriction_import_name ""
  let restriction_import_item false
  let restriction_import_offset offset
  let restriction_import_end end_offset
}
in ts_import_specifier let restriction_import_name if type_of(imported.static_name) == "str" then imported.static_name else imported.nonempty ?? local
in ts_export_specifier let restriction_import_name if type_of(local.static_name) == "str" then local.static_name else local
in ts_import_specifier, ts_export_specifier {
  let restriction_import_source parent.restriction_import_source
  let restriction_import_type kind == "type" || parent.restriction_import_type
  let restriction_import_all_type parent.restriction_import_all_type
  let restriction_import_item true
  let restriction_import_offset offset
  let restriction_import_end end_offset
}
in ts_identifier {
  let restriction_import_source parent.restriction_import_source
  let restriction_import_type parent.restriction_import_type
  let restriction_import_all_type parent.restriction_import_all_type
  let restriction_import_name if is ts_node.namespace then "*" else "default"
  let restriction_import_item true
  let restriction_import_offset if is ts_node.namespace then parent.restriction_import_star_offset else offset
  let restriction_import_end end_offset
}
@macro restriction_import_info {
  let info if type_of(restriction_import_source) == "str" then {
    source: restriction_import_source,
    name: restriction_import_name,
    item: restriction_import_item,
    type: restriction_import_type,
    all_type: restriction_import_all_type,
    offset: restriction_import_offset,
    end: restriction_import_end,
    parents: restriction_import_parents(restriction_import_source)
  } else null
}
in ts_import, ts_export, ts_import_equals rule es-no-restricted-imports {
  @restriction_import_options
  when len(paths) > 0
  @restriction_import_info
  @each entry in paths
  when info != null && entry.name == info.source && entry.importNames == null && entry.allowImportNames == null && !(entry.allowTypeImports && info.all_type)
  warn "'{info.source}' import is restricted from being used." @restriction_import_custom(entry)
}
in ts_import_specifier, ts_import.default_import, ts_import.namespace, ts_export_specifier, ts_export rule es-no-restricted-imports:names {
  @restriction_import_options
  when len(paths) > 0
  @restriction_import_info
  when info.item && info != null
  @each entry in paths
  when entry.name == info.source && !(entry.allowTypeImports && (info.type || info.all_type)) && (entry.importNames != null && (info.name == "*" || contains(entry.importNames, info.name)) || entry.allowImportNames != null && !contains(entry.allowImportNames, info.name))
  report at { start: info.offset, end: info.end }
  warn (if info.name == "*" then "* import is invalid because " (if entry.allowImportNames != null then "only " @restriction_import_list(entry.allowImportNames) " from '{info.source}' " @restriction_import_plural(entry.allowImportNames) " allowed." else @restriction_import_list(entry.importNames) " from '{info.source}' " @restriction_import_plural(entry.importNames) " restricted.") else "'{info.name}' import from '{info.source}' is restricted" (if entry.allowImportNames != null then " because only " @restriction_import_list(entry.allowImportNames) " " @restriction_import_plural(entry.allowImportNames) " allowed." else ".")) @restriction_import_custom(entry)
}
in ts_import, ts_export, ts_import_equals rule es-no-restricted-imports:patterns {
  @restriction_import_options
  when len(patterns) > 0
  @restriction_import_info
  when info != null
  @each entry in patterns
  when @restriction_import_pattern_matches(entry) && !(entry.allowTypeImports && info.all_type) && entry.importNames == null && entry.allowImportNames == null && entry.importNamePattern == null && entry.allowImportNamePattern == null
  warn "'{info.source}' import is restricted from being used by a pattern." @restriction_import_custom(entry)
}
in ts_import_specifier, ts_import.default_import, ts_import.namespace, ts_export_specifier, ts_export rule es-no-restricted-imports:pattern-names {
  @restriction_import_options
  when len(patterns) > 0
  @restriction_import_info
  when info.item && info != null
  @each entry in patterns
  when @restriction_import_pattern_matches(entry) && !(entry.allowTypeImports && (info.type || info.all_type)) && (entry.importNames != null && (info.name == "*" || contains(entry.importNames, info.name)) || entry.importNamePattern != null && (info.name == "*" || js_re_test(info.name, entry.importNamePattern, "u")) || entry.allowImportNames != null && !contains(entry.allowImportNames, info.name) || entry.allowImportNamePattern != null && (info.name == "*" || !js_re_test(info.name, entry.allowImportNamePattern, "u")))
  report at { start: info.offset, end: info.end }
  warn (if info.name == "*" then "* import is invalid because " (if entry.allowImportNames != null then "only " @restriction_import_list(entry.allowImportNames) " from '{info.source}' " @restriction_import_plural(entry.allowImportNames) " allowed." else if entry.allowImportNamePattern != null then "only imports that match the pattern '/{entry.allowImportNamePattern}/u' from '{info.source}' are allowed." else if entry.importNamePattern != null && entry.importNames == null then "import name matching '/{entry.importNamePattern}/u' pattern from '{info.source}' is restricted from being used." else @restriction_import_list(entry.importNames) " from '{info.source}' " @restriction_import_plural(entry.importNames) " restricted from being used by a pattern.") else "'{info.name}' import from '{info.source}' is restricted" (if entry.allowImportNames != null then " because only " @restriction_import_list(entry.allowImportNames) " " @restriction_import_plural(entry.allowImportNames) " allowed." else if entry.allowImportNamePattern != null then " because only imports that match the pattern '/{entry.allowImportNamePattern}/u' are allowed from '{info.source}'." else " from being used by a pattern.")) @restriction_import_custom(entry)
}

in ts_identifier let restriction_numeric_identifier true
in ts_parenthesized {
  let restriction_numeric_identifier expression.restriction_numeric_identifier == true
  let restriction_numeric_parse_int expression.restriction_numeric_parse_int == true
}
in ts_identifier let restriction_numeric_parse_int text == "parseInt"
in ts_member, ts_index let restriction_numeric_parse_int object == "Number" && static_name == "parseInt"
in ts_call let restriction_numeric_radix callee.restriction_numeric_parse_int == true
in ts_declarator let restriction_numeric_const parent.kind == "const"
in ts_assignment {
  let restriction_numeric_default parent is ts_array && parent.flow_destructuring_target == true
  let restriction_numeric_object left.restriction_numeric_identifier != true
}
in ts_node {
  let restriction_numeric_type_owner if parent is (ts_union, ts_intersection, ts_parenthesized_type) then parent.restriction_numeric_type_owner else {alias: parent is ts_type_alias, indexed: parent is ts_indexed_access}
  let restriction_numeric_parent if parent is ts_parenthesized then parent.restriction_numeric_parent else {
    default: is (ts_assignment_pattern.right, ts_parameter.init) || is ts_assignment.right && parent.restriction_numeric_default,
    class_field: is ts_class_property.init,
    readonly: is ts_class_property.init && contains(parent.modifier, "readonly"),
    enum: parent is ts_enum_member,
    literal_type: parent is ts_literal_type && parent.restriction_numeric_type_owner.alias,
    type_index: parent.restriction_numeric_type_owner.indexed == true,
    declaration: parent is ts_declarator,
    constant: parent.restriction_numeric_const == true,
    object: parent is (ts_object, ts_property, ts_method) || parent is ts_assignment && parent.restriction_numeric_object,
    radix: is ts_call.argument && index == 1 && parent.restriction_numeric_radix,
    jsx: parent is ts_jsx_expression,
    array_index: is ts_index.index
  }
  let restriction_numeric_full if parent is ts_parenthesized then parent.restriction_numeric_full else if parent is ts_unary && contains(["-", "+"], parent.operator) then {sign: parent.operator, start: parent.offset, context: parent.restriction_numeric_parent} else {sign: "", start: offset, context: restriction_numeric_parent}
}
in ts_number, ts_bigint {
  let restriction_numeric_signed_type parent is ts_literal_type && starts_with(parent.text, "-")
  let restriction_numeric_sign if restriction_numeric_full.sign != "" then restriction_numeric_full.sign else if restriction_numeric_signed_type then "-" else ""
  let restriction_numeric_value if is ts_bigint then (if restriction_numeric_sign == "-" && literal_value.value != "0" then "-" else "") literal_value.value "n" else num(literal_value.value) * (if restriction_numeric_sign == "-" then -1 else 1)
  let restriction_numeric_offset if restriction_numeric_signed_type then parent.offset else restriction_numeric_full.start
  let restriction_numeric_ts_offset if restriction_numeric_sign == "+" then offset else restriction_numeric_offset
  let restriction_numeric_raw restriction_numeric_sign text
  let restriction_numeric_ts_raw if restriction_numeric_sign == "+" then text else restriction_numeric_raw
  let restriction_numeric_array_index restriction_numeric_full.context.array_index && js_compare(literal_value, 0) >= 0 && js_compare(literal_value, 4294967295) < 0 && (is ts_bigint || restriction_numeric_value == round(restriction_numeric_value)) && (restriction_numeric_sign != "-" || num(literal_value.value) == 0)
  let no_magic_numbers_checked !(restriction_numeric_full.context.object || restriction_numeric_full.context.radix || restriction_numeric_full.context.jsx)
}
in ts_number, ts_bigint rule es-no-magic-numbers {
  option enforceConst boolean = false "require const for named number declarations"
  option ignore (number | string)[] = [] "numbers and bigint strings to allow"
  let info restriction_numeric_full.context
  let typescript_specific re_test(file, /\.[cm]?tsx?$/) && (info.enum || info.literal_type || info.type_index || info.readonly)
  when no_magic_numbers_checked
  when !any(ignore, v => type_of(v) == type_of(restriction_numeric_value) && v == restriction_numeric_value)
  when !info.declaration || enforceConst && !info.constant
  report at {start: if typescript_specific then restriction_numeric_ts_offset else restriction_numeric_offset, end: end_offset}
  warn if info.declaration then "Number constants declarations must use 'const'." else "No magic number: {if typescript_specific then restriction_numeric_ts_raw else restriction_numeric_raw}."
}

in ts_import_specifier let restriction_declaration_local local.nonempty ?? imported
in ts_export_specifier let restriction_declaration_local local
in ts_import {
  let restriction_declaration_export false
  let restriction_declaration_category if count(specifier) > 0 then "named" else if namespace != null then "namespace" else if default_import != null then "default" else "side"
  let restriction_declaration_count count(specifier) + (if namespace != null then 1 else 0) + (if default_import != null then 1 else 0)
  let restriction_declaration_syntax if restriction_declaration_count == 0 then "none" else if namespace != null && default_import == null then "all" else if restriction_declaration_count == 1 then "single" else "multiple"
  let restriction_declaration_local default_import.nonempty ?? namespace.nonempty ?? { value [] specifier.restriction_declaration_local; first; nonempty } ?? ""
}
in ts_export {
  let restriction_declaration_export true
  let restriction_declaration_category if count(specifier) > 0 then "named" else if namespace != null then "namespace" else "all"
  let restriction_declaration_count count(specifier) + (if namespace != null then 1 else 0)
  let restriction_declaration_syntax if restriction_declaration_count == 0 then "none" else if namespace != null then "all" else if restriction_declaration_count == 1 then "single" else "multiple"
  let restriction_declaration_local namespace.nonempty ?? { value [] specifier.restriction_declaration_local; first; nonempty } ?? ""
}
in ts_import, ts_export let restriction_declaration_entry if from == null then null else {
  node: node,
  offset: offset, end: end_offset, module: from.static_name.nonempty ?? "",
  export: restriction_declaration_export, type_only: kind == "type",
  category: restriction_declaration_category, syntax: restriction_declaration_syntax,
  local: restriction_declaration_local
}
group restriction_declaration ts_import, ts_export
in ts_program let restriction_declarations {
  value descendants(restriction_declaration)
  map (declaration) declaration.restriction_declaration_entry
  filter (entry) entry != null
}
in ts_import let sort_imports_rank if restriction_declaration_syntax == "none" then 0 else if restriction_declaration_syntax == "all" then 1 else if restriction_declaration_syntax == "multiple" then 2 else 3
fn restriction_sorted_items(items, ordered) = {
  value final_item: last(items)
  value items
  zip ordered (original, replacement) {
    value replacement.text (if original != final_item then
      byte_slice(original.parent.text, original.end_offset - original.parent.offset, original.next.offset - original.parent.offset)
      else "")
  }
  join ""
}
fn restriction_sorted_imports(members, insensitive) = {
  value ordered: {
    value members
    sort_by (item) if insensitive then lower(item.restriction_declaration_local) else item.restriction_declaration_local
  }
  value restriction_sorted_items(members, ordered)
}
@macro restriction_sort_import_options {
  option ignoreCase boolean = false "ignore letter case"
  option allowSeparatedGroups boolean = false "reset declaration order after blank lines"
}
in ts_import rule es-sort-imports:declarations {
  @restriction_sort_import_options
  let preceding {
    value ts_program.restriction_declarations
    filter (entry) !entry.export && entry.offset < offset
    fold null (nearest, entry) if nearest == null || entry.offset > nearest.offset then entry else nearest
  }
  let separated preceding != null && { value source; byte_slice preceding.end offset; re_count /\n/ } > 1
  when restriction_declaration_entry != null && preceding != null && !(allowSeparatedGroups && separated)
  when restriction_declaration_syntax != preceding.syntax && sort_imports_rank < preceding.node.sort_imports_rank || restriction_declaration_syntax == preceding.syntax && compare_text(restriction_declaration_local, preceding.local, false, ignoreCase) < 0
  warn if restriction_declaration_syntax != preceding.syntax then "Expected '{restriction_declaration_syntax}' syntax before '{preceding.syntax}' syntax." else "Imports should be sorted alphabetically."
}
in ts_import_specifier rule es-sort-imports:members {
  @restriction_sort_import_options
  let unsorted previous != null && compare_text(previous.restriction_declaration_local, restriction_declaration_local, false, ignoreCase) > 0
  let encountered previous.encountered == true || unsorted
  when parent is ts_import && parent.restriction_declaration_entry != null && unsorted && previous.encountered != true
  report at local.node ?? imported.node
  let members parent.specifier.nodes
  fix at {start: first(members).offset, end: last(members).end_offset} if {
    value members
    all (member) !member.space_before.comments && !member.space_after.comments
  } as restriction_sorted_imports(members, ignoreCase)
  warn "Member '{restriction_declaration_local}' of the import declaration should be sorted alphabetically."
}
fn restriction_import_mergeable(a, b) = !(a.type_only && b.type_only && (a.category == "default" && b.category == "named" || a.category == "named" && b.category == "default")) && !(a.category == "all" && contains(["named", "namespace", "default"], b.category) || b.category == "all" && contains(["named", "namespace", "default"], a.category) || a.category == "namespace" && b.category == "named" || a.category == "named" && b.category == "namespace")
group duplicate_imports_checked ts_import
@macro restriction_duplicate_import_body {
  option allowSeparateTypeImports boolean = false "allow separate type and value imports"
  let own restriction_declaration_entry
  let module trim(own.module)
  when own != null && module != ""
  when any(ts_program.restriction_declarations, entry => entry.node is duplicate_imports_checked && entry.offset < offset && entry.export == previous_export && trim(entry.module) == module && (!allowSeparateTypeImports || entry.type_only == own.type_only) && restriction_import_mergeable(own, entry))
  warn "'{module}' {if own.export then 'export' else 'import'} is duplicated{if own.export == previous_export then '' else if own.export then ' as import' else ' as export'}."
}
in duplicate_imports_checked rule es-no-duplicate-imports:imports {
  let previous_export false
  @restriction_duplicate_import_body
}
in duplicate_imports_checked rule es-no-duplicate-imports:exports {
  let previous_export true
  @restriction_duplicate_import_body
}

in ts_variable_declaration let restriction_sort_bindings {
  value declaration.nodes
  filter (item) item.name is ts_identifier
}
fn restriction_sorted_variables(bindings, insensitive) = {
  value ordered: {
    value bindings
    sort_by (item) if insensitive then lower(item.name) else item.name.text
  }
  value restriction_sorted_items(bindings, ordered)
}
in ts_declarator rule es-sort-vars {
  option ignoreCase boolean = false "ignore letter case"
  let simple_name name is ts_identifier
  let greatest if !simple_name then previous.greatest else if previous.greatest == null || compare_text(name, previous.greatest, false, ignoreCase) >= 0 then name else previous.greatest
  when simple_name && previous.greatest != null && compare_text(name, previous.greatest, false, ignoreCase) < 0
  report at name.node
  warn "Variables within the same declaration block should be sorted alphabetically."
  let bindings parent.restriction_sort_bindings
  let first_binding first(bindings)
  let last_binding last(bindings)
  # Crossing a destructuring initializer can change reads and evaluation order.
  fix at {start: first_binding.offset, end: last_binding.end_offset} if {
    value bindings
    all (item, i) (item.init == null || unparenthesised_node(item.init.node) is (ts_string, ts_number, ts_boolean, ts_null, ts_bigint, ts_regex))
      && item.index == first_binding.index + i
  } as restriction_sorted_variables(bindings, ignoreCase)
}
in ts_identifier let restriction_sort_key_name text
in ts_computed_key let restriction_sort_key_name if expression is ts_identifier then "{expression}" else null
in ts_property, ts_method {
  let restriction_sort_computed key is ts_computed_key
  let restriction_sort_key_fallback key.restriction_sort_key_name
}
in ts_object let restriction_sort_key_count count(property)
in ts_property, ts_method, ts_spread rule es-sort-keys {
  default option mode "asc" | "desc" = "asc" "key order"
  option caseSensitive boolean = true "compare letter case"
  option natural boolean = false "compare digit sequences numerically"
  option minKeys int(2..) = 2 "minimum object properties"
  option allowLineSeparatedGroups boolean = false "reset sorting after blank lines"
  option ignoreComputedKeys boolean = false "reset sorting at computed keys"
  let reset is ts_spread || ignoreComputedKeys && restriction_sort_computed
  let name if reset then null else if type_of(static_name) == "str" then static_name else restriction_sort_key_fallback
  let carried if reset then null else if type_of(name) == "str" then name else previous.carried
  let blank_gap previous.space_after.blank_gaps > 0 || space_before.blank_gaps > 0
  let pending_blank if reset then previous.pending_blank else allowLineSeparatedGroups && (previous.pending_blank == true || blank_gap) && type_of(name) != "str"
  let separated previous.pending_blank == true || blank_gap
  let order compare_text(previous.carried, name, natural, !caseSensitive)
  when parent is ts_object && parent.restriction_sort_key_count >= minKeys
  when !reset && type_of(name) == "str" && type_of(previous.carried) == "str" && !(allowLineSeparatedGroups && separated)
  when if mode == "asc" then order > 0 else order < 0
  report at key.node
  warn "Expected object keys to be in {if natural then 'natural ' else ''}{if caseSensitive then '' else 'insensitive '}{mode}ending order. '{name}' should be before '{previous.carried}'."
}

in ts_conditional rule es-no-ternary warn "Ternary operator used."

in ts_conditional let restriction_ternary true
in ts_parenthesized let restriction_ternary expression.restriction_ternary == true
in ts_conditional rule es-no-nested-ternary {
  when consequent.restriction_ternary == true || alternate.restriction_ternary == true
  warn "Do not nest ternary expressions."
}
in ts_continue rule es-no-continue warn "Unexpected use of continue statement."
in ts_parenthesized, ts_unary let restriction_statement_position if parent is ts_parenthesized then parent.restriction_statement_position else parent is ts_expression_statement
in ts_parenthesized, ts_sequence, ts_update let restriction_for_update if parent is (ts_parenthesized, ts_sequence) then parent.restriction_for_update else is ts_for.update
in ts_unary let no_void_checked true
in ts_unary rule es-no-void {
  when operator == "void" && no_void_checked
  warn "Expected 'undefined' and instead saw 'void'."
}
in ts_update let no_plusplus_checked true
in ts_update rule es-no-plusplus {
  when no_plusplus_checked
  warn "Unary operator '{operator}' used."
}
in ts_binary, ts_assignment let restriction_bitwise_zero_or operator == "|" && right.literal_value.value == "0"
in ts_binary, ts_assignment, ts_unary let no_bitwise_checked true
in ts_binary, ts_assignment rule es-no-bitwise:binary {
  when contains(["^", "|", "&", "<<", ">>", ">>>", "^=", "|=", "&=", "<<=", ">>=", ">>>=", "~"], operator)
  when no_bitwise_checked
  warn "Unexpected use of '{operator}'."
}
in ts_unary rule es-no-bitwise:unary {
  when operator == "~" && no_bitwise_checked
  warn "Unexpected use of '{operator}'."
}
in ts_identifier rule es-no-undefined {
  when text == "undefined" && (declaration_kind != null || resolved == "local" || global == "readonly" || global == "writable")
  warn "Unexpected use of undefined."
}
in ts_identifier {
  let restriction_window_object resolved == "global" && (text == "window" || text == "globalThis" && restriction_name_external)
  let restriction_called_name if resolved == "global" then text else null
}
in ts_this let restriction_window_object ts_function == null && ts_arrow == null && ts_method == null && ts_static_block == null
in ts_parenthesized {
  let restriction_window_object expression.restriction_window_object == true
  let restriction_called_name expression.restriction_called_name
}
in ts_member, ts_index let restriction_called_name if object.restriction_window_object == true then static_name else null
in ts_call rule es-no-alert {
  let name callee.restriction_called_name
  when contains(["alert", "confirm", "prompt"], name)
  warn "Unexpected {name}."
}
in ts_labeled let restriction_target body.node
in ts_labeled let restriction_label_entry {name: "{label}", target: restriction_target}
in ts_statement, ts_case let restriction_label_targets (parent.restriction_label_targets.nonempty ?? []) (if is ts_labeled then [restriction_label_entry] else [])
in ts_break, ts_continue let restriction_target (find_last(restriction_label_targets, target => target.name == label)).target
in ts_labeled, ts_break, ts_continue let no_labels_checked true
in ts_labeled rule es-no-labels {
  when no_labels_checked
  warn "Unexpected labeled statement."
}
in ts_break rule es-no-labels:break {
  when label != null
  when no_labels_checked
  warn "Unexpected label in break statement."
}
in ts_continue rule es-no-labels:continue {
  when label != null
  when no_labels_checked
  warn "Unexpected label in continue statement."
}

@macro restriction_function_name ({ value function_name.nonempty ?? "function"; slice 0 1; upper } { value function_name.nonempty ?? "function"; slice 1 })
group restriction_flow_control ts_conditional, ts_logical, ts_for, ts_for_in, ts_for_of, ts_if, ts_while, ts_do_while, ts_assignment_pattern
in ts_parameter let restriction_parameter_branch init != null
in ts_try let restriction_catch_branch handler != null
in ts_assignment let restriction_assignment_branch contains(["&&=", "||=", "??="], operator)
in ts_member, ts_index, ts_call let restriction_optional_branch optional != null
in ts_case let restriction_case_branch test != null
in ts_block let restriction_local_statements count(body)
in ts_function_like, ts_static_block let max_nested_callbacks_counted restriction_call_argument
in ts_class let max_classes_counted true
in ts_program let restriction_classes {
  value descendants(ts_class)
  filter (item) item.max_classes_counted == true
  count
}
in ts_program let restriction_declared_classes {
  value descendants(ts_class)
  filter (item) item.max_classes_counted == true && item.parent is (ts_program, ts_block, ts_export)
  count
}
in ts_program let restriction_program_span if count(body.nodes) == 0 then { start: offset, end: offset } else { start: first(body.nodes).offset, end: last(body.nodes).end_offset }
fn restriction_branch_total(branch, extra, child_totals) = (if branch then 1 else 0) + (if extra == true then 1 else 0) + sum(child_totals)
in ts_node {
  let restriction_metric_boundary is (ts_function_like, ts_static_block) || is ts_class_property.init
  let restriction_flow_branch is restriction_flow_control || (if is ts_parameter then restriction_parameter_branch == true else if is ts_try then restriction_catch_branch == true else if is ts_assignment then restriction_assignment_branch == true else if is (ts_member, ts_index, ts_call) then restriction_optional_branch == true else false)
  let restriction_statement_owner if parent.node == null then null else if parent.restriction_metric_boundary then parent.node else parent.restriction_statement_owner
  let restriction_subtree_classic restriction_branch_total(restriction_flow_branch, restriction_case_branch, children.restriction_classic_contribution)
  let restriction_classic_contribution if restriction_metric_boundary then 0 else restriction_branch_total(restriction_flow_branch, restriction_case_branch, children.restriction_classic_contribution)
  let restriction_subtree_modified restriction_branch_total(restriction_flow_branch, is ts_switch, children.restriction_modified_contribution)
  let restriction_modified_contribution if restriction_metric_boundary then 0 else restriction_branch_total(restriction_flow_branch, is ts_switch, children.restriction_modified_contribution)
  let restriction_function_depth (parent.restriction_function_depth.nonempty ?? 0) + (if parent is (ts_function_like, ts_static_block) then 1 else 0)
  let restriction_top_functions (if is ts_function_like && restriction_function_depth == 0 then 1 else 0) + sum(children.restriction_top_functions)
  let restriction_file_top_functions if parent.node == null then restriction_top_functions else (parent.restriction_file_top_functions.nonempty ?? 0)
  let restriction_call_argument if parent is ts_parenthesized then parent.restriction_call_argument else is ts_call.argument
  let restriction_constructor_argument if parent is ts_parenthesized then parent.restriction_constructor_argument else is (ts_call.argument, ts_new.argument)
  let restriction_iife if parent is ts_parenthesized then parent.restriction_iife else is ts_call.callee
  let restriction_callbacks (parent.restriction_callbacks.nonempty ?? 0) + (if max_nested_callbacks_counted == true then 1 else 0)
}
group restriction_parameter_function ts_function, ts_arrow, ts_method, ts_function_type
in ts_parameter {
  let restriction_this_parameter name == "this"
  let restriction_void_this_parameter name == "this" && type == "void"
  let max_params_counted !restriction_void_this_parameter || node != first(parent.parameter.nodes)
}
in restriction_parameter_function rule es-max-params {
  default option max int(0..) = 3 "maximum parameters"
  let amount { value parameter.nodes; filter (p) p.max_params_counted.nonempty ?? true; count }
  when amount > max
  report at restriction_function_head(node)
  warn "{@restriction_function_name} has too many parameters ({amount}). Maximum allowed is {max}."
}
in ts_function_like {
  let restriction_subtree_statements {
    value owner: node
    value descendants(ts_block)
    filter (block) !block.restriction_metric_boundary && block.restriction_statement_owner == owner
    map (block) block.restriction_local_statements
    sum
  }
  let max_statements_checked true
}
in ts_function_like rule es-max-statements {
  default option max int(0..) = 10 "maximum statements"
  option ignoreTopLevelFunctions boolean = false "skip top-level functions unless the file has only one"
  when restriction_subtree_statements > max
  when max_statements_checked
  when !(ignoreTopLevelFunctions && restriction_function_depth == 0 && restriction_file_top_functions == 1)
  report at restriction_function_head(node)
  warn "{@restriction_function_name} has too many statements ({restriction_subtree_statements}). Maximum allowed is {max}."
}
in ts_function_like rule es-complexity {
  default option max int(0..) = 20 "maximum cyclomatic complexity"
  option variant "classic" | "modified" = "classic" "how switches contribute"
  let amount 1 + (if variant == "classic" then restriction_subtree_classic else restriction_subtree_modified)
  when amount > max
  report at restriction_function_head(node)
  warn "{@restriction_function_name} has a complexity of {amount}. Maximum allowed is {max}."
}
in ts_static_block, ts_class_property.init rule es-complexity:implicit {
  default option max int(0..) = 20 "maximum cyclomatic complexity"
  option variant "classic" | "modified" = "classic" "how switches contribute"
  let amount if is (ts_function, ts_arrow) then 1 else 1 + (if variant == "classic" then restriction_subtree_classic else restriction_subtree_modified)
  when amount > max
  report at if is ts_static_block then { start: first_token.start, end: first_token.end } else node
  warn "{if is ts_static_block then 'Class static block' else 'Class field initializer'} has a complexity of {amount}. Maximum allowed is {max}."
}
group restriction_depth_control ts_if, ts_switch, ts_try, ts_do_while, ts_while, ts_with, ts_for, ts_for_in, ts_for_of
in ts_statement, ts_arrow, ts_method, ts_static_block, ts_case let restriction_nesting if is (ts_function_like, ts_static_block) then 0 else (parent.restriction_nesting.nonempty ?? 0) + (if is restriction_depth_control && !(is ts_if && is ts_if.alternate) then 1 else 0)
in restriction_depth_control rule es-max-depth {
  default option max int(0..) = 4 "maximum control-flow nesting"
  when !(is ts_if && is ts_if.alternate)
  when restriction_nesting > max
  report at { start: first_token.start, end: first_token.end }
  warn "Blocks are nested too deeply ({restriction_nesting}). Maximum allowed is {max}."
}
in ts_function, ts_arrow rule es-max-nested-callbacks {
  default option max int(0..) = 10 "maximum callback nesting"
  let amount restriction_callbacks
  when max_nested_callbacks_counted && amount > max
  report at function_warning_site(node)
  warn "Too many nested callbacks ({amount}). Maximum allowed is {max}."
}
in ts_program rule es-max-classes-per-file {
  default option max int(1..) = 1 "maximum classes"
  option ignoreExpressions boolean = false "count only class declarations"
  let amount if ignoreExpressions then restriction_declared_classes else restriction_classes
  when amount > max
  report at { start: restriction_program_span.start, end: restriction_program_span.end }
  warn "File has too many classes ({amount}). Maximum allowed is {max}."
}
fn restriction_line_previous(items, item) = {
  value result: index_of(items, item) - 1
  value items
  index_of: index_of item
  value slice(items, result, index_of)
  last
}
fn restriction_line_comment_gap(source, items, item, start, end) = {
  value default: { value restriction_line_previous(items, item).end_offset; nonempty } ?? start
  value max: max(start, default)
  value end
  min: min item.offset
  value max_2: max(start, min)
  value byte_slice(source, max, max_2)
}
in ts_line {
  let restriction_line_comments overlapping(ts_comment)
  let restriction_line_blank trim(text) == ""
  let restriction_line_comment count(restriction_line_comments) > 0 && all(restriction_line_comments, item => { value source; restriction_line_comment_gap restriction_line_comments item offset end_offset; trim } == "") && {
    value end_offset_2: last(restriction_line_comments).end_offset
    value max: max(offset, end_offset_2)
    value min: min(end_offset, max)
    value byte_slice(source, min, end_offset)
    trim
  } == ""
}
in ts_program, ts_function_like let restriction_line_rows overlapping(ts_line)
fn restriction_open_paren(n) = first(overlapping(ts_open_paren, n.offset, n.end_offset)).offset
fn restriction_function_type_arrow(n) = {
  value from: { value last(n.parameter.nodes).end_offset; nonempty } ?? n.offset
  value arrow: { value overlapping(ts_punctuator, from, n.return_type.offset); filter (t) t.text == "=>"; first }
  value { start: arrow.offset, end: arrow.end_offset }
}
# ESLint reports a function's head: the callable start through its parameter paren, or the arrow token for a function type.
fn restriction_function_head(n) = when {
  n.parent is (ts_property, ts_class_property) then { start: n.parent.node.offset, end: restriction_open_paren(n) }
  n is ts_function_type then restriction_function_type_arrow(n)
  n is ts_arrow then n.operator.node
  else then { start: n.offset, end: restriction_open_paren(n) }
}
in ts_program rule es-max-lines {
  default option max int(0..) = 300 "maximum lines"
  option skipComments boolean = false "exclude comment-only lines"
  option skipBlankLines boolean = false "exclude blank lines"
  let lines filter(restriction_line_rows, l => !(skipComments && l.restriction_line_comment || skipBlankLines && l.restriction_line_blank))
  let amount if source == "" && !skipBlankLines then 1 else len(lines)
  when amount > max
  let exceed_line { value { value lines; slice max; first }; nonempty } ?? node
  report at { start: position(exceed_line.offset).js_line_start, end: byte_len(source) }
  warn "File has too many lines ({amount}). Maximum allowed is {max}."
}
in ts_function_like let max_lines_per_function_checked !restriction_iife
in ts_function_like rule es-max-lines-per-function {
  default option max int(0..) = 50 "maximum function lines"
  option skipComments boolean = false "exclude comment-only lines"
  option skipBlankLines boolean = false "exclude blank lines"
  let lines filter(restriction_line_rows, l => !(skipComments && l.restriction_line_comment || skipBlankLines && l.restriction_line_blank))
  when max_lines_per_function_checked
  when len(lines) > max
  report at restriction_function_head(node)
  warn "{@restriction_function_name} has too many lines ({len(lines)}). Maximum allowed is {max}."
}

in ts_object {
  let restriction_import_options parent is ts_import_call
  let restriction_import_attributes parent.restriction_import_attribute_group == true
}
in ts_property, ts_pattern_property {
  let restriction_import_options_key parent.restriction_import_options == true || parent.restriction_import_attributes == true
  let restriction_import_attribute_group parent.restriction_import_options == true && contains(["with", "assert"], static_name)
  let restriction_name_pattern is ts_pattern_property || parent.flow_destructuring_target == true
  let restriction_name_alias restriction_name_pattern && value != null && (value not ts_assignment_pattern || value.left != null)
  let restriction_name_same value != null && "{key}" == "{value.left.nonempty ?? value}"
}
in ts_export_specifier {
  let restriction_name_reexport parent.from != null
  let restriction_name_export_alias exported != null
}
in ts_class let restriction_name_declaration parent is (ts_program, ts_block, ts_export)
in ts_member let restriction_name_mutation parent not ts_update && !(parent is ts_unary && parent.operator == "delete")
in ts_identifier let restriction_identifier_name text
in ts_private_name let restriction_identifier_name re_replace(text, /^#*/, "")
in ts_identifier, ts_private_name {
  let restriction_name_external contains(["readonly", "writable"], global)
  let restriction_name_attributes is ts_property.key && parent.restriction_import_options_key == true
  let restriction_name_pattern parent.restriction_name_pattern == true
  let restriction_name_alias is ts_node.key && parent.restriction_name_alias == true
  let restriction_name_same parent.restriction_name_same == true
  let restriction_name_assignment is ts_member.property && parent.write_site != null && parent.restriction_name_mutation
  let restriction_name_renamed is ts_import_specifier.imported && parent.local != null || is ts_export_specifier.local && parent.restriction_name_export_alias && parent.restriction_name_reexport
  let restriction_name_property is ts_node.key && (if restriction_name_pattern then !restriction_name_alias || restriction_name_same else parent is ts_property) || restriction_name_assignment
  let restriction_name_length if parent is (ts_declarator, ts_parameter) then is (ts_declarator.name, ts_parameter.name) else if parent is ts_assignment_pattern then is ts_assignment_pattern.left else if restriction_name_pattern then (if is ts_node.key then !restriction_name_alias || restriction_name_same else !restriction_name_same) else if parent is ts_property then is ts_property.key else if parent is ts_import_specifier then is ts_import_specifier.local && (parent.imported.static_name.nonempty ?? "{parent.imported}") != restriction_identifier_name else if parent is ts_import then is (ts_import.default_import, ts_import.namespace) else if parent is (ts_function, ts_arrow, ts_method, ts_class_property, ts_rest, ts_array_pattern) then true else if parent is ts_class then parent.restriction_name_declaration else if parent is ts_try then is ts_try.parameter else if parent is ts_member then restriction_name_assignment else false
}
in ts_identifier, ts_private_name rule es-id-denylist {
  option names string[] = [] "restricted identifiers"
  when len(names) > 0 && contains(names, restriction_identifier_name)
  when (!restriction_name_external || is ts_property.key && !restriction_name_pattern) && !restriction_name_attributes && !restriction_name_renamed && !restriction_name_alias
  when parent not (ts_call, ts_new, ts_meta_property) && !(is ts_member.property && !restriction_name_assignment)
  warn "Identifier '{text}' is restricted."
}
in ts_identifier, ts_private_name let id_length_checked true
in ts_identifier, ts_private_name rule es-id-length {
  option min int = 2 "minimum identifier length"
  option max int | null = null "maximum identifier length"
  option exceptions string[] = [] "names exempt from length limits"
  option exceptionPatterns regex[] = [] "name patterns exempt from length limits"
  let amount graphemes(restriction_identifier_name)
  when restriction_name_length && !restriction_name_attributes
  when id_length_checked
  when !contains(exceptions, restriction_identifier_name) && !any(exceptionPatterns, p => re_test(restriction_identifier_name, p))
  when amount < min || max != null && amount > max
  warn if amount < min then "Identifier name '{text}' is too short (< {min})." else "Identifier name '{text}' is too long (> {max})."
}
in ts_identifier, ts_private_name {
  let restriction_name_match_context if is ts_private_name then (if parent is ts_class_property then "field" else "always")
    else if parent is ts_member then (if is ts_member.object || restriction_name_assignment then "property" else null)
    else if restriction_name_pattern then (if restriction_name_alias then null else "destructuring")
    else if is ts_property.key then "property"
    else if parent is ts_assignment_pattern then (if is ts_assignment_pattern.left then "default_property" else null)
    else if parent is ts_import_specifier then (if is ts_import_specifier.local || is ts_import_specifier.imported && parent.local == null then "import" else null)
    else if parent is ts_import then (if is (ts_import.default_import, ts_import.namespace) then "import" else null)
    else if parent is ts_class_property then "field"
    else if parent is (ts_call, ts_new, ts_meta_property) then null
    else if parent is (ts_function, ts_declarator) then "declaration" else "reference"
  let id_match_checked contains(["always", "destructuring", "import", "declaration", "reference"], restriction_name_match_context)
}
in ts_identifier, ts_private_name rule es-id-match {
  default option mode regex = "^.+$" "required identifier pattern"
  when !restriction_name_attributes && id_match_checked && !restriction_name_external
  when !re_test(restriction_identifier_name, mode)
  warn "Identifier '{text}' does not match the pattern '{mode}'."
}
schema restriction_global {name: string; message?: string}
# ESLint accepts bare names as well as {name, message} records.
fn restriction_global_entry(g) = if type_of(g) == "str" then {name: g, message: null} else g
@macro restriction_global_options {
  option globals (restriction_global | string)[] = [] "restricted globals"
  option checkGlobalObject boolean = false "check global-object properties"
  option globalObjects string[] = [] "additional global-object names"
  when len(globals) > 0
}
in ts_identifier rule es-no-restricted-globals {
  @restriction_global_options
  let matched find_last(globals, g => restriction_global_entry(g).name == text)
  when resolved == "global" && access != "type" && matched != null
  when parent not (ts_type_reference, ts_qualified_name, ts_type_query)
  warn "Unexpected use of '{text}'." (if restriction_global_entry(matched).message != null && restriction_global_entry(matched).message != "" then " " restriction_global_entry(matched).message else "")
}
in ts_identifier let restriction_global_root if resolved == "global" && contains(["readonly", "writable"], global) then text else null
in ts_parenthesized let restriction_global_root expression.restriction_global_root
in ts_member, ts_index let restriction_global_root if static_name == object.restriction_global_root then object.restriction_global_root else null
in ts_member let restriction_global_property_report property.node
in ts_index let restriction_global_property_report index.offset
in ts_member, ts_index rule es-no-restricted-globals:member {
  @restriction_global_options
  let root object.restriction_global_root
  let name static_name
  let matched find_last(globals, g => restriction_global_entry(g).name == name)
  when checkGlobalObject && root != null && type_of(name) == "str" && contains(["globalThis", "self", "window"] globalObjects, root) && matched != null
  report at restriction_global_property_report
  warn "Unexpected use of '{name}'." (if restriction_global_entry(matched).message != null && restriction_global_entry(matched).message != "" then " " restriction_global_entry(matched).message else "")
}
schema restriction_property {
  object?: string
  property?: string
  allowObjects?: string[]
  allowProperties?: string[]
  message?: string
}
fn restriction_property_match(object, name, options) = {
  value options
  find_last (o) o.object != null && o.object == object && (o.property == name || o.property == null) && !{ value o.allowProperties.nonempty ?? []; contains name }
  nonempty
} ?? find_last(options, o => o.object == null && o.property == name && !{ value o.allowObjects.nonempty ?? []; contains object })
in ts_identifier let restriction_object_name text
in ts_parenthesized let restriction_object_name expression.restriction_object_name
in ts_declarator, ts_parameter let restriction_pattern_object init.restriction_object_name
in ts_assignment, ts_assignment_pattern let restriction_pattern_object right.restriction_object_name
in ts_object_pattern, ts_object {
  let restriction_property_object parent.restriction_pattern_object
  let restriction_property_pattern is ts_object_pattern || flow_destructuring_target == true
}
@macro restriction_property_body {
  option options restriction_property[] = [] "restricted object properties"
  when len(options) > 0
  let matched restriction_property_match(object_name, property_name, options)
  when type_of(property_name) == "str" && matched != null
  warn (if matched.object != null then "'{object_name}.{property_name}' is restricted from being used." (if matched.allowProperties != null then " Only these properties are allowed: {join(matched.allowProperties, ', ')}." else "") else "'{property_name}' is restricted from being used." (if matched.allowObjects != null then " Property '{property_name}' is only allowed on these objects: {join(matched.allowObjects, ', ')}." else "")) (if matched.message != null && matched.message != "" then " " matched.message else "")
}
in ts_member, ts_index rule es-no-restricted-properties {
  let object_name object.restriction_object_name
  let property_name static_name
  @restriction_property_body
}
in ts_pattern_property, ts_property rule es-no-restricted-properties:patterns {
  let object_name parent.restriction_property_object
  let property_name static_name
  when parent is (ts_object_pattern, ts_object) && parent.restriction_property_pattern
  report at key.node
  @restriction_property_body
}
@macro restriction_export_options {
  option restrictedNamedExports string[] = [] "restricted exported names"
  option restrictedNamedExportsPattern js_regex = "" "restricted exported-name pattern"
}
fn restriction_export_forbidden(name, names, pattern) = contains(names, name) || name != "default" && pattern != "" && js_re_test(name, pattern, "u")
in ts_export let restriction_export_form if kind == "default" then "direct" else null
in ts_export_specifier let restriction_export_form if parent.from == null then "named" else if (local.static_name.nonempty ?? local) == "default" then "defaultFrom" else "namedFrom"
in ts_identifier, ts_string let restriction_export_form if is ts_export.namespace then "namespaceFrom" else null
in ts_export, ts_export_specifier, ts_identifier, ts_string let no_restricted_default_export_checked false
in ts_variable_declaration let restriction_exported_declaration parent is ts_export && parent.kind != "default"
in ts_declarator let restriction_exported_declaration parent.restriction_exported_declaration == true
in ts_export rule es-no-restricted-exports:direct {
  @restriction_export_options
  when kind == "default" && no_restricted_default_export_checked
  warn "Exporting 'default' is restricted."
}
in ts_identifier rule es-no-restricted-exports:declarations {
  @restriction_export_options
  when len(restrictedNamedExports) > 0 || restrictedNamedExportsPattern != ""
  let export_name text
  when (exported && declaration_kind != null || is ts_declarator.name && parent.restriction_exported_declaration) && ts_export != null && ts_export.kind != "default"
  when restriction_export_forbidden(export_name, restrictedNamedExports, restrictedNamedExportsPattern)
  warn "'{export_name}' is restricted from being used as an exported name."
}
in ts_export_specifier rule es-no-restricted-exports:names {
  @restriction_export_options
  let export_name if exported == null then (if local is ts_string then local.static_name else local) else (if exported is ts_string then exported.static_name else exported)
  let restricted_name restriction_export_forbidden(export_name, restrictedNamedExports, restrictedNamedExportsPattern)
  when restricted_name || export_name == "default" && no_restricted_default_export_checked
  report at exported.node ?? local.node
  warn if restricted_name then "'{export_name}' is restricted from being used as an exported name." else "Exporting 'default' is restricted."
}
in ts_export.namespace rule es-no-restricted-exports:namespace {
  @restriction_export_options
  let export_name if is ts_string then static_name else text
  let restricted_name restriction_export_forbidden(export_name, restrictedNamedExports, restrictedNamedExportsPattern)
  when restricted_name || export_name == "default" && no_restricted_default_export_checked
  warn if restricted_name then "'{export_name}' is restricted from being used as an exported name." else "Exporting 'default' is restricted."
}

}
