# String and collection method policies.
import .ts/constants

define {

fn collection_value_node(n) = {
  value n
  walk (current) if current is (ts_parenthesized, ts_as, ts_satisfies, ts_non_null, ts_type_assertion) then current.expression.node
  else if current is ts_identifier then ts_runtime_binding_init(current)
  else null
  last
}

fn collection_value(n) =
  if n is ts_identifier && n.resolved == "global" && contains(["readonly", "writable"], n.global) && contains(["NaN", "undefined", "Infinity"], n.text) then {type: if n.text == "undefined" then "undefined" else "number", value: n.text}
  else ts_runtime_constant(n)

fn collection_static_value(n) = { value n; collection_value_node; collection_value }
fn collection_method(n, name) = n is ts_member && n.property == name || n is ts_index && collection_static_value(n.index.node).type == "string" && collection_static_value(n.index.node).value == name

fn collection_arrayish(n) = {
  value arms: value_parts(n)
  value parts: map(arms ?? [], arm => filter(arm.parts, part => !contains(part.traits, "parameter")
    && !(contains(part.traits, "intersection") && count(part.traits) == 1
      && part.carrier_known && part.carrier == null)))
  value nonnull: filter(parts, arm => !(count(arm) > 0 && all(arm, part =>
    contains(part.traits, "null") || contains(part.traits, "undefined"))))
  value arms != null && count(nonnull) > 0 && all(nonnull, arm => count(arm) > 0
    && all(arm, part => {
      value shape: ts_value_array_part(part, n)
      value shape.known && (shape.array || shape.tuple)
    }))
}

fn collection_filter(n) = n != null && {
  value n
  walk (item) if item is ts_parenthesized then item.expression.node
    else if item is ts_sequence then last(item.expression.nodes)
    else if item is ts_conditional then [item.consequent.node, item.alternate.node]
    else null
  all (item) if item is ts_parenthesized then item.expression.node != null
    else if item is ts_sequence then count(item.expression.nodes) > 0
    else if item is ts_conditional then item.consequent.node != null && item.alternate.node != null
    else item is ts_call && item.optional == null
      && { value item.callee.node; unparenthesised_node; collection_method "filter" }
      && collection_arrayish(unparenthesised_node(item.callee.node).object.node)
}

fn collection_index_zero(v) = v != null && (contains(["string", "bigint"], v.type) && v.value == "0" || v.type == "number" && js_compare(v, 0) == 0)
fn collection_at_number_zero(n) = n != null && (js_compare(n, n) == null || n > -1 && n < 1)
fn collection_at_zero(v) = v != null && { value v; js_number; collection_at_number_zero }

in ts_index rule prefer-find {
  when optional == null && { value index.node; collection_static_value; collection_index_zero } && collection_filter(object.node)
  warn "Prefer .find(...) instead of .filter(...)[0]."
}

in ts_call rule prefer-find:at {
  let method unparenthesised_node(callee.node)
  when count(argument) == 1 && method.optional == null && collection_method(method, "at") && {
    value argument.nodes
    first
    collection_static_value
    collection_at_zero
  } && collection_filter(method.object.node)
  warn "Prefer .find(...) instead of .filter(...)[0]."
}

}
