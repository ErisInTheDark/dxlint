# .ts/assertions: assertion syntax, type-aware and non-null policy.
import .ts/expression-fixes
import .ts/modules
import .ts/values/inspection

define {

in ts_number, ts_string, ts_boolean, ts_bigint, ts_null, ts_regex let raw_literal_expression text
in ts_parenthesized let raw_literal_expression expression.raw_literal_expression
in ts_literal_type let literal_type_text value
in ts_as, ts_type_assertion let use_const_assertion type.literal_type_text != null && type.literal_type_text == expression.raw_literal_expression
in ts_declarator, ts_class_property let use_const_annotation type.literal_type_text != null && type.literal_type_text == init.raw_literal_expression
in ts_as.type, ts_type_assertion.type rule es-prefer-as-const {
  when parent.use_const_assertion
  warn "Expected a `const` instead of a literal type assertion."
  fix at node as "const"
}
in ts_declarator.type, ts_class_property.type rule es-prefer-as-const:annotation {
  when parent.use_const_annotation
  warn "Expected a `const` assertion instead of a literal type annotation."
}

in ts_type_assertion let assertion_style_operand expression.node
in ts_type_assertion let assertion_style_type type.text
fn assertion_style_as(source, n) = {
  value operand: n.assertion_style_operand
  value operand_parens: operand.precedence < 10 || operand is ts_instantiation
  value body: expression_fix_wrap(operand.text, operand_parens) " as " n.assertion_style_type
  # Describe the replacement, not the unary angle assertion being removed.
  value shape: {
    kind: "ts_as", precedence: 10, offset: n.offset,
    structure_parens_hazard: !operand_parens && operand.structure_parens_hazard,
    structure_parens_has_in: !operand_parens && operand.structure_parens_has_in,
    structure_parens_has_call: operand.structure_parens_has_call,
    structure_parens_optional: false
  }
  value required: if n.parent is ts_arrow then 1 else expression_fix_parens(source, n, shape)
  value replacement: if required == null then null else expression_fix_wrap(body, required > 0)
  value if replacement != null && expression_fix_retains_comments(n, replacement) then assertion_fix_output(n, replacement) else null
}

in ts_object let assertion_literal_kind "object"
in ts_array let assertion_literal_kind "array"
in ts_parenthesized let assertion_literal_kind expression.assertion_literal_kind
in ts_as, ts_type_assertion rule es-consistent-type-assertions {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  when is ts_as && assertionStyle != "as" || is ts_type_assertion && assertionStyle != "angle-bracket"
  when !(assertionStyle == "never" && type == "const")
  warn if assertionStyle == "never" then "Do not use any type assertions." else if assertionStyle == "as" then "Use 'as {type}' instead of '<{type}>'." else "Use '<{type}>' instead of 'as {type}'."
  let edit if assertionStyle == "as" then assertion_style_as(source, node) else null
  fix at edit.target if edit != null as edit.text
}
in ts_template let tagged_substitution parent is ts_tagged_template
in ts_as, ts_type_assertion, ts_parenthesized let assertion_argument_context if parent is ts_parenthesized then parent.assertion_argument_context else parent is (ts_new, ts_call, ts_throw, ts_assignment_pattern, ts_jsx_expression) || is ts_parameter.init || parent is ts_template && parent.tagged_substitution
in ts_as, ts_type_assertion {
  let preferred_assertion_style if is ts_as then "as" else "angle-bracket"
  let literal_assertion_eligible type != "any" && type != "unknown" && type != "const"
}
in ts_as, ts_type_assertion rule es-consistent-type-assertions:object {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  default option mode ("allow" | "allow-as-parameter" | "never") = "allow" "When literal assertions are allowed."
  when literal_assertion_eligible && expression.assertion_literal_kind == "object"
  when assertionStyle == preferred_assertion_style
  when mode == "never" || mode == "allow-as-parameter" && !assertion_argument_context
  warn "Always prefer const x: T = {{ ... }}."
}
in ts_as, ts_type_assertion rule es-consistent-type-assertions:array {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  default option mode ("allow" | "allow-as-parameter" | "never") = "allow" "When literal assertions are allowed."
  when literal_assertion_eligible && expression.assertion_literal_kind == "array"
  when assertionStyle == preferred_assertion_style
  when mode == "never" || mode == "allow-as-parameter" && !assertion_argument_context
  warn "Always prefer const x: T[] = [ ... ]."
}

fn assertion_outer(n) = { value n; walk (current) if current.parent is ts_parenthesized then current.parent else null; last }
fn assertion_literal_preserved(n) = assertion_outer(n).parent is ts_declarator && assertion_outer(n).parent.parent.kind == "const" || assertion_outer(n).parent is ts_class_property && { value [] assertion_outer(n).parent.modifier; contains "readonly" }
fn assertion_const_scalar(n) = {
  value operand: unparenthesised_node(n.expression.node)
  value literal: operand is (ts_number, ts_string, ts_boolean, ts_bigint)
    || operand is ts_template && count(operand.expression.nodes) == 0
    || operand is ts_unary && contains(["+", "-"], operand.operator)
      && unparenthesised_node(operand.argument.node) is (ts_number, ts_bigint)
  value parts: value_parts(operand)
  value assertion_literal_preserved(n) && (literal || ts_value_has_enum(operand) == true
    && parts != null && count(parts) > 0 && all(parts, arm => any(arm.parts, part =>
      part.identity_known && part.identity.kind == "value" && count(part.uncertain_traits) == 0)))
}
fn assertion_call(n) = {
  value n
  unparenthesised_node
  walk (current) if current is ts_await then unparenthesised_node(current.argument.node) else if current is ts_non_null then unparenthesised_node(current.expression.node) else if current is ts_sequence then { value current.expression.nodes; last; unparenthesised_node } else null
  last
}
fn assertion_generic_call(n) = {
  value call: assertion_call(n)
  value callee: unparenthesised_node(call.callee.node)
  value binding: if callee is ts_identifier then name_binding(callee) else null
  value declaration: binding.node.parent.node
  value target: if callee is (ts_function, ts_arrow) then callee
    else if count(binding.declarations) == 1 && declaration is ts_function then declaration
    else if count(binding.declarations) == 1 && declaration is ts_declarator && declaration.type == null
      then unparenthesised_node(declaration.init.node) else null
  value if call not ts_call || call.type_argument != null then false
    else if target is (ts_function, ts_arrow) then count(target.type_parameter) > 0 else {
      value alternatives: value_signatures(callee)
      value headers: flat_map(alternatives ?? [], arm => arm)
      value parameters: map(headers, header => site_field(call, header.site, "type_parameter"))
      value if alternatives != null && count(headers) > 0
        && all(parameters, formals => formals != null && count(formals) == 0) then false else null
    }
}
fn assertion_same_handles(source, target) = if source == null || target == null then null else
  if all(source, arm => any(target, other => arm.handle == other.handle))
    && all(target, arm => any(source, other => arm.handle == other.handle)) then true else null
fn assertion_part_known(part) = count(part.uncertain_traits) == 0
  && !any(["any", "unknown", "error", "parameter"], trait => contains(part.traits, trait))
fn assertion_parts_known(arms) = arms != null && all(arms, arm => count(arm.parts) > 0
  && all(arm.parts, part => assertion_part_known(part)))
fn assertion_receiver_known(arms) = arms != null && count(arms) > 0
  && all(arms, arm => count(arm.parts) > 0
    && all(arm.parts, part => part.traits == ["unknown"]
      || assertion_part_known(part)))
fn assertion_parts_non_null(arms) = arms != null && count(arms) > 0
  && all(arms, arm => any(arm.parts, part => assertion_part_known(part)
    && !any(["null", "undefined", "void"], trait => contains(part.traits, trait))))
fn assertion_scalar_identity_known(value) = value != null && all(value, arm => all(arm, part =>
  part.identity_known && part.carrier_known && part.product_known && count(part.uncertain_traits) == 0
    && part.carrier == null && part.product == null && (part.identity != null || any(
      ["number", "string", "boolean", "bigint", "symbol", "null", "undefined", "void"],
      trait => contains(part.traits, trait)))))
fn assertion_same_value(source, target) = {
  value a: value_constituents(source)
  value b: value_constituents(target)
  value assertion_same_handles(value_parts(source), value_parts(target)) == true
    || assertion_scalar_identity_known(a) && assertion_scalar_identity_known(b) && a == b
}
fn assertion_scalar_types(n) = {
  value arms: value_constituents(n)
  value if !assertion_scalar_identity_known(arms) then null else map(arms, arm => map(arm, part => {
    traits: filter(part.traits, trait => !contains(["truthy", "falsy"], trait)),
    identity: part.identity
  }))
}
fn assertion_scalar_types_equal(left, right) = left != null && right != null && count(left) > 0 && count(right) > 0
    && all(left, arm => count(arm) > 0 && contains(right, arm))
    && all(right, arm => count(arm) > 0 && contains(left, arm))
fn assertion_same_scalar_type(source, target) = assertion_scalar_types_equal(
  assertion_scalar_types(source), assertion_scalar_types(target))
fn assertion_undefined_arm(arm) = count(arm) == 1 && contains(first(arm).traits, "undefined")
fn assertion_same_optional_type(source, target) = {
  value left: assertion_scalar_types(source)
  value right: assertion_scalar_types(target)
  value ts_compiler_option(source, "exactOptionalPropertyTypes") == true
    && left != null && right != null && any(left, arm => assertion_undefined_arm(arm))
    && any(right, arm => assertion_undefined_arm(arm))
    && assertion_scalar_types_equal(filter(left, arm => !assertion_undefined_arm(arm)),
      filter(right, arm => !assertion_undefined_arm(arm)))
}
fn assertion_type_parameter(n) = {
  value bare: ts_value_bare_type(n)
  value declarations: if bare is ts_type_reference && count(bare.type_argument.nodes) == 0
    then name_binding(bare.name.node).declarations else []
  value if count(declarations) == 1 && first(declarations).parent is ts_type_parameter
    then first(declarations).parent.node else null
}
fn assertion_parameter_constraint(parameter) = {
  value base: { value parameter; walk (current) assertion_type_parameter(current.constraint.node); last }
  value constraint: base.constraint.node
  value parts: value_parts(constraint)
  value top: parts != null && count(parts) > 0 && all(parts, arm => count(arm.parts) == 1
    && (first(arm.parts).traits == ["unknown"] || first(arm.parts).traits == ["any"]))
  value {type: constraint, unconstrained: base != null && (constraint == null || top)}
}
fn assertion_relation_parts_known(arms) = arms != null
  && all(arms, arm => count(arm.parts) > 0 && all(arm.parts, part => assertion_part_known(part)
    || part.traits == ["parameter"] && part.carrier_known && part.carrier.description.kind == "parameter"))
fn assertion_parameter_present(arms, parameter) = {
  value site: declaration_identity(parameter)
  value site != null && all(arms, arm => any(arm.parts, part => part.carrier_known
    && part.carrier.file == site.file && part.carrier.node == site.node))
}
fn assertion_unsafe_narrowing(n) = {
  value source: value_parts(n.expression.node)
  value target: value_parts(n.type.node)
  value parameter: assertion_type_parameter(n.type.node)
  value accepted: value_accepts(n.type.node, n.expression.node, "value", "value")
  value constraint: assertion_parameter_constraint(parameter)
  value declaration: first(name_binding(unparenthesised_node(n.expression.node)).declarations).parent.node
  value source_parameter: assertion_type_parameter(declaration.type.node)
  value source_constraint: assertion_parameter_constraint(source_parameter)
  value label: if parameter != null then parameter.name.text else ts_value_print_handle(n.type.node)
  value if !assertion_relation_parts_known(source) || !assertion_relation_parts_known(target)
    || accepted == true || parameter != null && assertion_parameter_present(source, parameter) then null
    else if parameter != null && constraint.unconstrained then {kind: "unconstrained", label: label}
    else if parameter != null && value_accepts(constraint.type, n.expression.node, "value", "value") == true
      then {kind: "constraint", label: label}
    else if accepted == false || source_parameter != null && source_constraint.unconstrained
      && assertion_parts_known(target) then {kind: "narrow", label: label}
    else null
}
fn assertion_subject(n, ignored) = {
  value n.expression.node
  walk (current) {
    value cast: unparenthesised_node(current)
    value if cast is (ts_as, ts_type_assertion) && cast.type.text != "const"
      && !contains(ignored, cast.type.text) then cast.expression.node else null
  }
  last
}
fn assertion_parts_contain_any(parts) = any(parts ?? [], arm => any(arm.parts, part => contains(part.traits, "any")))
fn assertion_handles_contain_any(handles, depth) = handles != null && depth > 0
  && any(handles, handle => assertion_parts_deep_contain_any(value_parts(handle), depth))
fn assertion_parts_deep_contain_any(parts, depth) = parts != null && depth > 0 && any(parts, arm => any(arm.parts, part =>
  contains(part.traits, "any")
    || part.carrier_known && part.carrier != null && assertion_handles_contain_any(part.carrier.arguments, depth - 1)
    || part.product_known && part.product != null && assertion_handles_contain_any(part.product.elements, depth - 1)))
fn assertion_contains_any(value) = assertion_parts_deep_contain_any(value_parts(value), 4)
# Literal operands only keep a literal type through a const/readonly declaration.
fn assertion_literal_expression(n) = n.expression.node is (ts_number, ts_string, ts_boolean, ts_bigint, ts_null, ts_regex, ts_array, ts_template, ts_arrow, ts_function, ts_class)
fn assertion_empty_object_expression(n) = n.expression.node is ts_object && count(n.expression.node.property.nodes) == 0
fn assertion_conceptual_literal(n) = assertion_literal_expression(n) || assertion_empty_object_expression(n)
fn assertion_parameter_value(value) = any(value_trait_parts(value, ["parameter"]) ?? [], arm => any(arm.parts, part => contains(part.traits, "parameter")))
fn assertion_written_annotation(subject) = {
  value declaration: if subject is ts_identifier then subject.declaration else null
  value owner: if declaration != null then declaration.parent else null
  value if owner != null && owner.type != null then owner.type.text else null
}
fn assertion_named_unchanged(n, subject) = {
  value written: assertion_written_annotation(subject)
  value printed: ts_value_print_handle(subject)
  value if assertion_parameter_value(subject) then true
    else if written != null then written == n.type.text
    else !contains(["object", "unknown"], printed) && printed == ts_value_print_handle(n.type.node)
}
# The receiver's own typing (union, satisfies, another assertion) gives no contextual type.
fn assertion_property_receiver(n) = {
  value property: n.parent.node
  value object: if property is ts_property then property.parent.node else null
  value parent: if object is ts_object then object.parent.node else null
  value expected: if object is ts_object then value_expected_handle(object) else null
  value if parent is (ts_as, ts_type_assertion, ts_satisfies) then true
    else if parent is ts_call && parent.parent.node is ts_satisfies then true
    else if object is ts_object && expected == null then true
    else if property is ts_property && assertion_union_narrowing(n) then true
    else false
}
# Selecting one arm of a union receiver keeps meaning; widening a whole union does not.
fn assertion_union_narrowing(n) = {
  value subject: unparenthesised_node(assertion_subject(n, []))
  value arms: value_alternatives(subject)
  value expected: value_expected_handle(n)
  value receiver_any: expected != null && ts_value_trait(value_trait_parts(expected, ["any"]) ?? [], "any")
  value narrows: value_accepts(subject, n.type.node, "value", "value") == true
    && value_accepts(n.type.node, subject, "value", "value") == false
  value arms != null && count(arms) > 1 && receiver_any != true && narrows
}
# Overloads with differing parameter lists give the argument no single receiver type.
fn assertion_overloaded_argument(n) = {
  value parent: n.parent.node
  value arguments: if parent is (ts_call, ts_new) then parent.argument.nodes else null
  value if arguments != null && any(arguments, argument => argument.node == n) then {
    value signatures: call_parameters(parent)
    value headers: flat_map(signatures ?? [], arm => arm)
    value counts: map(headers, header => count(header.parameters))
    value count(headers) > 1 && !all(counts, size => size == first(counts))
  } else false
}
# Inside a generic call only a literal operand (or a property's declared type) is a receiver context.
fn assertion_generic_skip(n) = assertion_generic_context(n)
  && !assertion_literal_expression(n) && n.parent.node not ts_property
# A literal asserted to an enum keeps a nominal member type instead of the literal's own.
fn assertion_enum_literal(n) = n.expression.node is (ts_number, ts_string, ts_boolean) && ts_value_has_enum(n) == true
fn assertion_context_identity(n) = if n.expression.node is ts_object
  && count(n.expression.node.property.nodes) > 0
  && !assertion_parts_contain_any(value_trait_parts(n.type.node, ["any"]))
  && !assertion_parts_contain_any(value_trait_parts(n.expression.node, ["any"]))
  && ts_value_trait(value_constituent_traits(n.type.node, ["unknown"]), "unknown") != true
  && value_same(n.type.node, value_expected_handle(n.expression.node)) == true
  && value_accepts(n.type.node, n.expression.node, "value", "value") == true then true else false
fn assertion_error_identity(n) = {
  value annotation: n.type.node
  value if annotation is ts_type_reference && name_binding(annotation.name.node) == null
    then assertion_parts_contain_any(value_trait_parts(n.type.node, ["any"]))
      && assertion_parts_contain_any(value_trait_parts(n.expression.node, ["any"]))
    else false
}
# `NonNullable<X>` is `X` itself once `X` has no nullish arm.
fn assertion_non_nullable_identity(n, subject) = {
  value annotation: n.type.node
  value arguments: if annotation is ts_type_reference && annotation.name.text == "NonNullable"
    then annotation.type_argument.nodes else null
  value arguments != null && count(arguments) == 1 && !assertion_nullish_parts(value_trait_parts(subject, ["null", "undefined", "void"]))
    && assertion_same_value(subject, first(arguments)) == true
}
fn assertion_same_shape(source, target) = if !assertion_parts_contain_any(value_trait_parts(source, ["any"]))
  && !assertion_parts_contain_any(value_trait_parts(target, ["any"]))
  && !assertion_nullish_parts(value_trait_parts(source, ["null", "undefined", "void"])) && !assertion_nullish_parts(value_trait_parts(target, ["null", "undefined", "void"]))
  && value_accepts(target, source, "value", "value") == true
  && value_accepts(source, target, "value", "value") == true then true else false
# `undefined`, `null` and `void` are mutually assignable without being the same type.
fn assertion_nullish_parts(parts) = any(parts ?? [], arm => any(arm.parts, part =>
  contains(part.traits, "null") || contains(part.traits, "undefined") || contains(part.traits, "void")))
fn assertion_generic_callee(call) = {
  value callee: unparenthesised_node(call.callee.node)
  value binding: if callee is ts_identifier then name_binding(callee) else null
  value declaration: if binding != null && count(binding.declarations) == 1 then first(binding.declarations).parent.node else null
  value if declaration is ts_function then count(declaration.type_parameter) > 0
    else any(flat_map(value_signatures(callee) ?? [], arm => arm),
      header => site_field(call, header.site, "type_parameter") != null
        && count(site_field(call, header.site, "type_parameter")) > 0)
}
fn assertion_generic_context(n) = {
  value n
  walk (current) if current is (ts_function, ts_arrow) && current.body is ts_block then null else current.parent
  any (current) current is (ts_call, ts_new) && (current not ts_call || current.type_argument == null)
    && assertion_generic_callee(current)
}
fn assertion_declared_same(n) = {
  value declared: n.declaration.parent.type.node
  value declared != null
    && value_accepts(declared, n, "value", "value") == true
    && value_accepts(n, declared, "value", "value") == true
}
fn assertion_context_skipped(n) = {
  value parent: n.parent.node
  value if assertion_parts_contain_any(value_trait_parts(n.type.node, ["any"])) then parent is ts_logical || assertion_generic_context(n)
    else if n.expression.node is ts_template && count(n.expression.node.expression.nodes) > 0 then true
    else if n.expression.node is ts_array then true
    else if n.type.node is ts_union && (n.expression.node is ts_null || n.expression.node is ts_identifier && n.expression.node.text == "undefined") then true
    else if assertion_enum_literal(n) then true
    else if assertion_generic_skip(n) then true
    else if assertion_property_receiver(n) then true
    else if assertion_overloaded_argument(n) then true
    else if parent is (ts_as, ts_type_assertion, ts_spread, ts_satisfies) then true
    else if parent is ts_assignment && parent.operator != "=" && parent.right.offset == n.offset then true
    else if parent is ts_assignment && parent.right.offset == n.offset && parent.parent not ts_expression_statement then true
    else false
}
fn assertion_check(n, ignored, check_const) = {
  value literal_const: n.type.text == "const"
  value raw_subject: if literal_const then n.expression.node else assertion_subject(n, ignored)
  value subject: if literal_const then raw_subject else unparenthesised_node(raw_subject)
  value operand: value_parts(subject)
  value annotation: if literal_const then value_parts(n) else value_parts(n.type.node)
  value contextual: !literal_const && assertion_outer(n).parent not (ts_as, ts_type_assertion)
    && !assertion_contains_any(n.expression.node)
    && (value_accepts(n, subject, "expected", "value") == true
      || value_accepts(n, n.expression.node, "expected", "widened") == true
      || n.parent.node is ts_property && value_accepts(n.expression.node, n.expression.node, "expected", "value") == true)
    && !assertion_context_skipped(n)
  value chain_contextual: !literal_const && n.expression.node is (ts_as, ts_type_assertion)
    && (assertion_parts_contain_any(value_trait_parts(n.expression.node, ["any"]))
      || ts_value_trait(value_constituent_traits(n.expression.node, ["unknown"]), "unknown") == true)
    && value_accepts(n, subject, "expected", "value") == true
  value receiver: contextual || chain_contextual
  value identity: !literal_const && assertion_context_identity(n)
  value same: if literal_const then assertion_same_handles(operand, annotation) == true
    else if assertion_context_identity(n) == true then true
    else if assertion_error_identity(n) == true then true
    else if assertion_non_nullable_identity(n, subject) == true then true
    else if assertion_parts_known(operand) && assertion_parts_known(annotation)
      && (assertion_same_scalar_type(subject, n.type.node) || assertion_same_optional_type(subject, n.type.node)) then n.expression.node is ts_template || !assertion_conceptual_literal(n) || assertion_literal_preserved(n)
    else assertion_parts_known(operand) && assertion_parts_known(annotation)
      && !assertion_conceptual_literal(n)
      && !assertion_parts_deep_contain_any(operand, 4) && !assertion_parts_deep_contain_any(annotation, 4)
      && (assertion_same_value(subject, n.type.node)
        || (subject not (ts_object, ts_array) || assertion_context_identity(n) == true)
          && assertion_named_unchanged(n, subject)
          && assertion_same_shape(subject, n.type.node))
  value generic: assertion_generic_call(subject)
  value literal_preserved: !any(annotation ?? [], arm => any(arm.parts, part =>
    part.identity_known && part.identity.kind == "value")) || assertion_literal_preserved(n)
      || subject is ts_call && generic == false
  value enum_preserved: ts_value_has_enum(n) != null && ts_value_has_enum(n) == ts_value_has_enum(subject)
  value if contains(ignored, n.type.text) || literal_const && (!check_const || !assertion_const_scalar(n))
    || !receiver && (!same || !identity && subject is (ts_object, ts_array)
      || !literal_const && subject is ts_template && count(subject.expression.nodes) == 0
      || !literal_preserved || !enum_preserved) || generic == null then null
    else {subject: subject, raw_subject: raw_subject, contextual: receiver && !same, generic: generic}
}
fn assertion_non_null_style(n) = {
  value source: value_parts(n.expression.node)
  value target: value_parts(n.type.node)
  value retained: filter(source ?? [], arm => !any(arm.parts, part =>
    contains(part.traits, "null") || contains(part.traits, "undefined")))
  value non_null: value_union(first(retained).handle, map(slice(retained, 1), arm => arm.handle))
  value if !assertion_parts_known(source) || !assertion_parts_non_null(target) then null
    else count(retained) < count(source)
      && (assertion_same_handles(retained, target) == true || assertion_same_value(non_null, n.type.node)
        || assertion_same_scalar_type(non_null, n.type.node))
}
fn assertion_unassigned(n) = n is ts_identifier && (n.declaration == null && n.resolved != "global" || n.declaration.parent is ts_declarator && n.declaration.ambient != true && (n.declaration.parent.init == null && { value n.declaration.parent.token_texts; slice 1 2; first } != "!"
    && assertion_declared_same(n) == true || n.declaration.parent.parent.kind == "var" && {
  value n.declaration.parent.parent.parent
  walk (current) current.parent
  any (current) current is ts_block && (n.offset < current.offset || n.end_offset > current.end_offset)
}))
fn assertion_fix_body(source, n) = {
  value operand: n.expression.node
  value text: if n is ts_type_assertion then
    byte_slice(source, operand.token_neighbours.before.end, n.expression.offset) operand.text
    else if n is ts_as then operand.text { value source; byte_slice n.expression.end_offset operand.token_neighbours.after.start; trim_end }
    else operand.text byte_slice(source, n.expression.end_offset, n.last_token.start)
  value {node: operand, text: text}
}
fn assertion_fix_enclosed(n) = {
  value n
  walk (current) if current == n.structure_parens_context then null else current.parent.node
  any (current) current is ts_parenthesized
}
fn assertion_fix_parens(source, n, body, needed) = if needed == null then null else if n.parent is ts_parenthesized then 0 else {
  value result: if n.structure_parens_context != null && n.structure_parens_context not ts_return && !assertion_fix_enclosed(n) && body.structure_parens_hazard == true
    || n.structure_parens_for_init && body.structure_parens_has_in == true
    || n.structure_parens_context is ts_return && { value source; byte_slice n.structure_parens_context.offset body.offset; re_test /[\n\r\u{2028}\u{2029}]/ } then 1 else 0
  value max(needed, result)
}
fn assertion_fix_result(n, text, asi) = if asi == null then null else {
  target: n, text: (if asi then ";" else "") expression_fix_edges(n, text)
}
fn assertion_fix_output(n, text) = {
  value statement: expression_fix_statement(n)
  value asi: if statement != null && {
    value text
    trim_start
    slice 0 1
    then (head) contains(["(", "[", "/", "`"], head)
  }
    then {
      value owners: expression_fix_before_nodes(n)
      value expression_fix_asi(statement, n.token_neighbours.before, owners, text)
    } else false
  value assertion_fix_result(n, text, asi)
}
fn assertion_fix_wrap_output(n, body, needed) = if needed == null then null
  else { value body.text; text: expression_fix_wrap (needed > 0); value assertion_fix_output(n, text) }
fn assertion_fix_with_body(source, n, body) = {
  value precedence_parens: expression_fix_parens(source, n, body.node)
  value required_parens: assertion_fix_parens(source, n, body.node, precedence_parens)
  value assertion_fix_wrap_output(n, body, required_parens)
}
fn assertion_fix(source, n) = {
  value body: assertion_fix_body(source, n)
  value assertion_fix_with_body(source, n, body)
}

in ts_as, ts_type_assertion rule es-no-unnecessary-type-assertion {
  option typesToIgnore string[] = [] "Ignore these written assertion types"
  option checkLiteralConstAssertions boolean = false "Check const assertions on literal values"
  let check assertion_check(node, typesToIgnore, checkLiteralConstAssertions)
  when check != null
  let owner assertion_outer(node).parent.node
  when owner not (ts_as, ts_type_assertion) || assertion_check(owner, typesToIgnore, checkLiteralConstAssertions) == null
  warn if check.generic then "The type arguments for this generic call may be inferred from the assertion. Specify them explicitly instead." else if !check.contextual then "This assertion is unnecessary since it does not change the type of the expression." else "This assertion is unnecessary since the receiver accepts the original type of the expression."
  let chain check.subject != unparenthesised_node(expression.node)
  let base if expression_fix_retains_comments(check.raw_subject, check.subject.text) then check.subject else check.raw_subject
  let body if !chain then assertion_fix_body(source, node) else {node: base, text: base.text}
  let edit if check.generic || chain && !expression_fix_retains_comments(node, body.text) then null else assertion_fix_with_body(source, node, body)
  fix at edit.target if edit != null as edit.text
}

in ts_non_null rule es-no-unnecessary-type-assertion:non-null {
  let outer assertion_outer(node)
  let assignment outer.parent is ts_assignment && outer.parent.operator == "="
  let target assignment && outer is ts_assignment.left
  let unassigned { value expression.node; unparenthesised_node; assertion_unassigned }
  let unchanged assertion_parts_non_null(value_parts(expression.node)) && !unassigned
  let contextual !unassigned && assertion_receiver_known(value_parts(value_expected_handle(node)))
    && value_accepts(node, expression.node, "expected", "value") == true
  let unchecked ts_compiler_option(node, "noUncheckedIndexedAccess") == true && unparenthesised_node(expression.node) is ts_index && condition_access(unparenthesised_node(expression.node)).from_index
  when target || !assignment && !unchecked && (unchanged || contextual)
  warn if target || !unchanged then "This assertion is unnecessary since the receiver accepts the original type of the expression." else "This assertion is unnecessary since it does not change the type of the expression."
  let edit assertion_fix(source, node)
  fix at edit.target if edit != null as edit.text
}

}
