# Expression simplification and atomic, precedence-safe fixes.
import .ts/expression-fixes

define {

fn boolean_cast_operand(n, negation) = {
  value if negation
  then unparenthesised_node(n.argument.node).argument.node else first(n.argument.nodes)
  unparenthesised_node
}
fn boolean_cast_empty_target(n) = { value n; walk (current) if current.parent is ts_parenthesized then current.parent.node else null; last }
fn boolean_cast_fix(source, n, info) =
  if !info.negation && count(n.argument.node) == 0 then
    if boolean_cast_empty_target(n).parent is ts_unary && boolean_cast_empty_target(n).parent.operator == "!" then
      if { value boolean_cast_empty_target(n).parent.node; expression_fix_clean } then {
        target: boolean_cast_empty_target(n).parent.node,
        text: { value boolean_cast_empty_target(n).parent.node; expression_fix_edges "true" }
      } else null
    else if expression_fix_clean(n) then { target: n, text: expression_fix_edges(n, "false") } else null
  else if !expression_fix_clean(n) || !info.negation && (count(n.argument.node) != 1 || first(n.argument.nodes) is ts_spread) then null
  else {
    value operand: boolean_cast_operand(n, info.negation)
    value required: expression_fix_parens(source, n, operand)
    value if required == null then null else { target: n, text: {
      value operand.text
      wrapped: expression_fix_wrap (required > 0 || n.parent not ts_parenthesized && operand is structure_assertion)
      value expression_fix_edges(n, wrapped)
    } }
  }

in ts_unary, ts_call rule no-extra-boolean-cast {
  option enforceForInnerExpressions boolean = false "check casts nested inside boolean expressions"
  option enforceForLogicalOperands boolean = false "check casts nested inside logical expressions"
  let cast_info redundant_boolean_cast
  when cast_info != null && (cast_info.mode == 0 || cast_info.mode == 1 && enforceForLogicalOperands || enforceForInnerExpressions)
  let cast_fix boolean_cast_fix(source, node, cast_info)
  warn if cast_info.negation then "Redundant double negation." else "Redundant Boolean call."
  fix at cast_fix.target if cast_fix != null as cast_fix.text
}

group expression_fix_precedence_owner ts_binary, ts_logical, ts_assignment, ts_conditional, ts_sequence, ts_unary, ts_await, ts_update, ts_call, ts_new, ts_member, ts_index, ts_tagged_template, ts_non_null, ts_as, ts_satisfies, ts_type_assertion, ts_arrow, ts_yield
fn exponentiation_base_parens(base) = base.precedence <= 14 || base is (ts_unary, ts_await, structure_assertion)
fn exponentiation_outer_parens(n, base) = n.parent not ts_parenthesized
  && (n is ts_class.extends
    || n is ts_arrow.body && !exponentiation_base_parens(base) && (base is ts_object || base.first_token.text == "{{")
    || n.parent is expression_fix_precedence_owner && n.parent.precedence >= 14
    && !(n is ts_binary.right && n.parent.operator == "**")
    && n not (ts_call.argument, ts_new.argument, ts_import_call.argument, ts_index.index))
fn exponentiation_statement_head(base) = base is (ts_function, ts_class, ts_object)
  || { value ["function", "class", "{{"]; contains base.first_token.text }
  || base.first_token.text == "async" && re_test(base.text, /^async\s+function\b/)
fn exponentiation_text(n, base, exponent) = {
  value text: (
    { value base; needed: exponentiation_base_parens; value expression_fix_wrap(base.text, needed) }
    "**" expression_fix_wrap(exponent.text, exponent.precedence < 14 || exponent is structure_assertion)
  )
  value needed_2: exponentiation_outer_parens(n, base) || expression_fix_statement(n) != null && exponentiation_statement_head(base) && !exponentiation_base_parens(base)
  value expression_fix_wrap(text, needed_2)
}
fn exponentiation_asi(n, text) = {
  value statement: expression_fix_statement(n)
  value if statement != null && {
    value text
    slice 0 1
    then (head) contains(["(", "[", "/", "`"], head)
  } then {
    value owners: expression_fix_before_nodes(n)
    value expression_fix_asi(statement, n.token_neighbours.before, owners)
  } else false
}
fn exponentiation_fix_result(n, text, semicolon) = if semicolon == null then null
  else (if semicolon then ";" else "") expression_fix_edges(n, text)
fn exponentiation_fix_output(n, text) = { value n; semicolon: exponentiation_asi text; value exponentiation_fix_result(n, text, semicolon) }
fn exponentiation_fix(n) =
  if count(n.argument.node) != 2 || any(n.argument.nodes, argument => argument is ts_spread) || !expression_fix_clean(n) then null
  else {
    value n.argument.nodes
    first
    base: unparenthesised_node
    value n.argument.nodes
    last
    exponent: unparenthesised_node
    value text: exponentiation_text(n, base, exponent)
    value exponentiation_fix_output(n, text)
  }

in ts_call rule prefer-exponentiation-operator {
  when global_method_callee == "Math.pow"
  let power_text exponentiation_fix(node)
  warn "Use the '**' operator instead of 'Math.pow'."
  fix if power_text != null as power_text
}

fn logical_chain_top(n) = n is (ts_member, ts_index, ts_call) && n.in_optional_chain == true && n not (ts_member.object, ts_index.object, ts_call.callee, ts_non_null.expression)
fn logical_reference(n) = n != null && !logical_chain_top(n) && (n is (ts_member, ts_index) || n is ts_identifier && n.text != "undefined")
fn logical_same_reference(a, b) = a.reference_key != null && a.reference_key == b.reference_key
fn logical_nullish(n) = if n is ts_null then false else if n is ts_identifier && n.text == "undefined" && n.resolved == "global" || n is ts_unary && n.operator == "void" && unparenthesised_node(n.argument.node) is ts_number && unparenthesised_node(n.argument.node).literal_value.value == 0 then true else null
fn logical_nullish_reference(reference, value) = if logical_reference(reference) && logical_nullish(value) != null then { reference: reference, undefined: logical_nullish(value), operator: "??" } else null
fn logical_nullish_comparison(n, op) = if n is ts_binary && n.operator == op then {
  value n.left.node
  reference: unparenthesised_node
  value n.right.node
  value_2: unparenthesised_node
  value logical_nullish_reference(reference, value_2)
  nonempty
} ?? {
  value n.right.node
  reference_2: unparenthesised_node
  value n.left.node
  value_3: unparenthesised_node
  value logical_nullish_reference(reference_2, value_3)
} else null
fn logical_nullish_pair(a, b) = if a != null && b != null && a.undefined != b.undefined && logical_same_reference(a.reference, b.reference) then a else null
fn logical_boolean_existence(n, negated) = if logical_reference(n) then { reference: n, operator: if negated then "||" else "&&" } else if n is ts_unary && n.operator == "!" && { value n.argument.node; unparenthesised_node; logical_reference } then { reference: unparenthesised_node(n.argument.node), operator: "&&" } else if n is ts_call && n.global_callee == "Boolean" && count(n.argument.node) == 1 && {
  value n.argument.node
  first
  unparenthesised_node
  logical_reference
} then { reference: { value n.argument.node; first; unparenthesised_node }, operator: if negated then "||" else "&&" } else null
fn logical_existence(n) = {
  value if n is ts_unary && n.operator == "!" then n.argument.node else n
  unparenthesised_node
  logical_boolean_existence (n is ts_unary && n.operator == "!")
  nonempty
} ?? { value n; logical_nullish_comparison "=="; nonempty } ?? if n is ts_logical && n.operator == "||" then {
  value n.left.node
  unparenthesised_node
  logical_nullish_comparison: logical_nullish_comparison "==="
  value n.right.node
  unparenthesised_node
  logical_nullish_comparison_2: logical_nullish_comparison "==="
  value logical_nullish_pair(logical_nullish_comparison, logical_nullish_comparison_2)
} else null
fn logical_leftmost(value) = {
  value value.left.node
  walk (current) if current is ts_logical && current.operator == value.operator then current.left.node else null
  last
}
fn logical_assignment_value(assigned, value) = if value is ts_logical && { value value; logical_leftmost: logical_leftmost; value logical_same_reference(assigned, logical_leftmost) } then { kind: "assignment", operator: value.operator "=" } else null
fn logical_expression_value(reference, assignment, op, kind) = if logical_reference(reference) && assignment is ts_assignment && assignment.operator == "=" && logical_same_reference(reference, assignment.left.node) then { kind: kind, operator: op "=" } else null
fn logical_if_body(n) = if n.consequent is ts_block then (if count(n.consequent.body.node) == 1 then first(n.consequent.body.node) else null) else n.consequent.node
fn logical_if_value(existence, body) = if existence != null && body is ts_expression_statement then {
  value body.expression.node
  assignment: unparenthesised_node
  value logical_expression_value(existence.reference, assignment, existence.operator, "if")
} else null
fn logical_assignment_info(n) = if n is ts_assignment && contains(["&&=", "||=", "??="], n.operator) then { kind: "shorthand", operator: n.operator } else if n is ts_assignment && n.operator == "=" then { value n.right.node; value_2: unparenthesised_node; value logical_assignment_value(n.left.node, value_2) } else if n is ts_logical then {
  value n.left.node
  reference: unparenthesised_node
  value n.right.node
  assignment: unparenthesised_node
  value logical_expression_value(reference, assignment, n.operator, "logical")
} else if n is ts_if && n.alternate == null then {
  value n.test.node
  unparenthesised_node
  existence: logical_existence
  value n
  body: logical_if_body
  value logical_if_value(existence, body)
} else null
fn logical_fix_root(n) = {
  value n
  walk (current) current.parent.node
  filter (current) current is ts_program
  first
}
fn logical_fix_with(n) = !logical_fix_root(n).scoping_strict_code
  && { value n; walk (current) current.parent.node; any (current) current is ts_with.body }
fn logical_fix_identifier(n) = n is ts_identifier && !logical_fix_with(n)
# Getters can change a mutable base or key between the read and write.
# Ambient const declarations provide types, not immutable runtime bindings.
fn logical_fix_const(n) = n.scoping_definition_use.kind == "const" && n.declaration != null
  && !{ value n.declaration.node; walk (current) current.parent.node; any (current) contains([] current.modifier, "declare") }
  && {
    value n.declaration.node
    walk (current) if current is ts_declarator then null else current.parent.node
    any (current) current is ts_declarator && (current.init != null || current.parent is (ts_for_in.left, ts_for_of.left))
  }
fn logical_fix_property(n) = !logical_fix_with(n) && n is (ts_member, ts_index)
  && (unparenthesised_node(n.object.node) is ts_this
    || unparenthesised_node(n.object.node) is ts_identifier && { value n.object.node; unparenthesised_node; logical_fix_const })
  && (n is ts_member || unparenthesised_node(n.index.node) is (ts_string, ts_number, ts_bigint, ts_boolean, ts_null))
fn logical_fix_operator(source, n, operator) = byte_slice(source, n.offset, n.operator.offset) operator byte_slice(source, n.operator.end_offset, n.end_offset)
fn logical_fix_expand(source, n) = if !{ value n.left.node; unparenthesised_node; logical_fix_identifier } then null
  else (byte_slice(source, n.offset, n.operator.offset) "= " unparenthesised_node(n.left.node).text " " slice(n.operator, 0, -1)
    byte_slice(source, n.operator.end_offset, n.right.offset)
    {
      value needed: n.right not ts_parenthesized
      && (n.right is structure_assertion || n.right.precedence <= (if n.operator == "&&=" then 5 else 4) || n.operator == "??=" && n.right is ts_logical)
      value expression_fix_wrap(n.right.text, needed)
    })
fn logical_fix_assignment(source, n, value, first) = if !{ value n.left.node; unparenthesised_node; logical_fix_identifier } then null
  else (byte_slice(source, n.offset, n.operator.offset) value.operator "="
    byte_slice(source, n.operator.end_offset, first.parent.offset) byte_slice(source, first.parent.right.offset, n.end_offset))
fn logical_fix_expression(source, n, assignment) = if !{ value n.left.node; unparenthesised_node; logical_fix_identifier } && !{ value n.left.node; unparenthesised_node; logical_fix_property } then null
  else if expression_fix_parens(source, n, assignment) == null then null
  else {
    value source
    text: logical_fix_operator assignment (n.operator "=")
    value needed: expression_fix_parens(source, n, assignment) > 0
    value expression_fix_wrap(text, needed)
  }
fn logical_fix_if(source, n, body, assignment, existence) =
  if !logical_fix_identifier(existence.reference) && !(unparenthesised_node(n.test.node) not ts_logical && logical_fix_property(existence.reference)) then null
  else if n.token_neighbours.before != null && !{ value [";", "{{"]; contains n.token_neighbours.before.text }
    && !re_test(body.first_token.text, /^[\w$\\]/) then null
  else (byte_slice(source, body.offset, assignment.operator.offset) existence.operator "="
    byte_slice(source, assignment.operator.end_offset, body.end_offset)
    (if n.consequent is ts_block && !{ value body.text; trim_end; ends_with ";" } then ";" else ""))
fn logical_assignment_fix(source, n, info) = if !expression_fix_clean(n) then null
  else if info.kind == "shorthand" then logical_fix_expand(source, n)
  else if info.kind == "assignment" then {
    value n.right.node
    value_2: unparenthesised_node
    value n.right.node
    unparenthesised_node
    first: logical_leftmost
    value logical_fix_assignment(source, n, value_2, first)
  }
  else if info.kind == "logical" then { value n.right.node; assignment: unparenthesised_node; value logical_fix_expression(source, n, assignment) }
  else {
    value n
    body: logical_if_body
    value logical_if_body(n).expression.node
    assignment_2: unparenthesised_node
    value n.test.node
    unparenthesised_node
    existence: logical_existence
    value logical_fix_if(source, n, body, assignment_2, existence)
  }

in ts_assignment, ts_logical, ts_if rule logical-assignment-operators {
  option mode ("always" | "never") = "always" "logical assignment policy"
  option enforceForIfStatements boolean = false "include conditional assignments"
  when not ts_if || enforceForIfStatements
  let logical_info logical_assignment_info(node)
  when logical_info != null
  when if mode == "never" then logical_info.kind == "shorthand" else logical_info.kind != "shorthand"
  let logical_text logical_assignment_fix(source, node, logical_info)
  warn if mode == "never" then "Unexpected logical operator assignment ({logical_info.operator}) shorthand." else if logical_info.kind == "assignment" then "Assignment (=) can be replaced with operator assignment ({logical_info.operator})." else if logical_info.kind == "logical" then "Logical expression can be replaced with an assignment ({logical_info.operator})." else "'if' statement can be replaced with a logical operator assignment with operator {logical_info.operator}."
  fix if logical_text != null as logical_text
}

}
