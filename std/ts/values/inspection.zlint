define {

fn ts_value_has_trait(n, trait) = {
  value arms: value_parts(n)
  value if arms == null then null else any(arms, arm => any(arm.parts, part => contains(part.traits, trait)))
}
fn ts_value_has_void(n) = ts_value_has_trait(n, "void")
fn ts_value_callable(n) = {
  value signatures: value_signatures(n)
  value signatures != null && count(signatures) > 0 && all(signatures, arm => count(arm) > 0)
}
# The value can't be computed (unsupported or unresolved), unlike explicit `unknown`.
fn ts_value_opaque(n) = value_parts(n) == null
fn ts_value_trait(parts, trait) = parts != null && len(parts) > 0
  && all(parts, arm => any(arm, part => contains(part.traits, trait)))
fn ts_value_category(parts) = if parts != null && any(parts, arm => any(arm, part => contains(part.traits, "error"))) then "error"
  else if ts_value_trait(parts, "any") then "any" else null
fn ts_value_string_like(n) = {
  value arms: value_parts(n)
  value arms != null && len(arms) > 0 && all(arms, arm =>
    any(arm.parts, part => contains(part.traits, "string"))
    && all(arm.parts, part => contains(part.traits, "intersection") || contains(part.traits, "parameter")
      || !contains(part.traits, "any") && !contains(part.traits, "unknown") && !contains(part.uncertain_traits, "string")))
}
fn ts_value_parameter(n) = {
  value arms: value_parts(n)
  value arms != null && len(arms) > 0 && all(arms, arm => any(arm.parts, part => part.carrier_known && part.carrier.description.kind == "parameter"))
}
fn ts_value_string(text) = {
  value slashes: replace(text, "\\", "\\\\")
  value quotes: replace(slashes, "\"", "\\\"")
  value lines: replace(quotes, "\n", "\\n")
  value "\"" lines "\""
}
# A literal's truthy/falsy split prints one label, so parenthesise on distinct
# printed arms: a union needs brackets, a nested array keeps its own.
fn ts_value_print_element_mode(parts) = {
  value labels: unique(map(parts ?? [], arm => ts_value_print_arm(arm)))
  value if count(labels) > 1 then "wrap"
    else if count(labels) == 1 && contains(first(labels), " & ") then "wrap" else "plain"
}
fn ts_value_print_element(parts, text) = if ts_value_print_element_mode(parts) == "wrap" then "(" text ")" else text
# TypeScript sorts union constituents by type flags (`stableTypeOrdering`),
# with `null` and `undefined` always printed last.
fn ts_value_print_part_rank(part) = {
  value traits: part.traits
  value literal: part.identity_known && part.identity.kind == "value"
  value unique: part.identity_known && part.identity.kind != "value"
  value when {
    contains(traits, "intersection") then 268435456
    contains(traits, "null") then 2000000
    contains(traits, "undefined") then 2000001
    contains(traits, "any") then 1
    contains(traits, "unknown") then 2
    contains(traits, "void") then 16
    contains(traits, "string") then (if literal then 1024 else 32)
    contains(traits, "number") then (if literal then 2048 else 64)
    contains(traits, "bigint") then (if literal then 4096 else 128)
    contains(traits, "boolean") then (if literal then 8192 else 256)
    contains(traits, "symbol") then (if unique then 16384 else 512)
    contains(traits, "enum") then 65536
    contains(traits, "never") then 262144
    contains(traits, "parameter") then 524288
    else then 1048576
  }
}
fn ts_value_print_arm_rank(arm) = if any(arm, part => contains(part.traits, "intersection")) then 268435456
  else if count(arm) == 0 then 1048576 else first(map(arm, part => ts_value_print_part_rank(part)))
fn ts_value_print_part(part) = {
  value carrier: part.carrier
  value args: if carrier.description.kind == "tuple" && part.product_known && part.product != null then
    map(zip(carrier.arguments ?? [], part.product.elements), pair => {
      value flags: last(pair)
      value (if flags.repeated then "..." else "") ts_value_print(first(pair)) (if flags.optional then "?" else "")
    })
    else map(carrier.arguments ?? [], item => ts_value_print(item))
  value joined: { value args; join ", " }
  value elements: zip(carrier.arguments ?? [], args, (item, text) => ts_value_print_element(item, text))
  value joined_elements: { value elements; join ", " }
  value scalar: find(["any", "unknown", "void", "null", "undefined", "string", "number", "boolean", "bigint", "symbol", "object"], trait => contains(part.traits, trait))
  value literal: part.identity.kind == "value" && part.identity_known
  value if carrier.description.kind == "tuple" then (if part.product.readonly then "readonly " else "") "[" joined "]"
    else if carrier.description.kind == "array" then (if part.product.readonly then "readonly " else "") joined_elements "[]"
    else if carrier.description.kind == "named" then carrier.description.name (if len(args) == 0 then "" else "<" joined ">")
    else if carrier.description.kind == "parameter" then carrier.description.name
    else if scalar == "symbol" && part.identity_known && part.identity != null && part.identity.kind != "value" then "unique symbol"
    else if literal && scalar == "string" then ts_value_string(part.identity.value)
    else if literal && scalar == "bigint" then part.identity.value.value "n"
    else if literal && (scalar == "number" || scalar == "boolean") then "" part.identity.value
    else scalar ?? "unknown"
}
fn ts_value_print_arm(arm) = {
  value labels: map(arm, part => {
    value text: ts_value_print_part(part)
    value { text: text, parameter: contains(part.traits, "parameter") }
  })
  value definite: filter(labels, item => item.text != "unknown")
  value content: filter(definite, item => !item.parameter)
  value kept: if count(content) > 0 then content else if count(definite) > 0 then definite else [{ text: "unknown" }]
  value { value kept; map (item) item.text; unique; join " & " }
}
fn ts_value_print(parts) = if parts == null then "unknown" else if len(parts) == 0 then "never" else {
  value labels: map(parts, arm => ts_value_print_arm(arm))
  value ranked: zip(labels, map(parts, arm => ts_value_print_arm_rank(arm)), (label, rank) => { label: label, rank: rank })
  value { value ranked; sort_by (pair) pair.rank; map (pair) pair.label; unique; join " | " }
}
fn ts_value_print_member(edge, seen) = {
  value key: edge.member.key
  value name: if type_of(key) == "num" then "" key
    else if type_of(key) != "str" then null
    else if re_test(key, /^[$A-Za-z_][$A-Za-z_0-9]*$/) then key else ts_value_string(key)
  value prefix: if any(edge.member.sources, source => contains(source.flags, "readonly")) then "readonly " else ""
  value optional: if edge.member.optional then "?" else ""
  value result: ts_value_print_handle_seen(edge.handle, seen)
  value if name == null || edge.member.optional == null
    || any(edge.member.sources, source => source.flags == null) then "unknown"
    else "{prefix}{name}{optional}: {result};"
}
fn ts_value_print_handle_part(part, seen) = {
  value structural: part.carrier == null && contains(part.traits, "structural")
    && !contains(part.traits, "callable") && !contains(part.traits, "constructible")
  value children: if structural then value_children(part.handle, true, []) else null
  value members: map(children ?? [], edge => ts_value_print_member(edge, seen))
  value if !structural then ts_value_print(value_constituents(part.handle))
    else if children == null then "unknown"
    else if count(children) == 0 then "{{}}"
    else "{{ " {value members; join " "} " }}"
}
fn ts_value_print_handle_arm(arm, seen, n) = if count(arm.parts) == 0 then "unknown" else {
  value printed: map(arm.parts, part => {
    value text: ts_value_print_handle_part(part, [] seen n)
    value { text: text, parameter: contains(part.traits, "parameter") }
  })
  value definite: filter(printed, item => item.text != "unknown")
  value content: filter(definite, item => !item.parameter)
  value kept: if count(content) > 0 then content else if count(definite) > 0 then definite else [{ text: "unknown" }]
  value { value kept; map (item) item.text; unique; join " & " }
}
fn ts_value_print_handle_seen(n, seen) = {
  value arms: if contains(seen, n) then null else value_parts(n)
  value labels: map(arms ?? [], arm => ts_value_print_handle_arm(arm, seen, n))
  value ranked: zip(labels, map(arms ?? [], arm => ts_value_print_arm_rank(arm.parts)), (label, rank) => { label: label, rank: rank })
  value if arms == null then "unknown" else if count(arms) == 0 then "never"
    else {value ranked; sort_by (pair) pair.rank; map (pair) pair.label; unique; join " | "}
}
fn ts_value_print_handle(n) = ts_value_print_handle_seen(n, [])
# The type TypeScript prints for an expression: a type parameter stands for its
# constraint (`any` counts as `unknown`), and a reference keeps its written name.
fn ts_value_print_annotation(n) = if n is ts_identifier && name_binding(n) != null
  && name_binding(n).node.parent.type != null then name_binding(n).node.parent.type.node else null
fn ts_value_print_written(n) = {
  value annotation: ts_value_print_annotation(n)
  value named: annotation is ts_type_reference && annotation.name is ts_identifier
    && !ts_value_has_trait(annotation, "parameter")
    && !contains(["Array", "ReadonlyArray"], annotation.name.text)
  value if named then annotation.text else null
}
fn ts_value_print_annotation_parameter(annotation) = if annotation is ts_type_reference
  && annotation.name is ts_identifier && count(annotation.type_argument.nodes) == 0
  && name_binding(annotation.name.node) != null
  && name_binding(annotation.name.node).node.parent is ts_type_parameter
  then name_binding(annotation.name.node).node.parent else null
fn ts_value_print_type(n) = {
  value annotation: ts_value_print_annotation(n)
  value parameter: if annotation != null then ts_value_print_annotation_parameter(annotation) else null
  value written: ts_value_print_written(n)
  value if parameter != null && parameter.constraint != null && parameter.constraint.text == "any" then "unknown"
    else written ?? ts_value_print_handle(n)
}
fn ts_value_symbol_key(n, key) = {
  value roots: global_declarations(n, "Symbol", "value")
  value properties: map(roots ?? [], root => value_constituents(value_lookup(declaration_value(n, root), key).member))
  value parts: flat_map(properties, property => flat_map(property ?? [], arm => arm))
  value identity: first(parts).identity
  value if roots != null && count(parts) > 0 && all(properties, property => property != null)
    && all(parts, part => contains(part.traits, "symbol") && part.identity_known
      && part.identity.kind == "declaration" && part.identity == identity)
    then {symbol: {file: identity.file, node: identity.node}} else null
}

fn ts_value_ancestry_links(handle) = {
  value bases: value_bases(handle)
  value projected: map(bases ?? [], base => value_parts(base))
  value parts: flat_map(projected, arms => flat_map(arms ?? [], arm => arm.parts))
  value {parts: parts, complete: bases != null && all(projected, arms => arms != null)}
}
fn ts_value_ancestry(part) = {
  value reached: walk([part.handle], handle =>
    map(ts_value_ancestry_links(handle).parts, base => base.handle))
  value parts: flat_map(reached, handle => flat_map(value_parts(handle) ?? [], arm => arm.parts))
  value complete: count(reached) > 0 && all(reached, handle => ts_value_ancestry_links(handle).complete)
  value {parts: parts, complete: complete}
}
fn ts_value_builtin_part(part, n, names) = {
  value states: map(names, name => {
    value carrier: part.carrier
    value globals: global_declarations(n, name, "type")
    value site: {file: carrier.file, node: carrier.node}
    value matched: carrier != null && globals != null && contains(globals, site)
    value origin: if matched then declaration_origin(n, site) else null
    value if !part.carrier_known || globals == null then null
      else if !matched then false
      else if origin == null then null
      else origin.kind == "library"
  })
  value if any(states, state => state == true) then true
    else if any(states, state => state == null) then null
    else false
}
fn ts_value_builtin_ancestor(part, n, names) = {
  value ancestry: ts_value_ancestry(part)
  value states: map(ancestry.parts, item => ts_value_builtin_part(item, n, names))
  value if any(states, state => state == true) then true
    else if !ancestry.complete || any(states, state => state == null) then null
    else false
}
fn ts_value_builtin_values(n, names) = {
  value globals: map(names, name => global_declarations(n, name, "value"))
  value projections: map(flat_map(globals, rows => rows ?? []), site => {
    value origin: declaration_origin(n, site)
    value arms: if origin.kind == "library" then value_parts(declaration_value(n, site)) else []
    value parts: flat_map(arms ?? [], arm => arm.parts)
    value {
      parts: parts,
      complete: origin != null && arms != null && all(parts, part => part.carrier_known)
    }
  })
  value {
    parts: flat_map(projections, projection => projection.parts),
    complete: all(globals, rows => rows != null) && all(projections, projection => projection.complete)
  }
}
fn ts_value_builtin_value_ancestor(part, n, names) = {
  value ancestry: ts_value_ancestry(part)
  value canonical: ts_value_builtin_values(n, names)
  value states: flat_map(ancestry.parts, item => map(canonical.parts, target => {
    value matched: item.carrier != null && target.carrier != null
      && item.carrier.file == target.carrier.file && item.carrier.node == target.carrier.node
    value if !item.carrier_known || !target.carrier_known then null
      else if !matched then false
      else if contains(target.uncertain_traits, "constructible") then null
      else if !contains(target.traits, "constructible") then true
      else if contains(item.uncertain_traits, "constructible") then null
      else contains(item.traits, "constructible")
  }))
  value if any(states, state => state == true) then true
    else if !ancestry.complete || !canonical.complete || any(states, state => state == null) then null
    else false
}
fn ts_value_builtin_type(n, names) = {
  value arms: value_parts(n)
  value if arms == null then null else if count(arms) != 1 then false else {
    value states: map(first(arms).parts, part => ts_value_builtin_ancestor(part, n, names))
    value if any(states, state => state == true) then true
      else if any(states, state => state == null) then null
      else false
  }
}
fn ts_value_builtin_constructor(n, names) = {
  value arms: value_parts(n)
  value if arms == null then null else if count(arms) == 0 then false else {
    value states: map(arms, arm => {
      value parts: map(arm.parts, part => ts_value_builtin_value_ancestor(part, n, names))
      value if any(parts, part => part == true) then true
        else if any(parts, part => part == null) then null
        else false
    })
    value if any(states, state => state == false) then false
      else if any(states, state => state == null) then null
      else true
  }
}

}
