define {

fn ts_value_enum_literal(n) = {
  value bare: unparenthesised_node(n)
  value direct: bare is (ts_number, ts_string) || bare is ts_unary
    && (bare.operator == "-" || bare.operator == "+") && bare.argument is ts_number
  value part: if direct then ts_value_scalar_part(bare) else null
  value if part != null && part.identity_known && part.identity.kind == "value"
    then part.identity.value else null
}
fn ts_value_enum_prior(n) = {
  value members: n.parent.member.nodes
  value position: index_of(members, n)
  value earlier: { value members; slice 0 position }
  value bare: unparenthesised_node(n.init.node)
  value if bare is ts_identifier then find(earlier, member => ts_value_key(member.name.node) == bare.text)
    else null
}
in ts_enum {
  scope statics
  scope enum_origin
  members statics closed
  fits object, truthy, nonthenable in statics
  fits enum in enum_origin open
  carries as { kind: "enum", name: name.text }
  unwraps ...member for type
  unwraps scope statics from it
}
in ts_namespace {
  let ts_value_namespace_enum_members {
    value name_binding(name.node).declarations
    filter (site) site.parent is ts_enum
    flat_map (site) site.parent.member.nodes
  }
  when count(ts_value_namespace_enum_members) > 0 {
    unwraps ...ts_value_namespace_enum_members for type
  }
}
in ts_enum_member {
  declares member name keyed ts_value_key(it) in nearest statics hoisted
  let ts_value_enum_previous {
    value members: parent.member.nodes
    value position: index_of(members, node)
    value if position > 0 then { value members; slice (position - 1) position; first } else null
  }
  let ts_value_enum_literal if init != null then ts_value_enum_literal(init.node)
    else if ts_value_enum_previous == null then 0
    else if type_of(ts_value_enum_previous.ts_value_enum_literal) == "num"
      then ts_value_enum_previous.ts_value_enum_literal + 1 else null
  let ts_value_enum_prior ts_value_enum_prior(node)
  let ts_value_enum_kind if type_of(ts_value_enum_literal) == "num" then "number"
    else if type_of(ts_value_enum_literal) == "str" then "string"
    else if init == null then "number"
    else if ts_value_enum_prior != null then ts_value_enum_prior.ts_value_enum_kind
    else if init always number then "number"
    else if init always string then "string" else null
  when ts_value_enum_kind != null {
    fits number, nonthenable when ts_value_enum_kind == "number"
    fits string, nonthenable when ts_value_enum_kind == "string"
    fits falsy when ts_value_enum_literal != null && (ts_value_enum_literal == 0 || ts_value_enum_literal == "")
    fits truthy when ts_value_enum_literal != null && ts_value_enum_literal != 0 && ts_value_enum_literal != ""
    when ts_value_enum_literal != null { identity ts_value_enum_literal }
    when ts_value_enum_literal == null { identity node }
    unwraps (scope enum_origin from parent) & self
    widens ...parent.member
  }
  when ts_value_enum_kind == null { unwraps unknown }
}
in ts_qualified_name {
  arguments parent.type_argument
  let ts_value_qualified_key ts_value_key(right.node)
  defines (from (scope module, namespace from left.definition) at ts_value_qualified_key) ?? (from (scope statics from left.definition) at ts_value_qualified_key)
  unwraps definition
}

}
