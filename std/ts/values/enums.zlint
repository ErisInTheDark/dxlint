define {

fn ts_value_has_enum(n) = any(value_constituents(n) ?? [], arm => any(arm, part => contains(part.traits, "enum")))
fn ts_value_enum_literal(n) = {
  value bare: unparenthesised_node(n)
  value if bare is ts_number then bare.ts_value_number
    else if bare is ts_string then js_string(bare.text)
    else if bare is ts_unary && bare.operator == "-" && bare.argument is ts_number
      then -bare.argument.ts_value_number
    else null
}
fn ts_value_enum_prior(n) = {
  value bare: unparenthesised_node(n.init.node)
  value if bare not ts_identifier then null else {
    value earlier: take(n.parent.member.nodes, node_ordinal(n))
    value find(earlier, member => ts_value_key(member.name.node) == bare.text)
  }
}
in ts_enum {
  let ts_value_enum_literals {
    value members: member.nodes
    value states: {
      value { index: 0, literal: null }
      walk (state) if state.index >= len(members) then null else {
        value member: get(members, state.index)
        value literal: if member.init != null then ts_value_enum_literal(member.init.node)
          else if state.index == 0 then 0
          else if type_of(state.literal) == "num" then state.literal + 1 else null
        value { index: state.index + 1, literal: literal }
      }
      drop 1
    }
    value map(states, state => state.literal)
  }
  scope statics
  scope enum_origin
  members statics closed
  fits object, truthy, nonthenable in statics
  fits enum in enum_origin open
  carries as { kind: "enum", name: name.text, first_member_kind: first(member.nodes).ts_value_enum_kind ?? "number" }
  unwraps ...member for type
  unwraps scope statics from it
}
in ts_namespace {
  let ts_value_namespace_enum_members {
    value name_binding(name.node).declarations
    filter (site) site.parent is ts_enum
    flat_map (site) site.parent.member.nodes
  }
  when count(ts_value_namespace_enum_members) > 0 {
    unwraps ...ts_value_namespace_enum_members for type
  }
}
in ts_enum_member {
  declares member name keyed ts_value_key(it) in nearest statics hoisted
  let ts_value_enum_literal if init != null then ts_value_enum_literal(init.node)
    else if node_ordinal(node) == 0 then 0
    else get(parent.ts_value_enum_literals, node_ordinal(node))
  let ts_value_enum_prior ts_value_enum_prior(node)
  let ts_value_enum_kind when {
    type_of(ts_value_enum_literal) == "num" then "number"
    type_of(ts_value_enum_literal) == "str" then "string"
    init == null then "number"
    ts_value_enum_prior != null then ts_value_enum_prior.ts_value_enum_kind
    init always number then "number"
    init always string then "string"
    else then null
  }
  when ts_value_enum_kind != null {
    fits number, nonthenable when ts_value_enum_kind == "number"
    fits string, nonthenable when ts_value_enum_kind == "string"
    fits falsy when ts_value_enum_literal != null && (ts_value_enum_literal == 0 || ts_value_enum_literal == "")
    fits truthy when ts_value_enum_literal != null && ts_value_enum_literal != 0 && ts_value_enum_literal != ""
    when ts_value_enum_literal != null { identity ts_value_enum_literal }
    when ts_value_enum_literal == null { identity node }
    unwraps (scope enum_origin from parent) & self
    widens ...parent.member
  }
  when ts_value_enum_kind == null { unwraps unknown }
}
in ts_qualified_name {
  arguments parent.type_argument
  let ts_value_qualified_key ts_value_key(right.node)
  defines (scope module, namespace from left.definition).[ts_value_qualified_key] ?? (scope statics from left.definition).[ts_value_qualified_key]
  unwraps definition
}

}
