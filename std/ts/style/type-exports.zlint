import .ts/expression-fixes
import .ts/style/type-imports

define {
in ts_export_specifier {
  let export_spaces symbol_spaces
  let export_type kind == null && export_spaces != null && !export_spaces.value
  let export_value kind == null && export_spaces.value == true
  let export_name local.literal_value.value ?? local.text
  let export_alias { value children.nodes; filter (item) item is ts_export_specifier.exported; first }
}
in ts_export {
  let export_types { value specifier.nodes; filter (item) item.export_type }
  let export_values { value specifier.nodes; filter (item) item.export_value }
  let export_inline { value specifier.nodes; filter (item) item.kind == "type" }
  let export_names { value export_types; map (item) item.export_name }
  let export_module module_exports
  let export_star operator == "*" && export_module != null && export_module.complete && !any(export_module.exports, item => item.spaces.value == true)
}
fn export_specifier_text(item) = if item.export_alias != null then item.local.text " as " item.export_alias.text else item.local.text
fn export_policy_text(source, n, inline) = if n.operator == "*" then {
  value edits: [{ start: n.operator.offset, end: n.operator.offset, text: "type " }]
  value expression_fix_edits(n.text, n.offset, edits)
} else if count(n.export_values) == 0 then {
  value removals: map(n.export_inline, item => import_remove_type(source, item))
  value edits: [{ start: n.first_token.end, end: n.first_token.end, text: " type" }] removals
  value expression_fix_edits(n.text, n.offset, edits)
} else if inline then {
  value edits: map(n.export_types, item => { start: item.offset, end: item.offset, text: "type " })
  value expression_fix_edits(n.text, n.offset, edits)
} else {
  value open: { value overlapping(ts_open_brace, n.first_token.end, n.end_offset); first }
  value close: open.paired_token
  value types: { value n.export_types n.export_inline; map (item) export_specifier_text(item); join ", " }
  value values: { value n.export_values; map (item) export_specifier_text(item); join ", " }
  value edits: [{ start: open.end_offset, end: close.start, text: " " values " " }]
  value body: expression_fix_edits(n.text, n.offset, edits)
  value source_suffix: if n.from != null then " from '" n.from.literal_value.value "'" else ""
  value newline: if contains(source, "\r\n") then "\r\n" else "\n"
  value "export type {{ " types " }}" source_suffix ";" newline body
}
in ts_export rule consistent-type-exports {
  option fixMixedExportsWithInlineTypeSpecifier boolean = false "Use inline type specifiers in mixed exports."
  when kind == null && (count(export_types) > 0 || export_star)
  let replacement export_policy_text(source, node, fixMixedExportsWithInlineTypeSpecifier)
  warn if count(export_values) == 0 then "All exports in the declaration are only used as types. Use `export type`."
    else if count(export_types) == 1 then "Type export {first(export_names)} is not a value and should be exported using `export type`."
    else "Type exports {word_list(export_names)} are not values and should be exported using `export type`."
  fix at node if expression_fix_retains_comments(node, replacement) as replacement
}
}
