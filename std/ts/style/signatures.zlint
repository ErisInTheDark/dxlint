# .ts/style/signatures: internal part of .ts/style.
import .ts/expression-fixes

define {

fn signature_key_shape(key, name) = when {
  key is ts_private_name then "private"
  key is (ts_identifier, ts_string, ts_number, ts_bigint, ts_boolean, ts_null) then if starts_with(name, '"') then "quoted" else "normal"
  else then "expression"
}
in ts_function let overload_identity if name != null then { name: name, shape: "normal", static: null, call: false } else null
in ts_method, ts_method_signature let overload_identity { name: style_member_name, shape: { value key.member_key_node.nonempty ?? key.node; signature_key_shape style_member_name }, static: if is ts_method then is_static else null, call: false }
in ts_call_signature let overload_identity { name: if kind == "new" then "new" else "call", shape: "normal", static: null, call: kind != "new" }
in ts_export forward overload_identity from declaration
in ts_function, ts_method, ts_method_signature, ts_call_signature, ts_export let overload_entry { identity: overload_identity, start: offset }
in ts_program, ts_block, ts_class, ts_interface, ts_type_literal let overload_entries [] children.overload_entry
fn earlier_overload(entries, identity, start) = any(entries, e => e.start < start && e.identity == identity)
fn overload_report_site(n) = {
  value terminator: n.token_neighbours.after
  value bodiless: n is (ts_method_signature, ts_call_signature) || n.body == null
  value separated: bodiless && terminator != null && terminator.text == ";" && terminator.start == n.end_offset
  value { start: n.offset, end: if separated then terminator.end else n.end_offset }
}
in ts_function, ts_method, ts_method_signature, ts_call_signature, ts_export rule adjacent-overload-signatures {
  when parent is (ts_program, ts_block, ts_class, ts_interface, ts_type_literal)
  when overload_identity != null && overload_identity != previous.overload_identity
  when earlier_overload(parent.overload_entries, overload_identity, offset)
  let identity overload_identity
  report at overload_report_site(node)
  warn "All {if identity.static == true then 'static ' else ''}{identity.name} signatures should be adjacent."
}

# `new (): I` in interface `I` (type arguments aside), and `constructor()`
# signatures in interfaces and type literals.
in ts_call_signature rule no-misused-new {
  when parent is ts_interface && kind == "new" && { value return_type.nonempty ?? ""; re_replace /\s*<[\s\S]*$/ "" } == ts_interface.name
  report at { start: offset, end: signature_source_end }
  warn "Interfaces cannot be constructed, only classes."
}
in ts_method_signature rule no-misused-new:constructor {
  when key == "constructor"
  report at { start: offset, end: signature_source_end }
  warn "Interfaces cannot be constructed, only classes."
}
in ts_method rule no-misused-new:class {
  when key == "new" && body == null && return_type == ts_class.name
  warn "Class cannot have method named `new`."
}

# ---- functions -----------------------------------------------------------------------
in ts_function_type let is_function_type kind != "new"
in ts_property_signature let signature_callable_node type.node
in ts_method_signature, ts_property_signature let signature_source_key
  (if contains(modifier, "readonly") then "readonly " else "") key.text (if optional != null then "?" else "")
in ts_method_signature, ts_property_signature, ts_call_signature let signature_source_end
  if contains([";", ","], token_neighbours.after.text) then token_neighbours.after.end else end_offset
in ts_method_signature, ts_property_signature let signature_source_delimiter
  if contains([";", ","], token_neighbours.after.text) then token_neighbours.after.text else ""
group signature_separator ts_semicolon, ts_comma
in ts_method_signature let signature_source_next {
  value delimiters: overlapping(signature_separator, end_offset, signature_source_end)
  value delimiter: first(delimiters)
  value delimiter.token_neighbours.after.start ?? token_neighbours.after.start
}
fn signature_callable_source(source, n) = {
  value last_type: last(n.type_parameter.nodes)
  value first_parameter: first(n.parameter.nodes)
  value from: last_type.end_offset ?? n.key.end_offset ?? n.offset
  value until: first_parameter.offset ?? n.return_type.offset ?? n.end_offset
  value opening_tokens: overlapping(ts_open_paren, from, until)
  value opening: first(opening_tokens)
  value parameters: if count(n.parameter) == 0 then "()" else byte_slice(source, opening.offset, opening.paired_token.end)
  value first_type: first(n.type_parameter.nodes)
  value closing_tokens: if last_type != null then overlapping(ts_close_angle, last_type.end_offset, opening.offset) else []
  value closing: first(closing_tokens)
  value type_parameters: if first_type != null then byte_slice(source, first_type.token_neighbours.before.start, closing.end_offset) else ""
  value { parameters: type_parameters parameters, result: n.return_type.text ?? "any", return_colon: n.signature_return_colon }
}
in ts_call_signature let signature_return_colon return_type.node.token_neighbours.before

# Only a call signature: a function type says it better.
in style_tree_node let function_this_offset when {
  is ts_type_literal then null
  is ts_type_keyword && text == "this" then offset
  else then { value children.function_this_offset; compact; first }
}
in ts_type_reference let function_base name == "Function"
in ts_interface let function_type_container { name: name, kind: "Interface", eligible: count(member) == 1 && (count(extends) == 0 || count(extends) == 1 && (first([] extends) == "Function" || first([] extends.function_base) == true)), this: function_this_offset }
in ts_type_literal let function_type_container { name: "", kind: "Type literal", eligible: count(member) == 1, this: null }
in ts_interface let function_type_header_end {
  value last_parameter: last(type_parameter.nodes)
  value first_member: first(member.nodes)
  value angle_tokens: if last_parameter != null then overlapping(ts_close_angle, last_parameter.end_offset, first_member.offset) else []
  value first(angle_tokens).end_offset ?? name.end_offset
}
in ts_interface let function_type_name_start name.offset
fn function_type_comments(n) = {
  value before: overlapping(ts_comment, n.token_neighbours.before.end, n.offset)
  value after: overlapping(ts_comment, n.signature_source_end, n.parent.end_offset)
  value before after
}
fn function_type_comment_prefix(comment, member, exported) = comment.text (if exported || starts_with(comment.text, "//") || position(comment.offset).js_line != position(member.offset).js_line then "\n" else " ")
fn function_type_fix(source, n, info) = {
  value owner: n.parent.node
  value exported: owner.parent is ts_export
  value colon: signature_callable_source(source, n).return_colon
  value raw: byte_slice(source, n.offset, colon.start) " =>" byte_slice(source, colon.end, n.end_offset)
  value comments: function_type_comments(n)
  value exported_comments: exported && count(comments) > 0
  value body: if owner is ts_interface then {
    value name: byte_slice(source, owner.function_type_name_start, owner.function_type_header_end)
    value ending: if n.token_neighbours.after.text == ";" then ";" else ""
    value "type " name " = " raw ending
  } else {
    value shape: { kind: "ts_function_type", precedence: 3 }
    value required: expression_fix_parens(source, owner, shape)
    value if required == null then null else expression_fix_wrap(raw, required > 0)
  }
  value replacement: if exported_comments then {
    value prefix: { value comments; map (comment) function_type_comment_prefix(comment, n, true); join "" }
    value prefix byte_slice(source, owner.parent.offset, owner.offset) body
  } else { value comments; fold (body) (text, comment) function_type_comment_prefix(comment, n, false) text }
  value start: if exported_comments then owner.parent.offset else owner.offset
  value span: { offset: start, end_offset: owner.end_offset, text: byte_slice(source, start, owner.end_offset) }
  value if info.this != null || exported && owner.parent.kind == "default" || body == null
    || !expression_fix_retains_comments(span, replacement) then null
    else { start: start, end: owner.end_offset, text: replacement }
}
in ts_call_signature rule prefer-function-type {
  let container parent.function_type_container
  when return_type != null && container.eligible == true
  report at container.this.nonempty ?? offset
  warn if container.this != null then "`this` refers to the function type '" container.name "', did you intend to use a generic `this` parameter like `<Self>(this: Self, ...) => Self` instead?" else container.kind " only has a call signature, you should use a function type instead."
  let edit function_type_fix(source, node, container)
  fix at { start: edit.start ?? offset, end: edit.end ?? offset } if edit != null as edit.text
}
fn signature_return_has_this(n) = n.return_type != null && {
  value nodes: walk([n.return_type.node], child => child.children.nodes)
  value any(nodes, child => child is ts_type_keyword && child.text == "this")
}
fn signature_in_namespace(n) = {
  value ancestors: walk([n], ancestor => ancestor.parent.node)
  value any(ancestors, ancestor => ancestor is ts_namespace)
}
in ts_interface, ts_type_literal let signature_method_groups {
  value member.nodes
  filter (member) member is ts_method_signature && member.kind != "get" && member.kind != "set"
  group_by (member) member.signature_source_key
}
in ts_method_signature let signature_method_group {
  value key: signature_source_key
  value parent.signature_method_groups
  find (group) group.key == key
  then (group) group.items
}
in ts_method_signature let signature_property_edit {
  value representative: first(signature_method_group)
  value if representative == node then signature_property_replacement(source, node) else representative.signature_property_edit
}
fn signature_property_replacement(source, owner) = {
  value key: owner.signature_source_key
  value methods: owner.signature_method_group
  value first_method: first(methods)
  value last_method: last(methods)
  value end: last_method.signature_source_end
  value start: first_method.offset
  value input: byte_slice(source, start, end)
  value signatures: map(methods, method => signature_callable_source(source, method))
  value functions: map(signatures, signature => signature.parameters " => " signature.result)
  value combined: if count(methods) == 1 then first(functions) else { value functions; map (signature) "(" signature ")"; join " & " }
  value edits: map(methods, method => if method.offset == last_method.offset then { start: method.offset, end: end, text: key ": " combined method.signature_source_delimiter } else { start: method.offset, end: method.signature_source_next, text: "" })
  value replacement: expression_fix_edits(input, start, edits)
  value span: { offset: start, end_offset: end, text: input }
  value if !signature_in_namespace(owner) && !any(methods, method => signature_return_has_this(method)) && expression_fix_retains_comments(span, replacement) then { start: start, end: end, text: replacement } else null
}
fn signature_method_replacement(source, owner) = {
  value callable: signature_callable_source(source, owner.signature_callable_node)
  value replacement: owner.signature_source_key callable.parameters ": " callable.result owner.signature_source_delimiter
  value end: owner.signature_source_end
  value input: byte_slice(source, owner.offset, end)
  value span: { offset: owner.offset, end_offset: end, text: input }
  value if !contains(owner.modifier, "readonly") && expression_fix_retains_comments(span, replacement) then { start: owner.offset, end: end, text: replacement } else null
}
in ts_method_signature, ts_property_signature let signature_report_end {
  value next: token(node, "after")
  value if next != null && contains([";", ","], next.text) then next.end else end_offset
}
in ts_method_signature rule method-signature-style {
  option mode ("method" | "property") = "property" "Preferred method signature notation."
  when mode == "property" && kind != "get" && kind != "set"
  report at { start: offset, end: signature_report_end }
  warn "Shorthand method signature is forbidden. Use a function property instead."
  let replacement signature_property_edit
  fix at { start: replacement.start ?? offset, end: replacement.end ?? offset } if replacement != null as replacement.text
}
in ts_property_signature rule method-signature-style:property {
  option mode ("method" | "property") = "property" "Preferred method signature notation."
  when mode == "method" && type.is_function_type == true
  report at { start: offset, end: signature_report_end }
  warn "Function property signature is forbidden. Use a method shorthand instead."
  let replacement signature_method_replacement(source, node)
  fix at { start: replacement.start ?? offset, end: replacement.end ?? offset } if replacement != null as replacement.text
}

in ts_parenthesized_type let unified_inner_type type.unified_bare_type
in ts_parenthesized let unified_inner_type expression.unified_bare_type
in style_tree_node let unified_bare_type unified_inner_type.nonempty ?? text
in ts_identifier, ts_this let unified_parameter_name text
in ts_rest let unified_parameter_name argument.unified_parameter_name
in ts_parameter let unified_parameter { index: index, offset: offset, end: end_offset, line: line, name: name.unified_parameter_name, rest: name is ts_rest, optional: optional != null, type: type.unified_bare_type, raw_type: type, union: type.unified_union_members.nonempty ?? [] }
in ts_type_parameter let unified_type_parameter { name: name, constraint: constraint.unified_bare_type }
in ts_type_parameter let unified_type_name name
in ts_type_reference let unified_outer_type name
in ts_array_type, ts_parenthesized_type let unified_outer_type type.unified_outer_type
in ts_parameter let unified_outer_type type.unified_outer_type
in ts_union let unified_union_children { value [] type.unified_union_members; fold ([]) (members, child) members child }
in ts_parenthesized_type let unified_union_children type.unified_union_members
in ts_parenthesized let unified_union_children expression.unified_union_members
in style_tree_node let unified_union_members unified_union_children.nonempty ?? [{ text: text, wrap: is (ts_function_type, ts_conditional_type) }]
fn unified_union(members) = {
  value members
  fold ([]) (unique_members, member) if any(unique_members, previous_member => previous_member.text == member.text) then unique_members else unique_members [member]
  map (member) if member.wrap then "(" member.text ")" else member.text
  join " | "
}
fn unified_doc(prefix) = if re_test(prefix, /\/\*[\s\S]*?\*\/[ \t\r\n]*(?:\/\/[^\n]*(?:\n|$)[ \t\r\n]*)*$/) then re_replace(prefix, /[\s\S]*\/\*([\s\S]*?)\*\/[ \t\r\n]*(?:\/\/[^\n]*(?:\n|$)[ \t\r\n]*)*$/, "$1") else null
in ts_export let unified_doc unified_doc(text_before)
in ts_function, ts_method, ts_method_signature, ts_call_signature let unified_doc if parent is ts_export then parent.unified_doc else unified_doc(text_before)
in style_tree_node let unified_after_line line + { value text; split "\n"; count } - 1 + { value space_after.text.nonempty ?? ""; split "\n"; count } - 1
in style_tree_node let unified_next_offset space_after.end
in ts_method let unified_head { offset: key.unified_next_offset, line: key.unified_after_line }
in ts_function let unified_key if body == null then name.nonempty ?? "default" else null
in ts_method let unified_key if body == null && kind != "get" && kind != "set" && key != null then { kind: kind_name(key.node), name: key, static: contains([] modifier, "static") } else null
in ts_method_signature let unified_key if kind != "get" && kind != "set" && key != null then { kind: kind_name(key.node), name: key, static: false } else null
in ts_call_signature let unified_key kind.nonempty ?? "call"
in ts_function, ts_method, ts_method_signature, ts_call_signature let unified_signature if unified_key == null then null else { key: unified_key, node: node, offset: offset, head: unified_head.nonempty ?? { offset: offset, line: line }, parameters: [] parameter.unified_parameter, types: [] type_parameter.unified_type_parameter, result: return_type.unified_bare_type, outer: [] parameter.unified_outer_type }
in ts_export let unified_signature declaration.unified_signature
in ts_program, ts_block, ts_class, ts_interface, ts_type_literal let unified_signatures [] children.unified_signature
in ts_export let unified_signatures parent.unified_signatures
in ts_program, ts_class, ts_interface, ts_type_literal let unified_scope true
in ts_block let unified_scope parent is ts_namespace
in ts_export let unified_scope parent.unified_scope
in ts_class, ts_interface let unified_outer_names [] type_parameter.unified_type_name
in ts_program, ts_block, ts_type_literal let unified_outer_names []
in ts_export let unified_outer_names parent.unified_outer_names
fn unified_parameter_at(signature, at) = { value signature.parameters; slice at (at + 1); first }
fn unified_sigils(a, b) = a.rest == b.rest && a.optional == b.optional
fn unified_difference(a, b) = if unified_sigils(a, b) && !a.rest then { offset: b.offset, end: b.end, other_line: a.line, ending: " taking `" unified_union(a.union b.union) "`." } else null
fn unified_equal_length(a, b, differences) = when {
  count(differences) == 0 then { offset: b.head.offset, end: b.node.end_offset, other_line: a.head.line, ending: " with identical parameters." }
  count(differences) == 1 then {
    value differences
    first_differences: first
    value at: first(differences).index
    value unified_parameter_at: unified_parameter_at(b, at)
    value unified_difference(first_differences, unified_parameter_at)
  }
  else then null
}
fn unified_shorter(short, long) = if last(short.parameters).rest == true || !all(short.parameters, p => p.type == unified_parameter_at(long, p.index).type) || !{
  value result: count(short.parameters) + 1
  value long.parameters
  parameters_count: count
  value slice(long.parameters, result, parameters_count)
  all (p) p.optional || p.rest
} then null else { offset: last(long.parameters).offset, end: last(long.parameters).end, other_line: short.head.line, ending: " with " (if last(long.parameters).rest then "a rest" else "an optional") " parameter." }
fn unified_parameter_difference(a, b) = when {
  count(a.parameters) == count(b.parameters) then {
    value a.parameters
    differences: filter (p) !{ value b; unified_parameter_at_3: unified_parameter_at p.index; value unified_sigils(p, unified_parameter_at_3) } || p.type != unified_parameter_at(b, p.index).type
    value unified_equal_length(a, b, differences)
  }
  (first(a.parameters).name == "this") != (first(b.parameters).name == "this") then null
  count(a.parameters) < count(b.parameters) then unified_shorter(a, b)
  else then unified_shorter(b, a)
}
fn unified_comparison(a, b, outer_names) = if a.result != b.result || any(a.outer, name => contains(outer_names, name)) != any(b.outer, name => contains(outer_names, name)) || a.types != b.types || first(a.parameters).name == "this" && first(a.parameters).raw_type == "void" || first(b.parameters).name == "this" && first(b.parameters).raw_type == "void" then null else unified_parameter_difference(a, b)
fn unified_names(a, b) = {
  value b.parameters
  parameters_count: count
  value slice(a.parameters, 0, parameters_count)
  all (p) p.rest != unified_parameter_at(b, p.index).rest || p.name == unified_parameter_at(b, p.index).name
}
fn unified_pair(a, b, outer_names, group_count) = { difference: unified_comparison(a, b, outer_names), a: a, b: b, count: group_count }
group unified_signature_node ts_function, ts_method, ts_method_signature, ts_call_signature
in unified_signature_node rule unified-signatures {
  option ignoreDifferentlyNamedParameters boolean = false "Ignore overloads with different parameter names."
  option ignoreOverloadsWithDifferentJSDoc boolean = false "Ignore overloads with different block comments."
  let signature unified_signature
  when signature != null && parent.unified_scope == true
  let group filter(parent.unified_signatures, candidate => candidate.key == signature.key)
  let pairs {
    value group
    filter (candidate) candidate.offset > signature.offset
    map (candidate) {
      value group
      group_count_2: count
      value unified_pair(signature, candidate, parent.unified_outer_names, group_count_2)
    }
  }
  each pair in filter(pairs, p => p.difference != null && (!ignoreDifferentlyNamedParameters || unified_names(p.a, p.b)) && (!ignoreOverloadsWithDifferentJSDoc || p.a.node.unified_doc == p.b.node.unified_doc)) {
    report at { start: pair.difference.offset, end: pair.difference.end }
    warn "{if pair.count == 2 then 'These overloads' else 'This overload and the one on line ' pair.difference.other_line} can be combined into one signature{pair.difference.ending}"
  }
}

}
