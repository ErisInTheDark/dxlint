# .ts/style/returns: internal part of .ts/style.

define {

in ts_as, ts_type_assertion, ts_jsx_expression, ts_jsx_spread_attribute, ts_new let return_accepts_value "all"
in ts_declarator, ts_class_property let return_accepts_value if type != null then "all" else ""
in ts_parameter let return_accepts_value if type != null then "init" else ""
in style_tree_node let return_parent_typed if parent is ts_parenthesized then parent.return_parent_typed else parent.return_accepts_value == "all" || parent.return_accepts_value == "init" && is ts_node.init || parent is ts_call && not ts_call.callee
in ts_declarator let return_context_name if name is ts_identifier then name else ""
in ts_class_property, ts_property let return_context_name if key is ts_identifier then key else ""
in style_tree_node let return_parent_info if parent is ts_parenthesized then parent.return_parent_info else { node: parent.node, name: parent.return_context_name }
in ts_function let return_own_name name
in ts_method let return_own_name if key is ts_identifier then key else ""
in ts_function, ts_arrow, ts_method let return_annotation return_type != null
in ts_declarator, ts_class_property let return_annotation type != null
in style_tree_node let return_ancestor_context if is (ts_declarator, ts_class_property) then return_annotation else if is ts_expression_statement then false else return_annotation == true || parent.return_ancestor_context
in ts_arrow let return_concise body not ts_block
in style_tree_node let return_ancestor_typed if parent is ts_parenthesized then parent.return_ancestor_typed else (parent is ts_return || is ts_arrow.body && parent.return_concise) && parent.return_ancestor_context == true
in ts_property, ts_method let return_object_typed parent is ts_object && parent.return_value_typed
in style_tree_node let return_property_typed if parent is ts_parenthesized then parent.return_property_typed else parent.return_object_typed == true
in style_tree_node let return_value_typed if parent is ts_parenthesized then parent.return_value_typed else return_parent_typed || return_property_typed || parent is ts_array && parent.return_value_typed || parent is ts_return && return_ancestor_typed
in ts_function, ts_arrow let returned_function true
in ts_parenthesized let returned_function expression.returned_function
in ts_as, ts_type_assertion let returned_const_assertion type == "const"
in ts_satisfies, ts_parenthesized let returned_const_assertion expression.returned_const_assertion
in ts_unary let returned_void operator == "void"
in ts_parenthesized let returned_void expression.returned_void
in ts_return let return_function argument.returned_function == true
in style_tree_node let function_returns_any if is ts_return then true else if is (ts_function, ts_arrow, ts_method, ts_class) then false else any(children.function_returns_any, any => any)
# Cheap aggregates; the returned values themselves are only collected where a
# caller needs them.
in style_tree_node let function_returns_functions if is ts_return then return_function else if is (ts_function, ts_arrow, ts_method, ts_class) then true else all(children.nodes, child => !child.function_returns_any || child.function_returns_functions)
in ts_return let return_value { value: argument.node, function: argument.returned_function == true }
in style_tree_node let function_return_values if is ts_return then [return_value] else if is (ts_function, ts_arrow, ts_method, ts_class) then [] else { value [] children.function_return_values; fold ([]) (values, child) values child }
in ts_method let return_method_valid key == "constructor" || kind == "set"

# ESLint reports the function head: the member or node start up to the parameter
# list's opening paren. It does not know accessor properties, so a function they
# hold reports from the function itself.
in ts_function, ts_arrow, ts_method let return_report_site when {
  parent.boundary_accessor != true then function_head_site(node)
  is ts_arrow then operator.node
  else then { start: offset, end: function_head_site(node).end }
}
in ts_function, ts_arrow, ts_method let return_declaration is ts_function && return_parent_info.node is (ts_program, ts_block, ts_export, ts_namespace)
in ts_function, ts_arrow, ts_method let return_context_typed !return_declaration && (return_parent_typed || return_property_typed) || is ts_method && return_object_typed
in ts_function, ts_arrow, ts_method let explicit_return_shape {
  name: return_own_name.nonempty ?? return_parent_info.name.nonempty ?? "",
  valid: return_annotation || return_method_valid == true,
  typed: return_context_typed || !return_declaration && return_ancestor_typed,
  context_typed: return_context_typed,
  ancestor_typed: !return_declaration && return_ancestor_typed,
  free_expression: !return_declaration && return_parent_info.node != null && return_parent_info.node not (ts_declarator, ts_class_property, ts_export, ts_class),
  higher_order: is ts_arrow && body.returned_function == true || body.function_returns_any && body.function_returns_functions,
  const_assertion: is ts_arrow && body.returned_const_assertion == true,
  iife: return_parent_info.node is ts_call,
  void_arrow: is ts_arrow && body.returned_void == true
}

@macro explicit_return_rule(rule-id, return_context) {
  in return_context rule rule-id {
    option allowConciseArrowFunctionExpressionsStartingWithVoid boolean = false "Allow concise arrows starting with void."
    option allowDirectConstAssertionInArrowFunctions boolean = true "Allow concise arrows returning const assertions."
    option allowedNames string[] = [] "Allowed function and member names."
    option allowExpressions boolean = false "Allow function expressions outside declarations."
    option allowFunctionsWithoutTypeParameters boolean = false "Allow nongeneric functions."
    option allowHigherOrderFunctions boolean = true "Allow functions returning only functions."
    option allowIIFEs boolean = false "Allow functions directly within calls."
    option allowTypedFunctionExpressions boolean = true "Allow contextually typed function expressions."
    let shape explicit_return_shape
    when !shape.valid && !contains(allowedNames, shape.name)
    when !(allowFunctionsWithoutTypeParameters && count(type_parameter) == 0 || allowIIFEs && shape.iife || allowHigherOrderFunctions && shape.higher_order || allowConciseArrowFunctionExpressionsStartingWithVoid && shape.void_arrow)
    when !(allowTypedFunctionExpressions && (shape.typed || allowExpressions && shape.free_expression || allowDirectConstAssertionInArrowFunctions && shape.const_assertion))
    report at return_report_site
    warn "Missing return type on function."
  }
}
@explicit_return_rule(explicit-function-return-type, ts_function)
@explicit_return_rule(explicit-function-return-type:method, ts_method)
@explicit_return_rule(explicit-function-return-type:arrow, ts_arrow)

# explicit-module-boundary-types: what other modules see needs types.
group style_boundary_export ts_export, ts_export_assignment
in ts_class_property, ts_method let boundary_private contains([] modifier, "private") || key is ts_private_name
in ts_function, ts_arrow, ts_method let boundary_returned_functions if is ts_arrow && body not ts_block then if body.returned_function == true then body.nodes else [] else if body.function_returns_any && body.function_returns_functions then map(body.function_return_values, value => value.value) else []
in ts_assignment let boundary_written_value right.node
in ts_identifier let boundary_binding_owner parent.node
in ts_identifier let boundary_identifier_refs if reference_kind != null && !contains(["parameter", "catch", "import"], reference_kind) then [] declaration.boundary_binding_owner [] declaration.references.writer.boundary_written_value else []
in ts_class let boundary_structural_refs member.nodes
in ts_object let boundary_structural_refs property.nodes
in ts_array let boundary_structural_refs element.nodes
in ts_variable_declaration let boundary_structural_refs declaration.nodes
in ts_declarator let boundary_structural_refs init.nodes
in ts_class_property let boundary_structural_refs if boundary_private then [] else init.nodes
in ts_property let boundary_structural_refs if value != null then value.nodes else if key is ts_identifier then key.nodes else []
in ts_parenthesized let boundary_structural_refs expression.nodes
in ts_function, ts_arrow, ts_method let boundary_structural_refs if boundary_private == true then [] else boundary_returned_functions
in style_tree_node let boundary_next boundary_structural_refs.nonempty ?? boundary_identifier_refs.nonempty ?? []
in ts_export_specifier let boundary_export_value local.node
in ts_export let boundary_export_roots if from == null then declaration.nodes [] expression.node [] specifier.boundary_export_value else []
in ts_export_assignment let boundary_export_roots expression.nodes
in ts_program let boundary_roots { value descendants(style_boundary_export); fold ([]) (roots, n) roots n.boundary_export_roots }
in ts_program let boundary_export_nodes walk(boundary_roots, n => n.boundary_next)
in ts_declarator let boundary_context_name if name is ts_identifier then name else ""
in ts_class_property let boundary_context_name member_static_name.nonempty ?? ""
in style_tree_node let boundary_parent_name if parent is ts_parenthesized then parent.boundary_parent_name else parent.boundary_context_name
in ts_function let boundary_function_name if return_declaration then name.nonempty ?? "" else boundary_parent_name.nonempty ?? ""
in ts_arrow let boundary_function_name boundary_parent_name.nonempty ?? ""
in ts_method let boundary_function_name member_static_name.nonempty ?? ""
in ts_function, ts_method let boundary_overload_entry { name: boundary_function_name, empty: body == null, exported: parent is ts_export, default: parent.boundary_default_export == true }
in ts_export let boundary_default_export kind == "default"
in ts_export let boundary_overload_entry declaration.boundary_overload_entry
in style_tree_node let boundary_overload_entries if is ts_export then parent.boundary_overload_entries else [] children.boundary_overload_entry
in ts_function, ts_arrow, ts_method let boundary_has_overload any(parent.boundary_overload_entries, entry => entry.empty && (parent is ts_export && entry.exported && entry.default == parent.boundary_default_export && (entry.default || entry.name == boundary_function_name) || parent not ts_export && !entry.exported && entry.name == boundary_function_name))
in ts_method let boundary_empty_method body == null
in ts_class_property let boundary_accessor contains([] modifier, "accessor")
in ts_function, ts_arrow, ts_method let boundary_report_site
  if boundary_empty_method == true then { start: function_head_site(node).end, end: end_offset } else return_report_site
in ts_function, ts_arrow, ts_method let boundary_function_reachable boundary_private != true && contains(ts_program.boundary_export_nodes, node)
in ts_parameter let boundary_argument {
  eligible: init == null && (type == null || type == "any"),
  any: type == "any",
  offset: name.offset,
  end: if modifier == null then end_offset else name.end_offset,
  name: name.unified_parameter_name,
  pattern: if name is ts_rest then "Rest" else if name is ts_array_pattern then "Array pattern" else "Object pattern"
}
@macro boundary_rule(rule-id, boundary_context, parameter_check) {
  in boundary_context rule rule-id {
    option allowArgumentsExplicitlyTypedAsAny boolean = false "Allow explicit any parameter types."
    option allowDirectConstAssertionInArrowFunctions boolean = true "Allow concise arrows returning const assertions."
    option allowedNames string[] = [] "Allowed function and member names."
    option allowHigherOrderFunctions boolean = true "Allow functions returning only functions."
    option allowTypedFunctionExpressions boolean = true "Allow contextually typed functions."
    option allowOverloadFunctions boolean = false "Allow implementations with overload signatures."
    let boundary_shape if parameter_check then parent.explicit_return_shape else explicit_return_shape
    let boundary_name if parameter_check then parent.boundary_function_name else boundary_function_name
    let empty_method if parameter_check then parent.boundary_empty_method else boundary_empty_method
    let overload if parameter_check then parent.boundary_has_overload else boundary_has_overload
    when if parameter_check then parent.boundary_function_reachable && boundary_argument.eligible else boundary_function_reachable
    when empty_method == true || !(contains(allowedNames, boundary_name) || boundary_shape.ancestor_typed || allowTypedFunctionExpressions && boundary_shape.context_typed || allowOverloadFunctions && overload)
    when if parameter_check then !(allowArgumentsExplicitlyTypedAsAny && boundary_argument.any) else !boundary_shape.valid && !(allowHigherOrderFunctions && boundary_shape.higher_order || allowDirectConstAssertionInArrowFunctions && boundary_shape.const_assertion)
    report at if parameter_check then { start: boundary_argument.offset, end: boundary_argument.end } else boundary_report_site
    warn if parameter_check then (if boundary_argument.name != null then "Argument '" boundary_argument.name "'" else boundary_argument.pattern " argument") " should be typed" (if boundary_argument.any then " with a non-any type" else "") "." else "Missing return type on function."
  }
}
@boundary_rule(explicit-module-boundary-types, ts_function, false)
@boundary_rule(explicit-module-boundary-types:method, ts_method, false)
@boundary_rule(explicit-module-boundary-types:arrow, ts_arrow, false)
@boundary_rule(explicit-module-boundary-types:argument, ts_parameter, true)

}
