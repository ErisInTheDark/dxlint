# .ts/style/types: internal part of .ts/style.
import .ts/expression-fixes

define {

# ---- type syntax -------------------------------------------------------------------
fn type_restriction_matches(names, name) = any(names, n => re_replace(n, /\s+/, "") == name)
in ts_type_reference let restricted_type_shape count(type_argument) > 0
in ts_type_keyword let restricted_type_shape contains(["bigint", "boolean", "never", "null", "number", "object", "string", "symbol", "undefined", "unknown", "void"], text)
in ts_tuple_type let restricted_type_shape count(element) == 0
in ts_type_literal let restricted_type_shape count(member) == 0
in ts_type_reference, ts_type_keyword, ts_tuple_type, ts_type_literal rule no-restricted-types {
  default option names string[] = [] "Restricted type names."
  when restricted_type_shape
  let restricted_name re_replace(text, /\s+/, "")
  when type_restriction_matches(names, restricted_name)
  warn "Don't use `{restricted_name}` as a type."
}
in ts_type_reference.name rule no-restricted-types:name {
  default option names string[] = [] "Restricted type names."
  let restricted_name re_replace(text, /\s+/, "")
  when type_restriction_matches(names, restricted_name)
  warn "Don't use `{restricted_name}` as a type."
}

# Array syntax supplies one notation value; mutable and readonly policies are independent.
in ts_type_keyword, ts_array_type, ts_qualified_name let is_simple_type true
in ts_type_reference let is_simple_type count(type_argument) == 0 || name == "Array" && count(type_argument) == 1 && first([] type_argument.is_simple_type) == true
in ts_array_type {
  let is_array_type true
  let array_element_simple type.is_simple_type == true
  let array_element_text type
  let array_element_node type.node
}
in ts_type_reference let array_element_node first([] type_argument.node)
in ts_node let style_type_unwrapped if is ts_parenthesized_type then type.style_type_unwrapped else node
in ts_type_reference let array_type_notation
  if re_test(name, /^(Array|ReadonlyArray|Readonly)$/) && count(type_argument) == 1 && name.reference_kind == null
    && (name != "Readonly" || first([] type_argument.is_array_type) == true)
  then { readonly: name != "Array", named: true, wrapper: name, element: array_element_node, simple: first([] type_argument.is_simple_type) == true, shown: if first([] type_argument.is_simple_type) == true then first([] type_argument) else "T", suffix: if name == "Readonly" then "" else "[]" }
  else null
in ts_array_type let array_type_notation
  if parent is ts_type_operator && parent.operator == "readonly" then null
  else { readonly: false, named: false, wrapper: "Array", element: array_element_node, simple: type.is_simple_type == true, shown: if type.is_simple_type == true then type else "T", suffix: "[]" }
in ts_type_operator let array_type_notation
  if operator == "readonly" && type.is_array_type == true
  then { readonly: true, named: false, wrapper: "ReadonlyArray", element: type.array_element_node, simple: type.array_element_simple == true, shown: if type.array_element_simple then type.array_element_text else "T", suffix: "[]" }
  else null
fn array_notation_forbidden(notation, mode) = if notation.named then mode != "generic" && (mode != "array-simple" || notation.simple) else mode == "generic" || mode == "array-simple" && !notation.simple
fn array_notation_warning(notation, mode) =
  if notation.named then "Array type using '{notation.wrapper}<{notation.shown}>' is forbidden{if mode == 'array-simple' then ' for simple types' else ''}. Use '{if notation.readonly then 'readonly ' else ''}{notation.shown}{notation.suffix}' instead."
  else "Array type using '{if notation.readonly then 'readonly ' else ''}{notation.shown}[]' is forbidden{if mode == 'array-simple' then ' for non-simple types' else ''}. Use '{notation.wrapper}<{notation.shown}>' instead."
fn array_notation_replacement(owner, notation) = {
  value element: if notation.named then notation.element else notation.element.style_type_unwrapped
  value comments: overlapping(ts_comment, owner.offset, owner.end_offset)
  value safe: all(comments, comment => element.offset <= comment.offset && comment.end_offset <= element.end_offset)
  value postfix: if element.precedence < 20 || element is ts_infer then "({element})" else "{element}"
  value replacement: if !notation.named then "{notation.wrapper}<{element}>"
    else "{if notation.readonly then 'readonly ' else ''}{if notation.wrapper == 'Readonly' then element else postfix}{notation.suffix}"
  value if !safe then null
    else if notation.named && notation.readonly && owner.parent is ts_array_type then "({replacement})"
    else replacement
}
in ts_type_reference, ts_array_type rule array-type:mutable {
  default option mode ("array" | "array-simple" | "generic") = "array" "Mutable array notation."
  when array_type_notation != null && !array_type_notation.readonly
  when array_notation_forbidden(array_type_notation, mode)
  warn array_notation_warning(array_type_notation, mode)
  let replacement array_notation_replacement(node, array_type_notation)
  fix if replacement != null as replacement
}
in ts_type_reference, ts_type_operator rule array-type:readonly {
  default option mode ("array" | "array-simple" | "generic") = "array" "Readonly array notation."
  when array_type_notation != null && array_type_notation.readonly
  when array_notation_forbidden(array_type_notation, mode)
  warn array_notation_warning(array_type_notation, mode)
  let replacement array_notation_replacement(node, array_type_notation)
  fix if replacement != null as replacement
}

# The global wrapper types (not local types of those names).
in ts_type_reference rule no-wrapper-object-types {
  when re_test(name, /^(String|Number|Boolean|Object|Symbol|BigInt)$/) && parent not ts_template_type && name.reference_kind == null
  warn "Prefer using the primitive `{lower(name)}` as a type name, rather than the upper-cased `{name}`."
}

in ts_non_null rule no-non-null-assertion {
  warn "Forbidden non-null assertion."
}
in ts_declarator let initialised_declaration_end if init != null || {
  value name
  len: len
  value slice(text, len)
  trim_start
  starts_with "!"
} then end_offset else null
in ts_identifier let binding_initialised_end if parent is ts_declarator then parent.initialised_declaration_end else null
in ts_identifier let binding_write_end if access == "write" || access == "read_write" then end_offset else null
in ts_identifier let binding_assignment_history if declaration == null then null else { initialised: declaration.binding_initialised_end, writes: [] declaration.references.binding_write_end }
in ts_parenthesized forward binding_assignment_history from expression
in ts_non_null, ts_parenthesized let nullish_left if parent is ts_parenthesized then parent.nullish_left else is ts_logical.left && parent.operator == "??"
fn assigned_before(history, end) = history == null || history.initialised != null && history.initialised < end || any(history.writes, n => n != null && n < end)
in ts_non_null rule no-non-null-asserted-nullish-coalescing {
  when nullish_left && assigned_before(expression.binding_assignment_history, end_offset)
  warn "The nullish coalescing operator is designed to handle undefined and null - using a non-null assertion is not needed."
}

in ts_type_parameter rule no-unnecessary-type-constraint {
  when constraint == "any" || constraint == "unknown"
  warn "Constraining the generic type `{name}` to `{constraint}` does nothing and is unnecessary."
}

in ts_function let function_declaration { name: name, node: node, body: body != null }
in ts_method let function_declaration { name: key, node: node, body: body != null }
in ts_export forward function_declaration from declaration
in style_tree_node let function_siblings if is ts_export then parent.function_siblings else [] children.function_declaration
in ts_function, ts_method let overload_implementation body != null && any(parent.function_siblings, d => (d.node is ts_function) == (is ts_function) && d.name == function_declaration.name && !d.body)
in style_tree_node let function_overload_context if is (ts_function, ts_method) then overload_implementation else parent.function_overload_context
in ts_type_keyword let void_keyword text == "void"
in ts_type_reference let has_void_argument any([] type_argument.void_keyword, v => v == true)
in style_tree_node let void_union_member if is ts_type_keyword then contains(["void", "never"], text) else if is ts_type_reference then has_void_argument else false
in ts_union let valid_void_union all([] type.void_union_member, t => t == true)
in ts_type_keyword {
  let void_type_context if is ts_node.return_type then "return" else if is ts_node.type_argument then (if parent is ts_type_reference then "generic" else if parent is ts_call then "other" else "generic-other") else if is ts_type_parameter.default then "default" else if parent is ts_parameter && parent.name == "this" then "this" else if parent is ts_union then (if parent.valid_void_union || parent.function_overload_context == true then "return" else "union") else "other"
  let void_type_generic_name { value parent.name.nonempty ?? ""; re_replace /\s+/ "" }
  let no_invalid_void_type_checked !contains(["generic", "generic-other", "default"], void_type_context)
}
in ts_type_keyword rule no-invalid-void-type {
  when text == "void" && void_type_context != "return"
  when no_invalid_void_type_checked
  warn if void_type_context == "generic" then void_type_generic_name " may not have void as a type argument." else if void_type_context == "union" then "void is not valid as a constituent in a union type" else "void is not valid in this position."
}

in ts_parameter let rest_function_parameter name is ts_rest && parent is (ts_function, ts_arrow, ts_method, ts_method_signature, ts_call_signature, ts_function_type)
fn rest_parameter_annotation(n) =
  n is ts_parameter.type && n.parent.rest_function_parameter == true
  || n is ts_type_operator.type && n.parent.operator == "readonly" && n.parent is ts_parameter.type && n.parent.parent.rest_function_parameter == true
in ts_array_type let rest_array_argument rest_parameter_annotation(node)
in ts_type_reference let rest_array_argument contains(["Array", "ReadonlyArray"], name) && rest_parameter_annotation(node)
in ts_type_keyword let no_explicit_any_checked true
in ts_type_keyword rule no-explicit-any {
  when text == "any"
  when no_explicit_any_checked
  warn "Unexpected any. Specify a different type."
}

in ts_number, ts_string let delete_literal_key true
in ts_number let delete_numeric_key true
in ts_parenthesized forward delete_literal_key, delete_numeric_key from expression
in ts_unary let delete_literal_key operator == "-" && argument.delete_numeric_key == true
in ts_index, ts_parenthesized let delete_operand if parent is ts_parenthesized then parent.delete_operand else parent is ts_unary && parent.operator == "delete"
in ts_index rule no-dynamic-delete {
  when delete_operand && index.delete_literal_key != true
  report at index.unparen_offset
  warn "Do not delete dynamically computed property keys."
}

in ts_namespace let namespace_is_declared contains([] modifier, "declare")
in style_tree_node let namespace_declared namespace_is_declared == true || parent.namespace_declared == true
in ts_namespace let no_namespace_checked !re_test(file, /\.d\.[cm]?ts$/)
in ts_namespace rule no-namespace {
  when kind != "global" && name != "global" && !re_test(name, /^["']/)
  when no_namespace_checked
  warn "ES2015 module syntax is preferred over namespaces."
}

in ts_export let empty_module_export declaration == null && expression == null && from == null && namespace == null && count(specifier) == 0 && { value result: "{{"; value contains(text, result) }
in ts_export let module_item !empty_module_export
in ts_import, ts_import_equals, ts_export_assignment let module_item true
in ts_program let has_module_item any([] body.module_item, x => x == true)
in ts_export rule no-useless-empty-export {
  when !re_test(file, /\.d\.[cm]?ts$/) && empty_module_export && parent.has_module_item
  warn "Empty export does nothing and can be removed."
}

in ts_enum_member rule prefer-enum-initializers {
  when init == null
  warn "The value of the member '{text}' should be explicitly defined."
}

in ts_enum let enum_keys [] member.static_name
in ts_enum_member let enum_scope { name: parent.name, keys: parent.enum_keys }
in ts_identifier, ts_member, ts_index, ts_unary, ts_binary, ts_parenthesized let enum_scope parent.enum_scope
in ts_number, ts_string, ts_bigint, ts_boolean, ts_null, ts_regex {
  let enum_literal_value true
  let enum_bitwise_value true
  let enum_bitwise_operand true
}
in ts_template {
  let enum_literal_value count(expression) == 0
  let enum_bitwise_value enum_literal_value
  let enum_bitwise_operand enum_literal_value
}
in ts_identifier let enum_bitwise_operand contains(enum_scope.keys, text)
in ts_member, ts_index let enum_bitwise_operand object == enum_scope.name && contains(enum_scope.keys, static_name)
in ts_unary {
  let enum_literal_value contains(["+", "-"], operator) && argument.enum_literal_value == true
  let enum_bitwise_value if operator == "~" then argument.enum_bitwise_operand == true else contains(["+", "-"], operator) && argument.enum_bitwise_value == true
  let enum_bitwise_operand contains(["+", "-", "~"], operator) && argument.enum_bitwise_operand == true
}
in ts_binary {
  let enum_bitwise_value contains(["&", "^", "<<", ">>", ">>>", "|"], operator) && left.enum_bitwise_operand == true && right.enum_bitwise_operand == true
  let enum_bitwise_operand enum_bitwise_value
}
in ts_parenthesized forward enum_literal_value, enum_bitwise_value, enum_bitwise_operand from expression
in ts_enum_member let enum_literal_value init == null || init.enum_literal_value == true
in ts_enum_member let enum_bitwise_value init == null || init.enum_bitwise_value == true
in ts_enum_member.name rule prefer-literal-enum-member {
  option allowBitwiseExpressions boolean = false "Allow bitwise expressions using literals and enum members."
  when !(if allowBitwiseExpressions then parent.enum_bitwise_value else parent.enum_literal_value)
  warn "Explicit enum value must only be a literal value (string or number){if allowBitwiseExpressions then ' or a bitwise expression' else ''}."
}

in ts_declarator let no_this_alias_checked name is ts_identifier
in ts_assignment let no_this_alias_checked left is ts_identifier
in ts_declarator.name rule no-this-alias {
  option allowedNames string[] = [] "Names allowed to alias this."
  when parent.init == "this"
  when parent.no_this_alias_checked && !contains(allowedNames, text)
  warn if is ts_identifier then "Unexpected aliasing of 'this' to local variable." else "Unexpected aliasing of members of 'this' to local variables."
}
in ts_assignment.left rule no-this-alias:assignment {
  option allowedNames string[] = [] "Names allowed to alias this."
  when parent.right == "this"
  when parent.no_this_alias_checked && !contains(allowedNames, text)
  warn if is ts_identifier then "Unexpected aliasing of 'this' to local variable." else "Unexpected aliasing of members of 'this' to local variables."
}

in ts_import_specifier let type_only_specifier kind == "type"
in ts_import rule no-import-type-side-effects {
  when kind != "type" && default_import == null && namespace == null && count(specifier) > 0
  when { value [] specifier.type_only_specifier; filter (t) t; count } == count(specifier)
  warn "TypeScript will only remove the inline type specifiers which will leave behind a side effect import at runtime. Convert this to a top-level type qualifier to properly remove the entire import."
}

fn property_modifiers(xs) = { value ["public", "protected", "private", "readonly"]; filter (m) contains(xs, m); join " " }
in ts_parameter, ts_class_property let parameter_modifiers property_modifiers([] modifier)
in ts_parameter, ts_class_property let parameter_properties_checked true
in ts_parameter rule parameter-properties {
  option prefer ("class-property" | "parameter-property") = "class-property" "Preferred property declaration."
  when parameter_properties_checked
  when prefer == "class-property" && parameter_modifiers != ""
  warn "Property {name} should be declared as a class property."
}
in ts_member let plain_this_property object is ts_this && property is ts_identifier
in ts_assignment let parameter_assignment_name if left.plain_this_property == true && right is ts_identifier then right else null
in ts_expression_statement let leading_parameter_assignment if expression.parameter_assignment_name != null && (previous == null || previous.leading_parameter_assignment != null) then expression.parameter_assignment_name else null
in ts_block let leading_parameter_assignments [] body.leading_parameter_assignment
in ts_parameter let convertible_parameter if init == null && parameter_modifiers == "" then { name: name, annotation: type } else null
in ts_method let property_conversion_constructor if key == "constructor" && body != null then { parameters: [] parameter.convertible_parameter, assignments: body.leading_parameter_assignments } else null
in ts_class let property_conversion_constructors [] member.property_conversion_constructor
fn conversion_parameter(parameters, name) = find(parameters, p => p.name == name)
fn property_conversion_matches(constructors, name, annotation) = any(constructors, c => conversion_parameter(c.parameters, name) != null && conversion_parameter(c.parameters, name).annotation == annotation && contains(c.assignments, name))
in ts_class_property rule parameter-properties:class {
  option prefer ("class-property" | "parameter-property") = "class-property" "Preferred property declaration."
  when parameter_properties_checked
  when prefer == "parameter-property" && key is ts_identifier && init == null
  when property_conversion_matches(parent.property_conversion_constructors, key, type)
  warn "Property {key} should be declared as a parameter property."
}

in ts_number, ts_string, ts_boolean, ts_bigint, ts_null, ts_regex let raw_literal_expression text
in ts_parenthesized let raw_literal_expression expression.raw_literal_expression
in ts_literal_type let literal_type_text value
in ts_as, ts_type_assertion let use_const_assertion type.literal_type_text != null && type.literal_type_text == expression.raw_literal_expression
in ts_declarator, ts_class_property let use_const_annotation type.literal_type_text != null && type.literal_type_text == init.raw_literal_expression
in ts_as.type, ts_type_assertion.type rule prefer-as-const {
  when parent.use_const_assertion
  warn "Expected a `const` instead of a literal type assertion."
}
in ts_declarator.type, ts_class_property.type rule prefer-as-const:annotation {
  when parent.use_const_annotation
  warn "Expected a `const` assertion instead of a literal type annotation."
}

fn empty_object_message(subject) = subject " allows any non-nullish value, including literals like `0` and `\"\"`.\n- If that's what you want, disable this lint rule with an inline comment or configure an exemption.\n- If you want a type meaning \"any object\", you probably want `object` instead.\n- If you want a type meaning \"any value\", you probably want `unknown` instead."
in ts_interface, ts_type_literal let no_empty_object_type_checked true
in ts_interface.name rule no-empty-object-type:interface {
  option allowSingleExtends boolean = false "Allow empty interfaces extending one type."
  option allowWithName regex | null = null "Allow matching interface and type alias names."
  when parent.no_empty_object_type_checked
  when count(parent.member) == 0 && count(parent.extends) <= 1
  when !(allowSingleExtends && count(parent.extends) == 1) && !(type_of(allowWithName) == "str" && re_test(text, allowWithName))
  warn if count(parent.extends) == 1 then "An interface declaring no members is equivalent to its supertype." else empty_object_message("An empty interface declaration")
}
in ts_type_literal rule no-empty-object-type:object {
  option allowWithName regex | null = null "Allow matching interface and type alias names."
  when no_empty_object_type_checked
  when count(member) == 0 && parent not ts_intersection
  when !(type_of(allowWithName) == "str" && parent is ts_type_alias && re_test(parent.name, allowWithName))
  warn { value "The `{{}}` (\"empty object\") type"; empty_object_message }
}

# A type literal or interface that is only an index signature.
in ts_type_alias, ts_interface let indexed_type_name name.offset
in style_tree_node let indexed_type_scope if is (ts_type_alias, ts_interface) then indexed_type_name else if is (ts_index_signature, ts_property_signature, ts_parameter, ts_declarator, ts_class_property, ts_method, ts_function, ts_function_type, ts_call_signature, ts_method_signature) then null else parent.indexed_type_scope
in ts_identifier let indexed_syntax_refs [] declaration.offset
in ts_type_literal, ts_interface let indexed_syntax_refs { value [] member.indexed_type_refs; fold ([]) (ids, child) ids child }
in ts_type_alias, ts_index_signature, ts_mapped_type, ts_parenthesized_type let indexed_syntax_refs type.indexed_type_refs.nonempty ?? []
in ts_union, ts_intersection, ts_indexed_access, ts_conditional_type, ts_type_reference let indexed_syntax_refs { value [] children.indexed_type_refs; fold ([]) (ids, child) ids child }
in style_tree_node let indexed_type_refs indexed_syntax_refs.nonempty ?? []
in ts_type_alias, ts_interface let indexed_type_entry { id: name.offset, refs: indexed_type_refs }
in style_tree_node let indexed_type_entries [] indexed_type_entry { value [] children.indexed_type_entries; fold ([]) (entries, child) entries child }
in style_tree_node let indexed_type_graph if is ts_program then indexed_type_entries else parent.indexed_type_graph
fn expand_graph_refs(graph, ids) = { value ids { value graph; filter (entry) contains(ids, entry.id); fold ([]) (refs, entry) refs entry.refs }; unique }
fn expanded_graph_state(previous_state, ids, target) = { ids: ids, done: ids == previous_state.ids || contains(ids, target) }
fn type_reaches(graph, ids, target) = target != null && {
  value initial_state: { ids: ids, done: contains(ids, target) }
  value graph
  final_state: fold initial_state (state, entry) if state.done then state else { value graph; expanded_ids: expand_graph_refs state.ids; value expanded_graph_state(state, expanded_ids, target) }
  value final_state.ids
  contains target
}
in ts_parameter let indexed_parameter name is ts_identifier && type != null
in ts_index_signature let indexed_signature type != null && any([] parameter.indexed_parameter, p => p == true)
in ts_type_literal, ts_interface let record_shape count(member) == 1 && first([] member.indexed_signature) == true
in ts_identifier let indexed_type_uses [] references.access
in ts_type_operator let indexed_keyof operator == "keyof"
in ts_type_parameter let indexed_key_parameter name != null && !contains(name.indexed_type_uses, "type") && constraint.indexed_keyof != true
in ts_mapped_type let record_shape type_parameter.indexed_key_parameter == true
in ts_type_literal, ts_interface, ts_mapped_type let indexed_record_eligible record_shape && !{
  value ids: if is ts_mapped_type then parent.indexed_type_refs else indexed_type_refs
  value type_reaches(indexed_type_graph, ids, indexed_type_scope)
}
in ts_parameter let indexed_parameter_type type.node
in ts_index_signature let indexed_conversion {
  key: first([] parameter.indexed_parameter_type), value: type.node,
  readonly: contains([] modifier, "readonly"), optional: null
}
in ts_type_literal, ts_interface let indexed_conversion first([] member.indexed_conversion)
in ts_type_literal, ts_interface let indexed_first_member first([] member.node)
in ts_mapped_type let indexed_conversion {
  key: type_parameter.constraint.style_type_unwrapped, value: type.node,
  readonly: contains([] modifier, "readonly") || contains([] modifier, "+readonly"), optional: optional
}
in ts_type_reference let indexed_conversion {
  key: first([] type_argument.node), value: last([] type_argument.node), readonly: false, optional: null
}
fn indexed_notation_replacement(source, owner, info) = {
  value comments: overlapping(ts_comment, owner.offset, owner.end_offset)
  value safe: all(comments, comment =>
    info.key.offset <= comment.offset && comment.end_offset <= info.key.end_offset
    || info.value != null && info.value.offset <= comment.offset && comment.end_offset <= info.value.end_offset)
  value record: "Record<{info.key}, {info.value ?? 'any'}>"
  value optional: if info.optional == "-?" then "Required<{record}>"
    else if info.optional != null then "Partial<{record}>" else record
  value result: if info.readonly then "Readonly<{optional}>" else optional
  value if !safe || info.key == null
    || owner is ts_interface && (owner.extends != null || owner.parent is ts_export && owner.parent.kind == "default")
    || owner is ts_type_reference && (owner.name.reference_kind != null
      || !(info.key is ts_type_keyword && contains(["string", "number", "symbol"], info.key.text)))
    || owner is ts_mapped_type && (owner.name != null || contains([] owner.modifier, "-readonly")) then null
    else if owner is ts_type_reference then "{{ [key: {info.key}]: {info.value} }}"
    else if owner not ts_interface then result
    else {
      value byte_slice(source, owner.offset, owner.indexed_first_member.offset)
      re_replace /\s*\{\s*$/ ""
      re_replace /^(declare\s+)?interface\b/ "${{1}}type"
      then (header) "{header} = {result};"
    }
}
in ts_type_literal rule consistent-indexed-object-style {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && indexed_record_eligible
  warn "A record is preferred over an index signature."
  let replacement indexed_notation_replacement(source, node, indexed_conversion)
  fix if replacement != null as replacement
}
in ts_interface rule consistent-indexed-object-style:interface {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && indexed_record_eligible
  warn "A record is preferred over an index signature."
  let replacement indexed_notation_replacement(source, node, indexed_conversion)
  fix if replacement != null as replacement
}
in ts_mapped_type rule consistent-indexed-object-style:mapped {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && indexed_record_eligible
  warn "A record is preferred over an index signature."
  let replacement indexed_notation_replacement(source, node, indexed_conversion)
  fix if replacement != null as replacement
}
in ts_type_reference rule consistent-indexed-object-style:record {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "index-signature" && name == "Record" && count(type_argument) == 2
  warn "An index signature is preferred over a record."
  let replacement indexed_notation_replacement(source, node, indexed_conversion)
  fix if replacement != null as replacement
}

in ts_type_literal let is_type_literal true
in ts_parenthesized_type let is_type_literal type.is_type_literal == true
in ts_type_alias let aliases_type_literal type.is_type_literal == true
in ts_type_alias let type_definition_annotation type.node
in ts_type_alias let type_definition_literal type.style_type_unwrapped
in ts_type_alias, ts_interface let type_definition_keyword name.node.token_neighbours.before
in ts_interface let type_definition_name name.text
in ts_interface let type_definition_name_end name.end_offset
in ts_interface let type_definition_heritage [] extends.text
fn type_definition_edit(source, start, end, edits) = {
  value original: byte_slice(source, start, end)
  value replacement: expression_fix_edits(original, start, edits)
  value span: { offset: start, end_offset: end, text: original }
  value if expression_fix_retains_comments(span, replacement) then { start: start, end: end, text: replacement } else null
}
fn type_definition_interface(source, n) = {
  value keyword: n.type_definition_keyword
  value literal: n.type_definition_literal
  value equals_tokens: overlapping(ts_equals, n.type_definition_name_end ?? n.offset, n.type_definition_annotation.offset)
  value equals: last(equals_tokens)
  value comments: overlapping(ts_comment, equals.token_neighbours.before.end, equals.offset)
  value comment_end: last(comments).end_offset ?? 0
  value before_equals: max(equals.token_neighbours.before.end, comment_end)
  value edits: [
    { start: keyword.start, end: keyword.end, text: "interface" },
    { start: before_equals, end: literal.offset, text: " " },
    { start: literal.end_offset, end: n.end_offset, text: "" }
  ]
  value if literal == null || equals == null then null else type_definition_edit(source, keyword.start, n.end_offset, edits)
}
fn type_definition_type(source, n) = {
  value ancestors: walk([n], ancestor => ancestor.parent.node)
  value global_augmentation: any(ancestors, ancestor =>
    ancestor is ts_namespace && ancestor.kind == "global" && contains(ancestor.modifier, "declare"))
  value close_tokens: overlapping(ts_close_brace, n.last_token.start, n.last_token.end)
  value close: last(close_tokens)
  value open: close.paired_token
  value last_parameter: last(n.type_parameter.nodes)
  value angle_tokens: if last_parameter != null then overlapping(ts_close_angle, last_parameter.end_offset, open.start) else []
  value header_end: first(angle_tokens).end_offset ?? n.type_definition_name_end
  value keyword: n.type_definition_keyword
  value default_export: n.parent is ts_export && n.parent.kind == "default"
  value start: if default_export then n.parent.offset else keyword.start
  value heritage: { value n.type_definition_heritage; map (base) " & " base; join "" }
  value suffix: heritage (if default_export then "\nexport default " n.type_definition_name else "")
  value edits: (if default_export then [{ start: start, end: n.offset, text: "" }] else []) [
    { start: keyword.start, end: keyword.end, text: "type" },
    { start: header_end, end: open.start, text: " = " },
    { start: close.end_offset, end: close.end_offset, text: suffix }
  ]
  value if global_augmentation || open == null || header_end == null then null else type_definition_edit(source, start, close.end_offset, edits)
}
in ts_type_alias.name rule consistent-type-definitions {
  option mode ("interface" | "type") = "interface" "Preferred object type definition."
  when mode == "interface" && parent.aliases_type_literal
  warn "Use an `interface` instead of a `type`."
  let edit type_definition_interface(source, parent.node)
  fix at { start: edit.start ?? offset, end: edit.end ?? offset } if edit != null as edit.text
}
in ts_interface.name rule consistent-type-definitions:interface {
  option mode ("interface" | "type") = "interface" "Preferred object type definition."
  when mode == "type"
  warn "Use a `type` instead of an `interface`."
  let edit type_definition_type(source, parent.node)
  fix at { start: edit.start ?? offset, end: edit.end ?? offset } if edit != null as edit.text
}

# Only a call signature: a function type says it better.
in style_tree_node let function_this_offset if is ts_type_literal then null else if is ts_type_keyword && text == "this" then offset else { value children.function_this_offset; compact; first }
in ts_type_reference let function_base name == "Function"
in ts_interface let function_type_container { name: name, kind: "Interface", eligible: count(member) == 1 && (count(extends) == 0 || count(extends) == 1 && (first([] extends) == "Function" || first([] extends.function_base) == true)), this: function_this_offset }
in ts_type_literal let function_type_container { name: "", kind: "Type literal", eligible: count(member) == 1, this: null }
in ts_call_signature rule prefer-function-type {
  let container parent.function_type_container
  when return_type != null && container.eligible == true
  report at container.this.nonempty ?? offset
  warn if container.this != null then "`this` refers to the function type '" container.name "', did you intend to use a generic `this` parameter like `<Self>(this: Self, ...) => Self` instead?" else container.kind " only has a call signature, you should use a function type instead."
}

in ts_namespace rule prefer-namespace-keyword {
  when kind == "module" && { value name; re_replace /\..*$/ ""; is_identifier }
  warn "Use 'namespace' instead of 'module' to declare custom TypeScript modules."
}

}
