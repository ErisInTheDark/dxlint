# .ts/style/declarations: internal part of .ts/style.

define {

# ---- declarations --------------------------------------------------------------
# Annotations the initializer already states, with widening exceptions.
fn primitive_call_types(name) = get({ BigInt: ["bigint"], Boolean: ["boolean"], Number: ["number"], String: ["string"], Symbol: ["symbol"], RegExp: ["RegExp"] }, name)
in ts_number let primitive_inference ["bigint", "number"]
in ts_string let primitive_inference ["bigint", "string"]
in ts_bigint let primitive_inference ["bigint"]
in ts_boolean let primitive_inference ["bigint", "boolean"]
in ts_null let primitive_inference ["bigint", "null"]
in ts_regex let primitive_inference ["bigint", "RegExp"]
in ts_template let primitive_inference ["string"]
in ts_identifier let primitive_inference if contains(["Infinity", "NaN"], text) then ["number"] else if text == "undefined" then ["undefined"] else []
in ts_call let primitive_inference if callee is ts_identifier then primitive_call_types(callee) else []
in ts_new let primitive_inference if callee == "RegExp" then ["RegExp"] else []
in ts_number, ts_string, ts_bigint, ts_boolean, ts_null, ts_regex, ts_template, ts_identifier, ts_call, ts_new let primitive_direct primitive_inference
in ts_unary let primitive_inference if operator == "!" then ["boolean"] else if operator == "void" then ["undefined"] else if operator == "-" then filter(argument.primitive_direct, t => contains(["bigint", "number"], t)) else if operator == "+" && contains(argument.primitive_direct, "number") then ["number"] else []
in ts_parenthesized forward primitive_inference, primitive_direct from expression
in ts_declarator, ts_class_property, ts_parameter let inferred_annotation if type != null && contains(init.primitive_inference, type) then type else null
# `readonly` (and optional) properties keep their annotation: it widens.
in ts_class_property let annotation_widens contains([] modifier, "readonly") || optional != null
group inferrable_annotation ts_declarator, ts_class_property, ts_parameter
in inferrable_annotation let no_inferrable_types_checked true
in inferrable_annotation rule no-inferrable-types {
  when inferred_annotation != null && (annotation_widens.nonempty ?? false) != true
  when no_inferrable_types_checked
  report at type.node
  warn "Type {inferred_annotation} trivially inferred from a {inferred_annotation} literal, remove type annotation."
  let annotation_colon type.token_neighbours.before
  let annotation_start if is ts_parameter && node.optional != null then node.optional.offset else annotation_colon.start
  let annotation_comments overlapping(ts_comment, annotation_start, type.end_offset)
  fix at { start: annotation_start, end: type.end_offset } if annotation_colon.text == ":" && count(annotation_comments) == 0 as ""
}

# `const x: Map<K, V> = new Map()`: the arguments belong on the constructor.
in ts_new let constructor_arguments if callee is ts_identifier then { name: callee, count: count(type_argument) } else null
in ts_parenthesized forward constructor_arguments from expression
in ts_type_reference let annotation_arguments if name is ts_identifier then { name: name, count: count(type_argument), typed_array: contains(["Float32Array", "Float64Array", "Int16Array", "Int32Array", "Int8Array", "Uint16Array", "Uint32Array", "Uint8Array", "Uint8ClampedArray"], name) && name.reference_kind == null } else null
in ts_declarator, ts_class_property, ts_parameter rule consistent-generic-constructors {
  option mode ("constructor" | "type-annotation") = "constructor" "Preferred location for generic arguments."
  when not ts_parameter || parent is (ts_function, ts_method)
  let construction init.constructor_arguments
  let annotation type.annotation_arguments
  when construction != null
  when mode != "constructor" || compiler_options.isolatedDeclarations != true
  when if mode == "constructor" then annotation != null && annotation.name == construction.name && !annotation.typed_array && annotation.count > 0 && construction.count == 0 else type == null && construction.count > 0
  warn if mode == "constructor" then "The generic type arguments should be specified as part of the constructor type arguments." else "The generic type arguments should be specified as part of the type annotation."
}

}
