# .ts/style/expressions: internal part of .ts/style.

define {

# ---- expressions -----------------------------------------------------------------------
in ts_assignment rule no-multi-assign {
  option ignoreNonDeclaration boolean = false "Allow chained assignments outside declaration initializers."
  let owner last(walk(parent.node, current => if current is ts_parenthesized then current.parent.node else null))
  when owner is ts_declarator && unparenthesised_node(owner.init.node) == node
    || owner is ts_class_property && unparenthesised_node(owner.init.node) == node
    || !ignoreNonDeclaration && owner is ts_assignment && unparenthesised_node(owner.right.node) == node
  warn "Unexpected chained assignment."
}

in ts_member, ts_index let loop_collection_read if object not ts_this && write_site == null then object else null
in ts_identifier let loop_index_use { start: offset, end: end_offset, array: if is (ts_node.property, ts_node.index) then parent.loop_collection_read else null }
in ts_identifier let loop_index_uses [] references.loop_index_use
in ts_number let loop_zero literal_value.value == "0"
in ts_declarator let counted_loop_binding if name is ts_identifier && init.loop_zero == true then { name: name, uses: name.loop_index_uses } else null
in ts_variable_declaration let counted_loop_initialisation if kind != "const" && count(declaration) == 1 then first([] declaration.counted_loop_binding) else null
in ts_member let array_length_object if property is ts_identifier && property == "length" then object else null
in ts_index let array_length_object if index is ts_identifier && index == "length" then object else null
in ts_binary let counted_loop_test if operator == "<" then { name: left, array: right.array_length_object } else null
in ts_number let loop_increment_unit literal_value.value == "1"
in ts_binary let counted_loop_increment if operator == "+" then { left: left, right: right, left_unit: left.loop_increment_unit, right_unit: right.loop_increment_unit } else null
in ts_update let incremented_loop_name if operator == "++" then argument else null
fn increments_name(sum, name) = sum != null && (sum.left == name && sum.right_unit == true || sum.right == name && sum.left_unit == true)
in ts_assignment let incremented_loop_name if operator == "+=" && right.loop_increment_unit == true || operator == "=" && increments_name(right.counted_loop_increment, left) then left else null
in ts_for rule prefer-for-of {
  let binding init.counted_loop_initialisation
  let comparison test.counted_loop_test
  when binding != null && comparison.array != null && comparison.name == binding.name && update.incremented_loop_name == binding.name
  when all(binding.uses, use => use.start < body.offset || use.end > body.end_offset || use.array == comparison.array)
  warn "Expected a `for-of` loop instead of a `for` loop with this simple iteration."
}
in style_tree_node let assignment_node_start offset
in style_tree_node let assignment_call_start if parent is ts_parenthesized then parent.assignment_call_start else if parent is ts_call then parent.assignment_node_start else null
in ts_parenthesized let assignment_inner_start expression.assignment_value_start
in style_tree_node let assignment_value_start default(assignment_inner_start, offset)
in ts_parameter let assignment_property_name if is_parameter_property && name is ts_identifier then name else null
in ts_method let assignment_constructor_properties [] parameter.assignment_property_name
in ts_method let assignment_is_constructor key == "constructor"
in ts_method, ts_function, ts_arrow let assignment_function_node { node: node, constructor: assignment_is_constructor == true, properties: default(assignment_constructor_properties, []), call: if is ts_arrow then assignment_call_start else null, outer: parent.assignment_nearest_function }
in style_tree_node let assignment_nearest_function if is (ts_method, ts_function, ts_arrow) then assignment_function_node else parent.assignment_nearest_function
fn assignment_owner(owner) = if owner.node is ts_arrow && owner.call != null then owner.outer else owner
in ts_class_property let assignment_property_node { init: init.assignment_value_start }
in style_tree_node let assignment_nearest_property if is ts_class_property then assignment_property_node else parent.assignment_nearest_property
in ts_identifier let assignment_parameter_value if reference_kind == "parameter" then text else null
in ts_as, ts_non_null, ts_parenthesized let assignment_parameter_value expression.assignment_parameter_value
in ts_member let assignment_this_name if object is ts_this then property else null
in ts_index let assignment_this_name if object is ts_this then index.static_name else null
fn assignment_constructor(owner) = owner.node is ts_method && owner.constructor
fn assignment_field_initialiser(owner, property) = property != null && (owner == null || owner.node is ts_arrow && owner.call == property.init)
fn parameter_assignment_entry(start, owner, nearest, property, left_name, left_parameter, right_parameter, op) = {
  start: start,
  prior: if assignment_constructor(owner) then if left_parameter != null then left_parameter else if !contains(["=", "??=", "&&=", "||="], op) then left_name else null else null,
  field_write: if !assignment_constructor(owner) && assignment_field_initialiser(nearest, property) then left_name else null,
  candidate: assignment_constructor(owner) && left_name != null && left_name == right_parameter && contains(owner.properties, left_name) && contains(["=", "??=", "&&=", "||="], op),
  name: left_name
}
in ts_assignment let parameter_assignment_entry parameter_assignment_entry(offset, assignment_owner(assignment_nearest_function), assignment_nearest_function, assignment_nearest_property, left.assignment_this_name, if left is ts_identifier then left.assignment_parameter_value else null, right.assignment_parameter_value, operator)
in style_tree_node let parameter_assignment_entries if is ts_class then [] else [] parameter_assignment_entry reduce([] children.parameter_assignment_entries, [], (entries, child) => entries child)
in ts_class let parameter_assignment_catalog reduce([] children.parameter_assignment_entries, [], (entries, child) => entries child)
in ts_assignment rule no-unnecessary-parameter-property-assignment {
  when ts_class.node != null
  let entry parameter_assignment_entry
  when entry.candidate && !any(ts_class.parameter_assignment_catalog, prior => prior.field_write == entry.name || prior.start < entry.start && prior.prior == entry.name)
  warn "This assignment is unnecessary since it is already assigned by a parameter property."
}

in ts_binary rule no-confusing-non-null-assertion {
  when contains(["==", "===", "in", "instanceof"], operator) && re_test(left, /!\s*$/)
  warn if operator == "in" || operator == "instanceof" then "Confusing combination of non-null assertion and `{operator}` operator like `a! {operator} b`, which might be misinterpreted as `!(a {operator} b)`." else "Confusing combination of non-null assertion and equality test like `a! == b`, which looks very similar to `a !== b`."
}
in ts_assignment rule no-confusing-non-null-assertion:assign {
  when operator == "=" && re_test(left, /!\s*$/)
  warn "Confusing combination of non-null assertion and assignment like `a! = b`, which looks very similar to `a != b`."
}

in ts_call rule no-require-imports {
  option allow string[] = [] "module paths (regexes) that may be required"
  option allowAsImport boolean = false "allow `import x = require(...)`"
  when callee == "require" && (callee.resolved == "global" || parent is ts_import_equals)
  when !(allowAsImport && parent is ts_import_equals)
  when !any(allow, p => re_test(default(first([] argument.literal_value).value, "\u{0}"), p) && first([] argument.literal_value).type == "string")
  warn "A `require()` style import is forbidden."
}
in ts_call rule no-var-requires {
  when callee == "require" && callee.resolved == "global" && parent is (ts_declarator, ts_call, ts_member, ts_index, ts_new, ts_as, ts_type_assertion)
  warn "Require statement not part of import statement."
}

in ts_array, ts_arrow, ts_binary, ts_class, ts_function, ts_identifier, ts_member, ts_index, ts_meta_property, ts_object, ts_sequence, ts_template, ts_this, ts_number, ts_string, ts_boolean, ts_bigint, ts_null, ts_regex let statement_effect false
in ts_unary let statement_effect contains(["delete", "void"], operator)
in ts_logical let statement_effect { kind: "logical", right: right.statement_effect }
in ts_conditional let statement_effect { kind: "conditional", left: consequent.statement_effect, right: alternate.statement_effect }
in ts_tagged_template let statement_effect { kind: "tagged" }
in ts_jsx_element, ts_jsx_fragment let statement_effect { kind: "jsx" }
in ts_parenthesized, ts_as, ts_type_assertion, ts_non_null, ts_instantiation forward statement_effect from expression
fn expression_allowed(shape, short, ternary, tagged, jsx) = if type_of(shape) == "bool" then shape else if shape.kind == "logical" then short && expression_allowed(shape.right, short, ternary, tagged, jsx) else if shape.kind == "conditional" then ternary && expression_allowed(shape.left, short, ternary, tagged, jsx) && expression_allowed(shape.right, short, ternary, tagged, jsx) else if shape.kind == "tagged" then tagged else if shape.kind == "jsx" then !jsx else true
in ts_expression_statement rule no-unused-expressions {
  option allowShortCircuit boolean = false "Allow effectful short circuit expressions."
  option allowTernary boolean = false "Allow ternaries with effectful branches."
  option allowTaggedTemplates boolean = false "Allow tagged templates."
  option enforceForJSX boolean = false "Report unused JSX expressions."
  option ignoreDirectives boolean = false "Ignore directive prologues."
  when !(directive_statement && (ecma_version >= 5 || ignoreDirectives)) && !expression_allowed(expression.statement_effect, allowShortCircuit, allowTernary, allowTaggedTemplates, enforceForJSX)
  warn "Expected an assignment or function call and instead saw an expression."
}

}
