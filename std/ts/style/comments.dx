# .ts/style/comments: internal part of .ts/style.

define {

# ---- comments --------------------------------------------------------------------
fn linter_comment_edit(source, n) = {
  value line_start: position(n.offset).js_line_start
  value prefix: byte_slice(source, line_start, n.offset)
  value tail: n.after
  value tail_bytes: byte_len(tail)
  value tail_end: n.end_offset + tail_bytes
  value after_end: tail_end + 1
  value after_tail: byte_slice(source, tail_end, after_end)
  value newline: if after_tail == "\r" && position(after_end).line == position(tail_end).line then 2 else if re_test(after_tail, /^[\r\n]/) then 1 else 0
  value standalone: re_test(prefix, /^[ \t]*$/) && re_test(tail, /^[ \t]*$/)
  value trimmed_prefix: re_replace(prefix, /[ \t]+$/, "")
  # Inline multiline comments can carry ASI-significant line breaks.
  value if standalone then { start: line_start, end: n.end_offset + byte_len(tail) + newline, text: "" }
    else if n is ts_line_comment then { start: line_start + byte_len(trimmed_prefix), end: n.end_offset, text: "" }
    else if re_test(n.text, /[\r\n]/) then null
    else {
      start: n.offset,
      end: n.end_offset,
      text: if re_test(prefix, /\S$/) && re_test(tail, /^\S/) && !re_test(tail, /^[;,)}\]]/) then " " else ""
    }
}
# Patterns read the whole comment, `//` or `/* */` included: ESLint takes its
# config comments (`/* eslint ... */`, `/* global x */`) from block comments only.
in ts_comment rule es-ban-linter-comment {
  option formats { name: string; pattern: regex }[] = [
    { name: "tslint", pattern: /^(?:\/\/|\/\*)\s*tslint:(?:enable|disable)(?:-(?:line|next-line))?(?::|\s|\*\/|$)/ },
    { name: "eslint", pattern: /^(?:\/\/|\/\*)\s*eslint-(?:disable|enable)(?:-(?:line|next-line))?(?:\s|\*\/|$)/ },
    { name: "eslint", pattern: /^\/\*\s*(?:eslint|eslint-env|globals?|exported)(?:\s|\*\/)/ }
  ] "linter comments to report: a name for the message and a pattern over the whole comment"
  option renames { [rule: string]: string } = {} "dxlint names for ESLint rule ids in converted suppressions, over the built-in mapping"
  let format first(filter(formats, format => re_test(text, format.pattern)))
  when format != null
  let content re_replace(text, /^\/\/|^\/\*|\*\/$/, "")
  let normalised re_replace(content, /^\s+|\s+$/, "")
  # ESLint suppressions become dxlint's own; other linter comments go.
  let suppression eslint_suppression(source, node, normalised, renames)
  let edit if suppression == "keep" then null
    else if suppression != null then { start: offset, end: end_offset, text: suppression } else linter_comment_edit(source, node)
  warn "{format.name} comment detected: \"{if node is ts_line_comment then '// ' normalised else '/* ' normalised ' */'}\""
  fix at edit if edit != null as edit.text
}

# `eslint-disable-next-line a, b -- why` as `dxlint-ignore es-a es-b`; the
# block forms become `dxlint-ignore-start` / `-end`. `dxlint-ignore` alone on
# its line covers the next line, after code its own: a next-line directive
# after code has no equivalent ("keep": reported, not fixed), and a same-line
# one alone on its line suppresses nothing (null: removed). Null for other
# comments too.
fn eslint_suppression(source, n, content, renames) = {
  value kind: if re_test(content, /^eslint-(?:disable-next-line|disable-line|disable|enable)(?:\s|$)/)
    then re_replace(content, /^eslint-(disable-next-line|disable-line|disable|enable)[\s\S]*$/, "$1") else null
  value alone: re_test(byte_slice(source, position(n.offset).js_line_start, n.offset), /^[ \t]*$/)
  value rest: re_replace(re_replace(content, /^eslint-[a-z-]+/, ""), /\s--[\s\S]*$/, "")
  value ids: filter(split(trim(re_replace(rest, /[\s,]+/, " ")), " "), id => id != "")
  value names: join(map(ids, id => " " eslint_rule_name(id, renames)))
  value word: get({ disable: "dxlint-ignore-start", enable: "dxlint-ignore-end" }, kind ?? "")
    ?? (if kind == "disable-next-line" && alone || kind == "disable-line" && !alone then "dxlint-ignore" else null)
  value if kind == "disable-next-line" && !alone then "keep"
    else if word == null then null else if n is ts_line_comment then "// " word names else "/* " word names " */"
}

# An ESLint rule id as dxlint names it: the plugin goes (`@typescript-eslint/`,
# `import/`, ...), the language prefix comes.
fn eslint_rule_name(id, renames) = get(renames, id) ?? get({
  "import/no-deprecated": "es-import-no-deprecated",
  "license-header/header": "es-header"
}, id) ?? {
  value bare: re_replace(id, /^.*\//, "")
  value if contains(["eol-last", "linebreak-style", "no-trailing-spaces"], bare) then "shared-" bare else "es-" bare
}

# Only directives before the first code token are triple-slash references.
in ts_line_comment rule es-triple-slash-reference {
  option lib ("always" | "never") = "always" "When lib directives are allowed."
  option path ("always" | "never") = "never" "When path directives are allowed."
  option types ("always" | "never" | "prefer-import") = "prefer-import" "When types directives are allowed."
  let directive re_replace(text, /^\/\/\/\s*<reference\s*(types|path|lib)\s*=[\s\S]*$/, "$1")
  let module re_replace(text, /^\/\/\/\s*<reference\s*(?:types|path|lib)\s*=\s*["'|](.*)["'|][\s\S]*$/, "$1")
  when re_test(text, /^\/\/\/\s*<reference\s*(?:types|path|lib)\s*=\s*["'|].*["'|]/)
  when { value source; byte_slice 0 offset; re_test /^(?:\s|\/\/[^\r\n]*(?:\r?\n|$)|\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\/)*$/ }
  when directive == "lib" && lib == "never" || directive == "path" && path == "never" || directive == "types" && (types == "never" || types == "prefer-import" && { value result: "(?:import|from|require\\s*\\()\\s*[\"']" re_escape(module) "[\"']"; value re_test(source, result) })
  warn "Do not use a triple slash reference for {module}, use `import` style instead."
}

# JSDoc lines whose `*` is not one column right of the opening `/**`. The
# matchers never take the `*` of the closing `*/` (the comment's own end).
in ts_block_comment match jsdoc_line /^[ \t]*\*(?!\/)/
in ts_block_comment match jsdoc_close_indent /^[ \t]+(?=\*\/)/
in ts_block_comment match jsdoc_blank_run /^(?:[ \t]*\r?\n)+/
# Blank lines inside the block have no `*` at all.
in jsdoc_blank_run rule es-check-alignment:blank {
  when re_test(parent_text, /^\/\*\*[^*]/)
  warn "Expected JSDoc block to be aligned."
}
# `/**` then anything but another `*` (`/*****` banners are not JSDoc).
@macro is_jsdoc re_test(parent_text, /^\/\*\*[^*]/)
in jsdoc_line rule es-check-alignment {
  when @is_jsdoc && text != parent_indent " *"
  warn "Expected JSDoc block to be aligned."
}
in jsdoc_close_indent rule es-check-alignment:close {
  when @is_jsdoc && text != parent_indent " "
  warn "Expected JSDoc block to be aligned."
}
in ts_block_comment match jsdoc_typed_tag /^[ \t]*\*[ \t]*@(?:param|arg|argument|returns?|property|prop|throws|yields)[ \t]+\{/
in jsdoc_typed_tag rule es-no-types {
  when @is_jsdoc
  warn "Types are not permitted on @{re_replace(text, /^.*@(\w+).*$/, '$1')}."
}

}
