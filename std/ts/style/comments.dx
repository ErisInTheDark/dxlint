# .ts/style/comments: internal part of .ts/style.

define {

# ---- comments --------------------------------------------------------------------
fn tslint_comment_edit(source, n) = {
  value line_start: position(n.offset).js_line_start
  value prefix: byte_slice(source, line_start, n.offset)
  value tail: n.after
  value tail_bytes: byte_len(tail)
  value tail_end: n.end_offset + tail_bytes
  value after_end: tail_end + 1
  value after_tail: byte_slice(source, tail_end, after_end)
  value newline: if after_tail == "\r" && position(after_end).line == position(tail_end).line then 2 else if re_test(after_tail, /^[\r\n]/) then 1 else 0
  value standalone: re_test(prefix, /^[ \t]*$/) && re_test(tail, /^[ \t]*$/)
  value trimmed_prefix: re_replace(prefix, /[ \t]+$/, "")
  # Inline multiline comments can carry ASI-significant line breaks.
  value if standalone then { start: line_start, end: n.end_offset + byte_len(tail) + newline, text: "" }
    else if n is ts_line_comment then { start: line_start + byte_len(trimmed_prefix), end: n.end_offset, text: "" }
    else if re_test(n.text, /[\r\n]/) then null
    else {
      start: n.offset,
      end: n.end_offset,
      text: if re_test(prefix, /\S$/) && re_test(tail, /^\S/) && !re_test(tail, /^[;,)}\]]/) then " " else ""
    }
}
in ts_comment rule ban-tslint-comment {
  let content re_replace(text, /^\/\/|^\/\*|\*\/$/, "")
  let normalised re_replace(content, /^\s+|\s+$/, "")
  when re_test(content, /^\s*tslint:(enable|disable)(?:-(line|next-line))?(:|\s|$)/)
  let edit tslint_comment_edit(source, node)
  warn "tslint comment detected: \"{if node is ts_line_comment then '// ' normalised else '/* ' normalised ' */'}\""
  fix at edit if edit != null as edit.text
}

# Only directives before the first code token are triple-slash references.
in ts_line_comment rule triple-slash-reference {
  option lib ("always" | "never") = "always" "When lib directives are allowed."
  option path ("always" | "never") = "never" "When path directives are allowed."
  option types ("always" | "never" | "prefer-import") = "prefer-import" "When types directives are allowed."
  let directive re_replace(text, /^\/\/\/\s*<reference\s*(types|path|lib)\s*=[\s\S]*$/, "$1")
  let module re_replace(text, /^\/\/\/\s*<reference\s*(?:types|path|lib)\s*=\s*["'|](.*)["'|][\s\S]*$/, "$1")
  when re_test(text, /^\/\/\/\s*<reference\s*(?:types|path|lib)\s*=\s*["'|].*["'|]/)
  when { value source; byte_slice 0 offset; re_test /^(?:\s|\/\/[^\r\n]*(?:\r?\n|$)|\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\/)*$/ }
  when directive == "lib" && lib == "never" || directive == "path" && path == "never" || directive == "types" && (types == "never" || types == "prefer-import" && { value result: "(?:import|from|require\\s*\\()\\s*[\"']" re_escape(module) "[\"']"; value re_test(source, result) })
  warn "Do not use a triple slash reference for {module}, use `import` style instead."
}

# JSDoc lines whose `*` is not one column right of the opening `/**`. The
# matchers never take the `*` of the closing `*/` (the comment's own end).
in ts_block_comment match jsdoc_line /^[ \t]*\*(?!\/)/
in ts_block_comment match jsdoc_close_indent /^[ \t]+(?=\*\/)/
in ts_block_comment match jsdoc_blank_run /^(?:[ \t]*\r?\n)+/
# Blank lines inside the block have no `*` at all.
in jsdoc_blank_run rule check-alignment:blank {
  when re_test(parent_text, /^\/\*\*[^*]/)
  warn "Expected JSDoc block to be aligned."
}
# `/**` then anything but another `*` (`/*****` banners are not JSDoc).
@macro is_jsdoc re_test(parent_text, /^\/\*\*[^*]/)
in jsdoc_line rule check-alignment {
  when @is_jsdoc && text != parent_indent " *"
  warn "Expected JSDoc block to be aligned."
}
in jsdoc_close_indent rule check-alignment:close {
  when @is_jsdoc && text != parent_indent " "
  warn "Expected JSDoc block to be aligned."
}
in ts_block_comment match jsdoc_typed_tag /^[ \t]*\*[ \t]*@(?:param|arg|argument|returns?|property|prop|throws|yields)[ \t]+\{/
in jsdoc_typed_tag rule no-types {
  when @is_jsdoc
  warn "Types are not permitted on @{re_replace(text, /^.*@(\w+).*$/, '$1')}."
}

}
