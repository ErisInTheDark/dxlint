  when !(style == "never" && parent.layout_block_line_comment)
  let block_space layout_comma_space(space_after.text, false)
  when layout_same_line(block_space) && (block_space != "") != (style == "always")
  report at if block_space != "" then end_offset else offset
  fix space_after as if style == "always" then " " else ""
  warn if style == "always" then "Requires a space after '{{'." else "Unexpected space(s) after '{{'."
}

in ts_close_brace rule block-spacing:before {
  @layout_block_space_options
  when parent is (ts_block, ts_static_block, ts_switch, ts_enum)
  when space_before.comments || previous_token not ts_open_brace
  when !(style == "never" && parent.layout_block_line_comment)
  let block_space layout_comma_space(space_before.text, true)
  when layout_same_line(block_space) && (block_space != "") != (style == "always")
  report at if block_space != "" then offset - byte_len(block_space) else offset
  fix space_before as if style == "always" then " " else ""
  warn if style == "always" then "Requires a space before '}}'." else "Unexpected space(s) before '}}'."
}

in ts_open_bracket rule computed-property-spacing:after {
  @layout_computed_space_options
  when parent is computed_spacing_owners && parent.computed_spacing_enabled
  let computed_space layout_comma_space(space_after.text, false)
  when layout_same_line(computed_space) && (computed_space != "") != (style == "always")
  report at if computed_space != "" then end_offset else offset
  fix space_after as if style == "always" then " " else ""
  warn if style == "always" then "A space is required after '['." else "There should be no space after '['."
}

in ts_close_bracket rule computed-property-spacing:before {
  @layout_computed_space_options
  when parent is computed_spacing_owners && parent.computed_spacing_enabled
  let computed_space layout_comma_space(space_before.text, true)
  when layout_same_line(computed_space) && (computed_space != "") != (style == "always")
  report at if computed_space != "" then offset - byte_len(computed_space) else offset
  fix space_before as if style == "always" then " " else ""
  warn if style == "always" then "A space is required before ']'." else "There should be no space before ']'."
}

in ts_yield.operator rule yield-star-spacing:before {
  @layout_yield_star_options
  when text == "*" && previous_token != null
  when space_before.spaced != (before.nonempty ?? mode == "before" || mode == "both")
  warn if space_before.spaced then "Unexpected space before *." else "Missing space before *."
}

in ts_yield.operator rule yield-star-spacing:after {
  @layout_yield_star_options
  when text == "*" && next_token != null
  when space_after.spaced != (after.nonempty ?? mode == "after" || mode == "both")
  warn if space_after.spaced then "Unexpected space after *." else "Missing space after *."
}

in ts_function.modifier rule generator-star-spacing:named {
  when parent.generator_star_named
  @layout_generator_star_options
}
in ts_function.modifier rule generator-star-spacing:anonymous {
  when !parent.generator_star_named
  @layout_generator_star_options
}
in ts_method.modifier rule generator-star-spacing:method {
  when !parent.generator_star_shorthand
  @layout_generator_star_options
}
in ts_method.modifier rule generator-star-spacing:shorthand {
  when parent.generator_star_shorthand
  @layout_generator_star_options
}

group layout_generic_owner ts_function, ts_arrow, ts_class, ts_interface, ts_type_alias, ts_method,
  ts_call, ts_new, ts_tagged_template, ts_type_reference, ts_function_type, ts_method_signature, ts_call_signature
in layout_generic_owner let layout_generic_parameter_tokens type_parameter.token_neighbours
in layout_generic_owner let layout_generic_argument_tokens type_argument.token_neighbours
in layout_generic_owner let layout_generic_parameters { open: first(layout_generic_parameter_tokens).before.start, close: last(layout_generic_parameter_tokens).after.start, closed: last(layout_generic_parameter_tokens).after.text == ">" }
in layout_generic_owner let layout_generic_arguments { open: first(layout_generic_argument_tokens).before.start, close: last(layout_generic_argument_tokens).after.start, closed: last(layout_generic_argument_tokens).after.text == ">" }
in ts_open_angle, ts_close_angle let layout_generic_edge parent is layout_generic_owner && (parent.layout_generic_parameters.closed && offset == (if is ts_open_angle then parent.layout_generic_parameters.open else parent.layout_generic_parameters.close) || parent.layout_generic_arguments.closed && offset == (if is ts_open_angle then parent.layout_generic_arguments.open else parent.layout_generic_arguments.close))
@macro layout_generic_policy {
  option before boolean = false "space before generic brackets"
  option after boolean = false "space after generic brackets"
  when layout_generic_edge
}

in ts_open_angle rule type-generic-spacing {
  @layout_generic_policy
  when parent not (ts_arrow, ts_function_type, ts_call_signature)
  when parent not (ts_function, ts_class) || parent.name != null
  when previous_token != null
  let generic_space layout_comma_space(space_before.text, true)
  when before != (generic_space != "")
  report at { start: offset - byte_len(generic_space), end: offset }
  warn "Generic spaces mismatch"
}
in ts_close_angle rule type-generic-spacing:after {
  @layout_generic_policy
  when parent is (ts_call, ts_new, ts_tagged_template, ts_call_signature, ts_method_signature, ts_function_type)
  when next_token != null
  let generic_space layout_comma_space(space_after.text, false)
  when after != (generic_space != "")
  report at { start: end_offset, end: end_offset + byte_len(generic_space) }
  warn "Generic spaces mismatch"
}
in ts_open_angle rule type-generic-spacing:inner-open {
  @layout_generic_policy
  when re_test(space_after.text, /\s/) && !re_test(space_after.text, /^[\n\r]/)
