# .ts/layout: @stylistic spacing, punctuation and line-break rules on the
# native TypeScript layers and token facts.

define {

fn layout_comma_space(gap, before_side) = default(re_find(gap, if before_side then /\s*$/ else /^\s*/), "")
fn layout_same_line(gap) = !re_test(gap, /[\n\r\u{2028}\u{2029}]/)
@macro layout_block_space_options {
  option style "always" | "never" = "always" "spaces inside non-empty blocks"
}
@macro layout_computed_space_options {
  option style "always" | "never" = "never" "spaces inside computed property brackets"
  option enforceForClassMembers boolean = true "check computed class members"
}
@macro layout_switch_colon_options {
  option before boolean = false "space before case colon"
  option after boolean = true "space after case colon"
}
in ts_block, ts_static_block, ts_switch, ts_enum let layout_block_line_comment starts_with(trim_start(opener.ts_open_brace.space_after.text), "//")
in ts_method let layout_class_method parent is ts_class
in ts_computed_key let layout_computed_class parent is ts_class_property || default(parent.layout_class_method, false)
in ts_rest, ts_spread let layout_spread_property parent is (ts_object, ts_object_pattern)
in ts_block let layout_block_function parent is (ts_function, ts_arrow, ts_method)
in ts_block let layout_block_case parent is ts_case
in ts_block let layout_block_module parent is ts_namespace
in ts_block let layout_brace_excluded parent is (ts_program, ts_block, ts_case)
in ts_block let layout_brace_keyword parent is (ts_if, ts_try)
in ts_block, ts_static_block, ts_switch, ts_class let layout_brace_single opener.ts_open_brace.line == closer.ts_close_brace.line
in ts_function let layout_generator_kind if name != null then "named" else "anonymous"
in ts_method let layout_generator_kind if parent is ts_object then "shorthand" else "method"
@macro layout_yield_star_options {
  option mode "before" | "after" | "both" | "neither" = "after" "spacing around yield star"
  option before boolean | null = null "override space before star"
  option after boolean | null = null "override space after star"
}
@macro layout_generator_star_options {
  option mode "before" | "after" | "both" | "neither" = "before" "spacing around generator star"
  option before boolean | null = null "override space before star"
  option after boolean | null = null "override space after star"
  option named star_mode | null = null "named function override"
  option anonymous star_mode | null = null "anonymous function override"
  option method star_mode | null = null "method override"
  option shorthand star_mode | null = null "object method override"
  let star_override if parent.layout_generator_kind == "named" then named else if parent.layout_generator_kind == "anonymous" then anonymous else if parent.layout_generator_kind == "shorthand" then default(shorthand, method) else method
  let resolved_mode if type_of(star_override) == "str" then star_override else mode
}
fn layout_star_space(overridden, mode, configured, before_side) = if type_of(overridden) == "str" then mode == "both" || mode == (if before_side then "before" else "after") else default(get(overridden, if before_side then "before" else "after"), default(configured, mode == "both" || mode == (if before_side then "before" else "after")))
macro layout_comment_pattern "(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/|//[^\\n\\r\\u{{2028}}\\u{{2029}}]*)"
macro layout_horizontal_space "[^\\S\\n\\r\\u{{2028}}\\u{{2029}}]"
fn layout_padding_attached_start(gap) = default(re_find(gap, "^(?:" layout_horizontal_space "*" layout_comment_pattern ")*"), "")
fn layout_padding_attached_end(gap) = default(re_find(gap, "(?:" layout_comment_pattern layout_horizontal_space "*)*$"), "")
fn layout_padding_last_attached(prefix) = re_replace(prefix, "^(?:" layout_horizontal_space "*(" layout_comment_pattern "))*$", "$1")
fn layout_padding_last_comment(gap) = re_replace(gap, "^(?:\\s*(" layout_comment_pattern "))*\\s*$", "$1")
fn layout_padding_top_space(gap) = layout_comma_space(slice(gap, len(layout_padding_attached_start(gap))), false)
fn layout_padding_tail_space(gap) = default(re_find(gap, if starts_with(layout_padding_last_comment(gap), "//") then /(?:\r\n|[\n\r\u{2028}\u{2029}])\s*$/ else /\s*$/), "")
fn layout_padding_bottom_space(gap) = layout_padding_tail_space(slice(gap, 0, len(gap) - len(layout_padding_attached_end(gap))))
fn layout_line_breaks(gap) = re_count(gap, /\r\n|[\n\r\u{2028}\u{2029}]/)
fn layout_padding_mode(style, blocks, switches, classes, kind) = if style != null then style else if blocks == null && switches == null && classes == null then "always" else if kind == "ts_class" then classes else if kind == "ts_switch" then switches else blocks
macro layout_padding_options {
  option style "always" | "never" | "start" | "end" | null = null "padding at block boundaries"
  option blocks "always" | "never" | "start" | "end" | null = null "statement block padding"
  option switches "always" | "never" | "start" | "end" | null = null "switch padding"
  option classes "always" | "never" | "start" | "end" | null = null "class padding"
  option allowSingleLineBlocks boolean = false "allow single-line blocks"
}
in ts_function, ts_method, ts_arrow, ts_function_type, ts_method_signature, ts_call_signature, ts_class, ts_interface, ts_type_alias let layout_last_type_parameter_end last(type_parameter.end_offset)
in ts_block, ts_static_block let layout_padding_content body != null
in ts_switch let layout_padding_content case != null
in ts_class let layout_padding_content member != null
in ts_block, ts_static_block, ts_switch, ts_class {
  let layout_padding_open_prefix layout_padding_attached_start(opener.ts_open_brace.space_after.text)
  let layout_padding_close_suffix layout_padding_attached_end(closer.ts_close_brace.space_before.text)
  let layout_padding_single opener.ts_open_brace.line + layout_line_breaks(layout_padding_open_prefix) == closer.ts_close_brace.line - layout_line_breaks(layout_padding_close_suffix)
}

in ts_variable_declaration, ts_array, ts_array_pattern, ts_object, ts_object_pattern, ts_function, ts_method, ts_arrow, ts_function_type, ts_call, ts_new, ts_import_call, ts_import, ts_export, ts_sequence, ts_enum, ts_tuple_type, ts_type_literal, ts_method_signature, ts_call_signature, ts_index_signature, ts_class, ts_interface, ts_type_alias, ts_type_reference, ts_tagged_template rule comma-style {
  option style "last" | "first" = "last" "comma line position"
  option exceptions { [key: string]: boolean } = {} "exempt list node kinds"
  each comma_line in filter(comma_line_sites, s => get(exceptions, s.owner) != true && (s.before_break && s.after_break || (if style == "last" then s.before_break else s.after_break)))
  report at comma_line.offset
  warn if comma_line.before_break && comma_line.after_break then "Bad line breaking before and after ','." else if style == "last" then "',' should be placed last." else "',' should be placed first."
}

in ts_program rule no-multi-spaces {
  option ignoreEOLComments boolean = false "ignore final comments on a line"
  option includeTabs boolean = true "include tabs in repeated whitespace"
  option exceptions { [key: string]: boolean } = {} "exempt node kinds"
  each multiple_gap in filter(multiple_space_sites, s => (includeTabs || contains(s.gap, "  ")) && !(ignoreEOLComments && s.eol_comment) && get(exceptions, s.owner) != true)
  report at multiple_gap.start
  fix as slice(text, 0, multiple_gap.start) " " slice(text, multiple_gap.end)
  warn "Multiple spaces found before '{multiple_gap.display}'."
}

in ts_string let layout_quote_fixed_string (parent is ts_property || parent is ts_pattern_property || parent is ts_method || parent is ts_class_property || parent is ts_method_signature || parent is ts_property_signature) && field == "key" || (parent is ts_import || parent is ts_export) && (field == "from" || field == "namespace") || parent is ts_import_specifier && field == "imported" || parent is ts_export_specifier || (parent is ts_namespace || parent is ts_enum_member) && field == "name" || parent is ts_import_type && field == "argument"
in ts_literal_type let layout_quote_import_argument parent is ts_import_type && offset == parent.argument.offset
in ts_call let layout_quote_external_module parent is ts_import_equals && offset == parent.value.offset
in ts_program let layout_quote_prologue true
in ts_block let layout_quote_prologue (parent is ts_function || parent is ts_arrow || parent is ts_method) && offset == parent.body.offset
in ts_expression_statement let layout_quote_directive default(parent.layout_quote_prologue, false) && expression.layer is ts_string && (previous == null || default(previous.layout_quote_directive, false))
in ts_template let layout_quote_template_feature count(expression) > 0 || parent is ts_tagged_template && field == "quasi" || re_test(text, /(^|[^\\])(\\\\)*[\n\r\u{2028}\u{2029}]/)
in ts_string, ts_template rule quotes {
  option style "double" | "single" | "backtick" = "double" "string delimiters"
  option avoidEscape boolean = false "allow alternate quotes to avoid escapes"
  option allowTemplateLiterals "never" | "avoidEscape" | "always" | boolean = "never" "allow unused template delimiters"
  option ignoreStringLiterals boolean = false "check templates only"
  let quote_template layer is ts_template
  let quote_fixed default(layout_quote_fixed_string, false) || parent is ts_expression_statement && parent.layout_quote_directive || parent is ts_literal_type && default(parent.layout_quote_import_argument, false) || parent is ts_call && default(parent.layout_quote_external_module, false)
  let quote_delimiter if style == "single" then "'" else if style == "double" then "\"" else "`"
  let quote_alternate if style == "double" then "'" else "\""
  when if quote_template then style != "backtick" && allowTemplateLiterals != "always" && allowTemplateLiterals != true && !layout_quote_template_feature && !((allowTemplateLiterals == "avoidEscape") && avoidEscape && contains(text, quote_delimiter)) else !ignoreStringLiterals && parent not ts_jsx_attribute && !(style == "backtick" && quote_fixed) && !starts_with(text, quote_delimiter) && !(avoidEscape && starts_with(text, quote_alternate) && contains(text, quote_delimiter))
  warn "Strings must use {if style == 'single' then 'singlequote' else if style == 'double' then 'doublequote' else 'backtick'}."
}

in ts_property, ts_pattern_property, ts_property_signature, ts_enum_member, ts_object, ts_interface, ts_type_literal, ts_enum, ts_import, ts_export rule quote-props {
  option style "always" | "as-needed" | "consistent" | "consistent-as-needed" = "always" "property quoting policy"
  option keywords boolean = false "require quotes on reserved words"
  option unnecessary boolean = true "report redundant quotes"
  option numbers boolean = false "require quoted numeric keys"
  let property_any_quoted any(property_quote_sites, s => s.quoted)
  let property_necessary any(property_quote_sites, s => s.quoted && !s.redundant || keywords && s.keyword)
  let property_keyword last(filter(property_quote_sites, s => !s.quoted && s.keyword)).name
  each property_site in filter(property_quote_sites, s => s.group == (style == "consistent" || style == "consistent-as-needed"))
  when if style == "always" then !property_site.quoted else if style == "as-needed" then (if property_site.quoted then unnecessary && property_site.redundant && !(numbers && property_site.redundant_number) && !(keywords && property_site.keyword) else keywords && property_site.keyword || numbers && property_site.numeric) else if style == "consistent-as-needed" && property_any_quoted && !property_necessary then property_site.quoted else !property_site.quoted && (property_any_quoted || style == "consistent-as-needed" && keywords && property_keyword != null)
  report at property_site.offset
  warn if style == "always" then "Unquoted property '{property_site.name}' found." else if style == "as-needed" then (if property_site.quoted then "Unnecessarily quoted property '{property_site.name}' found." else if property_site.keyword then "Unquoted reserved word '{property_site.name}' used as key." else "Unquoted number literal '{property_site.name}' used as key.") else if style == "consistent-as-needed" && !property_necessary then "Properties shouldn't be quoted as all quotes are redundant." else if style == "consistent-as-needed" && keywords && property_keyword != null then "Properties should be quoted as '{property_keyword}' is a reserved word." else "Inconsistently quoted property '{property_site.name}' found."
}

schema member_separator_options { delimiter?: "semi" | "comma" | "none"; requireLast?: boolean }
schema member_separator_config { multiline?: member_separator_options; singleline?: member_separator_options }
in ts_interface, ts_type_literal rule member-delimiter-style {
  option delimiter "semi" | "comma" | "none" | null = null "default separator for legacy configurations"
  option multiline member_separator_options = {} "multiline member separators"
  option singleline member_separator_options = {} "single-line member separators"
  option overrides { interface?: member_separator_config; typeLiteral?: member_separator_config } = {} "separators by declaration kind"
  option multilineDetection "brackets" | "last-member" = "brackets" "multiline classification"
  let member_delimiter_owner first(member_delimiter_sites)
  when member_delimiter_owner != null
  let member_single member_delimiter_owner.single_line || multilineDetection == "last-member" && member_delimiter_owner.last_same_line
  let member_override if member_delimiter_owner.kind == "interface" then overrides.interface else overrides.typeLiteral
  let member_base if member_single then singleline else multiline
  let member_policy if member_single then member_override.singleline else member_override.multiline
  let member_delimiter default(member_policy.delimiter, default(member_base.delimiter, default(delimiter, "semi")))
  let member_require_last default(member_policy.requireLast, default(member_base.requireLast, !member_single))
  each member_site in member_delimiter_sites
  when member_site.delimiter != (if member_site.last && !member_require_last then "none" else member_delimiter)
  report at member_site.offset
  warn if member_site.last && !member_require_last || member_delimiter == "none" then (if member_site.delimiter == "semi" then "Unexpected separator (;)." else "Unexpected separator (,).") else if member_delimiter == "semi" then "Expected a semicolon." else "Expected a comma."
}

in ts_program rule spaced-comment {
  option style "always" | "never" = "always" "spacing inside comment delimiters"
  option exceptions string[] = [] "repeated sequences exempt from spacing"
  option markers string[] = [] "comment prefix markers"
  option line { exceptions?: string[]; markers?: string[] } = {} "line-comment options"
  option block { exceptions?: string[]; markers?: string[]; balanced?: boolean } = {} "block-comment options"
  let comment_policies map([
    { kind: "line", markers: if line.markers != null then line.markers else markers, exceptions: if line.exceptions != null then line.exceptions else exceptions },
    { kind: "block", markers: if block.markers != null then block.markers else markers, exceptions: if block.exceptions != null then block.exceptions else exceptions }
  ], p => {
    kind: p.kind,
    markers: p.markers,
    marker_pattern: "(?:" join(map(p.markers, m => re_escape(m)), "|") (if count(p.markers) > 0 then "|\\*)" else "\\*)"),
    exception_pattern: if count(p.exceptions) == 0 then "\\s" else "(?:\\s|(?:" join(map(p.exceptions, e => "(?:" re_escape(e) ")+"), "|") ")(?:$|[\\n\\r\\u{{2028}}\\u{{2029}}]))",
    has_exceptions: count(p.exceptions) > 0
  })
  each comment_site in map(map(map(comment_contents, c => {
    site: c, policy: find(comment_policies, p => p.kind == c.kind)
  }), c => {
    site: c.site, policy: c.policy, marker: default(re_find(c.site.body, "^" c.policy.marker_pattern), "")
  }), c => {
    site: c.site, policy: c.policy, marker: c.marker,
    identifier: if c.site.kind == "block" then "/*" else "//",
    skip: c.site.body == "" || c.site.body == "*" || contains(c.policy.markers, c.site.body) || c.site.kind == "line" && re_test(c.site.body, /^\/\s*<(?:reference|amd-)/),
    begin_bad: if style == "always" then !re_test(c.site.body, "^" c.policy.marker_pattern "?" c.policy.exception_pattern) else re_test(c.site.body, "^" c.policy.marker_pattern "?[ \\t]+"),
    end_bad: c.site.kind == "block" && block.balanced == true && (if style == "always" then !re_test(c.site.body, c.policy.exception_pattern "$") else re_test(c.site.body, /[ \t]+$/))
  })
  when !comment_site.skip && (if comment_site.site.side == "begin" then comment_site.begin_bad else comment_site.end_bad)
  report at comment_site.site.offset
  warn if comment_site.site.side == "end" then (if style == "always" then "Expected space or tab before '*/' in comment." else "Unexpected space or tab before '*/' in comment.") else if style == "always" then (if comment_site.policy.has_exceptions then "Expected exception block, space or tab after '{comment_site.identifier}{comment_site.marker}' in comment." else "Expected space or tab after '{comment_site.identifier}{comment_site.marker}' in comment.") else if comment_site.marker != "" then "Unexpected space or tab after marker ({comment_site.marker}) in comment." else "Unexpected space or tab after '{comment_site.identifier}' in comment."
}

in ts_number rule no-floating-decimal:leading {
  when starts_with(text, ".")
  warn "A leading decimal point can be confused with a dot."
  fix as (if token_neighbours.before.gap == "" && re_test(token_neighbours.before.text, /[\w$]$/) then " 0" else "0") text
}
in ts_number rule no-floating-decimal:trailing {
  when ends_with(text, ".")
  warn "A trailing decimal point can be confused with a dot."
  fix as text "0"
}

in ts_program rule no-multiple-empty-lines {
  option max int(0..) = 2 "maximum consecutive blank lines"
  option maxEOF int(0..) | null = null "maximum final blank lines"
  option maxBOF int(0..) | null = null "maximum initial blank lines"
  each blank_run in map(empty_line_runs, s => {
    site: s,
    limit: if s.kind == "bof" then default(maxBOF, max) else if s.kind == "eof" then default(maxEOF, max) else max
  })
  when blank_run.site.count > blank_run.limit
  report at first(slice(blank_run.site.offsets, blank_run.limit))
  warn if blank_run.site.kind == "bof" then "Too many blank lines at the beginning of file. Max of {blank_run.limit} allowed." else if blank_run.site.kind == "eof" then "Too many blank lines at the end of file. Max of {blank_run.limit} allowed." else "More than {blank_run.limit} blank {if blank_run.limit == 1 then 'line' else 'lines'} not allowed."
}

schema annotation_gap_options { before?: boolean; after?: boolean }
in ts_declarator, ts_parameter, ts_class_property, ts_property_signature, ts_index_signature, ts_tuple_member, ts_mapped_type let layout_annotation_start type.offset
in ts_function, ts_arrow, ts_method, ts_method_signature, ts_call_signature, ts_function_type let layout_annotation_start return_type.offset
in ts_declarator let layout_annotation_category "variable"
in ts_parameter let layout_annotation_category "parameter"
in ts_class_property, ts_property_signature, ts_index_signature, ts_method_signature, ts_call_signature let layout_annotation_category "property"
in ts_function, ts_arrow, ts_method let layout_annotation_category "returnType"
in ts_function_type, ts_tuple_member, ts_mapped_type let layout_annotation_category "colon"
in ts_colon let layout_annotation_optional token_neighbours.before.text == "?"
@macro layout_annotation_options {
  option before boolean = false "space before annotation punctuation"
  option after boolean = true "space after annotation punctuation"
  option overrides { colon?: annotation_gap_options; variable?: annotation_gap_options | "ignore"; property?: annotation_gap_options | "ignore"; parameter?: annotation_gap_options | "ignore"; returnType?: annotation_gap_options | "ignore"; questionMark?: annotation_gap_options | "ignore" } = {} "annotation context policies"
  when parent.layout_annotation_start != null && offset < parent.layout_annotation_start
  let annotation_category parent.layout_annotation_category
  let annotation_policy if annotation_category == "variable" then overrides.variable else if annotation_category == "property" then overrides.property else if annotation_category == "parameter" then overrides.parameter else if annotation_category == "returnType" then overrides.returnType else overrides.colon
  when annotation_policy != "ignore"
  let annotation_colon_before default(overrides.colon.before, before)
  let annotation_colon_after default(overrides.colon.after, after)
  let annotation_optional layout_annotation_optional && overrides.questionMark != "ignore"
  let annotation_label if !annotation_optional then ":" else if starts_with(parent.optional, "+") then "+?:" else if starts_with(parent.optional, "-") then "-?:" else "?:"
  let annotation_before if annotation_optional then default(overrides.questionMark.before, annotation_colon_before) else default(annotation_policy.before, annotation_colon_before)
  let annotation_after default(annotation_policy.after, annotation_colon_after)
}
in ts_colon rule type-annotation-spacing:before {
  @layout_annotation_options
  let annotation_gap if annotation_optional then parent.optional.space_before else space_before
  when annotation_gap != null && annotation_gap.spaced != annotation_before
  report at if annotation_optional then parent.optional.offset else offset
  warn if annotation_before then "Expected a space before the '{annotation_label}'." else "Unexpected space before the '{annotation_label}'."
}
in ts_colon rule type-annotation-spacing:after {
  @layout_annotation_options
  when space_after.spaced != annotation_after
  warn if annotation_after then "Expected a space after the '{annotation_label}'." else "Unexpected space after the '{annotation_label}'."
}
in ts_colon rule type-annotation-spacing:between {
  when layout_annotation_optional
  @layout_annotation_options
  when annotation_optional
  let annotation_inner default(overrides.questionMark.after, false)
  when space_before.spaced != annotation_inner
  warn if annotation_inner then "Expected a space between the '?' and the ':'." else "Unexpected space between the '?' and the ':'."
}

in ts_block, ts_static_block, ts_switch, ts_class rule padded-blocks:top {
  layout_padding_options
  when opener.ts_open_brace.offset != null
  when layout_padding_content
  let padding_mode layout_padding_mode(style, blocks, switches, classes, layer)
  when padding_mode != null
  when !(allowSingleLineBlocks && layout_padding_single)
  let padding_space layout_padding_top_space(opener.ts_open_brace.space_after.text)
  let padding_padded layout_line_breaks(padding_space) >= 2
  when padding_padded != (padding_mode == "always" || padding_mode == "start")
  report at if layout_padding_open_prefix == "" then opener.ts_open_brace.offset else opener.ts_open_brace.end_offset + byte_len(layout_padding_open_prefix) - byte_len(layout_padding_last_attached(layout_padding_open_prefix))
  warn if padding_padded then "Block must not be padded by blank lines." else "Block must be padded by blank lines."
}

in ts_block, ts_static_block, ts_switch, ts_class rule padded-blocks:bottom {
  layout_padding_options
  when closer.ts_close_brace.offset != null
  when layout_padding_content
  let padding_mode layout_padding_mode(style, blocks, switches, classes, layer)
  when padding_mode != null
  when !(allowSingleLineBlocks && layout_padding_single)
  let padding_space layout_padding_bottom_space(closer.ts_close_brace.space_before.text)
  let padding_padded layout_line_breaks(padding_space) >= 2
  when padding_padded != (padding_mode == "always" || padding_mode == "end")
  report at closer.ts_close_brace.offset - byte_len(layout_padding_close_suffix) - byte_len(padding_space)
  warn if padding_padded then "Block must not be padded by blank lines." else "Block must be padded by blank lines."
}

in ts_class rule lines-between-class-members {
  option style "always" | "never" = "always" "blank lines between class members"
  option enforce { blankLine: "always" | "never"; prev: "method" | "field" | "*"; next: "method" | "field" | "*" }[] = [] "policy by neighbouring member kinds"
  option exceptAfterSingleLine boolean = false "skip after single-line members"
  option exceptAfterOverload boolean = true "skip overload signatures"
  let skip_overloads exceptAfterOverload && (count(enforce) == 0 && style == "always" || any(enforce, e => e.blankLine == "always" && e.prev != "field" && e.next != "field"))
  each class_gap in map(filter(class_member_gaps, s => s.overloads_skipped == skip_overloads), s => {
    site: s,
    mode: if count(enforce) == 0 then style else find_last(enforce, e => (e.prev == "*" || e.prev == s.prev) && (e.next == "*" || e.next == s.next)).blankLine
  })
  when class_gap.mode == "never" && class_gap.site.padded || class_gap.mode == "always" && !class_gap.site.padded && !(exceptAfterSingleLine && class_gap.site.single_line)
  report at class_gap.site.offset
  warn if class_gap.site.padded then "Unexpected blank line between class members." else "Expected blank line between class members."
}

in ts_binary.operator, ts_logical.operator, ts_assignment.operator, ts_equals, ts_question, ts_colon, ts_punctuator rule space-infix-ops {
  option int32Hint boolean = false "allow terminal |0 conversion"
  option ignoreOperators string[] = [] "operators exempt from spacing"
  option ignoreTypes boolean = false "skip union and intersection operators"
  let infix_types parent is (ts_union, ts_intersection)
  when parent is (ts_binary, ts_logical, ts_assignment)
    || infix_types && contains(["|", "&"], text)
    || parent is (ts_conditional, ts_conditional_type) && contains(["?", ":"], text)
    || parent is (ts_assignment_pattern, ts_declarator, ts_parameter, ts_class_property, ts_enum_member, ts_type_alias, ts_type_parameter) && text == "="
  when !(ignoreTypes && infix_types)
  when !(int32Hint && parent is (ts_binary, ts_logical, ts_assignment, ts_assignment_pattern) && ends_with(parent_text, "|0"))
  when !contains(ignoreOperators, text)
  when !(space_before.spaced && space_after.spaced)
  warn "Operator '{text}' must be spaced."
}

in ts_open_brace rule space-before-blocks {
  option style "always" | "never" = "always" "spaces before blocks"
  option functions "always" | "never" | "off" | null = null "function body policy"
  option keywords "always" | "never" | "off" | null = null "statement body policy"
  option classes "always" | "never" | "off" | null = null "class body policy"
  option modules "always" | "never" | "off" | null = null "module body policy"
  when parent is (ts_block, ts_switch, ts_class, ts_interface, ts_enum) && previous_token != null
  let block_class parent is (ts_class, ts_interface, ts_enum)
  let block_function default(parent.layout_block_function, false)
  let block_previous token_neighbours.before.text
  when block_previous != "=>"
  when !(contains(["try", "do", "else", "finally", "catch", "static"], block_previous) && !block_class && !block_function)
  when !(block_previous == ":" && default(parent.layout_block_case, false))
  when !space_before.line_break
  let block_mode if block_class then default(classes, style) else if block_function then default(functions, style) else if default(parent.layout_block_module, false) then default(modules, style) else default(keywords, style)
  when block_mode != "off" && space_before.spaced != (block_mode == "always")
  warn if space_before.spaced then "Unexpected space before opening brace." else "Missing space before opening brace."
}

in ts_open_paren rule space-before-function-paren {
  option style "always" | "never" = "always" "spaces before function parameter lists"
  option named "always" | "never" | "ignore" | null = null "named function policy"
  option anonymous "always" | "never" | "ignore" | null = null "anonymous function policy"
  option asyncArrow "always" | "never" | "ignore" | null = null "async arrow policy"
  option catch "always" | "never" | "ignore" | null = null "catch policy"
  when parent is (ts_function, ts_method, ts_arrow, ts_try) && previous_token != null
  let function_named parent is ts_method || parent.name != null
  when !(parent is ts_function && !function_named && contains(parent.modifier, "*"))
  when parent not ts_arrow || token_neighbours.before.text == "async"
  when parent not ts_try || parent.parameter != null
  let paren_mode if parent is ts_try then default(catch, style) else if parent is ts_arrow then default(asyncArrow, style) else if function_named then default(named, style) else default(anonymous, style)
  when paren_mode != "ignore" && !(paren_mode == "always" && !function_named && parent.type_parameter != null)
  when space_before.spaced != (paren_mode == "always")
  report at if space_before.spaced then space_before.start else offset
  warn if space_before.spaced then "Unexpected space before function parentheses." else "Missing space before function parentheses."
}

schema trailing_comma_mode "always-multiline" | "always" | "never" | "only-multiline" | "ignore"
in ts_array, ts_array_pattern, ts_object, ts_object_pattern, ts_function, ts_arrow, ts_method, ts_function_type, ts_call, ts_new, ts_import_call, ts_import, ts_export, ts_enum, ts_tuple_type, ts_class, ts_interface, ts_type_alias, ts_type_reference, ts_method_signature, ts_call_signature rule comma-dangle {
  option style trailing_comma_mode = "never" "trailing comma policy"
  option arrays trailing_comma_mode | null = null "array policy"
  option objects trailing_comma_mode | null = null "object policy"
  option functions trailing_comma_mode | null = null "parameter and argument policy"
  option imports trailing_comma_mode | null = null "named import policy"
  option exports trailing_comma_mode | null = null "named export policy"
  option importAttributes trailing_comma_mode | null = null "import attribute policy"
  option dynamicImports trailing_comma_mode | null = null "dynamic import policy"
  option enums trailing_comma_mode | null = null "enum policy"
  option generics trailing_comma_mode | null = null "type parameter policy"
  option tuples trailing_comma_mode | null = null "tuple policy"
  each dangle_check in map(trailing_comma_sites, s => {
    site: s,
    mode: if s.kind == "arrays" then default(arrays, style) else if s.kind == "objects" then default(objects, style) else if s.kind == "functions" then default(functions, style) else if s.kind == "imports" then default(imports, style) else if s.kind == "exports" then default(exports, style) else if s.kind == "dynamicImports" then default(dynamicImports, style) else if s.kind == "enums" then default(enums, style) else if s.kind == "generics" then default(generics, style) else if s.kind == "tuples" then default(tuples, style) else "never"
  })
  when dangle_check.mode != "ignore"
  when if dangle_check.mode == "always" || dangle_check.mode == "always-multiline" && dangle_check.site.multiline then
    dangle_check.site.trailing != dangle_check.site.allowed
    else dangle_check.site.trailing && !(dangle_check.mode == "only-multiline" && dangle_check.site.multiline) && !dangle_check.site.tsx_single
  report at dangle_check.site.offset
  fix as slice(text, 0, dangle_check.site.offset - offset) (if dangle_check.site.trailing then "" else ",") slice(text, dangle_check.site.offset - offset + (if dangle_check.site.trailing then 1 else 0))
  warn if dangle_check.site.trailing then "Unexpected trailing comma." else "Missing trailing comma."
}

in ts_parenthesized let layout_property_name default(expression.layout_property_name, expression)
in ts_parenthesized_type let layout_property_name default(type.layout_property_name, type)
in ts_member let layout_property_name property
in ts_index, ts_indexed_access let layout_property_name default(index.layout_property_name, index)
in ts_qualified_name let layout_property_name right
in ts_member let layout_property_spaced object.space_after.spaced || property.space_before.spaced
in ts_qualified_name let layout_property_spaced left.space_after.spaced || right.space_before.spaced
in ts_member let layout_property_same_line position(object.end_offset).line == position(property.offset).line
in ts_index let layout_property_same_line position(object.end_offset).line == position(index.offset).line
in ts_member, ts_qualified_name rule no-whitespace-before-property {
  when default(layout_property_same_line, true) && layout_property_spaced
  warn "Unexpected whitespace before property {layout_property_name}."
}
in ts_index, ts_indexed_access rule no-whitespace-before-property:computed {
  when default(layout_property_same_line, true)
  when object.space_after.spaced || opener.ts_open_bracket.space_before.spaced
  warn "Unexpected whitespace before property {layout_property_name}."
}
in ts_dot rule no-whitespace-before-property:import {
  when parent is ts_import_type && parent.qualifier != null
  when space_before.spaced || space_after.spaced
  report at parent.offset
  warn "Unexpected whitespace before property {parent.qualifier}."
}

in ts_open_brace rule block-spacing:after {
  @layout_block_space_options
  when parent is (ts_block, ts_static_block, ts_switch, ts_enum)
  when space_after.comments || next_token not ts_close_brace
  when !(style == "never" && parent.layout_block_line_comment)
  let block_space layout_comma_space(space_after.text, false)
  when layout_same_line(block_space) && (block_space != "") != (style == "always")
  report at if block_space != "" then end_offset else offset
  fix space_after as if style == "always" then " " else ""
  warn if style == "always" then "Requires a space after '{{'." else "Unexpected space(s) after '{{'."
}

in ts_close_brace rule block-spacing:before {
  @layout_block_space_options
  when parent is (ts_block, ts_static_block, ts_switch, ts_enum)
  when space_before.comments || previous_token not ts_open_brace
  when !(style == "never" && parent.layout_block_line_comment)
  let block_space layout_comma_space(space_before.text, true)
  when layout_same_line(block_space) && (block_space != "") != (style == "always")
  report at if block_space != "" then offset - byte_len(block_space) else offset
  fix space_before as if style == "always" then " " else ""
  warn if style == "always" then "Requires a space before '}}'." else "Unexpected space(s) before '}}'."
}

in ts_open_bracket rule computed-property-spacing:after {
  @layout_computed_space_options
  when parent is (ts_computed_key, ts_index, ts_indexed_access)
  when !default(parent.layout_computed_class, false) || enforceForClassMembers
  let computed_space layout_comma_space(space_after.text, false)
  when layout_same_line(computed_space) && (computed_space != "") != (style == "always")
  report at if computed_space != "" then end_offset else offset
  fix space_after as if style == "always" then " " else ""
  warn if style == "always" then "A space is required after '['." else "There should be no space after '['."
}

in ts_close_bracket rule computed-property-spacing:before {
  @layout_computed_space_options
  when parent is (ts_computed_key, ts_index, ts_indexed_access)
  when !default(parent.layout_computed_class, false) || enforceForClassMembers
  let computed_space layout_comma_space(space_before.text, true)
  when layout_same_line(computed_space) && (computed_space != "") != (style == "always")
  report at if computed_space != "" then offset - byte_len(computed_space) else offset
  fix space_before as if style == "always" then " " else ""
  warn if style == "always" then "A space is required before ']'." else "There should be no space before ']'."
}

schema star_mode "before" | "after" | "both" | "neither" | { before?: boolean; after?: boolean }

in ts_yield.operator rule yield-star-spacing:before {
  @layout_yield_star_options
  when text == "*" && previous_token != null
  when space_before.spaced != default(before, mode == "before" || mode == "both")
  warn if space_before.spaced then "Unexpected space before *." else "Missing space before *."
}

in ts_yield.operator rule yield-star-spacing:after {
  @layout_yield_star_options
  when text == "*" && next_token != null
  when space_after.spaced != default(after, mode == "after" || mode == "both")
  warn if space_after.spaced then "Unexpected space after *." else "Missing space after *."
}

in ts_function.modifier, ts_method.modifier rule generator-star-spacing:before {
  @layout_generator_star_options
  when text == "*" && previous_token != null
  when parent not ts_method || offset != token_neighbours.parent_start
  let star_space layout_comma_space(space_before.text, true)
  when (star_space != "") != layout_star_space(star_override, resolved_mode, before, true)
  warn if star_space != "" then "Unexpected space before *." else "Missing space before *."
}

in ts_function.modifier, ts_method.modifier rule generator-star-spacing:after {
  @layout_generator_star_options
  when text == "*" && next_token != null
  let star_space layout_comma_space(space_after.text, false)
  when (star_space != "") != layout_star_space(star_override, resolved_mode, after, false)
  warn if star_space != "" then "Unexpected space after *." else "Missing space after *."
}

in ts_function, ts_arrow, ts_class, ts_interface, ts_type_alias, ts_method, ts_call, ts_new, ts_tagged_template, ts_type_reference, ts_function_type, ts_method_signature, ts_call_signature rule type-generic-spacing {
  option before boolean = false "space before generic brackets"
  option after boolean = false "space after generic brackets"
  each generic_site in filter(generic_spacing_sites, s => s.spaced != (if s.side == "before" then before else if s.side == "after" then after else false))
  report at generic_site.start
  warn "Generic spaces mismatch"
}

in ts_unary, ts_update, ts_new, ts_await, ts_yield, ts_non_null rule space-unary-ops {
  option words boolean = true "spaces after word operators"
  option nonwords boolean = false "spaces around symbolic unary operators"
  option overrides { [key: string]: boolean } = {} "spacing by operator"
  let unary_gap unary_spacing
  when unary_gap != null
  let wants_space default(get(overrides, unary_gap.override_key), default(get(overrides, unary_gap.operator), if unary_gap.word then words else nonwords))
  when wants_space != unary_gap.separated
  when !(wants_space && unary_gap.first_bang) && !(unary_gap.word && !wants_space && !unary_gap.removable)
  warn if unary_gap.word then
    if wants_space then "Unary word operator '{unary_gap.operator}' must be followed by whitespace." else "Unexpected space after unary word operator '{unary_gap.operator}'."
    else if wants_space then
      if unary_gap.prefix then "Unary operator '{unary_gap.operator}' must be followed by whitespace." else "Space is required before unary operator '{unary_gap.operator}'."
    else if unary_gap.prefix then "Unexpected space after unary operator '{unary_gap.operator}'." else "Unexpected space before unary operator '{unary_gap.operator}'."
}

in ts_ellipsis rule rest-spread-spacing {
  option style "always" | "never" = "never" "spacing after rest and spread"
  when parent is (ts_rest, ts_spread) && next_token != null
  let spread_space layout_comma_space(space_after.text, false)
  when (spread_space != "") != (style == "always")
  let spread_kind (if parent is ts_rest then "rest" else "spread") (if parent.layout_spread_property then " property" else "")
  report at if style == "always" then offset else end_offset
  fix space_after as if style == "always" then " " else ""
  warn if style == "always" then "Expected whitespace after {spread_kind} operator." else "Unexpected whitespace after {spread_kind} operator."
}

in ts_colon rule switch-colon-spacing:before {
  @layout_switch_colon_options
  when parent is ts_case && previous_token != null
  when !space_before.line_break && before != space_before.spaced
  warn if before then "Expected space(s) before this colon." else "Unexpected space(s) before this colon."
}

in ts_colon rule switch-colon-spacing:after {
  @layout_switch_colon_options
  when parent is ts_case && next_token != null && next_token not ts_close_brace
  when !space_after.line_break && after != space_after.spaced
  warn if after then "Expected space(s) after this colon." else "Unexpected space(s) after this colon."
}

in ts_empty, ts_semicolon rule no-extra-semi {
  when layer is ts_empty && parent not (ts_for, ts_for_in, ts_for_of, ts_while, ts_do_while, ts_if, ts_labeled, ts_with)
    || layer is ts_semicolon && parent is ts_class
  warn "Unnecessary semicolon."
}

group layout_semi_owner ts_break, ts_continue, ts_debugger, ts_do_while, ts_export, ts_export_assignment, ts_expression_statement, ts_import, ts_return, ts_throw, ts_variable_declaration, ts_class_property
in layout_semi_owner let layout_semi_last parent is ts_do_while || parent is ts_if && parent.alternate != null && end_offset == parent.consequent.end_offset || parent is (ts_program, ts_block, ts_static_block, ts_case, ts_class) && next == null
in ts_variable_declaration let layout_semi_initializer parent is ts_for && offset == parent.init.offset
in ts_semicolon let layout_semi_header if parent is ts_for then parent.init != null && (parent.test == null && previous_token not ts_semicolon || offset < parent.test.offset) || parent.test != null && offset >= parent.test.end_offset else default(parent.layout_semi_initializer, false)
in ts_semicolon let layout_semi_statement parent is layout_semi_owner && end_offset == parent.end_offset
in ts_semicolon rule semi-style {
  option style "last" | "first" = "last" "semicolon line position"
  when layout_semi_header || layout_semi_statement
  let semi_at_end style == "last" || layout_semi_header
  when if semi_at_end then space_before.line_break else !default(parent.layout_semi_last, false) && space_after.line_break
  warn if semi_at_end then "Expected this semicolon to be at the end of the previous line." else "Expected this semicolon to be at the beginning of the next line."
}

@macro layout_semi_spacing_options {
  option before boolean = false "space before semicolon"
  option after boolean = true "space after semicolon"
  when layout_semi_header || layout_semi_statement || parent is (ts_type_alias, ts_function, ts_method) && end_offset == parent.end_offset || parent is (ts_interface, ts_type_literal)
}
in ts_semicolon rule semi-spacing:before {
  @layout_semi_spacing_options
  let semi_space space_before != null && !space_before.line_break && space_before.spaced
  when semi_space != before
  report at if semi_space then space_before.start else offset
  warn if semi_space then "Unexpected whitespace before semicolon." else "Missing whitespace before semicolon."
}
in ts_semicolon rule semi-spacing:after {
  @layout_semi_spacing_options
  when previous_token != null && next_token != null
  when !space_before.line_break && !space_after.line_break && next_token not (ts_close_paren, ts_close_brace)
  when space_after.spaced != after
  report at if space_after.spaced then end_offset else offset
  warn if space_after.spaced then "Unexpected whitespace after semicolon." else "Missing whitespace after semicolon."
}

in ts_comma rule comma-spacing:before {
  option before boolean = false "space before comma"
  option after boolean = true "space after comma"
  when previous_token != null && previous_token not ts_comma
  when !(parent is (ts_array, ts_array_pattern) && previous_token is ts_open_bracket)
  when !(parent.layout_last_type_parameter_end != null && space_before.start <= parent.layout_last_type_parameter_end && parent.layout_last_type_parameter_end <= offset)
  let comma_space layout_comma_space(space_before.text, true)
  when !re_test(comma_space, /[\n\r\u{2028}\u{2029}]/)
  when before != (comma_space != "")
  fix space_before as if before then " " else ""
  warn if before then "A space is required before ','." else "There should be no space before ','."
}

in ts_comma rule comma-spacing:after {
  option before boolean = false "space before comma"
  option after boolean = true "space after comma"
  when next_token != null
  when space_after.comments || next_token not (ts_comma, ts_close_paren, ts_close_bracket, ts_close_brace)
  when !(parent is (ts_array, ts_array_pattern) && previous_token is (ts_open_bracket, ts_comma) && next_token is (ts_comma, ts_close_bracket))
  when !(parent.layout_last_type_parameter_end != null && space_before.start <= parent.layout_last_type_parameter_end && parent.layout_last_type_parameter_end <= offset)
  when after || !starts_with(trim_start(space_after.text), "//")
  let comma_space layout_comma_space(space_after.text, false)
  when !re_test(comma_space, /[\n\r\u{2028}\u{2029}]/)
  when after != (comma_space != "")
  fix space_after as if after then " " else ""
  warn if after then "A space is required after ','." else "There should be no space after ','."
}

in ts_call, ts_new let layout_invocation_end default(last(type_argument.end_offset), callee.end_offset)
in ts_import_call let layout_invocation_end offset + 6
in ts_call let layout_invocation_optional optional != null
in ts_new, ts_import_call let layout_invocation_optional false
in ts_open_paren rule function-call-spacing {
  option mode "always" | "never" = "never" "spacing before invocation parentheses"
  option allowNewlines boolean = false "allow line breaks before invocation parentheses"
  option optionalChain { before: boolean = true; after: boolean = true } = { before: true, after: true } "spacing around optional invocation punctuation"
  when parent is (ts_call, ts_new, ts_import_call)
  when offset >= parent.layout_invocation_end
  let invocation_optional parent.layout_invocation_optional
  let invocation_prefix if invocation_optional then parent.optional.space_before else space_before
  let invocation_spaced invocation_prefix.spaced || space_before.spaced
  let bad_newline mode == "always" && !allowNewlines && (invocation_prefix.line_break || space_before.line_break)
  let bad_space if mode == "never" then invocation_spaced
    else if invocation_optional then invocation_prefix.spaced != optionalChain.before || space_before.spaced != optionalChain.after
    else !invocation_spaced
  when bad_newline || bad_space
  report at invocation_prefix.start
  warn if bad_newline then "Unexpected newline between function name and paren."
    else if mode == "never" || invocation_optional && (!optionalChain.before && invocation_prefix.spaced || !optionalChain.after && space_before.spaced) then "Unexpected whitespace between function name and paren."
    else "Missing space between function name and paren."
}

# Named tuple members use `name?: Type`.
in ts_tuple_member let layout_tuple_prefix !name.space_after.comments && (optional == null || !optional.space_after.comments)
in ts_colon rule type-named-tuple-spacing:optional {
  when parent is ts_tuple_member && parent.optional != null
  when parent.layout_tuple_prefix
  when space_before.spaced
  report at parent.offset
  fix space_before as ""
  warn "Unexpected space between '?' and the ':'."
}
in ts_tuple_member.name rule type-named-tuple-spacing:before {
  when parent.layout_tuple_prefix
  when space_after.spaced
  report at parent.offset
  fix space_after as ""
  warn "Unexpected space before the ':'."
}
in ts_colon rule type-named-tuple-spacing:after {
  when parent is ts_tuple_member
  when parent.layout_tuple_prefix
  when len(re_find(space_after.text, /^\s*/)) != 1
  report at parent.offset
  fix space_after as " "
  warn "Expected a space after the ':'."
}

@macro layout_brace_options {
  option style "1tbs" | "stroustrup" | "allman" = "1tbs" "brace layout"
  option allowSingleLine boolean = false "allow single-line block bodies"
  when parent is (ts_block, ts_static_block, ts_switch, ts_class)
  when !default(parent.layout_brace_excluded, false)
}
in ts_open_brace rule brace-style:open {
  @layout_brace_options
  when previous_token != null
  when if style == "allman" then !space_before.line_break && !(allowSingleLine && parent.layout_brace_single) else space_before.line_break
  warn if style == "allman" then "Opening curly brace appears on the same line as controlling statement." else "Opening curly brace does not appear on the same line as controlling statement."
}
in ts_open_brace rule brace-style:body {
  @layout_brace_options
  when next_token not ts_close_brace
  when !space_after.line_break && !(allowSingleLine && parent.layout_brace_single)
  warn "Statement inside of curly braces should be on next line."
}
in ts_close_brace rule brace-style:close {
  @layout_brace_options
  when previous_token not ts_open_brace
  when !space_before.line_break && !(allowSingleLine && parent.layout_brace_single)
  warn "Closing curly brace should be on the same line as opening curly brace or on the line after the previous block."
}
in ts_close_brace rule brace-style:keyword {
  @layout_brace_options
  when default(parent.layout_brace_keyword, false)
  when contains(["else", "catch", "finally"], token_neighbours.after.text)
  when space_after.line_break == (style == "1tbs")
  warn if style == "1tbs" then "Closing curly brace does not appear on the same line as the subsequent block." else "Closing curly brace appears on the same line as the subsequent block."
}

group semicolon_statement ts_expression_statement, ts_variable_declaration, ts_return, ts_throw, ts_break, ts_continue, ts_do_while, ts_import, ts_import_equals, ts_type_alias, ts_class_property, ts_debugger, ts_export_assignment, ts_export, ts_method, ts_function
in semicolon_statement rule semi {
  option mode "always" | "never" = "always" "statement semicolon policy"
  option omitLastInOneLineBlock boolean = false "omit final semicolons in single-line blocks"
  option omitLastInOneLineClassBody boolean = false "omit final semicolons in single-line class bodies"
  option beforeStatementContinuationChars "always" | "any" | "never" = "any" "semicolons before continuation characters"
  let statement_semi statement_semicolon
  when statement_semi != null
  let omit_statement_semi omitLastInOneLineBlock && statement_semi.one_line_block || omitLastInOneLineClassBody && statement_semi.one_line_class
  when if mode == "always" then statement_semi.present == omit_statement_semi else if statement_semi.present then statement_semi.redundant || !statement_semi.class_hazard && !statement_semi.same_line && (!statement_semi.hazard_before || !statement_semi.class_field && beforeStatementContinuationChars == "never" && !statement_semi.hazard_after) else !statement_semi.class_field && beforeStatementContinuationChars == "always" && statement_semi.hazard_before
  report at statement_semi.offset
  fix as slice(text, 0, statement_semi.offset - offset) (if statement_semi.present then "" else ";") slice(text, statement_semi.end - offset)
  warn if statement_semi.present then "Extra semicolon." else "Missing semicolon."
}

# Empty constructor argument lists belong to this new expression, not its callee.
in ts_new rule new-parens {
  option style "always" | "never" = "always" "empty constructor parentheses"
  let constructor_open opener.ts_open_paren.offset
  let constructor_close closer.ts_close_paren.offset
  when count(argument) == 0
  when (constructor_open != null && constructor_close != null && callee.end_offset < end_offset) != (style == "always")
  report at offset
  fix as if style == "always" then text "()" else "(" byte_slice(text, 0, constructor_open - offset) byte_slice(text, constructor_open - offset + 1, constructor_close - offset) byte_slice(text, constructor_close - offset + 1) ")"
  warn if style == "always" then "Missing '()' invoking a constructor." else "Unnecessary '()' invoking a constructor with no arguments."
}

}
