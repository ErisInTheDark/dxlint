# .ts/layout: @stylistic spacing, punctuation and line-break rules on the
# native TypeScript layers and token facts.

import .ts/import-attributes
import .ts/helpers

define {

fn layout_comma_space(gap, before_side) = { value result: if before_side then /\s*$/ else /^\s*/; value re_find(gap, result); nonempty } ?? ""
fn layout_same_line(gap) = !re_test(gap, /[\n\r\u{2028}\u{2029}]/)
@macro layout_block_space_options {
  option style "always" | "never" = "always" "spaces inside non-empty blocks"
}
@macro layout_computed_space_options {
  option style "always" | "never" = "never" "spaces inside computed property brackets"
}
group computed_spacing_owners ts_computed_key, ts_index, ts_indexed_access
in ts_computed_key, ts_index, ts_indexed_access let computed_spacing_enabled true
@macro layout_switch_colon_options {
  option before boolean = false "space before case colon"
  option after boolean = true "space after case colon"
}
in ts_block, ts_static_block, ts_switch, ts_enum let layout_block_line_comment { value opener.ts_open_brace.space_after.text; trim_start; starts_with "//" }
in ts_method let layout_class_method parent is ts_class
in ts_computed_key let layout_computed_class parent is ts_class_property || (parent.layout_class_method.nonempty ?? false)
in ts_rest, ts_spread let layout_spread_property parent is (ts_object, ts_object_pattern)
in ts_block let layout_block_function parent is (ts_function, ts_arrow, ts_method)
in ts_block let layout_block_case parent is ts_case
in ts_block let layout_block_module parent is ts_namespace
in ts_block let layout_brace_excluded parent is (ts_program, ts_block, ts_case)
in ts_block let layout_brace_keyword parent is (ts_if, ts_try)
in ts_block, ts_static_block, ts_switch, ts_class let layout_brace_single opener.ts_open_brace.line == closer.ts_close_brace.line
in ts_function let generator_star_named name != null
in ts_method let generator_star_shorthand parent is ts_object
@macro layout_yield_star_options {
  option mode "before" | "after" | "both" | "neither" = "after" "spacing around yield star"
  option before boolean | null = null "override space before star"
  option after boolean | null = null "override space after star"
}
@macro layout_generator_star_options {
  option before boolean = true "space before generator star"
  option after boolean = false "space after generator star"
  when text == "*"
  let star_before_space layout_comma_space(space_before.text, true)
  let star_after_space layout_comma_space(space_after.text, false)
  each star_before in [true, false]
  when if star_before then previous_token != null && (parent not ts_method || offset != token_neighbours.parent_start) else next_token != null
  when ((if star_before then star_before_space else star_after_space) != "") != (if star_before then before else after)
  warn if star_before then (if star_before_space != "" then "Unexpected space before *." else "Missing space before *.") else if star_after_space != "" then "Unexpected space after *." else "Missing space after *."
}
@macro layout_comment_pattern "(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/|//[^\\n\\r\\u{{2028}}\\u{{2029}}]*)"
@macro layout_horizontal_space "[^\\S\\n\\r\\u{{2028}}\\u{{2029}}]"
fn layout_padding_attached_start(gap) = { value gap; re_find ("^(?:" @layout_horizontal_space "*" @layout_comment_pattern ")*"); nonempty } ?? ""
fn layout_padding_attached_end(gap) = { value gap; re_find ("(?:" @layout_comment_pattern @layout_horizontal_space "*)*$"); nonempty } ?? ""
fn layout_padding_last_attached(prefix) = {
  value pattern: "^(?:" @layout_horizontal_space "*(" @layout_comment_pattern "))*$"
  value re_replace(prefix, pattern, "$1")
}
fn layout_padding_last_comment(gap) = { value pattern: "^(?:\\s*(" @layout_comment_pattern "))*\\s*$"; value re_replace(gap, pattern, "$1") }
fn layout_padding_top_space(gap) = {
  value gap
  layout_padding_attached_start
  len: len
  value slice(gap, len)
  layout_comma_space false
}
fn layout_padding_tail_space(gap) = {
  value result: if { value gap; layout_padding_last_comment; starts_with "//" } then /(?:\r\n|[\n\r\u{2028}\u{2029}])\s*$/ else /\s*$/
  value re_find(gap, result)
  nonempty
} ?? ""
fn layout_padding_bottom_space(gap) = {
  value result: len(gap) - { value gap; layout_padding_attached_end; len }
  value slice(gap, 0, result)
  layout_padding_tail_space
}
fn layout_line_breaks(gap) = re_count(gap, /\r\n|[\n\r\u{2028}\u{2029}]/)
fn layout_padding_reduced(gap) = "\n" { value gap; re_find /[^\n\r\u{2028}\u{2029}]*$/ }
fn layout_padding_mode(style, blocks, switches, classes, owner) = if owner.layout_block_module.nonempty ?? false then null else if style != null then style else if blocks == null && switches == null && classes == null then "always" else if owner is ts_class then classes else if owner is ts_switch then switches else blocks
@macro layout_padding_options {
  option style "always" | "never" | "start" | "end" | null = null "padding at block boundaries"
  option blocks "always" | "never" | "start" | "end" | null = null "statement block padding"
  option switches "always" | "never" | "start" | "end" | null = null "switch padding"
  option classes "always" | "never" | "start" | "end" | null = null "class padding"
  option allowSingleLineBlocks boolean = false "allow single-line blocks"
}
in ts_function, ts_method, ts_arrow, ts_function_type, ts_method_signature, ts_call_signature, ts_class, ts_interface, ts_type_alias let layout_last_type_parameter_end last(type_parameter.end_offset)
in ts_block, ts_static_block let layout_padding_content body != null
in ts_switch let layout_padding_content case != null
in ts_class let layout_padding_content member != null
in ts_block, ts_static_block, ts_switch, ts_class {
  let layout_padding_open_prefix layout_padding_attached_start(opener.ts_open_brace.space_after.text)
  let layout_padding_close_suffix layout_padding_attached_end(closer.ts_close_brace.space_before.text)
  let layout_padding_single opener.ts_open_brace.line + layout_line_breaks(layout_padding_open_prefix) == closer.ts_close_brace.line - layout_line_breaks(layout_padding_close_suffix)
}

group comma_style_lists ts_variable_declaration, ts_array, ts_array_pattern, ts_object, ts_object_pattern,
  ts_function, ts_method, ts_arrow, ts_function_type, ts_call, ts_new, ts_import_call, ts_import, ts_export,
  ts_sequence, ts_enum, ts_tuple_type, ts_type_literal, ts_method_signature, ts_call_signature,
  ts_index_signature, ts_class, ts_interface, ts_type_alias, ts_type_reference, ts_tagged_template, ts_import_attributes
in ts_comma {
  let comma_style_owner list_owner
  let comma_style_field list_field
}
in ts_import_attribute_comma {
  let comma_style_owner parent
  let comma_style_field "attribute"
}
in ts_comma, ts_import_attribute_comma let comma_style_checked comma_style_owner is comma_style_lists
in ts_comma, ts_import_attribute_comma rule comma-style {
  option style "last" | "first" = "last" "comma line position"
  when comma_style_checked
  when comma_style_owner not (ts_array, ts_array_pattern) || list_previous != null
  when !(token_neighbours.after.text == "," && token_neighbours.after.line_break)
  when token_neighbours.before.line_break && token_neighbours.after.line_break || (if style == "last" then token_neighbours.before.line_break else token_neighbours.after.line_break)
  warn if token_neighbours.before.line_break && token_neighbours.after.line_break then "Bad line breaking before and after ','." else if style == "last" then "',' should be placed last." else "',' should be placed first."
}

@macro multiple_space_horizontal "[ \\t\\u{{b}}\\u{{c}}\\u{{a0}}\\u{{1680}}\\u{{2000}}-\\u{{200a}}\\u{{202f}}\\u{{205f}}\\u{{3000}}\\u{{feff}}]"
@macro multiple_space_nonspace "[^ \\t\\u{{b}}\\u{{c}}\\r\\n\\u{{a0}}\\u{{1680}}\\u{{2000}}-\\u{{200a}}\\u{{2028}}\\u{{2029}}\\u{{202f}}\\u{{205f}}\\u{{3000}}\\u{{feff}}]"
in ts_code match multiple_space_gap /[ \t\u{b}\u{c}\u{a0}\u{1680}\u{2000}-\u{200a}\u{202f}\u{205f}\u{3000}\u{feff}]+/
fn multiple_space_preview_body(body) = if contains(body, "\n") || len(body) > 12 then {
  value body
  split "\n"
  first
  slice 0 12
} "..." else body
fn multiple_space_comment_preview(comment) = (if comment is ts_block_comment then "/*" else "//") {
  value result: if comment is ts_block_comment then -2 else len(comment.text)
  value slice(comment.text, 2, result)
  multiple_space_preview_body
} (if comment is ts_block_comment then "*/" else "")
in multiple_space_gap {
  let multiple_space_right node_at(end_offset)
  let multiple_space_eol_comment multiple_space_right is ts_comment && {
    value result: "^" @multiple_space_horizontal "*(?:$|[\\r\\n\\u{{2028}}\\u{{2029}}])"
    value re_test(multiple_space_right.text_after, result)
  }
  let multiple_space_display if multiple_space_right is ts_comment then multiple_space_comment_preview(multiple_space_right) else token_neighbours.after.text
  let multiple_spaces_checked true
}
in multiple_space_gap rule no-multi-spaces {
  option includeTabs boolean = true "include tabs in repeated whitespace"
  when multiple_spaces_checked && { value result: if includeTabs then /[ \t]{2}/ else / {2}/; value re_test(text, result) }
    && {
      value js_line_start: position(offset).js_line_start
      value byte_slice(source, js_line_start, offset)
      re_test @multiple_space_nonspace
    }
    && { value pattern: "^" @multiple_space_nonspace; value re_test(text_after, pattern) }
    && { value overlapping(ts_comment); count } == 0
  fix as " "
  warn "Multiple spaces found before '{multiple_space_display}'."
}

in ts_string let layout_quote_fixed_string is (ts_property.key, ts_pattern_property.key, ts_method.key, ts_class_property.key, ts_method_signature.key, ts_property_signature.key, ts_import.from, ts_export.from, ts_import.namespace, ts_export.namespace, ts_import_specifier.imported, ts_namespace.name, ts_enum_member.name, ts_import_type.argument) || parent is ts_export_specifier
in ts_literal_type let layout_quote_import_argument parent is ts_import_type && offset == parent.argument.offset
in ts_call let layout_quote_external_module parent is ts_import_equals && offset == parent.value.offset
in ts_program let layout_quote_prologue true
in ts_block let layout_quote_prologue (parent is ts_function || parent is ts_arrow || parent is ts_method) && offset == parent.body.offset
in ts_expression_statement let layout_quote_directive (parent.layout_quote_prologue.nonempty ?? false) && expression is ts_string && (previous == null || (previous.layout_quote_directive.nonempty ?? false))
in ts_template let layout_quote_template_feature count(expression) > 0 || is ts_tagged_template.quasi || re_test(text, /(^|[^\\])(\\\\)*[\n\r\u{2028}\u{2029}]/)
group quoted_literals ts_string, ts_template
in quoted_literals rule quotes {
  option style "double" | "single" | "backtick" = "double" "string delimiters"
  option avoidEscape boolean = false "allow alternate quotes to avoid escapes"
  option allowTemplateLiterals "never" | "avoidEscape" | "always" = "never" "allow unused template delimiters"
  let quote_template is ts_template
  let quote_fixed (layout_quote_fixed_string.nonempty ?? false) || parent is ts_expression_statement && parent.layout_quote_directive || parent is ts_literal_type && (parent.layout_quote_import_argument.nonempty ?? false) || parent is ts_call && (parent.layout_quote_external_module.nonempty ?? false)
  let quote_delimiter if style == "single" then "'" else if style == "double" then "\"" else "`"
  let quote_alternate if style == "double" then "'" else "\""
  when if quote_template then style != "backtick" && allowTemplateLiterals != "always" && !layout_quote_template_feature && !((allowTemplateLiterals == "avoidEscape") && avoidEscape && contains(text, quote_delimiter)) else parent not ts_jsx_attribute && !(style == "backtick" && quote_fixed) && !starts_with(text, quote_delimiter) && !(avoidEscape && starts_with(text, quote_alternate) && contains(text, quote_delimiter))
  warn "Strings must use {if style == 'single' then 'singlequote' else if style == 'double' then 'doublequote' else 'backtick'}."
}

in ts_property, ts_pattern_property, ts_property_signature, ts_enum_member, ts_object, ts_interface, ts_type_literal, ts_enum, ts_import, ts_export rule quote-props {
  option style "always" | "as-needed" | "consistent" | "consistent-as-needed" = "always" "property quoting policy"
  option keywords boolean = false "require quotes on reserved words"
  option unnecessary boolean = true "report redundant quotes"
  option numbers boolean = false "require quoted numeric keys"
  let property_any_quoted any(property_quote_sites, s => s.quoted)
  let property_necessary any(property_quote_sites, s => s.quoted && !s.redundant || keywords && s.keyword)
  let property_keyword { value property_quote_sites; filter (s) !s.quoted && s.keyword; last }.name
  each property_site in filter(property_quote_sites, s => s.group == (style == "consistent" || style == "consistent-as-needed"))
  when if style == "always" then !property_site.quoted else if style == "as-needed" then (if property_site.quoted then unnecessary && property_site.redundant && !(numbers && property_site.redundant_number) && !(keywords && property_site.keyword) else keywords && property_site.keyword || numbers && property_site.numeric) else if style == "consistent-as-needed" && property_any_quoted && !property_necessary then property_site.quoted else !property_site.quoted && (property_any_quoted || style == "consistent-as-needed" && keywords && property_keyword != null)
  report at property_site.offset
  warn if style == "always" then "Unquoted property '{property_site.name}' found." else if style == "as-needed" then (if property_site.quoted then "Unnecessarily quoted property '{property_site.name}' found." else if property_site.keyword then "Unquoted reserved word '{property_site.name}' used as key." else "Unquoted number literal '{property_site.name}' used as key.") else if style == "consistent-as-needed" && !property_necessary then "Properties shouldn't be quoted as all quotes are redundant." else if style == "consistent-as-needed" && keywords && property_keyword != null then "Properties should be quoted as '{property_keyword}' is a reserved word." else "Inconsistently quoted property '{property_site.name}' found."
}

schema member_separator_options { delimiter?: "semi" | "comma" | "none"; requireLast?: boolean }
schema member_separator_config { multiline?: member_separator_options; singleline?: member_separator_options }
in ts_interface, ts_type_literal let layout_last_member last(member.node)
in ts_interface, ts_type_literal let layout_members_single position(opener.ts_open_brace.offset).js_line == position(end_offset).js_line
in ts_interface, ts_type_literal let layout_last_member_inline position(layout_last_member.member_terminal_token.end).js_line == position(end_offset).js_line
in ts_property_signature, ts_method_signature, ts_call_signature, ts_index_signature rule member-delimiter-style {
  option delimiter "semi" | "comma" | "none" | null = null "default separator for legacy configurations"
  option multiline member_separator_options = {} "multiline member separators"
  option singleline member_separator_options = {} "single-line member separators"
  option overrides { interface?: member_separator_config; typeLiteral?: member_separator_config } = {} "separators by declaration kind"
  option multilineDetection "brackets" | "last-member" = "brackets" "multiline classification"
  when parent is (ts_interface, ts_type_literal)
  let member_single parent.layout_members_single || multilineDetection == "last-member" && parent.layout_last_member_inline
  let member_override if parent is ts_interface then overrides.interface else overrides.typeLiteral
  let member_base if member_single then singleline else multiline
  let member_policy if member_single then member_override.singleline else member_override.multiline
  let member_delimiter member_policy.delimiter.nonempty ?? member_base.delimiter.nonempty ?? delimiter.nonempty ?? "semi"
  let member_require_last member_policy.requireLast.nonempty ?? member_base.requireLast.nonempty ?? !member_single
  let member_last offset == parent.layout_last_member.offset
  let member_token member_terminal_token
  let member_actual if member_token.text == ";" then "semi" else if member_token.text == "," then "comma" else "none"
  when member_actual != (if member_last && !member_require_last then "none" else member_delimiter)
  report at member_token.end
  warn if member_last && !member_require_last || member_delimiter == "none" then (if member_actual == "semi" then "Unexpected separator (;)." else "Unexpected separator (,).") else if member_delimiter == "semi" then "Expected a semicolon." else "Expected a comma."
}

@macro layout_comment_policy {
  option style "always" | "never" = "always" "spacing inside comment delimiters"
  option exceptions string[] = [] "repeated sequences exempt from spacing"
  option markers string[] = [] "comment prefix markers"
  let comment_block is ts_block_comment
  let comment_body { value result: byte_len(text) - (if comment_block then 2 else 0); value byte_slice(text, 2, result) }
  let comment_marker_pattern "(?:" { value markers; map (m) re_escape(m); join "|" } (if count(markers) > 0 then "|\\*)" else "\\*)")
  let comment_exception_pattern if count(exceptions) == 0 then "\\s" else "(?:\\s|(?:" { value exceptions; map (e) "(?:" re_escape(e) ")+"; join "|" } ")(?:$|[\\n\\r\\u{{2028}}\\u{{2029}}]))"
  let comment_marker { value comment_body; re_find ("^" comment_marker_pattern); nonempty } ?? ""
  when comment_body != "" && comment_body != "*" && !contains(markers, comment_body)
  when comment_block || !re_test(comment_body, /^\/\s*<(?:reference|amd-)/)
}
fn layout_comment_open_wrong(body, style, marker_pattern, exception_pattern) = if style == "always" then !re_test(body, "^" marker_pattern "?" exception_pattern) else re_test(body, "^" marker_pattern "?[ \\t]+")
fn layout_comment_open_message(style, exceptions, marker, identifier) = if style == "always" then (if count(exceptions) > 0 then "Expected exception block, space or tab after '{identifier}{marker}' in comment." else "Expected space or tab after '{identifier}{marker}' in comment.") else if marker != "" then "Unexpected space or tab after marker ({marker}) in comment." else "Unexpected space or tab after '{identifier}' in comment."
in ts_line_comment rule spaced-comment:line {
  @layout_comment_policy
  when layout_comment_open_wrong(comment_body, style, comment_marker_pattern, comment_exception_pattern)
  warn layout_comment_open_message(style, exceptions, comment_marker, "//")
}
in ts_block_comment rule spaced-comment:block {
  @layout_comment_policy
  option balanced boolean = false "require matching closing delimiter spacing"
  each comment_end in [false, true]
  when !comment_end || balanced
  when if comment_end then (if style == "always" then !re_test(comment_body, comment_exception_pattern "$") else re_test(comment_body, /[ \t]+$/)) else layout_comment_open_wrong(comment_body, style, comment_marker_pattern, comment_exception_pattern)
  warn if !comment_end then layout_comment_open_message(style, exceptions, comment_marker, "/*") else if style == "always" then "Expected space or tab before '*/' in comment." else "Unexpected space or tab before '*/' in comment."
}

in ts_number rule no-floating-decimal:leading {
  when starts_with(text, ".")
  warn "A leading decimal point can be confused with a dot."
  fix as (if token_neighbours.before.gap == "" && re_test(token_neighbours.before.text, /[\w$]$/) then " 0" else "0") text
}
in ts_number rule no-floating-decimal:trailing {
  when ends_with(text, ".")
  warn "A trailing decimal point can be confused with a dot."
  fix as text "0"
}

# Non-BOF runs include the previous line ending: physical boundaries without lookbehind.
in .js layer layout_blank_lines match layout_blank_run (
  /\A(?:(?:[^\S\r\n]*[\r\n])+(?:[^\S\r\n]+\z)?|[^\S\r\n]+\z)/
  or /(?:\r\n[^\S\r\n]*[\r\n]|\n[^\S\r\n]*[\r\n]|\r\r|\r[^\S\r\n]+[\r\n])(?:[^\S\r\n]*[\r\n])*(?:[^\S\r\n]+\z)?/
  or /(?:\r\n|[\r\n])[^\S\r\n]+\z/
)
in layout_blank_run rule no-multiple-empty-lines {
  option max int(0..) = 2 "maximum consecutive blank lines"
  option maxEOF int(0..) | null = null "maximum final blank lines"
  option maxBOF int(0..) | null = null "maximum initial blank lines"
  let blank_prefix if offset == 0 then 0 else if starts_with(text, "\r\n") then 2 else 1
  let blank_text byte_slice(text, blank_prefix)
  let blank_kind if offset == 0 then "bof" else if end_offset == byte_len(source) then "eof" else "middle"
  let blank_count re_count(blank_text, /\r\n|[\n\r]/) + (if re_test(blank_text, /[\r\n]\z/) then 0 else 1)
  let blank_limit if blank_kind == "bof" then maxBOF.nonempty ?? max else if blank_kind == "eof" then maxEOF.nonempty ?? max else max
  when blank_count > blank_limit
  # Searching the syntax tree costs more than counting, so it comes after.
  when containing(ts_template.quasi) == null && containing(ts_template_type.quasi) == null
  # Blank whitespace cannot contain NUL; split after line endings to retain their byte lengths.
  let blank_parts { value blank_text; re_replace /(\r\n|[\r\n])/ "$1\0"; split "\0" }
  report at { start: offset + blank_prefix + {
    value blank_parts
    slice 0 blank_limit
    join ""
    byte_len
  }, end: end_offset }
  warn if blank_kind == "bof" then "Too many blank lines at the beginning of file. Max of {blank_limit} allowed." else if blank_kind == "eof" then "Too many blank lines at the end of file. Max of {blank_limit} allowed." else "More than {blank_limit} blank {if blank_limit == 1 then 'line' else 'lines'} not allowed."
}

schema annotation_gap_options { before?: boolean; after?: boolean }
in ts_declarator, ts_parameter, ts_class_property, ts_property_signature, ts_index_signature, ts_tuple_member, ts_mapped_type let layout_annotation_start type.offset
in ts_function, ts_arrow, ts_method, ts_method_signature, ts_call_signature, ts_function_type let layout_annotation_start return_type.offset
in ts_declarator let layout_annotation_category "variable"
in ts_parameter let layout_annotation_category "parameter"
in ts_class_property, ts_property_signature, ts_index_signature, ts_method_signature, ts_call_signature let layout_annotation_category "property"
in ts_function, ts_arrow, ts_method let layout_annotation_category "returnType"
in ts_function_type, ts_tuple_member, ts_mapped_type let layout_annotation_category "colon"
in ts_colon let layout_annotation_optional token_neighbours.before.text == "?"
@macro layout_annotation_options {
  option before boolean = false "space before annotation punctuation"
  option after boolean = true "space after annotation punctuation"
  option overrides { colon?: annotation_gap_options; variable?: annotation_gap_options | "ignore"; property?: annotation_gap_options | "ignore"; parameter?: annotation_gap_options | "ignore"; returnType?: annotation_gap_options | "ignore"; questionMark?: annotation_gap_options | "ignore" } = {} "annotation context policies"
  when parent.layout_annotation_start != null && offset < parent.layout_annotation_start
  let annotation_category parent.layout_annotation_category
  let annotation_policy if annotation_category == "variable" then overrides.variable else if annotation_category == "property" then overrides.property else if annotation_category == "parameter" then overrides.parameter else if annotation_category == "returnType" then overrides.returnType else overrides.colon
  when annotation_policy != "ignore"
  let annotation_colon_before overrides.colon.before.nonempty ?? before
  let annotation_colon_after overrides.colon.after.nonempty ?? after
  let annotation_optional layout_annotation_optional && overrides.questionMark != "ignore"
  let annotation_label if !annotation_optional then ":" else if starts_with(parent.optional, "+") then "+?:" else if starts_with(parent.optional, "-") then "-?:" else "?:"
  let annotation_before if annotation_optional then overrides.questionMark.before.nonempty ?? annotation_colon_before else annotation_policy.before.nonempty ?? annotation_colon_before
  let annotation_after annotation_policy.after.nonempty ?? annotation_colon_after
}
in ts_colon rule type-annotation-spacing:before {
  @layout_annotation_options
  let annotation_gap if annotation_optional then parent.optional.space_before else space_before
  when annotation_gap != null && annotation_gap.spaced != annotation_before
  report at if annotation_optional then parent.optional.offset else offset
  warn if annotation_before then "Expected a space before the '{annotation_label}'." else "Unexpected space before the '{annotation_label}'."
}
in ts_colon rule type-annotation-spacing:after {
  @layout_annotation_options
  when space_after.spaced != annotation_after
  warn if annotation_after then "Expected a space after the '{annotation_label}'." else "Unexpected space after the '{annotation_label}'."
}
in ts_colon rule type-annotation-spacing:between {
  when layout_annotation_optional
  @layout_annotation_options
  when annotation_optional
  let annotation_inner overrides.questionMark.after.nonempty ?? false
  when space_before.spaced != annotation_inner
  warn if annotation_inner then "Expected a space between the '?' and the ':'." else "Unexpected space between the '?' and the ':'."
}

in ts_block, ts_static_block, ts_switch, ts_class rule padded-blocks:top {
  @layout_padding_options
  when opener.ts_open_brace.offset != null
  when layout_padding_content
  let padding_mode layout_padding_mode(style, blocks, switches, classes, node)
  when padding_mode != null
  when !(allowSingleLineBlocks && layout_padding_single)
  let padding_space layout_padding_top_space(opener.ts_open_brace.space_after.text)
  let padding_padded layout_line_breaks(padding_space) >= 2
  when padding_padded != (padding_mode == "always" || padding_mode == "start")
  report at if layout_padding_open_prefix == "" then opener.ts_open_brace.offset else opener.ts_open_brace.end_offset + byte_len(layout_padding_open_prefix) - { value layout_padding_open_prefix; layout_padding_last_attached; byte_len }
  warn if padding_padded then "Block must not be padded by blank lines." else "Block must be padded by blank lines."
  let padding_start opener.ts_open_brace.end_offset + byte_len(layout_padding_open_prefix)
  fix at { start: padding_start, end: padding_start + (if padding_padded then byte_len(padding_space) else 0) } as if padding_padded then layout_padding_reduced(padding_space) else "\n"
}

in ts_block, ts_static_block, ts_switch, ts_class rule padded-blocks:bottom {
  @layout_padding_options
  when closer.ts_close_brace.offset != null
  when layout_padding_content
  let padding_mode layout_padding_mode(style, blocks, switches, classes, node)
  when padding_mode != null
  when !(allowSingleLineBlocks && layout_padding_single)
  let padding_space layout_padding_bottom_space(closer.ts_close_brace.space_before.text)
  let padding_padded layout_line_breaks(padding_space) >= 2
  when padding_padded != (padding_mode == "always" || padding_mode == "end")
  report at closer.ts_close_brace.offset - byte_len(layout_padding_close_suffix) - byte_len(padding_space)
  warn if padding_padded then "Block must not be padded by blank lines." else "Block must be padded by blank lines."
  let padding_end closer.ts_close_brace.offset - byte_len(layout_padding_close_suffix)
  fix at { start: padding_end - (if padding_padded then byte_len(padding_space) else 0), end: padding_end } as if padding_padded then layout_padding_reduced(padding_space) else "\n"
}

in ts_code match layout_class_line_gap /[\r\n](?:[^\S\r\n]*[\r\n])+/
in layout_class_line_gap let layout_class_blank re_count(text, /\r\n|[\r\n]/) > 1
in ts_semicolon let layout_member_before token_neighbours.before
in ts_semicolon let layout_member_preceding_end {
  value default: { value overlapping(ts_comment, layout_member_before.end, offset).end_offset; last; nonempty } ?? 0
  value max(layout_member_before.end, default)
}

in ts_class.member rule lines-between-class-members {
  option style "always" | "never" = "always" "blank lines between class members"
  option enforce { blankLine: "always" | "never"; prev: "method" | "field" | "*"; next: "method" | "field" | "*" }[] = [] "policy by neighbouring member kinds"
  option exceptAfterSingleLine boolean = false "skip after single-line members"
  option exceptAfterOverload boolean = true "skip overload signatures"
  let skip_overloads exceptAfterOverload && (count(enforce) == 0 && style == "always" || any(enforce, e => e.blankLine == "always" && e.prev != "field" && e.next != "field"))
  let member_skipped skip_overloads && is ts_method && ts_method.body == null
  let member_tail last_token
  let retained_member if member_skipped then previous.retained_member else {
    start: offset,
    kind: if is ts_method then "method" else if is ts_class_property then "field" else "*",
    tail: member_tail,
    before_tail: if member_tail is ts_semicolon then { value overlapping(ts_semicolon, offset, end_offset).layout_member_preceding_end; last } else null
  }
  let prior_member previous.retained_member
  when !member_skipped && prior_member != null
  let gap_moved_semicolon prior_member.tail.text == ";" && position(prior_member.before_tail).line != position(prior_member.tail.start).line && position(prior_member.tail.end).line == position(first_token.start).line
  let gap_start if gap_moved_semicolon then prior_member.before_tail else prior_member.tail.end
  let gap_end if gap_moved_semicolon then prior_member.tail.start else first_token.start
  let gap_padded { value overlapping(layout_class_line_gap, gap_start, gap_end).layout_class_blank; contains true }
  let gap_mode if count(enforce) == 0 then style else find_last(enforce, e => (e.prev == "*" || e.prev == prior_member.kind) && (e.next == "*" || e.next == retained_member.kind)).blankLine
  let gap_single_line position(prior_member.start).line == position(gap_start).line
  when gap_mode == "never" && gap_padded || gap_mode == "always" && !gap_padded && !(exceptAfterSingleLine && gap_single_line)
  report at { start: gap_start, end: gap_end }
  warn if gap_padded then "Unexpected blank line between class members." else "Expected blank line between class members."
}

group infix_spacing_owners ts_binary, ts_logical, ts_assignment, ts_union, ts_intersection,
  ts_conditional, ts_conditional_type, ts_assignment_pattern, ts_declarator, ts_parameter,
  ts_class_property, ts_enum_member, ts_type_alias, ts_type_parameter
in infix_spacing_owners let infix_spacing_enabled true
in ts_binary.operator, ts_logical.operator, ts_assignment.operator, ts_equals, ts_question, ts_colon, ts_punctuator rule space-infix-ops {
  option int32Hint boolean = false "allow terminal |0 conversion"
  let infix_types parent is (ts_union, ts_intersection)
  when parent is infix_spacing_owners && parent.infix_spacing_enabled
  when parent is (ts_binary, ts_logical, ts_assignment)
    || infix_types && contains(["|", "&"], text)
    || parent is (ts_conditional, ts_conditional_type) && contains(["?", ":"], text)
    || parent is (ts_assignment_pattern, ts_declarator, ts_parameter, ts_class_property, ts_enum_member, ts_type_alias, ts_type_parameter) && text == "="
  when !(int32Hint && parent is (ts_binary, ts_logical, ts_assignment, ts_assignment_pattern) && ends_with(parent_text, "|0"))
  when !(space_before.spaced && space_after.spaced)
  warn "Operator '{text}' must be spaced."
  fix as (if !space_before.spaced then " " else "") text (if !space_after.spaced then " " else "")
}

in ts_open_brace rule space-before-blocks {
  option style "always" | "never" = "always" "spaces before blocks"
  option functions "always" | "never" | "off" | null = null "function body policy"
  option keywords "always" | "never" | "off" | null = null "statement body policy"
  option classes "always" | "never" | "off" | null = null "class body policy"
  option modules "always" | "never" | "off" | null = null "module body policy"
  when parent is (ts_block, ts_switch, ts_class, ts_interface, ts_enum) && previous_token != null
  let block_class parent is (ts_class, ts_interface, ts_enum)
  let block_function parent.layout_block_function.nonempty ?? false
  let block_previous token_neighbours.before.text
  when block_previous != "=>"
  when !(contains(["try", "do", "else", "finally", "catch", "static"], block_previous) && !block_class && !block_function)
  when !(block_previous == ":" && (parent.layout_block_case.nonempty ?? false))
  when !space_before.line_break
  let block_mode if block_class then classes.nonempty ?? style else if block_function then functions.nonempty ?? style else if parent.layout_block_module.nonempty ?? false then modules.nonempty ?? style else keywords.nonempty ?? style
  when block_mode != "off" && space_before.spaced != (block_mode == "always")
