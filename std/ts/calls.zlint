# .ts/calls: signatures and invocation syntax.
import .ts/effects

define {
  in ts_member, ts_index let in_optional_chain optional != null || object.in_optional_chain == true
  in ts_call let in_optional_chain optional != null || callee.in_optional_chain == true
  in ts_non_null let in_optional_chain expression.in_optional_chain == true
  in ts_parenthesized let wraps_optional_chain expression.in_optional_chain == true || expression.wraps_optional_chain == true

  fn ts_calls_return_candidate(n) = {
    value bare: unparenthesised_node(n)
    value when {
      bare is (ts_number, ts_string, ts_boolean, ts_bigint) then true
      bare is ts_identifier then {
        value declaration: bare.scope_declaration.parent.node
        value declaration is ts_declarator && declaration.type == null
          && declaration.parent.kind == "const"
      }
      else then bare is (ts_unary, ts_conditional, ts_logical, ts_sequence, ts_satisfies)
    }
  }

  fn ts_calls_return_arguments(owner) = if owner.body is ts_block then {
    value flow_declared_effects(owner.body.node, "returned")
    filter (effect) effect.site is ts_return
    map (effect) effect.site.argument.node
  } else [owner.body.node]

  fn ts_calls_widens_return(owner) = {
    value if (contains([] owner.modifier, "async") || contains([] owner.modifier, "*"))
      && value_has_expected(owner) != false then false else {
      value arguments: ts_calls_return_arguments(owner)
      value if count(arguments) == 0 || !all(arguments, argument => argument != null
        && ts_calls_return_candidate(argument))
        || owner.body is ts_block && flow_normal(owner.body.node) != false then false else {
        value rows: map(arguments, argument => value_constituents(argument))
        value parts: { value rows; flat_map (row) row; unique }
        value part: if all(rows, row => row != null) && count(parts) == 1
          && count(first(parts)) == 1 then first(first(parts)) else null
        value part != null && contains(part.traits, "literal")
          && all(arguments, argument => ts_value_fresh_literal(argument, part)
            && !ts_value_contextual_literal(argument, part))
      }
    }
  }

  in ts_function, ts_arrow, ts_method, ts_function_type, ts_method_signature, ts_call_signature {
    overloads infer last
    let calls_overload_implementation node is ts_function && node.body != null
      && any(name_binding(node.name.node).declarations, declaration =>
        declaration.parent.node is ts_function && declaration.parent.node.body == null)
    let calls_receivers filter(parameter.nodes, p => p.name is ts_this || p.name is ts_identifier && p.name == "this")
    let calls_parameters filter(parameter.nodes, p => !(p.name is ts_this || p.name is ts_identifier && p.name == "this"))
    let calls_concise_result if node is ts_arrow && node.body not ts_block then node.body.node else null
    let calls_inferred_widen if node is (ts_function, ts_arrow, ts_method) && node.body != null && return_type == null
      then ts_calls_widens_return(node) else false
    let calls_generator_yields {
      value descendants(ts_yield)
      filter (yielded) ts_effects_function_owner(yielded) == node
    }
    let calls_generator_delegates any(calls_generator_yields, yielded => yielded.operator == "*")
    let calls_discards_result if return_type is ts_type_keyword then return_type.text == "void" else {
      value parts: value_constituents(return_type.node)
      value parts != null && count(parts) > 0
        && all(parts, arm => any(arm, part => contains(part.traits, "void")))
    }
    generics type_parameter
    when !calls_overload_implementation && !contains([] node.modifier, "async") && !contains([] node.modifier, "*")
      && !(node is ts_method && node.calls_constructor && count(node.parent.type_parameter) == 0) {
      when calls_concise_result != null && calls_inferred_widen {
        signature calls_parameters receiver calls_receivers returns calls_concise_result.widened
      }
      when calls_concise_result == null || !calls_inferred_widen {
        signature calls_parameters receiver calls_receivers returns return_type ?? calls_concise_result ?? (returned default trait void, undefined, nullable, falsy, nonthenable)
      }
    }
    when !calls_overload_implementation && contains([] node.modifier, "async") && !contains([] node.modifier, "*") {
      when calls_concise_result != null && calls_inferred_widen {
        signature calls_parameters receiver calls_receivers returns instance "Promise" of calls_concise_result.widened
      }
      when calls_concise_result == null || !calls_inferred_widen {
        signature calls_parameters receiver calls_receivers returns return_type ?? instance "Promise" of (calls_concise_result ?? (returned default trait void, undefined, nullable, falsy, nonthenable))
      }
    }
    when !calls_overload_implementation && contains([] node.modifier, "*") {
      when return_type != null {
        signature calls_parameters receiver calls_receivers returns return_type
      }
      when return_type == null {
        when !contains([] node.modifier, "async") && !calls_generator_delegates {
          signature calls_parameters receiver calls_receivers returns instance "Generator" of (...calls_generator_yields using (argument ?? trait undefined, nullable, falsy, nonthenable)), (returned default trait void, undefined, nullable, falsy, nonthenable), (trait unknown)
        }
        when !contains([] node.modifier, "async") && calls_generator_delegates {
          signature calls_parameters receiver calls_receivers returns instance "Generator" of (trait unknown), (returned default trait void, undefined, nullable, falsy, nonthenable), (trait unknown)
        }
        when contains([] node.modifier, "async") && !calls_generator_delegates {
          signature calls_parameters receiver calls_receivers returns instance "AsyncGenerator" of (...calls_generator_yields using (instance "Awaited" of (argument ?? trait undefined, nullable, falsy, nonthenable))), (instance "Awaited" of (returned default trait void, undefined, nullable, falsy, nonthenable)), (trait unknown)
        }
        when contains([] node.modifier, "async") && calls_generator_delegates {
          signature calls_parameters receiver calls_receivers returns instance "AsyncGenerator" of (trait unknown), (instance "Awaited" of (returned default trait void, undefined, nullable, falsy, nonthenable)), (trait unknown)
        }
      }
    }
    discards result when calls_discards_result
  }

  in ts_function, ts_arrow { fits callable }
  in ts_function_type, ts_call_signature {
    fits callable when kind != "new"
    fits constructible when kind == "new"
  }

  in ts_method {
    let calls_constructor parent is ts_class && kind == null && !contains([] modifier, "static") && (
      key is ts_identifier && key == "constructor" || key is ts_string && js_string(key.text) == "constructor"
    )
    fits callable when kind != "get" && kind != "set" && !calls_constructor
    fits constructible when calls_constructor
    when calls_constructor && count(parent.type_parameter) == 0 {
      signature calls_parameters receiver calls_receivers returns scope members from parent
    }
    variance parameters bivariant
  }
  in ts_method_signature {
    fits callable when kind != "get" && kind != "set"
    variance parameters bivariant
  }

  in ts_interface, ts_type_literal {
    let calls_headers filter(member.nodes, h => h is ts_call_signature)
    signatures calls_headers
    fits callable when any(calls_headers, h => h.kind != "new")
    fits constructible when any(calls_headers, h => h.kind == "new")
  }
  in ts_class {
    let calls_constructor_headers filter(member.nodes, h => h is ts_method && h.calls_constructor)
    when count(calls_constructor_headers) > 0 { signatures calls_constructor_headers }
    when count(calls_constructor_headers) == 0 && extends == null {
      signature calls_constructor_headers returns scope members from it
    }
  }

  in ts_parameter {
    optional when optional != null || init != null
    fits rest when name is ts_rest
  }
  in ts_type_parameter { optional when default != null }
  in ts_rest, ts_spread { fits rest }

  in ts_call {
    when in_optional_chain == true { calls (callee \ nullable, undefined) with argument }
    # A bare call's `this` is void: a signature declaring `this: object` does not apply.
    when in_optional_chain != true && callee is ts_identifier {
      calls callee with argument this (trait void, undefined, nullable, falsy, nonthenable)
    }
    when in_optional_chain != true && !(callee is ts_identifier) { calls callee with argument }
  }
  in ts_new { constructs callee with argument }
  # Overload resolution tries the subtype relation (where `any` fits only
  # `any`/`unknown`) before assignability.
  in ts_call, ts_new { overloads exact first }
  in ts_tagged_template {
    let calls_arguments [] quasi.node quasi.expression.nodes
    calls tag with calls_arguments
  }

  in ts_declarator {
    when type != null { in init expects type }
  }
  in ts_class_property { in init expects type ?? it.expected }
  in ts_assignment { in right expects left }
  in ts_parenthesized { in expression expects it.expected }
  in ts_as, ts_type_assertion { in expression expects type }
  in ts_array { in element expects each (parent.expected \ nullable).[position] }
  in ts_method, ts_class_property, ts_property {
    let calls_member_key if key is ts_computed_key then key.expression.node else ts_value_key(key.node)
    when parent is ts_object {
      in it expects parent.expected.[calls_member_key]
    }
    when parent is ts_class && parent.extends != null {
      when !contains([] modifier, "static") {
        in it expects parent.extends.["prototype"].[calls_member_key]
      }
      when contains([] modifier, "static") {
        in it expects parent.extends.[calls_member_key]
      }
    }
    when parent is ts_class && parent.implements != null && !contains([] modifier, "static") {
      in it expects (...parent.implements).[calls_member_key]
    }
  }
  in ts_property { in value expects it.expected }
  in ts_arrow {
    when body not ts_block { in body expects return_type ?? it.expected.result }
  }
  in ts_return {
    let calls_return_function ts_effects_function_owner(node)
    when calls_return_function is ts_method && calls_return_function.kind == "get" {
      in argument expects calls_return_function.return_type
    }
    when !(calls_return_function is ts_method && calls_return_function.kind == "get") {
      in argument expects calls_return_function.return_type ?? calls_return_function.expected.result
    }
  }
  # Wrappers pass their own context to the operand that produces their value.
  fn ts_calls_context_scalar(n) = {
    value operand: unparenthesised_node(n)
    value annotation: if operand is ts_identifier then name_binding(operand).node.parent.type.node else null
    value operand is (ts_number, ts_string, ts_boolean, ts_bigint, ts_null)
      || annotation is ts_type_keyword && ts_value_nonthenable(annotation) == true
  }
  in ts_non_null { in expression expects it.expected }
  in ts_satisfies { in expression expects type }
  in ts_conditional {
    in consequent expects it.expected
    in alternate expects it.expected
  }
  in ts_logical {
    in left expects it.expected
    in right expects it.expected
  }
  in ts_sequence {
    let calls_sequence_result last(expression.nodes)
    in calls_sequence_result expects it.expected
  }
  in ts_await {
    when ts_calls_context_scalar(argument.node) { in argument expects it.expected }
    when !ts_calls_context_scalar(argument.node) {
      in argument expects it.expected | instance "PromiseLike" of it.expected
    }
  }
}
