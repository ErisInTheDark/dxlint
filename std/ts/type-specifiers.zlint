# Shared type/value origin matching.

define {
fn matches_type_specifier(spec, gate) = spec == gate.name || (spec.name == gate.name || contains(default(spec.name, []), gate.name)) && spec.from == gate.from && (spec.path == null || ends_with(gate.path, spec.path)) && (spec.package == null || spec.package == gate.package)
fn type_is_allowed(specs, groups) = any(specs, spec => all(groups, group => any(group, gate => matches_type_specifier(spec, gate))))
}
