define {

schema type_specifier_file { from: "file"; name: string | string[]; path?: string }
schema type_specifier_lib { from: "lib"; name: string | string[] }
schema type_specifier_package { from: "package"; name: string | string[]; package: string }

fn type_specifier_path(path) = {
  value slashes: replace(path, "\\", "/")
  value rooted: starts_with(slashes, "/")
  value parts: fold(split(slashes, "/"), [], (parts, part) =>
    if part == "" || part == "." then parts
    else if part == ".." then
      if count(parts) > 0 && !ends_with(last(parts), ":") then slice(parts, 0, count(parts) - 1)
      else parts
    else concat(parts, [part]))
  value (if rooted then "/" else "") join(parts, "/")
}
fn type_specifier_matches(entry, gate, directory) =
  gate.name != null && (if type_of(entry) == "str" then gate.name == entry else {
    value matches_origin: when {
      entry.from == "lib" then gate.from == "lib"
      entry.from == "package" then gate.from == "package"
        && (gate.package == entry.package
          || gate.package == "@types/" replace(replace(entry.package, "@", ""), "/", "__"))
      entry.from == "file" then gate.path != null && directory != null && {
        value base: type_specifier_path(directory)
        value path: type_specifier_path(gate.path)
        value if entry.path == null then starts_with(path,
          base (if ends_with(base, "/") then "" else "/"))
          else path == type_specifier_path(base "/" entry.path)
      }
      else then false
    }
    value contains(if type_of(entry.name) == "str" then [entry.name] else entry.name, gate.name) && matches_origin
  })
fn type_is_allowed(entries, groups, node) = {
  value directory: if any(entries, entry => entry.from == "file") then program_directory(node) else null
  value count(groups) > 0 && any(entries, entry =>
    all(groups, group => any(group, gate => type_specifier_matches(entry, gate, directory))))
}
fn type_specifier_site(entry, n, site, name, directory) = {
  value origin: declaration_origin(n, site)
  value if origin == null || name == null || entry.from == "file" && directory == null then null else type_specifier_matches(entry, {
    name: name,
    from: if origin.kind == "library" then "lib" else if origin.kind == "package" then "package" else "file",
    path: origin.path,
    package: origin.package
  }, directory)
}
fn type_specifier_part(entry, n, part, directory) = {
  value scalar: find(["any", "unknown", "never", "void", "undefined", "null", "string", "number",
    "boolean", "bigint", "symbol", "object"], name => contains(part.traits, name))
  value if !part.carrier_known then null
    else if part.carrier != null && contains(["named", "enum"], part.carrier.description.kind)
      then type_specifier_site(entry, n, part.carrier, part.carrier.description.name, directory)
    else if scalar != null then type_specifier_matches(entry, {name: scalar, from: "lib"}, directory)
    else if contains(part.traits, "parameter") then null
    else false
}
fn type_value_allowed(entries, n) = if count(entries) == 0 then false else {
  value arms: value_parts(n)
  value roots: value_sources(n)
  value sites: walk(roots.sites ?? [], site => site_sources(n, site).sites ?? [])
  value complete: roots != null && all(sites, site =>
    contains(["ts_class", "ts_interface", "ts_enum", "ts_function", "ts_method", "ts_method_signature"], site.kind)
    || site_sources(n, site) != null)
  value named: if count(arms) == 1 then filter(sites, site => site.name != null
    && contains(["ts_type_alias", "ts_function", "ts_method", "ts_method_signature"], site.kind)) else []
  value directory: if any(entries, entry => entry.from == "file") then program_directory(n) else null
  value states: map(entries, entry => {
    value named_states: map(named, site => type_specifier_site(entry, n, site, site.name, directory))
    value alternatives: map(arms ?? [], arm => {
      value parts: map(arm.parts, part => type_specifier_part(entry, n, part, directory))
      value if any(parts, state => state == true) || any(named_states, state => state == true) then true
        else if !complete || any(parts, state => state == null) || any(named_states, state => state == null) then null
        else false
    })
    value if arms == null then null
      else if count(arms) == 0 then type_specifier_matches(entry, {name: "never", from: "lib"}, directory)
      else if all(alternatives, state => state == true) then true
      else if any(alternatives, state => state == false) then false
      else null
  })
  value if any(states, state => state == true) then true
    else if any(states, state => state == null) then null
    else false
}
}
