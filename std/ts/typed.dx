# Type-aware rules over TypeScript syntax and value queries.

import .ts/arithmetic
import .ts/deprecation
import .ts/import-no-deprecated
import .ts/methods
import .ts/spreads
import .ts/type-specifiers
import .ts/typed/promises
import .ts/typed/errors
import .ts/typed/awaitability
import .ts/typed/optional-chains
import .ts/typed/floating-promises
import .ts/typed/unbound-method
import .ts/typed/template-expressions
import .ts/typed/readonly-members
import .ts/typed/readonly-parameters
import .ts/typed/string-boundaries
import .ts/typed/includes
import .ts/typed/type-constituents
import .ts/typed/redundant-constituents
import .ts/typed/return-await
import .ts/typed/return-this
import .ts/typed/type-arguments
import .ts/typed/nullish-coalescing
import .ts/typed/boolean-comparisons
import .ts/typed/void-expressions
import .ts/typed/strict-void-return
import .ts/typed/assignments
import .ts/typed/transfers
import .ts/typed/defaults
import .ts/typed/template-values
import .ts/typed/enum-consistency
import .ts/typed/type-parameters
import .ts/typed/switches
import .ts/typed/enums
import .ts/typed/qualifiers
import .ts/typed/regexp-exec
import .ts/typed/for-in-arrays
import .ts/typed/type-conversions
import .ts/typed/rejection-handlers
import .ts/typed/unsafe-members
import .ts/typed/unsafe-calls
import .ts/values/inspection
import .ts/constants

define {

fn generated_empty_type(n) = {
  value arms: value_parts(n)
  value arms != null && any(arms, arm =>
    count(arm.parts) > 0 && all(arm.parts, part =>
      contains(part.traits, "structural") && count(part.uncertain_traits) == 0
      && part.carrier_known && part.carrier == null)
    && value_children(arm.handle, true, []) == []
    && value_signatures(arm.handle) == [[]] && value_constructors(arm.handle) == [[]])
}
in ts_type_reference, ts_intersection rule es-no-generated-empty-object-type {
  when node is ts_intersection || count(type_argument.nodes) > 0
    && last(walk(node, item => if item.parent is ts_parenthesized_type then item.parent.node else null)).parent not ts_intersection
  when generated_empty_type(node)
  warn "This type resolves to `{{}}`, the empty object type. This was likely not intentional."
}

in ts_function, ts_arrow, ts_method rule es-require-await {
  when missing_await != null
  report at ts_await_warning_site(node)
  warn missing_await.name " has no 'await' expression."
}

group promise_function_async_function ts_function, ts_arrow, ts_method
in promise_function_async_function let promise_function_async_kind
  if is ts_arrow then "arrow"
  else if is ts_method then if parent is ts_class then "method" else "expression"
  else if parent is (ts_program, ts_block, ts_export, ts_case, ts_if, ts_labeled) then "declaration"
  else "expression"
in promise_function_async_function let promise_function_async_checked true
in ts_method let promise_function_async_exempt
  contains(["get", "set"], kind)
  || parent is ts_class && !contains([] modifier, "static") && key not ts_computed_key && static_name == "constructor"
fn promise_function_async_edit(n) = {
  value anchor: if n is ts_method then find(n.modifier.nodes, modifier => modifier.text == "*") ?? n.key.node else n
  value before: anchor.token_neighbours.before
  value separator: if before.end == anchor.offset then expression_fix_separator(before.text, "async") else ""
  value { start: anchor.offset, text: separator "async " }
}
in promise_function_async_function rule es-promise-function-async {
  option allowAny boolean = true "Allow any and unknown return types"
  option allowedPromiseNames string[] = [] "Additional promise type names"
  when body != null && !contains([] modifier, "async")
  when !(promise_function_async_exempt.nonempty ?? false)
  when promise_function_async_checked
  let names ("Promise" allowedPromiseNames)
  let policy promise_async_policy(node, names)
  when policy.known
  let disallowed_unknown !allowAny && policy.dynamic
  when disallowed_unknown || policy.required
  report at function_head_site(node)
  warn if !disallowed_unknown && policy.mixed then "Functions that return promises must be async. Consider adding an explicit return type annotation if the function is intended to return a union of promise and non-promise types." else "Functions that return promises must be async."
  let edit promise_function_async_edit(node)
  fix at { start: edit.start, end: edit.start } if !disallowed_unknown as edit.text
}

in ts_node let only_throw_error_checked true
in ts_throw.argument rule es-only-throw-error {
  option allow (string | type_specifier_file | type_specifier_lib | type_specifier_package)[] = [] "Additional allowed thrown types"
  option allowRethrowing boolean = true "Allow rethrowing catch and Promise rejection parameters"
  option allowThrowingAny boolean = true "Allow any values"
  option allowThrowingUnknown boolean = true "Allow unknown values"
  when ts_error_value.kind != null && ts_error_value.kind != "error"
  when !allowRethrowing || !ts_error_value.rethrown
  when !allowThrowingAny || ts_error_value.kind != "any"
  when !allowThrowingUnknown || ts_error_value.kind != "unknown"
  when only_throw_error_checked
  when type_value_allowed(allow, node) != true
  report at unparenthesised_node(node)
  warn if ts_error_value.kind == "undefined" then "Do not throw undefined." else "Expected an error object to be thrown."
}

in ts_identifier let rejection_global_promise text == "Promise" && resolved == "global" && global != "off"
in ts_identifier, ts_member, ts_index let rejection_constructor
  if re_test(file, /\.[cm]?tsx?$/) then ts_value_builtin_constructor(node, ["Promise"]) == true else rejection_global_promise.nonempty ?? false
in ts_identifier, ts_member, ts_index let rejection_receiver
  rejection_constructor || re_test(file, /\.[cm]?tsx?$/) && ts_value_builtin_type(node, ["Promise"]) == true
in ts_member, ts_index let rejection_member static_name == "reject" && object.rejection_receiver == true
in ts_parenthesized forward rejection_global_promise, rejection_constructor, rejection_receiver, rejection_member from expression
in ts_new let rejection_promise_constructor callee.rejection_constructor == true
in ts_function, ts_arrow, ts_parenthesized let rejection_executor
  if parent is ts_parenthesized then parent.rejection_executor
  else is ts_new.argument && index == 0 && parent.rejection_promise_constructor
in ts_parameter let rejection_parameter index == 1 && init == null && parent.rejection_executor == true
in ts_identifier let rejection_binding is ts_parameter.name && parent.rejection_parameter == true
in ts_call let rejection_call
  callee.rejection_member == true || any(callee.declarations, d => d.rejection_binding == true)
fn rejection_reason_subject(n) = if n is ts_await then ts_awaited_value(n, n.argument.node) ?? n else n
in ts_node let rejection_reason
  {possible: could_be_error && error_undefined_global != true, kind: error_kind_at(node, rejection_reason_subject(node)),
    subject: rejection_reason_subject(node)}
fn rejection_reason_known(n) = value_parts(n) != null || unparenthesised_node(n) is ts_array
  || unparenthesised_node(n) is ts_assignment && contains(["-=", "*=", "/=", "%=", "**=", "<<=", ">>=", ">>>=", "|=", "&=", "^="],
    unparenthesised_node(n).operator)
in ts_call let prefer_promise_reject_errors_checked true
in ts_call rule es-prefer-promise-reject-errors {
  option allowEmptyReject boolean = false "Allow rejection without a reason"
  option allow (string | type_specifier_file | type_specifier_lib | type_specifier_package)[] = [] "Additional allowed rejection types"
  option allowThrowingAny boolean = false "Allow any values"
  option allowThrowingUnknown boolean = false "Allow unknown values"
  when rejection_call
  let reason first([] argument.rejection_reason)
  when reason != null || !allowEmptyReject
  when reason == null || (if re_test(file, /\.[cm]?tsx?$/) then rejection_reason_known(reason.subject) && reason.kind != "error" && !(allowThrowingAny && reason.kind == "any") && !(allowThrowingUnknown && reason.kind == "unknown") && type_value_allowed(allow, reason.subject) == false else !reason.possible)
  when prefer_promise_reject_errors_checked
  warn "Expected the Promise rejection reason to be an Error."
}

fn stringification_union(states) = if count(states) == 0 then 0 else if any(states, state => state == null) then null
  else if all(states, state => state == 2) then 2 else if all(states, state => state == 0) then 0 else 1
# Elements are all stringified, so one certain element is enough; a union's arms are exclusive.
fn stringification_elements(states) = if any(states, state => state == 2) then 2
  else if any(states, state => state == null) then null
  else if any(states, state => state == 1) then 1 else 0
fn stringification_member(n, handle, key) = {
  value roots: global_declarations(n, "Object", "type")
  value defaults: map(roots ?? [], root => value_lookup(declaration_value(n, root), key))
  value lookup: value_lookup(handle, key)
  value known: roots != null && count(roots) > 0
    && all(defaults, item => item.alternatives != null)
    && lookup.alternatives != null
  value canonical: flat_map(defaults, item => flat_map(item.alternatives, arm => map(arm.sources, source => source.site)))
  value sources: filter(flat_map(lookup.alternatives ?? [], arm => arm.sources), source => source.kind != "indexer")
  value if !known || any(sources, source => source.site == null) then null
    else if any(sources, source => !contains(canonical, source.site)) then 0
    else 2
}
fn stringification_ignored_base(n, carrier, ignored) = if carrier == null then false else {
  value sites: walk([carrier], site => {
    value constructed: if site.kind != "ts_declarator" then [] else flat_map(value_constituents(value_lookup(declaration_value(n, site), "prototype").member) ?? [], arm => map(arm, part => part.carrier))
    value (site_field(n, site, "extends") ?? []) (site_sources(n, site).sites ?? []) filter(constructed, item => item != null)
  })
  value any(sites, site => contains(["ts_class", "ts_interface"], site.kind) && contains(ignored, site.name)
    || site.description.kind == "named" && contains(ignored, site.description.name))
}
fn stringification_ignored_alias(n, ignored) = {
  value arms: value_parts(n)
  value roots: value_sources(n)
  value sites: walk(if count(roots.sites) == 1 then roots.sites else [], site =>
    if count(site_sources(n, site).sites) == 1 then site_sources(n, site).sites else [])
  value arms != null && all(arms, arm => all(arm.parts, part => part.carrier_known && part.carrier == null))
    && any(sites, site => site.kind == "ts_type_alias" && contains(ignored, site.name))
}
fn stringification_part(n, part, ignored, check_unknown, seen) = {
  value primitive: any(["boolean", "string", "number", "bigint", "symbol", "null", "undefined", "any", "callable"],
    trait => contains(part.traits, trait))
  value carrier: part.carrier
  value ignored_name: carrier != null && contains(ignored, carrier.description.name)
    || stringification_ignored_base(n, carrier, ignored)
  value if primitive || ignored_name then 0
    else if contains(part.traits, "unknown") || contains(part.traits, "parameter") then if check_unknown then 1 else 0
    else if contains(["array", "tuple"], carrier.description.kind) then
      stringification_elements(map(carrier.arguments, argument => stringification_certainty(n, argument, ignored, check_unknown, seen)))
    else if !part.carrier_known then null else {
      value symbol: value_lookup(part.handle, ts_value_symbol_key(n, "toPrimitive"))
      value custom_symbol: symbol.alternatives != null
        && any(symbol.alternatives, arm => arm.matched && any(arm.sources, source => source.kind != "indexer"))
      value states: map(["toString", "toLocaleString", "valueOf"], key => stringification_member(n, part.handle, key))
      value if custom_symbol || any(states, state => state == 0) then 0
        else if symbol.alternatives == null || any(states, state => state == null) then null
        else if any(states, state => state == 2) then 2 else null
    }
}
fn stringification_parts(arm) = {
  value concrete: filter(arm.parts, part => part.traits != ["intersection"])
  value if count(concrete) > 0 then concrete else arm.parts
}
fn stringification_certainty(n, handle, ignored, check_unknown, seen) = {
  value arms: if contains(seen, handle) then null else value_parts(handle)
  value if arms == null then null else if count(arms) == 0 then 0 else stringification_union(map(arms, arm => {
    value concrete: filter(stringification_parts(arm), part => part.traits != ["parameter"])
    value parts: if count(concrete) > 0 then concrete else arm.parts
    value states: map(parts, part => stringification_part(n, part, ignored, check_unknown, seen [handle]))
    value if any(states, state => state == 0) then 0
      else if any(states, state => state == null) then null
      else if all(states, state => state == 1) then 1 else 2
  }))
}
fn stringification_join(n, ignored, check_unknown) = {
  value arms: value_parts(n)
  value if arms == null then null else stringification_union(map(arms, arm => {
    value states: map(stringification_parts(arm), part => if contains(["array", "tuple"], part.carrier.description.kind)
      then stringification_elements(map(part.carrier.arguments, argument => stringification_certainty(n, argument, ignored, check_unknown, [])))
      else 0)
    value if any(states, state => state == 0) then 0
      else if any(states, state => state == null) then null else max(states)
  }))
}
fn stringification_literal_array(n, ignored, check_unknown) = {
  value elements: n.element.nodes
  value spread: any(elements, element => element is ts_spread)
  value if spread then null
    else stringification_union(map(elements, element => stringification_certainty(n, element, ignored, check_unknown, [])))
}
in ts_call let stringification_subjects
  if callee is ts_identifier && global_callee == "String" then [{node: { value argument.nodes; first; unparenthesised_node }, join: false}]
  else if callee is ts_member && callee.property is ts_identifier && contains(["toString", "toLocaleString", "join"], callee.property.text) then [{node: unparenthesised_node(callee.object.node), join: callee.property.text == "join"}]
  else []
in ts_binary, ts_assignment let stringification_subjects
  if contains(["+", "+="], operator) && ts_value_string_like(left.node) == true then [{node: unparenthesised_node(right.node), join: false}]
  else if contains(["+", "+="], operator) && ts_value_string_like(right.node) == true && left not ts_private_name then [{node: unparenthesised_node(left.node), join: false}]
  else []
in ts_template let stringification_subjects if parent is ts_tagged_template then [] else map(expression.nodes, n => {node: unparenthesised_node(n), join: false})
in ts_call, ts_binary, ts_assignment, ts_template rule es-no-base-to-string {
  option ignoredTypeNames string[] = ["Error", "RegExp", "URL", "URLSearchParams"] "Types whose string conversion is permitted"
  option checkUnknown boolean = false "Check explicit unknown and unconstrained type parameters"
  let findings map(stringification_subjects, subject => {
    node: subject.node,
    join: subject.join,
    certainty: if stringification_ignored_alias(subject.node, ignoredTypeNames) then 0 else if subject.join then stringification_join(subject.node, ignoredTypeNames, checkUnknown) else if subject.node is ts_array && value_parts(subject.node) == null then stringification_literal_array(subject.node, ignoredTypeNames, checkUnknown) else stringification_certainty(subject.node, subject.node, ignoredTypeNames, checkUnknown, [])
  })
  each subject in findings {
    when subject.node != null && subject.node not (ts_literal, ts_spread)
    when subject.certainty != null && subject.certainty > 0
    report at {start: subject.node.offset, end: subject.node.end_offset}
    warn if subject.join then "Using `join()` for " subject.node.text " " (if subject.certainty == 2 then "will" else "may") " use Object's default stringification format ('[object Object]') when stringified."
      else "'" subject.node.text "' " (if subject.certainty == 2 then "will" else "may") " use Object's default stringification format ('[object Object]') when stringified."
  }
}

in ts_identifier {
  let eval_name text
  let eval_identifier true
  let eval_core_root if contains(["global", "globalThis", "window", "self"], text) && global != null && global != "off" then text else null
  let eval_timer_global resolved == "global" && (re_test(file, /\.[cm]?tsx?$/) || global != null && global != "off")
  let eval_constructor ts_value_builtin_type(node, ["FunctionConstructor"]) == true || ts_value_has_trait(node, "any") == true || ts_value_opaque(node) && reference_kind == null
}
in ts_member, ts_index {
  let eval_name static_name
  let eval_core_root if object.eval_core_root != null && static_name == object.eval_core_root then object.eval_core_root else null
  let eval_timer_global if re_test(file, /\.[cm]?tsx?$/) then object is ts_identifier && contains(["global", "globalThis", "window"], object) else object.eval_core_root != null
  let eval_constructor ts_value_builtin_type(node, ["FunctionConstructor"]) == true || ts_value_has_trait(node, "any") == true || ts_value_opaque(node)
}
in ts_member let eval_bind_member property == "bind"
in ts_parenthesized {
  let eval_name expression.eval_name
  let eval_identifier expression.eval_identifier
  let eval_core_root expression.eval_core_root
  let eval_timer_global expression.eval_timer_global
  let eval_constructor expression.eval_constructor
}
group typed_simple_expression ts_identifier, ts_private_name, ts_this, ts_super, ts_null, ts_boolean,
  ts_number, ts_bigint, ts_string, ts_regex, ts_template, ts_tagged_template, ts_array, ts_object,
  ts_member, ts_index, ts_new, ts_unary, ts_update, ts_await, ts_yield,
  ts_logical, ts_assignment, ts_conditional, ts_sequence, ts_as, ts_satisfies,
  ts_non_null, ts_type_assertion, ts_function, ts_arrow, ts_class, ts_instantiation, ts_meta_property,
  ts_import_call
in typed_simple_expression, ts_binary {
  let eval_callback ts_value_callable(node) || ts_value_builtin_type(node, ["Function"]) == true
}
fn eval_constant_string(n) = ts_runtime_string(n) != null && {
  value arms: value_trait_parts(n, ["string", "enum"])
  value part: if count(arms) == 1 && count(first(arms).parts) == 1 then first(first(arms).parts) else null
  value part != null && contains(part.traits, "string") && !contains(part.traits, "enum")
}
in typed_simple_expression {
  let eval_string is (ts_string, ts_template)
    || eval_constant_string(node)
}
in ts_call {
  let eval_callback ts_value_callable(node) || ts_value_builtin_type(node, ["Function"]) == true || callee.eval_bind_member == true || callee is ts_identifier && callee == "bind"
  let eval_string eval_constant_string(node) || callee.global_value == "String" && ts_runtime_string(first(argument.nodes)) != null
}
in ts_binary let eval_string eval_constant_string(node) || operator == "+" && (left.eval_string == true || right.eval_string == true)
in ts_parenthesized {
  let eval_callback expression.eval_callback
  let eval_string expression.eval_string
}
in ts_call, ts_new let eval_timer (contains(["setTimeout", "setInterval", "execScript"], callee.eval_name) || callee.eval_name == "setImmediate" && re_test(file, /\.[cm]?tsx?$/)) && callee.eval_timer_global == true
in ts_call.argument, ts_new.argument rule es-no-implied-eval {
  when index == 0 && parent.eval_timer == true && re_test(file, /\.[cm]?tsx?$/) && eval_callback != true
  warn "Implied eval. Consider passing a function."
}
in ts_call {
  rule es-no-implied-eval:core {
    when eval_timer && callee.eval_name != "execScript" && !re_test(file, /\.[cm]?tsx?$/) && first([] argument.eval_string) == true
    warn "Implied eval. Consider passing a function instead of a string."
  }
  rule es-no-implied-eval:exec {
    when eval_timer && callee.eval_name == "execScript" && !re_test(file, /\.[cm]?tsx?$/) && first([] argument.eval_string) == true
    warn "Implied eval. Do not use execScript()."
  }
}
in ts_call, ts_new {
  rule es-no-implied-eval:function {
    when callee.eval_name == "Function" && re_test(file, /\.[cm]?tsx?$/) && callee.eval_constructor
    when callee.eval_identifier == true || callee.eval_timer_global == true
    warn "Implied eval. Do not use the Function constructor to create functions."
  }
}

fn unsafe_argument_sender(transfer) = if transfer.error then if transfer.mode == "array" then "error" else "error typed" else if transfer.mode == "tuple" then "of type `{transfer.sender}`" else "`{transfer.sender}`"
fn unsafe_assignment_sender(transfer) = if transfer.error then "error typed" else "`{transfer.sender}`"
fn unsafe_this_note() = "\nYou can try to fix this by turning on the `noImplicitThis` compiler option, or adding a `this` parameter to the function."

in ts_call, ts_new, ts_tagged_template {
  rule es-no-unsafe-argument {
    each unsafe_arg in argument_value_transfers ?? [] {
      when unsafe_arg.mode == "argument"
      report at unsafe_arg.site
      warn "Unsafe argument of type " unsafe_argument_sender(unsafe_arg) " assigned to a parameter of type `{unsafe_arg.receiver}`."
    }
  }
  rule es-no-unsafe-argument:spread {
    each unsafe_arg in argument_value_transfers ?? [] {
      when unsafe_arg.mode == "spread"
      report at unsafe_arg.site
      warn "Unsafe spread of an " unsafe_argument_sender(unsafe_arg) " type."
    }
  }
  rule es-no-unsafe-argument:array {
    each unsafe_arg in argument_value_transfers ?? [] {
      when unsafe_arg.mode == "array"
      report at unsafe_arg.site
      warn "Unsafe spread of an " unsafe_argument_sender(unsafe_arg) " array type."
    }
  }
  rule es-no-unsafe-argument:tuple {
    each unsafe_arg in argument_value_transfers ?? [] {
      when unsafe_arg.mode == "tuple"
      report at unsafe_arg.site
      warn "Unsafe spread of a tuple type. The argument is " unsafe_argument_sender(unsafe_arg) " and is assigned to a parameter of type `{unsafe_arg.receiver}`."
    }
  }
}

in ts_declarator, ts_parameter, ts_class_property, ts_assignment, ts_assignment_pattern, ts_property, ts_spread, ts_jsx_attribute {
  rule es-no-unsafe-assignment {
    each unsafe_assigned in assignment_value_transfers {
      when unsafe_assigned.mode == "any"
      report at unsafe_assigned.site
      warn when { unsafe_assigned.this_any then "Unsafe assignment of an `any` value. `this` is typed as `any`." unsafe_this_note()
        else then "Unsafe assignment of an " unsafe_assignment_sender(unsafe_assigned) " value." }
    }
  }
  rule es-no-unsafe-assignment:generic {
    each unsafe_assigned in assignment_value_transfers {
      when unsafe_assigned.mode == "generic"
      report at unsafe_assigned.site
      warn "Unsafe assignment of type " unsafe_assignment_sender(unsafe_assigned) " to a variable of type `{unsafe_assigned.receiver}`."
    }
  }
  rule es-no-unsafe-assignment:array {
    each unsafe_assigned in assignment_value_transfers {
      when unsafe_assigned.mode == "array"
      report at unsafe_assigned.site
      warn "Unsafe array destructuring of an " unsafe_assignment_sender(unsafe_assigned) " array value."
    }
  }
  rule es-no-unsafe-assignment:tuple {
    each unsafe_assigned in assignment_value_transfers {
      when unsafe_assigned.mode == "tuple"
      report at unsafe_assigned.site
      warn "Unsafe array destructuring of a tuple element with an " unsafe_assignment_sender(unsafe_assigned) " value."
    }
  }
  rule es-no-unsafe-assignment:object {
    each unsafe_assigned in assignment_value_transfers {
      when unsafe_assigned.mode == "object"
      report at unsafe_assigned.site
      warn "Unsafe object destructuring of a property with an " unsafe_assignment_sender(unsafe_assigned) " value."
    }
  }
  rule es-no-unsafe-assignment:spread {
    each unsafe_assigned in assignment_value_transfers {
      when unsafe_assigned.mode == "spread"
      report at unsafe_assigned.site
      warn "Unsafe spread of an " unsafe_assignment_sender(unsafe_assigned) " value in an array."
    }
  }
}

fn unsafe_return_sender(transfer) = if transfer.error then "error" else if transfer.mode == "array" then "`any[]`" else if transfer.mode == "promise" then "`Promise<any>`" else "`any`"

in ts_return, ts_arrow.body rule es-no-unsafe-return {
  when return_value_transfer != null && return_value_transfer.mode != "generic"
  warn when { return_value_transfer.this_any then "Unsafe return of a value of type `{unsafe_return_sender(return_value_transfer)}`. `this` is typed as `any`." unsafe_this_note()
    else then "Unsafe return of a value of type " unsafe_return_sender(return_value_transfer) "." }
}
in ts_return, ts_arrow.body rule es-no-unsafe-return:assignment {
  when return_value_transfer != null && return_value_transfer.mode == "generic"
  warn "Unsafe return of type `{return_value_transfer.sender}` from function with return type `{return_value_transfer.receiver}`."
}

fn non_null_style_fix(source, n) = {
  value body: assertion_fix_body(source, n)
  value wrapped: body.node is (structure_binary, structure_assertion, ts_sequence, ts_assignment,
    ts_conditional, ts_arrow, ts_yield, ts_unary, ts_await, ts_update)
  value replacement: expression_fix_wrap(body.text, wrapped) "!"
  value if !expression_fix_retains_comments(n, replacement) then null else assertion_fix_output(n, replacement)
}
in ts_as, ts_type_assertion rule es-non-nullable-type-assertion-style {
  when type.text != "const" && assertion_non_null_style(node) == true
  warn "Use a ! assertion to more succinctly remove null and undefined from the type."
  let edit non_null_style_fix(source, node)
  fix at edit.target if edit != null as edit.text
}
in ts_method.return_type, ts_method_signature.return_type rule es-related-getter-setter-pairs {
  when typed_accessor_type_mismatch(node)
  warn "`get()` type should be assignable to its equivalent `set()` type."
}
# `await` of something that is not a promise; promise aggregators of arrays
# of non-promises.
in ts_await rule es-await-thenable {
  when ts_value_nonthenable(argument.node) == true
  warn "Unexpected `await` of a non-Promise (non-\"Thenable\") value."
}
in ts_member, ts_index let promise_aggregate_member contains(["all", "allSettled", "race", "any"], static_name) && object.global_value == "Promise"
in ts_call let is_promise_aggregator callee.promise_aggregate_member == true
in ts_array let is_promise_aggregator_argument parent.is_promise_aggregator == true
in ts_array.element rule es-await-thenable:aggregate {
  when not ts_hole && parent.is_promise_aggregator_argument
    && (if is ts_spread then ts_await_nonawaitable_iterable(argument.node) else ts_value_nonthenable(node) == true)
  warn "Unexpected iterable of non-Promise (non-\"Thenable\") values passed to promise aggregator."
}
in ts_call.argument rule es-await-thenable:iterable {
  when parent.is_promise_aggregator == true && not ts_array && ts_await_nonawaitable_iterable(node)
  warn "Unexpected iterable of non-Promise (non-\"Thenable\") values passed to promise aggregator."
}
in ts_for_of rule es-await-thenable:for-of {
  report at { start: offset, end: last(overlapping(ts_close_paren, right.end_offset, body.offset)).end_offset }
  when contains([] modifier, "await")
    && value_has_member(right.node, {global: "Symbol", class: "value", path: ["asyncIterator"]}, null) == false
  warn "Unexpected `for await...of` of a value that is not async iterable."
}
in ts_declarator.init rule es-await-thenable:using {
  when starts_with(parent.parent.kind.text, "await")
    && value_has_member(node, {global: "Symbol", class: "value", path: ["asyncDispose"]}, null) == false
  warn "Unexpected `await using` of a value that is not async disposable."
}

# ---- template interpolation ----------------------------------------------------
in ts_template let tagged_template parent is ts_tagged_template
in ts_node let restrict_template_expressions_type_checks template_type_checks
in ts_template.expression rule es-restrict-template-expressions {
  option allowAny boolean = true "Allow any values"
  option allowArray boolean = false "Allow arrays whose elements can be interpolated"
  option allowBoolean boolean = true "Allow booleans"
  option allowNullish boolean = true "Allow null and undefined"
  option allowNumber boolean = true "Allow numbers and bigints"
  option allowRegExp boolean = true "Allow regular expressions"
  option allowNever boolean = false "Allow never values"
  option allow string[] | null = null "Allowed types and values; null keeps standard library Error, URL and URLSearchParams"
  let enabled_template_options ["string"] (if allowAny then ["any"] else []) (if allowArray then ["array"] else []) (if allowBoolean then ["boolean"] else []) (if allowNullish then ["nullish"] else []) (if allowNumber then ["number"] else []) (if allowRegExp then ["regexp"] else []) (if allowNever then ["never"] else [])
  when parent.tagged_template != true
  when template_type_checks != null
  when any(restrict_template_expressions_type_checks, clause => !any(clause, gate => contains(enabled_template_options, gate.option) || gate.name != null && (if allow == null then gate.from == "lib" && contains(["Error", "URL", "URLSearchParams"], gate.name) else contains(allow, gate.name))))
  let template_display_parts value_constituents(node)
  when template_display_parts != null
  warn "Invalid type \"{ts_value_print_type(node)}\" of template literal expression."
}

fn typed_unary_type(n) = if (n is ts_template) && count(n.expression.nodes) == 0
  then ts_value_string(slice(first(n.quasi.nodes).text, 1, -1)) else ts_value_print_type(n)

in ts_unary rule es-no-unsafe-unary-minus {
  when operator == "-" && !ts_value_opaque(argument.node)
    && !any(["any", "number", "bigint", "enum"], trait => ts_value_has_trait(argument.node, trait) == true)
  let operand_type value_constituents(argument.node)
  when operand_type != null && count(operand_type) > 0
  warn "Argument of unary negation should be assignable to number | bigint but is {typed_unary_type(argument.node)} instead."
}

in ts_member, ts_index let object_array_type ts_value_array_like(object.node)
in ts_parenthesized let object_array_type expression.object_array_type
in ts_member, ts_index let array_literal_object object is ts_array
in ts_parenthesized let array_literal_object expression.array_literal_object
in ts_unary rule es-no-array-delete {
  when operator == "delete" && (argument.array_literal_object == true || argument.object_array_type == true)
  warn "Using the `delete` operator with an array expression is unsafe."
}

in ts_assignment_pattern, ts_parameter rule es-no-useless-default-assignment {
  when typed_default_assignment != null
  report at { start: typed_default_assignment.offset, end: typed_default_assignment.end }
  warn when {
    typed_default_assignment.kind == "optional" then "Using `= undefined` to make a parameter optional adds unnecessary runtime logic."
    typed_default_assignment.kind == "undefined" then "Default value is useless because it is undefined. Optional {typed_default_assignment.owner}s are already undefined by default."
    else then "Default value is useless because the {typed_default_assignment.owner} is not optional."
  }
}
in ts_program rule es-no-useless-default-assignment:strict {
  option allowRuleToRunWithoutStrictNullChecksIKnowWhatIAmDoing boolean = false "Run without strict null checks"
  when ts_compiler_option(node, "strictNullChecks") == false && !allowRuleToRunWithoutStrictNullChecksIKnowWhatIAmDoing
  report at { start: 0, end: 0 }
  warn "This rule requires the `strictNullChecks` compiler option to be turned on to function correctly."
}

in ts_as, ts_type_assertion rule es-no-unsafe-type-assertion {
  when type.text != "const"
  let operand value_constituents(expression.node)
  let annotation value_constituents(type.node)
  when operand != null && annotation != null
  let from_any !assignment_empty_map(expression.node) && (assignment_unsafe(operand, annotation, node) || annotation == [] && ts_value_category(operand) != null)
  let to_any (operand == [] || ts_value_trait(operand, "unknown")) && ts_value_category(annotation) != null || assignment_unsafe(annotation, operand, node)
  let narrowing if from_any || to_any then null else assertion_unsafe_narrowing(node)
  let label if from_any then if ts_value_category(operand) == "error" then "error typed" else "`any`" else if to_any then if ts_value_category(annotation) == "error" then "error typed" else "`any`" else narrowing.label
  when from_any || to_any || narrowing != null && !re_test(label, /\bunknown\b/)
  warn if from_any then "Unsafe assertion from {label} detected: consider using type guards or a safer assertion." else if to_any then "Unsafe assertion to {label} detected: consider using a more specific type to ensure safety." else if narrowing.kind == "narrow" then "Unsafe type assertion: type '{label}' is more narrow than the original type." else if narrowing.kind == "unconstrained" then "Unsafe type assertion: '{label}' could be instantiated with an arbitrary type which could be unrelated to the original type." else "Unsafe type assertion: the original type is assignable to the constraint of type '{label}', but '{label}' could be instantiated with a different subtype of its constraint."
}

in ts_member let object_string_array_type ts_value_string_array(object.node)
in ts_call rule es-require-array-sort-compare {
  option ignoreStringArrays boolean = true "Ignore arrays whose elements are all strings"
  when count(argument) == 0 && re_test(callee, /\??\.\s*(sort|toSorted)$/)
  when callee.object_array_type == true && (!ignoreStringArrays || callee.object_string_array_type != true)
  warn "Require 'compare' argument."
}


in ts_unary rule es-no-meaningless-void-operator {
  option checkNever boolean = false "Also check calls returning never"
  when operator == "void" && argument != "0"
  let underlying {
    value argument.node
    walk (current) if current is (ts_parenthesized, ts_as, ts_satisfies, ts_non_null, ts_type_assertion)
      then current.expression.node
      else if current is ts_sequence then last(current.expression.nodes) else null
    last
  }
  when underlying not ts_assignment
  let call underlying is (ts_call, ts_new)
  when if call then ts_value_trait(value_constituent_traits(argument.node, ["undefined"]), "undefined")
    || checkNever && value_parts(argument.node) == [] else value_has_member(argument.node, "then", null) != true
  let operand_type if call then value_constituents(argument.node) else []
  when !call || operand_type != null
  warn if call then "void operator shouldn't be used on {ts_value_print(operand_type)}; it should convey that a return value is being ignored" else "void operator is useless here; it should only discard a call's return value"
  let operand argument.node
  let parens expression_fix_parens(source, node, operand)
  let replacement expression_fix_wrap(operand.text, parens > 0)
  let statement expression_fix_statement(node)
  let semicolon if statement != null && expression_fix_continuation(replacement)
    then expression_fix_asi(statement, token_neighbours.before, expression_fix_before_nodes(node), replacement) else false
  fix if parens != null && semicolon != null && expression_fix_clean({ offset: offset, end_offset: operand.offset }) as
    (if semicolon then ";" else "") expression_fix_edges(node, replacement)
}

}
