# .ts/style: typescript-eslint stylistic and strict rules, plus import /
# jsdoc / tslint ones, on the native TypeScript layers. Messages and
# positions follow typescript-eslint's.
#
# `[] x` turns a field or field attribute into a list whether it matched
# none, one or many nodes.

import .ts/helpers

define {

group style_tree_node ts_node

macro modifiers (join([] modifier, " "))
macro has_accessibility(m) re_test(m, /\b(?:public|private|protected)\b/)

# ---- comments --------------------------------------------------------------------
in ts_comment rule ban-tslint-comment {
  when re_test(text, /^\/[\/*]\s*tslint:/)
  warn "tslint comment detected: \"{text}\""
}

# Only directives before the first code token are triple-slash references.
in ts_line_comment rule triple-slash-reference {
  option lib ("always" | "never") = "always" "When lib directives are allowed."
  option path ("always" | "never") = "never" "When path directives are allowed."
  option types ("always" | "never" | "prefer-import") = "prefer-import" "When types directives are allowed."
  let directive re_replace(text, /^\/\/\/\s*<reference\s*(types|path|lib)\s*=[\s\S]*$/, "$1")
  let module re_replace(text, /^\/\/\/\s*<reference\s*(?:types|path|lib)\s*=\s*["'|](.*)["'|][\s\S]*$/, "$1")
  when re_test(text, /^\/\/\/\s*<reference\s*(?:types|path|lib)\s*=\s*["'|].*["'|]/)
  when re_test(slice(source, 0, offset), /^(?:\s|\/\/[^\r\n]*(?:\r?\n|$)|\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\/)*$/)
  when directive == "lib" && lib == "never" || directive == "path" && path == "never" || directive == "types" && (types == "never" || types == "prefer-import" && re_test(source, "(?:import|from|require\\s*\\()\\s*[\"']" re_escape(module) "[\"']"))
  warn "Do not use a triple slash reference for {module}, use `import` style instead."
}

# JSDoc lines whose `*` is not one column right of the opening `/**`. The
# matchers never take the `*` of the closing `*/` (the comment's own end).
in ts_block_comment match jsdoc_line /^[ \t]*\*(?!\/)/
in ts_block_comment match jsdoc_close_indent /^[ \t]+(?=\*\/)/
in ts_block_comment match jsdoc_blank_run /^(?:[ \t]*\r?\n)+/
# Blank lines inside the block have no `*` at all.
in jsdoc_blank_run rule check-alignment:blank {
  when re_test(parent_text, /^\/\*\*[^*]/)
  warn "Expected JSDoc block to be aligned."
}
# `/**` then anything but another `*` (`/*****` banners are not JSDoc).
macro is_jsdoc re_test(parent_text, /^\/\*\*[^*]/)
in jsdoc_line rule check-alignment {
  when is_jsdoc && text != parent_indent " *"
  warn "Expected JSDoc block to be aligned."
}
in jsdoc_close_indent rule check-alignment:close {
  when is_jsdoc && text != parent_indent " "
  warn "Expected JSDoc block to be aligned."
}
in ts_block_comment match jsdoc_typed_tag /^[ \t]*\*[ \t]*@(?:param|arg|argument|returns?|property|prop|throws|yields)[ \t]+\{/
in jsdoc_typed_tag rule no-types {
  when is_jsdoc
  warn "Types are not permitted on @{re_replace(text, /^.*@(\w+).*$/, '$1')}."
}

# ---- type syntax -------------------------------------------------------------------
fn type_restriction_key(types, name) = find_last(keys(types), n => re_replace(n, /\s+/, "") == name)
fn type_restriction_enabled(policy) = type_of(policy) != "null" && !(type_of(policy) == "bool" && policy == false)
fn type_restriction_message(name, policy) = "Don't use `" name "` as a type." (if type_of(policy) == "str" && policy != "" then " " policy else if policy.message != null && policy.message != "" then " " policy.message else "")
in ts_type_reference let restricted_type_shape count(type_argument) > 0
in ts_type_keyword let restricted_type_shape contains(["bigint", "boolean", "never", "null", "number", "object", "string", "symbol", "undefined", "unknown", "void"], text)
in ts_tuple_type let restricted_type_shape count(element) == 0
in ts_type_literal let restricted_type_shape count(member) == 0
in ts_type_reference, ts_type_keyword, ts_tuple_type, ts_type_literal rule no-restricted-types {
  option types { [key: string]: boolean | string | { fixWith?: string; message?: string; suggest?: string[] } | null } = {} "Restricted types and custom messages."
  when restricted_type_shape
  let restricted_name re_replace(text, /\s+/, "")
  let restriction get(types, type_restriction_key(types, restricted_name))
  when type_restriction_enabled(restriction)
  warn type_restriction_message(restricted_name, restriction)
}
in ts_type_reference.name rule no-restricted-types:name {
  option types { [key: string]: boolean | string | { fixWith?: string; message?: string; suggest?: string[] } | null } = {} "Restricted types and custom messages."
  let restricted_name re_replace(text, /\s+/, "")
  let restriction get(types, type_restriction_key(types, restricted_name))
  when type_restriction_enabled(restriction)
  warn type_restriction_message(restricted_name, restriction)
}

# array-type selects array or generic notation separately for readonly arrays.
in ts_type_keyword, ts_array_type, ts_qualified_name let is_simple_type true
in ts_type_reference let is_simple_type count(type_argument) == 0 || name == "Array" && count(type_argument) == 1 && first([] type_argument.is_simple_type) == true
in ts_array_type {
  let array_type_not_simple !(type.is_simple_type == true)
  let is_array_type true
  let array_element_simple type.is_simple_type == true
  let array_element_text type
}
in ts_type_operator let readonly_array_not_simple operator == "readonly" && type.array_type_not_simple == true
in ts_type_reference rule array-type:generic {
  option default ("array" | "array-simple" | "generic") = "array" "Mutable array notation."
  option readonly string = "" "Readonly array notation; empty uses default."
  let is_readonly name == "ReadonlyArray" || name == "Readonly"
  let mode if is_readonly && readonly != "" then readonly else default
  let arg first([] type_argument)
  when re_test(name, /^(Array|ReadonlyArray|Readonly)$/) && count(type_argument) == 1 && name.reference_kind == null
  when name != "Readonly" || first([] type_argument.is_array_type) == true
  when mode != "generic" && (mode != "array-simple" || first([] type_argument.is_simple_type) == true)
  let shown if first([] type_argument.is_simple_type) == true then arg else "T"
  warn "Array type using '{name}<{shown}>' is forbidden{if mode == 'array-simple' then ' for simple types' else ''}. Use '{if is_readonly then 'readonly ' else ''}{shown}{if name == 'Readonly' then '' else '[]'}' instead."
}
in ts_array_type rule array-type:simple {
  option default ("array" | "array-simple" | "generic") = "array" "Mutable array notation."
  option readonly string = "" "Readonly array notation; empty uses default."
  when !(parent == "ts_type_operator" && parent.operator == "readonly")
  when default == "generic" || default == "array-simple" && array_type_not_simple
  let shown if type.is_simple_type == true then type else "T"
  warn "Array type using '{shown}[]' is forbidden{if default == 'array-simple' then ' for non-simple types' else ''}. Use 'Array<{shown}>' instead."
}
in ts_type_operator rule array-type:readonly {
  option default ("array" | "array-simple" | "generic") = "array" "Mutable array notation."
  option readonly string = "" "Readonly array notation; empty uses default."
  let mode if readonly == "" then default else readonly
  when operator == "readonly" && type.is_array_type == true
  when mode == "generic" || mode == "array-simple" && readonly_array_not_simple
  let shown if type.array_element_simple then type.array_element_text else "T"
  warn "Array type using 'readonly {shown}[]' is forbidden{if mode == 'array-simple' then ' for non-simple types' else ''}. Use 'ReadonlyArray<{shown}>' instead."
}

# The global wrapper types (not local types of those names).
in ts_type_reference rule no-wrapper-object-types {
  when re_test(name, /^(String|Number|Boolean|Object|Symbol|BigInt)$/) && parent != "ts_template_type" && name.reference_kind == null
  warn "Prefer using the primitive `{lower(name)}` as a type name, rather than the upper-cased `{name}`."
}

in ts_non_null rule no-non-null-assertion {
  warn "Forbidden non-null assertion."
}
in ts_declarator let initialised_declaration_end if init != null || starts_with(trim_start(slice(text, len(name))), "!") then end_offset else null
in ts_identifier let binding_initialised_end if parent is ts_declarator then parent.initialised_declaration_end else null
in ts_identifier let binding_write_end if access == "write" || access == "read_write" then end_offset else null
in ts_identifier let binding_assignment_history if declaration == null then null else { initialised: declaration.binding_initialised_end, writes: [] declaration.references.binding_write_end }
in ts_parenthesized forward binding_assignment_history from expression
in ts_non_null, ts_parenthesized let nullish_left if parent is ts_parenthesized then parent.nullish_left else parent is ts_logical && parent.operator == "??" && field == "left"
fn assigned_before(history, end) = history == null || history.initialised != null && history.initialised < end || any(history.writes, n => n != null && n < end)
in ts_non_null rule no-non-null-asserted-nullish-coalescing {
  when nullish_left && assigned_before(expression.binding_assignment_history, end_offset)
  warn "The nullish coalescing operator is designed to handle undefined and null - using a non-null assertion is not needed."
}

in ts_type_parameter rule no-unnecessary-type-constraint {
  when constraint == "any" || constraint == "unknown"
  warn "Constraining the generic type `{name}` to `{constraint}` does nothing and is unnecessary."
}

in ts_function let function_declaration { name: name, kind: layer, body: body != null }
in ts_method let function_declaration { name: key, kind: layer, body: body != null }
in ts_export forward function_declaration from declaration
in style_tree_node let function_siblings if layer == "ts_export" then parent.function_siblings else [] children.function_declaration
in ts_function, ts_method let overload_implementation body != null && any(parent.function_siblings, d => d.kind == layer && d.name == function_declaration.name && !d.body)
in style_tree_node let function_overload_context if layer is (ts_function, ts_method) then overload_implementation else parent.function_overload_context
in ts_type_keyword let void_keyword text == "void"
in ts_type_reference let has_void_argument any([] type_argument.void_keyword, v => v == true)
in style_tree_node let void_union_member if layer == "ts_type_keyword" then contains(["void", "never"], text) else if layer == "ts_type_reference" then has_void_argument else false
in ts_union let valid_void_union all([] type.void_union_member, t => t == true)
in ts_type_keyword rule no-invalid-void-type {
  option allowAsThisParameter boolean = false "Allow void as the type of a this parameter."
  option allowInGenericTypeArguments boolean | string[] = true "Allow void in generic arguments, or only named generic types."
  let context if field == "return_type" then "return" else if field == "type_argument" then (if parent is ts_type_reference then "generic" else if parent is ts_call then "other" else "generic-other") else if parent is ts_type_parameter && field == "default" then "default" else if parent is ts_parameter && parent.name == "this" then "this" else if parent is ts_union then (if parent.valid_void_union || parent.function_overload_context == true then "return" else "union") else "other"
  let generic_name re_replace(default(parent.name, ""), /\s+/, "")
  let generic_allowed allowInGenericTypeArguments == true || type_of(allowInGenericTypeArguments) == "list" && contains(map(allowInGenericTypeArguments, n => re_replace(n, /\s+/, "")), generic_name)
  when text == "void" && context != "return"
  when !(context == "generic" && generic_allowed || context == "generic-other" && allowInGenericTypeArguments == true || context == "default" && allowInGenericTypeArguments || context == "this" && allowAsThisParameter)
  warn if context == "generic" && type_of(allowInGenericTypeArguments) == "list" then generic_name " may not have void as a type argument." else if allowInGenericTypeArguments && allowAsThisParameter then "void is only valid as a return type or generic type argument or the type of a `this` parameter." else if allowInGenericTypeArguments && context == "union" then "void is not valid as a constituent in a union type" else if allowInGenericTypeArguments then "void is only valid as a return type or generic type argument." else if allowAsThisParameter then "void is only valid as return type or type of `this` parameter." else "void is only valid as a return type."
}

in ts_parameter let rest_function_parameter name.layer == "ts_rest" && parent is (ts_function, ts_arrow, ts_method, ts_method_signature, ts_call_signature, ts_function_type)
in ts_type_operator let rest_array_wrapper operator == "readonly" && parent.rest_function_parameter == true
in ts_type_reference let rest_array_wrapper contains(["Array", "ReadonlyArray"], name) && parent.rest_function_parameter == true
in style_tree_node let rest_array_argument parent.rest_function_parameter == true || parent.rest_array_wrapper == true
in ts_type_keyword rule no-explicit-any {
  option ignoreRestArgs boolean = false "Ignore any in rest parameter arrays."
  option fixToUnknown boolean = false "Enable replacing any with unknown."
  when text == "any" && !(ignoreRestArgs && parent.rest_array_argument == true)
  warn "Unexpected any. Specify a different type."
}

in ts_number, ts_string let delete_literal_key true
in ts_number let delete_numeric_key true
in ts_parenthesized forward delete_literal_key, delete_numeric_key from expression
in ts_unary let delete_literal_key operator == "-" && argument.delete_numeric_key == true
in ts_index, ts_parenthesized let delete_operand if parent is ts_parenthesized then parent.delete_operand else parent is ts_unary && parent.operator == "delete"
in ts_index rule no-dynamic-delete {
  when delete_operand && index.delete_literal_key != true
  report at index.unparen_offset
  warn "Do not delete dynamically computed property keys."
}

in ts_namespace let namespace_is_declared contains([] modifier, "declare")
in style_tree_node let namespace_declared namespace_is_declared == true || parent.namespace_declared == true
in ts_namespace rule no-namespace {
  option allowDeclarations boolean = false "Allow namespaces within declarations."
  option allowDefinitionFiles boolean = true "Allow namespaces in definition files."
  when kind != "global" && name != "global" && !re_test(name, /^["']/) && parent != "ts_namespace"
  when !(allowDefinitionFiles && re_test(file, /\.d\.[cm]?ts$/)) && !(allowDeclarations && namespace_declared)
  warn "ES2015 module syntax is preferred over namespaces."
}

in ts_export let empty_module_export declaration == null && expression == null && from == null && namespace == null && count(specifier) == 0 && contains(text, "{{")
in ts_export let module_item !empty_module_export
in ts_import, ts_import_equals, ts_export_assignment let module_item true
in ts_program let has_module_item any([] body.module_item, x => x == true)
in ts_export rule no-useless-empty-export {
  when !re_test(file, /\.d\.[cm]?ts$/) && empty_module_export && parent.has_module_item
  warn "Empty export does nothing and can be removed."
}

in ts_enum_member rule prefer-enum-initializers {
  when init == null
  warn "The value of the member '{text}' should be explicitly defined."
}

in ts_enum let enum_keys [] member.static_name
in ts_enum_member let enum_scope { name: parent.name, keys: parent.enum_keys }
in ts_identifier, ts_member, ts_index, ts_unary, ts_binary, ts_parenthesized let enum_scope parent.enum_scope
in ts_number, ts_string, ts_bigint, ts_boolean, ts_null, ts_regex {
  let enum_literal_value true
  let enum_bitwise_value true
  let enum_bitwise_operand true
}
in ts_template {
  let enum_literal_value count(expression) == 0
  let enum_bitwise_value enum_literal_value
  let enum_bitwise_operand enum_literal_value
}
in ts_identifier let enum_bitwise_operand contains(enum_scope.keys, text)
in ts_member, ts_index let enum_bitwise_operand object == enum_scope.name && contains(enum_scope.keys, static_name)
in ts_unary {
  let enum_literal_value contains(["+", "-"], operator) && argument.enum_literal_value == true
  let enum_bitwise_value if operator == "~" then argument.enum_bitwise_operand == true else contains(["+", "-"], operator) && argument.enum_bitwise_value == true
  let enum_bitwise_operand contains(["+", "-", "~"], operator) && argument.enum_bitwise_operand == true
}
in ts_binary {
  let enum_bitwise_value contains(["&", "^", "<<", ">>", ">>>", "|"], operator) && left.enum_bitwise_operand == true && right.enum_bitwise_operand == true
  let enum_bitwise_operand enum_bitwise_value
}
in ts_parenthesized forward enum_literal_value, enum_bitwise_value, enum_bitwise_operand from expression
in ts_enum_member let enum_literal_value init == null || init.enum_literal_value == true
in ts_enum_member let enum_bitwise_value init == null || init.enum_bitwise_value == true
in ts_enum_member.name rule prefer-literal-enum-member {
  option allowBitwiseExpressions boolean = false "Allow bitwise expressions using literals and enum members."
  when !(if allowBitwiseExpressions then parent.enum_bitwise_value else parent.enum_literal_value)
  warn "Explicit enum value must only be a literal value (string or number){if allowBitwiseExpressions then ' or a bitwise expression' else ''}."
}

in ts_declarator.name rule no-this-alias {
  option allowDestructuring boolean = true "Allow destructuring this."
  option allowedNames string[] = [] "Names allowed to alias this."
  when parent.init == "this"
  when !(allowDestructuring && layer != "ts_identifier") && !contains(allowedNames, text)
  warn if layer == "ts_identifier" then "Unexpected aliasing of 'this' to local variable." else "Unexpected aliasing of members of 'this' to local variables."
}
in ts_assignment.left rule no-this-alias:assignment {
  option allowDestructuring boolean = true "Allow destructuring this."
  option allowedNames string[] = [] "Names allowed to alias this."
  when parent.right == "this"
  when !(allowDestructuring && layer != "ts_identifier") && !contains(allowedNames, text)
  warn if layer == "ts_identifier" then "Unexpected aliasing of 'this' to local variable." else "Unexpected aliasing of members of 'this' to local variables."
}

in ts_import_specifier let type_only_specifier kind == "type"
in ts_import rule no-import-type-side-effects {
  when kind != "type" && default_import == null && namespace == null && count(specifier) > 0
  when count(filter([] specifier.type_only_specifier, t => t)) == count(specifier)
  warn "TypeScript will only remove the inline type specifiers which will leave behind a side effect import at runtime. Convert this to a top-level type qualifier to properly remove the entire import."
}

in ts_method_signature rule method-signature-style {
  option mode ("method" | "property") = "property" "Preferred method signature notation."
  when mode == "property" && kind != "get" && kind != "set"
  warn "Shorthand method signature is forbidden. Use a function property instead."
}
in ts_function_type let is_function_type true
in ts_property_signature rule method-signature-style:property {
  option mode ("method" | "property") = "property" "Preferred method signature notation."
  when mode == "method" && type.is_function_type == true
  warn "Function property signature is forbidden. Use a method shorthand instead."
}

in ts_object let assertion_literal_kind "object"
in ts_array let assertion_literal_kind "array"
in ts_parenthesized let assertion_literal_kind expression.assertion_literal_kind
in ts_as, ts_type_assertion rule consistent-type-assertions {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  option objectLiteralTypeAssertions ("allow" | "allow-as-parameter" | "never") = "allow" "When object literal assertions are allowed."
  option arrayLiteralTypeAssertions ("allow" | "allow-as-parameter" | "never") = "allow" "When array literal assertions are allowed."
  when layer == "ts_as" && assertionStyle != "as" || layer == "ts_type_assertion" && assertionStyle != "angle-bracket"
  when !(assertionStyle == "never" && type == "const")
  warn if assertionStyle == "never" then "Do not use any type assertions." else if assertionStyle == "as" then "Use 'as {type}' instead of '<{type}>'." else "Use '<{type}>' instead of 'as {type}'."
}
in ts_template let tagged_substitution parent is ts_tagged_template
in ts_as, ts_type_assertion, ts_parenthesized let assertion_argument_context if parent is ts_parenthesized then parent.assertion_argument_context else parent is (ts_new, ts_call, ts_throw, ts_assignment_pattern, ts_jsx_expression) || parent is ts_parameter && field == "init" || parent is ts_template && parent.tagged_substitution
in ts_as, ts_type_assertion rule consistent-type-assertions:literal {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  option objectLiteralTypeAssertions ("allow" | "allow-as-parameter" | "never") = "allow" "When object literal assertions are allowed."
  option arrayLiteralTypeAssertions ("allow" | "allow-as-parameter" | "never") = "allow" "When array literal assertions are allowed."
  let literal_kind expression.assertion_literal_kind
  let literal_mode if literal_kind == "array" then arrayLiteralTypeAssertions else objectLiteralTypeAssertions
  when layer == "ts_as" && assertionStyle == "as" || layer == "ts_type_assertion" && assertionStyle == "angle-bracket"
  when literal_kind != null && type != "any" && type != "unknown" && type != "const"
  when literal_mode == "never" || literal_mode == "allow-as-parameter" && !assertion_argument_context
  warn if literal_kind == "array" then "Always prefer const x: T[] = [ ... ]." else "Always prefer const x: T = {{ ... }}."
}

fn property_modifiers(xs) = join(filter(["public", "protected", "private", "readonly"], m => contains(xs, m)), " ")
in ts_parameter, ts_class_property let parameter_modifiers property_modifiers([] modifier)
in ts_parameter rule parameter-properties {
  option allow string[] = [] "Parameter property modifiers to allow."
  option prefer ("class-property" | "parameter-property") = "class-property" "Preferred property declaration."
  when prefer == "class-property" && parameter_modifiers != "" && !contains(allow, parameter_modifiers)
  warn "Property {name} should be declared as a class property."
}
in ts_member let plain_this_property object.layer == "ts_this" && property.layer == "ts_identifier"
in ts_assignment let parameter_assignment_name if left.plain_this_property == true && right.layer == "ts_identifier" then right else null
in ts_expression_statement let leading_parameter_assignment if expression.parameter_assignment_name != null && (previous == null || previous.leading_parameter_assignment != null) then expression.parameter_assignment_name else null
in ts_block let leading_parameter_assignments [] body.leading_parameter_assignment
in ts_parameter let convertible_parameter if init == null && parameter_modifiers == "" then { name: name, annotation: type } else null
in ts_method let property_conversion_constructor if key == "constructor" && body != null then { parameters: [] parameter.convertible_parameter, assignments: body.leading_parameter_assignments } else null
in ts_class let property_conversion_constructors [] member.property_conversion_constructor
fn conversion_parameter(parameters, name) = find(parameters, p => p.name == name)
fn property_conversion_matches(constructors, name, annotation) = any(constructors, c => conversion_parameter(c.parameters, name) != null && conversion_parameter(c.parameters, name).annotation == annotation && contains(c.assignments, name))
in ts_class_property rule parameter-properties:class {
  option allow string[] = [] "Parameter property modifiers to allow."
  option prefer ("class-property" | "parameter-property") = "class-property" "Preferred property declaration."
  when prefer == "parameter-property" && key.layer == "ts_identifier" && init == null && !contains(allow, parameter_modifiers)
  when property_conversion_matches(parent.property_conversion_constructors, key, type)
  warn "Property {key} should be declared as a parameter property."
}

in ts_number, ts_string, ts_boolean, ts_bigint, ts_null, ts_regex let raw_literal_expression text
in ts_parenthesized let raw_literal_expression expression.raw_literal_expression
in ts_literal_type let literal_type_text value
in ts_as, ts_type_assertion let use_const_assertion type.literal_type_text != null && type.literal_type_text == expression.raw_literal_expression
in ts_declarator, ts_class_property let use_const_annotation type.literal_type_text != null && type.literal_type_text == init.raw_literal_expression
in ts_as.type, ts_type_assertion.type rule prefer-as-const {
  when parent.use_const_assertion
  warn "Expected a `const` instead of a literal type assertion."
}
in ts_declarator.type, ts_class_property.type rule prefer-as-const:annotation {
  when parent.use_const_annotation
  warn "Expected a `const` assertion instead of a literal type annotation."
}

macro empty_object_message(subject, option_name) subject " allows any non-nullish value, including literals like `0` and `\"\"`.\n- If that's what you want, disable this lint rule with an inline comment or configure the '" option_name "' rule option.\n- If you want a type meaning \"any object\", you probably want `object` instead.\n- If you want a type meaning \"any value\", you probably want `unknown` instead."
in ts_interface.name rule no-empty-object-type:interface {
  option allowInterfaces ("always" | "never" | "with-single-extends") = "never" "When to allow empty interfaces."
  option allowObjectTypes ("always" | "never") = "never" "When to allow empty object types."
  option allowWithName string = "" "Allow matching interface and type alias names."
  when allowInterfaces != "always" && count(parent.member) == 0 && count(parent.extends) <= 1
  when !(allowInterfaces == "with-single-extends" && count(parent.extends) == 1) && !(allowWithName != "" && re_test(text, allowWithName))
  warn if count(parent.extends) == 1 then "An interface declaring no members is equivalent to its supertype." else empty_object_message("An empty interface declaration", "allowInterfaces")
}
in ts_type_literal rule no-empty-object-type {
  option allowInterfaces ("always" | "never" | "with-single-extends") = "never" "When to allow empty interfaces."
  option allowObjectTypes ("always" | "never") = "never" "When to allow empty object types."
  option allowWithName string = "" "Allow matching interface and type alias names."
  when allowObjectTypes != "always" && count(member) == 0 && parent != "ts_intersection"
  when !(allowWithName != "" && parent == "ts_type_alias" && re_test(parent.name, allowWithName))
  warn empty_object_message("The `{{}}` (\"empty object\") type", "allowObjectTypes")
}

# A type literal or interface that is only an index signature.
in ts_type_alias, ts_interface let indexed_type_name name.offset
in style_tree_node let indexed_type_scope if layer is (ts_type_alias, ts_interface) then indexed_type_name else if layer is (ts_index_signature, ts_property_signature, ts_parameter, ts_declarator, ts_class_property, ts_method, ts_function, ts_function_type, ts_call_signature, ts_method_signature) then null else parent.indexed_type_scope
in ts_identifier let indexed_syntax_refs [] declaration.offset
in ts_type_literal, ts_interface let indexed_syntax_refs reduce([] member.indexed_type_refs, [], (ids, child) => ids child)
in ts_type_alias, ts_index_signature, ts_mapped_type, ts_parenthesized_type let indexed_syntax_refs default(type.indexed_type_refs, [])
in ts_union, ts_intersection, ts_indexed_access, ts_conditional_type, ts_type_reference let indexed_syntax_refs reduce([] children.indexed_type_refs, [], (ids, child) => ids child)
in style_tree_node let indexed_type_refs default(indexed_syntax_refs, [])
in ts_type_alias, ts_interface let indexed_type_entry { id: name.offset, refs: indexed_type_refs }
in style_tree_node let indexed_type_entries [] indexed_type_entry reduce([] children.indexed_type_entries, [], (entries, child) => entries child)
in style_tree_node let indexed_type_graph if layer == "ts_program" then indexed_type_entries else parent.indexed_type_graph
fn expand_graph_refs(graph, ids) = unique(ids reduce(filter(graph, entry => contains(ids, entry.id)), [], (refs, entry) => refs entry.refs))
fn expanded_graph_state(previous_state, ids, target) = { ids: ids, done: ids == previous_state.ids || contains(ids, target) }
fn type_reaches(graph, ids, target) = target != null && contains(reduce(graph, { ids: ids, done: contains(ids, target) }, (state, entry) => if state.done then state else expanded_graph_state(state, expand_graph_refs(graph, state.ids), target)).ids, target)
in ts_parameter let indexed_parameter name.layer == "ts_identifier" && type != null
in ts_index_signature let indexed_signature type != null && any([] parameter.indexed_parameter, p => p == true)
in ts_type_literal, ts_interface let record_shape count(member) == 1 && first([] member.indexed_signature) == true
in ts_identifier let indexed_type_uses [] references.access
in ts_type_operator let indexed_keyof operator == "keyof"
in ts_type_parameter let indexed_key_parameter name != null && !contains(name.indexed_type_uses, "type") && constraint.indexed_keyof != true
in ts_mapped_type let record_shape type_parameter.indexed_key_parameter == true
in ts_type_literal, ts_interface, ts_mapped_type let indexed_record_eligible record_shape && !type_reaches(indexed_type_graph, if layer == "ts_mapped_type" then parent.indexed_type_refs else indexed_type_refs, indexed_type_scope)
in ts_type_literal rule consistent-indexed-object-style {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && indexed_record_eligible
  warn "A record is preferred over an index signature."
}
in ts_interface rule consistent-indexed-object-style:interface {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && indexed_record_eligible
  warn "A record is preferred over an index signature."
}
in ts_mapped_type rule consistent-indexed-object-style:mapped {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && indexed_record_eligible
  warn "A record is preferred over an index signature."
}
in ts_type_reference rule consistent-indexed-object-style:record {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "index-signature" && name == "Record" && count(type_argument) == 2
  warn "An index signature is preferred over a record."
}

in ts_type_literal let is_type_literal true
in ts_parenthesized_type let is_type_literal type.is_type_literal == true
in ts_type_alias let aliases_type_literal type.is_type_literal == true
in ts_type_alias.name rule consistent-type-definitions {
  option mode ("interface" | "type") = "interface" "Preferred object type definition."
  when mode == "interface" && parent.aliases_type_literal
  warn "Use an `interface` instead of a `type`."
}
in ts_interface.name rule consistent-type-definitions:interface {
  option mode ("interface" | "type") = "interface" "Preferred object type definition."
  when mode == "type"
  warn "Use a `type` instead of an `interface`."
}

# Only a call signature: a function type says it better.
in style_tree_node let function_this_offset if layer == "ts_type_literal" then null else if layer == "ts_type_keyword" && text == "this" then offset else first(compact(children.function_this_offset))
in ts_type_reference let function_base name == "Function"
in ts_interface let function_type_container { name: name, kind: "Interface", eligible: count(member) == 1 && (count(extends) == 0 || count(extends) == 1 && (first([] extends) == "Function" || first([] extends.function_base) == true)), this: function_this_offset }
in ts_type_literal let function_type_container { name: "", kind: "Type literal", eligible: count(member) == 1, this: null }
in ts_call_signature rule prefer-function-type {
  let container parent.function_type_container
  when return_type != null && container.eligible == true
  report at default(container.this, offset)
  warn if container.this != null then "`this` refers to the function type '" container.name "', did you intend to use a generic `this` parameter like `<Self>(this: Self, ...) => Self` instead?" else container.kind " only has a call signature, you should use a function type instead."
}

in ts_namespace rule prefer-namespace-keyword {
  when kind == "module" && is_identifier(re_replace(name, /\..*$/, ""))
  warn "Use 'namespace' instead of 'module' to declare custom TypeScript modules."
}

# ---- declarations --------------------------------------------------------------
# Annotations the initializer already states, with widening exceptions.
fn primitive_call_types(name) = get({ BigInt: ["bigint"], Boolean: ["boolean"], Number: ["number"], String: ["string"], Symbol: ["symbol"], RegExp: ["RegExp"] }, name)
in ts_number let primitive_inference ["bigint", "number"]
in ts_string let primitive_inference ["bigint", "string"]
in ts_bigint let primitive_inference ["bigint"]
in ts_boolean let primitive_inference ["bigint", "boolean"]
in ts_null let primitive_inference ["bigint", "null"]
in ts_regex let primitive_inference ["bigint", "RegExp"]
in ts_template let primitive_inference ["string"]
in ts_identifier let primitive_inference if contains(["Infinity", "NaN"], text) then ["number"] else if text == "undefined" then ["undefined"] else []
in ts_call let primitive_inference if callee.layer == "ts_identifier" then primitive_call_types(callee) else []
in ts_new let primitive_inference if callee == "RegExp" then ["RegExp"] else []
in ts_number, ts_string, ts_bigint, ts_boolean, ts_null, ts_regex, ts_template, ts_identifier, ts_call, ts_new let primitive_direct primitive_inference
in ts_unary let primitive_inference if operator == "!" then ["boolean"] else if operator == "void" then ["undefined"] else if operator == "-" then filter(argument.primitive_direct, t => contains(["bigint", "number"], t)) else if operator == "+" && contains(argument.primitive_direct, "number") then ["number"] else []
in ts_parenthesized forward primitive_inference, primitive_direct from expression
in ts_declarator, ts_class_property, ts_parameter let inferred_annotation if type != null && contains(init.primitive_inference, type) then type else null
in ts_declarator rule no-inferrable-types {
  option ignoreParameters boolean = false "Ignore parameter annotations."
  option ignoreProperties boolean = false "Ignore property annotations."
  when inferred_annotation != null
  warn "Type {inferred_annotation} trivially inferred from a {inferred_annotation} literal, remove type annotation."
}
# `readonly` (and optional) properties keep their annotation: it widens.
in ts_class_property rule no-inferrable-types:property {
  option ignoreParameters boolean = false "Ignore parameter annotations."
  option ignoreProperties boolean = false "Ignore property annotations."
  when !ignoreProperties && inferred_annotation != null && !contains([] modifier, "readonly") && optional == null
  warn "Type {inferred_annotation} trivially inferred from a {inferred_annotation} literal, remove type annotation."
}
in ts_parameter rule no-inferrable-types:parameter {
  option ignoreParameters boolean = false "Ignore parameter annotations."
  option ignoreProperties boolean = false "Ignore property annotations."
  when !ignoreParameters && inferred_annotation != null
  report at name.unparen_offset
  warn "Type {inferred_annotation} trivially inferred from a {inferred_annotation} literal, remove type annotation."
}

# `const x: Map<K, V> = new Map()`: the arguments belong on the constructor.
in ts_new let constructor_arguments if callee.layer == "ts_identifier" then { name: callee, count: count(type_argument) } else null
in ts_parenthesized forward constructor_arguments from expression
in ts_type_reference let annotation_arguments if name.layer == "ts_identifier" then { name: name, count: count(type_argument), typed_array: contains(["Float32Array", "Float64Array", "Int16Array", "Int32Array", "Int8Array", "Uint16Array", "Uint32Array", "Uint8Array", "Uint8ClampedArray"], name) && name.reference_kind == null } else null
in ts_declarator, ts_class_property, ts_parameter rule consistent-generic-constructors {
  option mode ("constructor" | "type-annotation") = "constructor" "Preferred location for generic arguments."
  when layer != "ts_parameter" || parent is (ts_function, ts_method)
  let construction init.constructor_arguments
  let annotation type.annotation_arguments
  when construction != null
  when if mode == "constructor" then annotation != null && annotation.name == construction.name && !annotation.typed_array && annotation.count > 0 && construction.count == 0 else type == null && construction.count > 0
  warn if mode == "constructor" then "The generic type arguments should be specified as part of the constructor type arguments." else "The generic type arguments should be specified as part of the type annotation."
}

# ---- classes -------------------------------------------------------------------------
fn standard_member_scopes(kind) = join(map(["static", "decorated", "instance", "abstract"], scope => join(map(filter(["public", "protected", "private", "#private"], access => !(scope == "abstract" && contains(["private", "#private"], access) || scope == "decorated" && access == "#private")), access => access "-" scope "-" kind), " ")), " ")
fn standard_member_group(kind) = if kind == "static-initialization" then kind else (if kind == "constructor" then "" else standard_member_scopes(kind) " ") join(map(filter(["public", "protected", "private", "#private"], access => kind != "constructor" || access != "#private"), access => access "-" kind), " ") " " (if kind == "constructor" then "" else join(map(["static", "instance", "abstract", "decorated"], scope => scope "-" kind), " ") " ") kind
fn standard_member_order() = split("signature call-signature " join(map(["field", "static-initialization", "constructor", "accessor", "get", "set", "method"], kind => standard_member_group(kind)), " "), " ")
schema member_order_config null | "never" | (string | string[])[] | {
  memberTypes?: "never" | (string | string[])[]
  order?: "alphabetically" | "alphabetically-case-insensitive" | "as-written" | "natural" | "natural-case-insensitive"
  optionalityOrder?: "optional-first" | "required-first"
}
group ordering_container ts_class, ts_interface, ts_type_literal
group ordering_member_node ts_method, ts_class_property, ts_method_signature, ts_property_signature, ts_call_signature, ts_index_signature, ts_static_block, ts_empty
group ordering_target ordering_container, ordering_member_node
in ordering_container let ordering_is_container true
in ts_method, ts_class_property, ts_property_signature, ts_index_signature let ordering_modifiers [] modifier
in ts_method, ts_class_property let ordering_decorated count(decorator) > 0
in ts_method let ordering_kind if parent == "ts_class" && !contains([] modifier, "static") && key.layer != "ts_computed_key" && static_name == "constructor" then "constructor" else if kind == "get" || kind == "set" then kind else "method"
in ts_method_signature let ordering_kind if kind == "get" || kind == "set" then kind else "method"
in ts_call_signature let ordering_kind if kind == "new" then "constructor" else "call-signature"
in ts_class_property let ordering_kind if contains([] modifier, "accessor") then "accessor" else if init.returned_function == true then "method" else if contains([] modifier, "readonly") then "readonly-field" else "field"
in ts_property_signature let ordering_kind if contains([] modifier, "readonly") then "readonly-field" else "field"
in ts_index_signature let ordering_kind if contains([] modifier, "readonly") then "readonly-signature" else "signature"
in ts_static_block let ordering_kind "static-initialization"
in ts_method, ts_class_property, ts_method_signature, ts_property_signature let ordering_key { text: default(static_name, default(key.member_key_text, key)), private: key.layer == "ts_private_name" }
in ts_parameter let ordering_parameter_name if name.layer == "ts_identifier" then name else null
in ts_index_signature let ordering_name default(first([] parameter.ordering_parameter_name), "(index signature)")
in ts_call_signature let ordering_name if kind == "new" then "new" else "call"
in ts_static_block let ordering_name "static block"
in ts_method, ts_method_signature, ts_class_property, ts_property_signature let ordering_name if ordering_kind == "constructor" then "constructor" else if ordering_key.private then re_replace(ordering_key.text, /^#+/, "") else ordering_key.text
in ts_method let ordering_skip body == null && !contains([] modifier, "abstract")
in ts_class_property let ordering_initialiser init != null
in ts_member let ordering_this_dependency if object.layer == "ts_this" then re_replace(property, /^#+/, "") else null
in ts_index let ordering_this_dependency if object.layer == "ts_this" then index.static_string else null
in style_tree_node let ordering_dependencies if layer is (ts_function, ts_arrow, ts_method, ts_class) then [] else unique([] ordering_this_dependency reduce([] children.ordering_dependencies, [], (names, child) => names child))
in ts_class_property let ordering_initialiser_dependencies default(init.ordering_dependencies, [])
fn ordering_specific_groups(kind, access, scope, decorated) = (
  (if decorated && contains(["readonly-field", "field", "method", "accessor", "get", "set"], kind) then [access "-decorated-" kind, "decorated-" kind] (if kind == "readonly-field" then [access "-decorated-field", "decorated-field"] else []) else [])
  (if !contains(["readonly-signature", "signature", "static-initialization"], kind) then
    (if kind != "constructor" then [access "-" scope "-" kind, scope "-" kind] (if kind == "readonly-field" then [access "-" scope "-field", scope "-field"] else []) else [])
    [access "-" kind] (if kind == "readonly-field" then [access "-field"] else [])
  else []))
fn ordering_member_groups(kind, xs, private_key, decorated, class_member) = (
  (if class_member then ordering_specific_groups(kind, default(first(filter(["public", "protected", "private"], access => contains(xs, access))), if private_key then "#private" else "public"), if contains(xs, "static") then "static" else if contains(xs, "abstract") then "abstract" else "instance", decorated) else [])
  [kind] (if kind == "readonly-field" then ["field"] else if kind == "readonly-signature" then ["signature"] else [])
)
in ts_method, ts_class_property, ts_method_signature, ts_property_signature let ordering_optional_member optional != null
in ordering_member_node let ordering_member { index: index, name: default(ordering_name, ""), optional: ordering_optional_member == true, groups: ordering_member_groups(default(ordering_kind, ""), default(ordering_modifiers, []), ordering_key.private == true, ordering_decorated == true, parent == "ts_class"), skip: ordering_skip == true, init: ordering_initialiser == true, dependencies: default(ordering_initialiser_dependencies, []) }
in ordering_container let ordering_members [] member.ordering_member
in ordering_container let ordering_owner { layer: layer, expression: parent not (ts_program, ts_block, ts_export, ts_namespace), members: ordering_members }
fn ordering_optional(rows, mode, changed) = if !contains(["optional-first", "required-first"], mode) || changed == null then { split: null, bad: null } else { split: changed.index, bad: if first(rows).optional != (mode == "optional-first") then first(rows).index else if any(rows, row => row.index > changed.index && row.optional != changed.optional) then changed.index else null }
fn ordering_rank(row, types) = if row.skip || types == null then null else first(compact(map(row.groups, group_name => if any(types, group => contains(group, group_name)) then index_of(types, find(types, group => contains(group, group_name))) else null)))
fn ordering_group_state(before_state, rank, bad) = if rank == null then before_state else { ranks: if bad || last(before_state.ranks) == rank then before_state.ranks else before_state.ranks [rank], bad: before_state.bad || bad }
fn ordering_group_next(before_state, rank) = ordering_group_state(before_state, rank, rank != null && last(before_state.ranks) != null && rank < last(before_state.ranks))
fn ordering_fallback_group(before_state, at, rank, has_next, next_rank) = if has_next && (before_state.started && rank == before_state.rank || rank == next_rank) then if before_state.started && rank == before_state.rank then before_state.group else at else null
fn ordering_fallback_next(before_state, at, rank, has_next, next_rank) = if ordering_fallback_group(before_state, at, rank, has_next, next_rank) == null then before_state else { started: true, rank: rank, group: ordering_fallback_group(before_state, at, rank, has_next, next_rank) }
fn ordering_in_route(row, route) = if route.fallback then row.fallback == route.group else row.partition == route.partition && (route.rank == null || row.rank == route.rank)
fn ordering_alpha_bad(name, previous_name, order) = name != "" && name != previous_name && (if re_test(order, /^natural/) then compare_text(name, previous_name, true, re_test(order, /case-insensitive$/)) <= 0 else compare_text(name, previous_name, false, re_test(order, /case-insensitive$/)) < 0)
fn ordering_alpha_result(row, route, previous_state, bad, blocked) = { route: route, name: row.name, index: row.index, previous: previous_state.name, bad: bad && !blocked, accept: row.name != "" && !blocked }
fn ordering_alpha_check(row, route, previous_state, rows, order) = ordering_alpha_result(row, route, previous_state, ordering_alpha_bad(row.name, previous_state.name, order), ordering_alpha_bad(row.name, previous_state.name, order) && row.init && any(rows, earlier => earlier.index >= previous_state.index && earlier.index < row.index && ordering_in_route(earlier, route) && earlier.init && contains(row.dependencies, earlier.name)))
fn ordering_alpha_state(states, result) = if !result.accept then states else filter(states, state => state.id != result.route.id) [{ id: result.route.id, name: result.name, index: result.index }]
fn ordering_alpha_next(row, routes, states, rows, order) = reduce(map(routes, route => ordering_alpha_check(row, route, default(find(states, state => state.id == route.id), { name: "", index: 0 }), rows, order)), states, (current_states, result) => ordering_alpha_state(current_states, result))
fn ordering_alpha_messages(results) = reduce(filter(results, result => result.bad), [], (messages, result) => messages map(slice([0, 1], 0, result.route.copies), ignored => "Member " result.name " should be declared before member " result.previous "."))
in ordering_target rule member-ordering {
  option default member_order_config = null "Default ordering; null uses the standard member groups."
  option classes member_order_config = null "Class declaration ordering."
  option classExpressions member_order_config = null "Class expression ordering."
  option interfaces member_order_config = null "Interface ordering."
  option typeLiterals member_order_config = null "Type literal ordering."
  let standard_types standard_member_order()
  let owner if ordering_is_container == true then ordering_owner else parent.ordering_owner
  let specific_order if owner.layer == "ts_interface" then interfaces else if owner.layer == "ts_type_literal" then typeLiterals else if owner.expression then classExpressions else classes
  let selected_order if specific_order != null then specific_order else default
  let ordering_config if selected_order == null then { memberTypes: standard_types } else selected_order
  let ordering_types if type_of(ordering_config) == "list" then ordering_config else if ordering_config.memberTypes != null then ordering_config.memberTypes else if specific_order == null then standard_types else null
  let settings { enabled: selected_order != "never", types: if type_of(ordering_types) == "list" then map(ordering_types, group => if type_of(group) == "list" then group else [group]) else null, order: ordering_config.order, optionality: ordering_config.optionalityOrder }
  let optionality ordering_optional(owner.members, settings.optionality, find(owner.members, row => row.optional != first(owner.members).optional))
  let rank ordering_rank(ordering_member, settings.types)
  let partition if optionality.split != null && optionality.bad == null && ordering_member.index >= optionality.split then 1 else 0
  let group_state ordering_group_next(if previous.partition == partition then default(previous.group_state, { ranks: [], bad: false }) else { ranks: [], bad: false }, rank)
  let before_group if previous.partition == partition then default(previous.group_state, { ranks: [], bad: false }) else { ranks: [], bad: false }
  let group_bad rank != null && last(before_group.ranks) != null && rank < last(before_group.ranks)
  let group_status if ordering_member == null then null else { partition: partition, bad: group_bad }
  let group_statuses [] children.group_status
  let bad_partitions unique(map(filter(if ordering_is_container == true then group_statuses else parent.group_statuses, status => status.bad), status => status.partition))
  # Upstream fallback omits the final member and retains its last selected rank across gaps.
  let fallback_state ordering_fallback_next(default(previous.fallback_state, { started: false, rank: null, group: null }), ordering_member.index, rank, next.ordering_member != null, next.rank)
  let before_fallback default(previous.fallback_state, { started: false, rank: null, group: null })
  let fallback if next.ordering_member != null && (before_fallback.started && rank == before_fallback.rank || rank == next.rank) then if before_fallback.started && rank == before_fallback.rank then before_fallback.group else ordering_member.index else null
  let order_row if ordering_member == null then null else { index: ordering_member.index, name: ordering_member.name, init: ordering_member.init, dependencies: ordering_member.dependencies, rank: rank, partition: partition, fallback: fallback }
  let container_rows [] children.order_row
  let rows if ordering_is_container == true then container_rows else parent.container_rows
  let alpha_enabled contains(["alphabetically", "alphabetically-case-insensitive", "natural", "natural-case-insensitive"], settings.order)
  let alpha_routes (
    (if alpha_enabled && (settings.types == null || rank != null && !contains(bad_partitions, partition)) then [{ id: ["normal", partition, rank], fallback: false, group: null, partition: partition, rank: rank, copies: 1 }] else [])
    (if alpha_enabled && settings.types != null && count(bad_partitions) > 0 && fallback != null then [{ id: ["fallback", fallback], fallback: true, group: fallback, partition: null, rank: null, copies: count(bad_partitions) }] else []))
  let alpha_states ordering_alpha_next(order_row, alpha_routes, default(previous.alpha_states, []), rows, settings.order)
  let alpha_before default(previous.alpha_states, [])
  let alpha_results map(alpha_routes, route => ordering_alpha_check(order_row, route, default(find(alpha_before, state => state.id == route.id), { name: "", index: 0 }), rows, settings.order))
  let higher_rank min(filter(before_group.ranks, prior_rank => prior_rank > rank))
  let group_label join(map(first(slice(settings.types, higher_rank, higher_rank + 1)), name => re_replace(name, /-/, " ")), ", ")
  when ordering_member != null && parent is ordering_container && settings.enabled
  let messages if optionality.bad != null then if ordering_member.index == optionality.bad then ["Member " ordering_member.name " should be declared after all " (if settings.optionality == "optional-first" then "optional" else "required") " members."] else [] else (if group_bad then ["Member " ordering_member.name " should be declared before all " group_label " definitions."] else []) ordering_alpha_messages(alpha_results)
  each message in messages
  warn message
}

fn member_display_name(name, layer) = if name != "" && contains(["ts_string", "ts_number", "ts_bigint", "ts_boolean", "ts_null"], layer) && !re_test(name, /^[\p{Alphabetic}_$][\p{Alphabetic}\p{Number}_$]*$/) then '"' name '"' else name
fn public_modifier_offset(xs, positions, head) = if contains(xs, "public") then first(slice(positions, index_of(xs, "public"), index_of(xs, "public") + 1)) else head
in ts_decorator let after_decorator space_after.end
in ts_computed_key {
  let member_key_layer expression.layer
  let member_key_text expression
  let member_key_offset expression.offset
}
in ts_method, ts_class_property, ts_method_signature let style_member_name member_display_name(default(static_name, default(key.member_key_text, key)), default(key.member_key_layer, key.layer))
in ts_parameter let style_member_name member_display_name(name, name.layer)
in ts_method, ts_class_property let style_key_offset default(key.member_key_offset, key.offset)
in ts_parameter let style_key_offset name.offset
in ts_method, ts_class_property, ts_parameter let style_head_offset default(last([] decorator.after_decorator), offset)
in ts_method, ts_class_property, ts_parameter let style_member { name: style_member_name, head: style_head_offset, public: public_modifier_offset([] modifier, [] modifier.offset, style_head_offset), key: style_key_offset }
in ts_class_property rule explicit-member-accessibility:property {
  option accessibility ("explicit" | "no-public" | "off") = "explicit" "Required accessibility."
  option ignoredMethodNames string[] = [] "Ignored method names."
  option overrides { properties?: string; methods?: string; accessors?: string; constructors?: string; parameterProperties?: string } = {} "Requirements by member kind."
  let check default(overrides.properties, accessibility)
  let shape style_member
  when !re_test(key, /^#/) && (check == "explicit" && !has_accessibility(modifiers) || check == "no-public" && contains([] modifier, "public"))
  report at if check == "no-public" then shape.public else shape.head
  warn "{if check == 'no-public' then 'Public' else 'Missing'} accessibility modifier on class property {shape.name}."
}
in ts_method rule explicit-member-accessibility:method {
  option accessibility ("explicit" | "no-public" | "off") = "explicit" "Required accessibility."
  option ignoredMethodNames string[] = [] "Ignored method names."
  option overrides { properties?: string; methods?: string; accessors?: string; constructors?: string; parameterProperties?: string } = {} "Requirements by member kind."
  let check default(if key == "constructor" then overrides.constructors else if kind == "get" || kind == "set" then overrides.accessors else overrides.methods, accessibility)
  let shape style_member
  when parent == "ts_class" && !re_test(key, /^#/) && !contains(ignoredMethodNames, shape.name)
  when check == "explicit" && !has_accessibility(modifiers) || check == "no-public" && contains([] modifier, "public")
  report at if check == "no-public" then shape.public else shape.head
  warn "{if check == 'no-public' then 'Public' else 'Missing'} accessibility modifier on {if kind == 'get' then 'get property accessor' else if kind == 'set' then 'set property accessor' else 'method definition'} {shape.name}."
}
in ts_parameter rule explicit-member-accessibility:parameter {
  option accessibility ("explicit" | "no-public" | "off") = "explicit" "Required accessibility."
  option ignoredMethodNames string[] = [] "Ignored method names."
  option overrides { properties?: string; methods?: string; accessors?: string; constructors?: string; parameterProperties?: string } = {} "Requirements by member kind."
  let check default(overrides.parameterProperties, accessibility)
  let shape style_member
  when contains([] modifier, "readonly") && parent == "ts_method"
  when check == "explicit" && !has_accessibility(modifiers) || check == "no-public" && contains([] modifier, "public")
  report at if check == "no-public" then shape.public else shape.head
  warn "{if check == 'no-public' then 'Public' else 'Missing'} accessibility modifier on parameter property {shape.name}."
}

# Getters that return a literal: a readonly field says it better.
in ts_number, ts_bigint, ts_string, ts_regex, ts_null, ts_boolean let member_literal true
in ts_template let member_literal count(expression) == 0
in ts_tagged_template let member_literal quasi.member_literal
in ts_parenthesized let member_literal expression.member_literal
in ts_return let returned_member_literal argument.member_literal == true
in ts_block let first_member_literal first([] body.returned_member_literal) == true && first([] body.layer) == "ts_return"
in ts_computed_key let member_static_name expression.static_string
in ts_method, ts_class_property let member_static_name default(static_name, key.member_static_name)
in ts_method let setter_member_name if kind == "set" then member_static_name else null
in ts_member, ts_index let written_this_member if object.layer == "ts_this" && write_site != null then static_name else null
in style_tree_node let constructor_write_names if layer is (ts_function, ts_arrow, ts_method, ts_class) then [] else [] written_this_member reduce([] children.constructor_write_names, [], (names, child) => names child)
in ts_method let constructor_member_writes if key == "constructor" then body.constructor_write_names else []
in ts_class let constructor_member_writes reduce([] member.constructor_member_writes, [], (names, child) => names child)
in ts_class let setter_member_names [] member.setter_member_name
in ts_method let literal_member_candidate kind == "get" && !contains([] modifier, "override") && body.first_member_literal && (member_static_name == null || !contains(parent.setter_member_names, member_static_name))
in ts_class_property let literal_member_candidate contains([] modifier, "readonly") && !contains([] modifier, "declare") && !contains([] modifier, "override") && init.member_literal == true && (member_static_name == null || !contains(parent.constructor_member_writes, member_static_name))
in ts_method.key rule class-literal-property-style {
  option mode ("fields" | "getters") = "fields" "Preferred literal member declaration."
  when mode == "fields" && parent.literal_member_candidate
  let shape parent.style_member
  report at shape.key
  warn "Literals should be exposed using readonly fields."
}
in ts_class_property.key rule class-literal-property-style:getters {
  option mode ("fields" | "getters") = "fields" "Preferred literal member declaration."
  when mode == "getters" && parent.literal_member_candidate
  let shape parent.style_member
  report at shape.key
  warn "Literals should be exposed using getters."
}

in ts_parameter let is_parameter_property re_test(modifiers, /\b(?:public|private|protected|readonly)\b/)
in ts_method, ts_class_property let is_static contains([] modifier, "static")
in ts_method let constructor_parameter_properties any([] parameter.is_parameter_property, p => p == true)
in ts_method let class_constructor_only key == "constructor" && !constructor_parameter_properties
in ts_class_property, ts_index_signature, ts_static_block, ts_empty let class_constructor_only false
in ts_method let class_static_only if key == "constructor" then !constructor_parameter_properties else is_static && !contains([] modifier, "abstract")
in ts_class_property let class_static_only is_static && !contains([] modifier, "abstract")
in ts_index_signature let class_static_only false
in ts_static_block, ts_empty let class_static_only true
in ts_class let class_shape if count(member) == 0 then "empty" else if all([] member.class_constructor_only, m => m == true) then "constructor" else if all([] member.class_static_only, m => type_of(m) == "null" || m == true) then "static" else null
in ts_class rule no-extraneous-class {
  option allowConstructorOnly boolean = false "Allow constructor-only classes."
  option allowEmpty boolean = false "Allow empty classes."
  option allowStaticOnly boolean = false "Allow static-only classes."
  option allowWithDecorator boolean = false "Allow decorated classes."
  let shape class_shape
  when extends == null && !(allowWithDecorator && count(decorator) > 0) && shape != null
  when !(shape == "empty" && allowEmpty || shape == "constructor" && allowConstructorOnly || shape == "static" && allowStaticOnly)
  report at if name != null && re_test(parent, /^ts_(program|export|block|namespace)$/) then name.unparen_offset else offset
  warn if shape == "empty" then "Unexpected empty class." else if shape == "constructor" then "Unexpected class with only a constructor." else "Unexpected class with only static properties."
}

# Constructors that do nothing a missing one would not.
in ts_parameter let parameter_name re_replace(name, /\s+/, "")
in ts_method rule no-useless-constructor {
  # A public constructor of a derived class may widen a protected one.
  when key == "constructor" && body != null && count(decorator) == 0 && !re_test(modifiers, /\b(?:private|protected)\b/)
  when !(ts_class.extends != null && re_test(modifiers, /\bpublic\b/))
  when !any(compact([] parameter.is_parameter_property)) && !re_test(join([] parameter, ","), /[=@{\[?]/)
  when if ts_class.extends == null then re_test(body, /^\{\s*\}$/) else re_test(re_replace(body, /\s+/, ""), "^\\x7Bsuper\\((?:\\.\\.\\.arguments|" re_escape(join([] parameter.parameter_name, ",")) ")\\);?\\x7D$")
  warn "Useless constructor."
}

fn signature_key_shape(layer, name) = if layer == "ts_private_name" then "private" else if contains(["ts_identifier", "ts_string", "ts_number", "ts_bigint", "ts_boolean", "ts_null"], layer) then (if starts_with(name, '"') then "quoted" else "normal") else "expression"
in ts_function let overload_identity if name != null then { name: name, shape: "normal", static: null, call: false } else null
in ts_method, ts_method_signature let overload_identity { name: style_member_name, shape: signature_key_shape(default(key.member_key_layer, key.layer), style_member_name), static: if layer == "ts_method" then is_static else null, call: false }
in ts_call_signature let overload_identity { name: if kind == "new" then "new" else "call", shape: "normal", static: null, call: kind != "new" }
in ts_export forward overload_identity from declaration
in ts_function, ts_method, ts_method_signature, ts_call_signature, ts_export let overload_entry { identity: overload_identity, start: offset }
in ts_program, ts_block, ts_class, ts_interface, ts_type_literal let overload_entries [] children.overload_entry
fn earlier_overload(entries, identity, start) = any(entries, e => e.start < start && e.identity == identity)
in ts_function, ts_method, ts_method_signature, ts_call_signature, ts_export rule adjacent-overload-signatures {
  when parent is (ts_program, ts_block, ts_class, ts_interface, ts_type_literal)
  when overload_identity != null && overload_identity != previous.overload_identity
  when earlier_overload(parent.overload_entries, overload_identity, offset)
  let identity overload_identity
  warn "All {if identity.static == true then 'static ' else ''}{identity.name} signatures should be adjacent."
}

# `new (): I` in interface `I` (type arguments aside), and `constructor()`
# signatures in interfaces and type literals.
in ts_call_signature rule no-misused-new {
  when parent == "ts_interface" && kind == "new" && re_replace(default(return_type, ""), /\s*<[\s\S]*$/, "") == ts_interface.name
  warn "Interfaces cannot be constructed, only classes."
}
in ts_method_signature rule no-misused-new:constructor {
  when key == "constructor"
  warn "Interfaces cannot be constructed, only classes."
}
in ts_method rule no-misused-new:class {
  when key == "new" && body == null && return_type == ts_class.name
  warn "Class cannot have method named `new`."
}

# ---- functions -----------------------------------------------------------------------
in ts_parenthesized_type let unified_inner_type type.unified_bare_type
in ts_parenthesized let unified_inner_type expression.unified_bare_type
in style_tree_node let unified_bare_type default(unified_inner_type, text)
in ts_identifier, ts_this let unified_parameter_name text
in ts_rest let unified_parameter_name argument.unified_parameter_name
in ts_parameter let unified_parameter { index: index, offset: offset, line: line, name: name.unified_parameter_name, rest: name.layer == "ts_rest", optional: optional != null, type: type.unified_bare_type, raw_type: type, union: default(type.unified_union_members, []) }
in ts_type_parameter let unified_type_parameter { name: name, constraint: constraint.unified_bare_type }
in ts_type_parameter let unified_type_name name
in ts_type_reference let unified_outer_type name
in ts_array_type, ts_parenthesized_type let unified_outer_type type.unified_outer_type
in ts_parameter let unified_outer_type type.unified_outer_type
in ts_union let unified_union_children reduce([] type.unified_union_members, [], (members, child) => members child)
in ts_parenthesized_type let unified_union_children type.unified_union_members
in ts_parenthesized let unified_union_children expression.unified_union_members
in style_tree_node let unified_union_members default(unified_union_children, [{ text: text, wrap: layer is (ts_function_type, ts_conditional_type) }])
fn unified_union(members) = join(map(reduce(members, [], (unique_members, member) => if any(unique_members, previous_member => previous_member.text == member.text) then unique_members else unique_members [member]), member => if member.wrap then "(" member.text ")" else member.text), " | ")
fn unified_doc(prefix) = if re_test(prefix, /\/\*[\s\S]*?\*\/[ \t\r\n]*(?:\/\/[^\n]*(?:\n|$)[ \t\r\n]*)*$/) then re_replace(prefix, /[\s\S]*\/\*([\s\S]*?)\*\/[ \t\r\n]*(?:\/\/[^\n]*(?:\n|$)[ \t\r\n]*)*$/, "$1") else null
in ts_export let unified_doc unified_doc(text_before)
in style_tree_node let unified_after_line line + count(split(text, "\n")) - 1 + count(split(default(space_after.text, ""), "\n")) - 1
in style_tree_node let unified_next_offset space_after.end
in ts_method let unified_head { offset: key.unified_next_offset, line: key.unified_after_line }
in ts_function let unified_key if body == null then default(name, "default") else null
in ts_method let unified_key if body == null && kind != "get" && kind != "set" && key != null then { layer: key.layer, name: key, static: contains([] modifier, "static") } else null
in ts_method_signature let unified_key if kind != "get" && kind != "set" && key != null then { layer: key.layer, name: key, static: false } else null
in ts_call_signature let unified_key default(kind, "call")
in ts_function, ts_method, ts_method_signature, ts_call_signature let unified_signature if unified_key == null then null else { key: unified_key, offset: offset, head: default(unified_head, { offset: offset, line: line }), parameters: [] parameter.unified_parameter, types: [] type_parameter.unified_type_parameter, result: return_type.unified_bare_type, outer: [] parameter.unified_outer_type, doc: if parent == "ts_export" then parent.unified_doc else unified_doc(text_before) }
in ts_export let unified_signature declaration.unified_signature
in ts_program, ts_block, ts_class, ts_interface, ts_type_literal let unified_signatures [] children.unified_signature
in ts_export let unified_signatures parent.unified_signatures
in ts_program, ts_class, ts_interface, ts_type_literal let unified_scope true
in ts_block let unified_scope parent == "ts_namespace"
in ts_export let unified_scope parent.unified_scope
in ts_class, ts_interface let unified_outer_names [] type_parameter.unified_type_name
in ts_program, ts_block, ts_type_literal let unified_outer_names []
in ts_export let unified_outer_names parent.unified_outer_names
fn unified_parameter_at(signature, at) = first(slice(signature.parameters, at, at + 1))
fn unified_sigils(a, b) = a.rest == b.rest && a.optional == b.optional
fn unified_difference(a, b) = if unified_sigils(a, b) && !a.rest then { offset: b.offset, other_line: a.line, ending: " taking `" unified_union(a.union b.union) "`." } else null
fn unified_equal_length(a, b, differences) = if count(differences) == 0 then { offset: b.head.offset, other_line: a.head.line, ending: " with identical parameters." } else if count(differences) == 1 then unified_difference(first(differences), unified_parameter_at(b, first(differences).index)) else null
fn unified_shorter(short, long) = if last(short.parameters).rest == true || !all(short.parameters, p => p.type == unified_parameter_at(long, p.index).type) || !all(slice(long.parameters, count(short.parameters) + 1, count(long.parameters)), p => p.optional || p.rest) then null else { offset: last(long.parameters).offset, other_line: short.head.line, ending: " with " (if last(long.parameters).rest then "a rest" else "an optional") " parameter." }
fn unified_parameter_difference(a, b) = if count(a.parameters) == count(b.parameters) then unified_equal_length(a, b, filter(a.parameters, p => !unified_sigils(p, unified_parameter_at(b, p.index)) || p.type != unified_parameter_at(b, p.index).type)) else if (first(a.parameters).name == "this") != (first(b.parameters).name == "this") then null else if count(a.parameters) < count(b.parameters) then unified_shorter(a, b) else unified_shorter(b, a)
fn unified_comparison(a, b, outer_names) = if a.result != b.result || any(a.outer, name => contains(outer_names, name)) != any(b.outer, name => contains(outer_names, name)) || a.types != b.types || first(a.parameters).name == "this" && first(a.parameters).raw_type == "void" || first(b.parameters).name == "this" && first(b.parameters).raw_type == "void" then null else unified_parameter_difference(a, b)
fn unified_names(a, b) = all(slice(a.parameters, 0, count(b.parameters)), p => p.rest != unified_parameter_at(b, p.index).rest || p.name == unified_parameter_at(b, p.index).name)
fn unified_pair(a, b, outer_names, group_count) = { difference: unified_comparison(a, b, outer_names), names: unified_names(a, b), docs: a.doc == b.doc, count: group_count }
group unified_signature_node ts_function, ts_method, ts_method_signature, ts_call_signature
in unified_signature_node rule unified-signatures {
  option ignoreDifferentlyNamedParameters boolean = false "Ignore overloads with different parameter names."
  option ignoreOverloadsWithDifferentJSDoc boolean = false "Ignore overloads with different block comments."
  let signature unified_signature
  when signature != null && parent.unified_scope == true
  let group filter(parent.unified_signatures, candidate => candidate.key == signature.key)
  let pairs map(filter(group, candidate => candidate.offset > signature.offset), candidate => unified_pair(signature, candidate, parent.unified_outer_names, count(group)))
  each pair in filter(pairs, p => p.difference != null && (!ignoreDifferentlyNamedParameters || p.names) && (!ignoreOverloadsWithDifferentJSDoc || p.docs))
  report at pair.difference.offset
  warn "{if pair.count == 2 then 'These overloads' else 'This overload and the one on line ' pair.difference.other_line} can be combined into one signature{pair.difference.ending}"
}

in ts_as, ts_type_assertion, ts_jsx_expression, ts_jsx_spread_attribute, ts_new let return_accepts_value "all"
in ts_declarator, ts_class_property let return_accepts_value if type != null then "all" else ""
in ts_parameter let return_accepts_value if type != null then "init" else ""
in style_tree_node let return_parent_typed if parent == "ts_parenthesized" then parent.return_parent_typed else parent.return_accepts_value == "all" || parent.return_accepts_value == "init" && field == "init" || parent == "ts_call" && field != "callee"
in ts_declarator let return_context_name if name.layer == "ts_identifier" then name else ""
in ts_class_property, ts_property let return_context_name if key.layer == "ts_identifier" then key else ""
in ts_class_property let return_context_head style_head_offset
in ts_property let return_context_head offset
in style_tree_node let return_parent_info if parent == "ts_parenthesized" then parent.return_parent_info else { layer: parent, name: parent.return_context_name, head: parent.return_context_head }
in ts_function let return_own_name name
in ts_method let return_own_name if key.layer == "ts_identifier" then key else ""
in ts_function, ts_arrow, ts_method let return_annotation return_type != null
in ts_declarator, ts_class_property let return_annotation type != null
in style_tree_node let return_ancestor_context if layer is (ts_declarator, ts_class_property) then return_annotation else if layer == "ts_expression_statement" then false else return_annotation == true || parent.return_ancestor_context
in ts_arrow let return_concise body.layer != "ts_block"
in style_tree_node let return_ancestor_typed if parent == "ts_parenthesized" then parent.return_ancestor_typed else (parent == "ts_return" || parent == "ts_arrow" && field == "body" && parent.return_concise) && parent.return_ancestor_context == true
in ts_property, ts_method let return_object_typed parent == "ts_object" && parent.return_value_typed
in style_tree_node let return_property_typed if parent == "ts_parenthesized" then parent.return_property_typed else parent.return_object_typed == true
in style_tree_node let return_value_typed if parent == "ts_parenthesized" then parent.return_value_typed else return_parent_typed || return_property_typed || parent == "ts_array" && parent.return_value_typed || parent == "ts_return" && return_ancestor_typed
in ts_function, ts_arrow let returned_function true
in ts_parenthesized let returned_function expression.returned_function
in ts_as, ts_type_assertion let returned_const_assertion type == "const"
in ts_satisfies, ts_parenthesized let returned_const_assertion expression.returned_const_assertion
in ts_unary let returned_void operator == "void"
in ts_parenthesized let returned_void expression.returned_void
in ts_return let return_value { value: argument.node, function: argument.returned_function == true }
in style_tree_node let function_return_values if layer == "ts_return" then [return_value] else if layer is (ts_function, ts_arrow, ts_method, ts_class) then [] else reduce([] children.function_return_values, [], (values, child) => values child)
in ts_method let return_method_valid key == "constructor" || kind == "set"
in ts_arrow let return_arrow_head operator.offset
in ts_function, ts_arrow, ts_method let return_declaration layer == "ts_function" && contains(["ts_program", "ts_block", "ts_export", "ts_namespace"], return_parent_info.layer)
in ts_function, ts_arrow, ts_method let return_context_typed !return_declaration && (return_parent_typed || return_property_typed) || layer == "ts_method" && return_object_typed
in ts_function, ts_arrow, ts_method let explicit_return_shape {
  name: default(return_own_name, default(return_parent_info.name, "")),
  offset: if layer == "ts_method" then style_head_offset else default(return_parent_info.head, default(return_arrow_head, offset)),
  valid: return_annotation || return_method_valid == true,
  typed: return_context_typed || !return_declaration && return_ancestor_typed,
  context_typed: return_context_typed,
  ancestor_typed: !return_declaration && return_ancestor_typed,
  free_expression: !return_declaration && return_parent_info.layer != null && !contains(["ts_declarator", "ts_class_property", "ts_export", "ts_class"], return_parent_info.layer),
  higher_order: layer == "ts_arrow" && body.returned_function == true || count(body.function_return_values) > 0 && all(body.function_return_values, value => value.function),
  const_assertion: layer == "ts_arrow" && body.returned_const_assertion == true,
  iife: return_parent_info.layer == "ts_call",
  void_arrow: layer == "ts_arrow" && body.returned_void == true
}

macro explicit_return_rule(rule-id, return_context) {
  in return_context rule rule-id {
    option allowConciseArrowFunctionExpressionsStartingWithVoid boolean = false "Allow concise arrows starting with void."
    option allowDirectConstAssertionInArrowFunctions boolean = true "Allow concise arrows returning const assertions."
    option allowedNames string[] = [] "Allowed function and member names."
    option allowExpressions boolean = false "Allow function expressions outside declarations."
    option allowFunctionsWithoutTypeParameters boolean = false "Allow nongeneric functions."
    option allowHigherOrderFunctions boolean = true "Allow functions returning only functions."
    option allowIIFEs boolean = false "Allow functions directly within calls."
    option allowTypedFunctionExpressions boolean = true "Allow contextually typed function expressions."
    let shape explicit_return_shape
    when !shape.valid && !contains(allowedNames, shape.name)
    when !(allowFunctionsWithoutTypeParameters && count(type_parameter) == 0 || allowIIFEs && shape.iife || allowHigherOrderFunctions && shape.higher_order || allowConciseArrowFunctionExpressionsStartingWithVoid && shape.void_arrow)
    when !(allowTypedFunctionExpressions && (shape.typed || allowExpressions && shape.free_expression || allowDirectConstAssertionInArrowFunctions && shape.const_assertion))
    report at shape.offset
    warn "Missing return type on function."
  }
}
explicit_return_rule(explicit-function-return-type, ts_function)
explicit_return_rule(explicit-function-return-type:method, ts_method)
explicit_return_rule(explicit-function-return-type:arrow, ts_arrow)

# explicit-module-boundary-types: what other modules see needs types.
group style_boundary_export ts_export, ts_export_assignment
in ts_class_property, ts_method let boundary_private contains([] modifier, "private") || key.layer == "ts_private_name"
in ts_function, ts_arrow, ts_method let boundary_returned_functions if layer == "ts_arrow" && body.layer != "ts_block" then if body.returned_function == true then [] body.node else [] else if count(body.function_return_values) > 0 && all(body.function_return_values, value => value.function) then map(body.function_return_values, value => value.value) else []
in ts_assignment let boundary_written_value right.node
in ts_identifier let boundary_binding_owner parent.node
in ts_identifier let boundary_identifier_refs if reference_kind != null && !contains(["parameter", "catch", "import"], reference_kind) then [] declaration.boundary_binding_owner [] declaration.references.writer.boundary_written_value else []
in ts_class let boundary_structural_refs [] member.node
in ts_object let boundary_structural_refs [] property.node
in ts_array let boundary_structural_refs [] element.node
in ts_variable_declaration let boundary_structural_refs [] declaration.node
in ts_declarator let boundary_structural_refs [] init.node
in ts_class_property let boundary_structural_refs if boundary_private then [] else [] init.node
in ts_property let boundary_structural_refs if value != null then [] value.node else if key.layer == "ts_identifier" then [] key.node else []
in ts_parenthesized let boundary_structural_refs [] expression.node
in ts_function, ts_arrow, ts_method let boundary_structural_refs if boundary_private == true then [] else boundary_returned_functions
in style_tree_node let boundary_next default(boundary_structural_refs, default(boundary_identifier_refs, []))
in ts_export_specifier let boundary_export_value local.node
in ts_export let boundary_export_roots if from == null then [] declaration.node [] expression.node [] specifier.boundary_export_value else []
in ts_export_assignment let boundary_export_roots [] expression.node
in ts_program let boundary_roots reduce(descendants(style_boundary_export), [], (roots, n) => roots n.boundary_export_roots)
in ts_program let boundary_export_nodes walk(boundary_roots, n => n.boundary_next)
in ts_declarator let boundary_context_name if name.layer == "ts_identifier" then name else ""
in ts_class_property let boundary_context_name default(member_static_name, "")
in style_tree_node let boundary_parent_name if parent == "ts_parenthesized" then parent.boundary_parent_name else parent.boundary_context_name
in ts_function let boundary_function_name if return_declaration then default(name, "") else default(boundary_parent_name, "")
in ts_arrow let boundary_function_name default(boundary_parent_name, "")
in ts_method let boundary_function_name default(member_static_name, "")
in ts_function, ts_method let boundary_overload_entry { name: boundary_function_name, empty: body == null, exported: parent == "ts_export", default: parent.boundary_default_export == true }
in ts_export let boundary_default_export kind == "default"
in ts_export let boundary_overload_entry declaration.boundary_overload_entry
in style_tree_node let boundary_overload_entries if layer == "ts_export" then parent.boundary_overload_entries else [] children.boundary_overload_entry
in ts_function, ts_arrow, ts_method let boundary_has_overload any(parent.boundary_overload_entries, entry => entry.empty && (parent == "ts_export" && entry.exported && entry.default == parent.boundary_default_export && (entry.default || entry.name == boundary_function_name) || parent != "ts_export" && !entry.exported && entry.name == boundary_function_name))
in ts_method let boundary_empty_method body == null
in ts_method let boundary_empty_offset key.unified_next_offset
in ts_class_property let boundary_accessor contains([] modifier, "accessor")
in ts_function, ts_arrow, ts_method let boundary_offset if boundary_empty_method == true then boundary_empty_offset else if parent.boundary_accessor == true then default(return_arrow_head, offset) else explicit_return_shape.offset
in ts_function, ts_arrow, ts_method let boundary_function_reachable boundary_private != true && contains(ts_program.boundary_export_nodes, node)
in ts_parameter let boundary_argument {
  eligible: init == null && (type == null || type == "any"),
  any: type == "any",
  offset: name.offset,
  name: name.unified_parameter_name,
  pattern: if name.layer == "ts_rest" then "Rest" else if name.layer == "ts_array_pattern" then "Array pattern" else "Object pattern"
}
macro boundary_rule(rule-id, boundary_context, parameter_check) {
  in boundary_context rule rule-id {
    option allowArgumentsExplicitlyTypedAsAny boolean = false "Allow explicit any parameter types."
    option allowDirectConstAssertionInArrowFunctions boolean = true "Allow concise arrows returning const assertions."
    option allowedNames string[] = [] "Allowed function and member names."
    option allowHigherOrderFunctions boolean = true "Allow functions returning only functions."
    option allowTypedFunctionExpressions boolean = true "Allow contextually typed functions."
    option allowOverloadFunctions boolean = false "Allow implementations with overload signatures."
    let boundary_shape if parameter_check then parent.explicit_return_shape else explicit_return_shape
    let boundary_name if parameter_check then parent.boundary_function_name else boundary_function_name
    let empty_method if parameter_check then parent.boundary_empty_method else boundary_empty_method
    let overload if parameter_check then parent.boundary_has_overload else boundary_has_overload
    when if parameter_check then parent.boundary_function_reachable && boundary_argument.eligible else boundary_function_reachable
    when empty_method == true || !(contains(allowedNames, boundary_name) || boundary_shape.ancestor_typed || allowTypedFunctionExpressions && boundary_shape.context_typed || allowOverloadFunctions && overload)
    when if parameter_check then !(allowArgumentsExplicitlyTypedAsAny && boundary_argument.any) else !boundary_shape.valid && !(allowHigherOrderFunctions && boundary_shape.higher_order || allowDirectConstAssertionInArrowFunctions && boundary_shape.const_assertion)
    report at if parameter_check then boundary_argument.offset else boundary_offset
    warn if parameter_check then (if boundary_argument.name != null then "Argument '" boundary_argument.name "'" else boundary_argument.pattern " argument") " should be typed" (if boundary_argument.any then " with a non-any type" else "") "." else "Missing return type on function."
  }
}
boundary_rule(explicit-module-boundary-types, ts_function, false)
boundary_rule(explicit-module-boundary-types:method, ts_method, false)
boundary_rule(explicit-module-boundary-types:arrow, ts_arrow, false)
boundary_rule(explicit-module-boundary-types:argument, ts_parameter, true)

# ---- expressions -----------------------------------------------------------------------
in ts_member, ts_index let loop_collection_read if object.layer != "ts_this" && write_site == null then object else null
in ts_identifier let loop_index_use { start: offset, end: end_offset, array: if field == "property" || field == "index" then parent.loop_collection_read else null }
in ts_identifier let loop_index_uses [] references.loop_index_use
in ts_number let loop_zero literal_value.value == "0"
in ts_declarator let counted_loop_binding if name.layer == "ts_identifier" && init.loop_zero == true then { name: name, uses: name.loop_index_uses } else null
in ts_variable_declaration let counted_loop_initialisation if kind != "const" && count(declaration) == 1 then first([] declaration.counted_loop_binding) else null
in ts_member let array_length_object if property.layer == "ts_identifier" && property == "length" then object else null
in ts_index let array_length_object if index.layer == "ts_identifier" && index == "length" then object else null
in ts_binary let counted_loop_test if operator == "<" then { name: left, array: right.array_length_object } else null
in ts_number let loop_increment_unit literal_value.value == "1"
in ts_binary let counted_loop_increment if operator == "+" then { left: left, right: right, left_unit: left.loop_increment_unit, right_unit: right.loop_increment_unit } else null
in ts_update let incremented_loop_name if operator == "++" then argument else null
fn increments_name(sum, name) = sum != null && (sum.left == name && sum.right_unit == true || sum.right == name && sum.left_unit == true)
in ts_assignment let incremented_loop_name if operator == "+=" && right.loop_increment_unit == true || operator == "=" && increments_name(right.counted_loop_increment, left) then left else null
in ts_for rule prefer-for-of {
  let binding init.counted_loop_initialisation
  let comparison test.counted_loop_test
  when binding != null && comparison.array != null && comparison.name == binding.name && update.incremented_loop_name == binding.name
  when all(binding.uses, use => use.start < body.offset || use.end > body.end_offset || use.array == comparison.array)
  warn "Expected a `for-of` loop instead of a `for` loop with this simple iteration."
}
in style_tree_node let assignment_node_start offset
in style_tree_node let assignment_call_start if parent == "ts_parenthesized" then parent.assignment_call_start else if parent == "ts_call" then parent.assignment_node_start else null
in ts_parenthesized let assignment_inner_start expression.assignment_value_start
in style_tree_node let assignment_value_start default(assignment_inner_start, offset)
in ts_parameter let assignment_property_name if is_parameter_property && name.layer == "ts_identifier" then name else null
in ts_method let assignment_constructor_properties [] parameter.assignment_property_name
in ts_method let assignment_is_constructor key == "constructor"
in ts_method, ts_function, ts_arrow let assignment_function_node { kind: layer, constructor: assignment_is_constructor == true, properties: default(assignment_constructor_properties, []), call: if layer == "ts_arrow" then assignment_call_start else null, outer: parent.assignment_nearest_function }
in style_tree_node let assignment_nearest_function if layer is (ts_method, ts_function, ts_arrow) then assignment_function_node else parent.assignment_nearest_function
fn assignment_owner(owner) = if owner.kind == "ts_arrow" && owner.call != null then owner.outer else owner
in ts_class_property let assignment_property_node { init: init.assignment_value_start }
in style_tree_node let assignment_nearest_property if layer == "ts_class_property" then assignment_property_node else parent.assignment_nearest_property
in ts_identifier let assignment_parameter_value if reference_kind == "parameter" then text else null
in ts_as, ts_non_null, ts_parenthesized let assignment_parameter_value expression.assignment_parameter_value
in ts_member let assignment_this_name if object.layer == "ts_this" then property else null
in ts_index let assignment_this_name if object.layer == "ts_this" then index.static_name else null
fn assignment_constructor(owner) = owner.kind == "ts_method" && owner.constructor
fn assignment_field_initialiser(owner, property) = property != null && (owner == null || owner.kind == "ts_arrow" && owner.call == property.init)
fn parameter_assignment_entry(start, owner, nearest, property, left_name, left_parameter, right_parameter, op) = {
  start: start,
  prior: if assignment_constructor(owner) then if left_parameter != null then left_parameter else if !contains(["=", "??=", "&&=", "||="], op) then left_name else null else null,
  field_write: if !assignment_constructor(owner) && assignment_field_initialiser(nearest, property) then left_name else null,
  candidate: assignment_constructor(owner) && left_name != null && left_name == right_parameter && contains(owner.properties, left_name) && contains(["=", "??=", "&&=", "||="], op),
  name: left_name
}
in ts_assignment let parameter_assignment_entry parameter_assignment_entry(offset, assignment_owner(assignment_nearest_function), assignment_nearest_function, assignment_nearest_property, left.assignment_this_name, if left.layer == "ts_identifier" then left.assignment_parameter_value else null, right.assignment_parameter_value, operator)
in style_tree_node let parameter_assignment_entries if layer == "ts_class" then [] else [] parameter_assignment_entry reduce([] children.parameter_assignment_entries, [], (entries, child) => entries child)
in ts_class let parameter_assignment_catalog reduce([] children.parameter_assignment_entries, [], (entries, child) => entries child)
in ts_assignment rule no-unnecessary-parameter-property-assignment {
  when ts_class.node != null
  let entry parameter_assignment_entry
  when entry.candidate && !any(ts_class.parameter_assignment_catalog, prior => prior.field_write == entry.name || prior.start < entry.start && prior.prior == entry.name)
  warn "This assignment is unnecessary since it is already assigned by a parameter property."
}

in ts_binary rule no-confusing-non-null-assertion {
  when contains(["==", "===", "in", "instanceof"], operator) && re_test(left, /!\s*$/)
  warn if operator == "in" || operator == "instanceof" then "Confusing combination of non-null assertion and `{operator}` operator like `a! {operator} b`, which might be misinterpreted as `!(a {operator} b)`." else "Confusing combination of non-null assertion and equality test like `a! == b`, which looks very similar to `a !== b`."
}
in ts_assignment rule no-confusing-non-null-assertion:assign {
  when operator == "=" && re_test(left, /!\s*$/)
  warn "Confusing combination of non-null assertion and assignment like `a! = b`, which looks very similar to `a != b`."
}

in ts_call rule no-require-imports {
  option allow string[] = [] "module paths (regexes) that may be required"
  option allowAsImport boolean = false "allow `import x = require(...)`"
  when callee == "require" && (callee.resolved == "global" || parent == "ts_import_equals")
  when !(allowAsImport && parent == "ts_import_equals")
  when !any(allow, p => re_test(default(first([] argument.literal_value).value, "\u{0}"), p) && first([] argument.literal_value).type == "string")
  warn "A `require()` style import is forbidden."
}
in ts_call rule no-var-requires {
  when callee == "require" && callee.resolved == "global" && re_test(parent, /^ts_(declarator|call|member|index|new|as|type_assertion)$/)
  warn "Require statement not part of import statement."
}

in ts_block let directive_body parent is (ts_function, ts_arrow, ts_method, ts_namespace)
in ts_expression_statement let directive_prefix expression.layer == "ts_string" && (previous == null || previous.directive_prefix == true)
in ts_expression_statement let directive_statement (parent is ts_program || parent.directive_body == true) && directive_prefix
in ts_array, ts_arrow, ts_binary, ts_class, ts_function, ts_identifier, ts_member, ts_index, ts_meta_property, ts_object, ts_sequence, ts_template, ts_this, ts_number, ts_string, ts_boolean, ts_bigint, ts_null, ts_regex let statement_effect false
in ts_unary let statement_effect contains(["delete", "void"], operator)
in ts_logical let statement_effect { kind: "logical", right: right.statement_effect }
in ts_conditional let statement_effect { kind: "conditional", left: consequent.statement_effect, right: alternate.statement_effect }
in ts_tagged_template let statement_effect { kind: "tagged" }
in ts_jsx_element, ts_jsx_fragment let statement_effect { kind: "jsx" }
in ts_parenthesized, ts_as, ts_type_assertion, ts_non_null, ts_instantiation forward statement_effect from expression
fn expression_allowed(shape, short, ternary, tagged, jsx) = if type_of(shape) == "bool" then shape else if shape.kind == "logical" then short && expression_allowed(shape.right, short, ternary, tagged, jsx) else if shape.kind == "conditional" then ternary && expression_allowed(shape.left, short, ternary, tagged, jsx) && expression_allowed(shape.right, short, ternary, tagged, jsx) else if shape.kind == "tagged" then tagged else if shape.kind == "jsx" then !jsx else true
in ts_expression_statement rule no-unused-expressions {
  option allowShortCircuit boolean = false "Allow effectful short circuit expressions."
  option allowTernary boolean = false "Allow ternaries with effectful branches."
  option allowTaggedTemplates boolean = false "Allow tagged templates."
  option enforceForJSX boolean = false "Report unused JSX expressions."
  option ignoreDirectives boolean = false "Ignore directive prologues."
  when !directive_statement && !expression_allowed(expression.statement_effect, allowShortCircuit, allowTernary, allowTaggedTemplates, enforceForJSX)
  warn "Expected an assignment or function call and instead saw an expression."
}

# ---- consistent-type-imports ------------------------------------------------
# Every imported binding is unused, used only as a type (type positions,
# `typeof x` in types), or used as a value.
# A list of quoted names as eslint words it: "a", "b" and "c".
macro word_list(xs) (if count(xs) == 1 then first(xs) else join(slice(xs, 0, -1), ', ') " and " last(xs))
in ts_identifier {
  let import_use if uses == null then null else if uses == 0 then "unused" else if value_uses == 0 then "type" else "value"
  let type_only_name if import_use == "type" then '"' text '"' else null
}
in ts_import_specifier {
  let import_use if kind != null then "inline" else if local != null then local.import_use else imported.import_use
  let type_only_name if kind != null then null else if local != null then local.type_only_name else imported.type_only_name
}
in ts_import {
  let import_uses compact([default_import.import_use, namespace.import_use] specifier.import_use)
  let type_only_names compact([default_import.type_only_name, namespace.type_only_name] specifier.type_only_name)
}
in ts_import rule consistent-type-imports {
  option disallowTypeAnnotations boolean = true "Disallow import() type annotations."
  option fixStyle ("inline-type-imports" | "separate-type-imports") = "separate-type-imports" "Preferred fix style."
  option prefer ("type-imports" | "no-type-imports") = "type-imports" "Preferred import kind."
  when prefer == "no-type-imports" && kind == "type" || prefer == "type-imports" && kind == null && contains(import_uses, "type")
  warn if prefer == "no-type-imports" then "Use an `import` instead of an `import type`." else if !contains(import_uses, "value") && !contains(import_uses, "unused") then "All imports in the declaration are only used as types. Use `import type`." else "Imports {word_list(type_only_names)} are only used as type."
}
in ts_import_specifier rule consistent-type-imports:inline {
  option disallowTypeAnnotations boolean = true "Disallow import() type annotations."
  option fixStyle ("inline-type-imports" | "separate-type-imports") = "separate-type-imports" "Preferred fix style."
  option prefer ("type-imports" | "no-type-imports") = "type-imports" "Preferred import kind."
  when prefer == "no-type-imports" && kind == "type"
  warn "Use an `import` instead of an `import type`."
}
in ts_import_type rule consistent-type-imports:annotation {
  option disallowTypeAnnotations boolean = true "Disallow import() type annotations."
  option fixStyle ("inline-type-imports" | "separate-type-imports") = "separate-type-imports" "Preferred fix style."
  option prefer ("type-imports" | "no-type-imports") = "type-imports" "Preferred import kind."
  when disallowTypeAnnotations
  warn "`import()` type annotations are forbidden."
}

# n/no-sync: `fooSync()` inside functions (top-level code may block).
in ts_identifier let sync_argument_name if re_test(text, /^[\w$]*Sync$/) then text else null
in ts_call let sync_method_name first(compact([re_find(callee, /[\w$]*Sync$/)] argument.sync_argument_name))
in ts_call rule no-sync {
  when sync_method_name != null && (ts_function != null || ts_arrow != null || ts_method != null)
  warn "Unexpected sync method: '{sync_method_name}'."
}

}
