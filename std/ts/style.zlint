# .ts/style: typescript-eslint stylistic and strict rules, plus import /
# jsdoc / tslint ones, on the native TypeScript layers. Messages and
# positions follow typescript-eslint's.
#
# `[] x` turns a field or field attribute into a list whether it matched
# none, one or many nodes.

import .ts/helpers
import .ts/assertions

define {

group style_tree_node ts_node

@macro modifiers (join([] modifier, " "))
fn has_accessibility(m) = re_test(m, /\b(?:public|private|protected)\b/)

}

import .ts/style/comments
import .ts/style/types
import .ts/style/declarations
import .ts/style/ordering
import .ts/style/classes
import .ts/style/signatures
import .ts/style/returns
import .ts/style/expressions
import .ts/style/imports
