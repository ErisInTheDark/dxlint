# .ts/style: typescript-eslint stylistic and strict rules, plus import /
# jsdoc / tslint ones, on the native TypeScript layers. Messages and
# positions follow typescript-eslint's.
#
# `[] x` turns a field or field attribute into a list whether it matched
# none, one or many nodes.

import .ts/helpers

define {

macro modifiers (join([] modifier, " "))
macro has_accessibility(m) re_test(m, /\b(?:public|private|protected)\b/)

# ---- comments --------------------------------------------------------------------
in js_line_comment, js_block_comment rule ban-tslint-comment {
  when re_test(text, /^\/[\/*]\s*tslint:/)
  warn "tslint comment detected: \"{text}\""
}

# Only directives before the first code token are triple-slash references.
in js_line_comment rule triple-slash-reference {
  option lib ("always" | "never") = "always" "When lib directives are allowed."
  option path ("always" | "never") = "never" "When path directives are allowed."
  option types ("always" | "never" | "prefer-import") = "prefer-import" "When types directives are allowed."
  let directive re_replace(text, /^\/\/\/\s*<reference\s*(types|path|lib)\s*=[\s\S]*$/, "$1")
  let module re_replace(text, /^\/\/\/\s*<reference\s*(?:types|path|lib)\s*=\s*["'|](.*)["'|][\s\S]*$/, "$1")
  when re_test(text, /^\/\/\/\s*<reference\s*(?:types|path|lib)\s*=\s*["'|].*["'|]/)
  when re_test(slice(source, 0, offset), /^(?:\s|\/\/[^\r\n]*(?:\r?\n|$)|\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\/)*$/)
  when directive == "lib" && lib == "never" || directive == "path" && path == "never" || directive == "types" && (types == "never" || types == "prefer-import" && re_test(source, "(?:import|from|require\\s*\\()\\s*[\"']" re_escape(module) "[\"']"))
  warn "Do not use a triple slash reference for {module}, use `import` style instead."
}

# JSDoc lines whose `*` is not one column right of the opening `/**`. The
# matchers never take the `*` of the closing `*/` (the comment's own end).
in js_block_comment match jsdoc_line /^[ \t]*\*(?!\/)/
in js_block_comment match jsdoc_close_indent /^[ \t]+(?=\*\/)/
# Blank lines inside the block have no `*` at all (.js/format's
# `js_blank_run` already takes them).
in js_blank_run rule check-alignment:blank {
  when parent == "js_block_comment" && re_test(parent_text, /^\/\*\*[^*]/)
  warn "Expected JSDoc block to be aligned."
}
# `/**` then anything but another `*` (`/*****` banners are not JSDoc).
macro is_jsdoc re_test(parent_text, /^\/\*\*[^*]/)
in jsdoc_line rule check-alignment {
  when is_jsdoc && text != parent_indent " *"
  warn "Expected JSDoc block to be aligned."
}
in jsdoc_close_indent rule check-alignment:close {
  when is_jsdoc && text != parent_indent " "
  warn "Expected JSDoc block to be aligned."
}
in js_block_comment match jsdoc_typed_tag /^[ \t]*\*[ \t]*@(?:param|arg|argument|returns?|property|prop|throws|yields)[ \t]+\{/
in jsdoc_typed_tag rule no-types {
  when is_jsdoc
  warn "Types are not permitted on @{re_replace(text, /^.*@(\w+).*$/, '$1')}."
}

# ---- type syntax -------------------------------------------------------------------
in ts_type_reference, ts_type_keyword, ts_tuple_type, ts_type_literal rule no-restricted-types {
  option types { [key: string]: boolean | string | { fixWith?: string; message?: string; suggest?: string[] } | null } = {} "Restricted types and custom messages."
  let restricted_names filter(map(restricted_type_candidates, c => { name: c.name, offset: c.offset, key: find_last(keys(types), n => re_replace(n, /\s+/, "") == c.name) }), c => c.key != null)
  let restricted_entries map(restricted_names, c => { name: c.name, offset: c.offset, policy: first(slice(values(types), index_of(keys(types), c.key), index_of(keys(types), c.key) + 1)) })
  each entry in filter(restricted_entries, e => type_of(e.policy) != "null" && !(type_of(e.policy) == "bool" && e.policy == false))
  report at entry.offset
  warn "Don't use `{entry.name}` as a type." (if type_of(entry.policy) == "str" && entry.policy != "" then " " entry.policy else if entry.policy.message != null && entry.policy.message != "" then " " entry.policy.message else "")
}

# array-type selects array or generic notation separately for readonly arrays.
in ts_type_keyword, ts_array_type, ts_qualified_name let is_simple_type true
in ts_type_reference let is_simple_type count(type_argument) == 0 || name == "Array" && count(type_argument) == 1 && first([] type_argument.is_simple_type) == true
in ts_array_type {
  let array_type_not_simple !(type.is_simple_type == true)
  let is_array_type true
  let array_element_simple type.is_simple_type == true
  let array_element_text type
}
in ts_type_operator let readonly_array_not_simple operator == "readonly" && type.array_type_not_simple == true
in ts_type_reference rule array-type:generic {
  option default ("array" | "array-simple" | "generic") = "array" "Mutable array notation."
  option readonly string = "" "Readonly array notation; empty uses default."
  let is_readonly name == "ReadonlyArray" || name == "Readonly"
  let mode if is_readonly && readonly != "" then readonly else default
  let arg first([] type_argument)
  when re_test(name, /^(Array|ReadonlyArray|Readonly)$/) && count(type_argument) == 1 && name.reference_kind == null
  when name != "Readonly" || first([] type_argument.is_array_type) == true
  when mode != "generic" && (mode != "array-simple" || first([] type_argument.is_simple_type) == true)
  let shown if first([] type_argument.is_simple_type) == true then arg else "T"
  warn "Array type using '{name}<{shown}>' is forbidden{if mode == 'array-simple' then ' for simple types' else ''}. Use '{if is_readonly then 'readonly ' else ''}{shown}{if name == 'Readonly' then '' else '[]'}' instead."
}
in ts_array_type rule array-type:simple {
  option default ("array" | "array-simple" | "generic") = "array" "Mutable array notation."
  option readonly string = "" "Readonly array notation; empty uses default."
  when !(parent == "ts_type_operator" && parent.operator == "readonly")
  when default == "generic" || default == "array-simple" && array_type_not_simple
  let shown if type.is_simple_type == true then type else "T"
  warn "Array type using '{shown}[]' is forbidden{if default == 'array-simple' then ' for non-simple types' else ''}. Use 'Array<{shown}>' instead."
}
in ts_type_operator rule array-type:readonly {
  option default ("array" | "array-simple" | "generic") = "array" "Mutable array notation."
  option readonly string = "" "Readonly array notation; empty uses default."
  let mode if readonly == "" then default else readonly
  when operator == "readonly" && type.is_array_type == true
  when mode == "generic" || mode == "array-simple" && readonly_array_not_simple
  let shown if type.array_element_simple then type.array_element_text else "T"
  warn "Array type using 'readonly {shown}[]' is forbidden{if mode == 'array-simple' then ' for non-simple types' else ''}. Use 'ReadonlyArray<{shown}>' instead."
}

# The global wrapper types (not local types of those names).
in ts_type_reference rule no-wrapper-object-types {
  when re_test(name, /^(String|Number|Boolean|Object|Symbol|BigInt)$/) && parent != "ts_template_type" && name.reference_kind == null
  warn "Prefer using the primitive `{lower(name)}` as a type name, rather than the upper-cased `{name}`."
}

in ts_non_null rule no-non-null-assertion {
  warn "Forbidden non-null assertion."
}
in ts_non_null rule no-non-null-asserted-nullish-coalescing {
  when redundant_non_null_coalescing
  warn "The nullish coalescing operator is designed to handle undefined and null - using a non-null assertion is not needed."
}

in ts_type_parameter rule no-unnecessary-type-constraint {
  when constraint == "any" || constraint == "unknown"
  warn "Constraining the generic type `{name}` to `{constraint}` does nothing and is unnecessary."
}

in ts_type_keyword rule no-invalid-void-type {
  option allowAsThisParameter boolean = false "Allow void as the type of a this parameter."
  option allowInGenericTypeArguments boolean | string[] = true "Allow void in generic arguments, or only named generic types."
  let context void_type_context
  let generic_name re_replace(default(parent.name, ""), /\s+/, "")
  let generic_allowed allowInGenericTypeArguments == true || type_of(allowInGenericTypeArguments) == "list" && contains(map(allowInGenericTypeArguments, n => re_replace(n, /\s+/, "")), generic_name)
  when text == "void" && context != "return"
  when !(context == "generic" && generic_allowed || context == "generic-other" && allowInGenericTypeArguments == true || context == "default" && allowInGenericTypeArguments || context == "this" && allowAsThisParameter)
  warn if context == "generic" && type_of(allowInGenericTypeArguments) == "list" then generic_name " may not have void as a type argument." else if allowInGenericTypeArguments && allowAsThisParameter then "void is only valid as a return type or generic type argument or the type of a `this` parameter." else if allowInGenericTypeArguments && context == "union" then "void is not valid as a constituent in a union type" else if allowInGenericTypeArguments then "void is only valid as a return type or generic type argument." else if allowAsThisParameter then "void is only valid as return type or type of `this` parameter." else "void is only valid as a return type."
}

in ts_type_keyword rule no-explicit-any {
  option ignoreRestArgs boolean = false "Ignore any in rest parameter arrays."
  option fixToUnknown boolean = false "Enable replacing any with unknown."
  when text == "any" && !(ignoreRestArgs && any_rest_parameter)
  warn "Unexpected any. Specify a different type."
}

in ts_index rule no-dynamic-delete {
  when dynamic_delete
  report at index.unparen_offset
  warn "Do not delete dynamically computed property keys."
}

in ts_namespace rule no-namespace {
  option allowDeclarations boolean = false "Allow namespaces within declarations."
  option allowDefinitionFiles boolean = true "Allow namespaces in definition files."
  when kind != "global" && name != "global" && !re_test(name, /^["']/) && parent != "ts_namespace"
  when !(allowDefinitionFiles && re_test(file, /\.d\.[cm]?ts$/)) && !(allowDeclarations && declared_namespace)
  warn "ES2015 module syntax is preferred over namespaces."
}

in ts_export rule no-useless-empty-export {
  when !re_test(file, /\.d\.[cm]?ts$/) && useless_empty_export
  warn "Empty export does nothing and can be removed."
}

in ts_enum_member rule prefer-enum-initializers {
  when init == null
  warn "The value of the member '{text}' should be explicitly defined."
}

in ts_enum_member.name rule prefer-literal-enum-member {
  option allowBitwiseExpressions boolean = false "Allow bitwise expressions using literals and enum members."
  when !(if allowBitwiseExpressions then parent.bitwise_enum_initializer else parent.literal_enum_initializer)
  warn "Explicit enum value must only be a literal value (string or number){if allowBitwiseExpressions then ' or a bitwise expression' else ''}."
}

in ts_declarator.name rule no-this-alias {
  option allowDestructuring boolean = true "Allow destructuring this."
  option allowedNames string[] = [] "Names allowed to alias this."
  when parent.init == "this"
  when !(allowDestructuring && layer != "ts_identifier") && !contains(allowedNames, text)
  warn if layer == "ts_identifier" then "Unexpected aliasing of 'this' to local variable." else "Unexpected aliasing of members of 'this' to local variables."
}
in ts_assignment.left rule no-this-alias:assignment {
  option allowDestructuring boolean = true "Allow destructuring this."
  option allowedNames string[] = [] "Names allowed to alias this."
  when parent.right == "this"
  when !(allowDestructuring && layer != "ts_identifier") && !contains(allowedNames, text)
  warn if layer == "ts_identifier" then "Unexpected aliasing of 'this' to local variable." else "Unexpected aliasing of members of 'this' to local variables."
}

in ts_import_specifier let type_only_specifier kind == "type"
in ts_import rule no-import-type-side-effects {
  when kind != "type" && default_import == null && namespace == null && count(specifier) > 0
  when count(filter([] specifier.type_only_specifier, t => t)) == count(specifier)
  warn "TypeScript will only remove the inline type specifiers which will leave behind a side effect import at runtime. Convert this to a top-level type qualifier to properly remove the entire import."
}

in ts_method_signature rule method-signature-style {
  option mode ("method" | "property") = "property" "Preferred method signature notation."
  when mode == "property" && kind != "get" && kind != "set"
  warn "Shorthand method signature is forbidden. Use a function property instead."
}
in ts_function_type let is_function_type true
in ts_property_signature rule method-signature-style:property {
  option mode ("method" | "property") = "property" "Preferred method signature notation."
  when mode == "method" && type.is_function_type == true
  warn "Function property signature is forbidden. Use a method shorthand instead."
}

in ts_object let assertion_literal_kind "object"
in ts_array let assertion_literal_kind "array"
in ts_parenthesized let assertion_literal_kind expression.assertion_literal_kind
in ts_as, ts_type_assertion rule consistent-type-assertions {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  option objectLiteralTypeAssertions ("allow" | "allow-as-parameter" | "never") = "allow" "When object literal assertions are allowed."
  option arrayLiteralTypeAssertions ("allow" | "allow-as-parameter" | "never") = "allow" "When array literal assertions are allowed."
  when layer == "ts_as" && assertionStyle != "as" || layer == "ts_type_assertion" && assertionStyle != "angle-bracket"
  when !(assertionStyle == "never" && type == "const")
  warn if assertionStyle == "never" then "Do not use any type assertions." else if assertionStyle == "as" then "Use 'as {type}' instead of '<{type}>'." else "Use '<{type}>' instead of 'as {type}'."
}
in ts_as, ts_type_assertion rule consistent-type-assertions:literal {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  option objectLiteralTypeAssertions ("allow" | "allow-as-parameter" | "never") = "allow" "When object literal assertions are allowed."
  option arrayLiteralTypeAssertions ("allow" | "allow-as-parameter" | "never") = "allow" "When array literal assertions are allowed."
  let literal_kind expression.assertion_literal_kind
  let literal_mode if literal_kind == "array" then arrayLiteralTypeAssertions else objectLiteralTypeAssertions
  when layer == "ts_as" && assertionStyle == "as" || layer == "ts_type_assertion" && assertionStyle == "angle-bracket"
  when literal_kind != null && type != "any" && type != "unknown" && type != "const"
  when literal_mode == "never" || literal_mode == "allow-as-parameter" && !assertion_as_parameter
  warn if literal_kind == "array" then "Always prefer const x: T[] = [ ... ]." else "Always prefer const x: T = {{ ... }}."
}

in ts_parameter rule parameter-properties {
  option allow string[] = [] "Parameter property modifiers to allow."
  option prefer ("class-property" | "parameter-property") = "class-property" "Preferred property declaration."
  when prefer == "class-property" && parameter_property_modifiers != "" && !contains(allow, parameter_property_modifiers)
  warn "Property {name} should be declared as a class property."
}
in ts_class_property rule parameter-properties:class {
  option allow string[] = [] "Parameter property modifiers to allow."
  option prefer ("class-property" | "parameter-property") = "class-property" "Preferred property declaration."
  when prefer == "parameter-property" && parameter_property_candidate && !contains(allow, parameter_property_modifiers)
  warn "Property {key} should be declared as a parameter property."
}

in ts_number, ts_string, ts_boolean, ts_bigint, ts_null, ts_regex let raw_literal_expression text
in ts_parenthesized let raw_literal_expression expression.raw_literal_expression
in ts_literal_type let literal_type_text value
in ts_as, ts_type_assertion let use_const_assertion type.literal_type_text != null && type.literal_type_text == expression.raw_literal_expression
in ts_declarator, ts_class_property let use_const_annotation type.literal_type_text != null && type.literal_type_text == init.raw_literal_expression
in ts_as.type, ts_type_assertion.type rule prefer-as-const {
  when parent.use_const_assertion
  warn "Expected a `const` instead of a literal type assertion."
}
in ts_declarator.type, ts_class_property.type rule prefer-as-const:annotation {
  when parent.use_const_annotation
  warn "Expected a `const` assertion instead of a literal type annotation."
}

macro empty_object_message(subject, option_name) subject " allows any non-nullish value, including literals like `0` and `\"\"`.\n- If that's what you want, disable this lint rule with an inline comment or configure the '" option_name "' rule option.\n- If you want a type meaning \"any object\", you probably want `object` instead.\n- If you want a type meaning \"any value\", you probably want `unknown` instead."
in ts_interface.name rule no-empty-object-type:interface {
  option allowInterfaces ("always" | "never" | "with-single-extends") = "never" "When to allow empty interfaces."
  option allowObjectTypes ("always" | "never") = "never" "When to allow empty object types."
  option allowWithName string = "" "Allow matching interface and type alias names."
  when allowInterfaces != "always" && count(parent.member) == 0 && count(parent.extends) <= 1
  when !(allowInterfaces == "with-single-extends" && count(parent.extends) == 1) && !(allowWithName != "" && re_test(text, allowWithName))
  warn if count(parent.extends) == 1 then "An interface declaring no members is equivalent to its supertype." else empty_object_message("An empty interface declaration", "allowInterfaces")
}
in ts_type_literal rule no-empty-object-type {
  option allowInterfaces ("always" | "never" | "with-single-extends") = "never" "When to allow empty interfaces."
  option allowObjectTypes ("always" | "never") = "never" "When to allow empty object types."
  option allowWithName string = "" "Allow matching interface and type alias names."
  when allowObjectTypes != "always" && count(member) == 0 && parent != "ts_intersection"
  when !(allowWithName != "" && parent == "ts_type_alias" && re_test(parent.name, allowWithName))
  warn empty_object_message("The `{{}}` (\"empty object\") type", "allowObjectTypes")
}

# A type literal or interface that is only an index signature.
in ts_type_literal rule consistent-indexed-object-style {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && record_convertible
  warn "A record is preferred over an index signature."
}
in ts_interface rule consistent-indexed-object-style:interface {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && record_convertible
  warn "A record is preferred over an index signature."
}
in ts_mapped_type rule consistent-indexed-object-style:mapped {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "record" && record_convertible
  warn "A record is preferred over an index signature."
}
in ts_type_reference rule consistent-indexed-object-style:record {
  option mode ("record" | "index-signature") = "record" "Preferred indexed object notation."
  when mode == "index-signature" && name == "Record" && count(type_argument) == 2
  warn "An index signature is preferred over a record."
}

in ts_type_literal let is_type_literal true
in ts_parenthesized_type let is_type_literal type.is_type_literal == true
in ts_type_alias let aliases_type_literal type.is_type_literal == true
in ts_type_alias.name rule consistent-type-definitions {
  option mode ("interface" | "type") = "interface" "Preferred object type definition."
  when mode == "interface" && parent.aliases_type_literal
  warn "Use an `interface` instead of a `type`."
}
in ts_interface.name rule consistent-type-definitions:interface {
  option mode ("interface" | "type") = "interface" "Preferred object type definition."
  when mode == "type"
  warn "Use a `type` instead of an `interface`."
}

# Only a call signature: a function type says it better.
in ts_call_signature rule prefer-function-type {
  let shape function_type_candidate
  when shape != null
  report at shape.offset
  warn shape.message
}

in ts_namespace rule prefer-namespace-keyword {
  when kind == "module" && is_identifier(re_replace(name, /\..*$/, ""))
  warn "Use 'namespace' instead of 'module' to declare custom TypeScript modules."
}

# ---- declarations --------------------------------------------------------------
# Annotations the initializer already states, with widening exceptions.
in ts_declarator rule no-inferrable-types {
  option ignoreParameters boolean = false "Ignore parameter annotations."
  option ignoreProperties boolean = false "Ignore property annotations."
  when inferrable_annotation != null
  warn "Type {inferrable_annotation} trivially inferred from a {inferrable_annotation} literal, remove type annotation."
}
# `readonly` (and optional) properties keep their annotation: it widens.
in ts_class_property rule no-inferrable-types:property {
  option ignoreParameters boolean = false "Ignore parameter annotations."
  option ignoreProperties boolean = false "Ignore property annotations."
  when !ignoreProperties && inferrable_annotation != null && !contains([] modifier, "readonly") && optional == null
  warn "Type {inferrable_annotation} trivially inferred from a {inferrable_annotation} literal, remove type annotation."
}
in ts_parameter rule no-inferrable-types:parameter {
  option ignoreParameters boolean = false "Ignore parameter annotations."
  option ignoreProperties boolean = false "Ignore property annotations."
  when !ignoreParameters && inferrable_annotation != null
  report at name.unparen_offset
  warn "Type {inferrable_annotation} trivially inferred from a {inferrable_annotation} literal, remove type annotation."
}

# `const x: Map<K, V> = new Map()`: the arguments belong on the constructor.
in ts_declarator, ts_class_property, ts_parameter rule consistent-generic-constructors {
  option mode ("constructor" | "type-annotation") = "constructor" "Preferred location for generic arguments."
  when generic_constructor_style == mode
  warn if mode == "constructor" then "The generic type arguments should be specified as part of the constructor type arguments." else "The generic type arguments should be specified as part of the type annotation."
}

# ---- classes -------------------------------------------------------------------------
schema member_order_config null | "never" | (string | string[])[] | {
  memberTypes?: "never" | (string | string[])[]
  order?: "alphabetically" | "alphabetically-case-insensitive" | "as-written" | "natural" | "natural-case-insensitive"
  optionalityOrder?: "optional-first" | "required-first"
}
in ts_class, ts_interface, ts_type_literal rule member-ordering {
  option default member_order_config = null "Default ordering; null uses the standard member groups."
  option classes member_order_config = null "Class declaration ordering."
  option classExpressions member_order_config = null "Class expression ordering."
  option interfaces member_order_config = null "Interface ordering."
  option typeLiterals member_order_config = null "Type literal ordering."
  let ordering_info member_order_info
  let specific_order if layer == "ts_interface" then interfaces else if layer == "ts_type_literal" then typeLiterals else if ordering_info.class_expression then classExpressions else classes
  let selected_order if specific_order != null then specific_order else default
  when selected_order != "never"
  let ordering_config if selected_order == null then { memberTypes: ordering_info.standard_order } else selected_order
  let ordering_types if type_of(ordering_config) == "list" then ordering_config else if ordering_config.memberTypes != null then ordering_config.memberTypes else if specific_order == null then ordering_info.standard_order else null
  each violation in member_order(ordering_types, ordering_config.order, ordering_config.optionalityOrder)
  report at violation.offset
  warn violation.message
}

in ts_class_property rule explicit-member-accessibility:property {
  option accessibility ("explicit" | "no-public" | "off") = "explicit" "Required accessibility."
  option ignoredMethodNames string[] = [] "Ignored method names."
  option overrides { properties?: string; methods?: string; accessors?: string; constructors?: string; parameterProperties?: string } = {} "Requirements by member kind."
  let check default(overrides.properties, accessibility)
  let shape member_style
  when !re_test(key, /^#/) && (check == "explicit" && !has_accessibility(modifiers) || check == "no-public" && contains([] modifier, "public"))
  report at if check == "no-public" then shape.public else shape.head
  warn "{if check == 'no-public' then 'Public' else 'Missing'} accessibility modifier on class property {shape.name}."
}
in ts_method rule explicit-member-accessibility:method {
  option accessibility ("explicit" | "no-public" | "off") = "explicit" "Required accessibility."
  option ignoredMethodNames string[] = [] "Ignored method names."
  option overrides { properties?: string; methods?: string; accessors?: string; constructors?: string; parameterProperties?: string } = {} "Requirements by member kind."
  let check default(if key == "constructor" then overrides.constructors else if kind == "get" || kind == "set" then overrides.accessors else overrides.methods, accessibility)
  let shape member_style
  when parent == "ts_class" && !re_test(key, /^#/) && !contains(ignoredMethodNames, shape.name)
  when check == "explicit" && !has_accessibility(modifiers) || check == "no-public" && contains([] modifier, "public")
  report at if check == "no-public" then shape.public else shape.head
  warn "{if check == 'no-public' then 'Public' else 'Missing'} accessibility modifier on {if kind == 'get' then 'get property accessor' else if kind == 'set' then 'set property accessor' else 'method definition'} {shape.name}."
}
in ts_parameter rule explicit-member-accessibility:parameter {
  option accessibility ("explicit" | "no-public" | "off") = "explicit" "Required accessibility."
  option ignoredMethodNames string[] = [] "Ignored method names."
  option overrides { properties?: string; methods?: string; accessors?: string; constructors?: string; parameterProperties?: string } = {} "Requirements by member kind."
  let check default(overrides.parameterProperties, accessibility)
  let shape member_style
  when contains([] modifier, "readonly") && parent == "ts_method"
  when check == "explicit" && !has_accessibility(modifiers) || check == "no-public" && contains([] modifier, "public")
  report at if check == "no-public" then shape.public else shape.head
  warn "{if check == 'no-public' then 'Public' else 'Missing'} accessibility modifier on parameter property {shape.name}."
}

# Getters that return a literal: a readonly field says it better.
in ts_method.key rule class-literal-property-style {
  option mode ("fields" | "getters") = "fields" "Preferred literal member declaration."
  when mode == "fields" && parent.literal_member
  let shape parent.member_style
  report at shape.key
  warn "Literals should be exposed using readonly fields."
}
in ts_class_property.key rule class-literal-property-style:getters {
  option mode ("fields" | "getters") = "fields" "Preferred literal member declaration."
  when mode == "getters" && parent.literal_member
  let shape parent.member_style
  report at shape.key
  warn "Literals should be exposed using getters."
}

in ts_parameter let is_parameter_property re_test(modifiers, /\b(?:public|private|protected|readonly)\b/)
in ts_method, ts_class_property let is_static contains([] modifier, "static")
in ts_class rule no-extraneous-class {
  option allowConstructorOnly boolean = false "Allow constructor-only classes."
  option allowEmpty boolean = false "Allow empty classes."
  option allowStaticOnly boolean = false "Allow static-only classes."
  option allowWithDecorator boolean = false "Allow decorated classes."
  let shape extraneous_class
  when extends == null && !(allowWithDecorator && count(decorator) > 0) && shape != null
  when !(shape == "empty" && allowEmpty || shape == "constructor" && allowConstructorOnly || shape == "static" && allowStaticOnly)
  report at if name != null && re_test(parent, /^ts_(program|export|block|namespace)$/) then name.unparen_offset else offset
  warn if shape == "empty" then "Unexpected empty class." else if shape == "constructor" then "Unexpected class with only a constructor." else "Unexpected class with only static properties."
}

# Constructors that do nothing a missing one would not.
in ts_parameter let parameter_name re_replace(name, /\s+/, "")
in ts_method rule no-useless-constructor {
  # A public constructor of a derived class may widen a protected one.
  when key == "constructor" && body != null && count(decorator) == 0 && !re_test(modifiers, /\b(?:private|protected)\b/)
  when !(ts_class.extends != null && re_test(modifiers, /\bpublic\b/))
  when !any(compact([] parameter.is_parameter_property)) && !re_test(join([] parameter, ","), /[=@{\[?]/)
  when if ts_class.extends == null then re_test(body, /^\{\s*\}$/) else re_test(re_replace(body, /\s+/, ""), "^\\x7Bsuper\\((?:\\.\\.\\.arguments|" re_escape(join([] parameter.parameter_name, ",")) ")\\);?\\x7D$")
  warn "Useless constructor."
}

in ts_program, ts_block, ts_class, ts_interface, ts_type_literal rule adjacent-overload-signatures {
  each pair in nonadjacent_signatures
  report at pair.offset
  warn "All {pair.name} signatures should be adjacent."
}

# `new (): I` in interface `I` (type arguments aside), and `constructor()`
# signatures in interfaces and type literals.
in ts_call_signature rule no-misused-new {
  when parent == "ts_interface" && kind == "new" && re_replace(default(return_type, ""), /\s*<[\s\S]*$/, "") == ts_interface.name
  warn "Interfaces cannot be constructed, only classes."
}
in ts_method_signature rule no-misused-new:constructor {
  when key == "constructor"
  warn "Interfaces cannot be constructed, only classes."
}
in ts_method rule no-misused-new:class {
  when key == "new" && body == null && return_type == ts_class.name
  warn "Class cannot have method named `new`."
}

# ---- functions -----------------------------------------------------------------------
in ts_program, ts_class, ts_interface, ts_type_literal, ts_namespace rule unified-signatures {
  option ignoreDifferentlyNamedParameters boolean = false "Ignore overloads with different parameter names."
  option ignoreOverloadsWithDifferentJSDoc boolean = false "Ignore overloads with different block comments."
  each pair in filter(unifiable_signatures, p => (!ignoreDifferentlyNamedParameters || p.same_names) && (!ignoreOverloadsWithDifferentJSDoc || p.same_docs))
  report at pair.offset
  warn pair.message
}

macro explicit_return_rule(rule-id, return_context) {
  in return_context rule rule-id {
    option allowConciseArrowFunctionExpressionsStartingWithVoid boolean = false "Allow concise arrows starting with void."
    option allowDirectConstAssertionInArrowFunctions boolean = true "Allow concise arrows returning const assertions."
    option allowedNames string[] = [] "Allowed function and member names."
    option allowExpressions boolean = false "Allow function expressions outside declarations."
    option allowFunctionsWithoutTypeParameters boolean = false "Allow nongeneric functions."
    option allowHigherOrderFunctions boolean = true "Allow functions returning only functions."
    option allowIIFEs boolean = false "Allow functions directly within calls."
    option allowTypedFunctionExpressions boolean = true "Allow contextually typed function expressions."
    let shape function_return_style
    when !shape.valid && !contains(allowedNames, shape.name)
    when !(allowFunctionsWithoutTypeParameters && count(type_parameter) == 0 || allowIIFEs && shape.iife || allowHigherOrderFunctions && shape.higher_order || allowConciseArrowFunctionExpressionsStartingWithVoid && shape.void_arrow)
    when !(allowTypedFunctionExpressions && (shape.typed || allowExpressions && shape.free_expression || allowDirectConstAssertionInArrowFunctions && shape.const_assertion))
    report at shape.offset
    warn "Missing return type on function."
  }
}
explicit_return_rule(explicit-function-return-type, ts_function)
explicit_return_rule(explicit-function-return-type:method, ts_method)
explicit_return_rule(explicit-function-return-type:arrow, ts_arrow)

# explicit-module-boundary-types: what other modules see needs types.
macro boundary_rule(rule-id, boundary_context, parameter_check) {
  in boundary_context rule rule-id {
    option allowArgumentsExplicitlyTypedAsAny boolean = false "Allow explicit any parameter types."
    option allowDirectConstAssertionInArrowFunctions boolean = true "Allow concise arrows returning const assertions."
    option allowedNames string[] = [] "Allowed function and member names."
    option allowHigherOrderFunctions boolean = true "Allow functions returning only functions."
    option allowTypedFunctionExpressions boolean = true "Allow contextually typed functions."
    option allowOverloadFunctions boolean = false "Allow implementations with overload signatures."
    let boundary_shape function_boundary_style
    when boundary_shape != null
    when boundary_shape.empty_method || !(contains(allowedNames, boundary_shape.name) || boundary_shape.ancestor_typed || allowTypedFunctionExpressions && boundary_shape.context_typed || allowOverloadFunctions && boundary_shape.overload)
    when if parameter_check then !(allowArgumentsExplicitlyTypedAsAny && boundary_shape.any) else !boundary_shape.valid && !(allowHigherOrderFunctions && boundary_shape.higher_order || allowDirectConstAssertionInArrowFunctions && boundary_shape.const_assertion)
    report at if parameter_check then boundary_shape.parameter_offset else boundary_shape.offset
    warn if parameter_check then boundary_shape.message else "Missing return type on function."
  }
}
boundary_rule(explicit-module-boundary-types, ts_function, false)
boundary_rule(explicit-module-boundary-types:method, ts_method, false)
boundary_rule(explicit-module-boundary-types:arrow, ts_arrow, false)
boundary_rule(explicit-module-boundary-types:argument, ts_parameter, true)

# ---- expressions -----------------------------------------------------------------------
in ts_for rule prefer-for-of {
  when simple_array_iteration
  warn "Expected a `for-of` loop instead of a `for` loop with this simple iteration."
}
in ts_assignment rule no-unnecessary-parameter-property-assignment {
  when unnecessary_parameter_assignment
  warn "This assignment is unnecessary since it is already assigned by a parameter property."
}

in ts_binary rule no-confusing-non-null-assertion {
  when contains(["==", "===", "in", "instanceof"], operator) && re_test(left, /!\s*$/)
  warn if operator == "in" || operator == "instanceof" then "Confusing combination of non-null assertion and `{operator}` operator like `a! {operator} b`, which might be misinterpreted as `!(a {operator} b)`." else "Confusing combination of non-null assertion and equality test like `a! == b`, which looks very similar to `a !== b`."
}
in ts_assignment rule no-confusing-non-null-assertion:assign {
  when operator == "=" && re_test(left, /!\s*$/)
  warn "Confusing combination of non-null assertion and assignment like `a! = b`, which looks very similar to `a != b`."
}

in ts_call rule no-require-imports {
  option allow string[] = [] "module paths (regexes) that may be required"
  option allowAsImport boolean = false "allow `import x = require(...)`"
  when callee == "require" && (callee.resolved == "global" || parent == "ts_import_equals")
  when !(allowAsImport && parent == "ts_import_equals")
  when !any(allow, p => re_test(default(first([] argument.literal_value).value, "\u{0}"), p) && first([] argument.literal_value).type == "string")
  warn "A `require()` style import is forbidden."
}
in ts_call rule no-var-requires {
  when callee == "require" && callee.resolved == "global" && re_test(parent, /^ts_(declarator|call|member|index|new|as|type_assertion)$/)
  warn "Require statement not part of import statement."
}

in ts_expression_statement rule no-unused-expressions {
  option allowShortCircuit boolean = false "Allow effectful short circuit expressions."
  option allowTernary boolean = false "Allow ternaries with effectful branches."
  option allowTaggedTemplates boolean = false "Allow tagged templates."
  option enforceForJSX boolean = false "Report unused JSX expressions."
  option ignoreDirectives boolean = false "Ignore directive prologues."
  let shape expression_statement
  let mode (if allowShortCircuit then 1 else 0) + (if allowTernary then 2 else 0) + (if allowTaggedTemplates then 4 else 0) + (if enforceForJSX then 8 else 0)
  when !shape.directive && !contains(shape.valid_modes, mode)
  warn "Expected an assignment or function call and instead saw an expression."
}

# ---- consistent-type-imports ------------------------------------------------
# Every imported binding is unused, used only as a type (type positions,
# `typeof x` in types), or used as a value.
# A list of quoted names as eslint words it: "a", "b" and "c".
macro word_list(xs) (if count(xs) == 1 then first(xs) else join(slice(xs, 0, -1), ', ') " and " last(xs))
in ts_identifier {
  let import_use if uses == null then null else if uses == 0 then "unused" else if value_uses == 0 then "type" else "value"
  let type_only_name if import_use == "type" then '"' text '"' else null
}
in ts_import_specifier {
  let import_use if kind != null then "inline" else if local != null then local.import_use else imported.import_use
  let type_only_name if kind != null then null else if local != null then local.type_only_name else imported.type_only_name
}
in ts_import {
  let import_uses compact([default_import.import_use, namespace.import_use] specifier.import_use)
  let type_only_names compact([default_import.type_only_name, namespace.type_only_name] specifier.type_only_name)
}
in ts_import rule consistent-type-imports {
  option disallowTypeAnnotations boolean = true "Disallow import() type annotations."
  option fixStyle ("inline-type-imports" | "separate-type-imports") = "separate-type-imports" "Preferred fix style."
  option prefer ("type-imports" | "no-type-imports") = "type-imports" "Preferred import kind."
  when prefer == "no-type-imports" && kind == "type" || prefer == "type-imports" && kind == null && contains(import_uses, "type")
  warn if prefer == "no-type-imports" then "Use an `import` instead of an `import type`." else if !contains(import_uses, "value") && !contains(import_uses, "unused") then "All imports in the declaration are only used as types. Use `import type`." else "Imports {word_list(type_only_names)} are only used as type."
}
in ts_import_specifier rule consistent-type-imports:inline {
  option disallowTypeAnnotations boolean = true "Disallow import() type annotations."
  option fixStyle ("inline-type-imports" | "separate-type-imports") = "separate-type-imports" "Preferred fix style."
  option prefer ("type-imports" | "no-type-imports") = "type-imports" "Preferred import kind."
  when prefer == "no-type-imports" && kind == "type"
  warn "Use an `import` instead of an `import type`."
}
in ts_import_type rule consistent-type-imports:annotation {
  option disallowTypeAnnotations boolean = true "Disallow import() type annotations."
  option fixStyle ("inline-type-imports" | "separate-type-imports") = "separate-type-imports" "Preferred fix style."
  option prefer ("type-imports" | "no-type-imports") = "type-imports" "Preferred import kind."
  when disallowTypeAnnotations
  warn "`import()` type annotations are forbidden."
}

# n/no-sync: `fooSync()` inside functions (top-level code may block).
in ts_identifier let sync_argument_name if re_test(text, /^[\w$]*Sync$/) then text else null
in ts_call let sync_method_name first(compact([re_find(callee, /[\w$]*Sync$/)] argument.sync_argument_name))
in ts_call rule no-sync {
  when sync_method_name != null && (ts_function != null || ts_arrow != null || ts_method != null)
  warn "Unexpected sync method: '{sync_method_name}'."
}

}
