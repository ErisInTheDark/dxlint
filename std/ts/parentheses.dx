# Expression/type parentheses and IIFE wrapping; structure imports this policy.
define {

in ts_call, ts_new, ts_import_call let structure_argument_count count(argument)
in ts_function, ts_call let structure_iife_wrapped parent is ts_parenthesized
  || is (ts_if.test, ts_while.test, ts_do_while.test)
  || is ts_switch.discriminant
  || is ts_with.object
  || is (ts_call.argument, ts_new.argument, ts_import_call.argument) && parent.structure_argument_count == 1 && next_token is ts_close_paren
in ts_function let structure_iife_callee { direct: true, prototype: false, wrapped: structure_iife_wrapped, node: node }
in ts_parenthesized let structure_iife_callee expression.structure_iife_callee
in ts_member, ts_index let structure_iife_callee if (object.structure_iife_callee).direct && contains(["call", "apply"], static_name) then { direct: false, prototype: true, wrapped: (object.structure_iife_callee).wrapped, node: (object.structure_iife_callee).node } else null

in ts_call rule es-wrap-iife {
  option mode "outside" | "inside" | "any" = "outside"
  option functionPrototypeMethods boolean = false "include function call/apply invocations"
  let info callee.structure_iife_callee
  when info != null && (functionPrototypeMethods || !info.prototype)
  when !structure_iife_wrapped && !info.wrapped || mode == "inside" && !info.wrapped || mode == "outside" && !structure_iife_wrapped
  let target if mode == "inside" then info.node else node
  let closing if mode == "inside" then token_neighbours.after else info.node.token_neighbours.after
  let edit if !structure_iife_wrapped && !info.wrapped then { start: target.offset, end: target.end_offset, text: "(" target.text ")" }
  else if mode == "inside" then (
    if parent is ts_parenthesized && parent not ts_new.callee then
      { start: info.node.end_offset, end: closing.end, text: ")" byte_slice(source, info.node.end_offset, closing.start) }
    else { start: info.node.offset, end: info.node.end_offset, text: "(" info.node.text ")" }
  ) else {
    start: closing.start, end: end_offset, text: byte_slice(source, closing.end, end_offset) ")"
  }
  fix at edit as edit.text
  warn if !structure_iife_wrapped && !info.wrapped then "Wrap an immediate function invocation in parentheses." else if mode == "inside" then "Wrap only the function expression in parens." else "Move the invocation into the parens that contain the function."
}

group structure_parens ts_parenthesized, ts_parenthesized_type
group structure_assertion ts_as, ts_satisfies, ts_type_assertion
group structure_binary ts_binary, ts_logical
group structure_member ts_member, ts_index
group structure_conditional_owner ts_function, ts_arrow, ts_program, ts_return, ts_if, ts_while, ts_do_while, ts_conditional, ts_for
group structure_return_owner ts_return, ts_arrow, ts_function, ts_program
group no_extra_parens_inner ts_node
group no_extra_parens_spread_allowed

in structure_parens let no_extra_parens_checked true

in ts_parenthesized let structure_parens_inner expression.node
in ts_parenthesized_type let structure_parens_inner type.node
in ts_node let structure_unwrapped if is structure_parens then structure_parens_inner.structure_unwrapped else node
in structure_parens let structure_parens_outer if parent is structure_parens then parent.structure_parens_outer else node
in structure_parens let no_extra_parens_owner {
  value outer: structure_parens_outer
  value owner: outer.parent.node
  value if owner is ts_computed_key || outer is (ts_property.value, ts_pattern_property.value) && owner.parent is (ts_object, ts_object_pattern) then owner.parent.node else owner
}
in structure_parens let structure_parens_count if parent is structure_parens then 1 + parent.structure_parens_count else 1
in ts_node let structure_parens_optional node.optional != null || is (structure_member, ts_call)
  && (if is ts_call then callee.structure_parens_optional else object.structure_parens_optional) == true
in ts_node let structure_parens_has_call is (ts_call, ts_import_call)
  || is structure_member && object.structure_parens_has_call == true
  || is (ts_non_null, ts_parenthesized) && expression.structure_parens_has_call == true
  || is ts_tagged_template && tag.structure_parens_has_call == true
in ts_node let structure_parens_has_in node.operator == "in"
  || any(children.nodes, child =>
    if child is structure_parens then structure_parens_required(source, child.parent.node, child.structure_parens_inner.structure_unwrapped, child) == 0
      && child.structure_parens_inner.structure_unwrapped.structure_parens_has_in == true
    else !structure_parens_enclosed_in(child) && child.structure_parens_has_in == true)
in ts_call let structure_parens_iife (callee.structure_iife_callee).direct == true && !(callee.structure_iife_callee).wrapped
in ts_node let structure_parens_prototype if is ts_call then (callee.structure_iife_callee).prototype == true || (callee.structure_unwrapped).structure_parens_prototype == true
  else if is structure_member then (object.structure_unwrapped).structure_parens_prototype == true else false
in ts_node let structure_parens_leading_child if is (ts_call, ts_new) then callee.node
  else if is structure_member then object.node
  else if is (structure_binary, ts_assignment) then left.node
  else if is ts_conditional then test.node
  else if is (ts_sequence, ts_as, ts_satisfies, ts_non_null) then first(expression.nodes) else null
in ts_node let structure_parens_leading_object is ts_object
  || structure_parens_leading_child != null && structure_parens_leading_child.offset == offset
  && structure_parens_leading_child not ts_parenthesized && structure_parens_leading_child.structure_parens_leading_object == true
in ts_node let structure_parens_hazard is (ts_object, ts_function, ts_class)
  || is ts_index && node.object == "let"
  || structure_parens_leading_child != null && structure_parens_leading_child not ts_parenthesized && structure_parens_leading_child.structure_parens_hazard == true
in ts_node let structure_parens_leads is (ts_parenthesized.expression, ts_as.expression, ts_satisfies.expression, ts_non_null.expression,
  ts_member.object, ts_index.object, ts_call.callee, ts_binary.left, ts_logical.left, ts_assignment.left, ts_conditional.test)
  || is ts_sequence.expression && index == 0 || is ts_update.argument && offset == parent.offset
in ts_node let structure_parens_context if parent is (ts_expression_statement, ts_export_assignment, ts_return)
  || is (ts_arrow.body, ts_export.expression, ts_for.init, ts_for_in.left, ts_for_of.left) then parent.node
  else if structure_parens_leads && !(parent is structure_parens && parent.structure_parens_context is ts_return) then parent.structure_parens_context else null
in ts_node let structure_parens_for_init if parent is ts_for then is ts_for.init
  else if structure_parens_enclosed_in(node) then false else parent.structure_parens_for_init == true
in ts_node let structure_parens_conditional_owner if is structure_conditional_owner then node else parent.structure_parens_conditional_owner
in ts_node let structure_parens_return_owner if is structure_return_owner then node else parent.structure_parens_return_owner
in ts_node let structure_parens_leading_let if is ts_identifier then text == "let"
  else structure_parens_leading_child != null && structure_parens_leading_child not ts_parenthesized && structure_parens_leading_child.structure_parens_leading_let == true
in ts_node let structure_parens_new_receiver if is ts_new then node
  else if is (ts_new.callee, ts_member.object, ts_index.object, ts_call.callee, ts_tagged_template.tag, ts_non_null.expression) then parent.structure_parens_new_receiver else null

# These child fields use +In grammar even inside a for initialiser.
fn structure_parens_enclosed_in(child) = child.parent is (ts_array, ts_object, ts_array_pattern, ts_object_pattern, ts_function, ts_block, ts_template, structure_parens)
  || child is (ts_call.argument, ts_new.argument, ts_import_call.argument, ts_index.index, ts_computed_key.expression, ts_arrow.parameter, ts_parameter.init, ts_conditional.consequent)

fn structure_parens_need(required) = if required then 1 else 0
fn structure_parens_required(source, p, inner, outer) =
  if p is structure_binary then {
    value p.operator == "??" && contains(["&&", "||"], inner.operator) || contains(["&&", "||"], p.operator) && inner.operator == "??"
    || inner is structure_assertion || outer is ts_node.left && p.operator == "**" && inner is (ts_unary, ts_await)
    || inner.precedence < p.precedence || inner.precedence == p.precedence && (outer is ts_node.right) != (p.operator == "**")
    structure_parens_need
  }
  else if p is ts_conditional then {
    value inner is structure_assertion || inner.precedence < (if outer is ts_node.test then 4 else 1)
    structure_parens_need
  }
  else if outer is (ts_call.callee, ts_new.callee) then {
    value p is ts_call && inner is ts_function
    || inner.precedence < (if p is ts_new && p.callee.end_offset == p.end_offset then 18 else 19) || inner.structure_parens_optional
    || p is ts_new && inner.structure_parens_has_call
    structure_parens_need
  }
  else if p is (ts_call, ts_new, ts_import_call, ts_jsx_expression) then structure_parens_need(inner.precedence < 1)
  else if outer is (ts_member.object, ts_index.object) then (if inner is ts_regex then null else {
    value inner is ts_number && p is ts_member && re_test(inner.text, /^[0-9_]+$/) && !re_test(inner.text, /^0[0-7]+$/)
    || inner.structure_parens_optional && p.optional == null || inner.precedence < 19
    || p.structure_parens_new_receiver != null && inner.structure_parens_has_call
    structure_parens_need
  })
  else if p is structure_member then 0
  else if p is ts_arrow then (if inner is structure_assertion then null else structure_parens_need(inner.structure_parens_leading_object == true || inner.precedence < 1))
  else if outer is ts_declarator.init then (if inner is ts_regex then null else structure_parens_need(inner.precedence < 1))
  else if p is (ts_return, ts_throw, ts_yield) then (if inner is ts_regex && p is ts_return then null else {
    value { value source; byte_slice p.offset inner.offset; re_test /[\n\r\u{2028}\u{2029}]/ } || p is ts_yield && inner.precedence < 1
    structure_parens_need
  })
  else if p is (ts_expression_statement, ts_export_assignment) then structure_parens_need(inner.structure_parens_hazard || inner.structure_parens_iife)
  else if p is (ts_if, ts_while, ts_do_while, ts_switch, ts_with, ts_case) then (if p is ts_case && inner is structure_assertion then null else 0)
  else if outer is ts_export.expression then structure_parens_need(inner.precedence < 1)
  else if p is ts_for then (if inner is structure_assertion && outer not ts_for.init then null else structure_parens_need(outer is ts_for.init && inner.structure_parens_has_in))
  else if p is ts_for_in then 0
  else if p is ts_for_of then structure_parens_need(outer is ts_for_of.right && inner.precedence < 1)
  else if outer is ts_assignment.left then (if inner not (ts_identifier, structure_member) then null else structure_parens_need(
    inner is ts_identifier && (p.right.structure_unwrapped) is (ts_function, ts_class, ts_arrow) && (p.right.structure_unwrapped).name == null))
  else if p is ts_spread && inner is structure_assertion then null
  else if p is (ts_assignment, ts_assignment_pattern, ts_array, ts_spread, ts_property, ts_class_property, ts_parameter, ts_computed_key) then structure_parens_need(inner.precedence < 1)
  else if p is (ts_unary, ts_await) then structure_parens_need(inner.precedence < 15)
  else if p is ts_update then structure_parens_need(inner.precedence < 17)
  else if p is (ts_sequence, ts_type_alias, ts_parenthesized_type, ts_template) then 0
  else if outer is ts_tagged_template.tag then structure_parens_need(inner.precedence < 19 || inner.structure_parens_optional)
  else if outer is ts_class.extends then structure_parens_need(inner.precedence < 19)
  else if outer is ts_enum_member.init then structure_parens_need(inner.precedence < 1)
  else if p is ts_array_type then structure_parens_need(inner.precedence < 20)
  else if p is ts_type_operator then structure_parens_need(inner.precedence < p.precedence)
  else if p is (ts_union, ts_intersection) then structure_parens_need(inner.precedence < p.precedence)
  else if outer is (ts_type_assertion.expression, ts_as.expression, ts_satisfies.expression) then structure_parens_need(inner.precedence < 15)
  else if outer is (ts_node.type, ts_node.return_type) then 0 else null

# Removing a delimiter must not join identifiers, operators or comment openers.
fn structure_boundary_uncertain(left, right) = left != "" && right != ""
  && !re_test(left, /\s/) && !re_test(right, /\s/)
  && re_test(left right, /[\\\u{80}-\u{10ffff}]/)
fn structure_boundary_space(left, right) =
  re_test(left, /[a-zA-Z0-9_$]/) && re_test(right, /[a-zA-Z0-9_$]/)
  || left == "/" && re_test(right, /[a-zA-Z0-9_$/*]/)
  || re_test(left right, /^(?:\+\+|--|\*\*|&&|\|\||\?\?|\?\.|<<|>>|<=|>=|==|!=|=>|[+\-*%&|^]=)$/)

fn structure_parens_comment(pair, source) = {
  value start: (pair.space_before).start.nonempty ?? 0
  value overlapping(ts_comment, start, pair.offset + 1)
  find_last (c) c.end_offset <= pair.offset && { value source; byte_slice c.end_offset pair.offset; trim } == ""
}
fn structure_parens_cast(pair, source) = {
  value comment: structure_parens_comment(pair, source)
  value comment is ts_block_comment && contains(comment.structure_comment_body, "@type")
}
fn structure_parens_replacement(source, pairs) = {
  value pairs
  fold (null) (body, pair) {
    start: pair.offset, end: pair.end_offset,
    text: if body == null then byte_slice(source, pair.offset + 1, pair.end_offset - 1)
      else byte_slice(source, pair.offset + 1, body.start) body.text byte_slice(source, body.end, pair.end_offset - 1),
  }
}

in structure_parens rule es-no-extra-parens {
  option conditionalAssign boolean = true "enforce assignments in conditions"
  option ternaryOperandBinaryExpressions boolean = true "enforce binary ternary operands"
  option nestedBinaryExpressions boolean = true "enforce nested binary operands"
  option returnAssign boolean = true "enforce assignments in returns"
  option nestedConditionalExpressions boolean = true "enforce nested conditionals"
  option enforceForArrowConditionals boolean = true "enforce conditional arrow bodies"
  option enforceForSequenceExpressions boolean = true "enforce sequence expressions"
  option enforceForNewInMemberExpressions boolean = true "enforce new expressions in member access"
  option enforceForFunctionPrototypeMethods boolean = true "enforce function prototype receivers"
  option allowParensAfterCommentPattern string = "" "allow parentheses after matching comments"
  let inner structure_parens_inner
  when inner != null && inner not structure_parens
  when no_extra_parens_checked && inner is no_extra_parens_inner
  let outer structure_parens_outer
  let owner outer.parent.node
  when owner != null && outer not ts_node.type_argument
  let required structure_parens_required(source, owner, inner, outer)
  when required != null
  let context outer.structure_parens_context
  let protected inner.structure_parens_iife
    || inner is structure_assertion && owner is (ts_for, ts_for_in, ts_for_of, ts_throw, ts_yield, ts_unary, ts_await)
    || context != null && context not ts_return && (inner.structure_parens_hazard
      || context is ts_for_of && inner.structure_parens_leading_let || inner is ts_identifier && inner.text == "async" && context is ts_for_of)
    || context is (ts_expression_statement, ts_for, ts_for_in) && inner is ts_identifier && inner.text == "let" && outer.next_token is (ts_identifier, ts_open_bracket)
    || context is ts_return && { value source; byte_slice context.offset inner.offset; re_test /[\n\r\u{2028}\u{2029}]/ }
    || outer.structure_parens_for_init && inner.structure_parens_has_in
    || owner is ts_update && { value source; byte_slice inner.end_offset owner.end_offset; re_test /[\n\r]/ }
    || owner is ts_await && inner is ts_non_null
  when structure_parens_count > (if protected && required < 1 then 1 else required)
  let comment structure_parens_comment(outer, source)
  let typed_inner {
    value overlapping(ts_block_comment, outer.offset, inner.offset)
    any (c) c.offset > outer.offset && c.end_offset <= inner.offset && contains(c.structure_comment_body, "@type")
  }
  when !(comment is ts_block_comment && contains(comment.structure_comment_body, "@type") && (structure_parens_count == 1 || typed_inner))
  when conditionalAssign || !(inner is ts_assignment && owner.structure_parens_conditional_owner is (ts_if, ts_while, ts_do_while, ts_conditional, ts_for))
  when ternaryOperandBinaryExpressions || !(inner is structure_binary && owner is ts_conditional)
  when nestedBinaryExpressions || !(inner is structure_binary && owner is structure_binary || structure_parens_count == 1 && inner is (ts_union, ts_intersection) && owner is (ts_union, ts_intersection))
  when returnAssign || !(inner is ts_assignment && owner.structure_parens_return_owner is (ts_return, ts_arrow))
  when nestedConditionalExpressions || !(inner is ts_conditional && owner is ts_conditional)
  when enforceForArrowConditionals || !(inner is ts_conditional && owner is ts_arrow)
  when enforceForSequenceExpressions || inner not ts_sequence
  when enforceForNewInMemberExpressions || !(inner is ts_new && owner is structure_member)
  when enforceForFunctionPrototypeMethods || !(inner.structure_parens_prototype || inner is ts_function && owner.parent.structure_parens_prototype == true)
  when owner not ts_spread || inner not no_extra_parens_spread_allowed
  when allowParensAfterCommentPattern == "" || comment == null || !re_test(comment.structure_comment_body, allowParensAfterCommentPattern)
  warn "Unnecessary parentheses around expression."
  let directive owner is ts_expression_statement && (owner.parent is ts_program
    || owner.parent is ts_block && owner.parent.parent is (ts_function, ts_arrow, ts_method))
  let minimum if directive && inner is ts_string
    || !nestedBinaryExpressions && inner is (ts_union, ts_intersection) && owner is (ts_union, ts_intersection)
    || protected && required < 1 then 1 else required
  let chain {
    value node
    walk (pair) if pair.parent is structure_parens then pair.parent.node else null
  }
  let batch is ts_parenthesized_type || any(chain, pair => structure_parens_cast(pair, source))
  let removable if batch then structure_parens_count - minimum else 1
  let pairs {
    value chain
    filter (pair) !structure_parens_cast(pair, source)
    slice 0 removable
  }
  let replacement structure_parens_replacement(source, pairs)
  let pair { value pairs; last }
  let body replacement.text
  let before if {
    value 0
    max: max (pair.offset - 1)
    value overlapping(ts_block_comment, max, pair.offset)
    any (c) c.end_offset == pair.offset
  } then "" else byte_char(source, pair.offset, true)
  let after byte_char(source, pair.end_offset)
  let first byte_char(body, 0)
  let last { value body; length: byte_len; value byte_char(body, length, true) }
  let fixable pair != null && byte_char(source, pair.offset) == "(" && byte_char(source, pair.end_offset, true) == ")"
    && !structure_boundary_uncertain(before, first) && !structure_boundary_uncertain(last, after)
    && !(structure_parens_count == 1 && directive && inner is ts_string)
  fix at replacement if fixable as (if structure_boundary_space(before, first) then " " else "") body (if structure_boundary_space(last, after) then " " else "")
}

}
