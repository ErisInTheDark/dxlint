define {

schema indent_list_offset int(0..) | "first" | "off"
schema indent_function_options { parameters?: indent_list_offset; body?: int(0..); returnType?: int(0..) }

fn indent_numeric(mode) = if type_of(mode) == "num" then mode else 1
fn indent_variable_mode(mode, kind) = if type_of(mode) == "record" then default(get(mode, kind), 1) else mode
fn indent_steps(unit, levels) = repeat(byte_slice(unit, 0, 1), round(len(unit) * levels))
fn indent_declaration_level(owner, style, mode) =
  if !owner.indent_multiline_declaration then 0
  else if style != "first" then indent_numeric(style)
  else if mode == 0 then 0
  else divide(position(owner.indent_first_item.first_token.start).js_column - 1 - len(owner.indent), if mode == "tab" then 1 else mode)
fn indent_function_mode(owner, declaration, expression) = if owner is ts_function && owner.parent is (ts_program, ts_block, ts_export) then declaration else expression
fn indent_jsx_token_level(item) = if item is ts_jsx_fragment.token && item.text == "/" && item.space_after.line_break then 1 else 0
fn indent_expected(item, unit) = if item == null then null else if item is (ts_jsx_element.token, ts_jsx_fragment.token) then item.parent.indent indent_steps(unit, indent_jsx_token_level(item)) else item.indent_anchor indent_steps(unit, item.indent_level)
fn indent_list_mode(item, call, declaration, expression, array, object, imports, variable) =
  if item is (ts_call.argument, ts_new.argument, ts_import_call.argument) then default(call.arguments, 1)
  else if item is (ts_function.parameter, ts_arrow.parameter, ts_method.parameter) then default(indent_function_mode(item.parent, declaration, expression).parameters, 1)
  else if item is (ts_array.element, ts_array_pattern.element, ts_tuple_type.element) then array
  else if item is (ts_object.property, ts_object_pattern.property) then object
  else if item is ts_import.specifier then imports
  else if item is ts_variable_declaration.declaration then indent_variable_mode(variable, item.parent.kind.text)
  else 1
fn indent_ternary_level(branch, flat, offsets, statement) =
  if flat && position(branch.parent.test.offset).js_line == position(branch.parent.consequent.offset).js_line && position(branch.parent.offset).js_line != position(statement.offset).js_line then 0
  else if offsets != false && (branch.first_token is (opener, closer, ts_comma, ts_semicolon, ts_colon, ts_dot, ts_question, ts_ellipsis, ts_equals, ts_punctuator) || branch is (ts_call, ts_await, ts_new) && (type_of(offsets) == "bool" || default(get(offsets, if branch is ts_call then "CallExpression" else if branch is ts_await then "AwaitExpression" else "NewExpression"), true))) then 2
  else 1
fn indent_ternary_anchor_level(branch, flat, offsets, statement) =
  if branch is ts_conditional.alternate && position(branch.parent.consequent.last_token.end).js_line == position(branch.first_token.start).js_line then 0
  else max(0, indent_ternary_level(branch, flat, offsets, statement) - 1)

in ts_call, ts_new, ts_import_call let indent_first_item first([] argument.node)
in ts_function, ts_arrow, ts_method let indent_first_item first([] parameter.node)
in ts_array, ts_array_pattern, ts_tuple_type let indent_first_item first([] element.node)
in ts_object, ts_object_pattern let indent_first_item first([] property.node)
in ts_import let indent_first_item first([] specifier.node)
in ts_variable_declaration let indent_first_item first([] declaration.node)
in ts_variable_declaration let indent_multiline_declaration position(last([] declaration.node).offset).js_line > position(offset).js_line
in ts_node let indent_list_first if is (ts_call.argument, ts_new.argument, ts_import_call.argument, ts_function.parameter, ts_arrow.parameter, ts_method.parameter, ts_array.element, ts_array_pattern.element, ts_tuple_type.element, ts_object.property, ts_object_pattern.property, ts_import.specifier, ts_variable_declaration.declaration) then parent.indent_first_item else null

in ts_expression_statement, ts_variable_declaration let indent_outer_context parent is ts_program
in ts_call, ts_parenthesized, ts_assignment, ts_logical, ts_sequence, ts_declarator let indent_outer_context parent.indent_outer_context == true
in ts_unary let indent_outer_context contains(["!", "~", "+", "-"], operator) && parent.indent_outer_context == true
in ts_function, ts_arrow let indent_called_function node
in ts_parenthesized let indent_called_function expression.indent_called_function
in ts_function, ts_arrow let indent_outer_iife containing(ts_call).indent_outer_context == true && containing(ts_call).callee.indent_called_function.offset == offset
in ts_assignment, ts_assignment_pattern let indent_assignment_value right.node
in ts_declarator, ts_parameter, ts_class_property let indent_assignment_value init.node
in ts_jsx_attribute let indent_assignment_value value.node
in ts_index let indent_index_open index.token_neighbours.before.start
in ts_if let indent_control_tails [consequent.last_token.end, alternate.last_token.end]
in ts_for, ts_for_in, ts_for_of, ts_while, ts_do_while, ts_with let indent_control_tails [body.last_token.end]
in ts_semicolon, ts_empty let indent_semicolon_control if space_before.line_break && space_after.line_break == false && next_token != null then last(filter(walk(node, item => item.parent.node), item => contains(default(item.indent_control_tails, []), end_offset))) else null
in ts_semicolon let indent_tail_unchecked parent is (ts_variable_declaration, ts_declarator, ts_type_alias, ts_import_equals, ts_export_assignment)

in ts_line rule indent {
  option mode int(0..) | "tab" = 4 "spaces per level, or tab"
  option switch_case int(0..) = 1
  option variable_declarator indent_list_offset | { var?: indent_list_offset; let?: indent_list_offset; const?: indent_list_offset; using?: indent_list_offset } = 1
  option member_expression int(0..) | "off" = 1
  option function_declaration indent_function_options = {}
  option function_expression indent_function_options = {}
  option static_block { body?: int(0..) } = {}
  option call_expression { arguments?: indent_list_offset } = {}
  option array_expression indent_list_offset = 1
  option object_expression indent_list_offset = 1
  option import_declaration indent_list_offset = 1
  option assignment_operator int(0..) | "off" = 1
  option outerIIFEBody int(0..) | "off" = 1
  option ignore_comments boolean = false
  option flat_ternary_expressions boolean = false
  option offset_ternary_expressions boolean | { CallExpression?: boolean; AwaitExpression?: boolean; NewExpression?: boolean } = false

  indent in ts_block, ts_class, ts_interface, ts_namespace.body
  indent in ts_array, ts_array_pattern, ts_tuple_type by indent_numeric(array_expression)
  indent in ts_object, ts_object_pattern, ts_enum, ts_type_literal by indent_numeric(object_expression)
  indent in ts_parenthesized, ts_parenthesized_type, ts_computed_key, ts_mapped_type
  indent in ts_index from indent_index_open
  indent ts_index.token from if text == "]" then parent.indent_index_open else parent.offset by if text == "]" then 0 else indent_numeric(member_expression)
  indent in ts_call, ts_new, ts_import_call by indent_numeric(default(call_expression.arguments, 1))
  indent in ts_function.body, ts_arrow.body, ts_method.body from parent.offset by if parent.indent_outer_iife then indent_numeric(outerIIFEBody) else default(indent_function_mode(parent, function_declaration, function_expression).body, 1)
  indent in ts_static_block.body by default(static_block.body, 1)
  indent ts_function.parameter, ts_arrow.parameter, ts_method.parameter by indent_numeric(default(indent_function_mode(parent, function_declaration, function_expression).parameters, 1))
  indent ts_function.return_type by default(indent_function_mode(parent, function_declaration, function_expression).returnType, 1)
  indent ts_arrow.return_type, ts_parameter.type
  indent ts_call.argument, ts_new.argument, ts_import_call.argument by indent_numeric(default(call_expression.arguments, 1))
  indent ts_switch.case by switch_case
  indent ts_case.body
  indent ts_variable_declaration.declaration class declarators by indent_declaration_level(parent, indent_variable_mode(variable_declarator, parent.kind.text), mode)
  indent in ts_variable_declaration class declarators by indent_declaration_level(node, indent_variable_mode(variable_declarator, kind.text), mode)
  indent ts_declarator.token from token_neighbours.before.start by if text == "=" then indent_numeric(assignment_operator) else 0
  indent ts_member.property, ts_member.token, ts_member.optional, ts_index.optional, ts_meta_property.token by indent_numeric(member_expression)
  indent ts_import.specifier by indent_numeric(import_declaration)
  indent ts_export.specifier
  indent ts_assignment.right, ts_assignment_pattern.right, ts_class_property.init by indent_numeric(assignment_operator)
  indent ts_declarator.init from token_neighbours.before.start by indent_numeric(assignment_operator)
  indent ts_arrow.body from parent.offset by if is ts_block then 0 else 1
  indent ts_property.value, ts_return.argument, ts_throw.argument
  indent ts_conditional.consequent, ts_conditional.alternate by indent_ternary_level(node, flat_ternary_expressions, offset_ternary_expressions, containing(ts_statement))
  # An anchor at the branch itself skips this candidate; own-line branches keep ordinary collapsing.
  indent ts_conditional.consequent, ts_conditional.alternate from if position(first_token.start).js_line == position(token_neighbours.before.start).js_line && position(parent.offset).js_line < position(first_token.start).js_line then token_neighbours.before.start else offset class branches by indent_ternary_anchor_level(node, flat_ternary_expressions, offset_ternary_expressions, containing(ts_statement))
  indent ts_conditional.token
  indent ts_conditional_type.consequent, ts_conditional_type.alternate, ts_conditional_type.token
  indent in ts_jsx_element, ts_jsx_fragment
  indent in ts_jsx_expression, ts_jsx_spread_attribute
  indent ts_jsx_element.name, ts_jsx_element.property, ts_jsx_element.body, ts_jsx_fragment.body
  indent ts_jsx_element.closing from token_neighbours.before.start
  indent ts_jsx_element.token, ts_jsx_fragment.token from parent.offset by indent_jsx_token_level(node)
  indent ts_jsx_attribute.token from parent.offset by indent_numeric(assignment_operator)
  indent ts_jsx_attribute.value from token_neighbours.before.start by indent_numeric(assignment_operator)
  indent ts_function_type.parameter, ts_method_signature.parameter, ts_call_signature.parameter
  indent ts_function_type.return_type, ts_method_signature.return_type, ts_call_signature.return_type
  indent ts_type_reference.type_argument, ts_type_query.type_argument, ts_call.type_argument, ts_new.type_argument
  indent ts_function.type_parameter, ts_arrow.type_parameter, ts_method.type_parameter, ts_class.type_parameter, ts_interface.type_parameter
  indent ts_type_parameter.constraint, ts_type_parameter.default
  indent ts_for.init, ts_for.test, ts_for.update
  indent ts_if.consequent, ts_if.alternate, ts_for.body, ts_for_in.body, ts_for_of.body, ts_while.body, ts_do_while.body, ts_with.body from if is ts_empty then node.indent_semicolon_control else null by if is ts_block || is ts_empty && node.indent_semicolon_control != null then 0 else 1
  indent ts_semicolon from default(indent_semicolon_control, parent.node) by if indent_semicolon_control == null && parent is (ts_block, ts_class, ts_interface, ts_type_literal) then 1 else 0

  when trim(text) != ""
  let first_offset offset + byte_len(indent)
  let first_nodes overlapping(ts_node, first_offset, first_offset + 1)
  let semicolon first(overlapping(ts_semicolon, first_offset, first_offset + 1))
  when semicolon == null || !semicolon.indent_tail_unchecked
  when outerIIFEBody != "off" || !any(first_nodes, item => item is ts_block.body && item.first_token.start == first_offset && item.parent.parent.indent_outer_iife == true)
  let equals first(overlapping(ts_equals, first_offset, first_offset + 1))
  when assignment_operator != "off" || equals == null && !any(first_nodes, item => item.first_token.start == first_offset && item.parent.indent_assignment_value.offset == item.offset)
  let member first(overlapping(ts_member, first_offset, first_offset + 1))
  let index first(overlapping(ts_index, first_offset, first_offset + 1))
  when member_expression != "off" || (member == null || member.property.first_token.start != first_offset && member.property.previous_token.start != first_offset) && (index == null || index.index.first_token.start != first_offset && index.index.previous_token.start != first_offset)
  let list_item reduce(first_nodes, null, (best, item) => if item.indent_list_first != null && item.first_token.start == first_offset && (best == null || item.end_offset < best.end_offset) then item else best)
  let list_mode indent_list_mode(list_item, call_expression, function_declaration, function_expression, array_expression, object_expression, import_declaration, variable_declarator)
  when list_mode != "off"
  let binary_right first(overlapping(ts_binary.right, first_offset, first_offset + 1))
  let logical_right first(overlapping(ts_logical.right, first_offset, first_offset + 1))
  let binary_operator first(overlapping(ts_binary.operator, first_offset, first_offset + 1))
  let logical_operator first(overlapping(ts_logical.operator, first_offset, first_offset + 1))
  when binary_right == null || binary_right.first_token.start != first_offset
  when logical_right == null || logical_right.first_token.start != first_offset
  when binary_operator == null && logical_operator == null
  let quasi first(overlapping(ts_template.quasi, first_offset, first_offset + 1))
  let comment first(overlapping(ts_comment, first_offset, first_offset + 1))
  let block_comment if comment is ts_block_comment then comment else null
  when !ignore_comments || comment == null
  let string_literal first(overlapping(ts_string, first_offset, first_offset + 1))
  let jsx_text first(overlapping(ts_jsx_text, first_offset, first_offset + 1))
  when quasi == null || position(quasi.offset).js_line == position(first_offset).js_line
  when block_comment == null || position(block_comment.offset).js_line == position(first_offset).js_line
  when string_literal == null || position(string_literal.offset).js_line == position(first_offset).js_line
  let unit if mode == "tab" then "\t" else repeat(" ", mode)
  let comment_before if comment == null then null else node_at(comment.token_neighbours.before.start)
  let comment_after if comment == null then null else node_at(comment.token_neighbours.after.start)
  let before_wanted indent_expected(comment_before, unit)
  # Only line-leading declaration semicolons are unchecked; inline ones retain their declaration offset.
  let after_wanted if comment_after.indent_tail_unchecked then if position(comment_after.offset).js_line == position(comment.offset).js_line then indent_expected(comment_after.parent.node, unit) indent_steps(unit, if comment_after.parent is ts_variable_declaration then indent_numeric(indent_variable_mode(variable_declarator, comment_after.parent.kind.text)) else 1) else comment_after.indent else indent_expected(comment_after, unit)
  when comment == null || !(comment_before != null && comment.space_before.blank_gaps == 0 && indent == before_wanted || comment_after != null && comment.space_after.blank_gaps == 0 && indent == after_wanted)
  let aligned_first if list_mode == "first" && list_item.offset != list_item.indent_list_first.offset then list_item.indent_list_first else null
  let aligned_anchor if aligned_first == null then "" else aligned_first.indent_anchor indent_steps(unit, aligned_first.indent_level)
  # Raw JSX text uses the tag line's actual indentation, not virtual code-token offsets.
  let wanted if jsx_text != null then jsx_text.parent.indent unit else if comment != null && comment_after is ts_semicolon then after_wanted else if aligned_first != null then aligned_anchor repeat(if mode == "tab" then "\t" else " ", position(aligned_first.first_token.start).js_column - 1 - len(aligned_first.indent)) else indent_anchor indent_steps(unit, indent_level)
  when indent != wanted
  let spaces len(replace(indent, "\t", ""))
  let tabs len(replace(indent, " ", ""))
  let unit_name if mode == "tab" then "tab" else "space"
  let actual if spaces > 0 then "{spaces}{if mode == 'tab' then if spaces == 1 then ' space' else ' spaces' else ''}" else if tabs > 0 then "{tabs}{if mode != 'tab' then if tabs == 1 then ' tab' else ' tabs' else ''}" else "0"
  report at if jsx_text != null then jsx_text.node else { start: offset, end: offset + byte_len(indent) }
  fix as wanted byte_slice(text, byte_len(indent))
  warn "Expected indentation of {len(wanted)} {unit_name}{if len(wanted) == 1 then '' else 's'} but found {actual}."
}

}
