# Regular import/export attribute syntax, shared by formatting rules.
define {
in ts_import, ts_export layer ts_import_attributes match ts_import_attributes ts_import_attribute_string ts_import_attribute_gap* /\b(?:with|assert)/ ts_import_attribute_gap* open:/\{/ until close:/\}/ ts_import_attribute_gap* /;?\z/
in ts_import_attributes match ts_import_attribute_string /"(?:\\[\s\S]|[^"\\])*"|'(?:\\[\s\S]|[^'\\])*'/
in ts_import_attributes match ts_import_attribute_key /(?:[^\W\d]|\$)[\w$]*/ or ts_import_attribute_string
in ts_import_attributes match ts_import_attribute_comment /\/\*/ until /\*\// or /\/\/[^\n\r\u{2028}\u{2029}]*/
in ts_import_attributes match ts_import_attribute_gap /\s+/ or ts_import_attribute_comment
in ts_import_attributes match ts_import_attribute_colon /:/
in ts_import_attributes match ts_import_attribute_comma /,/
in ts_import_attributes match ts_import_attribute key:ts_import_attribute_key ts_import_attribute_gap* colon:ts_import_attribute_colon ts_import_attribute_gap* value:ts_import_attribute_string
}
