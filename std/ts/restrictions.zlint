# .ts/restrictions: eslint core rules that limit or forbid things by
# configuration: sizes (max-*, complexity), restricted names, imports,
# properties and syntax, identifier shapes, sort orders, comment and
# operator bans.

define {

schema restriction_import_path string | {
  name: string
  message?: string
  importNames?: string[]
  allowImportNames?: string[]
  allowTypeImports: boolean = false
}
schema restriction_import_pattern string | {
  group?: string[]
  regex?: regex
  message?: string
  caseSensitive: boolean = false
  importNames?: string[]
  allowImportNames?: string[]
  importNamePattern?: regex
  allowImportNamePattern?: regex
  allowTypeImports: boolean = false
}
schema restriction_import_options restriction_import_path | {
  paths: restriction_import_path[] = []
  patterns: restriction_import_pattern[] = []
}
macro restriction_import_paths default(first(options).paths, options)
macro restriction_import_patterns (if type_of(first(first(options).patterns)) == "str" then [{group: first(options).patterns}] else default(first(options).patterns, []))
macro restriction_import_list(xs) (if len(xs) < 2 then join(map(xs, x => "'" x "'"), "") else if len(xs) == 2 then join(map(xs, x => "'" x "'"), " and ") else join(map(slice(xs, 0, len(xs) - 1), x => "'" x "'"), ", ") ", and '" last(xs) "'")
macro restriction_import_plural(xs) (if len(xs) == 1 then "is" else "are")
macro restriction_import_custom(entry) (if entry.message != null && entry.message != "" then " " entry.message else "")
macro restriction_import_glob(path, glob, sensitive) (!starts_with(glob, "#") && re_test(path, (if sensitive then "" else "(?i)") (if contains(trim_start(glob, "!"), "/") then "^" else "(?:^|/)") replace(replace(replace(re_escape(replace(replace(trim_start(glob, "!/"), "\\#", "#"), "\\!", "!")), "\\*\\*/", "(?:.*/)?"), "\\*", "[^/]*"), "\\?", "[^/]") "(?:/|$)"))
macro restriction_import_group(path, entry) find_last(default(entry.group, []), import_glob_pattern => restriction_import_glob(path, import_glob_pattern, entry.caseSensitive))
macro restriction_import_group_blocked(path, entry) ((restriction_import_group(path, entry)) != null && !starts_with(restriction_import_group(path, entry), "!"))
macro restriction_import_pattern_matches(entry) (if entry.regex != null then re_test(info.source, (if entry.caseSensitive then "" else "(?i)") entry.regex) else restriction_import_group_blocked(info.source, entry) || any(info.parents, p => restriction_import_group_blocked(p, entry)))
fn restriction_import_parent(path) = join(slice(split(path, "/"), 0, len(split(path, "/")) - 1), "/")
fn restriction_import_parents(path) = if contains(path, "/") && restriction_import_parent(path) != "" then [restriction_import_parent(path)] restriction_import_parents(restriction_import_parent(path)) else []
fn restriction_import_source(value) = if type_of(value) == "str" then trim(value) else null
in ts_import_specifier, ts_export_specifier let restriction_import_all_members_type kind == "type" && (previous == null || previous.restriction_import_all_members_type == true)
in ts_call let restriction_import_argument first([] argument.static_name)
in ts_import {
  let restriction_import_source restriction_import_source(from.static_name)
  let restriction_import_type kind == "type"
  let restriction_import_all_type kind == "type" || default_import == null && namespace == null && count(specifier) > 0 && last([] specifier.restriction_import_all_members_type) == true
  let restriction_import_name ""
  let restriction_import_item false
  let restriction_import_offset offset
  let restriction_import_star_offset offset + byte_len(first(split(text, "*")))
}
in ts_export {
  let restriction_import_source restriction_import_source(from.static_name)
  let restriction_import_type kind == "type"
  let restriction_import_all_type kind == "type" || namespace == null && count(specifier) > 0 && last([] specifier.restriction_import_all_members_type) == true
  let restriction_import_star count(specifier) == 0 && declaration == null
  let restriction_import_name if restriction_import_star then "*" else ""
  let restriction_import_item restriction_import_star
  let restriction_import_offset if restriction_import_star then offset + byte_len(first(split(text, "*"))) else offset
}
in ts_import_equals {
  let restriction_import_source restriction_import_source(value.restriction_import_argument)
  let restriction_import_type kind == "type"
  let restriction_import_all_type kind == "type"
  let restriction_import_name ""
  let restriction_import_item false
  let restriction_import_offset offset
}
in ts_import_specifier let restriction_import_name if type_of(imported.static_name) == "str" then imported.static_name else default(imported, local)
in ts_export_specifier let restriction_import_name if type_of(local.static_name) == "str" then local.static_name else local
in ts_import_specifier, ts_export_specifier {
  let restriction_import_source parent.restriction_import_source
  let restriction_import_type kind == "type" || parent.restriction_import_type
  let restriction_import_all_type parent.restriction_import_all_type
  let restriction_import_item true
  let restriction_import_offset offset
}
in ts_identifier {
  let restriction_import_source parent.restriction_import_source
  let restriction_import_type parent.restriction_import_type
  let restriction_import_all_type parent.restriction_import_all_type
  let restriction_import_name if field == "namespace" then "*" else "default"
  let restriction_import_item true
  let restriction_import_offset if field == "namespace" then parent.restriction_import_star_offset else offset
}
@macro restriction_import_info {
  let info if type_of(restriction_import_source) == "str" then {
    source: restriction_import_source,
    name: restriction_import_name,
    item: restriction_import_item,
    type: restriction_import_type,
    all_type: restriction_import_all_type,
    offset: restriction_import_offset,
    parents: restriction_import_parents(restriction_import_source)
  } else null
}
in ts_import, ts_export, ts_import_equals rule no-restricted-imports {
  option options restriction_import_options[] = [] "restricted paths and pattern groups"
  @restriction_import_info
  @each entry in restriction_import_paths
  when info != null && (if type_of(entry) == "str" then entry else entry.name) == info.source && entry.importNames == null && entry.allowImportNames == null && !(entry.allowTypeImports && info.all_type)
  warn "'{info.source}' import is restricted from being used." restriction_import_custom(entry)
}
in ts_import_specifier, ts_import.default_import, ts_import.namespace, ts_export_specifier, ts_export rule no-restricted-imports:names {
  option options restriction_import_options[] = [] "restricted paths and pattern groups"
  @restriction_import_info
  when info.item && info != null
  @each entry in restriction_import_paths
  when entry.name == info.source && !(entry.allowTypeImports && (info.type || info.all_type)) && (entry.importNames != null && (info.name == "*" || contains(entry.importNames, info.name)) || entry.allowImportNames != null && !contains(entry.allowImportNames, info.name))
  report at info.offset
  warn (if info.name == "*" then "* import is invalid because " (if entry.allowImportNames != null then "only " restriction_import_list(entry.allowImportNames) " from '{info.source}' " restriction_import_plural(entry.allowImportNames) " allowed." else restriction_import_list(entry.importNames) " from '{info.source}' " restriction_import_plural(entry.importNames) " restricted.") else "'{info.name}' import from '{info.source}' is restricted" (if entry.allowImportNames != null then " because only " restriction_import_list(entry.allowImportNames) " " restriction_import_plural(entry.allowImportNames) " allowed." else ".")) restriction_import_custom(entry)
}
in ts_import, ts_export, ts_import_equals rule no-restricted-imports:patterns {
  option options restriction_import_options[] = [] "restricted paths and pattern groups"
  @restriction_import_info
  when info != null
  @each entry in restriction_import_patterns
  when restriction_import_pattern_matches(entry) && !(entry.allowTypeImports && info.all_type) && entry.importNames == null && entry.allowImportNames == null && entry.importNamePattern == null && entry.allowImportNamePattern == null
  warn "'{info.source}' import is restricted from being used by a pattern." restriction_import_custom(entry)
}
in ts_import_specifier, ts_import.default_import, ts_import.namespace, ts_export_specifier, ts_export rule no-restricted-imports:pattern-names {
  option options restriction_import_options[] = [] "restricted paths and pattern groups"
  @restriction_import_info
  when info.item && info != null
  @each entry in restriction_import_patterns
  when restriction_import_pattern_matches(entry) && !(entry.allowTypeImports && (info.type || info.all_type)) && (entry.importNames != null && (info.name == "*" || contains(entry.importNames, info.name)) || entry.importNamePattern != null && (info.name == "*" || re_test(info.name, entry.importNamePattern)) || entry.allowImportNames != null && !contains(entry.allowImportNames, info.name) || entry.allowImportNamePattern != null && (info.name == "*" || !re_test(info.name, entry.allowImportNamePattern)))
  report at info.offset
  warn (if info.name == "*" then "* import is invalid because " (if entry.allowImportNames != null then "only " restriction_import_list(entry.allowImportNames) " from '{info.source}' " restriction_import_plural(entry.allowImportNames) " allowed." else if entry.allowImportNamePattern != null then "only imports that match the pattern '/{entry.allowImportNamePattern}/u' from '{info.source}' are allowed." else if entry.importNamePattern != null && entry.importNames == null then "import name matching '/{entry.importNamePattern}/u' pattern from '{info.source}' is restricted from being used." else restriction_import_list(entry.importNames) " from '{info.source}' " restriction_import_plural(entry.importNames) " restricted from being used by a pattern.") else "'{info.name}' import from '{info.source}' is restricted" (if entry.allowImportNames != null then " because only " restriction_import_list(entry.allowImportNames) " " restriction_import_plural(entry.allowImportNames) " allowed." else if entry.allowImportNamePattern != null then " because only imports that match the pattern '/{entry.allowImportNamePattern}/u' are allowed from '{info.source}'." else " from being used by a pattern.")) restriction_import_custom(entry)
}

in ts_identifier let restriction_numeric_identifier true
in ts_parenthesized {
  let restriction_numeric_identifier expression.restriction_numeric_identifier == true
  let restriction_numeric_parse_int expression.restriction_numeric_parse_int == true
}
in ts_identifier let restriction_numeric_parse_int text == "parseInt"
in ts_member, ts_index let restriction_numeric_parse_int object == "Number" && static_name == "parseInt"
in ts_call let restriction_numeric_radix callee.restriction_numeric_parse_int == true
in ts_declarator let restriction_numeric_const parent.kind == "const"
in ts_assignment {
  let restriction_numeric_default parent is ts_array && parent.write_site != null
  let restriction_numeric_object left.restriction_numeric_identifier != true
}
in ts_node {
  let restriction_numeric_type_owner if parent is (ts_union, ts_intersection, ts_parenthesized_type) then parent.restriction_numeric_type_owner else {alias: parent is ts_type_alias, indexed: parent is ts_indexed_access}
  let restriction_numeric_parent if parent is ts_parenthesized then parent.restriction_numeric_parent else {
    default: parent is ts_assignment_pattern && field == "right" || parent is ts_parameter && field == "init" || parent is ts_assignment && field == "right" && parent.restriction_numeric_default,
    class_field: parent is ts_class_property && field == "init",
    readonly: parent is ts_class_property && field == "init" && contains(parent.modifier, "readonly"),
    enum: parent is ts_enum_member,
    literal_type: parent is ts_literal_type && parent.restriction_numeric_type_owner.alias,
    type_index: parent.restriction_numeric_type_owner.indexed == true,
    declaration: parent is ts_declarator,
    constant: parent.restriction_numeric_const == true,
    object: parent is (ts_object, ts_property, ts_method) || parent is ts_assignment && parent.restriction_numeric_object,
    radix: parent is ts_call && field == "argument" && index == 1 && parent.restriction_numeric_radix,
    jsx: parent is ts_jsx_expression,
    array_index: parent is ts_index && field == "index"
  }
  let restriction_numeric_full if parent is ts_parenthesized then parent.restriction_numeric_full else if parent is ts_unary && contains(["-", "+"], parent.operator) then {sign: parent.operator, start: parent.offset, context: parent.restriction_numeric_parent} else {sign: "", start: offset, context: restriction_numeric_parent}
}
in ts_number, ts_bigint {
  let restriction_numeric_signed_type parent is ts_literal_type && starts_with(parent.text, "-")
  let restriction_numeric_sign if restriction_numeric_full.sign != "" then restriction_numeric_full.sign else if restriction_numeric_signed_type then "-" else ""
  let restriction_numeric_value if layer is ts_bigint then (if restriction_numeric_sign == "-" && literal_value.value != "0" then "-" else "") literal_value.value "n" else num(literal_value.value) * (if restriction_numeric_sign == "-" then -1 else 1)
  let restriction_numeric_offset if restriction_numeric_signed_type then parent.offset else restriction_numeric_full.start
  let restriction_numeric_ts_offset if restriction_numeric_sign == "+" then offset else restriction_numeric_offset
  let restriction_numeric_raw restriction_numeric_sign text
  let restriction_numeric_ts_raw if restriction_numeric_sign == "+" then text else restriction_numeric_raw
}
in ts_number, ts_bigint rule no-magic-numbers {
  option detectObjects boolean = false "check object property numbers"
  option enforceConst boolean = false "require const for named number declarations"
  option ignore (number | string)[] = [] "numbers and bigint strings to allow"
  option ignoreArrayIndexes boolean = false "allow valid array indices"
  option ignoreDefaultValues boolean = false "allow default values"
  option ignoreClassFieldInitialValues boolean = false "allow class field initialisers"
  option ignoreEnums boolean = false "allow enum members"
  option ignoreNumericLiteralTypes boolean = false "allow numeric type aliases"
  option ignoreReadonlyClassProperties boolean = false "allow readonly class properties"
  option ignoreTypeIndexes boolean = false "allow numeric type indices"
  let info restriction_numeric_full.context
  let typescript_specific re_test(file, /\.[cm]?tsx?$/) && (info.enum || info.literal_type || info.type_index || info.readonly)
  let array_index info.array_index && js_compare(literal_value, 0) >= 0 && js_compare(literal_value, 4294967295) < 0 && (layer is ts_bigint || restriction_numeric_value == round(restriction_numeric_value)) && (restriction_numeric_sign != "-" || num(literal_value.value) == 0)
  when !any(ignore, v => type_of(v) == type_of(restriction_numeric_value) && v == restriction_numeric_value)
  when !(ignoreArrayIndexes && array_index || ignoreDefaultValues && info.default || ignoreClassFieldInitialValues && info.class_field || ignoreEnums && info.enum || ignoreNumericLiteralTypes && info.literal_type || ignoreReadonlyClassProperties && info.readonly || ignoreTypeIndexes && info.type_index || info.radix || info.jsx)
  when if info.declaration then enforceConst && !info.constant else detectObjects || !info.object
  report at {start: if typescript_specific then restriction_numeric_ts_offset else restriction_numeric_offset, end: end_offset}
  warn if info.declaration then "Number constants declarations must use 'const'." else "No magic number: {if typescript_specific then restriction_numeric_ts_raw else restriction_numeric_raw}."
}

in ts_import_specifier let restriction_declaration_local default(local, imported)
in ts_export_specifier let restriction_declaration_local local
in ts_import {
  let restriction_declaration_export false
  let restriction_declaration_category if count(specifier) > 0 then "named" else if namespace != null then "namespace" else if default_import != null then "default" else "side"
  let restriction_declaration_count count(specifier) + (if namespace != null then 1 else 0) + (if default_import != null then 1 else 0)
  let restriction_declaration_syntax if restriction_declaration_count == 0 then "none" else if namespace != null && default_import == null then "all" else if restriction_declaration_count == 1 then "single" else "multiple"
  let restriction_declaration_local default(default_import, default(namespace, default(first([] specifier.restriction_declaration_local), "")))
}
in ts_export {
  let restriction_declaration_export true
  let restriction_declaration_category if count(specifier) > 0 then "named" else if namespace != null then "namespace" else "all"
  let restriction_declaration_count count(specifier) + (if namespace != null then 1 else 0)
  let restriction_declaration_syntax if restriction_declaration_count == 0 then "none" else if namespace != null then "all" else if restriction_declaration_count == 1 then "single" else "multiple"
  let restriction_declaration_local default(namespace, default(first([] specifier.restriction_declaration_local), ""))
}
in ts_import, ts_export let restriction_declaration_entry if from == null then null else {
  offset: offset, end: end_offset, module: default(from.static_name, ""),
  export: restriction_declaration_export, type_only: kind == "type",
  category: restriction_declaration_category, syntax: restriction_declaration_syntax,
  local: restriction_declaration_local
}
# Declaration spans contain their literal keyword; skip only impossible subtrees.
in ts_node let restriction_declarations if !contains(text, "import") && !contains(text, "export") then [] else [] restriction_declaration_entry reduce([] children.restriction_declarations, [], (entries, child) => entries child)
schema restriction_import_syntax "none" | "all" | "multiple" | "single"
@macro restriction_sort_import_options {
  option ignoreCase boolean = false "ignore letter case"
  option memberSyntaxSortOrder restriction_import_syntax[4..4] = ["none", "all", "multiple", "single"] "import syntax ordering"
  option ignoreDeclarationSort boolean = false "ignore declaration order"
  option ignoreMemberSort boolean = false "ignore named-member order"
  option allowSeparatedGroups boolean = false "reset declaration order after blank lines"
}
in ts_import rule sort-imports {
  @restriction_sort_import_options
  let preceding reduce(filter(ts_program.restriction_declarations, entry => !entry.export && entry.offset < offset), null, (nearest, entry) => if nearest == null || entry.offset > nearest.offset then entry else nearest)
  let current_index len(first(split(join(memberSyntaxSortOrder, ","), restriction_declaration_syntax)))
  let previous_index len(first(split(join(memberSyntaxSortOrder, ","), preceding.syntax)))
  let separated preceding != null && re_count(byte_slice(source, preceding.end, offset), /\n/) > 1
  when !ignoreDeclarationSort && restriction_declaration_entry != null && preceding != null && !(allowSeparatedGroups && separated)
  when restriction_declaration_syntax != preceding.syntax && current_index < previous_index || restriction_declaration_syntax == preceding.syntax && compare_text(restriction_declaration_local, preceding.local, false, ignoreCase) < 0
  warn if restriction_declaration_syntax != preceding.syntax then "Expected '{restriction_declaration_syntax}' syntax before '{preceding.syntax}' syntax." else "Imports should be sorted alphabetically."
}
in ts_import_specifier rule sort-imports:members {
  @restriction_sort_import_options
  let unsorted previous != null && compare_text(previous.restriction_declaration_local, restriction_declaration_local, false, ignoreCase) > 0
  let encountered previous.encountered == true || unsorted
  when !ignoreMemberSort && parent is ts_import && parent.restriction_declaration_entry != null && unsorted && previous.encountered != true
  report at {start: offset, end: parent.end_offset}
  warn "Member '{restriction_declaration_local}' of the import declaration should be sorted alphabetically."
}
fn restriction_import_mergeable(a, b) = !(a.type_only && b.type_only && (a.category == "default" && b.category == "named" || a.category == "named" && b.category == "default")) && !(a.category == "all" && contains(["named", "namespace", "default"], b.category) || b.category == "all" && contains(["named", "namespace", "default"], a.category) || a.category == "namespace" && b.category == "named" || a.category == "named" && b.category == "namespace")
@macro restriction_duplicate_import_body {
  option includeExports boolean = false "also check re-exports"
  option allowSeparateTypeImports boolean = false "allow separate type and value imports"
  let own restriction_declaration_entry
  let module trim(own.module)
  when own != null && module != "" && (includeExports || !own.export && !previous_export)
  when any(ts_program.restriction_declarations, entry => entry.offset < offset && entry.export == previous_export && trim(entry.module) == module && (!allowSeparateTypeImports || entry.type_only == own.type_only) && restriction_import_mergeable(own, entry))
  warn "'{module}' {if own.export then 'export' else 'import'} is duplicated{if own.export == previous_export then '' else if own.export then ' as import' else ' as export'}."
}
in ts_import, ts_export rule no-duplicate-imports {
  let previous_export false
  @restriction_duplicate_import_body
}
in ts_import, ts_export rule no-duplicate-imports:exports {
  let previous_export true
  @restriction_duplicate_import_body
}

in ts_declarator rule sort-vars {
  option ignoreCase boolean = false "ignore letter case"
  let simple_name name.layer is ts_identifier
  let greatest if !simple_name then previous.greatest else if previous.greatest == null || compare_text(name, previous.greatest, false, ignoreCase) >= 0 then name else previous.greatest
  when simple_name && previous.greatest != null && compare_text(name, previous.greatest, false, ignoreCase) < 0
  report at {start: offset, end: parent.end_offset}
  warn "Variables within the same declaration block should be sorted alphabetically."
}
in ts_identifier let restriction_sort_key_name text
in ts_computed_key let restriction_sort_key_name if expression.layer is ts_identifier then expression else null
in ts_property, ts_method {
  let restriction_sort_computed key.layer is ts_computed_key
  let restriction_sort_key_fallback key.restriction_sort_key_name
  let restriction_sort_key_offset key.offset
}
in ts_object let restriction_sort_key_count count(property)
in ts_property, ts_method, ts_spread rule sort-keys {
  option mode "asc" | "desc" = "asc" "key order"
  option caseSensitive boolean = true "compare letter case"
  option natural boolean = false "compare digit sequences numerically"
  option minKeys int(2..) = 2 "minimum object properties"
  option allowLineSeparatedGroups boolean = false "reset sorting after blank lines"
  option ignoreComputedKeys boolean = false "reset sorting at computed keys"
  let reset layer is ts_spread || ignoreComputedKeys && restriction_sort_computed
  let name if reset then null else if type_of(static_name) == "str" then static_name else restriction_sort_key_fallback
  let carried if reset then null else if type_of(name) == "str" then name else previous.carried
  let blank_gap re_test(default(gap_before, ""), /\n\s*\n/)
  let pending_blank if reset then previous.pending_blank else allowLineSeparatedGroups && (previous.pending_blank == true || blank_gap) && type_of(name) != "str"
  let separated previous.pending_blank == true || blank_gap
  let order compare_text(previous.carried, name, natural, !caseSensitive)
  when parent is ts_object && parent.restriction_sort_key_count >= minKeys
  when !reset && type_of(name) == "str" && type_of(previous.carried) == "str" && !(allowLineSeparatedGroups && separated)
  when if mode == "asc" then order > 0 else order < 0
  report at {start: restriction_sort_key_offset, end: parent.end_offset}
  warn "Expected object keys to be in {if natural then 'natural ' else ''}{if caseSensitive then '' else 'insensitive '}{mode}ending order. '{name}' should be before '{previous.carried}'."
}

in ts_conditional rule no-ternary warn "Ternary operator used."

in ts_conditional let restriction_ternary true
in ts_parenthesized let restriction_ternary expression.restriction_ternary == true
in ts_conditional rule no-nested-ternary {
  when consequent.restriction_ternary == true || alternate.restriction_ternary == true
  warn "Do not nest ternary expressions."
}
in ts_continue rule no-continue warn "Unexpected use of continue statement."
in ts_parenthesized, ts_unary let restriction_statement_position if parent is ts_parenthesized then parent.restriction_statement_position else parent is ts_expression_statement
in ts_parenthesized, ts_sequence, ts_update let restriction_for_update if parent is (ts_parenthesized, ts_sequence) then parent.restriction_for_update else parent is ts_for && field == "update"
in ts_unary rule no-void {
  option allowAsStatement boolean = false "allow void as an expression statement"
  when operator == "void" && !(allowAsStatement && restriction_statement_position)
  warn "Expected 'undefined' and instead saw 'void'."
}
in ts_update rule no-plusplus {
  option allowForLoopAfterthoughts boolean = false "allow updates in for loop afterthoughts"
  when !(allowForLoopAfterthoughts && restriction_for_update)
  warn "Unary operator '{operator}' used."
}
in ts_binary, ts_assignment rule no-bitwise {
  option allow ("^" | "|" | "&" | "<<" | ">>" | ">>>" | "^=" | "|=" | "&=" | "<<=" | ">>=" | ">>>=" | "~")[] = [] "bitwise operators to allow"
  option int32Hint boolean = false "allow bitwise or with zero"
  let value right.literal_value
  when contains(["^", "|", "&", "<<", ">>", ">>>", "^=", "|=", "&=", "<<=", ">>=", ">>>=", "~"], operator)
  when !contains(allow, operator) && !(int32Hint && operator == "|" && value.value == "0")
  warn "Unexpected use of '{operator}'."
}
in ts_unary rule no-bitwise:unary {
  option allow ("^" | "|" | "&" | "<<" | ">>" | ">>>" | "^=" | "|=" | "&=" | "<<=" | ">>=" | ">>>=" | "~")[] = [] "bitwise operators to allow"
  option int32Hint boolean = false "allow bitwise or with zero"
  when operator == "~" && !contains(allow, operator)
  warn "Unexpected use of '{operator}'."
}
in ts_identifier rule no-undefined {
  when text == "undefined" && (declaration_kind != null || resolved == "local" || global == "readonly" || global == "writable")
  warn "Unexpected use of undefined."
}
in ts_identifier {
  let restriction_window_object resolved == "global" && (text == "window" || text == "globalThis" && global != null)
  let restriction_called_name if resolved == "global" then text else null
}
in ts_this let restriction_window_object ts_function == null && ts_arrow == null && ts_method == null && ts_static_block == null
in ts_parenthesized {
  let restriction_window_object expression.restriction_window_object == true
  let restriction_called_name expression.restriction_called_name
}
in ts_member, ts_index let restriction_called_name if object.restriction_window_object == true then static_name else null
in ts_call rule no-alert {
  let name callee.restriction_called_name
  when contains(["alert", "confirm", "prompt"], name)
  warn "Unexpected {name}."
}
in ts_labeled let restriction_target_kind if body.layer is ts_loop then "loop" else if body.layer is ts_switch then "switch" else "other"
in ts_labeled let restriction_label_entry {name: label, kind: restriction_target_kind}
in ts_statement, ts_case let restriction_label_targets default(parent.restriction_label_targets, []) (if layer is ts_labeled then [restriction_label_entry] else [])
in ts_break, ts_continue let restriction_target_kind default((find_last(restriction_label_targets, target => target.name == label)).kind, "other")
in ts_labeled rule no-labels {
  option allowLoop boolean = false "allow labels on loops"
  option allowSwitch boolean = false "allow labels on switches"
  when !(allowLoop && restriction_target_kind == "loop" || allowSwitch && restriction_target_kind == "switch")
  warn "Unexpected labeled statement."
}
in ts_break rule no-labels:break {
  option allowLoop boolean = false "allow labels on loops"
  option allowSwitch boolean = false "allow labels on switches"
  when label != null
  when !(allowLoop && restriction_target_kind == "loop" || allowSwitch && restriction_target_kind == "switch")
  warn "Unexpected label in break statement."
}
in ts_continue rule no-labels:continue {
  option allowLoop boolean = false "allow labels on loops"
  option allowSwitch boolean = false "allow labels on switches"
  when label != null
  when !(allowLoop && restriction_target_kind == "loop" || allowSwitch && restriction_target_kind == "switch")
  warn "Unexpected label in continue statement."
}

macro restriction_function_name (upper(slice(default(function_name, "function"), 0, 1)) slice(default(function_name, "function"), 1))
group restriction_flow_control ts_conditional, ts_logical, ts_for, ts_for_in, ts_for_of, ts_if, ts_while, ts_do_while, ts_assignment_pattern
in ts_parameter let restriction_parameter_branch init != null
in ts_try let restriction_catch_branch handler != null
in ts_assignment let restriction_assignment_branch contains(["&&=", "||=", "??="], operator)
in ts_member, ts_index, ts_call let restriction_optional_branch optional != null
in ts_case let restriction_case_branch test != null
in ts_block let restriction_local_statements count(body)
in ts_node {
  let restriction_metric_boundary layer is (ts_function_like, ts_static_block) || parent is ts_class_property && field == "init"
  let restriction_flow_branch layer is restriction_flow_control || restriction_parameter_branch == true || restriction_catch_branch == true || restriction_assignment_branch == true || restriction_optional_branch == true
  let restriction_subtree_statements default(restriction_local_statements, 0) + sum(children.restriction_statement_contribution)
  let restriction_statement_contribution if restriction_metric_boundary then 0 else restriction_subtree_statements
  let restriction_subtree_classic (if restriction_flow_branch then 1 else 0) + (if restriction_case_branch == true then 1 else 0) + sum(children.restriction_classic_contribution)
  let restriction_classic_contribution if restriction_metric_boundary then 0 else restriction_subtree_classic
  let restriction_subtree_modified (if restriction_flow_branch then 1 else 0) + (if layer is ts_switch then 1 else 0) + sum(children.restriction_modified_contribution)
  let restriction_modified_contribution if restriction_metric_boundary then 0 else restriction_subtree_modified
  let restriction_function_depth default(parent.restriction_function_depth, 0) + (if parent is (ts_function_like, ts_static_block) then 1 else 0)
  let restriction_ordinary_function_depth default(parent.restriction_ordinary_function_depth, 0) + (if parent is ts_function_like then 1 else 0)
  let restriction_top_functions (if layer is ts_function_like && restriction_ordinary_function_depth == 0 then 1 else 0) + sum(children.restriction_top_functions)
  let restriction_call_argument if parent is ts_parenthesized then parent.restriction_call_argument else parent is ts_call && field == "argument"
  let restriction_constructor_argument if parent is ts_parenthesized then parent.restriction_constructor_argument else parent is (ts_call, ts_new) && field == "argument"
  let restriction_iife if parent is ts_parenthesized then parent.restriction_iife else parent is ts_call && field == "callee"
  let restriction_callback layer is (ts_function_like, ts_static_block) && restriction_call_argument
  let restriction_constructor_callback layer is (ts_function_like, ts_static_block) && restriction_constructor_argument
  let restriction_callbacks default(parent.restriction_callbacks, 0) + (if restriction_callback then 1 else 0)
  let restriction_constructor_callbacks default(parent.restriction_constructor_callbacks, 0) + (if restriction_constructor_callback then 1 else 0)
  let restriction_classes (if layer is ts_class then 1 else 0) + sum(children.restriction_classes)
  let restriction_class_declarations (if layer is ts_class && parent is (ts_program, ts_block, ts_export) then 1 else 0) + sum(children.restriction_class_declarations)
}
group restriction_parameter_function ts_function, ts_arrow, ts_method, ts_function_type
in ts_parameter {
  let restriction_this_parameter name == "this"
  let restriction_void_this_parameter name == "this" && type == "void"
}
in restriction_parameter_function rule max-params {
  option max int(0..) = 3 "maximum parameters"
  option maximum int(0..) | null = null "legacy maximum parameters"
  option countVoidThis boolean = false "count a void this parameter"
  option countThis "never" | "except-void" | "always" = "except-void" "whether to count this parameters"
  let this_parameter first([] parameter.restriction_this_parameter) == true
  let void_this_parameter first([] parameter.restriction_void_this_parameter) == true
  let amount count(parameter) - (if this_parameter && (countThis == "never" || countThis == "except-void" && !countVoidThis && void_this_parameter) then 1 else 0)
  let limit default(maximum, max)
  when amount > limit
  report at default(function_head, offset)
  warn "{restriction_function_name} has too many parameters ({amount}). Maximum allowed is {limit}."
}
in ts_function_like rule max-statements {
  option max int(0..) = 10 "maximum statements"
  option maximum int(0..) | null = null "legacy maximum statements"
  option ignoreTopLevelFunctions boolean = false "ignore a sole top-level function"
  let limit default(maximum, max)
  when restriction_subtree_statements > limit
  when !(ignoreTopLevelFunctions && restriction_function_depth == 0 && ts_program.restriction_top_functions == 1)
  report at function_head
  warn "{restriction_function_name} has too many statements ({restriction_subtree_statements}). Maximum allowed is {limit}."
}
in ts_function_like rule complexity {
  option max int(0..) = 20 "maximum cyclomatic complexity"
  option maximum int(0..) | null = null "legacy maximum complexity"
  option variant "classic" | "modified" = "classic" "how switches contribute"
  let amount 1 + (if variant == "classic" then restriction_subtree_classic else restriction_subtree_modified)
  let limit default(maximum, max)
  when amount > limit
  report at function_head
  warn "{restriction_function_name} has a complexity of {amount}. Maximum allowed is {limit}."
}
in ts_static_block, ts_class_property.init rule complexity:implicit {
  option max int(0..) = 20 "maximum cyclomatic complexity"
  option maximum int(0..) | null = null "legacy maximum complexity"
  option variant "classic" | "modified" = "classic" "how switches contribute"
  let amount if layer is (ts_function, ts_arrow) then 1 else 1 + (if variant == "classic" then restriction_subtree_classic else restriction_subtree_modified)
  let limit default(maximum, max)
  when amount > limit
  warn "{if layer == 'ts_static_block' then 'Class static block' else 'Class field initializer'} has a complexity of {amount}. Maximum allowed is {limit}."
}
group restriction_depth_control ts_if, ts_switch, ts_try, ts_do_while, ts_while, ts_with, ts_for, ts_for_in, ts_for_of
in ts_statement, ts_arrow, ts_method, ts_static_block, ts_case let restriction_nesting if layer is (ts_function_like, ts_static_block) then 0 else default(parent.restriction_nesting, 0) + (if layer is restriction_depth_control && !(layer is ts_if && parent is ts_if && field == "alternate") then 1 else 0)
in restriction_depth_control rule max-depth {
  option max int(0..) = 4 "maximum control-flow nesting"
  option maximum int(0..) | null = null "legacy maximum nesting"
  let limit default(maximum, max)
  when !(layer == "ts_if" && parent == "ts_if" && field == "alternate")
  when restriction_nesting > limit
  warn "Blocks are nested too deeply ({restriction_nesting}). Maximum allowed is {limit}."
}
in ts_function, ts_arrow rule max-nested-callbacks {
  option max int(0..) = 10 "maximum callback nesting"
  option maximum int(0..) | null = null "legacy maximum callback nesting"
  option checkConstructorCallCallbacks boolean = false "count callbacks passed to constructors"
  let amount if checkConstructorCallCallbacks then restriction_constructor_callbacks else restriction_callbacks
  let callback if checkConstructorCallCallbacks then restriction_constructor_callback else restriction_callback
  let limit default(maximum, max)
  when callback && amount > limit
  report at function_head
  warn "Too many nested callbacks ({amount}). Maximum allowed is {limit}."
}
in ts_program rule max-classes-per-file {
  option max int(1..) = 1 "maximum classes"
  option ignoreExpressions boolean = false "count only class declarations"
  let amount if ignoreExpressions then restriction_class_declarations else restriction_classes
  when amount > max
  report at default(first([] body.offset), 0)
  warn "File has too many classes ({amount}). Maximum allowed is {max}."
}
fn restriction_line_previous(items, item) = last(slice(items, index_of(items, item) - 1, index_of(items, item)))
fn restriction_line_comment_gap(source, items, item, start, end) = byte_slice(source, max(start, default(restriction_line_previous(items, item).end_offset, start)), max(start, min(end, item.offset)))
in ts_line {
  let restriction_line_comments overlapping(ts_comment)
  let restriction_line_blank trim(text) == ""
  let restriction_line_comment count(restriction_line_comments) > 0 && all(restriction_line_comments, item => trim(restriction_line_comment_gap(source, restriction_line_comments, item, offset, end_offset)) == "") && trim(byte_slice(source, min(end_offset, max(offset, last(restriction_line_comments).end_offset)), end_offset)) == ""
}
in ts_program, ts_function_like let restriction_line_rows overlapping(ts_line)
in ts_program rule max-lines {
  option max int(0..) = 300 "maximum lines"
  option skipComments boolean = false "exclude comment-only lines"
  option skipBlankLines boolean = false "exclude blank lines"
  let lines filter(restriction_line_rows, l => !(skipComments && l.restriction_line_comment || skipBlankLines && l.restriction_line_blank))
  let amount if source == "" && !skipBlankLines then 1 else len(lines)
  when amount > max
  report at default(first(slice(lines, max)).offset, offset)
  warn "File has too many lines ({amount}). Maximum allowed is {max}."
}
in ts_function_like rule max-lines-per-function {
  option max int(0..) = 50 "maximum function lines"
  option skipComments boolean = false "exclude comment-only lines"
  option skipBlankLines boolean = false "exclude blank lines"
  option IIFEs boolean = false "also check immediately invoked functions"
  let lines filter(restriction_line_rows, l => !(skipComments && l.restriction_line_comment || skipBlankLines && l.restriction_line_blank))
  when IIFEs || !restriction_iife
  when len(lines) > max
  report at function_head
  warn "{restriction_function_name} has too many lines ({len(lines)}). Maximum allowed is {max}."
}

macro restriction_directive(x) re_test(x, /^\s*(?:eslint(?:[- ]|$)|globals?\s|exported\s)/)
in ts_program {
  let restriction_comment_catalog descendants(ts_comment)
  let restriction_comment_line_catalog overlapping(ts_line)
}
in ts_comment {
  let restriction_comment_body slice(text, 2, if layer is ts_block_comment then len(text) - 2 else len(text))
  let restriction_comment_clean replace(restriction_comment_body, "*", "")
  let restriction_comment_lowercase re_test(restriction_comment_clean, /^\s*\p{Lowercase}/)
  let restriction_comment_uppercase re_test(restriction_comment_clean, /^\s*\p{Uppercase}/)
  let restriction_comment_prefix byte_slice(source, position(offset).js_line_start, offset)
  let restriction_comment_line_end first(slice(ts_program.restriction_comment_line_catalog, position(end_offset).js_line - 1, position(end_offset).js_line)).end_offset
  let restriction_comment_suffix byte_slice(source, end_offset, restriction_comment_line_end)
  let restriction_comment_preamble trim(restriction_comment_prefix) != ""
  let restriction_comment_postamble trim(restriction_comment_suffix) != ""
  let restriction_comment_empty_jsx parent is ts_jsx_expression && parent.expression == null && (!restriction_comment_preamble || trim(restriction_comment_prefix) == "{{") && (!restriction_comment_postamble || trim(restriction_comment_suffix) == "}}")
  let restriction_comment_index index_of(ts_program.restriction_comment_catalog, node)
  let restriction_comment_previous last(slice(ts_program.restriction_comment_catalog, restriction_comment_index - 1, restriction_comment_index))
  let restriction_comment_consecutive restriction_comment_previous != null && trim(byte_slice(source, restriction_comment_previous.end_offset, offset)) == ""
}
in ts_comment rule no-inline-comments {
  option ignorePattern regex = "" "comments to ignore"
  when (restriction_comment_preamble || restriction_comment_postamble) && !restriction_comment_empty_jsx && !restriction_directive(restriction_comment_body) && !(ignorePattern != "" && re_test(restriction_comment_body, ignorePattern))
  report at {start: offset, end: ts_program.end_offset}
  warn "Unexpected comment inline with code."
}
in ts_comment rule no-warning-comments {
  option terms string[] = ["todo", "fixme", "xxx"] "warning terms"
  option location "start" | "anywhere" = "start" "where warning terms may occur"
  option decoration string(1..1)[] = [] "characters ignored before a starting warning"
  let body re_replace(re_replace(text, /^\/[\/*]/, ""), /\*\/$/, "")
  let compact re_replace(trim(body), /\s+/, " ")
  let short trim(default(re_find(compact, /^.{0,40}(?:\s|$)/), ""))
  let display short (if len(compact) > len(short) then "..." else "")
  when !(restriction_directive(body) && re_test(body, /\bno-warning-comments\b/))
  @each term in terms
  when re_test(body, "(?i)" (if location == "start" then "^[\\s" re_escape(join(decoration, "")) "]*" else if re_test(term, /^\w/) then "\\b" else "") re_escape(term) (if re_test(term, /\w$/) then "\\b" else ""))
  warn "Unexpected '{term}' comment: '{display}'."
}
schema restriction_comment_case {
  ignorePattern: regex = ""
  ignoreInlineComments: boolean = false
  ignoreConsecutiveComments: boolean = false
}
in ts_comment rule capitalized-comments {
  option mode "always" | "never" = "always" "required initial letter case"
  option ignorePattern regex = "" "starting comment text to ignore"
  option ignoreInlineComments boolean = false "ignore comments surrounded by code"
  option ignoreConsecutiveComments boolean = false "ignore comments following comments"
  option line restriction_comment_case | null = null "line-comment overrides"
  option block restriction_comment_case | null = null "block-comment overrides"
  let line_options default(line, {ignorePattern: ignorePattern, ignoreInlineComments: ignoreInlineComments, ignoreConsecutiveComments: ignoreConsecutiveComments})
  let block_options default(block, {ignorePattern: ignorePattern, ignoreInlineComments: ignoreInlineComments, ignoreConsecutiveComments: ignoreConsecutiveComments})
  let options if layer is ts_block_comment then block_options else line_options
  when (if mode == "always" then restriction_comment_lowercase else restriction_comment_uppercase)
    && !re_test(restriction_comment_body, /^\s*(?:eslint|jshint\s+|jslint\s+|istanbul\s+|globals?\s+|exported\s+|jscs)/)
    && !re_test(restriction_comment_clean, /^\s*[^:/?#\s]+:\/\/[^?#]/)
    && !(options.ignoreInlineComments && restriction_comment_preamble && restriction_comment_postamble)
    && !(options.ignoreConsecutiveComments && restriction_comment_consecutive)
    && !(options.ignorePattern != "" && re_test(restriction_comment_clean, "^\\s*(?:" options.ignorePattern ")"))
  report at {start: offset, end: ts_program.end_offset}
  warn if mode == "always" then "Comments should not begin with a lowercase character." else "Comments should not begin with an uppercase character."
}

in ts_object {
  let restriction_import_options parent is ts_import_call
  let restriction_import_attributes parent.restriction_import_attribute_group == true
}
in ts_property, ts_pattern_property {
  let restriction_import_options_key parent.restriction_import_options == true || parent.restriction_import_attributes == true
  let restriction_import_attribute_group parent.restriction_import_options == true && contains(["with", "assert"], static_name)
  let restriction_name_pattern layer is ts_pattern_property || parent.write_site != null
  let restriction_name_alias restriction_name_pattern && value != null && (value.layer not ts_assignment_pattern || value.left != null)
  let restriction_name_same value != null && key == default(value.left, value)
}
in ts_export_specifier {
  let restriction_name_reexport parent.from != null
  let restriction_name_export_alias exported != null
}
in ts_class let restriction_name_declaration parent is (ts_program, ts_block, ts_export)
in ts_member let restriction_name_mutation parent not ts_update && !(parent is ts_unary && parent.operator == "delete")
in ts_identifier, ts_private_name {
  let restriction_identifier_name re_replace(text, /^#*/, "")
  let restriction_name_external contains(["readonly", "writable"], global)
  let restriction_name_attributes field == "key" && parent is ts_property && parent.restriction_import_options_key == true
  let restriction_name_pattern parent.restriction_name_pattern == true
  let restriction_name_alias field == "key" && parent.restriction_name_alias == true
  let restriction_name_same parent.restriction_name_same == true
  let restriction_name_assignment parent is ts_member && field == "property" && parent.write_site != null && parent.restriction_name_mutation
  let restriction_name_renamed parent is ts_import_specifier && field == "imported" && parent.local != null || parent is ts_export_specifier && field == "local" && parent.restriction_name_export_alias && parent.restriction_name_reexport
  let restriction_name_property field == "key" && (if restriction_name_pattern then !restriction_name_alias || restriction_name_same else parent is ts_property) || restriction_name_assignment
  let restriction_name_length if parent is (ts_declarator, ts_parameter) then field == "name" else if parent is ts_assignment_pattern then field == "left" else if restriction_name_pattern then (if field == "key" then !restriction_name_alias || restriction_name_same else !restriction_name_same) else if parent is ts_property then field == "key" else if parent is ts_import_specifier then field == "local" && default(parent.imported.static_name, parent.imported) != restriction_identifier_name else if parent is ts_import then contains(["default_import", "namespace"], field) else if parent is (ts_function, ts_arrow, ts_method, ts_class_property, ts_rest, ts_array_pattern) then true else if parent is ts_class then parent.restriction_name_declaration else if parent is ts_try then field == "parameter" else if parent is ts_member then restriction_name_assignment else false
}
in ts_identifier, ts_private_name rule id-denylist {
  option options string[] = [] "restricted identifiers"
  when !restriction_name_external && !restriction_name_attributes && !restriction_name_renamed && !restriction_name_alias
  when parent not (ts_call, ts_new, ts_meta_property) && !(parent is ts_member && field == "property" && !restriction_name_assignment)
  when contains(options, restriction_identifier_name)
  warn "Identifier '{text}' is restricted."
}
in ts_identifier, ts_private_name rule id-length {
  option min int = 2 "minimum identifier length"
  option max int | null = null "maximum identifier length"
  option properties "always" | "never" = "always" "check author-defined properties"
  option exceptions string[] = [] "names exempt from length limits"
  option exceptionPatterns regex[] = [] "name patterns exempt from length limits"
  let amount graphemes(restriction_identifier_name)
  when restriction_name_length && !restriction_name_attributes && !(properties == "never" && restriction_name_property)
  when !contains(exceptions, restriction_identifier_name) && !any(exceptionPatterns, p => re_test(restriction_identifier_name, p))
  when amount < min || max != null && amount > max
  warn if amount < min then "Identifier name '{text}' is too short (< {min})." else "Identifier name '{text}' is too long (> {max})."
}
in ts_identifier, ts_private_name rule id-match {
  option mode regex = "^.+$" "required identifier pattern"
  option properties boolean = false "check properties"
  option classFields boolean = false "check class fields"
  option onlyDeclarations boolean = false "check only declarations"
  option ignoreDestructuring boolean = false "ignore existing destructured names"
  let check if layer is ts_private_name then parent not ts_class_property || classFields else if parent is ts_member then properties && (field == "object" || restriction_name_assignment) else if restriction_name_pattern then !restriction_name_alias && !(ignoreDestructuring && (field == "key" || restriction_name_same)) else if parent is ts_property && field == "key" then properties else if parent is ts_assignment_pattern then field == "left" && properties && !ignoreDestructuring else if parent is ts_import_specifier then field == "local" || field == "imported" && parent.local == null else if parent is ts_import then contains(["default_import", "namespace"], field) else if parent is ts_class_property then classFields else if parent is (ts_call, ts_new, ts_meta_property) then false else !onlyDeclarations || parent is (ts_function, ts_declarator)
  when !restriction_name_external && !restriction_name_attributes && check
  when !re_test(restriction_identifier_name, mode)
  warn "Identifier '{text}' does not match the pattern '{mode}'."
}
schema restriction_global string | {name: string; message?: string}
schema restriction_globals {
  globals: restriction_global[]
  checkGlobalObject: boolean = false
  globalObjects: string[] = []
}
in ts_identifier rule no-restricted-globals {
  option options (restriction_global | restriction_globals)[] = [] "restricted globals and global-object settings"
  let config first(options)
  let globals default(config.globals, options)
  let matched find_last(globals, g => (if type_of(g) == "str" then g else g.name) == text)
  when resolved == "global" && access != "type" && matched != null
  when parent not (ts_type_reference, ts_qualified_name, ts_type_query)
  warn "Unexpected use of '{text}'." (if matched.message != null && matched.message != "" then " " matched.message else "")
}
in ts_identifier let restriction_global_root if resolved == "global" && contains(["readonly", "writable"], global) then text else null
in ts_parenthesized let restriction_global_root expression.restriction_global_root
in ts_member, ts_index let restriction_global_root if static_name == object.restriction_global_root then object.restriction_global_root else null
in ts_member let restriction_global_property_offset property.offset
in ts_index let restriction_global_property_offset index.offset
in ts_member, ts_index rule no-restricted-globals:member {
  option options (restriction_global | restriction_globals)[] = [] "restricted globals and global-object settings"
  let config first(options)
  let root object.restriction_global_root
  let name static_name
  let matched find_last(config.globals, g => (if type_of(g) == "str" then g else g.name) == name)
  when config.checkGlobalObject && root != null && type_of(name) == "str" && contains(["globalThis", "self", "window"] default(config.globalObjects, []), root) && matched != null
  report at restriction_global_property_offset
  warn "Unexpected use of '{name}'." (if matched.message != null && matched.message != "" then " " matched.message else "")
}
schema restriction_property {
  object?: string
  property?: string
  allowObjects?: string[]
  allowProperties?: string[]
  message?: string
}
fn restriction_property_match(object, name, options) = default(find_last(options, o => o.object != null && o.object == object && (o.property == name || o.property == null) && !contains(default(o.allowProperties, []), name)), find_last(options, o => o.object == null && o.property == name && !contains(default(o.allowObjects, []), object)))
in ts_identifier let restriction_object_name text
in ts_parenthesized let restriction_object_name expression.restriction_object_name
in ts_declarator, ts_parameter let restriction_pattern_object init.restriction_object_name
in ts_assignment, ts_assignment_pattern let restriction_pattern_object right.restriction_object_name
in ts_object_pattern, ts_object {
  let restriction_property_object parent.restriction_pattern_object
  let restriction_property_pattern layer is ts_object_pattern || write_site != null
  let restriction_property_offset offset
}
@macro restriction_property_body {
  option options restriction_property[] = [] "restricted object properties"
  let matched restriction_property_match(object_name, property_name, options)
  when type_of(property_name) == "str" && matched != null
  warn (if matched.object != null then "'{object_name}.{property_name}' is restricted from being used." (if matched.allowProperties != null then " Only these properties are allowed: {join(matched.allowProperties, ', ')}." else "") else "'{property_name}' is restricted from being used." (if matched.allowObjects != null then " Property '{property_name}' is only allowed on these objects: {join(matched.allowObjects, ', ')}." else "")) (if matched.message != null && matched.message != "" then " " matched.message else "")
}
in ts_member, ts_index rule no-restricted-properties {
  let object_name object.restriction_object_name
  let property_name static_name
  @restriction_property_body
}
in ts_pattern_property, ts_property rule no-restricted-properties:patterns {
  let object_name parent.restriction_property_object
  let property_name static_name
  when parent is (ts_object_pattern, ts_object) && parent.restriction_property_pattern
  report at {start: parent.restriction_property_offset, end: parent.end_offset}
  @restriction_property_body
}
schema restriction_default_exports {
  direct: boolean = false
  named: boolean = false
  defaultFrom: boolean = false
  namedFrom: boolean = false
  namespaceFrom: boolean = false
}
@macro restriction_export_options {
  option restrictedNamedExports string[] = [] "restricted exported names"
  option restrictedNamedExportsPattern regex = "" "restricted exported-name pattern"
  option restrictDefaultExports restriction_default_exports = {} "restricted default-export forms"
}
fn restriction_export_forbidden(name, names, pattern) = contains(names, name) || name != "default" && pattern != "" && re_test(name, pattern)
in ts_variable_declaration let restriction_exported_declaration parent is ts_export && parent.kind != "default"
in ts_declarator let restriction_exported_declaration parent.restriction_exported_declaration == true
in ts_export rule no-restricted-exports {
  @restriction_export_options
  when kind == "default" && restrictDefaultExports.direct
  warn "Exporting 'default' is restricted."
}
in ts_identifier rule no-restricted-exports:declarations {
  @restriction_export_options
  let export_name text
  when (exported && declaration_kind != null || parent is ts_declarator && field == "name" && parent.restriction_exported_declaration) && ts_export != null && ts_export.kind != "default"
  when restriction_export_forbidden(export_name, restrictedNamedExports, restrictedNamedExportsPattern)
  report at {start: offset, end: ts_export.end_offset}
  warn "'{export_name}' is restricted from being used as an exported name."
}
in ts_export_specifier rule no-restricted-exports:names {
  @restriction_export_options
  let export_name if exported == null then (if local.layer is ts_string then local.static_name else local) else (if exported.layer is ts_string then exported.static_name else exported)
  let export_form if parent.from == null then "named" else if default(local.static_name, local) == "default" then "defaultFrom" else "namedFrom"
  let restricted_name restriction_export_forbidden(export_name, restrictedNamedExports, restrictedNamedExportsPattern)
  when restricted_name || export_name == "default" && (if export_form == "named" then restrictDefaultExports.named else if export_form == "defaultFrom" then restrictDefaultExports.defaultFrom else restrictDefaultExports.namedFrom)
  report at {start: default(exported.offset, local.offset), end: parent.end_offset}
  warn if restricted_name then "'{export_name}' is restricted from being used as an exported name." else "Exporting 'default' is restricted."
}
in ts_export.namespace rule no-restricted-exports:namespace {
  @restriction_export_options
  let export_name if layer is ts_string then static_name else text
  let restricted_name restriction_export_forbidden(export_name, restrictedNamedExports, restrictedNamedExportsPattern)
  when restricted_name || export_name == "default" && restrictDefaultExports.namespaceFrom
  report at {start: offset, end: parent.end_offset}
  warn if restricted_name then "'{export_name}' is restricted from being used as an exported name." else "Exporting 'default' is restricted."
}

}
