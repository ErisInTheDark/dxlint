# .ts/assertions: type-aware assertion policy.

define {

@macro assertion_options {
  option checkLiteralConstAssertions boolean = false "Check literal const assertions"
  option typesToIgnore string[] = [] "Ignore these written assertion types"
}

fn assertion_outer(n) = last(walk(n, current => if current.parent is ts_parenthesized then current.parent else null))
fn assertion_literal_preserved(n) = assertion_outer(n).parent is ts_declarator && assertion_outer(n).parent.parent.kind == "const" || assertion_outer(n).parent is ts_class_property && contains([] assertion_outer(n).parent.modifier, "readonly")
fn assertion_call(n) = last(walk(unparenthesised_node(n), current => if current is ts_await then unparenthesised_node(current.argument.node) else if current is ts_non_null then unparenthesised_node(current.expression.node) else if current is ts_sequence then unparenthesised_node(last([] current.expression.node)) else null))
fn assertion_generic_call(n) = assertion_call(n) is ts_call && assertion_call(n).type_argument == null && count(assertion_call(n).type_parameter_defaults) > 0
fn assertion_type_same(source, target, relation) = relation.identity == true || source.contains_any == false && target.contains_any == false && !(target.contains_variable == true && (source.contains_variable != true || target.intersection)) && !(source.nonprimitive && !target.nonprimitive) && source.index_signature == target.index_signature && assertion_generics_preserved(source, target) && assertion_generics_preserved(target, source) && relation.properties_equal == true && relation.type_arguments_equal == true && relation.assignable == true && relation.reverse_assignable == true
fn assertion_same(r) = assertion_type_same(r.operand, r.annotation, r.operand_annotation) || r.operand.property_bag && assertion_type_same(r.widened_operand, r.annotation, r.widened_operand_annotation)
fn assertion_generics_preserved(source, target) = source.generic_properties != null && target.generic_properties != null && all(target.generic_properties, name => contains(source.generic_properties, name))
fn assertion_context_known(n, r) = r.context.contains_any == false || r.context.any && assertion_outer(n).parent is (ts_call, ts_new) && r.annotation.contains_any == false
fn assertion_context(n, r) = r.context != null && assertion_context_known(n, r) && r.operand.contains_any == false && assertion_generics_preserved(r.operand, r.context) && r.operand_context.assignable == true && r.operand_context.type_arguments_equal == true && !(r.annotation.union && (r.operand.null || r.operand.undefined))
fn assertion_unassigned(n) = n is ts_identifier && (n.declaration == null && n.resolved != "global" || n.declaration.parent is ts_declarator && n.declaration.ambient != true && (n.declaration.parent.init == null && first(slice(n.declaration.parent.token_texts, 1, 2)) != "!" || n.declaration.parent.parent.kind == "var" && any(walk(n.declaration.parent.parent.parent, current => current.parent), current => current is ts_block && (n.offset < current.offset || n.end_offset > current.end_offset))))
fn assertion_non_null_context(r) = r.context != null && r.actual_constrained.identity == true && (!r.operand.unknown || r.context.unknown) && (!r.operand.null || r.context.null) && (!r.operand.undefined || r.context.undefined) && (!r.operand.void || r.context.void)
fn assertion_receiver(n) = last(walk(n, current => if current.parent is (ts_parenthesized, ts_property, ts_object, ts_array, ts_conditional, ts_logical, ts_sequence) then current.parent else null)).parent
fn assertion_context_safe(n) = !(assertion_receiver(n) is (ts_as, ts_type_assertion, ts_satisfies)) && !(assertion_outer(n).parent is (ts_assignment, ts_logical) && assertion_outer(n).parent.operator != "||") && !(assertion_outer(n).parent is ts_property && assertion_outer(n).parent.parent.type_relations.context.union)
fn assertion_fresh_literal(n, r, written) = unparenthesised_node(n.expression.node) is ts_object && r.annotation.property_literals == true || (r.annotation.literal || written == "const") && unparenthesised_node(n.expression.node) is ts_template && count([] unparenthesised_node(n.expression.node).expression.node) > 0

in ts_as, ts_type_assertion rule no-unnecessary-type-assertion {
  @assertion_options
  when !contains(typesToIgnore, type.text) && (type.text != "const" || checkLiteralConstAssertions)
  let relation type_relations
  let unchanged (assertion_same(relation) || !relation.annotation.any && (relation.original_annotation.identity == true || relation.original.property_bag && assertion_type_same(relation.widened_original, relation.annotation, relation.widened_original_annotation))) && (!relation.annotation.literal || assertion_literal_preserved(node)) && !assertion_fresh_literal(node, relation, type.text)
  let contextual !unchanged && assertion_context_safe(node) && (assertion_context(node, relation) || assertion_context_known(node, relation) && (relation.operand.any || relation.operand.unknown) && relation.original.contains_any == false && assertion_generics_preserved(relation.original, relation.context) && relation.original_context.assignable == true)
  when unchanged || contextual
  warn if unchanged && assertion_generic_call(expression.node) then "The type arguments for this generic call may be inferred from the assertion. Specify them explicitly instead." else if contextual then "This assertion is unnecessary since the receiver accepts the original type of the expression." else "This assertion is unnecessary since it does not change the type of the expression."
}

in ts_non_null rule no-unnecessary-type-assertion:non-null {
  @assertion_options
  let outer assertion_outer(node)
  let relation type_relations
  let assignment outer.parent is ts_assignment && outer.parent.operator == "="
  let target assignment && outer is ts_assignment.left
  let unchanged relation.operand != null && relation.constrained != null && !relation.constrained.nullable && (!relation.operand.nullable || relation.operand.contains_variable == true && relation.constrained.contains_variable == false) && !assertion_unassigned(unparenthesised_node(expression.node))
  let contextual (relation.operand.nullable || relation.constrained.nullable) && assertion_non_null_context(relation)
  let unchecked compiler_options.noUncheckedIndexedAccess == true && unparenthesised_node(expression.node) is ts_index && unparenthesised_node(expression.node).access_resolution.from_index
  when target || !assignment && !unchecked && (unchanged || contextual)
  warn if target || !unchanged then "This assertion is unnecessary since the receiver accepts the original type of the expression." else "This assertion is unnecessary since it does not change the type of the expression."
}

}
