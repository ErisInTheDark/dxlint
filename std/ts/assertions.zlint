# .ts/assertions: assertion syntax, type-aware and non-null policy.
import .ts/expression-fixes
import .ts/modules
import .ts/values/inspection

define {

in ts_number, ts_string, ts_boolean, ts_bigint, ts_null, ts_regex let raw_literal_expression text
in ts_parenthesized let raw_literal_expression expression.raw_literal_expression
in ts_literal_type let literal_type_text value
in ts_as, ts_type_assertion let use_const_assertion type.literal_type_text != null && type.literal_type_text == expression.raw_literal_expression
in ts_declarator, ts_class_property let use_const_annotation type.literal_type_text != null && type.literal_type_text == init.raw_literal_expression
in ts_as.type, ts_type_assertion.type rule prefer-as-const {
  when parent.use_const_assertion
  warn "Expected a `const` instead of a literal type assertion."
  fix at node as "const"
}
in ts_declarator.type, ts_class_property.type rule prefer-as-const:annotation {
  when parent.use_const_annotation
  warn "Expected a `const` assertion instead of a literal type annotation."
}

in ts_type_assertion let assertion_style_operand expression.node
in ts_type_assertion let assertion_style_type type.text
fn assertion_style_as(source, n) = {
  value operand: n.assertion_style_operand
  value operand_parens: operand.precedence < 10 || operand is ts_instantiation
  value body: expression_fix_wrap(operand.text, operand_parens) " as " n.assertion_style_type
  # Describe the replacement, not the unary angle assertion being removed.
  value shape: {
    kind: "ts_as", precedence: 10, offset: n.offset,
    structure_parens_hazard: !operand_parens && operand.structure_parens_hazard,
    structure_parens_has_in: !operand_parens && operand.structure_parens_has_in,
    structure_parens_has_call: operand.structure_parens_has_call,
    structure_parens_optional: false
  }
  value required: if n.parent is ts_arrow then 1 else expression_fix_parens(source, n, shape)
  value replacement: if required == null then null else expression_fix_wrap(body, required > 0)
  value if replacement != null && expression_fix_retains_comments(n, replacement) then assertion_fix_output(n, replacement) else null
}

in ts_object let assertion_literal_kind "object"
in ts_array let assertion_literal_kind "array"
in ts_parenthesized let assertion_literal_kind expression.assertion_literal_kind
in ts_as, ts_type_assertion rule consistent-type-assertions {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  when is ts_as && assertionStyle != "as" || is ts_type_assertion && assertionStyle != "angle-bracket"
  when !(assertionStyle == "never" && type == "const")
  warn if assertionStyle == "never" then "Do not use any type assertions." else if assertionStyle == "as" then "Use 'as {type}' instead of '<{type}>'." else "Use '<{type}>' instead of 'as {type}'."
  let edit if assertionStyle == "as" then assertion_style_as(source, node) else null
  fix at edit.target if edit != null as edit.text
}
in ts_template let tagged_substitution parent is ts_tagged_template
in ts_as, ts_type_assertion, ts_parenthesized let assertion_argument_context if parent is ts_parenthesized then parent.assertion_argument_context else parent is (ts_new, ts_call, ts_throw, ts_assignment_pattern, ts_jsx_expression) || is ts_parameter.init || parent is ts_template && parent.tagged_substitution
in ts_as, ts_type_assertion {
  let preferred_assertion_style if is ts_as then "as" else "angle-bracket"
  let literal_assertion_eligible type != "any" && type != "unknown" && type != "const"
}
in ts_as, ts_type_assertion rule consistent-type-assertions:object {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  default option mode ("allow" | "allow-as-parameter" | "never") = "allow" "When literal assertions are allowed."
  when literal_assertion_eligible && expression.assertion_literal_kind == "object"
  when assertionStyle == preferred_assertion_style
  when mode == "never" || mode == "allow-as-parameter" && !assertion_argument_context
  warn "Always prefer const x: T = {{ ... }}."
}
in ts_as, ts_type_assertion rule consistent-type-assertions:array {
  option assertionStyle ("as" | "angle-bracket" | "never") = "as" "Preferred assertion syntax."
  default option mode ("allow" | "allow-as-parameter" | "never") = "allow" "When literal assertions are allowed."
  when literal_assertion_eligible && expression.assertion_literal_kind == "array"
  when assertionStyle == preferred_assertion_style
  when mode == "never" || mode == "allow-as-parameter" && !assertion_argument_context
  warn "Always prefer const x: T[] = [ ... ]."
}

fn assertion_outer(n) = { value n; walk (current) if current.parent is ts_parenthesized then current.parent else null; last }
fn assertion_literal_preserved(n) = assertion_outer(n).parent is ts_declarator && assertion_outer(n).parent.parent.kind == "const" || assertion_outer(n).parent is ts_class_property && { value [] assertion_outer(n).parent.modifier; contains "readonly" }
fn assertion_const_scalar(n) = {
  value operand: unparenthesised_node(n.expression.node)
  value literal: operand is (ts_number, ts_string, ts_boolean, ts_bigint)
    || operand is ts_template && count(operand.expression.nodes) == 0
    || operand is ts_unary && contains(["+", "-"], operand.operator)
      && unparenthesised_node(operand.argument.node) is (ts_number, ts_bigint)
  value parts: value_parts(operand)
  value assertion_literal_preserved(n) && (literal || ts_value_has_enum(operand) == true
    && parts != null && count(parts) > 0 && all(parts, arm => any(arm.parts, part =>
      part.identity_known && part.identity.kind == "value" && count(part.uncertain_traits) == 0)))
}
fn assertion_call(n) = {
  value n
  unparenthesised_node
  walk (current) if current is ts_await then unparenthesised_node(current.argument.node) else if current is ts_non_null then unparenthesised_node(current.expression.node) else if current is ts_sequence then { value current.expression.nodes; last; unparenthesised_node } else null
  last
}
fn assertion_generic_call(n) = {
  value call: assertion_call(n)
  value callee: unparenthesised_node(call.callee.node)
  value binding: if callee is ts_identifier then name_binding(callee) else null
  value declaration: binding.node.parent.node
  value target: if callee is (ts_function, ts_arrow) then callee
    else if count(binding.declarations) == 1 && declaration is ts_function then declaration
    else if count(binding.declarations) == 1 && declaration is ts_declarator && declaration.type == null
      then unparenthesised_node(declaration.init.node) else null
  value if call not ts_call || call.type_argument != null then false
    else if target not (ts_function, ts_arrow) then null else count(target.type_parameter) > 0
}
fn assertion_same_handles(source, target) = if source == null || target == null then null else
  if all(source, arm => any(target, other => arm.handle == other.handle))
    && all(target, arm => any(source, other => arm.handle == other.handle)) then true else null
fn assertion_parts_known(arms) = arms != null && all(arms, arm => count(arm.parts) > 0
  && all(arm.parts, part => count(part.uncertain_traits) == 0
    && !any(["any", "unknown", "error", "parameter"], trait => contains(part.traits, trait))))
fn assertion_parts_non_null(arms) = assertion_parts_known(arms)
  && all(arms, arm => all(arm.parts, part =>
    !any(["null", "undefined", "void"], trait => contains(part.traits, trait))))
fn assertion_non_null_style(n) = {
  value source: value_parts(n.expression.node)
  value target: value_parts(n.type.node)
  value retained: filter(source ?? [], arm => !any(arm.parts, part =>
    contains(part.traits, "null") || contains(part.traits, "undefined")))
  value if !assertion_parts_known(source) || !assertion_parts_non_null(target) then null
    else count(retained) < count(source) && assertion_same_handles(retained, target) == true
}
fn assertion_unassigned(n) = n is ts_identifier && (n.declaration == null && n.resolved != "global" || n.declaration.parent is ts_declarator && n.declaration.ambient != true && (n.declaration.parent.init == null && { value n.declaration.parent.token_texts; slice 1 2; first } != "!" || n.declaration.parent.parent.kind == "var" && {
  value n.declaration.parent.parent.parent
  walk (current) current.parent
  any (current) current is ts_block && (n.offset < current.offset || n.end_offset > current.end_offset)
}))
fn assertion_fix_body(source, n) = {
  value operand: n.expression.node
  value text: if n is ts_type_assertion then
    byte_slice(source, operand.token_neighbours.before.end, n.expression.offset) operand.text
    else if n is ts_as then operand.text { value source; byte_slice n.expression.end_offset operand.token_neighbours.after.start; trim_end }
    else operand.text byte_slice(source, n.expression.end_offset, n.last_token.start)
  value {node: operand, text: text}
}
fn assertion_fix_enclosed(n) = {
  value n
  walk (current) if current == n.structure_parens_context then null else current.parent.node
  any (current) current is ts_parenthesized
}
fn assertion_fix_parens(source, n, body, needed) = if needed == null then null else if n.parent is ts_parenthesized then 0 else {
  value result: if n.structure_parens_context != null && n.structure_parens_context not ts_return && !assertion_fix_enclosed(n) && body.structure_parens_hazard == true
    || n.structure_parens_for_init && body.structure_parens_has_in == true
    || n.structure_parens_context is ts_return && { value source; byte_slice n.structure_parens_context.offset body.offset; re_test /[\n\r\u{2028}\u{2029}]/ } then 1 else 0
  value max(needed, result)
}
fn assertion_fix_result(n, text, asi) = if asi == null then null else {
  target: n, text: (if asi then ";" else "") expression_fix_edges(n, text)
}
fn assertion_fix_output(n, text) = {
  value statement: expression_fix_statement(n)
  value asi: if statement != null && {
    value text
    trim_start
    slice 0 1
    then (head) contains(["(", "[", "/", "`"], head)
  }
    then {
      value owners: expression_fix_before_nodes(n)
      value expression_fix_asi(statement, n.token_neighbours.before, owners, text)
    } else false
  value assertion_fix_result(n, text, asi)
}
fn assertion_fix_wrap_output(n, body, needed) = if needed == null then null
  else { value body.text; text: expression_fix_wrap (needed > 0); value assertion_fix_output(n, text) }
fn assertion_fix_with_body(source, n, body) = {
  value precedence_parens: expression_fix_parens(source, n, body.node)
  value required_parens: assertion_fix_parens(source, n, body.node, precedence_parens)
  value assertion_fix_wrap_output(n, body, required_parens)
}
fn assertion_fix(source, n) = {
  value body: assertion_fix_body(source, n)
  value assertion_fix_with_body(source, n, body)
}

in ts_as, ts_type_assertion let no_unnecessary_type_assertion_checked type.text != "const"
in ts_non_null let no_unnecessary_type_assertion_checked true
in ts_as, ts_type_assertion rule no-unnecessary-type-assertion {
  option typesToIgnore string[] = [] "Ignore these written assertion types"
  option checkLiteralConstAssertions boolean = false "Check const assertions on literal values"
  when no_unnecessary_type_assertion_checked || checkLiteralConstAssertions && type.text == "const"
  when !contains(typesToIgnore, type.text)
  let literal_const type.text == "const"
  when !literal_const || assertion_const_scalar(node)
  let operand value_parts(expression.node)
  let annotation if literal_const then value_parts(node) else value_parts(type.node)
  when literal_const || assertion_parts_known(operand) && assertion_parts_known(annotation)
  when assertion_same_handles(operand, annotation) == true
  when unparenthesised_node(expression.node) not (ts_object, ts_array)
  when literal_const || unparenthesised_node(expression.node) not ts_template
  when !any(annotation, arm => any(arm.parts, part => part.identity_known && part.identity.kind == "value")) || assertion_literal_preserved(node)
  when ts_value_has_enum(node) != null && ts_value_has_enum(node) == ts_value_has_enum(expression.node)
  let generic assertion_generic_call(expression.node)
  when generic != null
  warn if generic then "The type arguments for this generic call may be inferred from the assertion. Specify them explicitly instead." else "This assertion is unnecessary since it does not change the type of the expression."
  let edit if generic then null else assertion_fix(source, node)
  fix at edit.target if edit != null as edit.text
}

in ts_non_null rule no-unnecessary-type-assertion:non-null {
  when no_unnecessary_type_assertion_checked
  let outer assertion_outer(node)
  let assignment outer.parent is ts_assignment && outer.parent.operator == "="
  let target assignment && outer is ts_assignment.left
  let unchanged assertion_parts_non_null(value_parts(expression.node)) && !{ value expression.node; unparenthesised_node; assertion_unassigned }
  let unchecked ts_compiler_option(node, "noUncheckedIndexedAccess") == true && unparenthesised_node(expression.node) is ts_index && condition_access(unparenthesised_node(expression.node)).from_index
  when target || !assignment && !unchecked && unchanged
  warn if target || !unchanged then "This assertion is unnecessary since the receiver accepts the original type of the expression." else "This assertion is unnecessary since it does not change the type of the expression."
  let edit assertion_fix(source, node)
  fix at edit.target if edit != null as edit.text
}

}
