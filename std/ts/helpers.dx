# .ts/helpers: helpers shared by the native TypeScript rule definitions.

# A plain identifier, nothing else (`x`, `$el`, not `a.b` or `f()`).
fn is_identifier(x) = re_test(x, /^[A-Za-z_$][\w$]*$/)

# TypeScript source, where type-only syntax (annotations, modifiers) is legal.
in ts_program let typescript_source re_test(file, /\.[cm]?tsx?$/)

fn unparenthesised_node(n) = if n not ts_parenthesized then n else { value n; walk (current) if current is ts_parenthesized then current.expression.node else null; last }
fn outer_parenthesised_node(n) = { value n; walk (current) if current.parent is ts_parenthesized then current.parent.node else null; last }

fn function_uses_this(n) = {
  value n.children.nodes
  walk (current) when {
    current is (ts_function, ts_static_block) then []
    current is (ts_method, ts_class_property) then filter(current.children.nodes, child =>
      child is (ts_method.key, ts_method.decorator, ts_class_property.key, ts_class_property.decorator))
    else then current.children.nodes
  }
  any (current) current is ts_this
}

fn function_uses_arguments(n) = {
  value n.body.node
  walk (current) current.children.nodes
  any (reference) reference is ts_identifier && ts_arguments_owner(reference) == n
}

fn function_head_site(n) = {
  value outer: outer_parenthesised_node(n)
  value member: when {
    n is ts_method then n
    outer.parent is (ts_property, ts_class_property) then outer.parent.node
    else then null
  }
  value if member == null && n is ts_arrow then n.operator.node else {
    value from: last(n.type_parameter.nodes).end_offset ?? n.name.end_offset ?? n.key.end_offset ?? n.offset
    value until: first(n.parameter.nodes).offset ?? n.return_type.offset ?? n.body.offset ?? n.end_offset
    value opening: first(overlapping(ts_open_paren, from, until))
    value {
      start: last(member.decorator.nodes).token_neighbours.after.start ?? member.offset ?? n.offset,
      end: opening.offset ?? first(n.parameter.nodes).offset ?? n.body.offset
    }
  }
}

# Function-wide warnings identify the callable, not its body.
fn function_warning_site(n) = when {
  n is ts_method then n.key.node
  n.name != null then n.name.node
  n.parent is (ts_property, ts_class_property) then n.parent.key.node
  n is ts_arrow then n.operator.node
  else then { start: n.first_token.start, end: n.first_token.end }
}

fn function_description(n) = {
  value outer: outer_parenthesised_node(n)
  value member: when {
    n is ts_method then n
    outer is (ts_property.value, ts_class_property.init) then outer.parent.node
    else then null
  }
  value in_class: member is ts_class_property || member.parent is ts_class
  value private: member.key is ts_private_name
  value name: when {
    private then member.key.identifier_name
    member.static_name != null then "'" member.static_name "'"
    member.key is (ts_string, ts_number) then member.key.text
    member.key is ts_computed_key && unparenthesised_node(member.key.expression.node) is (ts_string, ts_number) then unparenthesised_node(member.key.expression.node).text
    n is ts_function && n.name != null then "'" n.name.identifier_name "'"
    else then ""
  }
  value static: if in_class && contains(member.modifier, "static") then "static " else ""
  value hidden: if in_class && private then "private " else ""
  value async: if contains(n.modifier, "async") then "async " else ""
  value generator: if contains(n.modifier, "*") then "generator " else ""
  value kind: when {
    member != null then when {
      member.kind == "get" then "getter"
      member.kind == "set" then "setter"
      else then "method"
    }
    n is ts_arrow then "arrow function"
    else then "function"
  }
  value description: "{static}{hidden}{async}{generator}{kind}"
  value if n is ts_method && in_class && !contains(member.modifier, "static") && member.key not ts_computed_key && member.static_name == "constructor" then "constructor"
    else description (if name != "" then " " name else "")
}

define {
  in ts_function, ts_arrow, ts_method let function_name function_description(node)
  in ts_node let enclosing_function_name {
    value owner: { value parent.node; walk (current) current.parent.node; find (current) current is (ts_function, ts_arrow, ts_method) }
    value owner.function_name
  }
  in ts_import {
    let import_named_open {
      value overlapping(ts_open_brace, first_token.end, from.offset)
      find (token) token.paired_token.end <= from.offset
    }
    let import_named_close import_named_open.paired_token
  }
  in ts_property_signature, ts_method_signature, ts_call_signature, ts_index_signature let member_terminal_token if contains([";", ","], token_neighbours.after.text) then token_neighbours.after else last_token
}
