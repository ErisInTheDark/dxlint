# .ts/conditions: type-aware conditional policy.

import .ts/values/inspection

define {

in ts_switch let switch_default_comment {
  value case_end: last([] case.end_offset)
  value if count(case) == 0 then null else {
    value descendants(ts_comment)
    filter (comment) comment.offset >= case_end && comment.end_offset < end_offset
    last
  }
}

fn condition_domains(parts) = {
  value arms: parts ?? []
  value known: parts != null && all(arms, arm => all(arm, part =>
    !any(part.traits, trait => contains(["any", "unknown", "error"], trait))))
  value {
    known: known,
    truthy: any(arms, arm => !any(arm, part => contains(part.traits, "falsy"))),
    falsy: any(arms, arm => !any(arm, part => contains(part.traits, "truthy"))
      && !condition_structural_truthy([arm])),
    nullish: any(arms, arm => any(arm, part =>
      any(part.traits, trait => contains(["null", "undefined", "any", "unknown"], trait)))
      || any(arm, part => contains(part.traits, "parameter")) && !any(arm, part =>
        any(part.traits, trait => contains(["boolean", "number", "string", "bigint", "symbol",
          "object", "structural", "callable", "constructible"], trait)))),
    non_nullish: any(arms, arm => !any(arm, part =>
      contains(part.traits, "null") || contains(part.traits, "undefined"))),
  }
}
fn condition_domain(n) = condition_domains(value_constituents(n))
fn condition_known(d) = d.known == true
fn condition_never(d) = !d.truthy && !d.falsy
fn condition_returns(n) = {
  value signatures: value_signatures(n)
  value if signatures == null then null else flat_map(signatures, headers =>
    map(headers, header => condition_domains(value_constituents(header.result))))
}
fn condition_base(n) = when {
  n is (ts_member, ts_index) then n.object.node
  n is ts_call then n.callee.node
  else then null
}
fn condition_unchecked_index(n) = if n not ts_index then false else {
  value shape: ts_value_array_shape(n.object.node)
  value if !shape.known then null else (shape.array || shape.tuple)
    && !(shape.tuple && unparenthesised_node(n.index.node) is ts_literal)
}
fn condition_array_origin(n) = {
  value candidates: {
    value n
    walk (current) condition_base(current)
    filter (current) current.optional != null
    map (current) { value current; condition_base; condition_unchecked_index }
  }
  value when {
    contains(candidates, true) then true
    contains(candidates, null) then null
    else then false
  }
}
fn condition_member_access(n, arms) = {
  value key: if n is ts_member then ts_value_key(n.property.node) else value_key(n.index.node)
  value receivers: filter(arms ?? [], arm => !all(arm.parts, part =>
    contains(part.traits, "null") || contains(part.traits, "undefined")))
  value lookups: map(receivers, arm => value_lookup(arm.handle, key))
  value complete: arms != null && key != null && all(lookups, lookup => lookup != null)
  value projected: map(lookups, lookup => value_parts(lookup.member))
  value {
    arms: if complete && all(projected, parts => parts != null)
      then flat_map(projected, parts => parts) else null,
    from_index: if !complete then null else any(lookups, lookup =>
      any(lookup.alternatives, alternative => any(alternative.sources, source => source.kind == "indexer"))),
    optional: if !complete then null else any(lookups, lookup =>
      any(lookup.alternatives, alternative => alternative.required == false
        && any(alternative.sources, source => source.kind == "named"))),
  }
}
fn condition_call_access(n) = {
  value binding: call_binding(n)
  value projected: map(binding.choices ?? [], choice => value_parts(choice.result))
  value {
    arms: if binding != null && !binding.uncertain && count(projected) > 0 && all(projected, parts => parts != null)
      then flat_map(projected, parts => parts) else null,
    from_index: false,
    optional: false,
  }
}
fn condition_evaluated(n) = if n.in_optional_chain != true then
  {arms: value_parts(n), from_index: false, optional: false}
  else {
    value steps: reverse(walk(n, current => condition_base(current)))
    value fold(slice(steps, 1), {arms: value_parts(first(steps)), from_index: false, optional: false}, (state, step) =>
      if step.in_optional_chain != true then {arms: value_parts(step), from_index: false, optional: false}
      else if step is ts_call then condition_call_access(step)
      else condition_member_access(step, state.arms))
  }
fn condition_access(n) = if n not (ts_member, ts_index) then null
  else if n.in_optional_chain == true then condition_evaluated(n)
  else condition_member_access(n, value_parts(n.object.node))
fn condition_index_fallback(n, unchecked) = condition_access(n).from_index == true
  && (n is ts_index || unchecked || condition_access_domains(condition_base(n)).nullish)
fn condition_access_domains(n) = {
  value arms: condition_evaluated(n).arms
  value condition_domains(if arms == null then null else map(arms, arm => arm.parts))
}
fn condition_predicate_union(n, descriptor, parts) = {
  value sources: walk([descriptor.target_source], source =>
    map(filter(source.sites ?? [], site => site.kind != "ts_type_parameter"), site => site_sources(n, site)))
  value kinds: unique(map(parts ?? [], arm =>
    find(["null", "undefined", "boolean", "number", "string", "bigint", "symbol"], trait =>
      any(arm, part => contains(part.traits, trait)))))
  value descriptor.target_union || any(sources, source => source.combine == "union")
    || count(kinds) > 1 || count(parts) > 1
      && !all(kinds, kind => kind == "boolean")
      && all(parts, arm => any(arm, part => part.identity_known && part.identity.kind == "value"))
      && !any(parts, arm => any(arm, part => contains(part.traits, "enum")))
}
fn condition_predicate(n) = {
  value binding: call_binding_at(n, ["return_type"])
  value choice: first(binding.choices)
  value descriptions: flat_map(value_parts(choice.at) ?? [], arm =>
    map(arm.parts, part => part.carrier.description))
  value descriptor: first(filter(descriptions, description => description.kind == "predicate"))
  value index: descriptor.parameter_index
  value if binding == null || binding.uncertain || count(binding.choices) != 1 || descriptor == null
    || index == null then null
  else {
    value parameter: first(slice(choice.parameters, index, index + 1))
    value if count(parameter.arguments) != 1
      || any(slice(n.argument.nodes, 0, index + 1), argument => argument is ts_spread) then null
    else {
      value actual: declaration_value(n, first(parameter.arguments))
      value target: if descriptor.has_target then first(call_binding_at(n, ["return_type", "type"]).choices).at else null
      value parts: if descriptor.has_target then value_constituents(target) else null
      value union: condition_predicate_union(n, descriptor, parts)
      value {
        argument_index: index,
        asserts: descriptor.asserts,
        argument: condition_domains(value_constituents(actual)),
        target: if descriptor.has_target then condition_domains(parts) else null,
        to_target: if descriptor.has_target then value_accepts(target, actual, null, null) else null,
        from_target: if descriptor.has_target then value_accepts(actual, target, null, null) else null,
        target_union: union,
      }
    }
  }
}
in ts_call let condition_predicate condition_predicate(node)
fn condition_boolean_use(n) = {
  value n
  walk (current) if current.parent is (ts_logical, ts_parenthesized) then current.parent else null
  any (current) current.parent is (ts_if, ts_while, ts_do_while, ts_for, ts_conditional) && current.parent.test.node == current || current.parent is ts_unary && current.parent.operator == "!" || current.parent is ts_logical && current.parent.operator == "&&" && current.parent.left.node == current
}
fn condition_steps(n) = {
  value n
  unparenthesised_node
  walk (current) when {
    current is ts_unary && current.operator == "!" then unparenthesised_node(current.argument.node)
    current is ts_logical && current.operator != "??" && condition_boolean_use(current) then unparenthesised_node(current.right.node)
    else then null
  }
}
fn condition_boolean(n) = { value n; steps: condition_steps; value condition_boolean_branch(n, steps) }
fn condition_boolean_branch(n, steps) = {
  value if any(steps, current => current is ts_logical && current.operator != "??" && condition_boolean_use(current)) then {
  value {
  value steps
  filter (current) current is ts_logical && current.operator != "??" && condition_boolean_use(current)
  last
}.right.node
  unparenthesised_node
} else unparenthesised_node(n)
  condition_boolean_leaf
}
fn condition_boolean_leaf(n) = { node: n, subject: {
  value n
  walk (current) if current is ts_unary && current.operator == "!" then unparenthesised_node(current.argument.node) else null
  last
}, negated: {
  value n
  walk (current) if current is ts_unary && current.operator == "!" then unparenthesised_node(current.argument.node) else null
  filter (current) current is ts_unary && current.operator == "!"
  count
} % 2 == 1 }
fn condition_loop_allowed(n, mode) = if mode == "always" then {
  value literal: condition_literal(n)
  value literal.type == "boolean" && literal.value == true
} else mode == "only-allowed-literals" && n is ts_literal && (n.literal_value.type == "boolean" || n.literal_value.type == "number" && contains([0, 1], n.literal_value.value))
fn condition_callback(n) = if n is (ts_arrow, ts_function) then when {
  n.body not ts_block then n.body.node
  count(n.body.body.node) == 1 && first(n.body.body.node) is ts_return then first(n.body.body.node).argument.node
  else then null
} else null
fn condition_array_method(n) = n.callee is (ts_member, ts_index) && contains(["every", "filter", "find", "findIndex", "findLast", "findLastIndex", "some"], n.callee.static_name)
fn condition_array_callback(n) = condition_array_method(n) && strict_boolean_array(n.callee.object.node)
fn condition_literal_arm(arm) = {
  value parts: filter(arm, part => part.identity.kind == "value")
  value part: first(parts)
  value kind: when {
    contains(part.traits, "null") then "null"
    contains(part.traits, "undefined") then "undefined"
    contains(part.traits, "boolean") then "boolean"
    contains(part.traits, "number") then "number"
    contains(part.traits, "string") then "string"
    contains(part.traits, "bigint") then "bigint"
    else then null
  }
  value if kind == null || !all(parts, other => other.identity == part.identity) then null else {
    type: kind,
    value: when {
      kind == "bigint" then part.identity.value.value "n"
      kind == "undefined" then "undefined"
      else then part.identity.value
    }
  }
}
fn condition_literal(n) = {
  value arms: value_constituents(n)
  value literals: map(arms, arm => condition_literal_arm(arm))
  value first_literal: first(literals)
  value if arms != null && count(arms) > 0 && first_literal != null && all(literals, literal => literal == first_literal)
    then first_literal else null
}
fn condition_equal(left, right, strict) = when {
  left.type == right.type then contains(["null", "undefined"], left.type) || js_compare(left, right) == 0
  strict then false
  contains(["null", "undefined"], left.type) || contains(["null", "undefined"], right.type) then contains(["null", "undefined"], left.type) && contains(["null", "undefined"], right.type)
  else then js_compare(left, right) == 0
}
fn condition_compare(left, right, op) = when {
  contains(["==", "==="], op) then condition_equal(left, right, op == "===")
  contains(["!=", "!=="], op) then !condition_equal(left, right, op == "!==")
  op == "<" then js_compare(left, right) == -1
  op == ">" then js_compare(left, right) == 1
  op == "<=" then js_compare(left, right) != null && js_compare(left, right) <= 0
  else then js_compare(left, right) != null && js_compare(left, right) >= 0
}
fn condition_comparable_nullish(literal, other, loose) = !contains(["null", "undefined"], literal.type)
  || !condition_known(condition_domain(other)) || ts_value_has_trait(other, literal.type) == true
  || literal.type == "undefined" && ts_value_has_void(other) == true
  || loose && condition_domain(other).nullish
fn condition_structural_truthy(arms) = arms != null && count(arms) > 0 && all(arms, arm =>
  any(arm, part => contains(part.traits, "structural")) && all(arm, part =>
    !any(part.traits, trait => contains(["any", "unknown", "error", "null", "undefined", "falsy"], trait))
    && (!any(part.traits, trait => contains(["boolean", "number", "bigint", "string"], trait))
      || contains(part.traits, "truthy"))))

in ts_binary let condition_comparison { left: left.node, right: right.node, operator: operator, report: node }
in ts_case let condition_comparison { left: parent.discriminant.node, right: test.node, operator: "===", report: test.node }

@macro condition_boolean_policy {
  when checked.node != null && (checked.subject not ts_logical || checked.subject.operator == "??")
  let values value_constituents(checked.subject)
  let never_value values != null && count(values) == 0
  let certainly_truthy condition_structural_truthy(values) || checked.subject always truthy
  let certainly_falsy if certainly_truthy then false else checked.subject always falsy
  when condition_unchecked_index(checked.subject) == false && !(ts_compiler_option(node, "noUncheckedIndexedAccess") == true && condition_access(checked.subject).from_index)
  when never_value || certainly_truthy || certainly_falsy
  report at { start: checked.node.offset, end: checked.node.end_offset }
  warn when {
    never_value then "Unnecessary conditional, value is `never`."
    certainly_falsy != checked.negated then "Unnecessary conditional, value is always falsy."
    else then "Unnecessary conditional, value is always truthy."
  }
}

in ts_if.test, ts_conditional.test rule no-unnecessary-condition {
  let checked condition_boolean(node)
  @condition_boolean_policy
}
in ts_while.test, ts_do_while.test, ts_for.test rule no-unnecessary-condition:loop {
  option allowConstantLoopConditions ("always" | "never" | "only-allowed-literals") = "never" "Allow selected constant loop conditions"
  when !{ value node; unparenthesised_node; condition_loop_allowed allowConstantLoopConditions }
  let checked condition_boolean(node)
  @condition_boolean_policy
}
in ts_logical, ts_assignment rule no-unnecessary-condition:logical {
  when contains(["&&", "||", "&&=", "||="], operator)
  let checked condition_boolean(left.node)
  @condition_boolean_policy
}
in ts_logical, ts_assignment rule no-unnecessary-condition:nullish {
  when contains(["??", "??="], operator)
  let subject unparenthesised_node(left.node)
  let domain condition_domain(subject)
  when condition_known(domain)
  when condition_never(domain) || !domain.non_nullish && ts_value_has_void(subject) == false || !domain.nullish && condition_unchecked_index(subject) == false && condition_array_origin(subject) == false && !condition_index_fallback(subject, ts_compiler_option(node, "noUncheckedIndexedAccess") == true) && !condition_access(subject).optional
  report at { start: subject.offset, end: subject.end_offset }
  warn when {
    condition_never(domain) then "Unnecessary conditional, value is `never`."
    !domain.non_nullish then "Unnecessary conditional, left-hand side of `??` operator is always `null` or `undefined`."
    else then "Unnecessary conditional, expected left-hand side of `??` operator to be possibly null or undefined."
  }
}
in ts_member, ts_index, ts_call rule no-unnecessary-condition:optional {
  when optional != null
  let subject condition_base(node)
  let domain condition_access_domains(subject)
  when condition_known(domain) && !domain.nullish && condition_unchecked_index(subject) == false && (condition_array_origin(node) == false || ts_compiler_option(node, "noUncheckedIndexedAccess") == true) && !condition_index_fallback(subject, ts_compiler_option(node, "noUncheckedIndexedAccess") == true)
  report at { start: optional.offset, end: optional.end_offset }
  warn "Unnecessary optional chain on a non-nullish value."
}
in ts_call let no_unnecessary_condition_truthiness_assertion_checked false
in ts_call let no_unnecessary_condition_predicate_checked false
in ts_call rule no-unnecessary-condition:truthiness-assertion {
  when no_unnecessary_condition_truthiness_assertion_checked
  when condition_predicate.asserts && condition_predicate.target == null
  let checked {
    value argument.nodes
    slice condition_predicate.argument_index (condition_predicate.argument_index + 1)
    first
    condition_boolean
  }
  @condition_boolean_policy
}
in ts_call rule no-unnecessary-condition:predicate {
  when no_unnecessary_condition_predicate_checked
  let predicate condition_predicate
  when predicate.target != null && condition_known(predicate.argument) && predicate.to_target && (predicate.from_target || predicate.target_union)
  let subject { value argument.nodes; slice predicate.argument_index (predicate.argument_index + 1); first }
  report at { start: subject.offset, end: subject.end_offset }
  warn "Unnecessary conditional, expression already has the type being checked by the " (if predicate.asserts then "assertion function" else "type guard") "."
}
in ts_call rule no-unnecessary-condition:callback {
  when condition_array_callback(node) && count(argument.nodes) > 0
  let checked {
    value argument.nodes
    first
    condition_callback
    condition_boolean
  }
  @condition_boolean_policy
}
in ts_call rule no-unnecessary-condition:callback-return {
  when condition_array_callback(node) && count(argument.nodes) > 0 && { value argument.nodes; first; condition_callback } == null
  let subject first(argument.nodes)
  let returns condition_returns(subject)
  when count(returns) > 0 && all(returns, domain => condition_known(domain))
  when all(returns, domain => !domain.falsy) || all(returns, domain => !domain.truthy)
  report at { start: subject.offset, end: subject.end_offset }
  warn if all(returns, domain => !domain.falsy) then "This callback should return a conditional, but return is always truthy." else "This callback should return a conditional, but return is always falsy."
}
in ts_program rule no-unnecessary-condition:strict {
  option allowRuleToRunWithoutStrictNullChecksIKnowWhatIAmDoing boolean = false "Run without strict null checks"
  when ts_compiler_option(node, "strictNullChecks") == false && !allowRuleToRunWithoutStrictNullChecksIKnowWhatIAmDoing
  report at { start: 0, end: 0 }
  warn "This rule requires the `strictNullChecks` compiler option to be turned on to function correctly."
}
in ts_binary, ts_case rule no-unnecessary-condition:comparison {
  let comparison condition_comparison
  when comparison.right != null && contains(["==", "===", "!=", "!==", "<", ">", "<=", ">="], comparison.operator)
  let left_value condition_literal(comparison.left)
  let right_value condition_literal(comparison.right)
  when left_value != null && right_value != null
  let answer condition_compare(left_value, right_value, comparison.operator)
  report at { start: comparison.report.offset, end: comparison.report.end_offset }
  warn "Unnecessary conditional, comparison is always " answer ", since `" comparison.left.type " " comparison.operator " " comparison.right.type "` is " answer "."
}
in ts_binary, ts_case rule no-unnecessary-condition:overlap {
  let comparison condition_comparison
  when ts_compiler_option(node, "strictNullChecks") != false && comparison.right != null && contains(["==", "===", "!=", "!==", "<", ">", "<=", ">="], comparison.operator)
  let left_value condition_literal(comparison.left)
  let right_value condition_literal(comparison.right)
  when left_value == null || right_value == null
  let loose contains(["==", "!="], comparison.operator)
  when !condition_comparable_nullish(left_value, comparison.right, loose) || !condition_comparable_nullish(right_value, comparison.left, loose)
  report at { start: comparison.report.offset, end: comparison.report.end_offset }
  warn "Unnecessary conditional, the types have no overlap."
}

@macro strict_boolean_options {
  option allowAny boolean = false "Allow any and unknown"
  option allowNullableBoolean boolean = false "Allow nullable booleans"
  option allowNullableEnum boolean = false "Allow nullable enums"
  option allowNullableNumber boolean = false "Allow nullable numbers"
  option allowNullableObject boolean = true "Allow nullable objects"
  option allowNullableString boolean = false "Allow nullable strings"
  option allowNumber boolean = true "Allow numbers and bigints"
  option allowString boolean = true "Allow strings"
  option allowRuleToRunWithoutStrictNullChecksIKnowWhatIAmDoing boolean = false "Run without strict null checks"
  let strict_boolean_settings {
    any: allowAny, boolean: allowNullableBoolean, enum: allowNullableEnum,
    number: allowNullableNumber, object: allowNullableObject, string: allowNullableString,
    primitive_number: allowNumber, primitive_string: allowString
  }
}

fn strict_boolean_exact(types, expected) = count(types) == count(expected) && all(types, variant => contains(expected, variant))
fn strict_boolean_report(types, options) = when {
  strict_boolean_exact(types, ["boolean"]) || strict_boolean_exact(types, ["truthy boolean"]) || strict_boolean_exact(types, ["never"]) || strict_boolean_exact(types, ["nullish", "truthy boolean"]) then null
  strict_boolean_exact(types, ["nullish"]) then "nullish"
  strict_boolean_exact(types, ["nullish", "boolean"]) then if options.boolean then null else "nullable boolean"
  options.primitive_number && strict_boolean_exact(types, ["nullish", "truthy number"]) || options.primitive_string && strict_boolean_exact(types, ["nullish", "truthy string"]) then null
  strict_boolean_exact(types, ["string"]) || strict_boolean_exact(types, ["truthy string"]) then if options.primitive_string then null else "string"
  strict_boolean_exact(types, ["nullish", "string"]) then if options.string then null else "nullable string"
  strict_boolean_exact(types, ["number"]) || strict_boolean_exact(types, ["truthy number"]) then if options.primitive_number then null else "number"
  strict_boolean_exact(types, ["nullish", "number"]) then if options.number then null else "nullable number"
  strict_boolean_exact(types, ["object"]) then "object"
  strict_boolean_exact(types, ["nullish", "object"]) then if options.object then null else "nullable object"
  contains(types, "nullish") && contains(types, "enum") && count(types) >= 3 && all(types, variant => contains(["nullish", "enum", "number", "truthy number", "string", "truthy string"], variant)) then if options.enum then null else "nullable enum"
  strict_boolean_exact(types, ["any"]) then if options.any then null else "any"
  else then "other"
}
fn strict_boolean_message(kind, context) = when {
  kind == "nullish" then "Unexpected nullish value in conditional. The condition is always false."
  kind == "other" then "Unexpected value in conditional. A boolean expression is required."
  kind == "object" then "Unexpected object value in " context ". The condition is always true."
  else then "Unexpected " kind " value in " context ". " (when {
    kind == "any" then "An explicit comparison or type conversion is required."
    kind == "nullable boolean" then "Please handle the nullish case explicitly."
    kind == "nullable enum" || kind == "nullable number" then "Please handle the nullish/zero/NaN cases explicitly."
    kind == "nullable object" then "An explicit null check is required."
    kind == "nullable string" then "Please handle the nullish/empty cases explicitly."
    kind == "number" then "An explicit zero/NaN check is required."
    else then "An explicit empty string check is required."
  })
}
fn strict_boolean_asserted(n) = n.parent is ts_call && n.parent.condition_predicate.asserts && n.parent.condition_predicate.target == null && {
  value n.parent.argument.nodes
  slice n.parent.condition_predicate.argument_index (n.parent.condition_predicate.argument_index + 1)
  first
} == n
fn strict_boolean_use(n) = {
  value n
  walk (current) if current.parent is ts_parenthesized || current.parent is ts_logical && current.parent.operator != "??" && current.parent.right.node == current then current.parent else null
  any (current) current.parent is (ts_if, ts_while, ts_do_while, ts_for, ts_conditional) && current.parent.test.node == current || current.parent is ts_unary && current.parent.operator == "!" || current.parent is ts_logical && current.parent.operator != "??" && current.parent.left.node == current || strict_boolean_asserted(current)
}
fn strict_boolean_array(n) = {
  value shape: ts_value_array_shape(n)
  value shape.known && (shape.array || shape.tuple)
}
fn strict_boolean_value_has(arm, trait) = any(arm, part => contains(part.traits, trait))
fn strict_boolean_value_primitive(arm) = when {
  strict_boolean_value_has(arm, "intersection") then if strict_boolean_value_has(arm, "boolean") then "boolean" else "object"
  strict_boolean_value_has(arm, "any") || strict_boolean_value_has(arm, "unknown") then "any"
  strict_boolean_value_has(arm, "null") || strict_boolean_value_has(arm, "undefined") then "nullish"
  strict_boolean_value_has(arm, "boolean") then "boolean"
  strict_boolean_value_has(arm, "string") then "string"
  strict_boolean_value_has(arm, "number") || strict_boolean_value_has(arm, "bigint") then "number"
  strict_boolean_value_has(arm, "parameter") && !any(arm, part =>
    any(part.traits, trait => contains(["object", "symbol", "callable", "constructible", "structural"], trait))) then "any"
  else then "object"
}
fn strict_boolean_value_complete(arms) = arms != null && all(arms, arm =>
  (!strict_boolean_value_has(arm, "error") || strict_boolean_value_has(arm, "any")) && any(arm, part =>
    any(part.traits, trait => contains(["any", "unknown", "parameter", "intersection", "null", "undefined", "boolean", "string", "number", "bigint", "object", "symbol", "callable", "constructible", "structural"], trait))))
fn strict_boolean_value_group(arms, primitive) = filter(arms, arm => strict_boolean_value_primitive(arm) == primitive)
fn strict_boolean_value_variant(arms, primitive) = {
  value group: strict_boolean_value_group(arms, primitive)
  value when {
    count(group) == 0 then null
    contains(["boolean", "string", "number"], primitive) && all(group, arm => strict_boolean_value_has(arm, "truthy"))
      then "truthy " primitive
    else then primitive
  }
}
fn strict_boolean_value_variants(arms) = when {
  !strict_boolean_value_complete(arms) then null
  count(arms) == 0 then ["never"]
  else then {
    value variants: {
      value ["nullish", "boolean", "string", "number", "object", "any"]
      map (primitive) strict_boolean_value_variant(arms, primitive)
      filter (variant) variant != null
    }
    value variants (if any(arms, arm => strict_boolean_value_has(arm, "enum")) then ["enum"] else [])
  }
}
fn strict_boolean_callback_variants(n) = {
  value signatures: call_results(n)
  value headers: { value signatures; flat_map (arm) arm }
  value parts: if signatures != null && count(headers) > 0 && all(headers, header => header.result_known)
    then { value headers; flat_map (header) header.result } else null
  value strict_boolean_value_variants(parts)
}

in ts_if.test, ts_while.test, ts_do_while.test, ts_for.test, ts_conditional.test, ts_unary.argument, ts_logical.left, ts_logical.right, ts_call.argument rule strict-boolean-expressions {
  @strict_boolean_options
  let subject unparenthesised_node(node)
  when strict_boolean_use(subject) && (subject not ts_logical || subject.operator == "??")
  let variants { value subject; value_constituents; strict_boolean_value_variants }
  when variants != null
  let failure strict_boolean_report(variants, strict_boolean_settings)
  when failure != null
  report at { start: subject.offset, end: subject.end_offset }
  warn strict_boolean_message(failure, "conditional")
}
in ts_call rule strict-boolean-expressions:callback {
  @strict_boolean_options
  when condition_array_method(node) && strict_boolean_array(callee.object.node) && count(argument.nodes) > 0
  let subject { value argument.nodes; first; unparenthesised_node }
  let asynchronous subject is (ts_arrow, ts_function) && contains(subject.modifier, "async")
  let variants strict_boolean_callback_variants(subject)
  when asynchronous || variants != null
  let failure if asynchronous then "async" else strict_boolean_report(variants, strict_boolean_settings)
  when failure != null
  report at { start: subject.offset, end: subject.end_offset }
  warn if asynchronous then "Predicate function should not be 'async'; expected a boolean return type." else strict_boolean_message(failure, "array predicate return type")
}
in ts_program rule strict-boolean-expressions:strict {
  @strict_boolean_options
  when ts_compiler_option(node, "strictNullChecks") == false && !allowRuleToRunWithoutStrictNullChecksIKnowWhatIAmDoing
  report at { start: 0, end: 0 }
  warn "This rule requires the `strictNullChecks` compiler option to be turned on to function correctly."
}

}
