# .ts/typed: typescript-eslint rules that need type information, on the
# native TypeScript layers and the type facts (`type`, `type_flags`,
# `type_members`, ...). Unresolved types differ from explicit unknown.

import .ts/arithmetic
import .ts/deprecation
import .ts/methods
import .ts/spreads
import .ts/type-specifiers
import .ts/typed/promises
import .ts/typed/optional-chains
import .ts/typed/floating-promises
import .ts/typed/unbound-method
import .ts/typed/template-expressions
import .ts/typed/readonly-members
import .ts/typed/string-boundaries
import .ts/typed/type-constituents
import .ts/typed/return-await
import .ts/typed/nullish-coalescing
import .ts/typed/boolean-comparisons
import .ts/typed/void-expressions

define {

@macro thenable ({ value type_members.nonempty ?? []; contains "then" })
@macro flags type_flags.nonempty ?? []
fn has_only_flags(fs, wanted) = count(fs) > 0 && { value fs wanted; unique; count } == { value wanted; unique; count }
fn matches_type_names(groups, names) = all(groups, group => any(group, name => contains(names, name)))

in ts_type_reference, ts_intersection rule no-generated-empty-object-type {
  when generated_empty_object
  warn "This type resolves to `{{}}`, the empty object type. This was likely not intentional."
}

in ts_function, ts_arrow, ts_method rule require-await {
  when missing_await != null
  report at function_warning_site(node)
  warn missing_await.name " has no 'await' expression."
}

in ts_call rule use-unknown-in-catch-callback-variable {
  each finding in unsafe_catch_callbacks
  report at finding.offset
  warn "Prefer the safe `: unknown` for a `" finding.method "`" (if finding.method == "then" then " rejection" else "") " callback variable." (if finding.pattern == "array" then " The thrown error may not be iterable." else if finding.pattern == "object" then " The thrown error may be nullable, or may not have the expected shape." else "")
}

group promise_function_async_function ts_function, ts_arrow, ts_method
in promise_function_async_function let promise_function_async_kind
  if is ts_arrow then "arrow"
  else if is ts_method then if parent is ts_class then "method" else "expression"
  else if parent is (ts_program, ts_block, ts_export, ts_case, ts_if, ts_labeled) then "declaration"
  else "expression"
in promise_function_async_function let promise_function_async_checked true
in ts_method let promise_function_async_exempt
  contains(["get", "set"], kind)
  || parent is ts_class && !contains([] modifier, "static") && key not ts_computed_key && static_name == "constructor"
in promise_function_async_function rule promise-function-async {
  option allowAny boolean = true "Allow any and unknown return types"
  option allowedPromiseNames string[] = [] "Additional promise type names"
  when body != null && !contains([] modifier, "async")
  when !(promise_function_async_exempt.nonempty ?? false)
  when promise_function_async_checked
  let names ("Promise" allowedPromiseNames)
  let disallowed_unknown (!allowAny && any(function_return_info.returns, result => result.unknown))
  when disallowed_unknown || all(function_return_info.returns, result => if function_return_info.explicit then matches_type_names(result.groups, names) else any(result.groups, group => any(group, name => contains(names, name))))
  report at function_warning_site(node)
  warn if !disallowed_unknown && any(function_return_info.returns, result => result.union && !matches_type_names(result.groups, names)) then "Functions that return promises must be async. Consider adding an explicit return type annotation if the function is intended to return a union of promise and non-promise types." else "Functions that return promises must be async."
}

in ts_node let only_throw_error_checked true
in ts_throw.argument rule only-throw-error {
  option allow string[] = [] "Additional allowed thrown types"
  option allowRethrowing boolean = true "Allow rethrowing catch and Promise rejection parameters"
  option allowThrowingAny boolean = true "Allow any values"
  option allowThrowingUnknown boolean = true "Allow unknown values"
  when error_value.kind != "error"
  when !allowRethrowing || !error_value.rethrown
  when !allowThrowingAny || error_value.kind != "any"
  when !allowThrowingUnknown || error_value.kind != "unknown"
  when only_throw_error_checked
  when !type_is_allowed(allow, type_specifier_groups)
  report at unparenthesised_node(node)
  warn if error_value.kind == "undefined" then "Do not throw undefined." else "Expected an error object to be thrown."
}

in ts_identifier let rejection_global_promise text == "Promise" && resolved == "global" && global != "off"
in ts_identifier, ts_member, ts_index let rejection_constructor
  if re_test(file, /\.[cm]?tsx?$/) then builtin_constructor("Promise") else rejection_global_promise.nonempty ?? false
in ts_identifier, ts_member, ts_index let rejection_receiver
  rejection_constructor || re_test(file, /\.[cm]?tsx?$/) && builtin_type("Promise")
in ts_member, ts_index let rejection_member static_name == "reject" && object.rejection_receiver == true
in ts_parenthesized forward rejection_global_promise, rejection_constructor, rejection_receiver, rejection_member from expression
in ts_new let rejection_promise_constructor callee.rejection_constructor == true
in ts_function, ts_arrow, ts_parenthesized let rejection_executor
  if parent is ts_parenthesized then parent.rejection_executor
  else is ts_new.argument && index == 0 && parent.rejection_promise_constructor
in ts_parameter let rejection_parameter index == 1 && init == null && parent.rejection_executor == true
in ts_identifier let rejection_binding is ts_parameter.name && parent.rejection_parameter == true
in ts_call let rejection_call
  callee.rejection_member == true || any(callee.declarations, d => d.rejection_binding == true)
in ts_node let rejection_reason
  {possible: could_be_error && error_global_undefined != true, kind: error_value.kind, groups: type_specifier_groups}
in ts_call let prefer_promise_reject_errors_checked true
in ts_call rule prefer-promise-reject-errors {
  option allowEmptyReject boolean = false "Allow rejection without a reason"
  option allow string[] = [] "Additional allowed rejection types"
  option allowThrowingAny boolean = false "Allow any values"
  option allowThrowingUnknown boolean = false "Allow unknown values"
  when rejection_call
  let reason first([] argument.rejection_reason)
  when reason != null || !allowEmptyReject
  when reason == null || (if re_test(file, /\.[cm]?tsx?$/) then reason.kind != "error" && !(allowThrowingAny && reason.kind == "any") && !(allowThrowingUnknown && reason.kind == "unknown") && !type_is_allowed(allow, reason.groups) else !reason.possible)
  when prefer_promise_reject_errors_checked
  warn "Expected the Promise rejection reason to be an Error."
}

fn stringification_compound(parts, kind) =
  if kind == "union" then if all(parts, part => part == 2) then 2 else if all(parts, part => part == 0) then 0 else 1
  else if any(parts, part => part == 0) then 0 else 2
fn stringification_collection(parts) = if any(parts, part => part == 2) then 2 else if any(parts, part => part == 1) then 1 else 0
fn stringification_object_member(declaration) = declaration.owner.kind == "interface" && declaration.owner.name == "Object"
fn stringification_leaf(t, unknown) =
  if any(t.members, member => member.name == "[Symbol.toPrimitive]" && any(member.declarations, declaration => declaration.signature && declaration.key_symbol == "toPrimitive")) then 0
  else if any(t.members, member => member.name != "[Symbol.toPrimitive]" && any(member.declarations, declaration => !stringification_object_member(declaration))) then 0
  else if any(t.members, member => member.name != "[Symbol.toPrimitive]" && any(member.declarations, declaration => stringification_object_member(declaration))) then 2
  else if unknown && contains(["unknown", "parameter"], t.kind) then 1 else 0
fn stringification_certainty(t, ignored, unknown) =
  if t.kind == "boolean" || any(t.names t.generic_names t.aliases, name => contains(ignored, name)) then 0
  else if contains(["union", "intersection"], t.kind) then { value t.parts; map (part) stringification_certainty(part, ignored, unknown); stringification_compound t.kind }
  else if contains(["array", "tuple"], t.kind) then { value t.parts; map (part) stringification_certainty(part, ignored, unknown); stringification_collection }
  else stringification_leaf(t, unknown)
fn stringification_join(t, ignored, unknown) =
  if contains(["union", "intersection"], t.kind) then { value t.parts; map (part) stringification_join(part, ignored, unknown); stringification_compound t.kind }
  else if contains(["array", "tuple"], t.kind) then { value t.parts; map (part) stringification_certainty(part, ignored, unknown); stringification_collection }
  else 0
in ts_node let stringification_type type_structure(["toString", "toLocaleString", "valueOf", "[Symbol.toPrimitive]"])
in ts_call let stringification_subjects
  if callee is ts_identifier && global_callee == "String" then [{node: { value argument.nodes; first; unparenthesised_node }, join: false}]
  else if callee is ts_member && callee.property is ts_identifier && contains(["toString", "toLocaleString", "join"], callee.property.text) then [{node: unparenthesised_node(callee.object.node), join: callee.property.text == "join"}]
  else []
in ts_binary, ts_assignment let stringification_subjects
  if contains(["+", "+="], operator) && left.type_is_string_like then [{node: unparenthesised_node(right.node), join: false}]
  else if contains(["+", "+="], operator) && right.type_is_string_like && left not ts_private_name then [{node: unparenthesised_node(left.node), join: false}]
  else []
in ts_template let stringification_subjects if parent is ts_tagged_template then [] else map(expression.nodes, n => {node: unparenthesised_node(n), join: false})
in ts_call, ts_binary, ts_assignment, ts_template rule no-base-to-string {
  option ignoredTypeNames string[] = ["Error", "RegExp", "URL", "URLSearchParams"] "Types whose string conversion is permitted"
  option checkUnknown boolean = false "Check explicit unknown and unconstrained type parameters"
  let findings map(stringification_subjects, subject => {
    node: subject.node,
    join: subject.join,
    certainty: if subject.join then stringification_join(subject.node.stringification_type, ignoredTypeNames, checkUnknown) else stringification_certainty(subject.node.stringification_type, ignoredTypeNames, checkUnknown)
  })
  each subject in findings
  when subject.node != null && subject.node not (ts_literal, ts_spread)
  when subject.certainty > 0
  report at {start: subject.node.offset, end: subject.node.end_offset}
  warn if subject.join then "Using `join()` for " subject.node.text " " (if subject.certainty == 2 then "will" else "may") " use Object's default stringification format ('[object Object]') when stringified."
    else "'" subject.node.text "' " (if subject.certainty == 2 then "will" else "may") " use Object's default stringification format ('[object Object]') when stringified."
}

in ts_identifier {
  let eval_name text
  let eval_identifier true
  let eval_core_root if contains(["global", "globalThis", "window", "self"], text) && global != null && global != "off" then text else null
  let eval_timer_global resolved == "global" && (re_test(file, /\.[cm]?tsx?$/) || global != null && global != "off")
  let eval_constructor builtin_type("FunctionConstructor") || { value type_flags.nonempty ?? []; contains "any" } || type_opaque && reference_kind == null
}
in ts_member, ts_index {
  let eval_name static_name
  let eval_core_root if object.eval_core_root != null && static_name == object.eval_core_root then object.eval_core_root else null
  let eval_timer_global if re_test(file, /\.[cm]?tsx?$/) then object is ts_identifier && contains(["global", "globalThis", "window"], object) else object.eval_core_root != null
  let eval_constructor builtin_type("FunctionConstructor") || { value type_flags.nonempty ?? []; contains "any" } || type_opaque
}
in ts_member let eval_bind_member property == "bind"
in ts_parenthesized {
  let eval_name expression.eval_name
  let eval_identifier expression.eval_identifier
  let eval_core_root expression.eval_core_root
  let eval_timer_global expression.eval_timer_global
  let eval_constructor expression.eval_constructor
}
group typed_simple_expression ts_identifier, ts_private_name, ts_this, ts_super, ts_null, ts_boolean,
  ts_number, ts_bigint, ts_string, ts_regex, ts_template, ts_tagged_template, ts_array, ts_object,
  ts_member, ts_index, ts_new, ts_unary, ts_update, ts_await, ts_yield,
  ts_logical, ts_assignment, ts_conditional, ts_sequence, ts_as, ts_satisfies,
  ts_non_null, ts_type_assertion, ts_function, ts_arrow, ts_class, ts_instantiation, ts_meta_property,
  ts_import_call
in typed_simple_expression, ts_binary {
  let eval_callback callable || builtin_type("Function")
}
in typed_simple_expression {
  let eval_string is (ts_string, ts_template)
    || static_string != null && { value type_flags.nonempty ?? []; has_only_flags (["string", "literal"]) }
}
in ts_call {
  let eval_callback callable || builtin_type("Function") || callee.eval_bind_member == true || callee is ts_identifier && callee == "bind"
  let eval_string static_string != null && { value type_flags.nonempty ?? []; has_only_flags (["string", "literal"]) } || callee.global_value == "String" && first([] argument.static_string) != null
}
in ts_binary let eval_string static_string != null && { value type_flags.nonempty ?? []; has_only_flags (["string", "literal"]) } || operator == "+" && (left.eval_string == true || right.eval_string == true)
in ts_parenthesized {
  let eval_callback expression.eval_callback
  let eval_string expression.eval_string
}
in ts_call, ts_new let eval_timer (contains(["setTimeout", "setInterval", "execScript"], callee.eval_name) || callee.eval_name == "setImmediate" && re_test(file, /\.[cm]?tsx?$/)) && callee.eval_timer_global == true
in ts_call.argument, ts_new.argument rule no-implied-eval {
  when index == 0 && parent.eval_timer == true && re_test(file, /\.[cm]?tsx?$/) && eval_callback != true
  warn "Implied eval. Consider passing a function."
}
in ts_call {
  rule no-implied-eval:core {
    when eval_timer && callee.eval_name != "execScript" && !re_test(file, /\.[cm]?tsx?$/) && first([] argument.eval_string) == true
    warn "Implied eval. Consider passing a function instead of a string."
  }
  rule no-implied-eval:exec {
    when eval_timer && callee.eval_name == "execScript" && !re_test(file, /\.[cm]?tsx?$/) && first([] argument.eval_string) == true
    warn "Implied eval. Do not use execScript()."
  }
}
in ts_call, ts_new {
  rule no-implied-eval:function {
    when callee.eval_name == "Function" && re_test(file, /\.[cm]?tsx?$/) && callee.eval_constructor
    when callee.eval_identifier == true || callee.eval_timer_global == true
    warn "Implied eval. Do not use the Function constructor to create functions."
  }
}

in ts_enum rule no-mixed-enums {
  when mixed_enum_offset != null
  report at mixed_enum_offset
  warn "Mixing number and string enums can be confusing."
}

fn unsafe_argument_sender(transfer) = if transfer.error then if transfer.mode == "array" then "error" else "error typed" else if transfer.mode == "tuple" then "of type `{transfer.sender}`" else "`{transfer.sender}`"
fn unsafe_assignment_sender(transfer) = if transfer.error then "error typed" else "`{transfer.sender}`"

in ts_call, ts_new, ts_tagged_template {
  rule no-unsafe-argument {
    each unsafe_arg in argument_transfers.nonempty ?? []
    when unsafe_arg.mode == "argument"
    report at unsafe_arg.offset
    warn "Unsafe argument of type " unsafe_argument_sender(unsafe_arg) " assigned to a parameter of type `{unsafe_arg.receiver}`."
  }
  rule no-unsafe-argument:spread {
    each unsafe_arg in argument_transfers.nonempty ?? []
    when unsafe_arg.mode == "spread"
    report at unsafe_arg.offset
    warn "Unsafe spread of an " unsafe_argument_sender(unsafe_arg) " type."
  }
  rule no-unsafe-argument:array {
    each unsafe_arg in argument_transfers.nonempty ?? []
    when unsafe_arg.mode == "array"
    report at unsafe_arg.offset
    warn "Unsafe spread of an " unsafe_argument_sender(unsafe_arg) " array type."
  }
  rule no-unsafe-argument:tuple {
    each unsafe_arg in argument_transfers.nonempty ?? []
    when unsafe_arg.mode == "tuple"
    report at unsafe_arg.offset
    warn "Unsafe spread of a tuple type. The argument is " unsafe_argument_sender(unsafe_arg) " and is assigned to a parameter of type `{unsafe_arg.receiver}`."
  }
}

in ts_declarator, ts_parameter, ts_class_property, ts_assignment, ts_assignment_pattern, ts_property, ts_spread, ts_jsx_attribute {
  rule no-unsafe-assignment {
    each unsafe_assigned in assignment_transfers.nonempty ?? []
    when unsafe_assigned.mode == "any"
    report at unsafe_assigned.offset
    warn "Unsafe assignment of an " unsafe_assignment_sender(unsafe_assigned) " value."
  }
  rule no-unsafe-assignment:generic {
    each unsafe_assigned in assignment_transfers.nonempty ?? []
    when unsafe_assigned.mode == "generic"
    report at unsafe_assigned.offset
    warn "Unsafe assignment of type " unsafe_assignment_sender(unsafe_assigned) " to a variable of type `{unsafe_assigned.receiver}`."
  }
  rule no-unsafe-assignment:array {
    each unsafe_assigned in assignment_transfers.nonempty ?? []
    when unsafe_assigned.mode == "array"
    report at unsafe_assigned.offset
    warn "Unsafe array destructuring of an " unsafe_assignment_sender(unsafe_assigned) " array value."
  }
  rule no-unsafe-assignment:tuple {
    each unsafe_assigned in assignment_transfers.nonempty ?? []
    when unsafe_assigned.mode == "tuple"
    report at unsafe_assigned.offset
    warn "Unsafe array destructuring of a tuple element with an " unsafe_assignment_sender(unsafe_assigned) " value."
  }
  rule no-unsafe-assignment:object {
    each unsafe_assigned in assignment_transfers.nonempty ?? []
    when unsafe_assigned.mode == "object"
    report at unsafe_assigned.offset
    warn "Unsafe object destructuring of a property with an " unsafe_assignment_sender(unsafe_assigned) " value."
  }
  rule no-unsafe-assignment:spread {
    each unsafe_assigned in assignment_transfers.nonempty ?? []
    when unsafe_assigned.mode == "spread"
    report at unsafe_assigned.offset
    warn "Unsafe spread of an " unsafe_assignment_sender(unsafe_assigned) " value in an array."
  }
}

fn unsafe_return_sender(transfer) = if transfer.error then "error" else if transfer.mode == "array" then "`any[]`" else if transfer.mode == "promise" then "`Promise<any>`" else "`any`"

in ts_return, ts_arrow.body rule no-unsafe-return {
  when return_transfer != null && return_transfer.mode != "generic"
  warn "Unsafe return of a value of type " unsafe_return_sender(return_transfer) "."
}
in ts_return, ts_arrow.body rule no-unsafe-return:assignment {
  when return_transfer != null && return_transfer.mode == "generic"
  warn "Unsafe return of type `{return_transfer.sender}` from function with return type `{return_transfer.receiver}`."
}

in ts_method, ts_function, ts_arrow rule prefer-return-this-type {
  when this_return_type_offset != null
  report at this_return_type_offset
  warn "Use `this` type instead."
}

in ts_call rule prefer-regexp-exec {
  when regexp_exec_offset != null
  report at regexp_exec_offset
  warn "Use the `RegExp#exec()` method instead."
}

in ts_union, ts_intersection {
  rule no-redundant-type-constituents {
    each redundant_constituent in redundant_type_constituents.nonempty ?? []
    when redundant_constituent.mode == "overrides"
    report at redundant_constituent.offset
    warn "'{redundant_constituent.name}' overrides all other types in this {redundant_constituent.container} type."
  }
  rule no-redundant-type-constituents:overridden {
    each redundant_constituent in redundant_type_constituents.nonempty ?? []
    when redundant_constituent.mode == "overridden"
    report at redundant_constituent.offset
    warn "'{redundant_constituent.name}' is overridden by other types in this {redundant_constituent.container} type."
  }
  rule no-redundant-type-constituents:error {
    each redundant_constituent in redundant_type_constituents.nonempty ?? []
    when redundant_constituent.mode == "error"
    report at redundant_constituent.offset
    warn "'{redundant_constituent.name}' is an 'error' type that acts as 'any' and overrides all other types in this {redundant_constituent.container} type."
  }
  rule no-redundant-type-constituents:literal {
    each redundant_constituent in redundant_type_constituents.nonempty ?? []
    when redundant_constituent.mode == "literal"
    report at redundant_constituent.offset
    warn "{redundant_constituent.name} is overridden by {redundant_constituent.primitive} in this union type."
  }
  rule no-redundant-type-constituents:primitive {
    each redundant_constituent in redundant_type_constituents.nonempty ?? []
    when redundant_constituent.mode == "primitive"
    report at redundant_constituent.offset
    warn "{redundant_constituent.primitive} is overridden by the {redundant_constituent.name} in this intersection type."
  }
}

in ts_as, ts_type_assertion rule non-nullable-type-assertion-style {
  when non_null_assertion == true
  warn "Use a ! assertion to more succinctly remove null and undefined from the type."
}
in ts_as, ts_type_assertion rule prefer-reduce-type-parameter {
  when reduce_type_assertion == true
  warn "Unnecessary assertion: Array#reduce accepts a type parameter for the default value."
}
in ts_method.return_type, ts_method_signature.return_type rule related-getter-setter-pairs {
  when accessor_type_mismatch == true
  warn "`get()` type should be assignable to its equivalent `set()` type."
}
in ts_call, ts_unary, ts_binary, ts_assignment rule no-unnecessary-type-conversion {
  when unnecessary_type_conversion != null
  report at unnecessary_type_conversion.offset
  warn "{unnecessary_type_conversion.violation} does not change the type or value of the {unnecessary_type_conversion.type}."
}

# `await` of something that is not a promise; promise aggregators of arrays
# of non-promises.
in ts_await rule await-thenable {
  when argument.nonawaitable_type == true
  warn "Unexpected `await` of a non-Promise (non-\"Thenable\") value."
}
in ts_member, ts_index let promise_aggregate_member object.global_value == "Promise" && contains(["all", "allSettled", "race", "any"], static_name)
in ts_call let is_promise_aggregator callee.promise_aggregate_member == true
in ts_array let is_promise_aggregator_argument parent.is_promise_aggregator == true
in ts_array.element rule await-thenable:aggregate {
  when not ts_hole && parent.is_promise_aggregator_argument && nonawaitable_type == true
  warn "Unexpected iterable of non-Promise (non-\"Thenable\") values passed to promise aggregator."
}
in ts_call.argument rule await-thenable:iterable {
  when parent.is_promise_aggregator == true && not ts_array && nonawaitable_iterable == true
  warn "Unexpected iterable of non-Promise (non-\"Thenable\") values passed to promise aggregator."
}
in ts_for_of rule await-thenable:for-of {
  report at unparenthesised_node(right.node)
  when nonasync_for_of == true
  warn "Unexpected `for await...of` of a value that is not async iterable."
}
in ts_declarator.init rule await-thenable:using {
  when nonasync_using == true
  warn "Unexpected `await using` of a value that is not async disposable."
}

# no-unnecessary-type-arguments: the last explicit type argument is the type
# parameter's default, or what the arguments infer anyway.
in ts_call.type_argument, ts_new.type_argument, ts_type_reference.type_argument, ts_class.type_argument rule no-unnecessary-type-arguments {
  when type_argument_redundant != null
  warn if type_argument_redundant == "default" then "This is the default value for this type parameter, so it can be omitted." else "This value can be trivially inferred for this type parameter, so it can be omitted."
}

# ---- more type-aware rules (type_flags) ----------------------------------------
in ts_for_in rule no-for-in-array {
  report at unparenthesised_node(right.node)
  when { value right.type_flags.nonempty ?? []; has_only_flags (["array", "tuple", "union", "nullable", "undefined", "null"]) } && contains(right.type_flags, "array")
  warn "For-in loops over arrays skips holes, returns indices as strings, and may visit the prototype chain or other enumerable properties. Use a more robust iteration method such as for-of or array.forEach instead."
}

# Receivers: what the object of `x.method(...)` is.
in ts_member let receiver_flags object.type_flags
@macro receiver_is(kind) ({ value callee.receiver_flags.nonempty ?? []; contains kind } && !{ value callee.receiver_flags.nonempty ?? []; contains "unknown" })
in ts_call let is_index_of re_test(callee, /\.\s*indexOf$/) && count(argument) == 1 && (@receiver_is("array") || @receiver_is("string"))

in ts_binary rule prefer-includes {
  when left.is_index_of == true && (re_test(operator, /^!==?$/) && right == "-1" || re_test(operator, /^===?$/) && right == "-1" || operator == ">" && right == "-1" || operator == ">=" && right == "0" || operator == "<" && right == "0")
  warn "Use 'includes()' method instead."
}

# ---- template interpolation ----------------------------------------------------
in ts_template let tagged_template parent is ts_tagged_template
in ts_node let restrict_template_expressions_type_checks template_type_checks
in ts_template.expression rule restrict-template-expressions {
  option allowAny boolean = true "Allow any values"
  option allowArray boolean = false "Allow arrays whose elements can be interpolated"
  option allowBoolean boolean = true "Allow booleans"
  option allowNullish boolean = true "Allow null and undefined"
  option allowNumber boolean = true "Allow numbers and bigints"
  option allowRegExp boolean = true "Allow regular expressions"
  option allowNever boolean = false "Allow never values"
  option allow string[] | null = null "Allowed types and values; null keeps standard library Error, URL and URLSearchParams"
  let enabled_template_options ["string"] (if allowAny then ["any"] else []) (if allowArray then ["array"] else []) (if allowBoolean then ["boolean"] else []) (if allowNullish then ["nullish"] else []) (if allowNumber then ["number"] else []) (if allowRegExp then ["regexp"] else []) (if allowNever then ["never"] else [])
  when parent.tagged_template != true
  when template_type_checks != null
  when any(restrict_template_expressions_type_checks, clause => !any(clause, gate => contains(enabled_template_options, gate.option) || gate.name != null && (if allow == null then gate.from == "lib" && contains(["Error", "URL", "URLSearchParams"], gate.name) else contains(allow, gate.name))))
  warn "Invalid type \"{template_type_display}\" of template literal expression."
}

in ts_unary rule no-unsafe-unary-minus {
  when operator == "-" && { value argument.type_flags.nonempty ?? []; count } > 0 && !contains(argument.type_flags, "any") && !contains(argument.type_flags, "unknown") && !contains(argument.type_flags, "number") && !contains(argument.type_flags, "bigint") && !contains(argument.type_flags, "enum")
  warn "Argument of unary negation should be assignable to number | bigint but is { { value argument.type.nonempty ?? '?'; re_replace /^\"[\s\S]*\"$/ 'string' } } instead."
}

in ts_member, ts_index let object_array_type object.array_type
in ts_parenthesized let object_array_type expression.object_array_type
in ts_member, ts_index let array_literal_object object is ts_array
in ts_parenthesized let array_literal_object expression.array_literal_object
in ts_unary rule no-array-delete {
  when operator == "delete" && (argument.array_literal_object == true || argument.object_array_type == true)
  warn "Using the `delete` operator with an array expression is unsafe."
}

in ts_assignment_pattern, ts_parameter rule no-useless-default-assignment {
  when useless_default != null
  report at useless_default.offset
  warn if useless_default.kind == "optional" then "Using `= undefined` to make a parameter optional adds unnecessary runtime logic." else if useless_default.kind == "undefined" then "Default value is useless because it is undefined. Optional {useless_default.owner}s are already undefined by default." else "Default value is useless because the {useless_default.owner} is not optional."
}

in ts_as, ts_type_assertion rule no-unsafe-type-assertion {
  when unsafe_assertion != null
  warn if unsafe_assertion.kind == "from-any" then "Unsafe assertion from {unsafe_assertion.type} detected: consider using type guards or a safer assertion." else if unsafe_assertion.kind == "to-any" then "Unsafe assertion to {unsafe_assertion.type} detected: consider using a more specific type to ensure safety." else if unsafe_assertion.kind == "unconstrained" then "Unsafe type assertion: '{unsafe_assertion.type}' could be instantiated with an arbitrary type which could be unrelated to the original type." else if unsafe_assertion.kind == "constraint" then "Unsafe type assertion: the original type is assignable to the constraint of type '{unsafe_assertion.type}', but '{unsafe_assertion.type}' could be instantiated with a different subtype of its constraint." else "Unsafe type assertion: type '{unsafe_assertion.type}' is more narrow than the original type."
}

in ts_member let object_string_array_type object.string_array_type
in ts_call rule require-array-sort-compare {
  option ignoreStringArrays boolean = true "Ignore arrays whose elements are all strings"
  when count(argument) == 0 && re_test(callee, /\??\.\s*(sort|toSorted)$/)
  when callee.object_array_type == true && (!ignoreStringArrays || callee.object_string_array_type != true)
  warn "Require 'compare' argument."
}

in ts_call.callee rule no-unsafe-call {
  when unsafe_call_type != null
  warn if unsafe_call_type == "error" then if unsafe_this_type == "error" then "Unsafe call of a `this` type that could not be resolved." else "Unsafe call of a type that could not be resolved." else "Unsafe call of {if unsafe_call_type == 'function' then 'a `Function`' else 'an `any`'} typed value."
}
in ts_new rule no-unsafe-call:new {
  when callee.unsafe_call_type != null
  warn if callee.unsafe_call_type == "error" then "Unsafe construction of a type that could not be resolved." else "Unsafe construction of {if callee.unsafe_call_type == 'function' then 'a `Function`' else 'an `any`'} typed value."
}
in ts_tagged_template.tag rule no-unsafe-call:tag {
  when unsafe_call_type != null
  warn if unsafe_call_type == "error" then "Unsafe use of a template tag whose type could not be resolved." else "Unsafe use of {if unsafe_call_type == 'function' then 'a `Function`' else 'an `any`'} typed template tag."
}

in ts_unary rule no-meaningless-void-operator {
  option checkNever boolean = false "Also check calls returning never"
  when operator == "void" && argument != "0" && void_argument_kind != "assignment"
  when if void_argument_kind == "call" then { value argument.type_flags.nonempty ?? []; has_only_flags (["undefined", "nullable", "union"]) } || checkNever && { value argument.type_flags.nonempty ?? []; has_only_flags (["undefined", "nullable", "never", "union"]) } else !{ value argument.type_members.nonempty ?? []; contains "then" }
  warn if void_argument_kind == "call" then "void operator shouldn't be used on {argument.type}; it should convey that a return value is being ignored" else "void operator is useless here; it should only discard a call's return value"
}

in ts_member, ts_index {
  let any_access_root object.any_access_root == true || object.unsafe_type != null
  let unsafe_member_access object.unsafe_type != null && object.any_access_root != true
  let any_access_optional_root optional == null && (object.any_access_optional_root == true || object.unsafe_type != null)
  let unsafe_optional_member_access optional == null && object.unsafe_type != null && object.any_access_optional_root != true
  let object_unsafe_type object.unsafe_type
  let object_unsafe_this_type object.unsafe_this_type
}
in ts_member.property rule no-unsafe-member-access {
  option allowOptionalChaining boolean = false "Allow optional chaining on any"
  when if allowOptionalChaining then parent.unsafe_optional_member_access == true else parent.unsafe_member_access == true
  warn if parent.object_unsafe_type == "error" then "Unsafe member access .{text} on a type that cannot be resolved." else "Unsafe member access .{text} on an `any` value."
}
in ts_index.index rule no-unsafe-member-access:computed {
  option allowOptionalChaining boolean = false "Allow optional chaining on any"
  when if allowOptionalChaining then parent.unsafe_optional_member_access == true else parent.unsafe_member_access == true
  report at unsafe_member_key.offset
  warn if parent.object_unsafe_type == "error" then "Unsafe member access [{unsafe_member_key.text}] on a type that cannot be resolved." else "Unsafe member access [{unsafe_member_key.text}] on an `any` value."
}
in ts_index.index rule no-unsafe-member-access:key {
  option allowOptionalChaining boolean = false "Allow optional chaining on any"
  when unsafe_member_key.kind != null && (!allowOptionalChaining || parent.optional == null)
  report at unsafe_member_key.offset
  warn if unsafe_member_key.kind == "error" then "The type of computed name [{unsafe_member_key.text}] cannot be resolved." else "Computed name [{unsafe_member_key.text}] resolves to an `any` value."
}

}
