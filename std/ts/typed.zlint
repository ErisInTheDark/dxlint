# .ts/typed: typescript-eslint rules that need type information, on the
# native TypeScript layers and the type facts (`type`, `type_flags`,
# `type_members`, ...). Unresolved types differ from explicit unknown.

import .ts/arithmetic
import .ts/deprecation
import .ts/methods
import .ts/spreads
import .ts/type-specifiers

define {

@macro thenable contains(default(type_members, []), "then")
@macro flags (default(type_flags, []))
fn has_only_flags(fs, wanted) = count(fs) > 0 && count(unique(fs wanted)) == count(unique(wanted))
fn matches_type_names(groups, names) = all(groups, group => any(group, name => contains(names, name)))

in ts_type_reference, ts_intersection rule no-generated-empty-object-type {
  when generated_empty_object
  warn "This type resolves to `{{}}`, the empty object type. This was likely not intentional."
}

in ts_function, ts_arrow, ts_method rule require-await {
  when missing_await != null
  report at missing_await.offset
  warn missing_await.name " has no 'await' expression."
}

in ts_call rule use-unknown-in-catch-callback-variable {
  each finding in unsafe_catch_callbacks
  report at finding.offset
  warn "Prefer the safe `: unknown` for a `" finding.method "`" (if finding.method == "then" then " rejection" else "") " callback variable." (if finding.pattern == "array" then " The thrown error may not be iterable." else if finding.pattern == "object" then " The thrown error may be nullable, or may not have the expected shape." else "")
}

group promise_function_async_function ts_function, ts_arrow, ts_method
in promise_function_async_function let promise_function_async_kind
  if is ts_arrow then "arrow"
  else if is ts_method then if parent is ts_class then "method" else "expression"
  else if parent is (ts_program, ts_block, ts_export, ts_case, ts_if, ts_labeled) then "declaration"
  else "expression"
in promise_function_async_function let promise_function_async_checked true
in ts_method let promise_function_async_exempt
  contains(["get", "set"], kind)
  || parent is ts_class && !contains([] modifier, "static") && key not ts_computed_key && static_name == "constructor"
in promise_function_async_function rule promise-function-async {
  option allowAny boolean = true "Allow any and unknown return types"
  option allowedPromiseNames string[] = [] "Additional promise type names"
  when body != null && !contains([] modifier, "async")
  when !default(promise_function_async_exempt, false)
  when promise_function_async_checked
  let names ("Promise" allowedPromiseNames)
  let disallowed_unknown (!allowAny && any(function_return_info.returns, result => result.unknown))
  when disallowed_unknown || all(function_return_info.returns, result => if function_return_info.explicit then matches_type_names(result.groups, names) else any(result.groups, group => any(group, name => contains(names, name))))
  report at function_return_info.offset
  warn if !disallowed_unknown && any(function_return_info.returns, result => result.union && !matches_type_names(result.groups, names)) then "Functions that return promises must be async. Consider adding an explicit return type annotation if the function is intended to return a union of promise and non-promise types." else "Functions that return promises must be async."
}

in ts_throw.argument rule only-throw-error {
  option allow (string | { from: string; name: string | string[]; path?: string; package?: string })[] = [] "Additional allowed thrown types"
  option allowRethrowing boolean = true "Allow rethrowing catch and Promise rejection parameters"
  option allowThrowingAny boolean = true "Allow any values"
  option allowThrowingUnknown boolean = true "Allow unknown values"
  when error_value.kind != "error"
  when !allowRethrowing || !error_value.rethrown
  when !allowThrowingAny || error_value.kind != "any"
  when !allowThrowingUnknown || error_value.kind != "unknown"
  when !type_is_allowed(allow, type_specifier_groups)
  report at error_value.offset
  warn if error_value.kind == "undefined" then "Do not throw undefined." else "Expected an error object to be thrown."
}

in ts_identifier let rejection_global_promise text == "Promise" && resolved == "global" && global != "off"
in ts_identifier, ts_member, ts_index let rejection_constructor
  if re_test(file, /\.[cm]?tsx?$/) then builtin_constructor("Promise") else default(rejection_global_promise, false)
in ts_identifier, ts_member, ts_index let rejection_receiver
  rejection_constructor || re_test(file, /\.[cm]?tsx?$/) && builtin_type("Promise")
in ts_member, ts_index let rejection_member static_name == "reject" && object.rejection_receiver == true
in ts_parenthesized forward rejection_global_promise, rejection_constructor, rejection_receiver, rejection_member from expression
in ts_new let rejection_promise_constructor callee.rejection_constructor == true
in ts_function, ts_arrow, ts_parenthesized let rejection_executor
  if parent is ts_parenthesized then parent.rejection_executor
  else is ts_new.argument && index == 0 && parent.rejection_promise_constructor
in ts_parameter let rejection_parameter index == 1 && init == null && parent.rejection_executor == true
in ts_identifier let rejection_binding is ts_parameter.name && parent.rejection_parameter == true
in ts_call let rejection_call
  callee.rejection_member == true || any(callee.declarations, d => d.rejection_binding == true)
in ts_node let rejection_reason
  {possible: could_be_error && error_global_undefined != true, kind: error_value.kind, groups: type_specifier_groups}
in ts_call rule prefer-promise-reject-errors {
  option allowEmptyReject boolean = false "Allow rejection without a reason"
  option allow (string | { from: string; name: string | string[]; path?: string; package?: string })[] = [] "Additional allowed rejection types"
  option allowThrowingAny boolean = false "Allow any values"
  option allowThrowingUnknown boolean = false "Allow unknown values"
  when rejection_call
  let reason first([] argument.rejection_reason)
  when reason != null || !allowEmptyReject
  when reason == null || (if re_test(file, /\.[cm]?tsx?$/) then reason.kind != "error" && !(allowThrowingAny && reason.kind == "any") && !(allowThrowingUnknown && reason.kind == "unknown") && !type_is_allowed(allow, reason.groups) else !reason.possible)
  warn "Expected the Promise rejection reason to be an Error."
}

fn stringification_compound(parts, kind) =
  if kind == "union" then if all(parts, part => part == 2) then 2 else if all(parts, part => part == 0) then 0 else 1
  else if any(parts, part => part == 0) then 0 else 2
fn stringification_collection(parts) = if any(parts, part => part == 2) then 2 else if any(parts, part => part == 1) then 1 else 0
fn stringification_object_member(declaration) = declaration.owner.kind == "interface" && declaration.owner.name == "Object"
fn stringification_leaf(t, unknown) =
  if any(t.members, member => member.name == "[Symbol.toPrimitive]" && any(member.declarations, declaration => declaration.signature && declaration.key_symbol == "toPrimitive")) then 0
  else if any(t.members, member => member.name != "[Symbol.toPrimitive]" && any(member.declarations, declaration => !stringification_object_member(declaration))) then 0
  else if any(t.members, member => member.name != "[Symbol.toPrimitive]" && any(member.declarations, declaration => stringification_object_member(declaration))) then 2
  else if unknown && contains(["unknown", "parameter"], t.kind) then 1 else 0
fn stringification_certainty(t, ignored, unknown) =
  if t.kind == "boolean" || any(t.names t.generic_names t.aliases, name => contains(ignored, name)) then 0
  else if contains(["union", "intersection"], t.kind) then stringification_compound(map(t.parts, part => stringification_certainty(part, ignored, unknown)), t.kind)
  else if contains(["array", "tuple"], t.kind) then stringification_collection(map(t.parts, part => stringification_certainty(part, ignored, unknown)))
  else stringification_leaf(t, unknown)
fn stringification_join(t, ignored, unknown) =
  if contains(["union", "intersection"], t.kind) then stringification_compound(map(t.parts, part => stringification_join(part, ignored, unknown)), t.kind)
  else if contains(["array", "tuple"], t.kind) then stringification_collection(map(t.parts, part => stringification_certainty(part, ignored, unknown)))
  else 0
in ts_node let stringification_type type_structure(["toString", "toLocaleString", "valueOf", "[Symbol.toPrimitive]"])
in ts_call let stringification_subjects
  if callee is ts_identifier && global_callee == "String" then [{node: unparenthesised_node(first([] argument.node)), join: false}]
  else if callee is ts_member && callee.property is ts_identifier && contains(["toString", "toLocaleString", "join"], callee.property.text) then [{node: unparenthesised_node(callee.object.node), join: callee.property.text == "join"}]
  else []
in ts_binary, ts_assignment let stringification_subjects
  if contains(["+", "+="], operator) && left.type_is_string_like then [{node: unparenthesised_node(right.node), join: false}]
  else if contains(["+", "+="], operator) && right.type_is_string_like && left not ts_private_name then [{node: unparenthesised_node(left.node), join: false}]
  else []
in ts_template let stringification_subjects if parent is ts_tagged_template then [] else map([] expression.node, n => {node: unparenthesised_node(n), join: false})
in ts_call, ts_binary, ts_assignment, ts_template rule no-base-to-string {
  option ignoredTypeNames string[] = ["Error", "RegExp", "URL", "URLSearchParams"] "Types whose string conversion is permitted"
  option checkUnknown boolean = false "Check explicit unknown and unconstrained type parameters"
  let findings map(stringification_subjects, subject => {
    node: subject.node,
    join: subject.join,
    certainty: if subject.join then stringification_join(subject.node.stringification_type, ignoredTypeNames, checkUnknown) else stringification_certainty(subject.node.stringification_type, ignoredTypeNames, checkUnknown)
  })
  each subject in findings
  when subject.node != null && subject.node not (ts_literal, ts_spread)
  when subject.certainty > 0
  report at {start: subject.node.offset, end: subject.node.end_offset}
  warn if subject.join then "Using `join()` for " subject.node.text " " (if subject.certainty == 2 then "will" else "may") " use Object's default stringification format ('[object Object]') when stringified."
    else "'" subject.node.text "' " (if subject.certainty == 2 then "will" else "may") " use Object's default stringification format ('[object Object]') when stringified."
}

in ts_identifier {
  let eval_name text
  let eval_identifier true
  let eval_core_root if contains(["global", "globalThis", "window", "self"], text) && global != null && global != "off" then text else null
  let eval_timer_global resolved == "global" && (re_test(file, /\.[cm]?tsx?$/) || global != null && global != "off")
  let eval_constructor builtin_type("FunctionConstructor") || contains(default(type_flags, []), "any") || type_opaque && reference_kind == null
}
in ts_member, ts_index {
  let eval_name static_name
  let eval_core_root if object.eval_core_root != null && static_name == object.eval_core_root then object.eval_core_root else null
  let eval_timer_global if re_test(file, /\.[cm]?tsx?$/) then object is ts_identifier && contains(["global", "globalThis", "window"], object) else object.eval_core_root != null
  let eval_constructor builtin_type("FunctionConstructor") || contains(default(type_flags, []), "any") || type_opaque
}
in ts_member let eval_bind_member property == "bind"
in ts_parenthesized {
  let eval_name expression.eval_name
  let eval_identifier expression.eval_identifier
  let eval_core_root expression.eval_core_root
  let eval_timer_global expression.eval_timer_global
  let eval_constructor expression.eval_constructor
}
group typed_simple_expression ts_identifier, ts_private_name, ts_this, ts_super, ts_null, ts_boolean,
  ts_number, ts_bigint, ts_string, ts_regex, ts_template, ts_tagged_template, ts_array, ts_object,
  ts_member, ts_index, ts_new, ts_unary, ts_update, ts_await, ts_yield,
  ts_logical, ts_assignment, ts_conditional, ts_sequence, ts_as, ts_satisfies,
  ts_non_null, ts_type_assertion, ts_function, ts_arrow, ts_class, ts_instantiation, ts_meta_property,
  ts_import_call
in typed_simple_expression, ts_binary {
  let eval_callback callable || builtin_type("Function")
}
in typed_simple_expression {
  let eval_string is (ts_string, ts_template)
    || static_string != null && has_only_flags(default(type_flags, []), ["string", "literal"])
}
in ts_call {
  let eval_callback callable || builtin_type("Function") || callee.eval_bind_member == true || callee is ts_identifier && callee == "bind"
  let eval_string static_string != null && has_only_flags(default(type_flags, []), ["string", "literal"]) || callee.global_value == "String" && first([] argument.static_string) != null
}
in ts_binary let eval_string static_string != null && has_only_flags(default(type_flags, []), ["string", "literal"]) || operator == "+" && (left.eval_string == true || right.eval_string == true)
in ts_parenthesized {
  let eval_callback expression.eval_callback
  let eval_string expression.eval_string
}
in ts_call, ts_new let eval_timer (contains(["setTimeout", "setInterval", "execScript"], callee.eval_name) || callee.eval_name == "setImmediate" && re_test(file, /\.[cm]?tsx?$/)) && callee.eval_timer_global == true
in ts_call.argument, ts_new.argument rule no-implied-eval {
  when index == 0 && parent.eval_timer == true && re_test(file, /\.[cm]?tsx?$/) && eval_callback != true
  warn "Implied eval. Consider passing a function."
}
in ts_call {
  rule no-implied-eval:core {
    when eval_timer && callee.eval_name != "execScript" && !re_test(file, /\.[cm]?tsx?$/) && first([] argument.eval_string) == true
    warn "Implied eval. Consider passing a function instead of a string."
  }
  rule no-implied-eval:exec {
    when eval_timer && callee.eval_name == "execScript" && !re_test(file, /\.[cm]?tsx?$/) && first([] argument.eval_string) == true
    warn "Implied eval. Do not use execScript()."
  }
}
in ts_call, ts_new {
  rule no-implied-eval:function {
    when callee.eval_name == "Function" && re_test(file, /\.[cm]?tsx?$/) && callee.eval_constructor
    when callee.eval_identifier == true || callee.eval_timer_global == true
    warn "Implied eval. Do not use the Function constructor to create functions."
  }
}

in ts_enum rule no-mixed-enums {
  when mixed_enum_offset != null
  report at mixed_enum_offset
  warn "Mixing number and string enums can be confusing."
}

in ts_call, ts_new, ts_tagged_template {
  rule no-unsafe-argument {
    each unsafe_arg in default(unsafe_arguments, [])
    when unsafe_arg.mode == "argument"
    report at unsafe_arg.offset
    warn "Unsafe argument of type {unsafe_arg.sender} assigned to a parameter of type {unsafe_arg.receiver}."
  }
  rule no-unsafe-argument:spread {
    each unsafe_arg in default(unsafe_arguments, [])
    when unsafe_arg.mode == "spread"
    report at unsafe_arg.offset
    warn "Unsafe spread of an {unsafe_arg.sender} type."
  }
  rule no-unsafe-argument:array {
    each unsafe_arg in default(unsafe_arguments, [])
    when unsafe_arg.mode == "array"
    report at unsafe_arg.offset
    warn "Unsafe spread of an {unsafe_arg.sender} array type."
  }
  rule no-unsafe-argument:tuple {
    each unsafe_arg in default(unsafe_arguments, [])
    when unsafe_arg.mode == "tuple"
    report at unsafe_arg.offset
    warn "Unsafe spread of a tuple type. The argument is {unsafe_arg.sender} and is assigned to a parameter of type {unsafe_arg.receiver}."
  }
}

in ts_declarator, ts_parameter, ts_class_property, ts_assignment, ts_assignment_pattern, ts_property, ts_spread, ts_jsx_attribute {
  rule no-unsafe-assignment {
    each unsafe_assigned in default(unsafe_assignments, [])
    when unsafe_assigned.mode == "any"
    report at unsafe_assigned.offset
    warn "Unsafe assignment of an {unsafe_assigned.sender} value."
  }
  rule no-unsafe-assignment:generic {
    each unsafe_assigned in default(unsafe_assignments, [])
    when unsafe_assigned.mode == "generic"
    report at unsafe_assigned.offset
    warn "Unsafe assignment of type {unsafe_assigned.sender} to a variable of type {unsafe_assigned.receiver}."
  }
  rule no-unsafe-assignment:array {
    each unsafe_assigned in default(unsafe_assignments, [])
    when unsafe_assigned.mode == "array"
    report at unsafe_assigned.offset
    warn "Unsafe array destructuring of an {unsafe_assigned.sender} array value."
  }
  rule no-unsafe-assignment:tuple {
    each unsafe_assigned in default(unsafe_assignments, [])
    when unsafe_assigned.mode == "tuple"
    report at unsafe_assigned.offset
    warn "Unsafe array destructuring of a tuple element with an {unsafe_assigned.sender} value."
  }
  rule no-unsafe-assignment:object {
    each unsafe_assigned in default(unsafe_assignments, [])
    when unsafe_assigned.mode == "object"
    report at unsafe_assigned.offset
    warn "Unsafe object destructuring of a property with an {unsafe_assigned.sender} value."
  }
  rule no-unsafe-assignment:spread {
    each unsafe_assigned in default(unsafe_assignments, [])
    when unsafe_assigned.mode == "spread"
    report at unsafe_assigned.offset
    warn "Unsafe spread of an {unsafe_assigned.sender} value in an array."
  }
}

in ts_return, ts_arrow.body rule no-unsafe-return {
  when unsafe_return != null && unsafe_return.kind != null
  warn "Unsafe return of a value of type {unsafe_return.kind}."
}
in ts_return, ts_arrow.body rule no-unsafe-return:assignment {
  when unsafe_return != null && unsafe_return.sender != null
  warn "Unsafe return of type `{unsafe_return.sender}` from function with return type `{unsafe_return.receiver}`."
}

in ts_method, ts_function, ts_arrow rule prefer-return-this-type {
  when this_return_type_offset != null
  report at this_return_type_offset
  warn "Use `this` type instead."
}

in ts_call rule prefer-regexp-exec {
  when regexp_exec_offset != null
  report at regexp_exec_offset
  warn "Use the `RegExp#exec()` method instead."
}

in ts_union, ts_intersection {
  rule no-redundant-type-constituents {
    each redundant_constituent in default(redundant_type_constituents, [])
    when redundant_constituent.mode == "overrides"
    report at redundant_constituent.offset
    warn "'{redundant_constituent.name}' overrides all other types in this {redundant_constituent.container} type."
  }
  rule no-redundant-type-constituents:overridden {
    each redundant_constituent in default(redundant_type_constituents, [])
    when redundant_constituent.mode == "overridden"
    report at redundant_constituent.offset
    warn "'{redundant_constituent.name}' is overridden by other types in this {redundant_constituent.container} type."
  }
  rule no-redundant-type-constituents:error {
    each redundant_constituent in default(redundant_type_constituents, [])
    when redundant_constituent.mode == "error"
    report at redundant_constituent.offset
    warn "'{redundant_constituent.name}' is an 'error' type that acts as 'any' and overrides all other types in this {redundant_constituent.container} type."
  }
  rule no-redundant-type-constituents:literal {
    each redundant_constituent in default(redundant_type_constituents, [])
    when redundant_constituent.mode == "literal"
    report at redundant_constituent.offset
    warn "{redundant_constituent.name} is overridden by {redundant_constituent.primitive} in this union type."
  }
  rule no-redundant-type-constituents:primitive {
    each redundant_constituent in default(redundant_type_constituents, [])
    when redundant_constituent.mode == "primitive"
    report at redundant_constituent.offset
    warn "{redundant_constituent.primitive} is overridden by the {redundant_constituent.name} in this intersection type."
  }
}

group duplicate_type_constituent ts_union, ts_intersection
in duplicate_type_constituent let duplicate_type_constituents_checked true
in duplicate_type_constituent rule no-duplicate-type-constituents {
  when duplicate_type_constituents_checked
  each duplicate_constituent in default(duplicate_type_constituents, [])
  when duplicate_constituent.previous != null
  report at duplicate_constituent.offset
  warn "{duplicate_constituent.kind} type constituent is duplicated with {duplicate_constituent.previous}."
}
in duplicate_type_constituent rule no-duplicate-type-constituents:optional {
  when is ts_union
  when duplicate_type_constituents_checked
  each duplicate_constituent in default(duplicate_type_constituents, [])
  when duplicate_constituent.previous == null
  report at duplicate_constituent.offset
  warn "Explicit undefined is unnecessary on an optional parameter."
}

in ts_as, ts_type_assertion rule non-nullable-type-assertion-style {
  when non_null_assertion == true
  warn "Use a ! assertion to more succinctly remove null and undefined from the type."
}
in ts_as, ts_type_assertion rule prefer-reduce-type-parameter {
  when reduce_type_assertion == true
  warn "Unnecessary assertion: Array#reduce accepts a type parameter for the default value."
}
in ts_method.return_type, ts_method_signature.return_type rule related-getter-setter-pairs {
  when accessor_type_mismatch == true
  warn "`get()` type should be assignable to its equivalent `set()` type."
}
in ts_call, ts_unary, ts_binary, ts_assignment rule no-unnecessary-type-conversion {
  when unnecessary_type_conversion != null
  report at unnecessary_type_conversion.offset
  warn "{unnecessary_type_conversion.violation} does not change the type or value of the {unnecessary_type_conversion.type}."
}

# A promise-valued statement that nothing awaits or handles.
# `.catch(handler)` and `.then(ok, handler)` handle rejections; `.finally`
# keeps what the chain before it did.
in ts_member let chain_handles_rejection object.handles_rejection
in ts_call let handles_rejection callee ~ /[\s\S]*\.catch/ && count(argument) >= 1 || callee ~ /[\s\S]*\.then/ && count(argument) >= 2 || callee ~ /[\s\S]*\.finally/ && callee.chain_handles_rejection == true
in ts_expression_statement.expression rule no-floating-promises {
  when not (ts_assignment, ts_await) && !handles_rejection && @thenable
  warn "Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator."
}

# `await` of something that is not a promise; promise aggregators of arrays
# of non-promises.
in ts_await rule await-thenable {
  when argument.nonawaitable_type == true
  warn "Unexpected `await` of a non-Promise (non-\"Thenable\") value."
}
in ts_member, ts_index let promise_aggregate_member object.global_value == "Promise" && contains(["all", "allSettled", "race", "any"], static_name)
in ts_call let is_promise_aggregator callee.promise_aggregate_member == true
in ts_array let is_promise_aggregator_argument parent.is_promise_aggregator == true
in ts_array.element rule await-thenable:aggregate {
  when not ts_hole && parent.is_promise_aggregator_argument && nonawaitable_type == true
  warn "Unexpected iterable of non-Promise (non-\"Thenable\") values passed to promise aggregator."
}
in ts_call.argument rule await-thenable:iterable {
  when parent.is_promise_aggregator == true && not ts_array && nonawaitable_iterable == true
  warn "Unexpected iterable of non-Promise (non-\"Thenable\") values passed to promise aggregator."
}
in ts_for_of rule await-thenable:for-of {
  when nonasync_for_of == true
  warn "Unexpected `for await...of` of a value that is not async iterable."
}
in ts_declarator.init rule await-thenable:using {
  when nonasync_using == true
  warn "Unexpected `await using` of a value that is not async disposable."
}

# no-unnecessary-type-arguments: the last explicit type argument is the type
# parameter's default, or what the arguments infer anyway.
in ts_call.type_argument, ts_new.type_argument, ts_type_reference.type_argument, ts_class.type_argument rule no-unnecessary-type-arguments {
  when type_argument_redundant != null
  warn if type_argument_redundant == "default" then "This is the default value for this type parameter, so it can be omitted." else "This value can be trivially inferred for this type parameter, so it can be omitted."
}

# Structural shapes keep computed access and calls distinct from dotted names.
in ts_identifier, ts_private_name, ts_this, ts_super, ts_literal let optional_shape [kind_name(node), text]
in ts_parenthesized let optional_shape if expression.in_optional_chain == true && parent is (ts_member, ts_index, ts_call) then ["boundary", expression.optional_shape] else expression.optional_shape
in ts_non_null let optional_shape expression.optional_shape
in ts_meta_property let optional_shape ["meta", text]
in ts_await let optional_shape if argument.optional_shape != null then ["await", argument.optional_shape] else null
in ts_member let optional_shape if object.optional_shape != null && property.optional_shape != null then ["member", object.optional_shape, property.optional_shape] else null
in ts_index let optional_shape if object.optional_shape != null && index.optional_shape != null then ["index", object.optional_shape, index.optional_shape] else null
in ts_call let optional_shape if callee.optional_shape != null && all([] argument.optional_shape, shape => shape != null) then ["call", callee.optional_shape, [] argument.optional_shape, [] type_argument.text] else null
in ts_unary let optional_shape if argument.optional_shape != null then ["unary", operator, argument.optional_shape] else null
in ts_binary let optional_shape if left.optional_shape != null && right.optional_shape != null then ["binary", operator, left.optional_shape, right.optional_shape] else null
in ts_template let optional_shape ["template", [] quasi.text, [] expression.optional_shape]
in ts_parenthesized let optional_operands expression.optional_operands
in ts_logical let optional_operands (if unparenthesised_node(left.node) is ts_logical && unparenthesised_node(left.node).operator == operator then left.optional_operands else [left.node]) (if unparenthesised_node(right.node) is ts_logical && unparenthesised_node(right.node).operator == operator then right.optional_operands else [right.node])
fn optional_base(n) = if n is (ts_member, ts_index) && n.property not ts_private_name then n.object.node else if n is ts_call then n.callee.node else if n is ts_non_null then n.expression.node else if n is ts_parenthesized && n.expression.in_optional_chain != true then n.expression.node else null
fn optional_same(a, b) = a.optional_shape != null && a.optional_shape == b.optional_shape
fn optional_extends(a, b) = last(walk(a, current => if current is ts_non_null then current.expression.node else null)) is (ts_identifier, ts_member, ts_index, ts_call, ts_meta_property) && !optional_same(a, b) && any(slice(walk(b, current => optional_base(current)), 1), current => optional_same(a, current))
fn optional_nullish(n) = if n is ts_null then "null" else if n is ts_identifier && n.text == "undefined" then "undefined" else if n is ts_string && n.literal_value.value == "undefined" then "typeof" else null
fn optional_subject(n, value) = if value == "typeof" && n is ts_unary && n.operator == "typeof" && !(n.argument is ts_identifier && n.argument.is_real_global) then n.argument.node else if value != "typeof" then n else null
fn optional_comparison_kind(value, comparison, op) = if value != "typeof" && starts_with(comparison, "!") != (op == "&&") then "last" else if comparison == "==" || comparison == "!=" then "nullish" else if value == "typeof" then "undefined" else value
fn optional_binary_operand(n, op) = if optional_nullish(n.right.node) != null then {node: n, subject: optional_subject(n.left.node, optional_nullish(n.right.node)), kind: optional_comparison_kind(optional_nullish(n.right.node), n.operator, op), matches: starts_with(n.operator, "!") == (op == "&&"), comparison: n.operator} else if optional_nullish(n.left.node) != null then {node: n, subject: optional_subject(n.right.node, optional_nullish(n.left.node)), kind: optional_comparison_kind(optional_nullish(n.left.node), n.operator, op), matches: starts_with(n.operator, "!") == (op == "&&"), comparison: n.operator} else {node: n, subject: null, kind: "last", matches: false, comparison: n.operator}
fn optional_operand(n, op) = if n is ts_binary then optional_binary_operand(n, op) else if n is ts_unary && n.operator == "!" then {node: n, subject: unparenthesised_node(n.argument.node), kind: "not", matches: op == "||"} else {node: n, subject: unparenthesised_node(n), kind: "plain", matches: op == "&&"}
fn optional_falsy_literal(n) = any(n.type_literal_values, literal => literal.type == "boolean" && literal.value == false || literal.type == "number" && literal.value == 0 || literal.type == "string" && literal.value == "" || literal.type == "bigint" && re_test(literal.value, /^-?0(?:[xXbBoO]0+|0*)n$/))
fn optional_type_allowed(n, opts) = !n.type_has_void && all(default(n.type_flags, ["unknown"]), flag => !contains(["any", "unknown", "string", "number", "boolean", "bigint"], flag) || get(opts, flag))
fn optional_uncertain(n, flag) = any(default(n.type_flags, ["unknown"]), part => contains([flag, "any", "unknown"], part))
fn optional_span(items, opts) = if len(items) > 1 && (!opts.requireNullish || any(slice(items, 0, -1), item => contains(default(item.subject.type_flags, []), "nullable"))) then {start: if re_test(byte_slice(opts.boundary, 0, first(items).node.offset - opts.boundary.offset), /^(?:\s|\(|\/\*[\s\S]*?\*\/|\/\/[^\n]*\n)*$/) then opts.boundary.offset else first(items).node.offset, end: last(items).end + byte_len(default(re_find(byte_slice(opts.boundary, last(items).end - opts.boundary.offset), /^(?:(?:\s|\/\*[\s\S]*?\*\/|\/\/[^\n]*\n)*\))+/), ""))} else null
fn optional_flush(state, opts) = if optional_span(state.items, opts) != null then state.reports [optional_span(state.items, opts)] else state.reports
# Paired strict guards form one logical unit; the fold consumes their next operand.
fn optional_group(current, next) = current.matches && next.matches && contains(["null", "undefined"], current.kind) && contains(["null", "undefined"], next.kind) && current.kind != next.kind && optional_same(current.subject, next.subject)
fn optional_valid(current, next, op, last, opts) = current.subject != null && current.matches && (if contains(["plain", "not"], current.kind) then last || optional_type_allowed(current.subject, opts) && !(current.kind == (if op == "&&" then "plain" else "not") && optional_falsy_literal(current.subject)) else current.kind == "nullish" || optional_group(current, next) || current.kind == "null" && (op == "||" || next != null) && !optional_uncertain(current.subject, "undefined") || current.kind == "undefined" && !optional_uncertain(current.subject, "null"))
fn optional_terminal_allowed(n, comparison, op) = if comparison == (if op == "&&" then "===" else "!==") then !optional_uncertain(n, "undefined") else if comparison == (if op == "&&" then "==" else "!=") then !optional_uncertain(n, "null") && !optional_uncertain(n, "undefined") else if comparison == (if op == "&&" then "!==" else "===") then all(default(n.type_flags, ["unknown"]), flag => contains(["undefined", "nullable", "union"], flag)) else if comparison == (if op == "&&" then "!=" else "==") then all(default(n.type_flags, ["unknown"]), flag => contains(["null", "undefined", "nullable", "union"], flag)) else false
fn optional_terminal(state, current, op, opts) = if len(state.items) > 0 && (optional_extends(last(state.items).subject, current.node.left.node) && !optional_extends(last(state.items).subject, current.node.right.node) && optional_terminal_allowed(current.node.right.node, current.comparison, op) || optional_extends(last(state.items).subject, current.node.right.node) && !optional_extends(last(state.items).subject, current.node.left.node) && optional_terminal_allowed(current.node.left.node, current.comparison, op)) then state.reports [optional_span(state.items [{node: current.node, subject: current.node, end: current.node.end_offset}], opts)] else optional_flush(state, opts)
fn optional_accept(state, current, next, opts) = if len(state.items) == 0 || optional_extends(last(state.items).subject, current.subject) then {items: state.items [{node: current.node, subject: current.subject, end: if optional_group(current, next) then next.node.end_offset else current.node.end_offset}], reports: state.reports, skip: optional_group(current, next)} else if optional_same(last(state.items).subject, current.subject) then {items: state.items, reports: state.reports, skip: optional_group(current, next)} else {items: [{node: current.node, subject: current.subject, end: if optional_group(current, next) then next.node.end_offset else current.node.end_offset}], reports: optional_flush(state, opts), skip: optional_group(current, next)}
fn optional_step(state, current, next, op, last, opts) = if state.skip then {items: state.items, reports: state.reports, skip: false} else if current.kind == "last" then {items: [], reports: optional_terminal(state, current, op, opts), skip: false} else if optional_valid(current, next, op, last, opts) then optional_accept(state, current, next, opts) else {items: [], reports: if current.kind == "undefined" && len(state.items) > 0 && optional_extends(last(state.items).subject, current.subject) then state.reports [optional_span(state.items [{node: current.node, subject: current.subject, end: current.node.end_offset}], opts)] else optional_flush(state, opts), skip: false}
in ts_logical rule prefer-optional-chain {
  option checkAny boolean = true "Check any values"
  option checkUnknown boolean = true "Check unknown values"
  option checkString boolean = true "Check string values"
  option checkNumber boolean = true "Check number values"
  option checkBoolean boolean = true "Check boolean values"
  option checkBigInt boolean = true "Check bigint values"
  option requireNullish boolean = false "Require a nullable checked operand"
  let enclosing last(walk(node, current => if current.parent is ts_parenthesized then current.parent.node else null))
  when operator != "??" && !(enclosing.parent is ts_logical && enclosing.parent.operator == operator)
  let opts {any: checkAny, unknown: checkUnknown, string: checkString, number: checkNumber, boolean: checkBoolean, bigint: checkBigInt, requireNullish: requireNullish, boundary: node}
  let operands map(optional_operands, operand => optional_operand(unparenthesised_node(operand), operator))
  let state reduce(zip(operands, slice(operands, 1) [null]), {items: [], reports: [], skip: false}, (state, pair) => optional_step(state, first(pair), last(pair), operator, last(pair) == null, opts))
  each span in filter(optional_flush(state, opts), report => report != null)
  report at span
  warn "Prefer using an optional chain expression instead, as it's more concise and easier to read."
}
in ts_logical rule prefer-optional-chain:empty-object {
  option requireNullish boolean = false "Require a nullable checked operand"
  when contains(["||", "??"], operator) && unparenthesised_node(right.node) is ts_object && count(unparenthesised_node(right.node).property) == 0
  let enclosing last(walk(node, current => if current.parent is ts_parenthesized then current.parent.node else null))
  when enclosing.parent is (ts_member, ts_index) && enclosing.parent.optional == null
  when !requireNullish || contains(default(left.type_flags, []), "nullable")
  report at enclosing.parent
  warn "Prefer using an optional chain expression instead, as it's more concise and easier to read."
}

# ---- more type-aware rules (type_flags) ----------------------------------------
in ts_for_in rule no-for-in-array {
  when has_only_flags(default(right.type_flags, []), ["array", "tuple", "union", "nullable", "undefined", "null"]) && contains(right.type_flags, "array")
  warn "For-in loops over arrays skips holes, returns indices as strings, and may visit the prototype chain or other enumerable properties. Use a more robust iteration method such as for-of or array.forEach instead."
}

# checksVoidReturn off (wayward): conditions and spreads only.
in ts_if.test, ts_while.test, ts_do_while.test, ts_for.test rule no-misused-promises {
  # Always a promise: `Promise | undefined` is a fair thing to test.
  when contains(@flags, "promise") && has_only_flags(@flags, ["promise", "object", "union"])
  warn "Expected non-Promise value in a boolean conditional."
}

in ts_binary {
  let boolean_literal if re_test(right, /^(true|false)$/) then right else if re_test(left, /^(true|false)$/) then left else null
  let other_side_flags if re_test(right, /^(true|false)$/) then left.type_flags else right.type_flags
}
in ts_binary rule no-unnecessary-boolean-literal-compare {
  when re_test(operator, /^[!=]==?$/) && boolean_literal != null && has_only_flags(default(other_side_flags, []), ["boolean", "literal"])
  warn if boolean_literal == "true" then "This expression unnecessarily compares a boolean value to a boolean instead of using it directly." else "This expression unnecessarily compares a boolean value to a boolean instead of negating it."
}

fn template_interpolation_subject(n) = if n is ts_literal_type then n.value.node else unparenthesised_node(n)
fn template_interpolation_whitespace(n) = if n is ts_string then n.literal_value.type == "string" && re_test(n.literal_value.value, /^[\t\v\f \r\n\uFEFF\p{Zs}\u2028\u2029]*$/) else n is (ts_template, ts_template_type) && count(n.quasi) == 1 && re_test(byte_slice(first(n.quasi), 1, byte_len(first(n.quasi)) - 1), /^[\t\v\f \r\n\uFEFF\p{Zs}\u2028\u2029]*$/)
fn template_interpolation_literal(n, type_syntax) = n is ts_literal || n is (ts_template, ts_template_type) || (if type_syntax then n is ts_type_keyword && contains(["null", "undefined"], n.text) else n is ts_identifier && contains(["undefined", "Infinity", "NaN"], n.text))
fn template_interpolation_string(n, single, type_syntax) = single && n.type_is_string_like && (!type_syntax || !n.type_is_parameter && !n.type_has_enum)
in ts_template let template_interpolation_nodes [] expression.node
in ts_template_type let template_interpolation_nodes [] type.node
in ts_template, ts_template_type rule no-unnecessary-template-expression {
  when parent not ts_tagged_template
  let single count(template_interpolation_nodes) == 1 && first([] quasi.text) == "`${{" && last([] quasi.text) == "}}`"
  let comments descendants(ts_comment)
  let type_syntax is ts_template_type
  let interpolation_pairs map(zip(template_interpolation_nodes, zip([] quasi.node, slice([] quasi.node, 1))), pair => {
    expression: unparenthesised_node(first(pair)),
    subject: template_interpolation_subject(first(pair)),
    previous: first(last(pair)),
    following: last(last(pair)),
    string_only: template_interpolation_string(unparenthesised_node(first(pair)), single, type_syntax)
  })
  each interpolation in interpolation_pairs
  when !any(comments, comment => comment.offset >= interpolation.previous.end_offset && comment.end_offset <= interpolation.following.offset)
  when interpolation.string_only || template_interpolation_literal(interpolation.subject, type_syntax) && !(re_test(interpolation.following.text, /^}[\r\n\u2028\u2029]/) && template_interpolation_whitespace(interpolation.subject))
  report at if interpolation.string_only then {start: interpolation.expression.offset - 2, end: interpolation.expression.end_offset + 1} else {start: interpolation.previous.end_offset - 2, end: interpolation.following.offset + 1}
  warn "Template literal expression is unnecessary and can be simplified."
}

# Receivers: what the object of `x.method(...)` is.
in ts_member let receiver_flags object.type_flags
@macro receiver_is(kind) (contains(default(callee.receiver_flags, []), kind) && !contains(default(callee.receiver_flags, []), "unknown"))
in ts_call let is_index_of re_test(callee, /\.\s*indexOf$/) && count(argument) == 1 && (@receiver_is("array") || @receiver_is("string"))

in ts_binary rule prefer-includes {
  when left.is_index_of == true && (re_test(operator, /^!==?$/) && right == "-1" || re_test(operator, /^===?$/) && right == "-1" || operator == ">" && right == "-1" || operator == ">=" && right == "0" || operator == "<" && right == "0")
  warn "Use 'includes()' method instead."
}

# startsWith / endsWith written the long way, on strings.
in ts_call {
  let starts_ends_kind if @receiver_is("string") && re_test(callee, /\.\s*indexOf$/) then "start_index" else if @receiver_is("string") && re_test(callee, /\.\s*charAt$/) && first([] argument) == "0" then "start" else if @receiver_is("string") && re_test(callee, /\.\s*(slice|substring)$/) && first([] argument) == "0" then "start" else if @receiver_is("string") && re_test(callee, /\.\s*lastIndexOf$/) then "end_index" else if @receiver_is("string") && re_test(callee, /\.\s*slice$/) && re_test(first([] argument), /^-/) && count(argument) == 1 then "end" else null
  let regex_starts_test re_test(callee, /^\/\^[\w\s-]+\/\.\s*test$/) && count(argument) == 1 && contains(default(argument.type_flags, []), "string")
  let regex_ends_test re_test(callee, /^\/[\w\s-]+\$\/\.\s*test$/) && count(argument) == 1 && contains(default(argument.type_flags, []), "string")
}
in ts_index let starts_ends_kind if contains(default(object.type_flags, []), "string") && index == "0" then "start" else if contains(default(object.type_flags, []), "string") && re_test(index, /\.length\s*-\s*1$/) then "end" else null
in ts_binary rule prefer-string-starts-ends-with {
  when re_test(operator, /^[!=]==?$/)
  when left.starts_ends_kind == "start_index" && right == "0" || left.starts_ends_kind == "start" || left.starts_ends_kind == "end_index" && re_test(right, /\.length\s*-/) || left.starts_ends_kind == "end"
  warn if re_test(default(left.starts_ends_kind, ""), /^end/) then "Use the 'String#endsWith' method instead." else "Use 'String#startsWith' method instead."
}
in ts_call rule prefer-string-starts-ends-with:regex {
  when regex_starts_test || regex_ends_test
  warn if regex_ends_test then "Use the 'String#endsWith' method instead." else "Use 'String#startsWith' method instead."
}

# Private members never written after construction.
fn is_private(m) = re_test(m, /\bprivate\b/)
in ts_class_property rule prefer-readonly {
  when (is_private(join([] modifier, " ")) || re_test(key, /^#/)) && !contains([] modifier, "readonly") && !contains([] modifier, "static") && member_writes == 0
  # Computed keys and decorated members can be written where zlint cannot see.
  when !re_test(key, /^\[/) && count(decorator) == 0
  warn "Member '{key}' is never reassigned; mark it as `readonly`."
}
in ts_parameter rule prefer-readonly:parameter {
  when member_writes == 0 && is_private(join([] modifier, " ")) && !contains([] modifier, "readonly")
  warn "Member '{re_replace(text, /^(?:(?:private|public|protected|readonly|override)\s+)*/, '')}' is never reassigned; mark it as `readonly`."
}

# ---- template interpolation ----------------------------------------------------
in ts_template let tagged_template parent is ts_tagged_template
in ts_template.expression rule restrict-template-expressions {
  option allowAny boolean = true "Allow any values"
  option allowArray boolean = false "Allow arrays whose elements can be interpolated"
  option allowBoolean boolean = true "Allow booleans"
  option allowNullish boolean = true "Allow null and undefined"
  option allowNumber boolean = true "Allow numbers and bigints"
  option allowRegExp boolean = true "Allow regular expressions"
  option allowNever boolean = false "Allow never values"
  option allow (string | { from: string; name: string | string[]; path?: string; package?: string })[] = [{ from: "lib", name: ["Error", "URL", "URLSearchParams"] }] "Additional allowed types and values"
  let enabled_template_options ["string"] (if allowAny then ["any"] else []) (if allowArray then ["array"] else []) (if allowBoolean then ["boolean"] else []) (if allowNullish then ["nullish"] else []) (if allowNumber then ["number"] else []) (if allowRegExp then ["regexp"] else []) (if allowNever then ["never"] else [])
  when parent.tagged_template != true
  when template_type_checks != null
  when any(template_type_checks, clause => !any(clause, gate => contains(enabled_template_options, gate.option) || gate.name != null && any(allow, spec => matches_type_specifier(spec, gate))))
  warn "Invalid type \"{template_type_display}\" of template literal expression."
}

in ts_unary rule no-unsafe-unary-minus {
  when operator == "-" && count(default(argument.type_flags, [])) > 0 && !contains(argument.type_flags, "any") && !contains(argument.type_flags, "unknown") && !contains(argument.type_flags, "number") && !contains(argument.type_flags, "bigint") && !contains(argument.type_flags, "enum")
  warn "Argument of unary negation should be assignable to number | bigint but is {re_replace(default(argument.type, '?'), /^\"[\s\S]*\"$/, 'string')} instead."
}

in ts_member, ts_index let object_array_type object.array_type
in ts_parenthesized let object_array_type expression.object_array_type
in ts_member, ts_index let array_literal_object object is ts_array
in ts_parenthesized let array_literal_object expression.array_literal_object
in ts_unary rule no-array-delete {
  when operator == "delete" && (argument.array_literal_object == true || argument.object_array_type == true)
  warn "Using the `delete` operator with an array expression is unsafe."
}

in ts_function, ts_arrow, ts_method rule return-await {
  option mode ("always" | "error-handling-correctness-only" | "in-try-catch" | "never") = "in-try-catch" "Await policy for returned promises"
  each result in returned_awaitables
  when result.certainty == "never" && result.awaited || result.certainty == "always" && (if mode == "always" || mode != "never" && result.handling then !result.awaited else if mode == "error-handling-correctness-only" then false else result.awaited)
  report at result.offset
  warn if result.certainty == "never" then "Returning an awaited value that is not a promise is not allowed." else if result.awaited then "Returning an awaited promise is not allowed in this context." else "Returning an awaited promise is required in this context."
}

in ts_assignment_pattern, ts_parameter rule no-useless-default-assignment {
  when useless_default != null
  report at useless_default.offset
  warn if useless_default.kind == "optional" then "Using `= undefined` to make a parameter optional adds unnecessary runtime logic." else if useless_default.kind == "undefined" then "Default value is useless because it is undefined. Optional {useless_default.owner}s are already undefined by default." else "Default value is useless because the {useless_default.owner} is not optional."
}

in ts_as, ts_type_assertion rule no-unsafe-type-assertion {
  when unsafe_assertion != null
  warn if unsafe_assertion.kind == "from-any" then "Unsafe assertion from {unsafe_assertion.type} detected: consider using type guards or a safer assertion." else if unsafe_assertion.kind == "to-any" then "Unsafe assertion to {unsafe_assertion.type} detected: consider using a more specific type to ensure safety." else if unsafe_assertion.kind == "unconstrained" then "Unsafe type assertion: '{unsafe_assertion.type}' could be instantiated with an arbitrary type which could be unrelated to the original type." else if unsafe_assertion.kind == "constraint" then "Unsafe type assertion: the original type is assignable to the constraint of type '{unsafe_assertion.type}', but '{unsafe_assertion.type}' could be instantiated with a different subtype of its constraint." else "Unsafe type assertion: type '{unsafe_assertion.type}' is more narrow than the original type."
}

in ts_member let object_string_array_type object.string_array_type
in ts_call rule require-array-sort-compare {
  option ignoreStringArrays boolean = true "Ignore arrays whose elements are all strings"
  when count(argument) == 0 && re_test(callee, /\??\.\s*(sort|toSorted)$/)
  when callee.object_array_type == true && (!ignoreStringArrays || callee.object_string_array_type != true)
  warn "Require 'compare' argument."
}

in ts_call.callee rule no-unsafe-call {
  when unsafe_call_type != null
  warn if unsafe_call_type == "error" then if unsafe_this_type == "error" then "Unsafe call of a `this` type that could not be resolved." else "Unsafe call of a type that could not be resolved." else "Unsafe call of {if unsafe_call_type == 'function' then 'a `Function`' else 'an `any`'} typed value."
}
in ts_new rule no-unsafe-call:new {
  when callee.unsafe_call_type != null
  warn if callee.unsafe_call_type == "error" then "Unsafe construction of a type that could not be resolved." else "Unsafe construction of {if callee.unsafe_call_type == 'function' then 'a `Function`' else 'an `any`'} typed value."
}
in ts_tagged_template.tag rule no-unsafe-call:tag {
  when unsafe_call_type != null
  warn if unsafe_call_type == "error" then "Unsafe use of a template tag whose type could not be resolved." else "Unsafe use of {if unsafe_call_type == 'function' then 'a `Function`' else 'an `any`'} typed template tag."
}

in ts_unary rule no-meaningless-void-operator {
  option checkNever boolean = false "Also check calls returning never"
  when operator == "void" && argument != "0" && void_argument_kind != "assignment"
  when if void_argument_kind == "call" then has_only_flags(default(argument.type_flags, []), ["undefined", "nullable", "union"]) || checkNever && has_only_flags(default(argument.type_flags, []), ["undefined", "nullable", "never", "union"]) else !contains(default(argument.type_members, []), "then")
  warn if void_argument_kind == "call" then "void operator shouldn't be used on {argument.type}; it should convey that a return value is being ignored" else "void operator is useless here; it should only discard a call's return value"
}

in ts_member, ts_index {
  let any_access_root object.any_access_root == true || object.unsafe_type != null
  let unsafe_member_access object.unsafe_type != null && object.any_access_root != true
  let any_access_optional_root optional == null && (object.any_access_optional_root == true || object.unsafe_type != null)
  let unsafe_optional_member_access optional == null && object.unsafe_type != null && object.any_access_optional_root != true
  let object_unsafe_type object.unsafe_type
  let object_unsafe_this_type object.unsafe_this_type
}
in ts_member.property rule no-unsafe-member-access {
  option allowOptionalChaining boolean = false "Allow optional chaining on any"
  when if allowOptionalChaining then parent.unsafe_optional_member_access == true else parent.unsafe_member_access == true
  warn if parent.object_unsafe_type == "error" then "Unsafe member access .{text} on a type that cannot be resolved." else "Unsafe member access .{text} on an `any` value."
}
in ts_index.index rule no-unsafe-member-access:computed {
  option allowOptionalChaining boolean = false "Allow optional chaining on any"
  when if allowOptionalChaining then parent.unsafe_optional_member_access == true else parent.unsafe_member_access == true
  report at unsafe_member_key.offset
  warn if parent.object_unsafe_type == "error" then "Unsafe member access [{unsafe_member_key.text}] on a type that cannot be resolved." else "Unsafe member access [{unsafe_member_key.text}] on an `any` value."
}
in ts_index.index rule no-unsafe-member-access:key {
  option allowOptionalChaining boolean = false "Allow optional chaining on any"
  when unsafe_member_key.kind != null && (!allowOptionalChaining || parent.optional == null)
  report at unsafe_member_key.offset
  warn if unsafe_member_key.kind == "error" then "The type of computed name [{unsafe_member_key.text}] cannot be resolved." else "Computed name [{unsafe_member_key.text}] resolves to an `any` value."
}

in ts_logical, ts_assignment, ts_conditional, ts_if rule prefer-nullish-coalescing {
  option ignoreBooleanCoercion boolean = false "Ignore Boolean conversion"
  option ignoreConditionalTests boolean = true "Ignore conditional tests"
  option ignoreIfStatements boolean = false "Ignore if statements"
  option ignoreMixedLogicalExpressions boolean = false "Ignore mixed logical expressions"
  option ignorePrimitives (boolean | { bigint?: boolean; boolean?: boolean; number?: boolean; string?: boolean }) = {} "Primitive types to ignore"
  option ignoreTernaryTests boolean = false "Ignore ternary tests"
  let replacement nullish_coalescing
  let nullish_flags replacement.flags
  when replacement != null
  when !(replacement.truthiness && (ignoreConditionalTests && replacement.conditional || ignoreBooleanCoercion && replacement.boolean))
  when !(ignoreMixedLogicalExpressions && replacement.mixed)
  when !replacement.truthiness || !(ignorePrimitives == true || replacement.unknown && (ignorePrimitives.bigint == true || ignorePrimitives.boolean == true || ignorePrimitives.number == true || ignorePrimitives.string == true) || contains(default(nullish_flags, []), "bigint") && ignorePrimitives.bigint == true || contains(default(nullish_flags, []), "boolean") && ignorePrimitives.boolean == true || contains(default(nullish_flags, []), "number") && ignorePrimitives.number == true || contains(default(nullish_flags, []), "string") && ignorePrimitives.string == true)
  when !(replacement.kind == "ternary" && ignoreTernaryTests) && !(replacement.kind == "if" && ignoreIfStatements)
  report at replacement.offset
  warn if replacement.kind == "ternary" then "Prefer using nullish coalescing operator (`??`) instead of a ternary expression, as it is simpler to read." else if replacement.kind == "if" then "Prefer using nullish coalescing operator (`??=`) instead of an assignment expression, as it is simpler to read." else if replacement.kind == "assignment" then "Prefer using nullish coalescing operator (`??=`) instead of a logical assignment (`||=`), as it is a safer operator." else "Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator."
}

}
