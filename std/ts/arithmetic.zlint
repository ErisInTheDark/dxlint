import .ts/values/inspection
define {

fn ts_value_print_literal_parts(parts) = parts != null && len(parts) > 0
  && any(parts, arm => any(arm, part => !contains(part.traits, "parameter")))
  && all(parts, arm => all(filter(arm, part => !contains(part.traits, "parameter")),
    part => contains(part.traits, "literal") || part.identity_known && part.identity.kind == "value"))
# Widening only changes literals: structure would collapse to `object`, so keep
# the handle's shape unless every printed constituent is a literal.
fn arithmetic_type_name(n) = {
  value written: ts_value_print_written(n)
  value parts: value_constituents(n)
  value if written != null then written
    else if ts_value_print_literal_parts(parts) then ts_value_print(value_widened(n) ?? parts)
    else ts_value_print_handle(n)
}
fn arithmetic_has_type(arms, kinds) = any(arms, arm =>
  any(arm.parts, part => any(kinds, kind => contains(part.traits, kind))))
fn arithmetic_known(arms) = arms != null && all(arms, arm => any(arm.parts, part =>
  any(["string", "number", "bigint", "boolean", "symbol", "null", "undefined", "any", "unknown", "object", "structural", "callable"],
    trait => contains(part.traits, trait) && !contains(part.uncertain_traits, trait))))
fn arithmetic_object_type(arm) = any(arm.parts, part =>
  any(["object", "structural", "callable", "constructible"], trait => contains(part.traits, trait)))
  && !arithmetic_has_type([arm], ["string", "number", "bigint", "boolean", "symbol", "null", "undefined", "any", "unknown"])
fn arithmetic_regexp(arm) = if any(arm.parts, part => part.carrier.description.name == "RegExp") then true
  else if all(arm.parts, part => part.carrier_known) then false else null
fn arithmetic_string_like(options) = ([]
  (if options.allowAny then ["`any`"] else [])
  (if options.allowBoolean then ["`boolean`"] else [])
  (if options.allowNullish then ["`null`"] else [])
  (if options.allowRegExp then ["`RegExp`"] else [])
  (if options.allowNullish then ["`undefined`"] else []))
fn arithmetic_operand_errors(subject, t, other, options) =
  if count(t) == 0 || arithmetic_has_type(t, ["symbol", "unknown"])
    || !options.allowAny && arithmetic_has_type(t, ["any"])
    || !options.allowBoolean && arithmetic_has_type(t, ["boolean"])
    || !options.allowNullish && arithmetic_has_type(t, ["null", "undefined"])
  then [{ node: subject, type: arithmetic_type_name(subject) }]
  else {
    value t
    filter (arm) arithmetic_object_type(arm)
    filter (arm) {
      value regexp: arithmetic_regexp(arm)
      value regexp == false || regexp == true && (!options.allowRegExp || arithmetic_has_type(other, ["number"]))
    }
    map (arm) { node: subject, type: if count(t) == 1 then arithmetic_type_name(subject) else ts_value_print_handle(arm.handle) }
  }

fn arithmetic_pair_error(left, right, options) = when {
  !options.allowNumberAndString && (arithmetic_has_type(left, ["string"]) && arithmetic_has_type(right, ["number", "bigint"])
    || arithmetic_has_type(right, ["string"]) && arithmetic_has_type(left, ["number", "bigint"])) then "mismatched"
  arithmetic_has_type(left, ["number"]) && arithmetic_has_type(right, ["bigint"])
    || arithmetic_has_type(right, ["number"]) && arithmetic_has_type(left, ["bigint"]) then "numeric"
  else then null
}

in ts_node let arithmetic_type value_parts(node)

in ts_binary, ts_assignment rule restrict-plus-operands {
  option allowAny boolean = true "allow any operands"
  option allowBoolean boolean = true "allow boolean operands"
  option allowNullish boolean = true "allow null and undefined operands"
  option allowNumberAndString boolean = true "allow strings with numbers or bigints"
  option allowRegExp boolean = true "allow regular expression operands"
  option skipCompoundAssignments boolean = false "skip compound assignments"
  when operator == "+" || operator == "+=" && !skipCompoundAssignments
  let settings { allowAny: allowAny, allowBoolean: allowBoolean, allowNullish: allowNullish, allowNumberAndString: allowNumberAndString, allowRegExp: allowRegExp }
  let left_type left.arithmetic_type
  let right_type right.arithmetic_type
  when arithmetic_known(left_type) && arithmetic_known(right_type)
  let errors (arithmetic_operand_errors(left.node, left_type, right_type, settings)
    arithmetic_operand_errors(right.node, right_type, left_type, settings))
  let pair_error if len(errors) == 0 then arithmetic_pair_error(left_type, right_type, settings) else null
  let string_types arithmetic_string_like(settings)
  let string_like (if len(string_types) == 0 then "string" else "string, allowing a string + "
    (if len(string_types) == 1 then first(string_types) else "any of: " join(string_types, ", ")))
  each finding in errors (if pair_error != null then [{ node: node, pair: pair_error }] else []) {
    report at finding.node
    warn when {
      finding.pair == "numeric" then "Numeric '+' operations must either be both bigints or both numbers. Got `{arithmetic_type_name(left.node)}` + `{arithmetic_type_name(right.node)}`."
      finding.pair == "mismatched" then "Operands of '+' operations must be a number or {string_like}. Got `{arithmetic_type_name(left.node)}` + `{arithmetic_type_name(right.node)}`."
      else then "Invalid operand for a '+' operation. Operands must each be a number or {string_like}. Got `{finding.type}`."
    }
  }
}

}
