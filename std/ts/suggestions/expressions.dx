# Expression preferences: sequences, comparisons, concatenation, ternaries and coercions.

define {

in ts_binary let arithmetic_operator if contains(["+", "-", "*", "/", "%", "**", "<<", ">>", ">>>", "&", "|", "^"], operator) then operator else null
in ts_binary let strict_left_reference_key left.reference_key_strict
in ts_binary let strict_right_reference_key right.reference_key_strict
in ts_parenthesized forward arithmetic_operator, strict_left_reference_key, strict_right_reference_key from expression

# Comma operators, except loop init/update and explicitly grouped expressions.
in ts_sequence rule es-no-sequences {
  option allowInParentheses boolean = true "allow explicitly parenthesised sequences"
  let enclosed walk(node, current => if current.parent is ts_parenthesized then current.parent.node else null)
  let outside last(enclosed)
  when outside not (ts_for.init, ts_for.update)
  let paren_count count(enclosed) - 1
  when !allowInParentheses || paren_count == 0 || paren_count == 1 && outside is ts_arrow.body
  let comma_offset opener.ts_comma.offset
  when comma_offset != null
  report at opener.ts_comma.node
  warn "Unexpected use of comma operator."
}

in ts_binary rule es-no-self-compare {
  when re_test(operator, /^(?:===?|!==?|>=?|<=?)$/)
  when left != null && right != null && left.unparenthesised_tokens == right.unparenthesised_tokens
  warn "Comparing to itself is potentially pointless."
}

in ts_binary rule es-no-eq-null {
  when (operator == "==" || operator == "!=") && (left == "null" || right == "null")
  warn "Use '===' to compare with null."
}

fn concat_endpoint_next(n, right_side) = when {
  n is ts_parenthesized then n.expression.node
  n is ts_binary && n.operator == "+" then if right_side then n.right.node else n.left.node
  else then null
}
fn concat_endpoint(n, right_side) = { value n; walk (current) concat_endpoint_next(current, right_side); last }

in ts_binary rule es-no-useless-concat {
  when operator == "+"
  let left_endpoint concat_endpoint(left.node, true)
  let right_endpoint concat_endpoint(right.node, false)
  when left_endpoint is (ts_string, ts_template) && right_endpoint is (ts_string, ts_template)
  when !{ value source; byte_slice left_endpoint.end_offset right_endpoint.offset; re_test /[\r\n\u{2028}\u{2029}]/ }
  report at { start: operator.offset, end: operator.end_offset }
  warn "Unexpected string concatenation of literals."
}

fn ternary_fix_inverse(operand) = {
  value bare: unparenthesised_node(operand)
  value inverse: if bare is ts_binary then get({ "==": "!=", "!=": "==", "===": "!==", "!==": "===" }, bare.operator) else null
  value if inverse != null then byte_slice(bare.text, 0, bare.operator.offset - bare.offset) inverse byte_slice(bare.text, bare.operator.end_offset - bare.offset)
    else "!" expression_fix_wrap(operand.text, bare.precedence < 15)
}
fn ternary_fix_boolean(n, consequent, alternate) = {
  value operand: n.test.node
  value bare: unparenthesised_node(operand)
  value when {
    consequent == alternate then if bare is ts_identifier then consequent else null
    alternate == "true" then ternary_fix_inverse(operand)
    bare is ts_binary && contains(["==", "===", "!=", "!==", ">", ">=", "<", "<=", "in", "instanceof"], bare.operator)
      || bare is ts_unary && bare.operator == "!" then operand.text
    else then "!" ternary_fix_inverse(operand)
  }
}

in ts_conditional rule es-no-unneeded-ternary {
  let consequent_value consequent.literal_value
  let alternate_value alternate.literal_value
  when consequent_value.type == "boolean" && alternate_value.type == "boolean"
  warn "Unnecessary use of boolean literals in conditional expression."
  let replacement ternary_fix_boolean(node, consequent_value.value, alternate_value.value)
  fix if replacement != null && expression_fix_retains_comments(node, replacement)
    && unparenthesised_node(consequent.node) is ts_boolean && unparenthesised_node(alternate.node) is ts_boolean as expression_fix_edges(node, replacement)
}

in ts_conditional rule es-no-unneeded-ternary:default-assignment {
  option defaultAssignment boolean = true "allow conditional expressions used as default assignments"
  when !defaultAssignment && (test.unwrapped_node.nonempty ?? test.node) is ts_identifier && (consequent.unwrapped_node.nonempty ?? consequent.node) is ts_identifier && (test.unwrapped_text.nonempty ?? test) == (consequent.unwrapped_text.nonempty ?? consequent)
  warn "Unnecessary use of conditional expression for default assignment."
  let operand alternate.node
  let bare unparenthesised_node(operand)
  let grouped operand not ts_parenthesized && (bare.precedence < 4 || bare is (ts_as, ts_satisfies, ts_type_assertion) || bare is ts_logical && bare.operator == "??")
  let replacement test " || " expression_fix_wrap(operand.text, grouped)
  fix if expression_fix_retains_comments(node, replacement) as expression_fix_edges(node, replacement)
}

fn suggestion_coercion_numeric(n) = {
  value n: unparenthesised_node(n)
  value n is ts_number || n is ts_call && n.callee is ts_identifier
    && contains(["Number", "parseInt", "parseFloat"], n.callee.text)
}
fn suggestion_coercion_string(n) = {
  value n: unparenthesised_node(n)
  value n is (ts_string, ts_template) || n is ts_call && n.callee is ts_identifier && n.callee.text == "String"
}
fn suggestion_coercion_empty(n) = {
  value n: unparenthesised_node(n)
  value n is (ts_string, ts_template) && n.literal_value.type == "string" && n.literal_value.value == ""
}
fn suggestion_coercion_operand(n) = {
  value n: unparenthesised_node(n)
  value if n is ts_sequence then "(" n.text ")" else n.text
}
fn suggestion_coercion_one(n) = n is ts_number && js_number(n.literal_value) == 1
fn suggestion_implicit_coercion(source, n) = {
  value argument: unparenthesised_node(n.argument.node)
  value left: unparenthesised_node(n.left.node)
  value right: unparenthesised_node(n.right.node)
  value if n is ts_unary then when {
    contains(["!", "-"], n.operator) && argument is ts_unary && argument.operator == n.operator then {
      value inner: argument.argument.node
      value if n.operator == "!" then {kind: "boolean", operator: "!!", recommendation: "Boolean(" suggestion_coercion_operand(inner) ")"}
        else if !suggestion_coercion_numeric(inner) then {kind: "number", operator: "- -", recommendation: "Number(" suggestion_coercion_operand(inner) ")"}
        else null
    }
    n.operator == "+" && !suggestion_coercion_numeric(argument) then {
      kind: "number", operator: "+", recommendation: "Number(" suggestion_coercion_operand(argument) ")"
    }
    n.operator == "~" && argument is ts_call then {
      value raw_callee: argument.callee.node
      value callee: unparenthesised_node(raw_callee)
      value optional: argument.optional == "?." || raw_callee not ts_parenthesized && callee.optional == "?."
      value if contains(["indexOf", "lastIndexOf"], callee.static_name) then {
        kind: "boolean", operator: "~", recommendation: argument.text (if optional then " >= 0" else " !== -1")
      } else null
    }
    else then null
  } else if n is (ts_binary, ts_assignment) then when {
    n.operator == "*" then {
      value fraction: suggestion_coercion_one(right) && n is ts_binary.left && n.parent.operator == "/"
      value operand: find([right, left], item => item not ts_binary && !suggestion_coercion_numeric(item))
      value if !fraction && (suggestion_coercion_one(left) || suggestion_coercion_one(right)) && operand != null
        then {kind: "number", operator: "*", recommendation: "Number(" suggestion_coercion_operand(operand) ")"}
        else null
    }
    n.operator == "-" && right is ts_number && js_number(right.literal_value) == 0 && !suggestion_coercion_numeric(left) then {
      kind: "number", operator: "-", recommendation: "Number(" suggestion_coercion_operand(left) ")"
    }
    n.operator == "+" && (suggestion_coercion_empty(left) && !suggestion_coercion_string(right)
      || suggestion_coercion_empty(right) && !suggestion_coercion_string(left)) then {
      value operand: if suggestion_coercion_empty(left) then right else left
      value {kind: "string", operator: "+", recommendation: "String(" suggestion_coercion_operand(operand) ")"}
    }
    n.operator == "+=" && suggestion_coercion_empty(right) then {
      kind: "string", operator: "+", recommendation: left.text " = String(" left.text ")"
    }
    else then null
  } else if n is ts_template && n.parent not ts_tagged_template && count(n.expression) == 1 then {
    value expression: first(n.expression.nodes)
    value prefix: trim_end(byte_slice(source, n.offset + 1, expression.offset))
    value suffix: trim_start(byte_slice(source, expression.end_offset, n.end_offset - 1))
    value head: js_string_parts("`" slice(prefix, 0, -2) "`")
    value tail: js_string_parts("`" slice(suffix, 1) "`")
    value if !suggestion_coercion_string(expression) && ends_with(prefix, "${{") && starts_with(suffix, "}}")
      && head != null && tail != null && head.text == "" && tail.text == ""
      then {kind: "template", operator: "", recommendation: "String(" suggestion_coercion_operand(expression) ")"}
      else null
  } else null
}

in ts_unary, ts_binary, ts_assignment, ts_template rule es-no-implicit-coercion {
  option boolean boolean = true "check boolean conversions"
  option number boolean = true "check number conversions"
  option string boolean = true "check string conversions"
  option disallowTemplateShorthand boolean = false "check single-expression templates"
  option allow string[] = [] "shorthand operators to allow"
  let coercion_info suggestion_implicit_coercion(source, node)
  when coercion_info != null
  when coercion_info.kind == "boolean" && boolean || coercion_info.kind == "number" && number || coercion_info.kind == "string" && string || coercion_info.kind == "template" && disallowTemplateShorthand
  when coercion_info.kind == "template" || !contains(allow, coercion_info.operator)
  warn "Unexpected implicit coercion encountered. Use `{coercion_info.recommendation}` instead."
  let program ts_module_program(node)
  let coercion_boolean_fixable coercion_info.operator == "!!" && ts_global_visible(node, "Boolean") == false
    && contains(["readonly", "writable"], ts_global_setting(program, "Boolean"))
    && !contains(program.ts_global_written, "Boolean")
    && expression_fix_retains_comments(node, coercion_info.recommendation)
  fix if coercion_boolean_fixable as expression_fix_edges(node, coercion_info.recommendation)
}

fn assignment_fix_reference(n) = {
  value bare: unparenthesised_node(n)
  value bare is ts_identifier
    || bare is (ts_member, ts_index) && bare.optional == null
    && bare.object is (ts_identifier, ts_this)
    && (bare is ts_member || unparenthesised_node(bare.index.node) is (ts_string, ts_number, ts_bigint, ts_boolean, ts_null, ts_regex))
}
fn assignment_fix_rank(operator) = get({
  "|": 6, "^": 7, "&": 8, "<<": 11, ">>": 11, ">>>": 11,
  "+": 12, "-": 12, "*": 13, "/": 13, "%": 13, "**": 14
}, operator)
fn assignment_fix_text(source, n, mode, shorthand) = {
  value binary: unparenthesised_node(n.right.node)
  value before: byte_slice(source, n.offset, n.operator.offset)
  value when {
    !assignment_fix_reference(n.left.node) then null
    mode == "always" then {
      value if binary not ts_binary || n.left.reference_key_strict != binary.left.reference_key_strict
        || !assignment_fix_reference(binary.left.node)
        || !expression_fix_clean({ offset: n.operator.end_offset, end_offset: binary.operator.offset }) then null
      else before shorthand byte_slice(source, binary.operator.end_offset, binary.end_offset)
    }
    else then {
      value operator: slice(n.operator, 0, -1)
      value if !expression_fix_clean({ offset: n.offset, end_offset: n.operator.offset }) then null
      else {
        value leading: byte_slice(source, n.operator.end_offset, n.right.offset)
        value needed: n.right not ts_parenthesized && n.right.precedence <= assignment_fix_rank(operator)
        value following: byte_slice(source, n.operator.end_offset, n.end_offset)
        value right: if needed then leading expression_fix_wrap(n.right.text, true)
          else expression_fix_separator(operator, following) following
        value before "= " before operator right
      }
    }
  }
}
in ts_assignment rule es-operator-assignment {
  default option mode ("always" | "never") = "always" "compound arithmetic assignment policy"
  let assigned_key left.reference_key_strict
  let shorthand if operator == "=" && right.arithmetic_operator != null && assigned_key != null && (assigned_key == right.strict_left_reference_key || contains(["*", "&", "^", "|"], right.arithmetic_operator) && assigned_key == right.strict_right_reference_key) then right.arithmetic_operator "=" else null
  when if mode == "never" then operator != "=" && !contains(["&&=", "||=", "??="], operator) else shorthand != null
  warn if mode == "never" then "Unexpected operator assignment ({operator}) shorthand." else "Assignment (=) can be replaced with operator assignment ({shorthand})."
  let replacement assignment_fix_text(source, node, mode, shorthand)
  fix if replacement != null && expression_fix_retains_comments(node, replacement) as replacement
}

}
