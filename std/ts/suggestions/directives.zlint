# `use strict` directive policy.

define {

fn strict_enclosing_function_directive(n) =
  {
    value n.parent.node
    walk (current) current.parent.node
    any (current) current is (ts_function, ts_arrow, ts_method) && count(current.directive_scope.directives) > 0
  }
fn strict_directive_kind(n, scope, mode, directive) =
  when {
    n not ts_program && !scope.simple_parameters then
      if directive == first(scope.directives) then "non-simple" else "multiple"
    mode == "never" then "never"
    mode == "module" then "module"
    mode == "implied" then "implied"
    n is ts_program then when {
      mode == "function" then "function"
      directive == first(scope.directives) then null
      else then "multiple"
    }
    mode == "global" then "global"
    directive != first(scope.directives) then "multiple"
    strict_enclosing_function_directive(n) then "unnecessary"
    scope.class_body then "class"
    else then null
  }
fn strict_directive_message(kind) = get({
  "non-simple": "'use strict' directive inside a function with non-simple parameter list throws a syntax error since ES2016.",
  multiple: "Multiple 'use strict' directives.",
  never: "Strict mode is not permitted.",
  module: "'use strict' is unnecessary inside of modules.",
  implied: "'use strict' is unnecessary when implied strict mode is enabled.",
  function: "Use the function form of 'use strict'.",
  global: "Use the global form of 'use strict'.",
  unnecessary: "Unnecessary 'use strict' directive.",
  class: "'use strict' is unnecessary inside of classes."
}, kind)
fn strict_missing(n, scope, mode) =
  when {
    count(scope.directives) != 0 then []
    n is ts_program && mode == "global" && count(n.body.node) > 0 then [{ report: { start: first(n.body.node).offset, end: last(n.body.node).end_offset }, message: "Use the global form of 'use strict'." }]
    n not ts_program && mode == "function" && !scope.parent_function && !scope.class_body then [{
      report: n.offset,
      message: if scope.simple_parameters then "Use the function form of 'use strict'." else "Wrap " (n.function_name.nonempty ?? "function") " in a function with 'use strict' directive."
    }]
    else then []
  }
in ts_program, ts_function, ts_arrow, ts_method rule strict {
  option mode ("safe" | "never" | "global" | "function") = "safe" "strict directive policy"
  let strict_scope directive_scope
  let strict_mode when {
    ts_source_type(ts_module_program(node)) == "module" then "module"
    source_environment.implied_strict then "implied"
    mode == "safe" then if source_environment.root_function then "global" else "function"
    else then mode
  }
  let strict_findings {
    value initial_findings: strict_missing(node, strict_scope, strict_mode)
    value strict_scope.directives
    fold initial_findings (findings, directive) {
      value kind: strict_directive_kind(node, strict_scope, strict_mode, directive)
      value findings [{
        report: directive.offset,
        directive: directive,
        kind: kind,
        message: strict_directive_message(kind)
      }]
    }
  }
  each strict_finding in filter(strict_findings, finding => finding.message != null) {
    report at strict_finding.report
    fix at strict_finding.directive if contains(["multiple", "unnecessary", "module", "implied", "class"], strict_finding.kind) && expression_fix_clean(strict_finding.directive) as ""
    warn strict_finding.message
  }
}

}
