# Spread policy over constrained constituent types and declaration provenance.

import .ts/type-specifiers

define {

fn spread_string(n) = ts_value_has_trait(n, "string") == true
fn spread_written_properties(n) = {
  value binding: name_binding(n)
  value if binding == null then if n is (ts_function, ts_arrow) then false else null else
    any(binding.references, reference => reference.parent is (ts_member, ts_index)
      && reference.parent.object.node == reference && reference.parent.write_site != null)
}
fn spread_class_value(n) = {
  value binding: name_binding(n)
  value binding != null && any(binding.declarations, declaration => declaration.parent is ts_class)
}
fn spread_class_instance(n, arms) = any(arms, arm => any(arm.parts, part => {
  value carrier: part.carrier
  value constructor: if carrier == null then null else declaration_value(n, {file: carrier.file, node: carrier.node})
  value headers: if constructor == null then null else value_constructors(constructor)
  value !contains(part.traits, "constructible") && carrier.description.kind == "named"
    && headers != null && any(headers, signatures => count(signatures) > 0)
}))
fn spread_iterable(n) = {
  value member: value_lookup(n, {global: "Symbol", class: "value", path: ["iterator"]})
  value signatures: if member.member == null then null else value_signatures(member.member)
  value member.alternatives != null && count(member.alternatives) > 0
    && all(member.alternatives, arm => arm.matched)
    && signatures != null && count(signatures) > 0 && all(signatures, arm => count(arm) > 0)
}
fn spread_object_category(n) = {
  value arms: value_parts(n)
  value if arms == null then null
    else if ts_value_builtin_type(n, ["Promise"]) == true then "promise"
    else if spread_written_properties(n) == false && any(arms, arm => {
      value signatures: value_signatures(arm.handle)
      value signatures != null && any(signatures, headers => count(headers) > 0)
        && value_children(arm.handle, true, []) == []
    }) then "function"
    else if ts_value_builtin_type(n, ["Map", "ReadonlyMap", "WeakMap"]) == true then "map"
    else if any(arms, arm => any(arm.parts, part => contains(["array", "tuple"], part.carrier.description.kind))) then "array"
    else if !spread_string(n) && spread_iterable(n) then "iterable"
    else if spread_class_instance(n, arms) then "instance"
    else if spread_class_value(n) then "class" else null
}
in ts_spread, ts_jsx_spread_attribute let no_misused_spread_checked true
in ts_spread, ts_jsx_spread_attribute rule no-misused-spread {
  option allow (string | type_specifier_file | type_specifier_lib | type_specifier_package)[] = [] "types safe to spread"
  let object_spread node is ts_jsx_spread_attribute || parent is ts_object
  let sequence_spread parent is (ts_array, ts_call)
  when object_spread || sequence_spread
  let subject argument.node
  when type_value_allowed(allow, subject) == false
  let category if object_spread then spread_object_category(subject) else if spread_string(subject) then "string" else null
  when category != null
  when no_misused_spread_checked
  warn if category == "promise" then "Using the spread operator on Promise in an object can cause unexpected behavior. Did you forget to await the promise?"
    else if category == "function" then "Using the spread operator on a function without additional properties can cause unexpected behavior. Did you forget to call the function?"
    else if category == "map" then "Using the spread operator on a Map in an object will result in an empty object. Did you mean to use `Object.fromEntries(map)` instead?"
    else if category == "array" then "Using the spread operator on an array in an object will result in a list of indices."
    else if category == "iterable" then "Using the spread operator on an Iterable in an object can cause unexpected behavior."
    else if category == "instance" then "Using the spread operator on class instances will lose their class prototype."
    else if category == "class" then "Using the spread operator on class declarations will spread only their static properties, and will lose their class prototype."
    else """
Using the spread operator on a string can mishandle special characters, as can `.split("")`.
- `...` produces Unicode code points, which will decompose complex emojis into individual emojis
- .split("") produces UTF-16 code units, which breaks rich characters in many languages
Consider using `Intl.Segmenter` for locale-aware string decomposition.
Otherwise, if you don't need to preserve emojis or other non-Ascii characters, disable this lint rule on this line or configure the 'allow' rule option.
"""
}

}
