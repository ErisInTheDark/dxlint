# .ts/scoping: eslint core and typescript-eslint rules about declarations,
# scopes and names (shadowing, use before definition, `this`),
# on the native TypeScript layers and bindings.

import .ts/naming
import .ts/expression-fixes

define {

in ts_assignment rule require-atomic-updates {
  option allowProperties boolean = false
  each updated in filter(scoping_atomic_update, u => !u.property || !allowProperties)
  warn if updated.property then "Possible race condition: `{updated.value}` might be assigned based on an outdated state of `{updated.name}`." else "Possible race condition: `{updated.name}` might be reassigned based on an outdated value of `{updated.name}`."
}

in ts_this rule no-invalid-this {
  option capIsConstructor boolean = true
  let context scoping_this_context
  when !context.valid && !(capIsConstructor && context.constructor)
  warn "Unexpected 'this'."
}

in ts_this let arrow_bound_this true
in ts_parenthesized forward arrow_bound_this from expression
in ts_call let arrow_bind_lexical count(argument) == 1 && first([] argument.arrow_bound_this) == true
in ts_node let arrow_bound_callback
  if parent is ts_parenthesized then parent.arrow_bound_callback
  else if is ts_call.callee && parent.arrow_callback_receiver != null then parent.arrow_bind_lexical
  else null
# Null: not a callback; boolean: its receiver is lexical.
in ts_node let arrow_callback_receiver
  if is (ts_call.argument, ts_new.argument) then false
  else if parent is (ts_parenthesized, ts_logical) || parent is ts_conditional && not ts_conditional.test then parent.arrow_callback_receiver
  else if is ts_member.object && parent.property == "bind" then parent.arrow_bound_callback
  else null
in ts_node let arrow_callback_barrier
  if is (ts_function, ts_method) then false
  else is ts_super || is ts_meta_property && starts_with(text, "new") || any(children.arrow_callback_barrier, b => b == true)
fn arrow_callback_fix(source, n, lexical) = {
  value parameters: n.parameter.nodes
  value names: [] n.parameter.name
  value distinct: unique(names)
  value duplicates: count(distinct) != count(names)
  value unsafe: n.uses_this && !lexical || duplicates || first(names) == "this" || count(n.type_parameter) != 0
  value wrapped: {
    value n
    walk (current) if current.parent is ts_parenthesized then current.parent.node else null
    last
  }
  value member: wrapped.parent.node
  value bound: if lexical && member is ts_member && member.property == "bind"
    && member.parent is ts_call && member.parent.arrow_bind_lexical then member.parent.node else null
  value target: bound ?? n
  value function_tokens: overlapping(ts_keyword, n.offset, n.body.offset)
  value keyword: { value function_tokens; find (token) token.text == "function" }
  value opening_from: n.name.end_offset ?? keyword.end_offset
  value opening_until: first(parameters).offset ?? n.body.offset
  value opening_tokens: overlapping(ts_open_paren, opening_from, opening_until)
  value opening: first(opening_tokens)
  value before_body: n.body.node.token_neighbours.before
  value comments: overlapping(ts_comment, keyword.end_offset, opening.offset)
  value prefix: if count(comments) == 0 then [{ start: keyword.offset, end: opening.offset, text: "" }]
    else ([{ start: keyword.offset, end: keyword.end_offset, text: "" }] (if n.name != null then [{ start: n.name.offset, end: n.name.end_offset, text: "" }] else []))
  value edits: prefix [{ start: before_body.end, end: before_body.end, text: " =>" }] (if bound != null then [{ start: wrapped.end_offset, end: bound.end_offset, text: "" }] else [])
  value replacement: expression_fix_edits(target.text, target.offset, edits)
  value shape: { kind: "ts_arrow", precedence: if bound != null && wrapped is ts_parenthesized then 20 else 1 }
  value parens: expression_fix_parens(source, target, shape)
  value async_break: contains([] n.modifier, "async") && { value source; byte_slice keyword.offset opening.offset; re_test /[\n\r\u{2028}\u{2029}]/ }
  value if unsafe || lexical && bound == null || keyword == null || opening == null || before_body == null
    || async_break || parens == null || !expression_fix_retains_comments(target, replacement) then null
    else { start: target.offset, end: target.end_offset, text: expression_fix_wrap(replacement, parens > 0) }
}
in ts_function rule prefer-arrow-callback {
  option allowNamedFunctions boolean = false
  option allowUnboundThis boolean = true
  # Cheap checks first: the barrier scan walks the whole body.
  let callback arrow_callback_receiver
  when callback != null && !(allowNamedFunctions && name != null)
  when !contains([] modifier, "*") && (name.uses.nonempty ?? 0) + (name.self_uses.nonempty ?? 0) + (name.writes.nonempty ?? 0) == 0 && !uses_arguments
  when !allowUnboundThis || !uses_this || callback
  when !any(children.arrow_callback_barrier, b => b == true)
  warn "Unexpected function expression."
  let edit arrow_callback_fix(source, node, callback)
  fix at (edit ?? { start: offset, end: end_offset }) if edit != null as edit.text
}

in ts_identifier rule no-unmodified-loop-condition {
  option checkConditionalExpressions boolean = false
  let condition scoping_unmodified_condition
  when if checkConditionalExpressions then condition.independent else condition.grouped
  warn "'{text}' is not modified in this loop."
}

in ts_function, ts_arrow rule no-loop-func {
  let captured scoping_loop_captures
  when { value captured.nonempty ?? []; len } > 0
  let captured_names { value captured; map (name) "'" name "'"; join ", " }
  warn "Function declared in a loop contains unsafe references to variable(s) {captured_names}."
}

in ts_node let scoping_outer_parens if parent is ts_parenthesized then parent.scoping_outer_parens else node
in ts_node let scoping_callback_destination
  if parent is (ts_parenthesized, ts_logical, ts_conditional, ts_return) then parent.scoping_callback_destination
  else if parent is ts_call then { call: parent.node, argument: node } else null
in ts_return let scoping_callback_destination {
  value owner: containing(ts_function_like).scoping_outer_parens
  value if owner.parent is ts_call && owner.parent.callee.node == owner then owner.parent.scoping_callback_destination else null
}
in ts_function, ts_arrow let scoping_callback_method {
  value destination: if contains([] modifier, "*") then null else scoping_callback_destination
  value callee: destination.call.callee.scoping_unparen_node.nonempty ?? destination.call.callee.node
  value method: callee.static_name
  value object: callee.object.scoping_unparen_node.nonempty ?? callee.object.node
  value factory: object is ts_identifier && (method == "from" && ends_with(object.text, "Array") || method == "fromAsync" && object.text == "Array")
  value arguments: [] destination.call.argument.nodes
  value index: if factory then 1 else 0
  value next_index: index + 1
  value asynchronous: contains([] modifier, "async")
  value if destination == null || body == null || callee not (ts_member, ts_index)
    || { value arguments; slice index next_index; first } != destination.argument then null
    else if factory && (method == "fromAsync" || !asynchronous)
      || !asynchronous && contains(["every", "filter", "find", "findLast", "findIndex", "findLastIndex", "flatMap", "forEach", "map", "reduce", "reduceRight", "some", "sort", "toSorted"], method) then method else null
}
in ts_function, ts_arrow let scoping_callback_label
  if contains(["from", "fromAsync"], scoping_callback_method) then "Array." scoping_callback_method else "Array.prototype." scoping_callback_method
in ts_function, ts_arrow let scoping_callback_head
  if parent is (ts_property, ts_class_property) && is (ts_property.value, ts_class_property.init) then parent.offset
  else if is ts_arrow then operator.offset else offset
in ts_function, ts_arrow rule array-callback-return {
  option allowImplicit boolean = false
  option checkForEach boolean = false
  option allowVoid boolean = false
  when scoping_callback_method != null && scoping_callback_method != "forEach" && body is ts_block && code_path == "falls_off"
  report at scoping_callback_head
  warn if count(own_returns) > 0 then "{scoping_callback_label}() expects a value to be returned at the end of {function_name}." else "{scoping_callback_label}() expects a return value from {function_name}."
}
in ts_function, ts_arrow rule array-callback-return:return {
  option allowImplicit boolean = false
  option checkForEach boolean = false
  option allowVoid boolean = false
  when scoping_callback_method != null && body is ts_block
  each returned in filter(own_returns, r => if scoping_callback_method == "forEach" then checkForEach && r.argument != null && !(allowVoid && r.argument.scoping_void_expression == true) else !allowImplicit && r.argument == null)
  report at returned.offset
  warn if scoping_callback_method == "forEach" then "{scoping_callback_label}() expects no useless return value from {function_name}." else "{scoping_callback_label}() expects a return value from {function_name}."
}
in ts_arrow rule array-callback-return:concise {
  option allowImplicit boolean = false
  option checkForEach boolean = false
  option allowVoid boolean = false
  when scoping_callback_method == "forEach" && checkForEach && body not ts_block && !(allowVoid && body.scoping_void_expression == true)
  report at scoping_callback_head
  warn "{scoping_callback_label}() expects no useless return value from {function_name}."
}

fn scoping_const_declaration(n) = {
  value n
  walk (current) if current is ts_variable_declaration then null else current.parent.node
  last
}
in ts_variable_declaration let scoping_const_fix {
  value owner: node
  value bindings: {
    value declaration.nodes
    flat_map (item) overlapping(ts_identifier, item.name.offset, item.name.end_offset)
    filter (item) item.declaration.node == item && item.declaration_kind == "let" && scoping_const_declaration(item) == owner
  }
  value {
    eligible: kind == "let" && count(bindings) > 0
      && (is (ts_for_in.left, ts_for_of.left) || all(declaration.nodes, item => item.init != null))
      && all(bindings, item => item.scoping_const_binding != null && item.scoping_const_binding.all),
    before: any(bindings, item => item.scoping_const_binding.before)
  }
}
in ts_program.binding_declarations rule prefer-const {
  option destructuring "any" | "all" = "any"
  option ignoreReadBeforeAssign boolean = false
  let binding scoping_const_binding
  when binding != null && !(ignoreReadBeforeAssign && binding.before)
  when destructuring != "all" || binding.all && !(ignoreReadBeforeAssign && binding.all_before)
  report at binding.offset
  warn "'{text}' is never reassigned. Use 'const' instead."
  let variable scoping_const_declaration(node)
  # Reserve the declaration so another first-pass edit cannot invalidate const.
  fix at variable if variable.scoping_const_fix.eligible && !(ignoreReadBeforeAssign && variable.scoping_const_fix.before) as
    byte_slice(variable.text, 0, variable.kind.offset - variable.offset) "const" byte_slice(variable.text, variable.kind.end_offset - variable.offset)
}

in ts_function rule func-names {
  option mode "always" | "as-needed" | "never" = "always"
  option generators "always" | "as-needed" | "never" | null = null "override policy for generators"
  let context scoping_function_context
  let policy if context.generator && generators != null then generators else mode
  when context.eligible && !context.recursive
  when policy == "never" && context.named && context.expression || policy != "never" && !context.named && (policy != "as-needed" || !context.inferred)
  report at function_warning_site(node)
  warn if policy == "never" then "Unexpected named {function_name}." else "Unexpected unnamed {function_name}."
}

in ts_parenthesized let scoping_unparen_node expression.scoping_unparen_node.nonempty ?? expression.node
in ts_parenthesized let scoping_unparen_text expression.scoping_unparen_text.nonempty ?? expression
in ts_identifier let scoping_assignment_name text
in ts_member let scoping_assignment_name static_name
in ts_index let scoping_assignment_name
  if (index.scoping_unparen_node.nonempty ?? index.node) is ts_string then static_name else null
in ts_member, ts_index let scoping_assignment_property true
in ts_parenthesized forward scoping_assignment_name, scoping_assignment_property from expression
in ts_member, ts_index let scoping_property_object object.scoping_unparen_text.nonempty ?? object
in ts_member, ts_index let scoping_descriptor_method
  if scoping_property_object == "Object" || scoping_property_object == "Reflect" && static_name == "defineProperty" then static_name else null
in ts_parenthesized forward scoping_descriptor_method from expression
in ts_string let scoping_string_value literal_value.value
in ts_parenthesized forward scoping_string_value from expression
in ts_call let scoping_descriptor_kind callee.scoping_descriptor_method
in ts_call let scoping_descriptor_name { value [] argument.scoping_string_value; slice 1 2; first }
in ts_object let scoping_descriptors parent is ts_call && contains(["defineProperties", "create"], parent.scoping_descriptor_kind)
in ts_property let scoping_descriptor_holder
  if parent.scoping_descriptors then {name: if key is ts_identifier then key else null} else null
in ts_object let scoping_descriptor_context
  if parent is ts_call && parent.scoping_descriptor_kind == "defineProperty" then {name: parent.scoping_descriptor_name}
  else parent.scoping_descriptor_holder
in ts_computed_key let scoping_match_key_node expression.node
in ts_declarator let scoping_name_destination
  {target: if name is ts_identifier then name else null, property: false, commonjs: false, offset: offset}
in ts_assignment let scoping_name_destination
  {target: left.scoping_assignment_name, property: left.scoping_assignment_property,
    commonjs: left.static_name == "exports" && left.scoping_property_object == "module", offset: offset}
in ts_property, ts_class_property let scoping_name_destination
  {target: if (key.scoping_match_key_node.nonempty ?? key.node) is (ts_identifier, ts_string) then static_name else null,
    property: true, commonjs: false, descriptor: if static_name == "value" then parent.scoping_descriptor_context else null, offset: offset}
in ts_parenthesized let scoping_name_destination parent.scoping_name_destination
in ts_function rule func-name-matching {
  option mode "always" | "never" = "always"
  option considerPropertyDescriptor boolean = false
  option includeCommonJSModuleExports boolean = false
  let matched parent.scoping_name_destination
  let descriptor_call considerPropertyDescriptor && matched.descriptor != null
  let target if descriptor_call then matched.descriptor.name else matched.target
  when name != null && matched != null && target != null
  when includeCommonJSModuleExports || !matched.commonjs
  when descriptor_call || re_test(target, /^[\p{XID_Start}_$][\p{XID_Continue}$]*$/)
  when if mode == "always" then target != name else target == name
  report at matched.offset
  warn "Function name `{name}` should{if mode == 'never' then ' not' else ''} match {if matched.property then 'property' else 'variable'} name `{target}`."
}

in ts_identifier, ts_private_name rule camelcase {
  option allow string[] = [] "names or regular expressions allowed"
  option ignoreDestructuring boolean = false
  option ignoreGlobals boolean = false
  option ignoreImports boolean = false
  option properties "always" | "never" = "always"
  let candidate scoping_camelcase
  when candidate != null && !any(allow, pattern => candidate.name == pattern || re_test(candidate.name, pattern))
  when candidate.property && properties == "always" || candidate.binding && !(ignoreGlobals && candidate.global) && !(ignoreImports && candidate.import && candidate.original) && !(ignoreDestructuring && candidate.original && !candidate.import) || !candidate.property && !candidate.binding
  warn if candidate.private then "#{candidate.name} is not in camel case." else "Identifier '{candidate.name}' is not in camel case."
}

in ts_block let scoping_block_meaningful { value [] body.scoping_following_meaningful; first; nonempty } ?? false
in ts_return let scoping_bare_return argument == null
in ts_statement let scoping_meaningful
  if is ts_block then scoping_block_meaningful
  else !(is (ts_function, ts_break)) && !scoping_bare_return
in ts_statement let scoping_following_meaningful scoping_meaningful || next.scoping_following_meaningful
in ts_statement let scoping_following_break is ts_break || next.scoping_following_break
in ts_case let scoping_case_exit first([] body.scoping_following_break) || next.node == null
in ts_statement, ts_case let scoping_return_tail
  if parent is ts_function_like then true
  else if parent is ts_loop || is ts_try.finalizer then false
  else if parent is (ts_block, ts_case) then
    !next.scoping_following_meaningful && (parent not ts_case || parent.scoping_case_exit) && parent.scoping_return_tail
  else parent.scoping_return_tail
in ts_node let scoping_return_fix_owner
  if parent is (ts_function_like, ts_program) then parent.node
  else parent.scoping_return_fix_owner
in ts_return rule no-useless-return {
  when argument == null && !contains(["unreachable", "unreachable_run"], code_path) && scoping_return_tail
  warn "Unnecessary return statement."
  let owner scoping_return_fix_owner
  # Reserve control-flow owner so overlapping edits wait for the next pass.
  fix at owner if parent is (ts_block, ts_case, ts_program, ts_static_block) && expression_fix_clean(node) as
    byte_slice(owner.text, 0, offset - owner.offset) byte_slice(owner.text, end_offset - owner.offset)
}

fn scoping_return_void(t, asynchronous) = t.kind == "void"
  || t.kind == "union" && any(t.parts, part => scoping_return_void(part, asynchronous))
  || asynchronous && any(t.declarations, declaration => !declaration.inherited && contains(["Promise", "PromiseLike"], declaration.name))
    && { value t.arguments; first; scoping_return_void true }
in ts_node let scoping_return_type_structure type_structure([], ["kind", "parts", "declarations", "arguments"], false)
in ts_program let scoping_return_void_annotation false
in ts_function, ts_arrow, ts_method let scoping_return_void_annotation
  return_type != null && {
    value asynchronous: contains([] modifier, "async")
    value return_type.scoping_return_type_structure
    scoping_return_void asynchronous
  }
in ts_program, ts_function, ts_arrow, ts_method let scoping_consistent_returns
  if re_test(file, /\.(ts|tsx|mts|cts)$/) && any(own_returns, returned => returned.argument == null)
    && any(own_returns, returned => returned.argument != null) && scoping_return_void_annotation == true
    then filter(own_returns, returned => returned.argument != null) else own_returns
in ts_node let scoping_return_undefined
  is ts_identifier && text == "undefined" || scoping_void_expression == true
  || re_test(file, /\.(ts|tsx|mts|cts)$/) && type == "undefined" && contains(type_flags, "undefined")
in ts_parenthesized let scoping_return_undefined expression.scoping_return_undefined
fn scoping_return_specified(returned, unspecified) = returned.argument != null && !(unspecified && returned.argument.scoping_return_undefined == true)
in ts_program, ts_function, ts_arrow, ts_method let scoping_return_name function_name.nonempty ?? "program"
in ts_program, ts_function, ts_arrow, ts_method let scoping_return_capitalized
  { value scoping_return_name; slice 0 1; upper } { value scoping_return_name; slice 1 }
in ts_program, ts_function, ts_arrow, ts_method let scoping_return_head
  if is ts_arrow then operator.offset else if is ts_method then key.offset else if is ts_function then name.offset.nonempty ?? offset else offset
in ts_function let scoping_return_uppercase name != null && re_test(name, /^\p{Uppercase}/)
in ts_program, ts_function, ts_arrow, ts_method let scoping_return_constructor
  function_name == "constructor" || scoping_return_uppercase == true
in ts_program, ts_function, ts_arrow, ts_method rule consistent-return {
  option treatUndefinedAsUnspecified boolean = false "treat undefined and void as bare returns"
  let returns scoping_consistent_returns
  let initial first(returns)
  let expected scoping_return_specified(initial, treatUndefinedAsUnspecified)
  each returned in filter(returns, r => r != initial && scoping_return_specified(r, treatUndefinedAsUnspecified) != expected)
  report at returned.offset
  warn if expected then "{scoping_return_capitalized} expected a return value." else "{scoping_return_capitalized} expected no return value."
}
in ts_program, ts_function, ts_arrow, ts_method rule consistent-return:fallthrough {
  option treatUndefinedAsUnspecified boolean = false "treat undefined and void as bare returns"
  let initial first(scoping_consistent_returns)
  when scoping_return_specified(initial, treatUndefinedAsUnspecified)
  when !scoping_return_constructor && code_path == "falls_off"
  report at scoping_return_head
  warn "Expected to return a value at the end of {scoping_return_name}."
}

in ts_node let underscore_declarator
  if is ts_declarator.name then parent.node
  else if parent is (ts_array_pattern, ts_object_pattern) || is (ts_pattern_property.value, ts_assignment_pattern.left, ts_rest.argument)
    || is ts_pattern_property.key && (parent.value == null || parent.value is ts_assignment_pattern && parent.value.left == null) then parent.underscore_declarator
  else null
in ts_node let underscore_pattern
  if parent is ts_array_pattern then "array"
  else if parent is ts_object_pattern then "object"
  else if parent is (ts_pattern_property, ts_assignment_pattern, ts_rest) then parent.underscore_pattern
  else null
in ts_parameter let underscore_parameter_position if parent is (ts_function, ts_arrow, ts_method) then {start: offset, end: parent.end_offset} else null
in ts_rest let underscore_parameter_position if is ts_parameter.name then parent.underscore_parameter_position else null
in ts_method let underscore_method_position if parent is ts_class || kind != "get" && kind != "set" then offset else null
in ts_identifier, ts_private_name let underscore_candidate
  if underscore_declarator != null then {context: underscore_pattern.nonempty ?? "variable"}
  else if is ts_function.name && declaration_kind == "function" then {context: "function"}
  else if is (ts_parameter.name, ts_rest.argument) && parent.underscore_parameter_position != null then {context: "parameter"}
  else if is ts_method.key && parent.underscore_method_position != null then {context: "method"}
  else if is ts_class_property.key then {context: "field"}
  else if is ts_identifier && is (ts_member.property, ts_index.index) then {context: "member"}
  else null
fn underscore_this_constructor(object) = object is ts_member && object.property == "constructor" && (object.object.scoping_unparen_node.nonempty ?? object.object.node) is ts_this
in ts_identifier, ts_private_name rule no-underscore-dangle {
  option allow string[] = [] "names allowed to have dangling underscores"
  option allowAfterSuper boolean = false
  option allowAfterThis boolean = false
  option allowAfterThisConstructor boolean = false
  option allowFunctionParams boolean = true
  option allowInArrayDestructuring boolean = true
  option allowInObjectDestructuring boolean = true
  option enforceInClassFields boolean = false
  option enforceInMethodNames boolean = false
  let bare_name if is ts_private_name then slice(text, 1) else text
  when bare_name != "_" && (starts_with(bare_name, "_") || ends_with(bare_name, "_")) && !contains(allow, bare_name)
  let candidate underscore_candidate
  when candidate != null
  when !(allowFunctionParams && candidate.context == "parameter")
  when !(allowInArrayDestructuring && candidate.context == "array")
  when !(allowInObjectDestructuring && candidate.context == "object")
  when (enforceInClassFields || candidate.context != "field") && (enforceInMethodNames || candidate.context != "method")
  let receiver if candidate.context == "member" then parent.object.scoping_unparen_node.nonempty ?? parent.object.node else null
  when !(candidate.context == "member" && (bare_name == "__proto__" || allowAfterThis && receiver is ts_this || allowAfterSuper && receiver is ts_super || allowAfterThisConstructor && underscore_this_constructor(receiver)))
  report at node
  warn "Unexpected dangling '_' in '{text}'."
}

in ts_identifier let scoping_promise_callee text == "Promise" && resolved == "global" && global != "off"
in ts_unary let scoping_void_expression operator == "void"
in ts_parenthesized forward scoping_promise_callee, scoping_void_expression from expression
in ts_parenthesized let scoping_expression_offset expression.scoping_expression_offset.nonempty ?? expression.offset
in ts_new let scoping_promise_new callee.scoping_promise_callee
in ts_function, ts_arrow, ts_parenthesized let scoping_executor_argument
  if parent is ts_parenthesized then parent.scoping_executor_argument
  else is ts_new.argument && index == 0 && parent.scoping_promise_new
in ts_statement, ts_arrow, ts_method, ts_static_block, ts_program, ts_case let scoping_executor_body
  if is ts_function_like then scoping_executor_argument.nonempty ?? false
  else if is (ts_program, ts_static_block) then false
  else parent.scoping_executor_body

in ts_return let scoping_executor_result
  if scoping_executor_body && argument != null then {void: argument.scoping_void_expression, offset: offset} else null
in ts_arrow let scoping_executor_result
  if scoping_executor_argument && body not ts_block then
    {void: body.scoping_void_expression, offset: body.scoping_expression_offset.nonempty ?? body.offset} else null
in ts_return, ts_arrow rule no-promise-executor-return {
  option allowVoid boolean = false "allow explicit void return expressions"
  let returned scoping_executor_result
  when returned != null && !(allowVoid && returned.void)
  report at returned.offset
  warn "Return values from promise executor functions cannot be read."
}

in ts_identifier rule block-scoped-var {
  each definition in scoping_outside_bindings
  warn "'{text}' declared on line {definition.line} column {definition.column} is used outside of binding context."
}

in ts_statement, ts_arrow, ts_method, ts_static_block, ts_program, ts_case let scoping_declaration_body
  if is ts_program then "program"
  else if is ts_static_block then "class static block body"
  else if is ts_function_like then "function body"
  else parent.scoping_declaration_body
in ts_program, ts_static_block let scoping_body_root true
in ts_block let scoping_body_root parent is (ts_function_like, ts_static_block)
in ts_block let scoping_static_body parent is ts_static_block
fn scoping_var_step(prior, variable, prefix, static_body) =
  if prior == 2 then 2 else if variable then 1 else if prior == 0 && prefix && !static_body then 0 else 2
in ts_expression_statement let scoping_var_directive expression is ts_string
in ts_export let scoping_export_variable declaration is ts_variable_declaration
in ts_statement let scoping_var_prefix {
  value previous.scoping_var_prefix.nonempty ?? 0
  scoping_var_step (is ts_variable_declaration || scoping_export_variable) (is ts_import || scoping_var_directive) (parent is ts_static_block || parent.scoping_static_body)
}
in ts_export let scoping_export_top parent.scoping_body_root && scoping_var_prefix != 2
in ts_variable_declaration rule vars-on-top {
  when kind == "var"
  when !(if parent is ts_export then parent.scoping_export_top else parent.scoping_body_root && scoping_var_prefix != 2)
  warn "All 'var' declarations must be at the top of the function scope."
}

in ts_function rule no-inner-declarations {
  option mode "functions" | "both" = "functions"
  option blockScopedFunctions "allow" | "disallow" = "allow"
  when parent is (ts_program, ts_block, ts_export, ts_if, ts_labeled, ts_while, ts_do_while, ts_for, ts_for_in, ts_for_of, ts_case)
  when !parent.scoping_body_root && parent not ts_export
  when !(blockScopedFunctions == "allow" && ecma_version >= 2015 && parent.scoping_strict_code)
  warn "Move function declaration to { parent.scoping_declaration_body.nonempty ?? 'program' } root."
}
in ts_variable_declaration rule no-inner-declarations:variable {
  option mode "functions" | "both" = "functions"
  option blockScopedFunctions "allow" | "disallow" = "allow"
  when mode == "both" && kind == "var" && !parent.scoping_body_root && parent not ts_export
  warn "Move variable declaration to { parent.scoping_declaration_body.nonempty ?? 'program' } root."
}

in ts_identifier rule no-redeclare {
  option builtinGlobals boolean = true "also report built-in global redeclarations"
  option ignoreDeclarationMerge boolean = true "allow typescript declaration merging"
  let redeclared scoping_redeclaration
  when redeclared != null && (redeclared.duplicate || redeclared.comment || builtinGlobals && redeclared.builtin)
  when !(ignoreDeclarationMerge && redeclared.safe_merge && !redeclared.comment && !(builtinGlobals && redeclared.builtin))
  warn if builtinGlobals && redeclared.builtin then "'{text}' is already defined as a built-in global variable." else if redeclared.comment then "'{text}' is already defined by a variable declaration." else "'{text}' is already defined."
}
in ts_program rule no-redeclare:global {
  option builtinGlobals boolean = true "also report built-in global redeclarations"
  option ignoreDeclarationMerge boolean = true "allow typescript declaration merging"
  each redeclaration in filter(scoping_global_redeclarations, d => d.duplicate || d.syntax || builtinGlobals && d.builtin)
  report at redeclaration.offset
  warn if builtinGlobals && redeclaration.builtin then "'{redeclaration.name}' is already defined as a built-in global variable." else if redeclaration.syntax then "'{redeclaration.name}' is already defined by a variable declaration." else "'{redeclaration.name}' is already defined."
}

in ts_this let scoping_captures_this true
in ts_parenthesized forward scoping_captures_this from expression
in ts_assignment let scoping_assigns_this operator == "=" && right.scoping_captures_this
in ts_identifier let scoping_initialised_alias parent is ts_declarator && parent.init != null
in ts_identifier let scoping_alias_initialised
  any(declarations, d => d.scope == scope && d.scoping_initialised_alias)
  || any(declarations, d => any(d.references, r => r.scope == scope && r.writer.scoping_assigns_this))
in ts_declarator let scoping_alias_context
  if name is ts_identifier then {
    name: name, this: init.scoping_captures_this, valid: init.scoping_captures_this, value: init != null,
    assigned: init != null || name.scoping_alias_initialised
  } else null
in ts_assignment let scoping_alias_context
  if left is ts_identifier then {
    name: left, this: right.scoping_captures_this, valid: scoping_assigns_this, value: right != null, assigned: right != null
  } else null
in ts_declarator, ts_assignment rule consistent-this {
  option names string[] = ["that"] "names used to capture this"
  let alias scoping_alias_context
  when alias != null && { value if len(names) == 0 then ["that"] else names; contains alias.name }
  when alias.value && !alias.valid || !alias.assigned
  warn "Designated alias '{alias.name}' is not assigned to 'this'."
}
in ts_declarator, ts_assignment rule consistent-this:unexpected {
  option names string[] = ["that"] "names used to capture this"
  let alias scoping_alias_context
  when alias != null && alias.this && !{ value if len(names) == 0 then ["that"] else names; contains alias.name }
  warn "Unexpected alias '{alias.name}' for 'this'."
}

in ts_program.binding_declarations rule no-shadow {
  option allow string[] = [] "names allowed to shadow"
  option builtinGlobals boolean = false "also check configured global names"
  option hoist "all" | "functions" | "never" | "types" | "functions-and-types" = "functions"
  option ignoreOnInitialization boolean = false "allow callback declarations in initializers"
  option ignoreTypeValueShadow boolean = true "allow type and value namespace shadowing"
  option ignoreFunctionTypeParameterNameValueShadow boolean = true "allow parameter names in function types"
  let shadowed scoping_shadow
  when shadowed != null && !contains(allow, identifier_name)
  when !shadowed.global || builtinGlobals
  when !(ignoreTypeValueShadow && shadowed.type_value)
  when !(ignoreFunctionTypeParameterNameValueShadow && shadowed.function_type)
  when !(ignoreOnInitialization && shadowed.initializing)
  when !shadowed.early || hoist == "all" || (hoist == "functions" || hoist == "functions-and-types") && shadowed.kind == "function" || (hoist == "types" || hoist == "functions-and-types") && contains(["type", "interface"], shadowed.kind)
  warn if shadowed.enum_member then "Enum members are added to the enum scope, so references to '{text}' in enum member initializers resolve to this member instead of the declaration in the upper scope on line {shadowed.line} column {shadowed.column}." else if shadowed.global then "'{text}' is already a global variable." else "'{text}' is already declared in the upper scope on line {shadowed.line} column {shadowed.column}."
}

in ts_identifier rule no-use-before-define {
  option mode "always" | "nofunc" = "always"
  option functions boolean = true "check function declarations"
  option classes boolean = true "check class declarations across execution contexts"
  option variables boolean = true "check variables across execution contexts"
  option enums boolean = true "check enum declarations"
  option typedefs boolean = true "check type declarations"
  option allowNamedExports boolean = false "allow export specifiers before declarations"
  option ignoreTypeReferences boolean = true "allow type references before declarations"
  let definition scoping_definition_use
  when definition.before && !(allowNamedExports && definition.export)
  when !(ignoreTypeReferences && access == "type")
  when !((!functions || mode == "nofunc") && (definition.kind == "function" || definition.kind == "function_name"))
  when !(definition.separate && (!classes && (definition.kind == "class" || definition.kind == "class_name") || !variables && contains(["var", "let", "const", "using"], definition.kind)))
  when !(!enums && definition.kind == "enum")
  when !(!typedefs && contains(["type", "interface"], definition.kind))
  warn "'{text}' was used before it was defined."
}

fn implicit_global_label(kind) = if kind == "function" || kind == "class" then kind else "'" kind "'"
in ts_variable_declaration, ts_function, ts_class rule no-implicit-globals {
  option lexicalBindings boolean = false "also top-level let, const and class declarations"
  each global_declaration in filter(scoping_global_declarations, d => !d.exported && contains(["var", "let", "const", "function", "class"], d.kind) && d.setting != "writable" && (lexicalBindings || d.kind == "var" || d.kind == "function"))
  report at global_declaration.offset
  warn if global_declaration.setting == "readonly" then "Unexpected redeclaration of read-only global variable." else if global_declaration.kind == "var" || global_declaration.kind == "function" then "Unexpected {implicit_global_label(global_declaration.kind)} declaration in the global scope, wrap in an IIFE for a local variable, assign as global property for a global variable." else "Unexpected {implicit_global_label(global_declaration.kind)} declaration in the global scope, wrap in a block or in an IIFE."
}
in ts_identifier rule no-implicit-globals:leak {
  option lexicalBindings boolean = false "also top-level let, const and class declarations"
  when source_type != "module" && !scoping_strict_code && resolved == "global" && (global == null || global == "off") && access == "write"
  report at node
  warn "Global variable leak, declare the variable if it is intended to be local."
}
in ts_identifier rule no-implicit-globals:readonly {
  option lexicalBindings boolean = false "also top-level let, const and class declarations"
  when source_type != "module" && resolved == "global" && global == "readonly" && access == "write"
  report at node
  warn "Unexpected assignment to read-only global variable."
}

in ts_variable_declaration rule no-case-declarations {
  when parent is ts_case && kind != "var"
  warn "Unexpected lexical declaration in case block."
}
in ts_function, ts_class rule no-case-declarations:declaration {
  when parent is ts_case
  warn "Unexpected lexical declaration in case block."
}

in ts_identifier rule no-param-reassign {
  option props boolean = false "also assignments to parameter properties"
  option ignorePropertyModificationsFor string[] = [] "parameter names whose properties may change"
  option ignorePropertyModificationsForRegex string[] = [] "patterns for exempt parameter names"
  when reference_kind == "parameter" && (access == "write" || access == "read_write")
  warn "Assignment to function parameter '{text}'."
}
in ts_identifier rule no-param-reassign:property {
  option props boolean = false "also assignments to parameter properties"
  option ignorePropertyModificationsFor string[] = [] "parameter names whose properties may change"
  option ignorePropertyModificationsForRegex string[] = [] "patterns for exempt parameter names"
  when props && param_property_write && !contains(ignorePropertyModificationsFor, identifier_name)
  when !any(ignorePropertyModificationsForRegex, pattern => re_test(identifier_name, pattern))
  warn "Assignment to property of function parameter '{text}'."
}

in ts_return rule no-constructor-return {
  when argument != null && enclosing_function_name == "constructor"
  warn "Unexpected return statement in constructor."
}

in ts_variable_declaration {
  let scoping_loop_head is (ts_for.init, ts_for_in.left, ts_for_of.left)
  let scoping_iteration_binding is (ts_for_in.left, ts_for_of.left)
}
in ts_declarator rule init-declarations {
  option mode "always" | "never" = "always"
  option ignoreForLoopInit boolean = false "allow initialized declarations in loop initializers"
  when name.declaration_kind != null && name.ambient != true && mode == "always" && init == null
  when !parent.scoping_iteration_binding
  warn "Variable '{name}' should be initialized on declaration."
}
in ts_declarator rule init-declarations:never {
  option mode "always" | "never" = "always"
  option ignoreForLoopInit boolean = false "allow initialized declarations in loop initializers"
  when name.declaration_kind != null && name.ambient != true && mode == "never"
  when parent.kind != "const" && name.declaration_kind != "using"
  when init != null || parent.scoping_iteration_binding
  when !(ignoreForLoopInit && parent.scoping_loop_head)
  warn "Variable '{name}' should not be initialized on declaration."
}

in ts_method rule class-methods-use-this {
  option exceptMethods string[] = [] "method names that need not use this"
  option enforceForClassFields boolean = true "also check function-valued class fields"
  option ignoreOverrideMethods boolean = false "ignore overriding methods"
  option ignoreClassesWithImplements "all" | "public-fields" | null = null "ignore methods implementing interfaces"
  option ignoreClassesThatImplementAnInterface boolean | "public-fields" = false "typescript-eslint interface exception"
  when parent is ts_class && body != null && !contains(modifier, "static") && static_name != "constructor"
  when !scoping_receiver_use && !{ value default: static_name.nonempty ?? key; value contains(exceptMethods, default) }
  when !(ignoreOverrideMethods && contains(modifier, "override"))
  when !((ignoreClassesWithImplements == "all" || ignoreClassesThatImplementAnInterface == true) && parent.implements != null)
  when !((ignoreClassesWithImplements == "public-fields" || ignoreClassesThatImplementAnInterface == "public-fields") && parent.implements != null && !contains(modifier, "private") && !contains(modifier, "protected") && !starts_with(key, "#"))
  report at function_warning_site(node)
  warn "Expected 'this' to be used by class {function_name}."
}
in ts_class_property rule class-methods-use-this:field {
  option exceptMethods string[] = [] "method names that need not use this"
  option enforceForClassFields boolean = true "also check function-valued class fields"
  option ignoreOverrideMethods boolean = false "ignore overriding methods"
  option ignoreClassesWithImplements "all" | "public-fields" | null = null "ignore methods implementing interfaces"
  option ignoreClassesThatImplementAnInterface boolean | "public-fields" = false "typescript-eslint interface exception"
  when enforceForClassFields && parent is ts_class && !contains(modifier, "static")
  when init.function_name != null && !scoping_receiver_use
  when !{ value default: static_name.nonempty ?? key; value contains(exceptMethods, default) }
  when !(ignoreOverrideMethods && contains(modifier, "override"))
  when !((ignoreClassesWithImplements == "all" || ignoreClassesThatImplementAnInterface == true) && parent.implements != null)
  when !((ignoreClassesWithImplements == "public-fields" || ignoreClassesThatImplementAnInterface == "public-fields") && parent.implements != null && !contains(modifier, "private") && !contains(modifier, "protected") && !starts_with(key, "#"))
  report at function_warning_site(init.node)
  warn if contains(modifier, "accessor") then "Expected 'this' to be used by class arrow function." else "Expected 'this' to be used by class {init.function_name}."
}

in ts_identifier let scoping_cap_name text
in ts_member, ts_index let scoping_cap_name static_name
in ts_parenthesized let scoping_cap_name expression.scoping_cap_name
in ts_identifier let scoping_builtin_constructor global == "readonly" || global == "writable"
in ts_member, ts_index let scoping_builtin_constructor (object == "globalThis" || object == "window" || object == "self" || object == "global") && (object.global == "readonly" || object.global == "writable")
in ts_parenthesized let scoping_builtin_constructor expression.scoping_builtin_constructor
in ts_member, ts_index let scoping_is_property true
in ts_parenthesized let scoping_is_property expression.scoping_is_property
in ts_identifier let scoping_global_date text == "Date" && resolved == "global" && global != "off"
in ts_identifier let scoping_global_object contains(["global", "globalThis", "self", "window"], text) && resolved == "global" && contains(["readonly", "writable"], global)
in ts_member, ts_index let scoping_global_date static_name == "Date" && object.scoping_global_object
in ts_parenthesized forward scoping_global_date, scoping_global_object from expression
in ts_member, ts_index let scoping_utc_call static_name == "UTC" && object.scoping_global_date
in ts_parenthesized forward scoping_utc_call from expression
in ts_identifier, ts_function, ts_method let scoping_callable_head offset
in ts_arrow let scoping_callable_head operator.offset
in ts_member let scoping_callable_head property.scoping_expression_offset.nonempty ?? property.offset
in ts_index let scoping_callable_head index.scoping_expression_offset.nonempty ?? index.offset
in ts_parenthesized let scoping_callable_head expression.scoping_callable_head.nonempty ?? expression.offset
in ts_call.callee rule new-cap {
  option capIsNew boolean = true "require new for capitalised calls"
  option newIsCap boolean = true "require capitalised constructors"
  option capIsNewExceptions string[] = [] "capitalised functions that may be called"
  option newIsCapExceptions string[] = [] "lowercase functions that may be constructed"
  option capIsNewExceptionPattern regex | null = null "pattern for callable capitalised functions"
  option newIsCapExceptionPattern regex | null = null "pattern for constructible lowercase functions"
  option properties boolean = true "check member calls"
  when capIsNew && scoping_cap_name != null && re_test(scoping_cap_name, /^\p{Lu}/)
  when properties || scoping_is_property != true
  when !contains(capIsNewExceptions, scoping_cap_name) && !contains(capIsNewExceptions, text)
  when capIsNewExceptionPattern == null || !re_test(text, capIsNewExceptionPattern)
  when !(scoping_builtin_constructor && contains(["Array", "Boolean", "Date", "Error", "Function", "Number", "Object", "RegExp", "String", "Symbol", "BigInt"], scoping_cap_name))
  when !scoping_utc_call
  report at scoping_callable_head
  warn "A function with a name starting with an uppercase letter should only be used as a constructor."
}
in ts_new.callee rule new-cap:constructor {
  option capIsNew boolean = true "require new for capitalised calls"
  option newIsCap boolean = true "require capitalised constructors"
  option capIsNewExceptions string[] = [] "capitalised functions that may be called"
  option newIsCapExceptions string[] = [] "lowercase functions that may be constructed"
  option capIsNewExceptionPattern regex | null = null "pattern for callable capitalised functions"
  option newIsCapExceptionPattern regex | null = null "pattern for constructible lowercase functions"
  option properties boolean = true "check member calls"
  when newIsCap && scoping_cap_name != null && re_test(scoping_cap_name, /^\p{Ll}/)
  when properties || scoping_is_property != true
  when !contains(newIsCapExceptions, scoping_cap_name) && !contains(newIsCapExceptions, text)
  when newIsCapExceptionPattern == null || !re_test(text, newIsCapExceptionPattern)
  report at scoping_callable_head
  warn "A constructor name should not start with a lowercase letter."
}

}
