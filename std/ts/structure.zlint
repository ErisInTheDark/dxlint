# .ts/structure: @stylistic rules about the shape of code across lines:
# indentation, parentheses, wrapping, comments' places, line lengths.

define {

in ts_conditional let structure_ternary_jsx if parent is ts_conditional then parent.structure_ternary_jsx else parent is ts_jsx_expression
in ts_binary, ts_logical let structure_operator operator
in ts_conditional let structure_operator "?:"
in ts_binary, ts_logical let structure_operator_offset operator.offset
in ts_conditional let structure_operator_offset (test.space_after).end
in ts_conditional let structure_test_offset test.offset
in ts_conditional let structure_consequent_offset consequent.offset
in ts_variable_declaration let structure_loop_declaration parent is (ts_for, ts_for_in, ts_for_of)
in ts_union, ts_intersection let structure_first_type_offset first(type.offset)
in ts_type_alias let structure_start offset
in ts_unary let structure_typeof operator == "typeof"
in ts_parenthesized let structure_typeof default(expression.structure_typeof, false)
in ts_parenthesized let structure_single_conditional expression.layer is ts_conditional

@macro structure_mixed_operator_rule(name, position) {
  in ts_binary, ts_logical rule name {
    option groups string[][] = [["+", "-", "*", "/", "%", "**"], ["&", "|", "^", "~", "<<", ">>", ">>>"], ["==", "!=", "===", "!==", ">", ">=", "<", "<="], ["&&", "||"], ["in", "instanceof"]] "operator groups requiring parentheses"
    option allowSamePrecedence boolean = true "allow mixtures with equal precedence"
    when parent is (ts_binary, ts_logical, ts_conditional)
    let child_operator structure_operator
    let outer_operator parent.structure_operator
    when child_operator != outer_operator
    when !allowSamePrecedence || precedence != parent.precedence
    when any(groups, operators => contains(operators, child_operator) && contains(operators, outer_operator))
    let child_first field == "left" || field == "test"
    let left_operator if child_first then child_operator else outer_operator
    let right_operator if child_first then outer_operator else child_operator
    report at position
    warn "Unexpected mix of '{left_operator}' and '{right_operator}'. Use parentheses to clarify the intended order of operations."
  }
}

in ts_call, ts_new, ts_import_call let structure_argument_count count(argument)
in ts_function, ts_call let structure_iife_wrapped parent is ts_parenthesized
  || parent is (ts_if, ts_while, ts_do_while) && field == "test"
  || parent is ts_switch && field == "discriminant"
  || parent is ts_with && field == "object"
  || parent is (ts_call, ts_new, ts_import_call) && field == "argument" && parent.structure_argument_count == 1 && next_token is ts_close_paren
in ts_function let structure_iife_callee { direct: true, prototype: false, wrapped: structure_iife_wrapped }
in ts_parenthesized let structure_iife_callee expression.structure_iife_callee
in ts_member, ts_index let structure_iife_callee if (object.structure_iife_callee).direct && contains(["call", "apply"], static_name) then { direct: false, prototype: true, wrapped: (object.structure_iife_callee).wrapped } else null

in ts_call rule wrap-iife {
  option mode "outside" | "inside" | "any" = "outside"
  option functionPrototypeMethods boolean = false "include function call/apply invocations"
  let info callee.structure_iife_callee
  when info != null && (functionPrototypeMethods || !info.prototype)
  when !structure_iife_wrapped && !info.wrapped || mode == "inside" && !info.wrapped || mode == "outside" && !structure_iife_wrapped
  warn if !structure_iife_wrapped && !info.wrapped then "Wrap an immediate function invocation in parentheses." else if mode == "inside" then "Wrap only the function expression in parens." else "Move the invocation into the parens that contain the function."
}

@structure_mixed_operator_rule(no-mixed-operators:child, structure_operator_offset)
@structure_mixed_operator_rule(no-mixed-operators:parent, parent.structure_operator_offset)

in ts_variable_declaration rule one-var {
  option options ("always" | "never" | "consecutive" | { separateRequires?: boolean; var?: "always" | "never" | "consecutive"; let?: "always" | "never" | "consecutive"; const?: "always" | "never" | "consecutive"; using?: "always" | "never" | "consecutive"; awaitUsing?: "always" | "never" | "consecutive"; initialized?: "always" | "never" | "consecutive"; uninitialized?: "always" | "never" | "consecutive" })[] = [] "declaration grouping policy"
  let info declaration_groups
  let settings default(first(options), "always")
  let kind info.kind
  let common if type_of(settings) == "str" then settings else if kind == "var" then settings.var else if kind == "let" then settings.let else if kind == "const" then settings.const else if kind == "using" then settings.using else settings.awaitUsing
  let init_mode default(settings.initialized, common)
  let uninit_mode default(settings.uninitialized, common)
  let counts info.counts
  let previous_counts info.previous
  let total counts.initialized + counts.uninitialized
  let prior_counts info.prior
  let prior_init prior_counts.initialized > 0 && (!settings.separateRequires || prior_counts.initialized > prior_counts.requires)
  let prior_uninit prior_counts.uninitialized > 0
  let prior_required settings.separateRequires && prior_counts.requires > 0
  let both_always init_mode == "always" && uninit_mode == "always"
  let always_failed both_always && (prior_init || prior_uninit) && counts.requires == 0 || uninit_mode == "always" && counts.uninitialized > 0 && prior_uninit || init_mode == "always" && counts.initialized > 0 && prior_init && counts.requires == 0 || prior_required && counts.requires > 0
  let consecutive previous_counts != null && !((counts.requires + previous_counts.requires > 0) && (total + previous_counts.initialized + previous_counts.uninitialized > counts.requires + previous_counts.requires))
  let consecutive_message if !consecutive then null else if init_mode == "consecutive" && uninit_mode == "consecutive" then "Combine this with the previous '" kind "' statement." else if init_mode == "consecutive" && counts.initialized > 0 && previous_counts.initialized > 0 then "Combine this with the previous '" kind "' statement with initialized variables." else if uninit_mode == "consecutive" && counts.uninitialized > 0 && previous_counts.uninitialized > 0 then "Combine this with the previous '" kind "' statement with uninitialized variables." else null
  let split_message if total < 2 || info.for_init then null else if init_mode == "never" && uninit_mode == "never" then "Split '" kind "' declarations into multiple statements." else if init_mode == "never" && counts.initialized > 0 then "Split initialized '" kind "' declarations into multiple statements." else if uninit_mode == "never" && counts.uninitialized > 0 then "Split uninitialized '" kind "' declarations into multiple statements." else null
  each issue in compact([
    if init_mode == "always" && settings.separateRequires && counts.requires > 0 && counts.requires < total then "Split requires to be separated into a single block." else null,
    consecutive_message,
    if always_failed && both_always then "Combine this with the previous '" kind "' statement." else null,
    if always_failed && !both_always && init_mode == "always" && counts.initialized > 0 then "Combine this with the previous '" kind "' statement with initialized variables." else null,
    if always_failed && !both_always && uninit_mode == "always" && counts.uninitialized > 0 && !info.for_binding then "Combine this with the previous '" kind "' statement with uninitialized variables." else null,
    split_message
  ])
  warn "{issue}"
}

macro expanded_line_length(parts, extra, width) (if width == 0 then sum(parts) else sum(map(slice(parts, 0, len(parts) - 1), part => part - part % width + width)) + last(parts)) - extra

in ts_program rule max-len {
  option options (number | { code?: number; comments?: number; tabWidth?: number; ignorePattern?: string; ignoreComments?: boolean; ignoreStrings?: boolean; ignoreUrls?: boolean; ignoreTemplateLiterals?: boolean; ignoreRegExpLiterals?: boolean; ignoreTrailingComments?: boolean })[] = [] "line limits, tab stops and exemptions"
  let settings last(options)
  let code_limit if type_of(first(options)) == "num" then first(options) else default(settings.code, 80)
  let second first(slice(options, 1))
  let tab_width if type_of(second) == "num" then second else default(settings.tabWidth, 4)
  let comment_limit default(settings.comments, 0)
  let strip_comments settings.ignoreTrailingComments || settings.ignoreComments
  let measurements map(line_lengths, source_line => {
    offset: source_line.offset,
    text: if strip_comments then source_line.stripped else source_line.text,
    length: expanded_line_length(if strip_comments then source_line.stripped_segments else source_line.segments, if strip_comments then source_line.stripped_unicode_extra else source_line.unicode_extra, tab_width),
    comment_applies: source_line.comment && comment_limit > 0,
    limit: if source_line.comment && comment_limit > 0 then comment_limit else code_limit,
    ignored: settings.ignoreComments && source_line.comment || settings.ignoreStrings && source_line.string || settings.ignoreTemplateLiterals && source_line.template || settings.ignoreRegExpLiterals && source_line.regex
  })
  each finding in measurements
  when !finding.ignored
  when !settings.ignoreUrls || !re_test(finding.text, /[^:/?#]:\/\/[^?#]/)
  when !settings.ignorePattern || !re_test(finding.text, settings.ignorePattern)
  when finding.length > finding.limit
  report at finding.offset
  warn if finding.comment_applies then "This line has a comment length of {finding.length}. Maximum allowed is {finding.limit}." else "This line has a length of {finding.length}. Maximum allowed is {finding.limit}."
}

in ts_program rule line-comment-position {
  option options ("above" | "beside" | { position?: "above" | "beside"; ignorePattern?: string; applyDefaultIgnorePatterns?: boolean })[] = [] "line comment position and exemptions"
  let settings first(options)
  let position if type_of(settings) == "str" then settings else default(settings.position, "above")
  let ignore_pattern default(settings.ignorePattern, "")
  let ignore_default default(settings.applyDefaultIgnorePatterns, true)
  each finding in comment_layout
  when !ignore_default || !finding.directive && !re_test(finding.body, /^\s*falls?\s?through/)
  when ignore_pattern == "" || !re_test(finding.body, ignore_pattern)
  when position == "above" && finding.beside || position == "beside" && !finding.beside
  report at finding.offset
  warn if position == "above" then "Expected comment to be above code." else "Expected comment to be beside code."
}

in ts_program rule multiline-comment-style {
  option mode "starred-block" | "bare-block" | "separate-lines" = "starred-block"
  option checkJSDoc boolean = false "check JSDoc when requiring line comments"
  option checkExclamation boolean = false "check exclamation comments when requiring line comments"
  each finding in comment_style_findings
  when finding.mode == mode
  when checkJSDoc || !finding.jsdoc
  when checkExclamation || !finding.exclamation
  report at finding.offset
  warn "{finding.message}"
}

in ts_parenthesized, ts_parenthesized_type rule no-extra-parens {
  option mode "all" | "functions" = "all"
  option conditionalAssign boolean = true "enforce assignments in conditions"
  option ternaryOperandBinaryExpressions boolean = true "enforce binary ternary operands"
  option nestedBinaryExpressions boolean = true "enforce nested binary operands"
  option returnAssign boolean = true "enforce assignments in returns"
  option nestedConditionalExpressions boolean = true "enforce nested conditionals"
  option enforceForArrowConditionals boolean = true "enforce conditional arrow bodies"
  option enforceForSequenceExpressions boolean = true "enforce sequence expressions"
  option enforceForNewInMemberExpressions boolean = true "enforce new expressions in member access"
  option enforceForFunctionPrototypeMethods boolean = true "enforce function prototype receivers"
  option allowParensAfterCommentPattern string = "" "allow parentheses after matching comments"
  option ignoreJSX "none" | "all" | "multi-line" | "single-line" = "none"
  option ignoredNodes string[] = [] "ignored selector contexts"
  option allowNodesInSpreadElement { ConditionalExpression?: boolean; LogicalExpression?: boolean; AssignmentExpression?: boolean; AwaitExpression?: boolean } = {} "allowed spread operands"
  let parens excess_parens
  when parens != null && (mode == "all" || parens.functions)
  when conditionalAssign || !parens.conditional_assign
  when ternaryOperandBinaryExpressions || !parens.ternary_binary
  when nestedBinaryExpressions || !parens.nested_binary
  when returnAssign || !parens.return_assign
  when nestedConditionalExpressions || !parens.nested_conditional
  when enforceForArrowConditionals || !parens.arrow_conditional
  when enforceForSequenceExpressions || !parens.sequence
  when enforceForNewInMemberExpressions || !parens.new_member
  when enforceForFunctionPrototypeMethods || !parens.function_member
  when !parens.jsx || ignoreJSX == "none" || ignoreJSX == "multi-line" && !parens.multiline || ignoreJSX == "single-line" && parens.multiline
  when !allowNodesInSpreadElement.ConditionalExpression || !parens.spread_conditional
  when !allowNodesInSpreadElement.LogicalExpression || !parens.spread_logical
  when !allowNodesInSpreadElement.AssignmentExpression || !parens.spread_assignment
  when !allowNodesInSpreadElement.AwaitExpression || !parens.spread_await
  when !any(ignoredNodes, selector => contains(parens.selectors, re_replace(selector, /["']/, "")))
  when allowParensAfterCommentPattern == "" || parens.comment == null || !re_test(parens.comment, allowParensAfterCommentPattern)
  report at parens.offset
  warn "Unnecessary parentheses around expression."
}

in ts_question, ts_colon rule multiline-ternary {
  option mode "always" | "always-multiline" | "never" = "always"
  option ignoreJSX boolean = false "ignore conditionals in JSX expressions"
  when parent is ts_conditional
  when !ignoreJSX || !parent.structure_ternary_jsx
  when mode != "always-multiline" || re_test(parent_text, /[\n\r\u{2028}\u{2029}]/)
  let broken space_before.line_break || space_after.line_break
  when mode == "never" && broken || mode != "never" && !broken
  let operands if text == "?" then "test and consequent" else "consequent and alternate"
  report at if text == "?" then parent.structure_test_offset else parent.structure_consequent_offset
  warn if mode == "never" then "Unexpected newline between {operands} of ternary expression." else "Expected newline between {operands} of ternary expression."
}

in ts_program rule no-tabs {
  option allowIndentationTabs boolean = false "allow tabs at the start of a line"
  each finding in line_layout_findings
  when finding.kind == "tab" && (!allowIndentationTabs || !finding.indentation)
  report at finding.offset
  warn "Unexpected tab character."
}

in ts_program rule no-mixed-spaces-and-tabs {
  option mode "default" | "smart-tabs" = "default"
  each finding in line_layout_findings
  when mode == "smart-tabs" && finding.kind == "mixed-smart" || mode != "smart-tabs" && finding.kind == "mixed"
  report at finding.offset
  warn "Mixed spaces and tabs."
}

in ts_program rule linebreak-style {
  option mode "unix" | "windows" = "unix"
  each finding in line_layout_findings
  when mode == "unix" && contains(["crlf", "other-linebreak"], finding.kind) || mode == "windows" && contains(["lf", "other-linebreak"], finding.kind)
  report at finding.offset
  warn if mode == "unix" then "Expected linebreaks to be 'LF' but found 'CRLF'." else "Expected linebreaks to be 'CRLF' but found 'LF'."
}

in ts_program rule unicode-bom {
  option mode "always" | "never" = "never"
  when mode == "always" && !bom || mode == "never" && bom
  report at 0
  warn if mode == "always" then "Expected Unicode BOM (Byte Order Mark)." else "Unexpected Unicode BOM (Byte Order Mark)."
}

in ts_regex rule wrap-regex {
  when parent == "ts_member" && field == "object"
  warn "Wrap the regexp literal in parens to disambiguate the slash."
}

in ts_declarator rule one-var-declaration-per-line {
  option mode "initializations" | "always" = "initializations"
  when previous_sibling != null && !contains(previous_gap, "\n")
  when !parent.structure_loop_declaration
  when mode == "always" || init != null || previous.init != null
  warn "Expected variable declaration to be on a new line."
}

in ts_binary rule eqeqeq {
  option options ("always" | "smart" | "allow-null" | { null: "always" | "never" | "ignore" })[] = [] "equality mode and null policy"
  let mode default(first(options), "always")
  let null_mode default(last(options).null, "always")
  let left_literal left.literal_value
  let right_literal right.literal_value
  let null_check left_literal.type == "null" || right_literal.type == "null"
  let same_literal_type left_literal != null && right_literal != null && left_literal.type == right_literal.type
  let loose operator == "==" || operator == "!="
  let strict_null (operator == "===" || operator == "!==") && null_check && mode == "always" && null_mode == "never"
  when strict_null || loose && (!null_check || mode == "always" && null_mode == "always") && (mode != "smart" || !(same_literal_type || default(left.structure_typeof, false) || default(right.structure_typeof, false)))
  let expected if strict_null then slice(operator, 0, len(operator) - 1) else operator "="
  report at operator.offset
  warn "Expected '{expected}' and instead saw '{operator}'."
}

macro padding_selector_matches(info, selector) (if type_of(selector) == "str" then contains(info.tags, selector) else contains(info.selectors, re_replace(selector.selector, /["']/, "")) && (default(selector.lineMode, "any") == "any" || selector.lineMode == "multiline" && info.multiline || selector.lineMode == "singleline" && !info.multiline))

in ts_program rule padding-line-between-statements {
  option options { blankLine: "any" | "always" | "never"; prev: string | { selector: string; lineMode?: "any" | "singleline" | "multiline" } | (string | { selector: string; lineMode?: "any" | "singleline" | "multiline" })[]; next: string | { selector: string; lineMode?: "any" | "singleline" | "multiline" } | (string | { selector: string; lineMode?: "any" | "singleline" | "multiline" })[] }[] = [] "ordered statement padding policies"
  let findings map(statement_padding, info => {
    offset: info.offset,
    padded: info.padded,
    policy: default(last(filter(options, config => any(map(config.prev, selector => padding_selector_matches(info.prev, selector))) && any(map(config.next, selector => padding_selector_matches(info.next, selector))))).blankLine, "any"),
  })
  each info in findings
  when info.policy == "always" && !info.padded || info.policy == "never" && info.padded
  report at info.offset
  warn if info.policy == "always" then "Expected blank line before this statement." else "Unexpected blank line before this statement."
}

macro operand_cached_indent(records, row, fallback) default(last(filter(records, prior => prior.right_line == row)).expected, fallback)

in ts_program rule indent-binary-ops {
  option mode number | "tab" = 2 "indent width or tabs"
  let width if mode == "tab" then 1 else mode
  let unit if mode == "tab" then "\t" else " "
  let measurements reduce(binary_operand_indents, [], (state, info) => state [{
    offset: info.offset,
    right_line: info.right_line,
    actual: operand_cached_indent(state, info.right_line, info.right),
    expected: if info.adjust > 0 then (operand_cached_indent(state, info.left_line, info.left) repeat(unit, width)) else if info.adjust < 0 then slice(operand_cached_indent(state, info.left_line, info.left), width) else operand_cached_indent(state, info.left_line, info.left),
  }])
  each info in measurements
  when info.actual != info.expected
  report at info.offset
  warn "Expected indentation of " len(info.expected) " " (if mode == "tab" then "tab" else "space") (if len(info.expected) == 1 then "" else "s")
}

in ts_binary.operator, ts_logical.operator, ts_assignment.operator, ts_equals, ts_question, ts_colon, ts_punctuator rule operator-linebreak {
  option mode "before" | "after" | "none" | null = null "operator side of a line break"
  option overrides { [key: string]: "before" | "after" | "none" | "ignore" } = {} "operator-specific placement"
  when parent is (ts_binary, ts_logical, ts_assignment)
    || parent is (ts_conditional, ts_conditional_type) && contains(["?", ":"], text)
    || parent is (ts_declarator, ts_class_property, ts_import_equals, ts_type_alias, ts_type_parameter, ts_enum_member) && text == "="
    || parent is (ts_union, ts_intersection) && contains(["|", "&"], text) && offset > parent.structure_first_type_offset
  let placement default(get(overrides, text), if mode == null && contains(["?", ":"], text) then "before" else default(mode, "after"))
  let next_text if parent is ts_type_alias then byte_slice(parent_text, space_after.end - parent.structure_start) else null
  let policy if placement != "ignore" && parent is ts_type_alias && re_test(next_text, /^[|&]/) then "after" else placement
  when policy != "ignore" && (space_before.line_break || space_after.line_break)
  when space_before.line_break && space_after.line_break || policy == "before" && !space_before.line_break || policy == "after" && !space_after.line_break || policy == "none"
  warn if space_before.line_break && space_after.line_break then "Bad line breaking before and after '{text}'." else if policy == "before" then "'{text}' should be placed at the beginning of the line." else if policy == "after" then "'{text}' should be placed at the end of the line." else "There should be no line break before or after '{text}'."
}

in ts_array, ts_array_pattern, ts_object, ts_object_pattern, ts_function, ts_arrow, ts_call, ts_new, ts_if, ts_import, ts_export, ts_enum, ts_function_type, ts_interface, ts_type_literal, ts_tuple_type, ts_type_reference, ts_method, ts_class rule list-style {
  option empty "ignore" | "always" | "never" = "ignore" "empty bracket spacing"
  option singleLine { spacing?: "always" | "never"; maxItems?: number } = { spacing: "never" } "single-line lists"
  option multiLine { minItems?: number } = { minItems: 0 } "multiline lists"
  option overrides { [key: string]: "off" | { empty?: "ignore" | "always" | "never"; singleLine?: { spacing?: "always" | "never"; maxItems?: number }; multiLine?: { minItems?: number } } } = { "{}": { singleLine: { spacing: "always" } } } "bracket and node type overrides"
  let sites map(list_layout, info => {
    info: info,
    byNode: get(overrides, info.kind),
    byBracket: get(overrides, info.brackets),
  })
  let policies map(sites, entry => {
    info: entry.info,
    off: entry.byNode == "off" || entry.byNode == null && entry.byBracket == "off",
    empty: default(entry.byNode.empty, default(entry.byBracket.empty, empty)),
    spacing: default(entry.byNode.singleLine.spacing, default(entry.byBracket.singleLine.spacing, default(singleLine.spacing, "never"))),
    maxItems: default(entry.byNode.singleLine.maxItems, default(entry.byBracket.singleLine.maxItems, default(singleLine.maxItems, 1000000000))),
    minItems: default(entry.byNode.multiLine.minItems, default(entry.byBracket.multiLine.minItems, default(multiLine.minItems, 0))),
  })
  let findings map(policies, entry => {
    info: entry.info,
    off: entry.off || entry.info.count == 0 && entry.empty == "ignore",
    spacing: entry.info.single && entry.info.count <= entry.maxItems,
    shouldSpace: if entry.info.count == 0 then entry.empty == "always" else entry.spacing == "always",
    emptyWrap: entry.info.count == 0,
    ignoreEmptyWrap: !entry.info.empty_comments && entry.minItems == 0,
    shouldWrap: if entry.info.count == 0 then entry.info.empty_comments else if entry.info.node_single then entry.info.count > entry.maxItems else entry.info.count >= entry.minItems && entry.info.first_broken,
  })
  each entry in findings
  when !entry.off
  when if entry.spacing then entry.info.mode == "spacing" && entry.shouldSpace != entry.info.spaced
    else (if entry.emptyWrap then entry.info.mode == "empty_wrapping" && !entry.ignoreEmptyWrap else entry.info.mode == "wrapping") && entry.shouldWrap != entry.info.broken
  report at entry.info.offset
  warn (if entry.spacing then (if entry.shouldSpace then "Should have space between '" else "Should not have space(s) between '") else (if entry.shouldWrap then "Should have line break between '" else "Should not have line break(s) between '")) entry.info.prev "' and '" entry.info.next "'"
}

in ts_program rule max-statements-per-line {
  option max number = 1 "maximum statements on one line"
  option ignoredNodes string[] = [] "statement types excluded from counting"
  let events filter(statement_line_events, event => !contains(ignoredNodes, event.kind))
  let groups map(filter(events, current => default(last(filter(events, previous => previous.index < current.index)).line, 0) != current.line), current => {
    startIndex: current.index,
    endIndex: default(first(filter(events, next => next.index > current.index && next.line != current.line)).index, len(statement_line_events)),
    carried: if current.enter then 0 else 1,
  })
  let measurements map(groups, group => {
    carried: group.carried,
    entries: filter(events, event => event.enter && event.index >= group.startIndex && event.index < group.endIndex),
  })
  each info in measurements
  when count(info.entries) + info.carried > max
  report at first(slice(info.entries, max - info.carried)).offset
  warn "This line has {count(info.entries) + info.carried} statements. Maximum allowed is {max}."
}

in ts_program rule lines-around-comment {
  option beforeBlockComment boolean = true "blank line before block comments"
  option afterBlockComment boolean = false "blank line after block comments"
  option beforeLineComment boolean = false "blank line before line comments"
  option afterLineComment boolean = false "blank line after line comments"
  option afterHashbangComment boolean = false "blank line after hashbangs"
  option applyDefaultIgnorePatterns boolean = true "ignore directive comments"
  option ignorePattern string = "" "ignore matching comment bodies"
  option allowBlockStart boolean = false "allow comments at block starts"
  option allowBlockEnd boolean = false "allow comments at block ends"
  option allowClassStart boolean | null = null "override class start exceptions"
  option allowClassEnd boolean | null = null "override class end exceptions"
  option allowObjectStart boolean = false "allow comments at object starts"
  option allowObjectEnd boolean = false "allow comments at object ends"
  option allowArrayStart boolean = false "allow comments at array starts"
  option allowArrayEnd boolean = false "allow comments at array ends"
  option allowInterfaceStart boolean = false "allow comments at interface starts"
  option allowInterfaceEnd boolean = false "allow comments at interface ends"
  option allowTypeStart boolean = false "allow comments at type starts"
  option allowTypeEnd boolean = false "allow comments at type ends"
  option allowEnumStart boolean = false "allow comments at enum starts"
  option allowEnumEnd boolean = false "allow comments at enum ends"
  option allowModuleStart boolean = false "allow comments at module starts"
  option allowModuleEnd boolean = false "allow comments at module ends"
  let allowedStart compact([if allowClassStart == true then "Class" else null, if allowObjectStart then "Object" else null, if allowArrayStart then "Array" else null, if allowInterfaceStart then "Interface" else null, if allowTypeStart then "Type" else null, if allowEnumStart then "Enum" else null, if allowModuleStart then "Module" else null])
  let allowedEnd compact([if allowClassEnd == true then "Class" else null, if allowObjectEnd then "Object" else null, if allowArrayEnd then "Array" else null, if allowInterfaceEnd then "Interface" else null, if allowTypeEnd then "Type" else null, if allowEnumEnd then "Enum" else null, if allowModuleEnd then "Module" else null])
  each info in comment_gaps
  when !(applyDefaultIgnorePatterns && info.directive) && (ignorePattern == "" || !re_test(info.body, ignorePattern))
  when !any(map(info.targets, target => contains(if info.boundary == "before" then allowedStart else allowedEnd, target)))
  when !(contains(info.targets, "Block") && (if info.boundary == "before" then allowBlockStart else allowBlockEnd) && !(contains(info.targets, "Class") && (if info.boundary == "before" then allowClassStart else allowClassEnd) == false))
  when if info.boundary == "before" then (if info.block then beforeBlockComment else beforeLineComment)
    else (if info.hashbang then afterHashbangComment else if info.block then afterBlockComment else afterLineComment)
  report at info.offset
  warn if info.boundary == "before" then "Expected line before comment." else "Expected line after comment."
}

in ts_parenthesized let structure_unwrapped_end default(expression.structure_unwrapped_end, expression.end_offset)
in ts_parenthesized let structure_unwrapped_text default(expression.structure_unwrapped_text, expression.text)
in ts_parenthesized let structure_chain_info expression.structure_chain_info
in ts_parenthesized let structure_call_depth expression.structure_call_depth
in ts_call, ts_new let structure_call_depth default((callee.structure_chain_info).depth, 1)

@macro structure_chain_owner(kind, property_start, property_text, is_computed) {
  in kind let structure_chain_info {
    depth: 1 + default(object.structure_call_depth, 0),
    offset: (object.space_after).end,
    gap: byte_slice(source, default(object.structure_unwrapped_end, object.end_offset), property_start),
    property: property_text,
    computed: is_computed,
    optional: optional != null,
  }
}
@structure_chain_owner(ts_member, property.offset, default(property.structure_unwrapped_text, property.text), false)
@structure_chain_owner(ts_index, index.offset, default(index.structure_unwrapped_text, index.text), true)

in ts_call rule newline-per-chained-call {
  option ignoreChainWithDepth number = 2 "allow chains up to this depth"
  let info callee.structure_chain_info
  when info != null && info.depth > ignoreChainWithDepth && !re_test(info.gap, /[\n\r\u{2028}\u{2029}]/)
  report at info.offset
  let first_line default(re_find(info.property, /^[^\n\r\u{2028}\u{2029}]*/), "")
  let prefix if info.optional then (if info.computed then "?.[" else "?.") else (if info.computed then "[" else ".")
  let suffix if info.computed && len(first_line) == len(info.property) then "]" else ""
  let callee_name prefix first_line suffix
  warn "Expected line break before `{callee_name}`."
}

in ts_arrow.body rule implicit-arrow-linebreak {
  option mode "beside" | "below" = "beside"
  when layer != "ts_block"
  let broken re_test(parent_before, /=>[\s\S]*\n/)
  when mode == "beside" && broken || mode == "below" && !broken
  warn if mode == "beside" then "Expected no linebreak before this expression." else "Expected a linebreak before this expression."
}

in ts_arrow rule no-confusing-arrow {
  option allowParens boolean = true "parentheses disambiguate a conditional body"
  option onlyOneSimpleParam boolean = false "check only single identifier parameters"
  when body.layer is ts_conditional || !allowParens && body.layer is ts_parenthesized && body.structure_single_conditional
  when !onlyOneSimpleParam || count(parameter) == 1 && re_test(first(parameter), /^[A-Za-z_$][\w$]*$/)
  warn "Arrow function used ambiguously with a conditional expression."
}

in ts_if.consequent, ts_if.alternate, ts_while.body, ts_do_while.body, ts_for.body, ts_for_in.body, ts_for_of.body rule nonblock-statement-body-position {
  option mode "beside" | "below" | "any" = "beside"
  option overrides { if?: "beside" | "below" | "any"; else?: "beside" | "below" | "any"; while?: "beside" | "below" | "any"; do?: "beside" | "below" | "any"; for?: "beside" | "below" | "any" } = {} "position by statement"
  let kind if parent == "ts_if" then (if field == "alternate" then "else" else "if") else if parent == "ts_while" then "while" else if parent == "ts_do_while" then "do" else "for"
  let style default(if kind == "if" then overrides.if else if kind == "else" then overrides.else else if kind == "while" then overrides.while else if kind == "do" then overrides.do else overrides.for, mode)
  let broken re_test(parent_before, /\n[ \t]*$/)
  when layer != "ts_block" && !(kind == "else" && layer == "ts_if")
  when style != "any" && (style == "beside" && broken || style == "below" && !broken)
  warn if style == "beside" then "Expected no linebreak before this statement." else "Expected a linebreak before this statement."
}

}
