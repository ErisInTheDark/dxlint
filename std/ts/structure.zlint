# .ts/structure: @stylistic rules about the shape of code across lines:
# wrapping, comments' places, line lengths.

import .ts/parentheses
import .ts/structure/padding
import .ts/expression-fixes
import .ts/import-attributes
import .ts/precedence
import .ts/structure/declarations
import .ts/structure/lists
import .ts/structure/lines

define {

in ts_declarator let structure_destructure_left name.node
in ts_declarator let structure_destructure_right init.structure_unwrapped
in ts_declarator let structure_destructure_role "VariableDeclarator"
in ts_declarator let structure_destructure_eligible !contains(["using", "await using"], parent.kind)
in ts_declarator let structure_destructure_annotated type.node != null
in ts_assignment let structure_destructure_left left.structure_unwrapped
in ts_assignment let structure_destructure_right right.structure_unwrapped
in ts_assignment let structure_destructure_role "AssignmentExpression"
in ts_assignment let structure_destructure_eligible operator == "="
in ts_member, ts_index let structure_access_optional optional != null || object is (ts_member, ts_index) && object.structure_access_optional
in ts_member let structure_access_key property.node
in ts_index let structure_access_key index.structure_unwrapped

fn structure_destructure_enabled(settings, role, kind) =
  if settings == null then true
  else if settings.array != null || settings.object != null then get(settings, kind) == true
  else { value settings; get role; get kind } == true

fn structure_typescript(path) = re_test(path, /\.(?:ts|tsx|mts|cts)$/)

fn structure_iterable(n) = if n.structure_unwrapped is (ts_array, ts_string, ts_template) then true
  else structure_iterable_parts(n, value_parts(n))
fn structure_iterable_inventory(handle) = {
  value members: value_children(handle, true, [])
  value if members != null && all(members, edge => edge.member != null
    && contains(["str", "num"], type_of(edge.member.key))) then false else null
}
fn structure_iterable_parts(n, parts) = if parts == null then null else if len(parts) == 0 then false else {
  value arms: map(parts, arm => {
    value builtin: any(arm.parts, part => contains(part.traits, "string") || contains(part.traits, "tuple")
      || ts_value_array_part(part, n).array)
    value unresolved: any(arm.parts, part => contains(part.traits, "any") || contains(part.traits, "parameter"))
    value absent: any(arm.parts, part => any(["unknown", "null", "undefined", "void"], trait => contains(part.traits, trait)))
    value { builtin: builtin, unresolved: unresolved, absent: absent, handle: arm.handle }
  })
  value if all(arms, arm => arm.builtin) then true
    else structure_iterable_members(arms, value_lookup(n, { global: "Symbol", class: "value", path: ["iterator"] }))
}
fn structure_iterable_members(arms, lookup) = {
  value states: map(zip(arms, lookup.alternatives ?? map(arms, arm => null)), pair => {
    value arm: first(pair)
    value member: last(pair)
    value if arm.builtin || member.matched == true && any(member.sources, source => source.kind == "named") then true
      else if arm.unresolved then null
      else if arm.absent then false
      else if lookup == null then structure_iterable_inventory(arm.handle)
      else false
  })
  value if any(states, state => state == false) then false
    else if all(states, state => state == true) then true
    else null
}

in ts_declarator, ts_assignment rule prefer-destructuring {
  option options ({ array?: boolean; object?: boolean; VariableDeclarator?: { array?: boolean; object?: boolean }; AssignmentExpression?: { array?: boolean; object?: boolean }; enforceForRenamedProperties?: boolean; enforceForDeclarationWithTypeAnnotation?: boolean })[] = [] "destructuring categories, per declaration or assignment, renamed-property and annotated-declaration enforcement"
  when structure_destructure_eligible
  let typed structure_typescript(file)
  let enforcement { value options; slice 1; first }
  when !(typed && is ts_declarator && structure_destructure_annotated) || enforcement.enforceForDeclarationWithTypeAnnotation == true
  let settings first(options)
  let array_enabled structure_destructure_enabled(settings, structure_destructure_role, "array")
  let object_enabled structure_destructure_enabled(settings, structure_destructure_role, "object")
  let access structure_destructure_right
  when access is (ts_member, ts_index) && !access.structure_access_optional
  when access.object.structure_unwrapped not ts_super && access.structure_access_key not ts_private_name
  let key access.structure_access_key
  let value key.literal_value
  let array_index access is ts_index && key is ts_number && value.type == "number" && !contains(["Infinity", "-Infinity", "NaN"], value.value) && num(value.value) == { value value.value; num; round }
  let renamed enforcement.enforceForRenamedProperties == true
  when if array_index then array_enabled || typed && renamed && object_enabled else object_enabled
  when array_index || renamed || structure_destructure_left is ts_identifier && (access is ts_member && structure_destructure_left.text == key.text || access is ts_index && key is ts_string && structure_destructure_left.text == value.value)
  let iterable if typed && array_index then structure_iterable(access.object.node) else true
  when iterable != false || renamed
  let category if array_index && iterable != false then "array" else "object"
  when if category == "array" then array_enabled else object_enabled
  let receiver access.object.structure_unwrapped
  let fixable is ts_declarator && !structure_destructure_annotated && structure_destructure_left is ts_identifier && access is ts_member && structure_destructure_left.text == key.text
    && !{
      value overlapping(ts_comment)
      any (comment) comment.offset < receiver.offset || comment.end_offset > receiver.end_offset
    }
  warn "Use {category} destructuring."
  fix if fixable as "{{" key.text "}} = " expression_fix_wrap(receiver.text, receiver.precedence < 1)
}

fn structure_dot_keyword(name) = contains(["abstract", "boolean", "break", "byte", "case", "catch", "char", "class", "const", "continue", "debugger", "default", "delete", "do", "double", "else", "enum", "export", "extends", "false", "final", "finally", "float", "for", "function", "goto", "if", "implements", "import", "in", "instanceof", "int", "interface", "long", "native", "new", "null", "package", "private", "protected", "public", "return", "short", "static", "super", "switch", "synchronized", "this", "throw", "throws", "transient", "true", "try", "typeof", "var", "void", "volatile", "while", "with"], name)
fn structure_property_info(subject, key) = {
  value arms: filter(value_parts(subject) ?? [], arm => !all(arm.parts, part =>
    contains(part.traits, "null") || contains(part.traits, "undefined")))
  value lookups: map(arms, arm => value_lookup(arm.handle, key))
  value declared: count(lookups) > 0 && all(lookups, lookup => lookup != null
    && count(lookup.alternatives) > 0 && all(lookup.alternatives, alternative =>
      any(alternative.sources, source => source.kind == "named")))
  value sources: if declared then flat_map(lookups, lookup =>
    flat_map(lookup.alternatives, alternative => filter(alternative.sources, source => source.kind == "named"))) else []
  value flags: first(sources).flags
  value {
    declared: declared,
    named: any(lookups, lookup => any(lookup.alternatives, alternative =>
      any(alternative.sources, source => source.kind == "named"))),
    visibility: if !declared then null else if contains(flags, "private_access") then "private"
      else if contains(flags, "protected_access") then "protected" else "public",
  }
}

@macro structure_dot_options {
  option allowKeywords boolean = true "allow ES3 keywords in dot notation"
  option allowPattern string = "" "property names exempt from dot notation"
  option allowPrivateClassPropertyAccess boolean = false "allow bracket access to private properties"
  option allowProtectedClassPropertyAccess boolean = false "allow bracket access to protected properties"
  option allowIndexSignaturePropertyAccess boolean = false "allow bracket access through string-like index signatures"
}

in ts_index rule dot-notation:computed {
  @structure_dot_options
  let key index.structure_unwrapped
  let literal key.literal_value
  let template key is ts_template && count(key.expression) == 0
  when key is (ts_string, ts_boolean, ts_null) || template
  let name if template then key.static_name else literal.value
  when re_test(name, /^[a-zA-Z_$][a-zA-Z0-9_$]*$/) && (allowKeywords || !structure_dot_keyword(name))
  when allowPattern == "" || !re_test(name, allowPattern)
  let allow_index allowIndexSignaturePropertyAccess || structure_typescript(file) && ts_compiler_option(node, "noPropertyAccessFromIndexSignature") == true
  let property if allowPrivateClassPropertyAccess || allowProtectedClassPropertyAccess || allow_index
    then structure_property_info(object.node, name) else null
  when !(allowPrivateClassPropertyAccess && property.visibility == "private" || allowProtectedClassPropertyAccess && property.visibility == "protected")
  when !allow_index || property.named == true || ts_value_has_trait(object.node, "unknown") == true
    || ts_value_has_trait(object.node, "any") == true || value_has_member(object.node, name, null) == false
  let open index.space_before.start - 1
  let fixable { value overlapping(ts_comment, open, end_offset); count } == 0
  let receiver object.structure_unwrapped
  let separator if optional != null then "" else if receiver is ts_number && re_test(receiver.text, /^(?:0|0[0-7]*[89]\d*|[1-9](?:_?\d)*)$/) then " ." else "."
  let trailing if space_after.text == "" && next_token is (ts_identifier, ts_keyword, ts_number, ts_boolean, ts_null) then " " else ""
  let quoted if template then "`" name "`" else if literal.type == "string" then "\"" name "\"" else name
  report at key
  warn "[{quoted}] is better written in dot notation."
  fix at { start: open, end: end_offset } if fixable as separator name trailing
}

in ts_member rule dot-notation:keyword {
  @structure_dot_options
  when !allowKeywords && structure_dot_keyword(property.text)
  let dot property.space_before.start - 1
  let fixable !(object is ts_identifier && object.text == "let" && optional == null) && { value overlapping(ts_comment, dot, property.offset); count } == 0
  report at property.node
  warn ".{property} is a syntax error."
  fix at { start: dot, end: end_offset } if fixable as (if optional != null then "." else "") "[\"" property "\"]"
}

in ts_conditional let structure_ternary_jsx if parent is ts_conditional then parent.structure_ternary_jsx else parent is ts_jsx_expression
in ts_binary, ts_logical let structure_operator operator
in ts_conditional let structure_operator "?:"
in ts_binary, ts_logical let structure_operator_offset operator.offset
in ts_conditional let structure_operator_offset (test.space_after).end
in ts_conditional let structure_test_offset test.offset
in ts_conditional let structure_consequent_offset consequent.offset
in ts_variable_declaration let structure_loop_declaration parent is (ts_for, ts_for_in, ts_for_of)
in ts_union, ts_intersection let structure_first_type_offset first(type.offset)
in ts_type_alias let structure_start offset
in ts_unary let structure_typeof operator == "typeof"
in ts_parenthesized let structure_typeof expression.structure_typeof.nonempty ?? false
in ts_parenthesized let structure_single_conditional expression is ts_conditional || expression is ts_parenthesized && expression.structure_single_conditional

@macro structure_mixed_operator_rule(name, position) {
  in ts_binary, ts_logical rule name {
    option groups string[][] = [["+", "-", "*", "/", "%", "**"], ["&", "|", "^", "~", "<<", ">>", ">>>"], ["==", "!=", "===", "!==", ">", ">=", "<", "<="], ["&&", "||"], ["in", "instanceof"]] "operator groups requiring parentheses"
    option allowSamePrecedence boolean = true "allow mixtures with equal precedence"
    when parent is (ts_binary, ts_logical, ts_conditional)
    let child_operator structure_operator
    let outer_operator parent.structure_operator
    when child_operator != outer_operator
    when !allowSamePrecedence || precedence != parent.precedence
    when any(groups, operators => contains(operators, child_operator) && contains(operators, outer_operator))
    let child_first is (ts_node.left, ts_node.test)
    let left_operator if child_first then child_operator else outer_operator
    let right_operator if child_first then outer_operator else child_operator
    report at position
    warn "Unexpected mix of '{left_operator}' and '{right_operator}'. Use parentheses to clarify the intended order of operations."
  }
}

@structure_mixed_operator_rule(no-mixed-operators:child, structure_operator_offset)
@structure_mixed_operator_rule(no-mixed-operators:parent, parent.structure_operator_offset)

fn structure_declaration_issue(message, fix) = if message == null then null else { message: message, fix: fix }
fn structure_fix_edits(source, edits) = if count(edits) == 0 then null else {
  value start: first(edits).start
  value end: last(edits).end
  value region: byte_slice(source, start, end)
  value { start: start, end: end, text: expression_fix_edits(region, start, edits) }
}
fn structure_declaration_join(n, source) = {
  value before: ts_token_neighbours(source, n.kind.node).before
  value first: ts_token_record(token(n.kind.node, "first"))
  value last: ts_token_record(token(n.kind.node, "last"))
  value edits: [
    { start: if before.text == ";" then before.start else before.end, end: before.end, text: "," },
    { start: first.start, end: first.end, text: "" },
    if first.start != last.start then { start: last.start, end: last.end, text: "" } else null,
  ]
  value edits
  compact
  ordered: sort_by (edit) edit.start
  value structure_fix_edits(source, ordered)
}
fn structure_declaration_split_edit(declarator, source, kind, exported) = {
  value comma: declarator.token_neighbours.after
  value next: declarator.next.offset
  value comments: overlapping(ts_comment, comma.end, next)
  value after: first(comments).offset ?? next
  value prefix: (if exported then "export " else "") kind
  value separated: position(after).js_line > position(comma.end).js_line || count(comments) > 0
  value {
    start: comma.start,
    end: if after != comma.end && separated then next else comma.end,
    text: if after == comma.end then "; " prefix " "
      else if separated then ";" byte_slice(source, comma.end, next) prefix " "
      else "; " prefix,
  }
}
fn structure_declaration_split(declarations, kind, exported, source) = {
  value declarations
  filter (declarator) declarator.token_neighbours.after.text == ","
  edits: map (declarator) structure_declaration_split_edit(declarator, source, kind, exported)
  value structure_fix_edits(source, edits)
}

fn structure_declaration_findings(info, settings, source) = {
  value kind: info.kind
  value common: if type_of(settings) == "str" then settings else if kind == "var" then settings.var else if kind == "let" then settings.let else if kind == "const" then settings.const else if kind == "using" then settings.using else settings.awaitUsing
  value init_mode: settings.initialized.nonempty ?? common
  value uninit_mode: settings.uninitialized.nonempty ?? common
  value counts: info.counts
  value total: counts.initialized + counts.uninitialized
  value prior_counts: info.prior
  value prior_init: prior_counts.initialized > 0 && (!settings.separateRequires || prior_counts.initialized > prior_counts.requires)
  value prior_uninit: prior_counts.uninitialized > 0
  value prior_required: settings.separateRequires && prior_counts.requires > 0
  value both_always: init_mode == "always" && uninit_mode == "always"
  value always_failed: both_always && (prior_init || prior_uninit) && counts.requires == 0 || uninit_mode == "always" && counts.uninitialized > 0 && prior_uninit || init_mode == "always" && counts.initialized > 0 && prior_init && counts.requires == 0 || prior_required && counts.requires > 0
  value joining: always_failed && (both_always || init_mode == "always" && counts.initialized > 0
    || uninit_mode == "always" && counts.uninitialized > 0 && !info.for_binding)
  value previous_counts: if init_mode == "consecutive" || uninit_mode == "consecutive" || joining
    then structure_declaration_previous(info.node) else null
  value consecutive: previous_counts != null && !((counts.requires + previous_counts.requires > 0) && (total + previous_counts.initialized + previous_counts.uninitialized > counts.requires + previous_counts.requires))
  value consecutive_message: if !consecutive then null else if init_mode == "consecutive" && uninit_mode == "consecutive" then "Combine this with the previous '" kind "' statement." else if init_mode == "consecutive" && counts.initialized > 0 && previous_counts.initialized > 0 then "Combine this with the previous '" kind "' statement with initialized variables." else if uninit_mode == "consecutive" && counts.uninitialized > 0 && previous_counts.uninitialized > 0 then "Combine this with the previous '" kind "' statement with uninitialized variables." else null
  value split_message: if total < 2 || info.for_init then null else if init_mode == "never" && uninit_mode == "never" then "Split '" kind "' declarations into multiple statements." else if init_mode == "never" && counts.initialized > 0 then "Split initialized '" kind "' declarations into multiple statements." else if uninit_mode == "never" && counts.uninitialized > 0 then "Split uninitialized '" kind "' declarations into multiple statements." else null
  value join_fix: if previous_counts != null && (consecutive_message != null || joining)
    then structure_declaration_join(info.node, source) else null
  value split_parent: if info.node.parent is ts_export then info.node.parent.parent.node else info.node.parent.node
  value declaration_exported: info.node.parent is ts_export
  value split_fix: if split_message != null && split_parent is (ts_program, ts_block, ts_case, ts_static_block) then structure_declaration_split(info.node.declaration.nodes, kind, declaration_exported, source) else null
  value issues: compact([
    if init_mode == "always" && settings.separateRequires && counts.requires > 0 && counts.requires < total then { message: "Split requires to be separated into a single block.", fix: null } else null,
    structure_declaration_issue(consecutive_message, join_fix),
    if always_failed && both_always then { message: "Combine this with the previous '" kind "' statement.", fix: join_fix } else null,
    if always_failed && !both_always && init_mode == "always" && counts.initialized > 0 then { message: "Combine this with the previous '" kind "' statement with initialized variables.", fix: join_fix } else null,
    if always_failed && !both_always && uninit_mode == "always" && counts.uninitialized > 0 && !info.for_binding then { message: "Combine this with the previous '" kind "' statement with uninitialized variables.", fix: join_fix } else null,
    structure_declaration_issue(split_message, split_fix)
  ])
  value map(issues, issue => {node: info.node, message: issue.message, fix: issue.fix})
}

in structure_lexical_scope, ts_variable_declaration rule one-var {
  option options ("always" | "never" | "consecutive" | { separateRequires?: boolean; var?: "always" | "never" | "consecutive"; let?: "always" | "never" | "consecutive"; const?: "always" | "never" | "consecutive"; using?: "always" | "never" | "consecutive"; awaitUsing?: "always" | "never" | "consecutive"; initialized?: "always" | "never" | "consecutive"; uninitialized?: "always" | "never" | "consecutive" })[] = [] "declaration grouping policy"
  let settings { value options; first; nonempty } ?? "always"
  let scoped if type_of(settings) == "str" then settings == "always"
    else settings.separateRequires || contains([settings.var, settings.let, settings.const, settings.using, settings.awaitUsing, settings.initialized, settings.uninitialized], "always")
  when if scoped then is structure_lexical_scope
    else is ts_variable_declaration && (settings != "never" || count(node.declaration.nodes) > 1)
  let entries if scoped then structure_declaration_entries
    else [structure_declaration_entry(node, structure_declaration_counts(node), {initialized: 0, uninitialized: 0, requires: 0})]
  each issue in flat_map(entries, info => structure_declaration_findings(info, settings, source)) {
    report at issue.node
    fix at issue.fix if issue.fix != null as issue.fix.text
    warn "{issue.message}"
  }
}

group structure_template ts_template, ts_template_type
group structure_literal ts_string, ts_regex
in ts_comment let structure_comment_span if parent is ts_jsx_expression && parent.expression == null && !re_test(parent.text, /[\n\r\u{2028}\u{2029}]/) then { start: parent.offset, end: parent.end_offset } else { start: offset, end: end_offset }
in ts_line let structure_line_content re_replace(text, /(?:\r\n|[\n\r\u{2028}\u{2029}])$/, "")
in ts_line let structure_line_end offset + byte_len(structure_line_content)
in ts_line let structure_line_comments { value overlapping(ts_comment); map (comment) comment.structure_comment_span }
in ts_line let structure_last_comment last(structure_line_comments)
in ts_line let structure_full_comment structure_last_comment != null && structure_last_comment.end >= structure_line_end
  && (structure_last_comment.start <= offset || { value structure_line_content; byte_slice 0 (structure_last_comment.start - offset); trim } == "")
in ts_line let structure_line_template {
  value overlapping(structure_template)
  any (template) any(template.quasi.node, quasi => quasi.offset <= structure_line_end && quasi.end_offset >= offset)
}

fn expanded_line_length(parts, extra, width) = (if width == 0 then sum(parts) else {
  value result: len(parts) - 1
  value slice(parts, 0, result)
  map (part) part - part % width + width
  sum
} + last(parts)) - extra
fn structure_strip_comments(content, start, comments) = {
  value comments
  reversed: reverse
  value initial_end: byte_len(content)
  value reversed
  end: fold initial_end (end, comment) if comment.start >= start && comment.start <= start + end && comment.end >= start + end
  then {
    value content
    byte_slice 0 (comment.start - start)
    trim_end
    byte_len
  } else end
  value byte_slice(content, 0, end)
}

in ts_line rule max-len {
  option options (number | { code?: number; comments?: number; tabWidth?: number; ignorePattern?: string; ignoreComments?: boolean; ignoreStrings?: boolean; ignoreUrls?: boolean; ignoreTemplateLiterals?: boolean; ignoreRegExpLiterals?: boolean; ignoreTrailingComments?: boolean })[] = [] "line limits, tab stops and exemptions"
  let settings last(options)
  let code_limit if { value options; first; type_of } == "num" then first(options) else settings.code.nonempty ?? 80
  let second { value options; slice 1; first }
  let tab_width if type_of(second) == "num" then second else settings.tabWidth.nonempty ?? 4
  let comment_limit settings.comments.nonempty ?? 0
  let strip_comments settings.ignoreTrailingComments || settings.ignoreComments
  when !settings.ignoreComments || !structure_full_comment
  when !settings.ignoreStrings || { value overlapping(ts_string); count } == 0
  when !settings.ignoreTemplateLiterals || !structure_line_template
  when !settings.ignoreRegExpLiterals || { value overlapping(ts_regex); count } == 0
  let measured if strip_comments && !structure_full_comment then structure_strip_comments(structure_line_content, offset, structure_line_comments) else structure_line_content
  when !settings.ignoreUrls || !re_test(measured, /[^:/?#]:\/\/[^?#]/)
  when !settings.ignorePattern || !re_test(measured, settings.ignorePattern)
  let parts { value measured; split "\t"; map (part) utf16_len(part) }
  let length if !contains(measured, "\t") then len(measured) else { value extra: utf16_len(measured) - len(measured); value expanded_line_length(parts, extra, tab_width) }
  let comment_applies comment_limit > 0 && structure_full_comment
  let limit if comment_applies then comment_limit else code_limit
  when length > limit
  report at { start: offset, end: offset + byte_len(measured) }
  warn if comment_applies then "This line has a comment length of {length}. Maximum allowed is {limit}." else "This line has a length of {length}. Maximum allowed is {limit}."
}

fn structure_is_directive(body) = re_test(body, /^(?:eslint|jscs|\/ <reference|\/ <amd-)/)
  || re_test(body, /^(?:@ts-expect-error|@ts-ignore|@ts-nocheck|@ts-check|prettier-ignore)(?:[^\p{Alphabetic}\p{Number}_-]|$)/)
  || re_test(body, /^(?:jshint|jslint|istanbul|global|globals|exported)\s/)
  || re_test(body, /^(?:v8|c8)\s+ignore(?:[^\p{Alphabetic}\p{Number}_-]|$)/)
  || re_test(body, /^node:coverage\s+(?:(?:disable|enable)(?:[^\p{Alphabetic}\p{Number}_-]|$)|ignore\s+next(?:[^\p{Alphabetic}\p{Number}_-]|$))/)
  || re_test(body, /^webpack(?:ChunkName|FetchPriority|Mode|Exports|Include|Exclude|Prefetch|Preload|Ignore)\s*:/)

in ts_program layer text match structure_hashbang /\A#![^\n\r\u{2028}\u{2029}]*/
group structure_comment ts_comment, structure_hashbang
in structure_comment let structure_comment_body if is ts_block_comment then { value result: len(text) - 2; value slice(text, 2, result) } else slice(text, 2)
in structure_comment let structure_directive { value structure_comment_body; trim_start; structure_is_directive }
in ts_comment let structure_comment_beside { value js_line_start: position(offset).js_line_start; value byte_slice(source, js_line_start, offset); trim } != ""

in ts_line_comment rule line-comment-position {
  option options ("above" | "beside" | { position?: "above" | "beside"; ignorePattern?: string; applyDefaultIgnorePatterns?: boolean })[] = [] "line comment position and exemptions"
  let settings first(options)
  let position if type_of(settings) == "str" then settings else settings.position.nonempty ?? "above"
  let ignore_pattern settings.ignorePattern.nonempty ?? ""
  let ignore_default settings.applyDefaultIgnorePatterns.nonempty ?? true
  when !ignore_default || !structure_directive && !re_test(structure_comment_body, /^\s*falls?\s?through/)
  when ignore_pattern == "" || !re_test(structure_comment_body, ignore_pattern)
  when position == "above" && structure_comment_beside || position == "beside" && !structure_comment_beside
  warn if position == "above" then "Expected comment to be above code." else "Expected comment to be beside code."
}

@macro structure_comment_style_options {
  option mode "starred-block" | "bare-block" | "separate-lines" = "starred-block"
  option checkJSDoc boolean = false "check JSDoc when requiring line comments"
  option checkExclamation boolean = false "check exclamation comments when requiring line comments"
}
in ts_comment let structure_style_eligible !structure_directive && !structure_comment_beside
in ts_block_comment let structure_multiline structure_first_row.offset != structure_last_row.offset
in ts_block_comment let structure_block_first byte_slice(source, offset + 2, structure_first_row.structure_line_end)
in ts_block_comment let structure_block_last byte_slice(source, structure_last_row.offset, end_offset - 2)
in ts_block_comment let structure_block_middle {
  value overlapping(ts_line)
  filter (row) row.offset > structure_first_row.offset && row.offset < structure_last_row.offset
}
in ts_block_comment let structure_block_padded all(structure_block_middle, row => re_test(row.structure_line_content, /^\s/) && contains(row.structure_line_content, " "))
in ts_block_comment let structure_block_jsdoc starts_with(structure_block_first, "*") && { value structure_block_first; slice 1; trim } == "" && structure_block_padded && trim(structure_block_last) == ""
in ts_block_comment let structure_block_exclamation starts_with(structure_block_first, "!") && { value structure_block_first; slice 1; trim } == "" && structure_block_padded && trim(structure_block_last) == ""

fn structure_comment_indent(n, source) = byte_slice(source, n.structure_first_row.offset, n.offset)
fn structure_comment_split(body) = { value body; re_replace /\r\n|[\n\r\u{2028}\u{2029}]/ "\n"; split "\n" }
fn structure_comment_starred(lines) = { value lines; first; trim } == "" && { value lines; last; trim } == ""
  && { value lines; slice 1 -1; all (line) re_test(line, /^\s*\*/) }
fn structure_comment_starred_lines(lines) = {
  value lines
  slice 1 -1
  rows: map (line) re_replace(line, /^\s*$/, "")
  value padded: all(rows, line => { value line; re_replace /^\s*\*/ ""; then (body) trim(body) == "" || starts_with(body, " ") })
  value rows
  map (line) if padded then re_replace(line, /^\s*\* ?/, "") else re_replace(line, /^\s*\*/, "")
}
fn structure_comment_bare_line(line) = {
  value content: if trim(line) == "" then "" else line
  value { prefix: re_find(content, /^\s*\*?\s*/), content: re_replace(content, /^\s*\*?\s*/, "") }
}
fn structure_comment_bare_lines(lines, indent) = {
  value lines
  rows: map (line) structure_comment_bare_line(line)
  value width: len(indent) + 3
  value rows
  slice 1
  filter (row) row.content != ""
  map (row) width - len(row.prefix)
  widest: max
  value adjustment: max(widest, 0)
  value rows
  map (row) if len(row.prefix) > width then {
    value begin: width - adjustment - len(row.prefix)
    value slice(row.prefix, begin) row.content
  } else row.content
}
fn structure_comment_block_lines(n, indent) = {
  value lines: structure_comment_split(n.structure_comment_body)
  value if structure_comment_starred(lines) then structure_comment_starred_lines(lines) else structure_comment_bare_lines(lines, indent)
}
fn structure_comment_group_lines(group) = {
  value group
  lines: map (comment) comment.structure_comment_body
  value padded: all(lines, line => trim(line) == "" || starts_with(line, " "))
  value lines
  map (line) if padded then re_replace(line, /^ /, "") else line
}
fn structure_comment_format(lines, indent, mode) = {
  value separator: "\n" indent (if mode == "bare-block" then "   " else "")
  value if mode == "starred-block" then {
    value lines
    map (line) indent " * " line
    body: join "\n"
    value "/*\n" body "\n" indent " */"
  } else if mode == "bare-block" then "/* " join(lines, separator) " */"
  else { value lines; map (line) "// " line; join separator }
}
in ts_block_comment let structure_style_reference {
  value comment: node
  value overlapping(ts_line)
  filter (line) { value if line.offset == comment.structure_first_row.offset then comment.structure_block_first else if line.offset == comment.structure_last_row.offset then comment.structure_block_last else line.structure_line_content; trim } != ""
  first
}
fn structure_comment_alignment(row, comment, source) = {
  value reference: comment.structure_style_reference
  value starred: re_test(row.structure_line_content, /^\s*\*/)
  value leading: re_find(row.structure_line_content, /^\s*\*?/)
  value original_prefix: re_find(reference.structure_line_content, /^\s*(?:\/?\*)?\s*/)
  value padding: if contains(original_prefix, "*") then re_replace(original_prefix, /^\s*\/?\*/, "") else ""
  value prefix_size: len(original_prefix)
  value extra: slice(leading, prefix_size)
  value missing: (if trim(row.structure_line_content) != "" && !re_test(reference.structure_line_content, /^\s*\/?\*\s/) then " " else "") extra padding
  value prefix: structure_comment_indent(comment, source) " *"
  value { start: row.offset, end: row.offset + byte_len(leading), text: prefix (if starred then "" else missing) }
}

in ts_block_comment rule multiline-comment-style:shape {
  @structure_comment_style_options
  when structure_style_eligible && structure_multiline
  when if mode == "bare-block" then trim(structure_block_first) == "" && trim(structure_block_last) == ""
    && all(structure_block_middle, row => { value row.structure_line_content; trim_start; starts_with "*" })
    && !structure_block_jsdoc && !structure_block_exclamation
    else mode == "separate-lines"
      && { value source; byte_slice end_offset structure_last_row.structure_line_end; trim } == ""
      && (checkJSDoc || !structure_block_jsdoc) && (checkExclamation || !structure_block_exclamation)
  let style_indent structure_comment_indent(node, source)
  let style_lines structure_comment_block_lines(node, style_indent)
  let converted_lines if mode == "separate-lines" && (structure_block_jsdoc || structure_block_exclamation) then { value style_lines; slice 1 -1 } else style_lines
  fix as structure_comment_format(converted_lines, style_indent, mode)
  warn if mode == "bare-block" then "Expected a block comment without padding stars." else "Expected multiple line comments instead of a block comment."
}

in ts_block_comment rule multiline-comment-style:open {
  @structure_comment_style_options
  when mode == "starred-block" && structure_style_eligible && structure_multiline
  when {
    value if starts_with(structure_block_first, "*") || starts_with(structure_block_first, "!") then slice(structure_block_first, 1) else structure_block_first
    trim
  } != ""
  let style_indent structure_comment_indent(node, source)
  let opening_body if starts_with(structure_block_first, "*") || starts_with(structure_block_first, "!") then slice(structure_block_first, 1) else structure_block_first
  let opening_space re_find(opening_body, /^\s*/)
  let opening_end offset + (if opening_body != structure_block_first then 3 else 2)
  fix at { start: opening_end, end: opening_end } as "\n" style_indent " *" (if opening_space == "" then " " else "")
  report at offset
  warn "Expected a linebreak after '/*'."
}

in ts_block_comment rule multiline-comment-style:close {
  @structure_comment_style_options
  when mode == "starred-block" && structure_style_eligible && structure_multiline && trim(structure_block_last) != ""
  let style_indent structure_comment_indent(node, source)
  fix at { start: end_offset - 2, end: end_offset } as "\n" style_indent " */"
  report at { start: end_offset - 2, end: end_offset }
  warn "Expected a linebreak before '*/'."
}

in ts_line rule multiline-comment-style:alignment {
  @structure_comment_style_options
  when mode == "starred-block"
  let comment {
    value overlapping(ts_block_comment)
    filter (comment) comment.structure_style_eligible && comment.offset < offset
    first
  }
  when comment != null
  let prefix byte_slice(source, comment.structure_first_row.offset, comment.offset) " *"
  when !starts_with(text, prefix)
  let alignment_fix structure_comment_alignment(node, comment, source)
  fix at alignment_fix as alignment_fix.text
  report at offset
  warn if { value text; trim_start; starts_with "*" } then "Expected this line to be aligned with the start of the comment." else "Expected a '*' at the start of this line."
}

fn structure_line_comments_join(source, previous, next) = previous != null && next != null
  && previous is ts_line_comment && next is ts_line_comment
  && previous.structure_style_eligible && next.structure_style_eligible && previous.end_offset <= next.offset
  && position(next.offset).js_line == position(previous.end_offset).js_line + 1
  && { value source; byte_slice previous.end_offset next.offset; trim } == ""
in ts_line_comment let structure_previous_comment last(structure_previous_row.structure_row_comments)
in ts_line_comment let structure_next_comment first(structure_next_row.structure_row_comments)
in ts_line_comment let structure_joins_previous structure_line_comments_join(source, structure_previous_comment, node)
in ts_line_comment let structure_joins_next structure_line_comments_join(source, node, structure_next_comment)
in ts_line_comment let structure_group_unsafe contains(structure_comment_body, "*/")
  || {
    value if structure_joins_next then structure_next_comment.node else null
    walk (comment) if comment.structure_joins_next then comment.structure_next_comment.node else null
    any (comment) contains(comment.structure_comment_body, "*/")
  }
in ts_line_comment rule multiline-comment-style:consecutive {
  @structure_comment_style_options
  when mode != "separate-lines" && structure_style_eligible && !structure_joins_previous && structure_joins_next && !structure_group_unsafe
  let style_group { value node; walk (comment) if comment.structure_joins_next then comment.structure_next_comment.node else null }
  let style_lines structure_comment_group_lines(style_group)
  let style_indent structure_comment_indent(node, source)
  let style_end last(style_group).end_offset
  fix at { start: offset, end: style_end } if mode != "starred-block" || !any(style_lines, line => starts_with(line, "/")) as structure_comment_format(style_lines, style_indent, mode)
  warn "Expected a block comment instead of consecutive line comments."
}

in ts_question, ts_colon rule multiline-ternary {
  option mode "always" | "always-multiline" | "never" = "always"
  option ignoreJSX boolean = false "ignore conditionals in JSX expressions"
  when parent is ts_conditional
  when !ignoreJSX || !parent.structure_ternary_jsx
  when mode != "always-multiline" || re_test(parent_text, /[\n\r\u{2028}\u{2029}]/)
  let broken space_before.line_break || space_after.line_break
  when mode == "never" && broken || mode != "never" && !broken
  let operands if text == "?" then "test and consequent" else "consequent and alternate"
  let ternary_edits {
    value [
      if mode != "never" || space_before.line_break then { start: space_before.start, end: offset, text: if mode == "never" then "" else "\n" } else null,
      if mode == "never" && space_after.line_break then { start: end_offset, end: space_after.end, text: "" } else null,
    ]
    compact
  }
  let ternary_fix structure_fix_edits(source, ternary_edits)
  fix at ternary_fix if expression_fix_clean(parent.node) as ternary_fix.text
  report at if text == "?" then parent.structure_test_offset else parent.structure_consequent_offset
  warn if mode == "never" then "Unexpected newline between {operands} of ternary expression." else "Expected newline between {operands} of ternary expression."
}

in ts_line match structure_tab_run /\t+/
in structure_tab_run rule no-tabs {
  option allowIndentationTabs boolean = false "allow tabs at the start of a line"
  when !allowIndentationTabs || !{ value parent.text; byte_slice 0 (offset - parent.offset); re_test /^[ \t]*$/ }
  warn "Unexpected tab character."
}

in ts_line rule no-mixed-spaces-and-tabs {
  option mode "default" | "smart-tabs" = "default"
  when re_test(text, /^(?: +\t|\t+ )/)
  let indentation re_find(structure_line_content, /^[ \t]+/)
  let smart_prefix re_find(indentation, /^[ \t]*? \t/)
  when mode != "smart-tabs" || smart_prefix != null
  let boundary offset + (if mode == "smart-tabs" then len(smart_prefix) - 2 else { value indentation; re_find /^(?: +|\t+)/; len } - 1)
  when !{ value overlapping(ts_comment); any (comment) comment.offset < offset && offset < comment.end_offset }
  when !{ value overlapping(structure_literal); any (literal) literal.offset < offset && boundary < literal.end_offset }
  when !{
    value overlapping(structure_template)
    any (template) any(template.quasi.node, quasi => quasi.offset < offset && boundary < quasi.end_offset)
  }
  report at boundary
  warn "Mixed spaces and tabs."
}

in ts_program rule unicode-bom {
  option mode "always" | "never" = "never"
  when mode == "always" && !bom || mode == "never" && bom
  fix at { start: 0, end: if mode == "never" then 3 else 0 } as if mode == "always" then "\u{feff}" else ""
  report at 0
  warn if mode == "always" then "Expected Unicode BOM (Byte Order Mark)." else "Unexpected Unicode BOM (Byte Order Mark)."
}

in ts_regex rule wrap-regex {
  when is (ts_member.object, ts_index.object)
  fix as "(" text ")"
  warn "Wrap the regexp literal in parens to disambiguate the slash."
}

in ts_declarator rule one-var-declaration-per-line {
  option mode "initializations" | "always" = "initializations"
  when previous_sibling != null && !re_test(previous_gap, /[\n\r\u{2028}\u{2029}]/)
  when !parent.structure_loop_declaration
  when mode == "always" || init != null || previous.init != null
  fix at { start: offset, end: offset } as "\n"
  warn "Expected variable declaration to be on a new line."
}

in ts_binary rule eqeqeq {
  option options ("always" | "smart" | "allow-null" | { null: "always" | "never" | "ignore" })[] = [] "equality mode and null policy"
  let mode { value options; first; nonempty } ?? "always"
  let null_mode { value last(options).null; nonempty } ?? "always"
  let left_literal left.literal_value
  let right_literal right.literal_value
  let null_check left_literal.type == "null" || right_literal.type == "null"
  let same_literal_type left_literal != null && right_literal != null && left_literal.type == right_literal.type
  let left_typeof left.structure_typeof.nonempty ?? false
  let right_typeof right.structure_typeof.nonempty ?? false
  let loose operator == "==" || operator == "!="
  let strict_null (operator == "===" || operator == "!==") && null_check && mode == "always" && null_mode == "never"
  when strict_null || loose && (!null_check || mode == "always" && null_mode == "always") && (mode != "smart" || !(same_literal_type || left_typeof || right_typeof))
  let expected if strict_null then { value result: len(operator) - 1; value slice(operator, 0, result) } else operator "="
  let fixable same_literal_type && left_literal.type != "regex" || loose && (left_typeof && right_literal.type == "string" || right_typeof && left_literal.type == "string")
  let operator_span { start: operator.offset, end: operator.end_offset }
  report at operator_span
  warn "Expected '{expected}' and instead saw '{operator}'."
  fix at operator_span if fixable as expected
}

fn operand_cached_indent(records, row, fallback) = { value records; filter (prior) prior.right_line == row; last }.expected ?? fallback
fn operand_assignment(token) = contains(["=", "+=", "-=", "*=", "/=", "%=", "**=", "<<=", ">>=", ">>>=", "|=", "^=", "&=", "&&=", "||=", "??="], token)
fn operand_add(info) =
  contains(["break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do", "else", "export", "extends", "finally", "for", "function", "if", "import", "in", "let", "new", "return", "super", "switch", "throw", "try", "var", "void", "while", "with"], info.first)
  || info.type_keyword || contains([":", "[", "(", "<"], info.last) || operand_assignment(info.last)
  || contains(["[", "(", "{{", "=>", ":"], info.before) || operand_assignment(info.before)

in ts_program rule indent-binary-ops {
  option mode number | "tab" = 2 "indent width or tabs"
  let width if mode == "tab" then 1 else mode
  let unit if mode == "tab" then "\t" else " "
  let measurements {
    value binary_operand_indents
    sort_by (info) info.right_line
    fold ([]) (state, info) {
      value closes_more: info.last == ")" && info.parens < 0
      value chain: closes_more && contains([".", "?."], info.first)
      value add: operand_add(info)
      value subtract: closes_more && !contains(["]", ")", "}}"], info.first) && !chain
      value left: if chain then operand_cached_indent(state, info.root_line, info.root) else operand_cached_indent(state, info.left_line, info.left)
      value state [{
        offset: info.offset,
        end: info.offset + byte_len(info.right),
        right_line: info.right_line,
        actual: operand_cached_indent(state, info.right_line, info.right),
        expected: if add && !subtract then left repeat(unit, width) else if subtract && !add then { value left; slice width } else left,
      }]
    }
  }
  each info in measurements {
    when info.actual != info.expected
    report at info.offset
    fix at { start: info.offset, end: info.end } as info.expected
    warn "Expected indentation of " len(info.expected) " " (if mode == "tab" then "tab" else "space") (if len(info.expected) == 1 then "" else "s")
  }
}

fn structure_operator_gap(gap, keep) = if keep || trim(gap) != "" then gap else re_replace(gap, /\r\n|[\n\r\u{2028}\u{2029}]/, "")
fn structure_operator_fix(before, after, next, policy, operator, before_comment, after_comment) =
  if before.line_break != after.line_break && policy != "none" && before.comments && after.comments then null
  else {
    value start: if policy == "after" && before_comment is ts_block_comment then before_comment.end_offset else before.start
    value end: if policy == "before" && after_comment is ts_block_comment then after_comment.offset else after.end
    value before_text: byte_slice(before.text, start - before.start)
    value after_text: byte_slice(after.text, 0, end - after.start)
    value swap: before.line_break != after.line_break && policy != "none"
    value left: if swap then after_text else structure_operator_gap(before_text, policy == "before")
    value right: if swap then before_text else structure_operator_gap(after_text, policy == "after")
    value if left == before_text && right == after_text then null else {
      start: start,
      end: end,
      text: left operator right (if right == "" && contains(["+", "-"], operator) && next.text == operator then " " else ""),
    }
  }

in ts_binary.operator, ts_logical.operator, ts_assignment.operator, ts_equals, ts_question, ts_colon, ts_punctuator rule operator-linebreak {
  option mode "before" | "after" | "none" | null = null "operator side of a line break"
  option overrides { [key: string]: "before" | "after" | "none" | "ignore" } = {} "operator-specific placement"
  when parent is (ts_binary, ts_logical, ts_assignment)
    || parent is (ts_conditional, ts_conditional_type) && contains(["?", ":"], text)
    || parent is (ts_declarator, ts_class_property, ts_import_equals, ts_type_alias, ts_type_parameter, ts_enum_member) && text == "="
    || parent is (ts_union, ts_intersection) && contains(["|", "&"], text) && offset > parent.structure_first_type_offset
  let placement { value overrides; get text; nonempty } ?? if mode == null && contains(["?", ":"], text) then "before" else mode.nonempty ?? "after"
  let operator_previous token(node, "before")
  let operator_next token(node, "after")
  let operator_before_break operator_previous != null && position(operator_previous.end).js_line != position(offset).js_line
  let operator_after_break operator_next != null && position(end_offset).js_line != position(operator_next.start).js_line
  when operator_before_break || operator_after_break
  let next_text if parent is ts_type_alias then byte_slice(parent_text, operator_next.start - parent.structure_start) else null
  let policy if placement != "ignore" && parent is ts_type_alias && re_test(next_text, /^[|&]/) then "after" else placement
  when policy != "ignore"
  when operator_before_break && operator_after_break || policy == "before" && !operator_before_break || policy == "after" && !operator_after_break || policy == "none"
  let space_before ts_token_space(source, node, true)
  let space_after ts_token_space(source, node, false)
  let operator_before_comment { value overlapping(ts_comment, space_before.start, offset); last }
  let operator_after_comment { value overlapping(ts_comment, end_offset, space_after.end); first }
  let operator_fix structure_operator_fix(space_before, space_after, operator_next, policy, text, operator_before_comment, operator_after_comment)
  fix at operator_fix if operator_fix != null as operator_fix.text
  warn if operator_before_break && operator_after_break then "Bad line breaking before and after '{text}'." else if policy == "before" then "'{text}' should be placed at the beginning of the line." else if policy == "after" then "'{text}' should be placed at the end of the line." else "There should be no line break before or after '{text}'."
}

group core_ts_list ts_array, ts_array_pattern, ts_object, ts_object_pattern, ts_function, ts_arrow,
  ts_call, ts_new, ts_if, ts_import, ts_export, ts_enum, ts_function_type, ts_interface,
  ts_type_literal, ts_tuple_type, ts_type_reference, ts_method, ts_class
group core_list core_ts_list
in ts_import, ts_export let structure_attribute_lists overlapping(ts_import_attributes, offset, end_offset)
in core_ts_list let core_list_layout
  if is (ts_import, ts_export) then filter(list_layout, site => !contains(["ImportDeclaration", "ExportNamedDeclaration"], site.kind) || !any(structure_attribute_lists, attributes => site.offset >= attributes.open.offset && site.end <= attributes.close.end_offset))
  else list_layout

group structure_declaration_parent ts_program, ts_block, ts_if, ts_for, ts_for_in, ts_for_of,
  ts_while, ts_do_while, ts_labeled, ts_with, ts_export
group structure_suppress_statement_entry ts_do_while, ts_for, ts_for_in, ts_for_of, ts_if, ts_labeled, ts_while
@macro register_max_statements_counted(target, eligible) {
  group max_statements_counted target
  in target let max_statements_counted_here eligible
}
@register_max_statements_counted(ts_break, true)
@register_max_statements_counted(ts_class, parent is structure_declaration_parent)
@register_max_statements_counted(ts_continue, true)
@register_max_statements_counted(ts_debugger, true)
@register_max_statements_counted(ts_do_while, true)
@register_max_statements_counted(ts_expression_statement, true)
@register_max_statements_counted(ts_for_in, true)
@register_max_statements_counted(ts_for_of, true)
@register_max_statements_counted(ts_for, true)
@register_max_statements_counted(ts_function, parent is structure_declaration_parent)
@register_max_statements_counted(ts_if, true)
@register_max_statements_counted(ts_import, true)
@register_max_statements_counted(ts_labeled, true)
@register_max_statements_counted(ts_return, true)
@register_max_statements_counted(ts_switch, true)
@register_max_statements_counted(ts_throw, true)
@register_max_statements_counted(ts_try, true)
@register_max_statements_counted(ts_variable_declaration, true)
@register_max_statements_counted(ts_while, true)
@register_max_statements_counted(ts_with, true)
@register_max_statements_counted(ts_export, true)
in max_statements_counted let max_statements_entry_line if parent is structure_suppress_statement_entry && not ts_node.alternate || parent is ts_export && parent.operator != "*" then null else position(offset).js_line
in max_statements_counted let max_statements_exit_offset offset + {
  value {
  value text
  trim_end
  trim_end ";"
  trim_end
  nonempty
} ?? text
  byte_len
}
in max_statements_counted let max_statements_exit_line position(max_statements_exit_offset).js_line

in ts_line rule max-statements-per-line {
  option max int(1..) = 1 "maximum statements on one line"
  let row position(offset).js_line
  let statements { value overlapping(max_statements_counted); filter (statement) statement.max_statements_counted_here.nonempty ?? true }
  let tally {
    value statements
    fold ({ count: 0, first_entry: null, first_exit: null, at_limit: null, after_limit: null }) (state, statement) if statement.max_statements_entry_line != row && statement.max_statements_exit_line != row then state else {
      count: state.count + (if statement.max_statements_entry_line == row then 1 else 0),
      first_entry: if statement.max_statements_entry_line == row then state.first_entry.nonempty ?? statement.offset else state.first_entry,
      first_exit: if statement.max_statements_exit_line == row then { value state.first_exit.nonempty ?? statement.max_statements_exit_offset; min statement.max_statements_exit_offset } else state.first_exit,
      at_limit: if statement.max_statements_entry_line == row && state.count + 1 == max then statement.offset else state.at_limit,
      after_limit: if statement.max_statements_entry_line == row && state.count == max then statement.offset else state.after_limit,
    }
  }
  let carried if tally.first_exit != null && (tally.first_entry == null || tally.first_exit <= tally.first_entry) then 1 else 0
  when tally.count + carried > max
  report at if carried == 1 then tally.at_limit else tally.after_limit
  warn "This line has {tally.count + carried} statements. Maximum allowed is {max}."
}

fn structure_gap_parts(source, from, to, comments) = {
  value comments
  filter (comment) comment.offset < to && comment.end_offset > from
  fold ({ cursor: from, code: false }) (state, comment) {
    cursor: min(comment.end_offset, to),
    code: state.code || {
      value comment.offset
      max: max from
      value byte_slice(source, state.cursor, max)
      trim
    } != "",
  }
}
fn structure_gap_has_code(source, to, parts) = parts.code || { value source; byte_slice parts.cursor to; trim } != ""

in ts_line let structure_row_comments overlapping(structure_comment)
in ts_line let structure_row_blocked trim(text) == "" || any(structure_row_comments, comment =>
  position(comment.offset).js_line == position(offset).js_line || position(comment.end_offset).js_line == position(offset).js_line)
in structure_comment let structure_first_row { value overlapping(ts_line, offset, offset + 1); first }
in structure_comment let structure_last_row { value overlapping(ts_line, end_offset - 1, end_offset); first }
in structure_comment let structure_previous_row if structure_first_row.offset > 0 then { value overlapping(ts_line, structure_first_row.offset - 1, structure_first_row.offset); first } else null
in structure_comment let structure_next_row { value overlapping(ts_line, structure_last_row.end_offset, structure_last_row.end_offset + 1); first }
in structure_comment let structure_inline {
  value source
  parts: structure_gap_parts structure_first_row.offset offset structure_first_row.structure_row_comments
  value structure_gap_has_code(source, offset, parts)
}
  || {
    value source
    parts_2: structure_gap_parts end_offset structure_last_row.end_offset structure_last_row.structure_row_comments
    value structure_gap_has_code(source, structure_last_row.end_offset, parts_2)
  }

in ts_class let structure_boundary_targets ["Block", "Class"]
in ts_block let structure_boundary_targets if parent is ts_namespace then ["Module"] else ["Block"]
in ts_static_block, ts_switch, ts_case let structure_boundary_targets ["Block"]
in ts_object, ts_object_pattern let structure_boundary_targets ["Object"]
in ts_array, ts_array_pattern let structure_boundary_targets ["Array"]
in ts_interface let structure_boundary_targets ["Interface"]
in ts_type_literal let structure_boundary_targets ["Type"]
in ts_enum let structure_boundary_targets ["Enum"]
in ts_class, ts_interface, ts_enum, ts_static_block, ts_switch let structure_boundary_start opener.ts_open_brace.offset
in ts_block, ts_case, ts_object, ts_object_pattern, ts_array, ts_array_pattern, ts_type_literal let structure_boundary_start offset

@macro structure_comment_gap(name, before) {
in structure_comment rule name {
  option beforeBlockComment boolean = true "blank line before block comments"
  option afterBlockComment boolean = false "blank line after block comments"
  option beforeLineComment boolean = false "blank line before line comments"
  option afterLineComment boolean = false "blank line after line comments"
  option afterHashbangComment boolean = false "blank line after hashbangs"
  option applyDefaultIgnorePatterns boolean = true "ignore directive comments"
  option ignorePattern string = "" "ignore matching comment bodies"
  option allowBlockStart boolean = false "allow comments at block starts"
  option allowBlockEnd boolean = false "allow comments at block ends"
  option allowClassStart boolean | null = null "override class start exceptions"
  option allowClassEnd boolean | null = null "override class end exceptions"
  option allowObjectStart boolean = false "allow comments at object starts"
  option allowObjectEnd boolean = false "allow comments at object ends"
  option allowArrayStart boolean = false "allow comments at array starts"
  option allowArrayEnd boolean = false "allow comments at array ends"
  option allowInterfaceStart boolean = false "allow comments at interface starts"
  option allowInterfaceEnd boolean = false "allow comments at interface ends"
  option allowTypeStart boolean = false "allow comments at type starts"
  option allowTypeEnd boolean = false "allow comments at type ends"
  option allowEnumStart boolean = false "allow comments at enum starts"
  option allowEnumEnd boolean = false "allow comments at enum ends"
  option allowModuleStart boolean = false "allow comments at module starts"
  option allowModuleEnd boolean = false "allow comments at module ends"
  let allowedStart {
    value [if allowClassStart == true then "Class" else null, if allowObjectStart then "Object" else null, if allowArrayStart then "Array" else null, if allowInterfaceStart then "Interface" else null, if allowTypeStart then "Type" else null, if allowEnumStart then "Enum" else null, if allowModuleStart then "Module" else null]
    compact
  }
  let allowedEnd {
    value [if allowClassEnd == true then "Class" else null, if allowObjectEnd then "Object" else null, if allowArrayEnd then "Array" else null, if allowInterfaceEnd then "Interface" else null, if allowTypeEnd then "Type" else null, if allowEnumEnd then "Enum" else null, if allowModuleEnd then "Module" else null]
    compact
  }
  when if before then (if is ts_block_comment then beforeBlockComment else beforeLineComment)
    else (if is structure_hashbang then afterHashbangComment else if is ts_block_comment then afterBlockComment else afterLineComment)
  when !(applyDefaultIgnorePatterns && structure_directive) && (ignorePattern == "" || !re_test(structure_comment_body, ignorePattern))
  when !structure_inline
  let row if before then structure_first_row else structure_last_row
  let adjacent if before then structure_previous_row else structure_next_row
  when adjacent != null && !adjacent.structure_row_blocked
  when !any(row.structure_row_comments, comment => if before
    then comment.offset < offset && position(comment.end_offset).js_line == position(offset).js_line
    else comment.offset >= end_offset && position(comment.offset).js_line == position(end_offset).js_line)
  let boundary parent.structure_boundary_start != null && parent.structure_boundary_start <= offset
    && (if before then position(parent.structure_boundary_start).js_line + 1 == position(offset).js_line
      else position(parent.end_offset).js_line == position(end_offset).js_line + 1)
  let targets if boundary then parent.structure_boundary_targets.nonempty ?? [] else []
  when !any(targets, target => { value if before then allowedStart else allowedEnd; contains target })
  when !(contains(targets, "Block") && (if before then allowBlockStart else allowBlockEnd) && !(contains(targets, "Class") && (if before then allowClassStart else allowClassEnd) == false))
  warn if before then "Expected line before comment." else "Expected line after comment."
  let comment_fix_site if before then row.offset else end_offset
  fix at { start: comment_fix_site, end: comment_fix_site } as "\n"
}
}
@structure_comment_gap(lines-around-comment:before, true)
@structure_comment_gap(lines-around-comment:after, false)

in ts_parenthesized let structure_unwrapped_end expression.structure_unwrapped_end.nonempty ?? expression.end_offset
in ts_parenthesized let structure_unwrapped_text expression.structure_unwrapped_text.nonempty ?? expression.text
in ts_parenthesized let structure_chain_info expression.structure_chain_info
in ts_parenthesized let structure_call_depth expression.structure_call_depth
in ts_call, ts_new let structure_call_depth (callee.structure_chain_info).depth.nonempty ?? 1

@macro structure_chain_owner(kind, property_start, property_text, is_computed) {
  in kind let structure_chain_info {
    depth: 1 + (object.structure_call_depth.nonempty ?? 0),
    offset: (object.space_after).end,
    gap: {
      value default: object.structure_unwrapped_end.nonempty ?? object.end_offset
      value byte_slice(source, default, property_start)
    },
    property: property_text,
    computed: is_computed,
    optional: optional != null,
  }
}
@structure_chain_owner(ts_member, property.offset, property.structure_unwrapped_text.nonempty ?? property.text, false)
@structure_chain_owner(ts_index, index.offset, index.structure_unwrapped_text.nonempty ?? index.text, true)

in ts_call rule newline-per-chained-call {
  option ignoreChainWithDepth number = 2 "allow chains up to this depth"
  let info callee.structure_chain_info
  when info != null && info.depth > ignoreChainWithDepth && !re_test(info.gap, /[\n\r\u{2028}\u{2029}]/)
  fix at { start: info.offset, end: info.offset } as "\n"
  report at info.offset
  let first_line { value info.property; re_find /^[^\n\r\u{2028}\u{2029}]*/; nonempty } ?? ""
  let prefix if info.optional then (if info.computed then "?.[" else "?.") else (if info.computed then "[" else ".")
  let suffix if info.computed && len(first_line) == len(info.property) then "]" else ""
  let callee_name prefix first_line suffix
  warn "Expected line break before `{callee_name}`."
}

in ts_arrow.body rule implicit-arrow-linebreak {
  option mode "beside" | "below" = "beside"
  when not ts_block
  let broken space_before.line_break
  when mode == "beside" && broken || mode == "below" && !broken
  fix at { start: if mode == "below" then offset else space_before.start, end: offset } if mode == "below" || !space_before.comments as if mode == "below" then "\n" else " "
  warn if mode == "beside" then "Expected no linebreak before this expression." else "Expected a linebreak before this expression."
}

in ts_arrow rule no-confusing-arrow {
  option allowParens boolean = true "parentheses disambiguate a conditional body"
  option onlyOneSimpleParam boolean = false "check only single identifier parameters"
  when body is ts_conditional || !allowParens && body is ts_parenthesized && body.structure_single_conditional
  when !onlyOneSimpleParam || count(parameter) == 1 && { value parameter; first; re_test /^[A-Za-z_$][\w$]*$/ }
  fix at body.node if allowParens as "(" body.text ")"
  warn "Arrow function used ambiguously with a conditional expression."
}

in ts_if.consequent, ts_if.alternate, ts_while.body, ts_do_while.body, ts_for.body, ts_for_in.body, ts_for_of.body rule nonblock-statement-body-position {
  option mode "beside" | "below" | "any" = "beside"
  option overrides { if?: "beside" | "below" | "any"; else?: "beside" | "below" | "any"; while?: "beside" | "below" | "any"; do?: "beside" | "below" | "any"; for?: "beside" | "below" | "any" } = {} "position by statement"
  let kind if parent is ts_if then (if is ts_if.alternate then "else" else "if") else if parent is ts_while then "while" else if parent is ts_do_while then "do" else "for"
  let style {
    value (if kind == "if" then overrides.if else if kind == "else" then overrides.else else if kind == "while" then overrides.while else if kind == "do" then overrides.do else overrides.for)
    nonempty
  } ?? mode
  let broken space_before.line_break
  when not ts_block && !(kind == "else" && is ts_if)
  when style != "any" && (style == "beside" && broken || style == "below" && !broken)
  fix at { start: if style == "below" then offset else space_before.start, end: offset } if style == "below" || !space_before.comments as if style == "below" then "\n" else " "
  warn if style == "beside" then "Expected no linebreak before this statement." else "Expected a linebreak before this statement."
}

}
