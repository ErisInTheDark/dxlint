# .ts/helpers: helpers shared by the native TypeScript rule definitions.

# A plain identifier, nothing else (`x`, `$el`, not `a.b` or `f()`).
fn is_identifier(x) = re_test(x, /^[A-Za-z_$][\w$]*$/)

fn unparenthesised_node(n) = { value n; walk (current) if current is ts_parenthesized then current.expression.node else null; last }
fn outer_parenthesised_node(n) = { value n; walk (current) if current.parent is ts_parenthesized then current.parent.node else null; last }

fn function_head_site(n) = {
  value outer: outer_parenthesised_node(n)
  value member: if n is ts_method then n else if outer.parent is (ts_property, ts_class_property) then outer.parent.node else null
  value if member == null && n is ts_arrow then n.operator.node else {
    value from: last(n.type_parameter.nodes).end_offset ?? n.name.end_offset ?? n.key.end_offset ?? n.offset
    value until: first(n.parameter.nodes).offset ?? n.return_type.offset ?? n.body.offset ?? n.end_offset
    value opening: first(overlapping(ts_open_paren, from, until))
    value {
      start: last(member.decorator.nodes).token_neighbours.after.start ?? member.offset ?? n.offset,
      end: opening.offset ?? first(n.parameter.nodes).offset ?? n.body.offset
    }
  }
}

# Function-wide warnings identify the callable, not its body.
fn function_warning_site(n) = if n is ts_method then n.key.node
  else if n.name != null then n.name.node
  else if n.parent is (ts_property, ts_class_property) then n.parent.key.node
  else if n is ts_arrow then n.operator.node
  else { start: n.first_token.start, end: n.first_token.end }

define {
  in ts_import {
    let import_named_open {
      value overlapping(ts_open_brace, first_token.end, from.offset)
      find (token) token.paired_token.end <= from.offset
    }
    let import_named_close import_named_open.paired_token
  }
  in ts_property_signature, ts_method_signature, ts_call_signature, ts_index_signature let member_terminal_token if contains([";", ","], token_neighbours.after.text) then token_neighbours.after else last_token
}
