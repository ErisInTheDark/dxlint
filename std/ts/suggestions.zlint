  value consequent: conditional.consequent.node
  value destination: if conditional.parent is ts_case then conditional.parent.parent.node
    else if conditional.parent is ts_block && conditional.parent.parent is ts_function_like then conditional.parent.parent.node
    else conditional.parent.node
