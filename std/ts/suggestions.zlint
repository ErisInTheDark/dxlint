  let caught_parameter get(caught_info, "parameter")
  let catch_kind if caught_parameter == null then "missing" else if caught_parameter.kind == "ts_identifier" then "present" else "destructured"
  let builtin_error caught_info.global && contains(["Error", "EvalError", "RangeError", "ReferenceError", "SyntaxError", "TypeError", "URIError", "AggregateError"], caught_info.name)
  let configured_error find_last(errorClassNames, x => caught_info.name == (if type_of(x) == "str" then x else x.name))
  when builtin_error || configured_error != null
  let cause_position if builtin_error then (if caught_info.name == "AggregateError" then 2 else 1) else if type_of(configured_error) == "str" then 1 else configured_error.argumentPosition - 1
  let cause_argument { value caught_info.arguments; slice cause_position; first }
  let cause_kind {
    value preceding: if cause_argument == null then caught_info.arguments else slice(caught_info.arguments, 0, cause_position)
    value caught_throw_cause_kind(caught_parameter, cause_argument, preceding)
  }
  let cause_property { value cause_argument.properties.nonempty ?? []; find_last (property) property.name == "cause" }
  when catch_kind == "destructured" || catch_kind == "missing" && requireCatchParameter || catch_kind == "present" && contains(["missing", "incorrect", "shadowed"], cause_kind)
  report at if catch_kind == "destructured" then caught_info.catch_offset else if catch_kind == "present" && cause_kind == "incorrect" then cause_property.value.offset else caught_info.throw_offset
  warn if catch_kind == "destructured" then "Re-throws cannot preserve the caught error as a part of it is being lost due to destructuring." else if catch_kind == "missing" then "The caught error is not accessible because the catch clause lacks the error parameter. Start referencing the caught error using the catch parameter." else if cause_kind == "missing" then "There is no `cause` attached to the symptom error being thrown." else if cause_kind == "incorrect" then "The symptom error is being thrown with an incorrect `cause`." else "The caught error is being attached as `cause`, but is shadowed by a closer scoped redeclaration."
}

}
