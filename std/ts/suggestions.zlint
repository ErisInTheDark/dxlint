in ts_call, ts_new rule prefer-regex-literals {
  option disallowRedundantWrapping boolean = false "disallow constructors wrapping regex literals"
  when callee.global_value == "RegExp"
  let regex_preference regex_construction_kind(argument.nodes)
  when regex_preference != null && (regex_preference == "static" || disallowRedundantWrapping)
  warn if regex_preference == "static" then "Use a regular expression literal instead of the 'RegExp' constructor." else if regex_preference == "wrapped" then "Regular expression literal is unnecessarily wrapped within a 'RegExp' constructor." else "Use regular expression literal with flags instead of the 'RegExp' constructor."
}

in ts_regex, ts_call, ts_new rule require-unicode-regexp {
  option requireFlag ("u" | "v" | null) = null "require a particular unicode mode"
  let unicode_info unicode_regex_flags
  when unicode_info != null
  when if requireFlag == "u" then !re_test(unicode_info.flags, /u/) else if requireFlag == "v" then !re_test(unicode_info.flags, /v/) else !re_test(unicode_info.flags, /[uv]/)
  warn if requireFlag == "v" then "Use the 'v' flag." else "Use the 'u' flag."
}

fn strict_enclosing_function_directive(n) =
  {
    value n.parent.node
    walk (current) current.parent.node
    any (current) current is (ts_function, ts_arrow, ts_method) && count(current.directive_scope.directives) > 0
  }
