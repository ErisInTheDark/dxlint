# .ts/suggestions: eslint core "suggestion" rules (style and best
# practice, not likely bugs) on the native TypeScript layers.

define {

# Statement properties stay lazy: rules request only the shape they need.
in ts_if let statement_has_else alternate != null
in ts_if let unmatched_tail alternate == null || alternate.unmatched_tail == true
in ts_for, ts_for_in, ts_for_of, ts_while, ts_with, ts_labeled let unmatched_tail body.unmatched_tail == true
in ts_if, ts_for, ts_for_in, ts_for_of, ts_while, ts_with, ts_labeled, ts_block let enclosing_else_boundary is ts_if.consequent && parent.statement_has_else == true || parent is (ts_if, ts_for, ts_for_in, ts_for_of, ts_while, ts_with, ts_labeled) && parent.enclosing_else_boundary == true
in ts_block let else_block is ts_if.alternate
in ts_block let statement_count count([] body)

in ts_return let return_end true
in ts_block let return_end last([] body.node) is ts_return
in ts_return let branch_exit true
in ts_if let branch_exit consequent.return_end == true && alternate.return_end == true
in ts_return, ts_if let returning_branch branch_exit == true
in ts_block let returning_branch any([] body.branch_exit, r => r == true)
in ts_if let chain_else_offset if consequent.returning_branch != true || alternate == null then null else if alternate is ts_if then alternate.chain_else_offset else alternate.offset

in ts_unary let negative_test operator == "!"
in ts_binary let negative_test operator == "!=" || operator == "!=="
in ts_parenthesized let negative_test expression.negative_test == true
in ts_continue let continue_guard true
in ts_block let continue_guard count([] body) == 1 && first([] body.node) is ts_continue
in ts_if let conditional_continue consequent.continue_guard == true
in ts_block let guarded_iteration count([] body) == 0 || first([] body.node) is ts_if && (count([] body) == 1 || first([] body.conditional_continue) == true)

in ts_parenthesized let unwrapped_node default(expression.unwrapped_node, expression.node)
in ts_parenthesized let unwrapped_text default(expression.unwrapped_text, expression)
in ts_return let return_value_object default(argument.unwrapped_node, argument.node) is ts_object
in ts_return let return_value_braced starts_with(argument, "{{")
in ts_block let single_return count([] body) == 1 && first([] body.node) is ts_return
in ts_block let return_value_object first([] body.return_value_object) == true
in ts_block let return_value_braced first([] body.return_value_braced) == true
in ts_function let function_this uses_this
in ts_member let bind_property_offset property.offset
in ts_index let bind_property_offset index.offset
in ts_member, ts_index let bind_target if static_name != "bind" then null else if default(object.unwrapped_node, object.node) is ts_arrow || default(object.unwrapped_node, object.node) is ts_function && object.function_this != true then bind_property_offset else null
in ts_parenthesized forward function_this, bind_target from expression

in ts_throw let thrown_identifier if default(argument.unwrapped_node, argument.node) is ts_identifier then default(argument.unwrapped_text, argument) else null
in ts_block let first_throw first([] body.thrown_identifier)
in ts_try let catch_rethrows parameter is ts_identifier && handler.first_throw == parameter

in ts_binary let additive operator == "+"
in ts_binary let string_addition additive && (default(left.unwrapped_node, left.node) is (ts_string, ts_template) || left.string_addition == true || default(right.unwrapped_node, right.node) is (ts_string, ts_template) || right.string_addition == true)
in ts_binary let nonstring_addition additive && ((if left.additive == true then left.nonstring_addition == true else default(left.unwrapped_node, left.node) not (ts_string, ts_template)) || (if right.additive == true then right.nonstring_addition == true else default(right.unwrapped_node, right.node) not (ts_string, ts_template)))
in ts_binary, ts_parenthesized let inside_addition parent is ts_binary && parent.additive == true || parent is ts_parenthesized && parent.inside_addition == true
in ts_parenthesized forward additive, string_addition, nonstring_addition from expression
in ts_binary let arithmetic_operator if contains(["+", "-", "*", "/", "%", "**", "<<", ">>", ">>>", "&", "|", "^"], operator) then operator else null
in ts_binary let strict_left_reference_key left.reference_key_strict
in ts_binary let strict_right_reference_key right.reference_key_strict
in ts_parenthesized forward arithmetic_operator, strict_left_reference_key, strict_right_reference_key from expression

in ts_parameter let required_parameter init == null && optional == null && name not ts_rest && !starts_with(text, "...")
in ts_function, ts_arrow, ts_method let parameter_required [] parameter.required_parameter
in ts_object let assign_source_accessor any([] property.accessor_kind, k => k == "get" || k == "set")
in ts_object let assign_source_proto contains([] property.static_name, "__proto__")
in ts_parenthesized forward assign_source_accessor, assign_source_proto from expression

in ts_computed_key let computed_literal_text if default(expression.unwrapped_node, expression.node) is (ts_string, ts_number) then default(expression.unwrapped_text, expression) else null
in ts_method, ts_class_property let member_static contains([] modifier, "static")
in ts_property, ts_pattern_property let computed_exception parent is ts_object && parent.write_site == null && static_name == "__proto__"
in ts_method let computed_exception if parent is ts_class then static_name == (if member_static then "prototype" else "constructor") else parent is ts_object && parent.write_site == null && static_name == "__proto__"
in ts_class_property let computed_exception static_name == "constructor" || member_static && static_name == "prototype"

in ts_identifier let module_name_info { name: identifier_name }
in ts_string let module_name_info { name: get(literal_value, "value") }
in ts_parenthesized forward module_name_info, module_default_info from expression
in ts_assignment_pattern, ts_assignment let module_default_info left.module_name_info
fn aliases_same(a, b) = a != null && b != null && a.name == b.name

in ts_unary let signed_numeric_literal operator == "-" && default(argument.unwrapped_node, argument.node) is (ts_number, ts_bigint)
in ts_template let static_template count(expression) == 0
in ts_parenthesized forward signed_numeric_literal, static_template, range_terms from expression
in ts_binary let left_literal default(left.unwrapped_node, left.node) is ts_literal || left.signed_numeric_literal == true || left.static_template == true
in ts_binary let right_literal default(right.unwrapped_node, right.node) is ts_literal || right.signed_numeric_literal == true || right.static_template == true
in ts_binary let range_terms if !contains(["<", "<="], operator) then null else { left_key: left.reference_key, right_key: right.reference_key, left_literal: left_literal, right_literal: right_literal, left_value: left.literal_value, right_value: right.literal_value }
fn yoda_ordered(a_literal, a, b_literal, b) = if !a_literal && !b_literal then false else if !a_literal || !b_literal then true else a != null && b != null && js_compare(a, b) != null && js_compare(a, b) <= 0
fn yoda_range_pair(a, b, op) = a != null && b != null && (if op == "&&" then a.right_key != null && a.right_key == b.left_key && yoda_ordered(a.left_literal, a.left_value, b.right_literal, b.right_value) else op == "||" && a.left_key != null && a.left_key == b.right_key && yoda_ordered(a.right_literal, a.right_value, b.left_literal, b.left_value))
in ts_logical let logical_range (parent is ts_parenthesized || is (ts_if.test, ts_while.test, ts_do_while.test, ts_for.test)) && yoda_range_pair(left.range_terms, right.range_terms, operator)
in ts_parenthesized let logical_range parent is ts_logical && parent.logical_range == true

in ts_node let return_assignment_context if parent is ts_return then { arrow: false, offset: parent.offset } else if is ts_arrow.body then { arrow: true, offset: parent.offset } else if parent is (ts_function, ts_method, ts_arrow, ts_class, ts_block, ts_static_block, ts_expression_statement, ts_variable_declaration, ts_if, ts_for, ts_for_in, ts_for_of, ts_while, ts_do_while, ts_switch, ts_throw, ts_with, ts_labeled, ts_try, ts_export) then null else parent.return_assignment_context
in ts_variable_declaration let async_resource_declaration kind == "await using"
in ts_for_of let asynchronous_iteration contains([] modifier, "await")
in ts_labeled let declared_label label
in ts_node let repeated_evaluation if parent is ts_function_like || parent is ts_for_of && parent.asynchronous_iteration == true then false else if is (ts_for.body, ts_for.test, ts_for.update, ts_for_in.body, ts_for_of.body) || is (ts_for_in.left, ts_for_of.left) && async_resource_declaration == true || is (ts_while.body, ts_while.test, ts_do_while.body, ts_do_while.test) then true else parent.repeated_evaluation == true
in ts_node let nearest_break_target if is (ts_loop, ts_switch) then { label: if parent is ts_labeled then parent.declared_label else null } else if is ts_function_like || is ts_labeled && declared_label == get(parent.nearest_break_target, "label") then null else parent.nearest_break_target

in ts_parenthesized let inner_comparison_tokens expression.unparenthesised_tokens
in ts_node let unparenthesised_tokens if is ts_parenthesized then inner_comparison_tokens else token_texts
in ts_unary let void_operator operator == "void"
in ts_parenthesized let inner_null_receiver expression.null_call_receiver
in ts_node let null_call_receiver if is ts_parenthesized then inner_null_receiver else is ts_null || is ts_identifier && text == "undefined" || is ts_unary && void_operator == true
in ts_member, ts_index let member_receiver_tokens object.unparenthesised_tokens
in ts_member, ts_index let invoked_receiver if object == null then null else { member: default(object.unwrapped_node, object.node) is (ts_member, ts_index), tokens: object.member_receiver_tokens }
in ts_member let direct_method_name property
in ts_member, ts_index let called_method_name static_name
in ts_parenthesized forward member_receiver_tokens, invoked_receiver, direct_method_name, called_method_name from expression
fn unchanged_call_receiver(receiver, tokens, null_receiver) = receiver != null && (if receiver.member then receiver.tokens == tokens else null_receiver == true)

@macro suggestion_curly_policy {
  option mode ("all" | "multi" | "multi-line" | "multi-or-nest") = "all" "control body brace policy"
  option style ("consistent" | null) = null "consistent braces throughout if chains"
  let curly_info curly_body
  when curly_info != null
  let body_expected if mode == "all" then 1 else if mode == "multi" then curly_info.multi else if mode == "multi-line" then curly_info.multiline else curly_info.nested
  let chain_required if mode == "multi" then curly_info.multi_consistent else if mode == "multi-line" then curly_info.multiline_consistent else curly_info.nested_consistent
  let curly_expected if style == "consistent" && mode != "all" then if chain_required then 1 else 0 else body_expected
  when curly_expected != -1 && (curly_expected == 1 && !curly_info.block || curly_expected == 0 && curly_info.block)
  warn "{if curly_expected == 1 then 'Expected' else 'Unnecessary'} {{ after '{curly_info.name}'{if curly_info.condition then ' condition' else ''}."
}
in ts_if.consequent rule curly:if { @suggestion_curly_policy }
in ts_if.alternate rule curly:else { @suggestion_curly_policy }
in ts_for.body, ts_while.body rule curly:loop { @suggestion_curly_policy }
in ts_for_in.body, ts_for_of.body, ts_do_while.body rule curly:loop-body { @suggestion_curly_policy }

# The global `eval`, called or referenced (`(0, eval)`, `globalThis.eval`).
@macro suggestion_eval_policy {
  option allowIndirect boolean = false "allow indirect eval references and calls"
  let eval_info eval_usage
  when eval_info != null && (!allowIndirect || eval_info.direct && !eval_info.optional)
  report at eval_info.offset
  warn "`eval` can be harmful."
}
in ts_identifier rule no-eval { @suggestion_eval_policy }
in ts_member, ts_index rule no-eval:member { @suggestion_eval_policy }

# `.bind(x)` on a function that never uses `this` (or on an arrow).
in ts_call rule no-extra-bind {
  when count(argument) == 1 && first([] argument.node) not ts_spread && callee.bind_target != null
  report at callee.bind_target
  warn "The function binding is unnecessary."
}

in ts_unary, ts_call rule no-extra-boolean-cast {
  option enforceForInnerExpressions boolean = false "check casts nested inside boolean expressions"
  option enforceForLogicalOperands boolean = false "check casts nested inside logical expressions"
  let cast_info redundant_boolean_cast
  when cast_info != null && (cast_info.mode == 0 || cast_info.mode == 1 && enforceForLogicalOperands || enforceForInnerExpressions)
  warn if cast_info.negation then "Redundant double negation." else "Redundant Boolean call."
}

in ts_new rule no-new-wrappers {
  when re_test(global_callee, /^(String|Number|Boolean)$/)
  warn "Do not use {global_callee} as a constructor."
}

in ts_string rule no-nonoctal-decimal-escape {
  each decimal_escape in nonoctal_decimal_escapes
  report at decimal_escape.offset
  warn "Don't use '{decimal_escape.text}' escape sequence."
}

# Comma operators, except loop init/update and explicitly grouped expressions.
in ts_sequence rule no-sequences {
  option allowInParentheses boolean = true "allow explicitly parenthesised sequences"
  let enclosed walk(node, current => if current.parent is ts_parenthesized then current.parent.node else null)
  let outside last(enclosed)
  when outside not (ts_for.init, ts_for.update)
  let paren_count count(enclosed) - 1
  when !allowInParentheses || paren_count == 0 || paren_count == 1 && outside is ts_arrow.body
  let comma_offset opener.ts_comma.offset
  when comma_offset != null
  report at comma_offset
  warn "Unexpected use of comma operator."
}

in ts_identifier let error_global_undefined text == "undefined" && resolved == "global" && global != "off"
in ts_parenthesized forward error_global_undefined from expression
in ts_throw rule no-throw-literal {
  when !argument.could_be_error || argument.error_global_undefined == true
  warn if argument.could_be_error then "Do not throw undefined." else "Expected an error object to be thrown."
}

in ts_declarator rule no-undef-init {
  when init == "undefined" && init.resolved == "global" && re_test(ts_variable_declaration.kind, /^(var|let)$/)
  warn "It's not necessary to initialize '{name}' to undefined."
}

in ts_try rule no-useless-catch {
  when catch_rethrows && finalizer == null
  warn "Unnecessary try/catch wrapper."
}
in ts_try.kind rule no-useless-catch:clause {
  when parent.catch_rethrows && parent.finalizer != null
  warn "Unnecessary catch clause."
}

fn enabled_global_identifier(n, name) = n is ts_identifier && n.text == name && n.resolved == "global" && n.global != "off"
fn parse_int_target(n) = if enabled_global_identifier(n, "parseInt") || n is (ts_member, ts_index) && n.static_name == "parseInt" && enabled_global_identifier(unparenthesised_node(n.object.node), "Number") then n.text else null
in ts_call let parse_int_name parse_int_target(unparenthesised_node(callee.node))
fn valid_radix(value) = value.type == "number" && value.value >= 2 && value.value <= 36 && value.value % 1 == 0
fn invalid_radix(n) = n is ts_identifier && n.text == "undefined" && n.resolved == "global" || (n is (ts_number, ts_string, ts_boolean, ts_null, ts_regex, ts_bigint) || n is ts_unary && contains(["+", "-"], n.operator) && n.argument is ts_number) && !valid_radix(n.literal_value)

in ts_call rule radix {
  option mode ("always" | "as-needed") = "always" "legacy radix policy"
  when parse_int_name != null
  let argument_count count(argument)
  let first_argument unparenthesised_node(first([] argument.node))
  let second_argument unparenthesised_node(first(slice([] argument.node, 1)))
  when first_argument not ts_spread && second_argument not ts_spread
  when argument_count < 2 || invalid_radix(second_argument)
  warn if argument_count == 0 then "Missing parameters." else if argument_count == 1 then "Missing radix parameter." else "Invalid radix parameter, must be an integer between 2 and 36."
}

in ts_identifier rule no-shadow-restricted-names {
  option reportGlobalThis boolean = true "include globalThis among restricted names"
  when restricted_binding && (text != "globalThis" || reportGlobalThis)
  warn "Shadowing of global property '{text}'."
}

# ---- preferences -----------------------------------------------------------------
in ts_identifier rule prefer-rest-params {
  when text == "arguments" && resolved == "global" && (ts_function != null || ts_method != null)
  when !(parent is ts_member && index == 0)
  warn "Use the rest parameters instead of 'arguments'."
}

in ts_call rule prefer-spread {
  when callee.called_method_name == "apply" && count(argument) == 2
  let second_argument_node default(first(slice([] argument.unwrapped_node, 1)), first(slice([] argument.node, 1)))
  when second_argument_node not (ts_array, ts_spread)
  when unchanged_call_receiver(callee.invoked_receiver, first([] argument.unparenthesised_tokens), first([] argument.null_call_receiver))
  warn "Use the spread operator instead of '.apply()'."
}

in ts_call rule prefer-object-spread {
  when global_method_callee == "Object.assign" && default(first([] argument.unwrapped_node), first([] argument.node)) is ts_object
  when !any([] argument.node, arg => arg is ts_spread) && !any([] argument.unwrapped_node, arg => arg is ts_spread)
  when count(argument) == 1 || !any([] argument.assign_source_accessor, a => a == true) && !any(slice([] argument.assign_source_proto, 1), p => p == true)
  warn if count(argument) == 1 then "Use an object literal instead of `Object.assign`. eg: `{{ foo: bar }}`." else "Use an object spread instead of `Object.assign` eg: `{{ ...foo }}`."
}

# String concatenation mixing literals and other values.
in ts_binary rule prefer-template {
  when string_addition && nonstring_addition && !inside_addition
  warn "Unexpected string concatenation."
}

in ts_case rule default-case-last {
  when test == null && index < count(parent.case) - 1
  warn "Default clause should be the last clause."
}

in ts_call, ts_new rule no-array-constructor {
  when global_callee == "Array" && count(type_argument) == 0
  when count(argument) != 1 || re_test(first(argument), /^\.\.\./)
  warn "The array literal notation [] is preferable."
}

in ts_call, ts_new rule no-object-constructor {
  when global_callee == "Object" && count(argument) == 0
  warn "The object literal notation {{}} is preferable."
}

in ts_expression_statement.expression rule no-new {
  when is ts_new
  warn "Do not use 'new' for side effects."
}

in ts_binary rule no-self-compare {
  when re_test(operator, /^(?:===?|!==?|>=?|<=?)$/)
  when left != null && right != null && left.unparenthesised_tokens == right.unparenthesised_tokens
  warn "Comparing to itself is potentially pointless."
}

in ts_with rule no-with warn "Unexpected use of 'with' statement."

in ts_member, ts_index rule no-proto {
  when static_name == "__proto__"
  warn "The '__proto__' property is deprecated."
}

in ts_member, ts_index rule no-iterator {
  when static_name == "__iterator__"
  warn "Reserved name '__iterator__'."
}

in ts_string, ts_template rule no-script-url {
  when literal_value.type == "string" && re_test(literal_value.value, /(?i)^javascript:/)
  when parent not ts_tagged_template
  warn "Script URL is a form of eval."
}

in ts_binary rule no-eq-null {
  when (operator == "==" || operator == "!=") && (left == "null" || right == "null")
  warn "Use '===' to compare with null."
}

in ts_call rule symbol-description {
  when callee == "Symbol" && callee.resolved == "global" && count(argument) == 0
  warn "Expected Symbol to have a description."
}

in ts_call rule prefer-numeric-literals {
  when count(argument) == 2 && parse_int_name != null
  when first([] argument.literal_value).type == "string"
  when contains(["2", "8", "16"], last(argument))
  warn "Use {if last(argument) == '2' then 'binary' else if last(argument) == '8' then 'octal' else 'hexadecimal'} literals instead of {parse_int_name}()."
}

in ts_string let octal_escape re_find(re_find(text, /(?:^|[^\\])(?:\\\\)*\\(?:[0-3][0-7]{1,2}|[4-7][0-7]|0[89]|[1-7])/), /\\(?:[0-3][0-7]{1,2}|[4-7][0-7]|0[89]|[1-7])$/)
in ts_string rule no-octal-escape {
  when octal_escape != null
  warn "Don't use octal: '{if re_test(octal_escape, /^\\0[89]$/) then '\\0' else octal_escape}'. Use '\\u....' instead."
}

group useless_rename_import ts_import_specifier
in useless_rename_import rule no-useless-rename:import {
  let original_name imported.module_name_info
  when aliases_same(original_name, local.module_name_info)
  warn "Import {original_name.name} unnecessarily renamed."
}

group useless_rename_export ts_export_specifier
in useless_rename_export rule no-useless-rename:export {
  let original_name local.module_name_info
  when aliases_same(original_name, exported.module_name_info)
  warn "Export {original_name.name} unnecessarily renamed."
}

group useless_rename_destructuring ts_pattern_property, ts_property
in useless_rename_destructuring rule no-useless-rename:destructuring {
  let original_name key.module_name_info
  when is ts_pattern_property || parent.write_site != null
  when aliases_same(original_name, default(value.module_default_info, value.module_name_info))
  warn "Destructuring assignment {original_name.name} unnecessarily renamed."
}

fn concat_endpoint_next(n, right_side) = if n is ts_parenthesized then n.expression.node else if n is ts_binary && n.operator == "+" then (if right_side then n.right.node else n.left.node) else null
fn concat_endpoint(n, right_side) = last(walk(n, current => concat_endpoint_next(current, right_side)))

in ts_binary rule no-useless-concat {
  when operator == "+"
  let left_endpoint concat_endpoint(left.node, true)
  let right_endpoint concat_endpoint(right.node, false)
  when left_endpoint is (ts_string, ts_template) && right_endpoint is (ts_string, ts_template)
  when !re_test(byte_slice(source, left_endpoint.end_offset, right_endpoint.offset), /[\r\n\u{2028}\u{2029}]/)
  report at operator.offset
  warn "Unexpected string concatenation of literals."
}

in ts_conditional rule no-unneeded-ternary {
  let consequent_value consequent.literal_value
  let alternate_value alternate.literal_value
  when consequent_value.type == "boolean" && alternate_value.type == "boolean"
  warn "Unnecessary use of boolean literals in conditional expression."
}

in ts_conditional rule no-unneeded-ternary:default-assignment {
  option defaultAssignment boolean = true "allow conditional expressions used as default assignments"
  when !defaultAssignment && default(test.unwrapped_node, test.node) is ts_identifier && default(consequent.unwrapped_node, consequent.node) is ts_identifier && default(test.unwrapped_text, test) == default(consequent.unwrapped_text, consequent)
  warn "Unnecessary use of conditional expression for default assignment."
}

in ts_member, ts_index rule no-console {
  option allow string[] = [] "console methods to allow"
  when object == "console" && object.resolved == "global" && !contains(allow, static_name)
  warn if count(allow) == 0 then "Unexpected console statement." else "Unexpected console statement. Only these console methods are allowed: {join(allow, ', ')}."
}

in ts_member, ts_index let global_function_method object == "Function" && object.resolved == "global" && contains(["apply", "bind", "call"], static_name)
in ts_parenthesized let global_function_method expression.global_function_method
in ts_call, ts_new rule no-new-func {
  when callee == "Function" && callee.resolved == "global" || callee.global_function_method == true
  warn "The Function constructor is eval."
}

in ts_method, ts_method_signature rule accessor-pairs {
  option getWithoutSet boolean = false "require a setter for each getter"
  option setWithoutGet boolean = true "require a getter for each setter"
  option enforceForClassMembers boolean = true "check class accessors"
  option enforceForTSTypes boolean = false "check type accessors"
  when accessor_pair != null && !accessor_pair.paired
  when accessor_pair.scope == "object" || accessor_pair.scope == "class" && enforceForClassMembers || accessor_pair.scope == "type" && enforceForTSTypes
  when accessor_pair.kind == "get" && getWithoutSet || accessor_pair.kind == "set" && setWithoutGet
  report at accessor_pair.offset
  warn "{if accessor_pair.kind == 'set' then 'Getter' else 'Setter'} is not present for {if accessor_pair.scope == 'class' then 'class ' else if accessor_pair.scope == 'type' then 'type ' else ''}{accessor_pair.name}."
}

in ts_object rule accessor-pairs:descriptor {
  option getWithoutSet boolean = false "require a setter for each getter"
  option setWithoutGet boolean = true "require a getter for each setter"
  when property_descriptor != null
  when setWithoutGet && property_descriptor.set && !property_descriptor.get || getWithoutSet && property_descriptor.get && !property_descriptor.set
  warn "{if property_descriptor.set then 'Getter' else 'Setter'} is not present in property descriptor."
}

in ts_method, ts_method_signature rule grouped-accessor-pairs {
  option mode ("anyOrder" | "getBeforeSet" | "setBeforeGet") = "anyOrder" "accessor order"
  option enforceForTSTypes boolean = false "check type accessors"
  let group_info accessor_pair.grouping
  when accessor_pair.scope != "type" || enforceForTSTypes
  when group_info != null && (group_info.gap || mode == "getBeforeSet" && !group_info.getter_first || mode == "setBeforeGet" && group_info.getter_first)
  report at accessor_pair.offset
  warn if group_info.gap then "Accessor pair {group_info.former} and {accessor_pair.name} should be grouped." else "Expected {accessor_pair.name} to be before {group_info.former}."
}

in ts_property, ts_method rule object-shorthand {
  option mode ("always" | "never" | "methods" | "properties" | "consistent" | "consistent-as-needed") = "always" "object shorthand policy"
  option avoidQuotes boolean = false "keep string-literal keys in long form"
  option ignoreConstructors boolean = false "ignore capitalised method names"
  option methodsIgnorePattern string = "" "method names to ignore"
  option avoidExplicitReturnArrows boolean = false "prefer methods to block-bodied arrows without lexical captures"
  let shorthand_info object_shorthand_member
  when shorthand_info != null && !shorthand_info.proto
  let needs_longform shorthand_info.concise && (mode == "never" || shorthand_info.method && avoidQuotes && shorthand_info.quoted)
  let needs_method !shorthand_info.concise && (mode == "always" || mode == "methods") && (shorthand_info.function || avoidExplicitReturnArrows && shorthand_info.arrow) && !(ignoreConstructors && shorthand_info.constructor) && !(avoidQuotes && shorthand_info.quoted) && !(methodsIgnorePattern != "" && shorthand_info.name != null && re_test(shorthand_info.name, methodsIgnorePattern))
  let needs_property !shorthand_info.concise && (mode == "always" || mode == "properties") && !shorthand_info.computed && shorthand_info.redundant && !shorthand_info.function && !shorthand_info.annotated && !(avoidQuotes && shorthand_info.quoted)
  when needs_longform || needs_method || needs_property
  warn if needs_longform then
    if shorthand_info.method then
      if mode == "never" then "Expected longform method syntax." else "Expected longform method syntax for string literal keys."
    else "Expected longform property syntax."
  else if needs_method then "Expected method shorthand."
  else "Expected property shorthand."
}

in ts_object rule object-shorthand:consistent {
  option mode ("always" | "never" | "methods" | "properties" | "consistent" | "consistent-as-needed") = "always" "object shorthand policy"
  when mode == "consistent" || mode == "consistent-as-needed"
  when object_shorthand_consistency == "mixed" || mode == "consistent-as-needed" && object_shorthand_consistency == "redundant"
  warn if object_shorthand_consistency == "mixed" then "Unexpected mix of shorthand and non-shorthand properties." else "Expected shorthand for all properties."
}

in ts_call rule prefer-exponentiation-operator {
  when global_method_callee == "Math.pow"
  warn "Use the '**' operator instead of 'Math.pow'."
}

in ts_property, ts_pattern_property, ts_method, ts_class_property rule no-useless-computed-key {
  option enforceForClassMembers boolean = true "check class member keys"
  let computed_text key.computed_literal_text
  when computed_text != null && !computed_exception && (parent not ts_class || enforceForClassMembers)
  warn "Unnecessarily computed property [{computed_text}] found."
}

in ts_unary, ts_binary, ts_assignment, ts_template rule no-implicit-coercion {
  option boolean boolean = true "check boolean conversions"
  option number boolean = true "check number conversions"
  option string boolean = true "check string conversions"
  option disallowTemplateShorthand boolean = false "check single-expression templates"
  option allow string[] = [] "shorthand operators to allow"
  let coercion_info implicit_coercion
  when coercion_info != null
  when coercion_info.kind == "boolean" && boolean || coercion_info.kind == "number" && number || coercion_info.kind == "string" && string || coercion_info.kind == "template" && disallowTemplateShorthand
  when coercion_info.kind == "template" || !contains(allow, coercion_info.operator)
  warn "Unexpected implicit coercion encountered. Use `{coercion_info.recommendation}` instead."
}

in ts_parameter rule default-param-last {
  when parent is (ts_function, ts_arrow, ts_method) && (init != null || optional != null)
  when any(slice(parent.parameter_required, index + 1), p => p == true)
  warn "Default parameters should be last."
}

in ts_function, ts_arrow rule func-style {
  option style ("declaration" | "expression") = "expression" "function syntax policy"
  option allowArrowFunctions boolean = false "allow arrow expressions"
  option allowTypeAnnotation boolean = false "allow annotated function variables"
  option overrides { namedExports: "" | "declaration" | "expression" | "ignore" } = { namedExports: "" } "named export policy"
  let function_info function_style
  when function_info != null && !function_info.exempt
  let requested_style if function_info.exported && overrides.namedExports != "" then overrides.namedExports else style
  when requested_style == "expression" && function_info.declaration || requested_style == "declaration" && !function_info.declaration && !(function_info.arrow && (allowArrowFunctions || function_info.captures)) && !(allowTypeAnnotation && function_info.annotated)
  report at function_info.offset
  warn "Expected a function {requested_style}."
}

in ts_switch let empty_switch count(case) == 0
in ts_block, ts_switch rule no-empty {
  option allowEmptyCatch boolean = false "allow empty catch blocks"
  when parent not (ts_function_like, ts_static_block)
  when !allowEmptyCatch || not ts_try.handler
  let empty_start if is ts_switch then opener.ts_open_brace.offset else offset
  when empty_start != null
  when if is ts_switch then empty_switch && !any(descendants(ts_comment), comment => comment.offset > empty_start && comment.end_offset < end_offset) else uncommented_empty_block
  report at empty_start
  warn "Empty {if is ts_switch then 'switch' else 'block'} statement."
}

in ts_block rule no-lone-blocks {
  let nested parent is ts_block
  when nested || parent is ts_program || parent is ts_case && count(parent.body) != 1
  when nested && count(parent.body) == 1 || !any([] body.node, statement => if statement is ts_variable_declaration then statement.kind != "var" else statement is ts_class || statement is ts_function && statement.scoping_strict_code)
  warn if nested then "Nested block is redundant." else "Block is redundant."
}

in ts_if rule no-lonely-if {
  when parent.else_block == true && parent.statement_count == 1
  when !(unmatched_tail && parent.enclosing_else_boundary == true)
  warn "Unexpected if as the only statement in an else block."
}

in ts_if, ts_conditional rule no-negated-condition {
  when is ts_conditional || alternate != null && alternate not ts_if
  when test.negative_test == true
  warn "Unexpected negated condition."
}

in ts_switch rule default-case {
  option commentPattern regex | null = null "comments that allow a missing default"
  when count(case) > 0 && !any([] case.node, branch => branch.test.node == null)
  let case_end last([] case.end_offset)
  let final_comment last(filter(descendants(ts_comment), comment => comment.offset >= case_end && comment.end_offset < end_offset))
  when final_comment == null || !re_test(trim(final_comment.structure_comment_body), default(commentPattern, "(?i)^no default$"))
  warn "Expected a default case."
}

in ts_break, ts_continue rule no-extra-label {
  when label != null && label == get(parent.nearest_break_target, "label")
  report at label.offset
  warn "This label '{label}' is unnecessary."
}

in ts_await, ts_for_of, ts_variable_declaration rule no-await-in-loop {
  when is ts_await || asynchronous_iteration == true || async_resource_declaration == true
  when repeated_evaluation
  warn "Unexpected `await` inside a loop."
}

in ts_for_in rule guard-for-in {
  when body != null
  when body not (ts_empty, ts_if) && body.guarded_iteration != true
  warn "The body of a for-in should be wrapped in an if statement to filter unwanted properties from the prototype."
}

in ts_assignment rule no-return-assign {
  option mode ("except-parens" | "always") = "except-parens" "assignment return policy"
  let return_info return_assignment_context
  when return_info != null && (mode == "always" || parent not ts_parenthesized)
  report at return_info.offset
  warn if return_info.arrow then "Arrow function should not return assignment." else "Return statement should not contain assignment."
}

in ts_if rule no-else-return {
  option allowElseIf boolean = true "allow returning else-if branches"
  when parent is (ts_program, ts_block, ts_case) && consequent.returning_branch == true && alternate != null
  let else_report if allowElseIf then chain_else_offset else alternate.offset
  when else_report != null
  report at else_report
  warn "Unnecessary 'else' after 'return'."
}

in ts_arrow rule arrow-body-style {
  option mode ("always" | "never" | "as-needed") = "as-needed" "arrow body block policy"
  option requireReturnForObjectLiteral boolean = false "require a block for object values"
  when body != null
  let body_block body is ts_block
  let body_object if body_block then body.return_value_object == true else default(body.unwrapped_node, body.node) is ts_object
  when body_block && (mode == "never" || mode == "as-needed" && body.single_return == true && !(requireReturnForObjectLiteral && body_object)) || !body_block && (mode == "always" || mode == "as-needed" && requireReturnForObjectLiteral && body_object)
  report at body.unparen_offset
  warn if !body_block then "Expected block statement surrounding arrow body." else if body.statement_count == 0 then "Unexpected block statement surrounding arrow body; put a value of `undefined` immediately after the `=>`." else if body.single_return != true then "Unexpected block statement surrounding arrow body." else if body.return_value_braced == true then "Unexpected block statement surrounding arrow body; parenthesize the returned value and move it immediately after the `=>`." else "Unexpected block statement surrounding arrow body; move the returned value immediately after the `=>`."
}

in ts_block let uncommented_empty_block count(body) == 0 && count(descendants(ts_comment)) == 0
fn empty_function_constructor(n) = n is ts_method && n.parent is ts_class && n.key.text == "constructor" && !contains(n.modifier, "static")
fn empty_function_category(n, constructor) = if n is ts_arrow then "arrowFunctions" else if constructor then "constructors" else if n is ts_method && n.kind == "get" then "getters" else if n is ts_method && n.kind == "set" then "setters" else if contains(n.modifier, "*") then (if n is ts_method then "generatorMethods" else "generatorFunctions") else if contains(n.modifier, "async") then (if n is ts_method then "asyncMethods" else "asyncFunctions") else if n is ts_method then "methods" else "functions"
fn empty_function_decorated(n, constructor) = n is ts_method && !constructor && count(n.decorator.node) > 0

in ts_function, ts_arrow, ts_method rule no-empty-function {
  option allow string[] = [] "function categories that may be empty"
  when body.uncommented_empty_block == true
  let constructor empty_function_constructor(node)
  when !constructor || !any([] parameter.node, param => count(param.modifier) > 0)
  when !contains(allow, empty_function_category(node, constructor))
  when !(constructor && contains(modifier, "private") && (contains(allow, "privateConstructors") || contains(allow, "private-constructors")))
  when !(constructor && contains(modifier, "protected") && (contains(allow, "protectedConstructors") || contains(allow, "protected-constructors")))
  when !(empty_function_decorated(node, constructor) && contains(allow, "decoratedFunctions"))
  when !(is ts_method && !constructor && contains(modifier, "override") && contains(allow, "overrideMethods"))
  report at body.offset
  warn "Unexpected empty {default(function_name, 'function')}."
}

in ts_call rule no-useless-call {
  let method_name callee.direct_method_name
  when method_name == "call" && count(argument) > 0 || method_name == "apply" && count(argument) == 2 && default(first(slice([] argument.unwrapped_node, 1)), first(slice([] argument.node, 1))) is ts_array
  when unchanged_call_receiver(callee.invoked_receiver, first([] argument.unparenthesised_tokens), first([] argument.null_call_receiver))
  warn "Unnecessary '.{method_name}()'."
}

in ts_assignment, ts_call rule no-extend-native {
  option exceptions string[] = [] "builtins that may be extended"
  when extended_native != null && !contains(exceptions, extended_native)
  warn "{extended_native} prototype is read only, properties should not be added."
}

in ts_string rule no-multi-str {
  when re_test(text, /[\r\n\u{2028}\u{2029}]/) && parent not (ts_jsx_attribute, ts_jsx_expression, ts_jsx_element)
  warn "Multiline support is limited to browsers supporting ES5 only."
}

in ts_string, ts_template, ts_regex rule no-useless-escape {
  option allowRegexCharacters string[] = [] "allow otherwise unnecessary regex escapes"
  each escape_info in useless_escapes
  when !escape_info.regex || !contains(allowRegexCharacters, escape_info.character)
  report at escape_info.offset
  warn "Unnecessary escape character: \\{escape_info.character}."
}

in ts_regex, ts_call, ts_new rule prefer-named-capture-group {
  each capture in unnamed_regex_captures
  warn "Capture group '{capture}' should be converted to a named or non-capturing group."
}

in ts_regex rule no-div-regex {
  when re_test(text, "^/=")
  warn "A regular expression literal can be confused with '/='."
}

in ts_call, ts_new rule prefer-regex-literals {
  option disallowRedundantWrapping boolean = false "disallow constructors wrapping regex literals"
  let regex_preference regex_literal_preference
  when regex_preference != null && (!regex_preference.wrapped || disallowRedundantWrapping)
  warn regex_preference.message
}

in ts_regex, ts_call, ts_new rule require-unicode-regexp {
  option requireFlag ("u" | "v" | null) = null "require a particular unicode mode"
  let unicode_info unicode_regex_flags
  when unicode_info != null
  when if requireFlag == "u" then !re_test(unicode_info.flags, /u/) else if requireFlag == "v" then !re_test(unicode_info.flags, /v/) else !re_test(unicode_info.flags, /[uv]/)
  warn if requireFlag == "v" then "Use the 'v' flag." else "Use the 'u' flag."
}

fn strict_enclosing_function_directive(n) =
  any(walk(n.parent.node, current => current.parent.node), current => current is (ts_function, ts_arrow, ts_method) && count(current.directive_scope.directives) > 0)
fn strict_directive_message(n, scope, mode, directive) =
  if n not ts_program && !scope.simple_parameters then
    if directive == first(scope.directives) then "'use strict' directive inside a function with non-simple parameter list throws a syntax error since ES2016." else "Multiple 'use strict' directives."
  else if mode == "never" then "Strict mode is not permitted."
  else if mode == "module" then "'use strict' is unnecessary inside of modules."
  else if mode == "implied" then "'use strict' is unnecessary when implied strict mode is enabled."
  else if n is ts_program then
    if mode == "function" then "Use the function form of 'use strict'." else if directive == first(scope.directives) then null else "Multiple 'use strict' directives."
  else if mode == "global" then "Use the global form of 'use strict'."
  else if directive != first(scope.directives) then "Multiple 'use strict' directives."
  else if strict_enclosing_function_directive(n) then "Unnecessary 'use strict' directive."
  else if scope.class_body then "'use strict' is unnecessary inside of classes."
  else null
fn strict_missing(n, scope, mode) =
  if count(scope.directives) != 0 then []
  else if n is ts_program && mode == "global" && count(n.body.node) > 0 then [{ offset: first(n.body.node).offset, message: "Use the global form of 'use strict'." }]
  else if n not ts_program && mode == "function" && !scope.parent_function && !scope.class_body then [{
    offset: n.offset,
    message: if scope.simple_parameters then "Use the function form of 'use strict'." else "Wrap " default(n.function_name, "function") " in a function with 'use strict' directive."
  }]
  else []
in ts_program, ts_function, ts_arrow, ts_method rule strict {
  option mode ("safe" | "never" | "global" | "function") = "safe" "strict directive policy"
  let strict_scope directive_scope
  let strict_mode if source_type == "module" then "module" else if source_environment.implied_strict then "implied" else if mode == "safe" then if source_environment.root_function then "global" else "function" else mode
  let strict_findings reduce(strict_scope.directives, strict_missing(node, strict_scope, strict_mode), (findings, directive) => findings [{
    offset: directive.offset,
    message: strict_directive_message(node, strict_scope, strict_mode, directive)
  }])
  each strict_finding in filter(strict_findings, finding => finding.message != null)
  report at strict_finding.offset
  warn strict_finding.message
}

in ts_call rule prefer-object-has-own {
  when own_property_call
  warn "Use 'Object.hasOwn()' instead of 'Object.prototype.hasOwnProperty.call()'."
}

in ts_labeled rule no-label-var {
  when label_binding
  warn "Found identifier with same name as label."
}

group unreachable_loop ts_while, ts_do_while, ts_for, ts_for_in, ts_for_of
in unreachable_loop rule no-unreachable-loop {
  when single_iteration_loop
  warn "Invalid loop. Its body allows only one iteration."
}

fn unparenthesised_node(n) = last(walk(n, current => if current is ts_parenthesized then current.expression.node else null))
fn logical_chain_top(n) = n is (ts_member, ts_index, ts_call) && n.in_optional_chain == true && n not (ts_member.object, ts_index.object, ts_call.callee, ts_non_null.expression)
fn logical_reference(n) = n != null && !logical_chain_top(n) && (n is (ts_member, ts_index) || n is ts_identifier && n.text != "undefined")
fn logical_same_reference(a, b) = a.reference_key != null && a.reference_key == b.reference_key
fn logical_nullish(n) = if n is ts_null then false else if n is ts_identifier && n.text == "undefined" && n.resolved == "global" || n is ts_unary && n.operator == "void" && unparenthesised_node(n.argument.node) is ts_number && unparenthesised_node(n.argument.node).literal_value.value == 0 then true else null
fn logical_nullish_reference(reference, value) = if logical_reference(reference) && logical_nullish(value) != null then { reference: reference, undefined: logical_nullish(value), operator: "??" } else null
fn logical_nullish_comparison(n, op) = if n is ts_binary && n.operator == op then default(logical_nullish_reference(unparenthesised_node(n.left.node), unparenthesised_node(n.right.node)), logical_nullish_reference(unparenthesised_node(n.right.node), unparenthesised_node(n.left.node))) else null
fn logical_nullish_pair(a, b) = if a != null && b != null && a.undefined != b.undefined && logical_same_reference(a.reference, b.reference) then a else null
fn logical_boolean_existence(n, negated) = if logical_reference(n) then { reference: n, operator: if negated then "||" else "&&" } else if n is ts_unary && n.operator == "!" && logical_reference(unparenthesised_node(n.argument.node)) then { reference: unparenthesised_node(n.argument.node), operator: "&&" } else if n is ts_call && n.global_callee == "Boolean" && count(n.argument.node) == 1 && logical_reference(unparenthesised_node(first(n.argument.node))) then { reference: unparenthesised_node(first(n.argument.node)), operator: if negated then "||" else "&&" } else null
fn logical_existence(n) = default(logical_boolean_existence(unparenthesised_node(if n is ts_unary && n.operator == "!" then n.argument.node else n), n is ts_unary && n.operator == "!"), default(logical_nullish_comparison(n, "=="), if n is ts_logical && n.operator == "||" then logical_nullish_pair(logical_nullish_comparison(unparenthesised_node(n.left.node), "==="), logical_nullish_comparison(unparenthesised_node(n.right.node), "===")) else null))
fn logical_assignment_value(assigned, value) = if value is ts_logical && logical_same_reference(assigned, last(walk(value.left.node, current => if current is ts_logical && current.operator == value.operator then current.left.node else null))) then { kind: "assignment", operator: value.operator "=" } else null
fn logical_expression_value(reference, assignment, op, kind) = if logical_reference(reference) && assignment is ts_assignment && assignment.operator == "=" && logical_same_reference(reference, assignment.left.node) then { kind: kind, operator: op "=" } else null
fn logical_if_value(existence, body) = if existence != null && body is ts_expression_statement then logical_expression_value(existence.reference, unparenthesised_node(body.expression.node), existence.operator, "if") else null
fn logical_assignment_info(n) = if n is ts_assignment && contains(["&&=", "||=", "??="], n.operator) then { kind: "shorthand", operator: n.operator } else if n is ts_assignment && n.operator == "=" then logical_assignment_value(n.left.node, unparenthesised_node(n.right.node)) else if n is ts_logical then logical_expression_value(unparenthesised_node(n.left.node), unparenthesised_node(n.right.node), n.operator, "logical") else if n is ts_if && n.alternate == null then logical_if_value(logical_existence(unparenthesised_node(n.test.node)), if n.consequent is ts_block then (if count(n.consequent.body.node) == 1 then first(n.consequent.body.node) else null) else n.consequent.node) else null

in ts_assignment, ts_logical, ts_if rule logical-assignment-operators {
  option mode ("always" | "never") = "always" "logical assignment policy"
  option enforceForIfStatements boolean = false "include conditional assignments"
  when not ts_if || enforceForIfStatements
  let logical_info logical_assignment_info(node)
  when logical_info != null
  when if mode == "never" then logical_info.kind == "shorthand" else logical_info.kind != "shorthand"
  warn if mode == "never" then "Unexpected logical operator assignment ({logical_info.operator}) shorthand." else if logical_info.kind == "assignment" then "Assignment (=) can be replaced with operator assignment ({logical_info.operator})." else if logical_info.kind == "logical" then "Logical expression can be replaced with an assignment ({logical_info.operator})." else "'if' statement can be replaced with a logical operator assignment with operator {logical_info.operator}."
}

in ts_assignment rule operator-assignment {
  option mode ("always" | "never") = "always" "compound arithmetic assignment policy"
  let assigned_key left.reference_key_strict
  let shorthand if operator == "=" && right.arithmetic_operator != null && assigned_key != null && (assigned_key == right.strict_left_reference_key || contains(["*", "&", "^", "|"], right.arithmetic_operator) && assigned_key == right.strict_right_reference_key) then right.arithmetic_operator "=" else null
  when if mode == "never" then operator != "=" && !contains(["&&=", "||=", "??="], operator) else shorthand != null
  warn if mode == "never" then "Unexpected operator assignment ({operator}) shorthand." else "Assignment (=) can be replaced with operator assignment ({shorthand})."
}

in ts_binary rule yoda {
  option mode ("never" | "always") = "never" "literal comparison side"
  option exceptRange boolean = false "allow parenthesised ordered range checks"
  option onlyEquality boolean = false "apply only to equality operators"
  when contains(["==", "===", "!=", "!==", "<", ">", "<=", ">="], operator)
  when (!onlyEquality || contains(["==", "==="], operator)) && !(exceptRange && parent.logical_range == true)
  when if mode == "always" then right_literal && !left_literal else left_literal && !right_literal
  warn "Expected literal to be on the {if mode == 'always' then 'left' else 'right'} side of {operator}."
}

in ts_throw rule preserve-caught-error {
  option requireCatchParameter boolean = false "require a catch parameter when throwing a symptom error"
  option errorClassNames (string | { name: string; argumentPosition: number })[] = [] "additional error constructors and options positions"
  let caught_info caught_error_preservation
  when caught_info != null
  let configured_error find_last(errorClassNames, x => caught_info.name == (if type_of(x) == "str" then x else x.name))
  when caught_info.builtin || configured_error != null
  let cause_position if caught_info.builtin then caught_info.default_index else if type_of(configured_error) == "str" then 1 else configured_error.argumentPosition - 1
  let cause_info default(first(slice(caught_info.causes, cause_position)), caught_info.missing)
  when caught_info.catch == "destructured" || caught_info.catch == "missing" && requireCatchParameter || caught_info.catch == "present" && cause_info.checked
  report at if caught_info.catch == "destructured" then caught_info.catch_offset else if caught_info.catch == "missing" then caught_info.throw_offset else cause_info.offset
  warn if caught_info.catch == "destructured" then "Re-throws cannot preserve the caught error as a part of it is being lost due to destructuring." else if caught_info.catch == "missing" then "The caught error is not accessible because the catch clause lacks the error parameter. Start referencing the caught error using the catch parameter." else cause_info.message
}

}
