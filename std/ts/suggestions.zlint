# .ts/suggestions: eslint core "suggestion" rules (style and best
# practice, not likely bugs) on the native TypeScript layers.

import .ts/expressions
import .ts/suggestions/object-shorthand
import .ts/suggestions/curly
import .ts/suggestions/renames
import .ts/suggestions/comparisons
import .ts/suggestions/templates
import .ts/suggestions/object-spread
import .ts/suggestions/computed-keys
import .ts/expression-fixes

define {

# Statement properties stay lazy: rules request only the shape they need.
in ts_if let statement_has_else alternate != null
in ts_if let unmatched_tail alternate == null || alternate.unmatched_tail == true
in ts_for, ts_for_in, ts_for_of, ts_while, ts_with, ts_labeled let unmatched_tail body.unmatched_tail == true
in ts_if, ts_for, ts_for_in, ts_for_of, ts_while, ts_with, ts_labeled, ts_block let enclosing_else_boundary is ts_if.consequent && parent.statement_has_else == true || parent is (ts_if, ts_for, ts_for_in, ts_for_of, ts_while, ts_with, ts_labeled) && parent.enclosing_else_boundary == true
in ts_block let else_block is ts_if.alternate
in ts_block let statement_count count([] body)

in ts_return let return_end true
in ts_block let return_end last(body.nodes) is ts_return
in ts_return let branch_exit true
in ts_if let branch_exit consequent.return_end == true && alternate.return_end == true
in ts_return, ts_if let returning_branch branch_exit == true
in ts_block let returning_branch any([] body.branch_exit, r => r == true)
in ts_if let chain_else_node if consequent.returning_branch != true || alternate == null then null else if alternate is ts_if then alternate.chain_else_node else alternate.node
in ts_if let chain_else_offset chain_else_node.offset

in ts_unary let negative_test operator == "!"
in ts_binary let negative_test operator == "!=" || operator == "!=="
in ts_parenthesized let negative_test expression.negative_test == true
in ts_continue let continue_guard true
in ts_block let continue_guard count([] body) == 1 && first(body.nodes) is ts_continue
in ts_if let conditional_continue consequent.continue_guard == true
in ts_block let guarded_iteration count([] body) == 0 || first(body.nodes) is ts_if && (count([] body) == 1 || first([] body.conditional_continue) == true)

in ts_parenthesized let unwrapped_node expression.unwrapped_node.nonempty ?? expression.node
in ts_parenthesized let unwrapped_text expression.unwrapped_text.nonempty ?? expression
in ts_return let return_value_object (argument.unwrapped_node.nonempty ?? argument.node) is ts_object
in ts_return let return_value_braced { value result: "{{"; value starts_with(argument, result) }
in ts_block let single_return count([] body) == 1 && first(body.nodes) is ts_return
in ts_block let return_value_object first([] body.return_value_object) == true
in ts_block let return_value_braced first([] body.return_value_braced) == true
in ts_function let function_this uses_this
in ts_member let bind_property_offset property.offset
in ts_index let bind_property_offset index.offset
in ts_member, ts_index let bind_target if static_name != "bind" then null else if (object.unwrapped_node.nonempty ?? object.node) is ts_arrow || (object.unwrapped_node.nonempty ?? object.node) is ts_function && object.function_this != true then bind_property_offset else null
in ts_parenthesized forward function_this, bind_target from expression

in ts_throw let thrown_identifier if (argument.unwrapped_node.nonempty ?? argument.node) is ts_identifier then argument.unwrapped_text.nonempty ?? argument else null
in ts_block let first_throw first([] body.thrown_identifier)
in ts_try let catch_rethrows parameter is ts_identifier && handler.first_throw == parameter

in ts_binary let arithmetic_operator if contains(["+", "-", "*", "/", "%", "**", "<<", ">>", ">>>", "&", "|", "^"], operator) then operator else null
in ts_binary let strict_left_reference_key left.reference_key_strict
in ts_binary let strict_right_reference_key right.reference_key_strict
in ts_parenthesized forward arithmetic_operator, strict_left_reference_key, strict_right_reference_key from expression

in ts_parameter let required_parameter init == null && optional == null && name not ts_rest && !starts_with(text, "...")
in ts_function, ts_arrow, ts_method let parameter_required [] parameter.required_parameter

in ts_template let static_template count(expression) == 0
in ts_parenthesized forward static_template from expression

in ts_node let return_assignment_context if parent is ts_return then { arrow: false, offset: parent.offset } else if is ts_arrow.body then { arrow: true, offset: parent.offset } else if parent is (ts_function, ts_method, ts_arrow, ts_class, ts_block, ts_static_block, ts_expression_statement, ts_variable_declaration, ts_if, ts_for, ts_for_in, ts_for_of, ts_while, ts_do_while, ts_switch, ts_throw, ts_with, ts_labeled, ts_try, ts_export) then null else parent.return_assignment_context
in ts_variable_declaration let async_resource_declaration kind == "await using"
in ts_for_of let asynchronous_iteration contains([] modifier, "await")
in ts_labeled let declared_label label
in ts_node let repeated_evaluation if parent is ts_function_like || parent is ts_for_of && parent.asynchronous_iteration == true then false else if is (ts_for.body, ts_for.test, ts_for.update, ts_for_in.body, ts_for_of.body) || is (ts_for_in.left, ts_for_of.left) && async_resource_declaration == true || is (ts_while.body, ts_while.test, ts_do_while.body, ts_do_while.test) then true else parent.repeated_evaluation == true
in ts_node let nearest_break_target if is (ts_loop, ts_switch) then { label: if parent is ts_labeled then parent.declared_label else null } else if is ts_function_like || is ts_labeled && declared_label == get(parent.nearest_break_target, "label") then null else parent.nearest_break_target

in ts_parenthesized let inner_comparison_tokens expression.unparenthesised_tokens
in ts_node let unparenthesised_tokens if is ts_parenthesized then inner_comparison_tokens else token_texts
in ts_unary let void_operator operator == "void"
in ts_parenthesized let inner_null_receiver expression.null_call_receiver
in ts_node let null_call_receiver if is ts_parenthesized then inner_null_receiver else is ts_null || is ts_identifier && text == "undefined" || is ts_unary && void_operator == true
in ts_member, ts_index let member_receiver_tokens object.unparenthesised_tokens
in ts_member, ts_index let invoked_receiver if object == null then null else { member: (object.unwrapped_node.nonempty ?? object.node) is (ts_member, ts_index), tokens: object.member_receiver_tokens }
in ts_member let direct_method_name property
in ts_member, ts_index let called_method_name static_name
in ts_parenthesized forward member_receiver_tokens, invoked_receiver, direct_method_name, called_method_name from expression
fn unchanged_call_receiver(receiver, tokens, null_receiver) = receiver != null && (if receiver.member then receiver.tokens == tokens else null_receiver == true)

# The global `eval`, called or referenced (`(0, eval)`, `globalThis.eval`).
@macro suggestion_eval_policy {
  option allowIndirect boolean = false "allow indirect eval references and calls"
  let eval_info eval_usage
  when eval_info != null && (!allowIndirect || eval_info.direct && !eval_info.optional)
  report at eval_info.offset
  warn "`eval` can be harmful."
}
in ts_identifier rule no-eval { @suggestion_eval_policy }
in ts_member, ts_index rule no-eval:member { @suggestion_eval_policy }

# `.bind(x)` on a function that never uses `this` (or on an arrow).
fn suggestion_bind_fix(n) = {
  value wrapped_callee: n.callee.node
  value member: unparenthesised_node(wrapped_callee)
  value receiver: member.object.node
  value property_start: receiver.token_neighbours.after
  value argument_start: wrapped_callee.token_neighbours.after
  value argument: first(n.argument.nodes)
  value bare_argument: unparenthesised_node(argument)
  value region: {offset: property_start.start, end_offset: n.end_offset}
  value edits: [
    {start: property_start.start, end: member.end_offset, text: ""},
    {start: argument_start.start, end: n.end_offset, text: ""}
  ]
  value suffix: byte_slice(n.text, property_start.start - n.offset)
  value if property_start == null || argument_start == null
    || bare_argument not (ts_string, ts_number, ts_boolean, ts_null, ts_bigint, ts_regex, ts_identifier, ts_this, ts_function)
    || !expression_fix_clean(region) then null
    else {start: property_start.start, end: n.end_offset, text: expression_fix_edits(suffix, property_start.start, edits)}
}
in ts_call rule no-extra-bind {
  when count(argument) == 1 && first(argument.nodes) not ts_spread && callee.bind_target != null
  report at callee.bind_target
  warn "The function binding is unnecessary."
  let replacement suggestion_bind_fix(node)
  fix at replacement ?? node if replacement != null as replacement.text
}

in ts_new rule no-new-wrappers {
  when re_test(global_callee, /^(String|Number|Boolean)$/)
  warn "Do not use {global_callee} as a constructor."
}

in ts_string rule no-nonoctal-decimal-escape {
  each decimal_escape in nonoctal_decimal_escapes
  report at decimal_escape.offset
  warn "Don't use '{decimal_escape.text}' escape sequence."
}

# Comma operators, except loop init/update and explicitly grouped expressions.
in ts_sequence rule no-sequences {
  option allowInParentheses boolean = true "allow explicitly parenthesised sequences"
  let enclosed walk(node, current => if current.parent is ts_parenthesized then current.parent.node else null)
  let outside last(enclosed)
  when outside not (ts_for.init, ts_for.update)
  let paren_count count(enclosed) - 1
  when !allowInParentheses || paren_count == 0 || paren_count == 1 && outside is ts_arrow.body
  let comma_offset opener.ts_comma.offset
  when comma_offset != null
  report at comma_offset
  warn "Unexpected use of comma operator."
}

in ts_identifier let error_global_undefined text == "undefined" && resolved == "global" && global != "off"
in ts_parenthesized forward error_global_undefined from expression
in ts_throw rule no-throw-literal {
  when !argument.could_be_error || argument.error_global_undefined == true
  warn if argument.could_be_error then "Do not throw undefined." else "Expected an error object to be thrown."
}

in ts_declarator rule no-undef-init {
  when init == "undefined" && init.resolved == "global" && re_test(ts_variable_declaration.kind, /^(var|let)$/)
  let undef_initializer { offset: type.end_offset ?? name.end_offset, end_offset: init.end_offset }
  fix at { start: undef_initializer.offset, end: undef_initializer.end_offset } if ts_variable_declaration.kind == "let" && name is ts_identifier && expression_fix_clean(undef_initializer) as ""
  warn "It's not necessary to initialize '{name}' to undefined."
}

in ts_try rule no-useless-catch {
  when catch_rethrows && finalizer == null
  warn "Unnecessary try/catch wrapper."
}
in ts_try.kind rule no-useless-catch:clause {
  when parent.catch_rethrows && parent.finalizer != null
  warn "Unnecessary catch clause."
}

fn enabled_global_identifier(n, name) = n is ts_identifier && n.text == name && n.resolved == "global" && n.global != "off"
fn parse_int_target(n) = if enabled_global_identifier(n, "parseInt") || n is (ts_member, ts_index) && n.static_name == "parseInt" && { value n.object.node; unparenthesised_node; enabled_global_identifier "Number" } then n.text else null
in ts_call let parse_int_name { value callee.node; unparenthesised_node; parse_int_target }
fn valid_radix(value) = value.type == "number" && value.value >= 2 && value.value <= 36 && value.value % 1 == 0
fn invalid_radix(n) = n is ts_identifier && n.text == "undefined" && n.resolved == "global" || (n is (ts_number, ts_string, ts_boolean, ts_null, ts_regex, ts_bigint) || n is ts_unary && contains(["+", "-"], n.operator) && n.argument is ts_number) && !valid_radix(n.literal_value)

in ts_call rule radix {
  option mode ("always" | "as-needed") = "always" "legacy radix policy"
  when parse_int_name != null
  let argument_count count(argument)
  let first_argument { value argument.nodes; first; unparenthesised_node }
  let second_argument {
    value argument.nodes
    slice 1
    first
    unparenthesised_node
  }
  when first_argument not ts_spread && second_argument not ts_spread
  when argument_count < 2 || invalid_radix(second_argument)
  warn if argument_count == 0 then "Missing parameters." else if argument_count == 1 then "Missing radix parameter." else "Invalid radix parameter, must be an integer between 2 and 36."
}

in ts_identifier rule no-shadow-restricted-names {
  option reportGlobalThis boolean = true "include globalThis among restricted names"
  when restricted_binding && (text != "globalThis" || reportGlobalThis)
  warn "Shadowing of global property '{text}'."
}

# ---- preferences -----------------------------------------------------------------
in ts_identifier rule prefer-rest-params {
  when text == "arguments" && resolved == "local" && declaration == null && (ts_function != null || ts_method != null)
  when !(parent is ts_member && index == 0)
  warn "Use the rest parameters instead of 'arguments'."
}

in ts_call rule prefer-spread {
  when callee.called_method_name == "apply" && count(argument) == 2
  let second_argument_node {
    value [] argument.unwrapped_node
    slice 1
    first
    nonempty
  } ?? { value argument.nodes; slice 1; first }
  when second_argument_node not (ts_array, ts_spread)
  when {
    value [] argument.unparenthesised_tokens
    tokens: first
    value [] argument.null_call_receiver
    null_receiver: first
    value unchanged_call_receiver(callee.invoked_receiver, tokens, null_receiver)
  }
  warn "Use the spread operator instead of '.apply()'."
}

in ts_case rule default-case-last {
  when test == null && index < count(parent.case) - 1
  warn "Default clause should be the last clause."
}

fn array_constructor_fix(source, n) = {
  value open: {
    value overlapping(ts_open_paren, n.callee.end_offset, n.end_offset)
    find (token) token.paired_token.end == n.end_offset
  }
  value arguments: if open != null then byte_slice(source, open.end_offset, open.paired_token.start) else ""
  value replacement: "[" arguments "]"
  value if open == null && count(n.argument) > 0 || !expression_fix_retains_comments(n, replacement) then null else replacement
}
in ts_call, ts_new rule no-array-constructor {
  when global_callee == "Array" && count(type_argument) == 0
  when count(argument) != 1 || { value argument; first; re_test /^\.\.\./ }
  warn "The array literal notation [] is preferable."
  let replacement array_constructor_fix(source, node)
  fix at node if replacement != null as replacement
}

in ts_call, ts_new rule no-object-constructor {
  when global_callee == "Object" && count(argument) == 0
  warn "The object literal notation {{}} is preferable."
}

in ts_expression_statement.expression rule no-new {
  when is ts_new
  warn "Do not use 'new' for side effects."
}

in ts_binary rule no-self-compare {
  when re_test(operator, /^(?:===?|!==?|>=?|<=?)$/)
  when left != null && right != null && left.unparenthesised_tokens == right.unparenthesised_tokens
  warn "Comparing to itself is potentially pointless."
}

in ts_with rule no-with warn "Unexpected use of 'with' statement."

in ts_member, ts_index rule no-proto {
  when static_name == "__proto__"
  warn "The '__proto__' property is deprecated."
}

in ts_member, ts_index rule no-iterator {
  when static_name == "__iterator__"
  warn "Reserved name '__iterator__'."
}

in ts_string, ts_template rule no-script-url {
  when literal_value.type == "string" && re_test(literal_value.value, /(?i)^javascript:/)
  when parent not ts_tagged_template
  warn "Script URL is a form of eval."
}

in ts_binary rule no-eq-null {
  when (operator == "==" || operator == "!=") && (left == "null" || right == "null")
  warn "Use '===' to compare with null."
}

in ts_call rule symbol-description {
  when callee == "Symbol" && callee.resolved == "global" && count(argument) == 0
  warn "Expected Symbol to have a description."
}

in ts_call rule prefer-numeric-literals {
  when count(argument) == 2 && parse_int_name != null
  when first([] argument.literal_value).type == "string"
  when { value argument; last_argument: last; value contains(["2", "8", "16"], last_argument) }
  warn "Use {if last(argument) == '2' then 'binary' else if last(argument) == '8' then 'octal' else 'hexadecimal'} literals instead of {parse_int_name}()."
  let literal first(argument.nodes)
  let base last(argument)
  let digits literal.literal_value.value
  let valid_digits if base == "2" then /\A[01]+\z/ else if base == "8" then /\A[0-7]+\z/ else /\A[0-9a-fA-F]+\z/
  let replacement (if base == "2" then "0b" else if base == "8" then "0o" else "0x") digits
  fix if (literal is ts_string || literal is ts_template && count(literal.expression) == 0) && re_test(digits, valid_digits) && expression_fix_clean(node) as expression_fix_edges(node, replacement)
}

in ts_string let octal_escape {
  value text
  re_find /(?:^|[^\\])(?:\\\\)*\\(?:[0-3][0-7]{1,2}|[4-7][0-7]|0[89]|[1-7])/
  re_find /\\(?:[0-3][0-7]{1,2}|[4-7][0-7]|0[89]|[1-7])$/
}
in ts_string rule no-octal-escape {
  when octal_escape != null
  warn "Don't use octal: '{if re_test(octal_escape, /^\\0[89]$/) then '\\0' else octal_escape}'. Use '\\u....' instead."
}

fn concat_endpoint_next(n, right_side) = if n is ts_parenthesized then n.expression.node else if n is ts_binary && n.operator == "+" then (if right_side then n.right.node else n.left.node) else null
fn concat_endpoint(n, right_side) = { value n; walk (current) concat_endpoint_next(current, right_side); last }

in ts_binary rule no-useless-concat {
  when operator == "+"
  let left_endpoint concat_endpoint(left.node, true)
  let right_endpoint concat_endpoint(right.node, false)
  when left_endpoint is (ts_string, ts_template) && right_endpoint is (ts_string, ts_template)
  when !{ value source; byte_slice left_endpoint.end_offset right_endpoint.offset; re_test /[\r\n\u{2028}\u{2029}]/ }
  report at operator.offset
  warn "Unexpected string concatenation of literals."
}

fn ternary_fix_inverse(operand) = {
  value bare: unparenthesised_node(operand)
  value inverse: if bare is ts_binary then get({ "==": "!=", "!=": "==", "===": "!==", "!==": "===" }, bare.operator) else null
  value if inverse != null then byte_slice(bare.text, 0, bare.operator.offset - bare.offset) inverse byte_slice(bare.text, bare.operator.end_offset - bare.offset)
    else "!" expression_fix_wrap(operand.text, bare.precedence < 15)
}
fn ternary_fix_boolean(n, consequent, alternate) = {
  value operand: n.test.node
  value bare: unparenthesised_node(operand)
  value if consequent == alternate then if bare is ts_identifier then consequent else null
    else if alternate == "true" then ternary_fix_inverse(operand)
    else if bare is ts_binary && contains(["==", "===", "!=", "!==", ">", ">=", "<", "<=", "in", "instanceof"], bare.operator)
      || bare is ts_unary && bare.operator == "!" then operand.text
    else "!" ternary_fix_inverse(operand)
}

in ts_conditional rule no-unneeded-ternary {
  let consequent_value consequent.literal_value
  let alternate_value alternate.literal_value
  when consequent_value.type == "boolean" && alternate_value.type == "boolean"
  warn "Unnecessary use of boolean literals in conditional expression."
  let replacement ternary_fix_boolean(node, consequent_value.value, alternate_value.value)
  fix if replacement != null && expression_fix_retains_comments(node, replacement)
    && unparenthesised_node(consequent.node) is ts_boolean && unparenthesised_node(alternate.node) is ts_boolean as expression_fix_edges(node, replacement)
}

in ts_conditional rule no-unneeded-ternary:default-assignment {
  option defaultAssignment boolean = true "allow conditional expressions used as default assignments"
  when !defaultAssignment && (test.unwrapped_node.nonempty ?? test.node) is ts_identifier && (consequent.unwrapped_node.nonempty ?? consequent.node) is ts_identifier && (test.unwrapped_text.nonempty ?? test) == (consequent.unwrapped_text.nonempty ?? consequent)
  warn "Unnecessary use of conditional expression for default assignment."
  let operand alternate.node
  let bare unparenthesised_node(operand)
  let grouped operand not ts_parenthesized && (bare.precedence < 4 || bare is (ts_as, ts_satisfies, ts_type_assertion) || bare is ts_logical && bare.operator == "??")
  let replacement test " || " expression_fix_wrap(operand.text, grouped)
  fix if expression_fix_retains_comments(node, replacement) as expression_fix_edges(node, replacement)
}

in ts_member, ts_index rule no-console {
  option allow string[] = [] "console methods to allow"
  when object == "console" && object.resolved == "global" && !contains(allow, static_name)
  warn if count(allow) == 0 then "Unexpected console statement." else "Unexpected console statement. Only these console methods are allowed: {join(allow, ', ')}."
}

in ts_member, ts_index let global_function_method object == "Function" && object.resolved == "global" && contains(["apply", "bind", "call"], static_name)
in ts_parenthesized let global_function_method expression.global_function_method
in ts_call, ts_new rule no-new-func {
  when callee == "Function" && callee.resolved == "global" || callee.global_function_method == true
  warn "The Function constructor is eval."
}

in ts_method, ts_method_signature rule accessor-pairs {
  option getWithoutSet boolean = false "require a setter for each getter"
  option setWithoutGet boolean = true "require a getter for each setter"
  option enforceForClassMembers boolean = true "check class accessors"
  option enforceForTSTypes boolean = false "check type accessors"
  when accessor_pair != null && !accessor_pair.paired
  when accessor_pair.scope == "object" || accessor_pair.scope == "class" && enforceForClassMembers || accessor_pair.scope == "type" && enforceForTSTypes
  when accessor_pair.kind == "get" && getWithoutSet || accessor_pair.kind == "set" && setWithoutGet
  report at accessor_pair.offset
  warn "{if accessor_pair.kind == 'set' then 'Getter' else 'Setter'} is not present for {if accessor_pair.scope == 'class' then 'class ' else if accessor_pair.scope == 'type' then 'type ' else ''}{accessor_pair.name}."
}

in ts_object rule accessor-pairs:descriptor {
  option getWithoutSet boolean = false "require a setter for each getter"
  option setWithoutGet boolean = true "require a getter for each setter"
  when property_descriptor != null
  when setWithoutGet && property_descriptor.set && !property_descriptor.get || getWithoutSet && property_descriptor.get && !property_descriptor.set
  warn "{if property_descriptor.set then 'Getter' else 'Setter'} is not present in property descriptor."
}

in ts_method, ts_method_signature rule grouped-accessor-pairs {
  option mode ("anyOrder" | "getBeforeSet" | "setBeforeGet") = "anyOrder" "accessor order"
  option enforceForTSTypes boolean = false "check type accessors"
  let group_info accessor_pair.grouping
  when accessor_pair.scope != "type" || enforceForTSTypes
  when group_info != null && (group_info.gap || mode == "getBeforeSet" && !group_info.getter_first || mode == "setBeforeGet" && group_info.getter_first)
  report at accessor_pair.offset
  warn if group_info.gap then "Accessor pair {group_info.former} and {accessor_pair.name} should be grouped." else "Expected {accessor_pair.name} to be before {group_info.former}."
}

in ts_unary, ts_binary, ts_assignment, ts_template rule no-implicit-coercion {
  option boolean boolean = true "check boolean conversions"
  option number boolean = true "check number conversions"
  option string boolean = true "check string conversions"
  option disallowTemplateShorthand boolean = false "check single-expression templates"
  option allow string[] = [] "shorthand operators to allow"
  let coercion_info implicit_coercion
  when coercion_info != null
  when coercion_info.kind == "boolean" && boolean || coercion_info.kind == "number" && number || coercion_info.kind == "string" && string || coercion_info.kind == "template" && disallowTemplateShorthand
  when coercion_info.kind == "template" || !contains(allow, coercion_info.operator)
  warn "Unexpected implicit coercion encountered. Use `{coercion_info.recommendation}` instead."
}

in ts_parameter rule default-param-last {
  when parent is (ts_function, ts_arrow, ts_method) && (init != null || optional != null)
  when { value parent.parameter_required; slice (index + 1); any (p) p == true }
  warn "Default parameters should be last."
}

in ts_function, ts_arrow rule func-style {
  option style ("declaration" | "expression") = "expression" "function syntax policy"
  option allowArrowFunctions boolean = false "allow arrow expressions"
  option allowTypeAnnotation boolean = false "allow annotated function variables"
  option overrides { namedExports: "" | "declaration" | "expression" | "ignore" } = { namedExports: "" } "named export policy"
  let function_info function_style
  when function_info != null && !function_info.exempt
  let requested_style if function_info.exported && overrides.namedExports != "" then overrides.namedExports else style
  when requested_style == "expression" && function_info.declaration || requested_style == "declaration" && !function_info.declaration && !(function_info.arrow && (allowArrowFunctions || function_info.captures)) && !(allowTypeAnnotation && function_info.annotated)
  report at function_info.offset
  warn "Expected a function {requested_style}."
}

in ts_switch let empty_switch count(case) == 0
in ts_block, ts_switch rule no-empty {
  option allowEmptyCatch boolean = false "allow empty catch blocks"
  when parent not (ts_function_like, ts_static_block)
