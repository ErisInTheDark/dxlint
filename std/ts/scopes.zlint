# .ts/scopes: rules on names and their uses.

define {

# Each binding belongs to one variant; arrays have their own name policy.
in ts_identifier let no_unused_vars_checked unused_var.setter != true
in ts_identifier let no_unused_vars_ignored null
in ts_identifier let unused_binding_context if unused_var.array_element || unused_var.array_target then "array" else unused_var.def
fn unused_binding_names(context) = if context == "array" then "elements of array destructuring"
  else if context == "catch" then "caught errors" else if context == "parameter" then "args" else "vars"

@macro unused_binding_options {
  option ignorePattern regex = "" "names allowed to be unused"
  option reportUsedIgnorePattern boolean = false "report ignored names that are used"
}

@macro unused_binding_checks(context, after_used) {
  let summary ts_usage_summary
  when summary != null && (!summary.used || reportUsedIgnorePattern)
  let u unused_var
  when u != null && no_unused_vars_checked && unused_binding_context == context
  let policy if type_of(no_unused_vars_ignored) == "null" then ignorePattern else no_unused_vars_ignored
  let pattern if type_of(policy) == "str" then policy else ""
  let ignored ts_usage_ignored(node, pattern)
  let used_ignored ignored && reportUsedIgnorePattern && u.used
  when used_ignored || !ignored && !u.used && !u.exported && !u.silent && !(after_used && u.before_used_param)
  let names unused_binding_names(context)
  report at if used_ignored then u.ignored_report_site else u.report_site
  warn if used_ignored then "'{text}' is marked as ignored but is used{if pattern != '' then '. Used ' names ' must not match /' pattern '/u' else ''}."
    else "'{text}' is {u.action} but {if u.only_type then 'only used as a type' else 'never used'}{if pattern != '' then '. Allowed unused ' names ' must match /' pattern '/u' else ''}."
}

in ts_identifier rule no-unused-vars:variables {
  @unused_binding_options
  option enableAutofixRemoval { imports?: boolean } = {} "remove unused import bindings"
  @unused_binding_checks("variable", false)
  let removal if enableAutofixRemoval.imports == true && !used_ignored then ts_usage_import_removal(source, node, pattern) else null
  fix at removal if removal != null as ""
}
in ts_identifier rule no-unused-vars:parameters {
  @unused_binding_options
  default option mode enum(all, after-used) = after-used "which unused parameters to check"
  @unused_binding_checks("parameter", mode == "after-used")
}
in ts_identifier rule no-unused-vars:caught-errors {
  @unused_binding_options
  @unused_binding_checks("catch", false)
}
in ts_identifier rule no-unused-vars:array-elements {
  @unused_binding_options
  @unused_binding_checks("array", false)
}

# `/* global a */` names nothing reads.
in ts_program rule no-unused-vars:globals {
  option vars "all" | "local" = "all" "`local`: skip the global scope of scripts"
  when vars == "all"
  each g in unused_globals
  report at { start: g.offset, end: g.offset + byte_len(g.name) }
  warn "'{g.name}' is defined but never used."
}

}
