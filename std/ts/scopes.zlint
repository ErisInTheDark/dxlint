# .ts/scopes: rules on names and their uses (bindings), on the native
# TypeScript layers.

define {

# ---- no-unused-vars (typescript-eslint) ----------------------------------------
# Unused parameters are reported whatever comes after them (no "after-used").
in ts_identifier rule no-unused-vars {
  option varsIgnorePattern regex = "" "variable names allowed to be unused"
  option argsIgnorePattern regex = "" "parameter names allowed to be unused"
  when uses != null && uses - self_uses == 0 && !exported && !ambient && !(file ~ /.*\.d\.ts/)
  when !contains(["function_name", "class_name", "type_parameter"], declaration_kind)
  when if declaration_kind == "parameter" then argsIgnorePattern == "" || !re_test(text, argsIgnorePattern) else varsIgnorePattern == "" || !re_test(text, varsIgnorePattern)
  warn "'{text}' is {if writes > 0 || declaration_kind ~ /var|let|const|using/ && ts_declarator.init != null then 'assigned a value' else 'defined'} but never used.{if declaration_kind == 'parameter' && argsIgnorePattern != '' then ' Allowed unused args must match /' argsIgnorePattern '/u.' else if declaration_kind != 'parameter' && declaration_kind != 'catch' && varsIgnorePattern != '' then ' Allowed unused vars must match /' varsIgnorePattern '/u.' else ''}"
}

}
