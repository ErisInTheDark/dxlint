# Declaration documentation policy.

import .ts/type-specifiers
import .ts/constants

define {
fn deprecation_tag(doc) =
  if doc == null || !re_test(doc, /(?m)^@deprecated\b/) then null
  else {reason: {
    value doc
    re_find /(?m)^@deprecated[^\n]*(?:\n[^@\n][^\n]*)*/
    re_replace /^@deprecated[ \t]*/ ''
    trim
  }}
fn deprecation_first(docs) = {
  value docs
  map (doc) deprecation_tag(doc)
  filter (reason) reason != null
  first
}
fn deprecation_leading_doc(leading) = {
  value doc: if leading == null then null else re_find(leading, /\/\*\*(?:[^*]|\*+[^*/])*\*\/\s*$/)
  value if doc == null then null else {
    value doc
    re_replace /^\s*\/\*\*/ ""
    re_replace /\*\/\s*$/ ""
    re_replace /\r\n?/ "\n"
    re_replace /(?m)^[ \t]*\*?[ \t]?/ ""
    trim
  }
}
fn deprecation_doc(n, site) = {
  value owners: walk([site], current => {
    value parent: site_parent(n, current)
    value if parent != null && (parent.kind == "ts_export"
      || current.kind == "ts_identifier" && parent.kind == "ts_declarator"
      || current.kind == "ts_declarator" && parent.kind == "ts_variable_declaration")
      then parent else null
  })
  value first(filter(map(owners, owner => deprecation_leading_doc(site_text(n, owner).leading)),
    doc => doc != null))
}
fn deprecation_local_doc(n) = {
  value owner: find(walk([] n.declaration, current =>
    if current is (ts_declarator, ts_identifier) then current.parent.node else null),
    current => current is ts_variable_declaration)
  value if owner == null then null else deprecation_leading_doc(owner.gap_before ?? owner.text_before)
}
fn deprecation_subject(n) = if n is ts_member.property then n.parent.node
  else if n.deprecation_shorthand then n.declaration else n
fn deprecation_pattern_source(pattern) = {
  value path: walk(pattern, current =>
    if current is (ts_pattern_property.value, ts_property.value) then current.parent.parent.node
    else if current is (ts_array_pattern.element, ts_array.element, ts_assignment_pattern.left, ts_parenthesized.expression)
      then current.parent.node else null)
  value root: last(path)
  value source: if root is ts_declarator.name then root.parent.init.node
    else if root is ts_parameter.name then root.parent.type.node ?? root.parent.init.node
    else if root is ts_assignment.left then root.parent.right.node else null
  value fold(reverse(path), source, (receiver, current) =>
    if current is (ts_pattern_property.value, ts_property.value) then
      value_lookup(receiver, ts_value_key(current.parent.key.node)).member
    else if current is (ts_array_pattern.element, ts_array.element) then
      value_lookup(receiver, index_of(current.parent.element.nodes, current)).member
    else receiver)
}
fn deprecation_symbols(n) = {
  value subject: deprecation_subject(n)
  value pattern: subject.deprecation_pattern_key
  value member: subject is (ts_member, ts_index) || pattern
  value binding: if member then null else name_binding(subject)
  value key: if pattern then ts_value_key(subject)
    else if subject is ts_index then subject.static_name ?? value_key(subject.index.node)
    else if subject is ts_member then subject.static_name else binding.key
  value name: if type_of(key) == "str" then key else if subject is ts_index then ts_runtime_string(subject.index.node) else null
  value receiver: if pattern then deprecation_pattern_source(subject.parent.parent.node) else subject.object.node
  value lookup: if member && name != null then value_lookup(receiver, name) else null
  value declaration: if member then null else declaration_identity(subject)
  value sites: if member then unique(flat_map(lookup.alternatives ?? [], alternative =>
    map(alternative.sources ?? [], source => source.site)))
    else if declaration != null then [declaration] else []
  value complete: name != null && (if member then lookup.alternatives != null
    && count(lookup.alternatives) > 0 && all(lookup.alternatives, alternative =>
      alternative.matched && alternative.sources != null && count(alternative.sources) > 0)
    else binding != null && binding.node.imported_name == null && declaration != null)
  value {name: name, sites: sites, complete: complete}
}
fn deprecation_value_allowed(entries, n) = if count(entries) == 0 then false else {
  value symbols: deprecation_symbols(n)
  value directory: if any(entries, entry => entry.from == "file") then program_directory(n) else null
  value states: flat_map(entries, entry => map(symbols.sites, site =>
    type_specifier_site(entry, n, site, symbols.name, directory)))
  value if any(states, state => state == true) then true
    else if !symbols.complete || any(states, state => state == null) then null else false
}
fn deprecation_call(n) = {
  value chain: walk([n], current => if current.parent is (ts_parenthesized, ts_non_null, ts_instantiation)
    then current.parent.node else null)
  value callee: find(chain, current => current is (ts_call.callee, ts_new.callee, ts_tagged_template.tag))
  value callee.parent.node
}
fn deprecation_reason(n) = {
  value subject: deprecation_subject(n)
  value call: deprecation_call(subject)
  value selection: if call != null then call_selection(call) else null
  value roots: value_sources(subject)
  value sites: walk(roots.sites ?? [], site =>
    if contains(["ts_declarator", "ts_parameter"], site.kind) then []
    else site_sources(subject, site).sites ?? [])
  value members: if subject is (ts_member, ts_index) || subject.deprecation_pattern_key then deprecation_symbols(subject).sites else []
  value origin: declaration_identity(subject)
  value declarations: unique([] members (if origin != null then [origin] else []) sites)
  value owners: if call == null then declarations else filter(roots.sites ?? [], site =>
    !contains(["ts_function", "ts_arrow", "ts_method", "ts_function_type", "ts_method_signature", "ts_call_signature"], site.kind))
  value signatures: if call != null && selection != null && !selection.uncertain && count(selection.selected) == 1
    then selection.selected else []
  value docs: map(unique([] signatures owners), site => deprecation_doc(subject, site))
  value deprecation_first([deprecation_local_doc(subject)] docs)
}

in ts_node let deprecation_import
  if is (ts_import, ts_import_equals) then true
  else if is (ts_program, ts_block, ts_function, ts_arrow, ts_class, ts_interface) then false
  else parent.deprecation_import == true
in ts_node let deprecation_pattern_key is ts_pattern_property.key || is ts_property.key && parent.flow_destructuring_target
in ts_node let deprecation_shorthand is ts_property.key && parent.value.node == null && !deprecation_pattern_key
in ts_node let deprecation_excluded
  deprecation_import || uses != null && !deprecation_pattern_key || is (ts_function.name, ts_class.name, ts_interface.name, ts_type_alias.name, ts_enum.name, ts_namespace.name, ts_method.key, ts_class_property.key, ts_property_signature.key, ts_method_signature.key) || is ts_property.key && !deprecation_shorthand && !deprecation_pattern_key || is (ts_enum_member.name, ts_parameter.name, ts_type_parameter.name, ts_import_equals.name, ts_export_specifier.exported, ts_jsx_closing.name, ts_index.index)
in ts_index let deprecation_key index.node
in ts_node let deprecation_export_name if is ts_export_specifier.local then parent.exported.node ?? node else null
in ts_node let no_deprecated_checked true

in ts_identifier, ts_private_name, ts_super, ts_jsx_attribute.name, ts_index, ts_pattern_property.key, ts_property.key rule no-deprecated {
  option allow (string | type_specifier_file | type_specifier_lib | type_specifier_package)[] = [] "Allowed deprecated symbols"
  when !deprecation_excluded
  when deprecation_export_name == null || deprecation_export_name is ts_identifier
  let computed is ts_index
  let tag deprecation_reason(node)
  when tag != null
  when no_deprecated_checked
  when deprecation_value_allowed(allow, node) == false
  report at if computed then deprecation_key else deprecation_export_name ?? node
  warn "`" (deprecation_export_name.identifier_name ?? deprecation_symbols(node).name ?? identifier_name) "` is deprecated." (if tag.reason == "" then "" else " " tag.reason)
}
}
