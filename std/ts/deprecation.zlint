# Declaration documentation policy.

import .ts/type-specifiers

define {
fn deprecation_tag(doc) =
  if doc == null || !re_test(doc, /(?m)^@deprecated\b/) then null
  else {reason: trim(re_replace(re_find(doc, /(?m)^@deprecated[^\n]*(?:\n[^@\n][^\n]*)*/), /^@deprecated[ \t]*/, ''))}
fn deprecation_first(docs) = first(filter(map(docs, doc => deprecation_tag(doc)), reason => reason != null))
fn deprecation_declarations(declarations) = first(filter(map(declarations, declaration => deprecation_first(if declaration.kind == "class" then [declaration.doc] else [declaration.doc] declaration.signature_docs)), reason => reason != null))
fn deprecation_reason(metadata, computed) =
  if deprecation_first(map(metadata.aliases, alias => alias.doc)) != null then deprecation_first(map(metadata.aliases, alias => alias.doc))
  else if !computed && metadata.selected_signature != null && count(metadata.declarations) > 0 && all(metadata.declarations, declaration => contains(["function", "method"], declaration.kind)) then deprecation_tag(metadata.selected_signature.doc)
  else if deprecation_declarations(metadata.declarations) != null then deprecation_declarations(metadata.declarations)
  else deprecation_tag(metadata.selected_signature.doc)
fn deprecation_allowed(names, metadata) =
  any(metadata.declarations, declaration => any(declaration.provenance, gate => contains(names, gate.name)))

in ts_node let deprecation_import
  if is (ts_import, ts_import_equals) then true
  else if is (ts_program, ts_block, ts_function, ts_arrow, ts_class, ts_interface) then false
  else parent.deprecation_import == true
in ts_node let deprecation_shorthand is ts_property.key && parent.value.node == null
in ts_node let deprecation_excluded
  deprecation_import || uses != null && !(is ts_pattern_property.key) || is (ts_function.name, ts_class.name, ts_interface.name, ts_type_alias.name, ts_enum.name, ts_namespace.name, ts_method.key, ts_class_property.key, ts_property_signature.key, ts_method_signature.key) || is ts_property.key && !deprecation_shorthand || is (ts_enum_member.name, ts_parameter.name, ts_type_parameter.name, ts_import_equals.name, ts_export_specifier.local, ts_jsx_closing.name, ts_index.index)
in ts_index let deprecation_key index.node
in ts_node let deprecation_metadata if deprecation_shorthand then declaration.symbol_metadata else symbol_metadata
in ts_node let no_deprecated_checked true

in ts_identifier, ts_private_name, ts_super, ts_jsx_attribute.name, ts_index rule no-deprecated {
  option allow string[] = [] "Allowed deprecated symbols"
  when !deprecation_excluded
  let metadata deprecation_metadata
  when !(is ts_export_specifier.exported) || deprecation_tag(metadata.own_doc) == null
  let computed is ts_index
  let tag deprecation_reason(metadata, computed)
  when tag != null
  when no_deprecated_checked
  when if computed then !type_is_allowed(allow, object.type_specifier_groups) else !deprecation_allowed(allow, metadata)
  report at if computed then deprecation_key else node
  warn "`" metadata.name "` is deprecated." (if tag.reason == "" then "" else " " tag.reason)
}
}
