import .ts/values/enums
import .ts/values/arguments
import .ts/values/inspection

define {

# A primitive intersected with an object type stays (a branded `string &
# { tag }`, `string & number[]`); only nullish values exclude objects.
exclusive null, undefined, string, number, boolean, bigint, symbol
exclusive null, undefined, object
exclusive falsy, truthy
exclusive thenable, nonthenable
# TypeScript's `object` keyword takes every non-primitive: a shape with members is one.
trait shaped implies object
top unknown
dynamic any
keys text string, nonthenable
keys ordinal number, nonthenable
keys symbol symbol, nonthenable
keys truthiness truthy falsy
apparent number inherits instance "Number"
apparent string inherits instance "String"
apparent boolean inherits instance "Boolean"
apparent bigint inherits instance "BigInt"
apparent symbol inherits instance "Symbol"
apparent callable inherits instance "Function"
product ts_tuple items fits object, truthy, tuple as { kind: "tuple" } inherits instance "Array" of ...items readonly inherits instance "ReadonlyArray" of ...items optional trait undefined, nullable, falsy, nonthenable count "length"
product ts_array items fits object, truthy, array as { kind: "array" } inherits instance "Array" of ...items readonly inherits instance "ReadonlyArray" of ...items

in ts_program { fits object, truthy in module }
in ts_namespace {
  unwraps trait unknown for type
  let ts_value_namespace_runtime ts_namespace_runtime(node)
  when ts_value_namespace_runtime {
    unwraps scope namespace from it
    fits object, truthy in namespace
  }
  when !ts_value_namespace_runtime { unwraps unknown }
}

fn ts_value_key(key) = {
  value literal: if key is ts_computed_key then key.expression.node else key
  value allowed: key not ts_computed_key || literal is (ts_string, ts_number, ts_bigint, ts_boolean, ts_null)
    || literal is ts_template && count(literal.expression.nodes) == 0
  value if !allowed then null
    else if literal is ts_string then js_string(literal.text)
    else if literal is ts_template && count(literal.expression.nodes) == 0 then js_string_parts(literal.text).text
    else if literal is ts_number then "" literal.ts_value_number
    else if literal is ts_bigint then js_bigint(literal.text)
