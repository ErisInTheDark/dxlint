fn ts_value_fresh_literal(n, part) = {
  value {node: unparenthesised_node(n), seen: []}
  walk (entry) if contains(entry.seen, entry.node) then [] else {
    value children: ts_value_fresh_step(entry.node, part).children
    value map(children, child => {node: unparenthesised_node(child), seen: entry.seen [entry.node]})
  }
  all (entry) !contains(entry.seen, entry.node) && ts_value_fresh_step(entry.node, part).valid
