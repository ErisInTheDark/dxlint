}
in ts_template {
  # An element access types its template key as a template literal type:
  # literal holes make it one literal key (`foo[`ba${"zz"}`]` reads `bazz`).
  let ts_value_template_key if is ts_index.index && count(expression.nodes) > 0 then ts_value_template_text(node) else null
  when !(is ts_tagged_template.quasi) {
    fits string
    widens (trait string, truthy) | (trait string, falsy)
    fits falsy when count(expression.nodes) == 0 && text == "``"
    fits truthy when count(expression.nodes) == 0 && text != "``"
    when type_of(ts_value_template_key) == "str" {
      fits literal
      identity ts_value_template_key
