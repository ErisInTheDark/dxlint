# One alternative of the library's `Promise` and declarations merged into it
# (not a subclass: its first type argument need not be what it resolves to).
fn ts_value_lib_promise(n) = {
  value arms: value_parts(n)
  value arms != null && count(arms) == 1
    && any(first(arms).parts, part => ts_value_builtin_part(part, n, ["Promise"]) == true)
    && all(first(arms).parts, part => part.carrier.description.name == "Promise")
