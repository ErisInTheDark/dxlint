# function expression has a contextual type is read from where it stands:
# asking for its expected value would re-enter call selection.
fn ts_value_uncontextual(f) = {
  value holder: if f is ts_method then f.parent.node else f
  value at: last(walk(holder, item => if item.parent is ts_parenthesized then item.parent.node else null))
