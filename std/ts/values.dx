}
fn ts_value_const_context(n) = {
  value chain: walk(n, item => if item.parent is (ts_parenthesized, ts_array, ts_object, ts_spread, ts_property) then item.parent.node else null)
  value outer: last(chain).parent.node
  value outer is (ts_as, ts_type_assertion) && outer.type.text == "const"
}
fn ts_value_destructuring_receiver(n) = {
  value path: walk(n, current => if current is (ts_parenthesized.expression, ts_array.element) then current.parent.node else null)
  value terminal: last(path)
  value receiver: if terminal is (ts_declarator.init, ts_parameter.init) then terminal.parent.name.node
    else if terminal is (ts_assignment.right, ts_assignment_pattern.right) then terminal.parent.left.node else null
  value fold(reverse(path), receiver, (target, current) => if current is ts_array.element then {
    value position: index_of(current.parent.element.nodes, current)
    value { value target.element.nodes; slice position (position + 1); first }
  } else target)
}
fn ts_value_tuple_context(n) = {
  value receiver: ts_value_destructuring_receiver(n)
  value n.flow_destructuring_target || receiver is (ts_array, ts_array_pattern)
    || !any(n.element.nodes, item => item is ts_spread)
      && (ts_value_const_context(n) || value_has_expected(n) && n.expected could tuple)
}
fn ts_value_scalar_part(n) = {
  value parts: value_constituents(n)
  value arm: first(parts)
  value if parts != null && len(parts) == 1 && len(arm) == 1 then first(arm) else null
}
fn ts_value_literal_branch(n, part) = {
  value branch: ts_value_scalar_part(n)
  value part != null && branch != null && part.identity_known && branch.identity_known
    && part.identity != null && part.identity == branch.identity
}
fn ts_value_logical_choice(n) = {
  value left: {
    value n.left.node
    walk (current) if current is (ts_parenthesized, ts_as, ts_satisfies, ts_non_null, ts_type_assertion)
      then current.expression.node else null
    last
  }
  value if left is ts_new && n.operator == "&&" then n.right.node
    else if left is ts_new && contains(["||", "??"], n.operator) then n.left.node
    else if n.operator == "||" && n.left always falsy then n.right.node
    else if n.operator == "||" && n.left always truthy then n.left.node
    else if n.operator == "&&" && n.left always falsy then n.left.node
    else if n.operator == "&&" && n.left always truthy then n.right.node
    else if n.operator == "??" && n.left always nullable then n.right.node
    else if n.operator == "??" && !(n.left could nullable) then n.left.node else null
