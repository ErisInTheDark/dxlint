    when ts_value_mapped_readonly == "add" { unwraps modified ts_value_mapped_source optional remove readonly add flag readonly add }
    when ts_value_mapped_readonly == "remove" { unwraps modified ts_value_mapped_source optional remove readonly remove flag readonly remove }
