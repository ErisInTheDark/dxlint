  # A name a destructuring pattern binds takes the value that pattern gives
  # it, not the declarator's whole value.
  let ts_value_pattern_name if declaration != null
    && (declaration.parent is (ts_array_pattern, ts_pattern_property, ts_assignment_pattern)
      || declaration.parent is ts_rest
        && declaration.parent.parent is (ts_array_pattern, ts_object_pattern))
    then declaration else null
  let ts_value_pattern_slot if ts_value_pattern_name != null && ts_value_pattern_name.parent is ts_array_pattern
    then index_of(ts_value_pattern_name.parent.element.nodes, ts_value_pattern_name) else 0
  let ts_value_pattern_any ts_value_pattern_name != null && ts_value_pattern_name.parent is ts_array_pattern
    && ts_value_has_trait(ts_value_pattern_name.parent.node, "any") == true
  when ts_value_undefined {
    fits undefined, nullable, falsy, nonthenable
    identity { type: "undefined" }
  }
  when ts_value_unresolved_value { fits any, error open }
  when ts_value_pattern_name != null {
    when ts_value_pattern_any { unwraps ts_value_pattern_name.parent }
    when ts_value_pattern_name.parent is ts_array_pattern && !ts_value_pattern_any {
      unwraps ts_value_pattern_name.parent.[ts_value_pattern_slot]
