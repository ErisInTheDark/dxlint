    when ts_value_mapped_readonly == "add" { unwraps modified ts_value_mapped_source readonly add flag readonly add }
    when ts_value_mapped_readonly == "remove" { unwraps modified ts_value_mapped_source readonly remove flag readonly remove }
  }
  when ts_value_mapped_source != null && ts_value_mapped_optional == "add" {
    when ts_value_mapped_readonly == "keep" { unwraps modified ts_value_mapped_source optional add }
    when ts_value_mapped_readonly == "add" { unwraps modified ts_value_mapped_source optional add readonly add flag readonly add }
    when ts_value_mapped_readonly == "remove" { unwraps modified ts_value_mapped_source optional add readonly remove flag readonly remove }
  }
