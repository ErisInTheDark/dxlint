fn ts_value_fresh_step(bare, part) = {
  value if bare is (ts_number, ts_string, ts_boolean, ts_bigint) then {valid: true, children: []}
  else if bare is ts_unary && (bare.operator == "-" || bare.operator == "+") then {valid: true, children: [bare.argument.node]}
  else if bare is ts_identifier then {
    value declaration: bare.scope_declaration.parent.node
    value valid: declaration is ts_declarator && declaration.type == null && declaration.parent.kind == "const"
    value {valid: valid, children: if valid then [declaration.init.node] else []}
  } else if bare is ts_conditional then {
    value branches: filter([bare.consequent.node, bare.alternate.node], branch => ts_value_literal_branch(branch, part))
    value {valid: len(branches) > 0, children: branches}
  } else if bare is ts_logical then {
    value chosen: ts_value_logical_choice(bare)
    value if chosen != null then {valid: true, children: [chosen]} else {
      value branches: filter([bare.left.node, bare.right.node], branch => ts_value_literal_branch(branch, part))
      value {valid: len(branches) > 0, children: branches}
    }
