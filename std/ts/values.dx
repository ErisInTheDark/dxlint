  when text == "number" { unwraps (trait number, truthy) | (trait number, falsy) }
  when text == "boolean" { unwraps (trait boolean, truthy) | (trait boolean, falsy) }
  when text == "bigint" { unwraps (trait bigint, truthy) | (trait bigint, falsy) }
