      value closed: part.carrier_known && (part.carrier == null || part.carrier.description.kind == "enum")
        && count(part.uncertain_traits) == 0
        && (any(part.traits, trait => contains(["number", "string", "boolean", "bigint", "symbol", "structural"], trait))
          || part.carrier.description.kind == "enum" && contains(part.traits, "object"))
