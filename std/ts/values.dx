in ts_node let ts_value_preserved_element {
  value bare: unparenthesised_node(node)
  value if ts_value_const_context(node) || bare not (ts_null, ts_boolean, ts_number, ts_bigint, ts_string,
    ts_template, ts_unary, ts_identifier, ts_conditional, ts_logical, ts_sequence, ts_satisfies) then node else {
    value part: ts_value_scalar_part(node)
