  value parts: value_parts(n)
  value certain: parts != null && all(parts, arm => {
    value fixed: any(arm.parts, part => contains(part.traits, "nonthenable")
      && !contains(part.uncertain_traits, "nonthenable"))
    value members: filter(arm.parts, part => part.traits != ["intersection"] && part.traits != ["enum"]
      && part.traits != ["parameter"])
