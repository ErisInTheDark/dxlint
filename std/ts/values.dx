fn ts_value_contextual_literal(n, part) = {
  value category: find(["string", "number", "boolean", "bigint"], trait => contains(part.traits, trait))
  value wanted: if category == "boolean" then ["boolean"] else if category == null then null else [category, "literal"]
  # A type parameter in the context (one being inferred) stands for its
  # constraint only, as in TypeScript: an unconstrained one keeps no literal.
  value arms: if wanted == null || !value_has_expected(n) then null else value_parts(value_expected_handle(n))
  value when {
    wanted == null || !value_has_expected(n) then false
    arms != null && any(arms, arm => any(arm.parts, item => contains(item.traits, "parameter")))
      then any(arms, arm => all(wanted, trait => any(arm.parts, item => !contains(item.traits, "parameter") && contains(item.traits, trait))))
