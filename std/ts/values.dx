  when ts_value_evolving_array && !ts_value_evolving_any {
    unwraps product ts_array of init using trait unknown repeated values ts_value_array_element
    widens product ts_array of init using trait unknown repeated values ts_value_array_element
  }
  when !ts_value_evolving_array { widens type ?? init.widened }
  when ts_value_unique_symbol {
