# Read from certain traits: `always any` stays unknown for an open type
# parameter, which would leave its intersections without a value.
fn ts_value_dynamic_part(item) = {
  value parts: value_constituents(item)
  value parts != null && len(parts) > 0 && all(parts, arm => any(arm, part => contains(part.traits, "any")))
