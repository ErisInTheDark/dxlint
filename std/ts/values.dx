# A rest element's remaining values: a plain array gives the same array (a
# tuple would give the tail, which no recipe can slice yet).
fn ts_value_array_rest(n) = {
  value arms: value_parts(n)
  value arms != null && count(arms) > 0 && all(arms, arm =>
    any(arm.parts, part => contains(part.traits, "array") && !contains(part.traits, "tuple")))
