fn ts_value_string_array(n) = {
  value arms: value_parts(n)
  value ts_value_array_like(n) && all(arms, arm => {
    # A type parameter's own part stands beside its constraint's.
    value parts: filter(arm.parts, part => !contains(part.traits, "parameter"))
    value empty: any(parts, part => part.product_known && part.product != null && count(part.product.elements) == 0)
    value element: value_constituents(value_lookup(arm.handle, 0).member)
    value (count(parts) == 1 && empty) || (element != null && count(element) > 0
      && all(element, item => any(item, part => contains(part.traits, "string"))))
