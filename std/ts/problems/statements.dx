# Statement-level mistakes: debugger, empty patterns, octal and array holes.

define {

in ts_debugger rule es-no-debugger warn "Unexpected 'debugger' statement."

in ts_object_pattern let empty_object_pattern_checked true
in ts_object_pattern rule es-no-empty-pattern:object {
  when count(property) == 0 && rest == null
  when empty_object_pattern_checked
  warn "Unexpected empty object pattern."
}
in ts_array_pattern rule es-no-empty-pattern:array {
  when count(element) == 0
  warn "Unexpected empty array pattern."
}

in ts_static_block.body rule es-no-empty-static-block {
  when re_test(text, /^\{\s*\}$/)
  warn "Unexpected empty static block."
}

in ts_number rule es-no-octal {
  when re_test(text, /^0[0-9]/)
  warn "Octal literals should not be used."
}

# Every hole, at its comma.
in ts_array let is_assignment_target parent is ts_assignment && parent.left == text || parent is (ts_for_of, ts_for_in)
in ts_hole rule es-no-sparse-arrays {
  when parent is ts_array && !parent.is_assignment_target
  report at { start: offset, end: offset + 1 }
  warn "Unexpected comma in middle of array."
}

}
