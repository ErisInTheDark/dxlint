# Regular expression validation rules.

define {

fn backreference_reason(kind) = (if kind == "nested" then "from within that group" else if kind == "forward" then "which appears later in the pattern" else if kind == "backward" then "which appears before in the same lookbehind" else if kind == "disjunctive" then "which is in another alternative" else "which is in a negative lookaround")
fn misleading_message(kind) = (if kind == "surrogatePairWithoutUFlag" then "Unexpected surrogate pair in character class. Use 'u' flag." else if kind == "surrogatePair" then "Unexpected surrogate pair in character class." else if kind == "combiningClass" then "Unexpected combined character in character class." else if kind == "emojiModifier" then "Unexpected modified Emoji in character class." else if kind == "regionalIndicatorSymbol" then "Unexpected national flag in character class." else "Unexpected joined character sequence in character class.")

in ts_regex rule es-no-empty-character-class {
  when contains(text, "[")
  each f in regexp_empty_class_findings {
    warn "Empty class."
  }
}

# On literals, and on plain string patterns of `RegExp(...)` (at the string).
in regexp_site rule es-no-control-regex {
  when is ts_regex || regexp_candidate
  when is ts_regex || regexp_input.written == "string"
  each f in regexp_control_findings {
    report at regexp_input.pattern_node
    warn "Unexpected control character(s) in regular expression: {first(f.data)}."
  }
}

in regexp_site rule es-no-useless-backreference {
  when is ts_regex || regexp_candidate
  each f in regexp_backreference_findings {
    warn "Backreference '{first(f.data)}' will be ignored. It references group '{ { value f.data; slice 1; first } }'{last(f.data)} {backreference_reason(f.kind)}."
  }
}

# Each sequence where it is written (or at the pattern when it is
# computed). With computed flags, nothing is known.
in regexp_site let misleading_character_class_findings regexp_misleading_findings
in regexp_site rule es-no-misleading-character-class {
  when is ts_regex || regexp_candidate
  when type_of(regexp_input.flags) == "str" || is ts_regex
  each f in misleading_character_class_findings {
    report at { start: f.offset, end: f.end }
    warn misleading_message(f.kind)
  }
}

# Literals, and `RegExp` calls with a string literal pattern and flags.
in regexp_site rule es-no-regex-spaces {
  when is ts_regex || regexp_candidate
  let spaces_argument if is (ts_call, ts_new) then { value argument.nodes; first; unparenthesised_node } else null
  let spaces_fixable is ts_regex || regexp_input.source == slice(spaces_argument.text, 1, -1)
  when is ts_regex || regexp_input.written == "string" && type_of(regexp_flags) == "str"
  each f in regexp_space_findings {
    fix at { start: f.offset, end: f.end } if spaces_fixable as " {{{f.kind}}}"
    warn "Spaces are hard to count. Use {{{f.kind}}}."
  }
}

# The flags first (`RegExp` checks them first), then the pattern.
in ts_call, ts_new rule es-no-invalid-regexp {
  option allowConstructorFlags string[] = [] "flags beyond the standard ones that are allowed"
  when regexp_candidate
  when callee.global_value == "RegExp"
  let flags_problem if regexp_flags == null then null else regex_flags_error(regexp_flags, allowConstructorFlags)
  when flags_problem != null || regexp_pattern_error != null
  warn "{ flags_problem.nonempty ?? regexp_pattern_error }."
}

}
