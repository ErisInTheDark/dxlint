# TypeScript-specific declarations: directives, Function types and interfaces.

define {

in ts_class.name, ts_interface.name rule no-unsafe-declaration-merging {
  when contains(declaration_kinds, "class") && contains(declaration_kinds, "interface")
  warn "Unsafe declaration merging between classes and interfaces."
}

# The directive and its description, as TypeScript reads them: `// @ts-x`
# (`///` too for check/nocheck) or the last line of a block comment.
in ts_comment let ts_comment_body if is ts_line_comment then slice(text, 2) else { value result: len(text) - 2; value slice(text, 2, result); re_replace /^[\s\S]*(?:\r\n|[\r\n\u{2028}\u{2029}])/ "" }
in ts_comment let ts_pragma is ts_line_comment && re_test(text, /^\/\/\/?\s*@ts-(?:check|nocheck)/)
in ts_comment let ts_suppress if is ts_line_comment then re_test(ts_comment_body, /^\/*\s*@ts-(?:expect-error|ignore)/) else re_test(ts_comment_body, /^\s*(?:\/|\*)*\s*@ts-(?:expect-error|ignore)/)
in ts_comment let ts_directive if ts_pragma then re_replace(text, /^\/\/\/?\s*@ts-(check|nocheck)[\s\S]*$/, "$1") else if ts_suppress then re_replace(ts_comment_body, /^[\/*\s]*@ts-(expect-error|ignore)[\s\S]*$/, "$1") else null
in ts_comment let ts_directive_description if ts_pragma then re_replace(text, /^\/\/\/?\s*@ts-(?:check|nocheck)([^\r\n\u{2028}\u{2029}]*)[\s\S]*$/, "$1") else re_replace(ts_comment_body, /^[\/*\s]*@ts-(?:expect-error|ignore)([^\r\n\u{2028}\u{2029}]*)[\s\S]*$/, "$1")
# `@ts-nocheck` only counts before the first statement.
in ts_comment let ts_directive_effective ts_directive != "nocheck" || { value overlapping(ts_program); first }.first_token.start == null || offset < { value overlapping(ts_program); first }.first_token.start
fn ts_directive_message(directive, description, mode, minimum, pattern) = (
  if mode == "allow" then null
  else if mode == "deny" && directive == "ignore" then "Use \"@ts-expect-error\" instead of \"@ts-ignore\", as \"@ts-ignore\" will do nothing if the following line is error-free."
  else if mode == "deny" then "Do not use \"@ts-{directive}\" because it alters compilation errors."
  else if { value description; trim; graphemes } < minimum then "Include a description after the \"@ts-{directive}\" directive to explain why the @ts-{directive} is necessary. The description must be {minimum} characters or longer."
  else if pattern != null && !re_test(description, pattern) then "The description for the \"@ts-{directive}\" directive must match the {pattern} format."
  else null
)
@macro ban_ts_directive(name, mode_default) {
  default option mode enum(allow, deny, require-description) = mode_default
  option descriptionPattern regex | null = null
  option minimumDescriptionLength int(0..) = 3
  when ts_directive == name && ts_directive_effective
  let message ts_directive_message(ts_directive, ts_directive_description, mode, minimumDescriptionLength, descriptionPattern)
  when message != null
  warn message
}
in ts_comment rule ban-ts-comment:expect-error { @ban_ts_directive("expect-error", require-description) }
in ts_comment rule ban-ts-comment:ignore { @ban_ts_directive("ignore", deny) }
in ts_comment rule ban-ts-comment:nocheck { @ban_ts_directive("nocheck", deny) }
in ts_comment rule ban-ts-comment:check { @ban_ts_directive("check", allow) }

# `Function` as a type (not a local type of that name), also `implements
# Function`.
in ts_type_reference rule no-unsafe-function-type {
  when name == "Function" && name.resolved == null && name.reference_kind == null
  warn "The `Function` type accepts any function-like value.\nPrefer explicitly defining any function parameters and return type."
}

in ts_interface rule no-empty-interface warn "{if count(extends) > 0 then 'An interface declaring no members is equivalent to its supertype.' else 'An empty interface is equivalent to `{{}}`.'}" {
  when count(member) == 0
  # Several supertypes make a useful intersection.
  when count(extends) <= 1
  report at { start: opener.ts_open_brace.offset, end: closer.ts_close_brace.end_offset }
}

}
