# .ts/jsx: @stylistic's JSX rules (spacing, wrapping, props, closing tags),
# on the native `ts_jsx_*` layers.

import .ts/expression-fixes

define {

in ts_node, ts_open_angle, ts_close_angle, ts_punctuator let jsx_line_prefix { value js_line_start: position(offset).js_line_start; value byte_slice(source, js_line_start, offset) }
fn jsx_indent(prefix) = { value { value result: "^" jsx_space_regex() "*"; value re_find(prefix, result); nonempty } ?? ""; len }
fn jsx_indent_operator(text) = re_test(text, /^[ \t]*[?:]/)
fn jsx_indent_spaces(text) = { value { value text; re_find /^ */; nonempty } ?? ""; len }
fn jsx_indent_tabs(text) = { value { value text; re_find /^\t*/; nonempty } ?? ""; len }
in ts_jsx_opening {
  let jsx_prop_indent_operator jsx_indent_operator(jsx_line_prefix)
  let jsx_prop_indent_first_column { value first(property.nodes).offset; position }.js_column - 1
}
in ts_jsx_attribute, ts_jsx_spread_attribute {
  let jsx_prop_indent_line {
    value js_line_start: position(offset).js_line_start
    value byte_slice(source, js_line_start, end_offset)
    re_find /^[^\n\r\u{2028}\u{2029}]*/
    nonempty
  } ?? ""
  let jsx_prop_indent_operator jsx_indent_operator(jsx_prop_indent_line)
  let jsx_prop_indent_extra previous.jsx_prop_indent_extra == true || !jsx_prop_indent_operator && !contains(jsx_prop_indent_line, "<") && (if previous == null then parent.jsx_prop_indent_operator else previous.jsx_prop_indent_operator)
}
in ts_jsx_attribute, ts_jsx_spread_attribute rule jsx-indent-props {
  option mode int | "tab" | "first" = 4 "prop indent size or alignment"
  let size if mode == "tab" then 1 else mode
  let base_indent if mode == "tab" then jsx_indent_tabs(parent.jsx_line_prefix) else jsx_indent_spaces(parent.jsx_line_prefix)
  let actual if mode == "tab" then jsx_indent_tabs(jsx_line_prefix) else jsx_indent_spaces(jsx_line_prefix)
  let expected if mode == "first" then parent.jsx_prop_indent_first_column else base_indent + size * (if jsx_prop_indent_extra then 2 else 1)
  when parent is ts_jsx_opening && jsx_trim_space(jsx_line_prefix) == "" && actual != expected
  report at if is ts_jsx_attribute then name.node else argument.node
  fix at { start: offset - byte_len(jsx_line_prefix), end: offset } if expected >= 0 as { value if mode == "tab" then "\t" else " "; repeat expected }
  warn "Expected indentation of {expected} {if mode == 'tab' then 'tab' else 'space'} {if expected == 1 then 'character' else 'characters'} but found {actual}."
}
in ts_node {
  let jsx_child_leading is ts_jsx_text && { value result: "^" jsx_space_regex() "*\n"; value re_test(text, result) }
  let jsx_child_trailing is ts_jsx_text && { value result: "\n" jsx_space_regex() "*$"; value re_test(text, result) }
  let jsx_child_row not ts_jsx_text || jsx_trim_space(text) != ""
  let jsx_child_first_line position(offset).js_line + (if jsx_child_leading then 1 else 0)
  let jsx_child_last_line position(end_offset).js_line - (if jsx_child_trailing then 1 else 0)
  let jsx_child_previous_row if previous == null then null else if previous.jsx_child_row then {first: previous.jsx_child_first_line, last: previous.jsx_child_last_line} else previous.jsx_child_previous_row
  let jsx_child_next_row if next == null then null else if next.jsx_child_row then {first: next.jsx_child_first_line, last: next.jsx_child_last_line} else next.jsx_child_next_row
  let jsx_child_multiline position(offset).js_line != position(end_offset).js_line
  let jsx_child_next_multiline if jsx_child_newline_eligible == true then jsx_child_multiline else if next != null then next.jsx_child_next_multiline else false
}
in ts_jsx_element {
  let jsx_child_inline_name if contains(["a", "abbr", "acronym", "b", "bdo", "big", "button", "cite", "code", "dfn", "em", "i", "img", "input", "kbd", "label", "map", "object", "q", "samp", "script", "select", "small", "span", "strong", "sub", "sup", "textarea", "tt", "var"], opening.name) then opening.name else null
  let jsx_child_descriptor if !re_test(opening.name, /[.:]/) then opening.name else replace(text, "\n", "")
  let jsx_child_newline_eligible true
}
in ts_jsx_expression let jsx_child_newline_eligible expression not ts_spread && !{
  value text
  jsx_trim_space: jsx_trim_space
  value result: "{{/*"
  value starts_with(jsx_trim_space, result)
}
in ts_jsx_expression, ts_jsx_fragment, ts_jsx_text let jsx_child_descriptor replace(text, "\n", "")
in ts_jsx_text {
  let jsx_child_preceding_eligible previous.jsx_child_newline_eligible == true
  let jsx_child_preceding_multiline previous.jsx_child_multiline == true
}
in ts_jsx_element, ts_jsx_fragment {
  let jsx_one_expression_per_line_enabled true
  let jsx_child_rows {
    value body.nodes
    filter (item) item.jsx_child_row
    map (item) {index: item.index, first: item.jsx_child_first_line, last: item.jsx_child_last_line}
  }
  let jsx_child_one_group count(jsx_child_rows) > 0 && all(jsx_child_rows, row => row.first == first(jsx_child_rows).first && row.last == first(jsx_child_rows).first)
  let jsx_child_first first(body.nodes)
  let jsx_child_last last(body.nodes)
  let jsx_child_single_line_allowed (position(jsx_child_last.end_offset).js_line - position(jsx_child_first.offset).js_line == 0 && !jsx_child_first.jsx_child_leading && !jsx_child_last.jsx_child_trailing) || (position(jsx_child_last.end_offset).js_line - position(jsx_child_first.offset).js_line == 2 && jsx_child_first.jsx_child_leading && jsx_child_last.jsx_child_trailing)
  let jsx_child_single count(body) == 1 && jsx_child_first.jsx_child_multiline == false && position(offset).js_line == position(end_offset).js_line
  let jsx_child_literal count(body) == 1 && jsx_child_first is ts_jsx_text
  let jsx_child_has_jsx any(body.nodes, item => item is (ts_jsx_element, ts_jsx_fragment))
}
fn jsx_child_group_contains(row, line) = row.first == line || row.last == line
in ts_jsx_element.body, ts_jsx_fragment.body rule jsx-one-expression-per-line {
  option mode "always" | "single-child" | "single-line" = "always" "same-line child layout"
  let opening_line position(parent.opening.end_offset).js_line
  let closing_line { value parent.closing.offset.nonempty ?? parent.opening.end_offset; position }.js_line
  let first_line jsx_child_first_line
  let last_line jsx_child_last_line
  let first_wrong jsx_child_previous_row != null && jsx_child_group_contains(jsx_child_previous_row, first_line) || first_line == opening_line || first_line == closing_line && !(jsx_child_next_row != null && jsx_child_group_contains(jsx_child_next_row, first_line))
  let last_wrong jsx_child_previous_row != null && jsx_child_group_contains(jsx_child_previous_row, last_line) || last_line == opening_line || last_line == closing_line && !(jsx_child_next_row != null && jsx_child_group_contains(jsx_child_next_row, last_line))
  let single_group_wrong index == first(parent.jsx_child_rows).index && first_line == opening_line || index == last(parent.jsx_child_rows).index && last_line == closing_line
  when jsx_child_row
  when parent.jsx_one_expression_per_line_enabled
  when !(mode == "single-child" && parent.jsx_child_single || mode == "single-line" && parent.jsx_child_single_line_allowed)
  when if mode == "single-line" && parent.jsx_child_one_group then single_group_wrong else first_wrong || last_wrong
  let single_group mode == "single-line" && parent.jsx_child_one_group
  let leading if single_group then index == first(parent.jsx_child_rows).index && first_line == opening_line else jsx_child_previous_row != null && (jsx_child_group_contains(jsx_child_previous_row, first_line) || jsx_child_group_contains(jsx_child_previous_row, last_line)) || first_line == opening_line || last_line == opening_line
  let trailing if single_group then index == last(parent.jsx_child_rows).index && last_line == closing_line else first_line == closing_line && !(jsx_child_next_row != null && jsx_child_group_contains(jsx_child_next_row, first_line)) || last_line == closing_line && !(jsx_child_next_row != null && jsx_child_group_contains(jsx_child_next_row, last_line))
  let leading_space starts_with(text, " ") || previous is ts_jsx_text && ends_with(previous.text, " ")
  let trailing_space ends_with(text, " ") || next is ts_jsx_text && starts_with(next.text, " ")
  let space_expression "{{' '}}"
  let leading_text if leading_space && leading then "\n{space_expression}" else ""
  let trailing_text if trailing_space && trailing then "{space_expression}\n" else ""
  fix at {start: if single_group && !leading then end_offset else offset, end: if single_group && !trailing then offset else end_offset} as if single_group then "{if leading then '\n' else ''}{if leading && trailing then text else ''}{if trailing then '\n' else ''}" else "{leading_text}{if leading then '\n' else ''}{re_replace(text, /(^ +| +$)/, '')}{if trailing then '\n' else ''}{trailing_text}"
  report at node
  warn "`{jsx_child_descriptor}` must be placed on a new line"
}
fn jsx_newline_text(text, remove) = {
  value separator: if remove then "\n\n" else "\n"
  value parts: split(text, separator)
  value result: {
    value parts
    fold ({ index: 0, text: "" }) (state, part) {
      index: state.index + 1,
      text: state.text (if state.index == 0 then "" else if remove then {
        value if state.index == len(parts) - 1 || contains(part, "\n") then "\n" else "\n\n"
      } else if state.index == len(parts) - 1 then "\n\n" else "\n") part
    }
  }
  value result.text
}
in ts_jsx_element.body, ts_jsx_fragment.body rule jsx-newline {
  option prevent boolean = false "prevent blank lines between children"
  option allowMultilines boolean = false "keep blank lines around multiline children"
  let multiline previous.jsx_child_preceding_multiline == true || jsx_child_next_multiline
  let blank { value result: "\n" jsx_space_regex() "*\n"; value re_test(previous.text, result) }
  when previous is ts_jsx_text && previous.jsx_child_preceding_eligible
  when if allowMultilines && multiline then !blank else blank == prevent
  report at previous.node
  warn if allowMultilines && multiline then "Multiline JSX elements should start in a new line" else if prevent then "JSX element should not start in a new line" else "JSX element should start in a new line"
  let remove prevent && !(allowMultilines && multiline)
  let fixed jsx_newline_text(previous.text, remove)
  fix at previous.node if fixed != previous.text as fixed
}
in ts_jsx_text rule jsx-child-element-spacing {
  let after { value result: "^" jsx_space_regex() "*\n"; value re_test(text, result) } && jsx_trim_space(text) != ""
  let before jsx_trim_space(text) != "" && { value result: "\n" jsx_space_regex() "*$"; value re_test(text, result) }
  let preceding after && previous != null
  when (previous != null || next != null) && (previous == null || previous.jsx_child_inline_name != null) && (next == null || next.jsx_child_inline_name != null)
  when preceding || before && next != null
  report at if preceding then node.offset else node.end_offset
  warn "Ambiguous spacing {if preceding then 'after previous' else 'before next'} element {if preceding then previous.jsx_child_inline_name else next.jsx_child_inline_name}"
}
schema jsx_wrap_mode boolean | "ignore" | "parens" | "parens-new-line"
fn jsx_wrap_active(value) = value != false && value != "ignore"
in ts_jsx_element let jsx_wrap_element true
in ts_parenthesized let jsx_wrap_element expression.jsx_wrap_element == true
in ts_jsx_expression let jsx_prop_expression parent is ts_jsx_attribute
in ts_parenthesized, ts_jsx_element, ts_jsx_fragment, ts_conditional {
  let jsx_wrap_context if parent is ts_parenthesized then parent.jsx_wrap_context else if is ts_declarator.init then "declaration" else if is ts_assignment.right then "assignment" else if is ts_return.argument then "return" else if is ts_arrow.body then "arrow" else if is ts_logical.right then "logical" else if is (ts_conditional.consequent, ts_conditional.alternate) then "condition" else if is ts_jsx_expression.expression && parent.jsx_prop_expression then "prop" else if jsx_wrap_element && is ts_property.value then "propertyValue" else null
  let jsx_wrap_fallback if parent is ts_parenthesized then parent.jsx_wrap_fallback else if parent is ts_conditional then parent.jsx_wrap_context else null
  let jsx_call_argument if parent is ts_parenthesized then parent.jsx_call_argument else is (ts_call.argument, ts_new.argument)
}
fn jsx_wrap_edit(source, n, selected, parenthesized, opening, closing) = {
  value newline: selected == "parens-new-line"
  value before: n.token_neighbours.before
  value after: n.token_neighbours.after
  value if parenthesized then {
    start: n.offset, end: n.end_offset,
    text: (if opening then "\n" else "") n.text (if closing then "\n" else "")
  } else if !newline then { start: n.offset, end: n.end_offset, text: "(" n.text ")" }
  else if before != null && position(before.end).js_line < position(n.offset).js_line then {
    value comments: { value source; byte_slice before.end n.offset; trim }
    value tab: starts_with(n.jsx_line_prefix, "\t")
    value unit: if tab then "\t" else " "
    value column: position(n.offset).js_column - 1
    value tail_size: column - (if tab then 1 else 2)
    value tail_column: max(0, tail_size)
    value indent: repeat(unit, column)
    value tail_indent: repeat(unit, tail_column)
    value leading: trim(before.text) (if contains(["{{", "["], before.text) then "" else " ")
    value {
      start: before.start,
      end: if after != null && contains([";", "}}"], after.text) then after.start else n.end_offset,
      text: leading "(\n" indent comments (if comments != "" then "\n" indent else "") n.text "\n" tail_indent ")"
    }
  } else { start: n.offset, end: n.end_offset, text: "(\n" n.text "\n)" }
}
in ts_jsx_element, ts_jsx_fragment rule jsx-wrap-multilines {
  option declaration jsx_wrap_mode = "parens" "variable initializer wrapping"
  option assignment jsx_wrap_mode = "parens" "assignment wrapping"
  option return jsx_wrap_mode = "parens" "return expression wrapping"
  option arrow jsx_wrap_mode = "parens" "arrow body wrapping"
  option condition jsx_wrap_mode = "ignore" "conditional branch wrapping"
  option logical jsx_wrap_mode = "ignore" "logical right-hand side wrapping"
  option prop jsx_wrap_mode = "ignore" "JSX prop expression wrapping"
  option propertyValue jsx_wrap_mode = "ignore" "object property value wrapping"
  let context if jsx_wrap_context == "condition" && !jsx_wrap_active(condition) && contains(["declaration", "assignment"], jsx_wrap_fallback) then jsx_wrap_fallback else jsx_wrap_context
  let selected {
    value {declaration: declaration, assignment: assignment, return: return, arrow: arrow, condition: condition, logical: logical, prop: prop, propertyValue: propertyValue}
    get context
    nonempty
  } ?? "ignore"
  let parenthesized parent is ts_parenthesized
  when jsx_break(text) && jsx_wrap_active(selected)
  when !parenthesized || selected == "parens-new-line" && (!space_before.line_break || !space_after.line_break)
  warn if !parenthesized then "Missing parentheses around multilines JSX" else "Parentheses around JSX should be on separate lines"
  let edit jsx_wrap_edit(source, node, selected, parenthesized, !space_before.line_break, !space_after.line_break)
  let original { offset: edit.start, end_offset: edit.end, text: byte_slice(source, edit.start, edit.end) }
  fix at edit if expression_fix_retains_comments(original, edit.text) as edit.text
}
in ts_jsx_element, ts_jsx_fragment rule jsx-function-call-newline {
  option mode "always" | "multiline" = "multiline" "call argument linebreak policy"
  when jsx_call_argument && (mode == "always" || jsx_break(text))
  when !space_before.line_break || next_token not ts_comma && !space_after.line_break
  warn "Missing line break around JSX"
  fix at node as (if !space_before.line_break then "\n" else "") text (if next_token not ts_comma && !space_after.line_break then "\n" else "")
}
fn jsx_presence_whitespace(value) = value != "" && jsx_trim_space(value) == ""
fn jsx_presence_edge(value) = { value result: "^" jsx_space_regex() "|" jsx_space_regex() "$"; value re_test(value, result) }
fn jsx_presence_entities(value) = re_replace(value, /&[a-zA-Z0-9#]+;/, "")
fn jsx_presence_quote(raw) = {
  value escaped: {
    value raw
    re_replace /\\/ "\\\\"
    re_replace /"/ "\\\""
    re_replace /\u{8}/ "\\b"
    re_replace /\u{c}/ "\\f"
    re_replace /\n/ "\\n"
    re_replace /\r/ "\\r"
    re_replace /\t/ "\\t"
  }
  value "\"" escaped "\""
}
fn jsx_presence_content(raw) = { value end: byte_len(raw) - 1; value byte_slice(raw, 1, end) }
fn jsx_presence_wrap(raw) = if raw == "" then "" else "{{" jsx_presence_quote(raw) "}}"
in ts_jsx_text layer jsx_presence_lines match jsx_presence_line /[^\n]+|\n/
in jsx_presence_line layer jsx_presence_entities match jsx_presence_entity /&[a-zA-Z0-9#]+;/
fn jsx_presence_line_fix(line) = if jsx_trim_space(line.text) == "" then line.text else {
  value prefix: jsx_edge_space(line.text, true)
  value start: line.offset + byte_len(prefix)
  value overlapping(jsx_presence_entity, start, line.end_offset)
  filter (entity) start <= entity.offset && entity.end_offset <= line.end_offset
  unique_by (entity) entity.offset
  sort_by (entity) entity.offset
  result: fold ({ end: start, text: prefix }) (state, entity) {
    end: entity.end_offset,
    text: state.text { value byte_slice(line.text, state.end - line.offset, entity.offset - line.offset); jsx_presence_wrap } entity.text
  }
  value result.text { value byte_slice(line.text, result.end - line.offset); jsx_presence_wrap }
}
fn jsx_presence_text_fix(n) = if !jsx_break(n.text) then jsx_presence_wrap(n.text) else {
  value overlapping(jsx_presence_line, n.offset, n.end_offset)
  filter (line) n.offset <= line.offset && line.end_offset <= n.end_offset
  unique_by (line) line.offset
  sort_by (line) line.offset
  map (line) jsx_presence_line_fix(line)
  join
}
fn jsx_presence_remove(inner, attribute) = if inner is (ts_jsx_element, ts_jsx_fragment) then inner.text
  else if attribute then "\"" jsx_presence_content(inner.text) "\""
  else inner.literal_value.value
in ts_parenthesized let jsx_presence_inner expression.jsx_presence_inner.nonempty ?? expression.node
in ts_jsx_expression {
  let jsx_presence_expression_inner expression.jsx_presence_inner.nonempty ?? expression.node
  let jsx_presence_comments { value descendants(ts_comment); count }
}
in ts_jsx_expression, ts_jsx_text, ts_string, ts_jsx_element, ts_jsx_fragment rule jsx-curly-brace-presence {
  option mode "always" | "never" | "ignore" = "never" "default brace policy"
  option props "always" | "never" | "ignore" | null = null "attribute literal brace policy"
  option children "always" | "never" | "ignore" | null = null "child literal brace policy"
  option propElementValues "always" | "never" | "ignore" = "ignore" "JSX element attribute brace policy"
  let attribute is ts_jsx_attribute.value
  let child is (ts_jsx_element.body, ts_jsx_fragment.body)
  let expression_node is ts_jsx_expression
  let inner jsx_presence_expression_inner
  let element_value attribute && (is ts_jsx_element || inner is ts_jsx_element)
  let selected { value (if attribute then props else children); nonempty } ?? mode
  let string inner is ts_string
  let template inner is ts_template && count(inner.expression) == 0
  let value inner.literal_value.value.nonempty ?? ""
  let spelling if template then { value result: len(inner.text) - 1; value slice(inner.text, 1, result) } else inner.text
  let escape contains(spelling, "\\") || jsx_presence_entities(spelling) != spelling || child && re_test(spelling, /[{}<>]/)
  let comment jsx_presence_comments > 0
  let removable if element_value then true else if !comment && string then !escape && !contains(value, "/*") && (!attribute || !jsx_presence_whitespace(value)) && (attribute || !jsx_presence_edge(value)) && (child || !re_test(value, /['"]/)) else if !comment && template then !escape && !contains(spelling, "\n") && !jsx_presence_edge(spelling) && !re_test(value, /['"]/) else !comment && inner is (ts_jsx_element, ts_jsx_fragment)
  let adjacent previous is ts_jsx_expression || next is ts_jsx_expression
  let space_expression string && jsx_presence_whitespace(value)
  let unnecessary removable && !(child && (adjacent || space_expression && (count(parent.body) == 1 || previous is ts_jsx_element || next is ts_jsx_element)))
  let raw_line_break jsx_break(text) && jsx_trim_space(text) == ""
  let missing element_value || !raw_line_break && { value text; jsx_presence_entities; jsx_trim_space } != ""
  when attribute || child
  when expression_node || element_value || is (ts_string, ts_jsx_text)
  when if element_value then (if expression_node then propElementValues == "never" else propElementValues != "ignore") else if expression_node then selected == "never" && unnecessary else selected == "always" && missing
  warn if expression_node then "Curly braces are unnecessary here." else "Need to wrap this literal in a JSX expression."
  let replacement if expression_node then jsx_presence_remove(inner, attribute) else if element_value then "{{" text "}}" else if attribute then { value jsx_presence_content(text); jsx_presence_wrap } else jsx_presence_text_fix(node)
  # Entities must remain JSX, not literal entity spellings inside a JS string.
  let safe_literal !re_test(text, /[\u{0}-\u{7}\u{b}\u{e}-\u{1f}]/) && (expression_node || element_value || (jsx_presence_entities(text) == text || child && jsx_break(text)) && !(attribute && jsx_break(text)))
  fix if safe_literal && !(element_value && !expression_node && propElementValues != "always") && expression_fix_retains_comments(node, replacement) as replacement
}

fn jsx_space_regex() = /[\t\n\u{b}\u{c}\r \u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}\u{feff}]/
fn jsx_js_space(text) = { value jsx_space_regex: jsx_space_regex(); value re_test(text, jsx_space_regex) }
fn jsx_strip_space(text) = { value jsx_space_regex: jsx_space_regex(); value re_replace(text, jsx_space_regex, "") }
fn jsx_gap_safe(text) = jsx_strip_space(text) == ""
fn jsx_trim_space(text) = {
  value result: "^" jsx_space_regex() "*"
  value re_replace: re_replace(text, result, "")
  value result_2: jsx_space_regex() "*$"
  value re_replace(re_replace, result_2, "")
}
fn jsx_utf16_length(text) = len(text) + re_count(text, /[\u{10000}-\u{10ffff}]/)
fn jsx_break(text) = re_test(text, /[\n\r\u{2028}\u{2029}]/)
fn jsx_edge_space(text, opening) = {
  value result: if opening then "^" jsx_space_regex() "*" else jsx_space_regex() "*$"
  value re_find(text, result)
  nonempty
} ?? ""
fn jsx_curly_trim(gap, opening) = {
  value pattern: if opening then "(^|[\\n\\r\\u{2028}\\u{2029}])" jsx_space_regex() "+" else jsx_space_regex() "+($|[\\n\\r\\u{2028}\\u{2029}])"
  value re_replace(gap, pattern, "$1")
}
in ts_jsx_expression {
  let jsx_brace_container expression not ts_spread
  let jsx_brace_attribute parent is ts_jsx_attribute
  let jsx_brace_single !{ value expression.nonempty ?? { value result: len(text) - 1; value slice(text, 1, result) }; jsx_break }
}
in ts_jsx_spread_attribute {
  let jsx_brace_container true
  let jsx_brace_attribute true
