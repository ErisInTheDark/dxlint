# .ts/jsx: @stylistic's JSX rules (spacing, wrapping, props, closing tags),
# on the native `ts_jsx_*` layers.

define {

in ts_node, ts_open_angle, ts_close_angle, ts_punctuator let jsx_line_prefix byte_slice(source, position(offset).js_line_start, offset)
fn jsx_indent(prefix) = len(default(re_find(prefix, "^" jsx_space_regex() "*"), ""))
fn jsx_indent_operator(text) = re_test(text, /^[ \t]*[?:]/)
fn jsx_indent_spaces(text) = len(default(re_find(text, /^ */), ""))
fn jsx_indent_tabs(text) = len(default(re_find(text, /^\t*/), ""))
in ts_jsx_element {
  let jsx_prop_indent_operator jsx_indent_operator(jsx_line_prefix)
  let jsx_prop_indent_first_column position(first([] property.node).offset).js_column - 1
}
in ts_jsx_attribute, ts_jsx_spread_attribute {
  let jsx_prop_indent_line default(re_find(byte_slice(source, position(offset).js_line_start, end_offset), /^[^\n\r\u{2028}\u{2029}]*/), "")
  let jsx_prop_indent_operator jsx_indent_operator(jsx_prop_indent_line)
  let jsx_prop_indent_extra previous.jsx_prop_indent_extra == true || !jsx_prop_indent_operator && !contains(jsx_prop_indent_line, "<") && (if previous == null then parent.jsx_prop_indent_operator else previous.jsx_prop_indent_operator)
}
in ts_jsx_attribute, ts_jsx_spread_attribute rule jsx-indent-props {
  option mode int | "tab" | "first" = 4 "prop indent size or alignment"
  option indentMode int | "tab" | "first" | null = null "prop indent size or alignment"
  option ignoreTernaryOperator boolean = false "ignore ternary continuation indentation"
  let selected default(indentMode, mode)
  let size if selected == "tab" then 1 else selected
  let base_indent if selected == "tab" then jsx_indent_tabs(parent.jsx_line_prefix) else jsx_indent_spaces(parent.jsx_line_prefix)
  let actual if selected == "tab" then jsx_indent_tabs(jsx_line_prefix) else jsx_indent_spaces(jsx_line_prefix)
  let expected if selected == "first" then parent.jsx_prop_indent_first_column else base_indent + size * (if jsx_prop_indent_extra && !ignoreTernaryOperator then 2 else 1)
  when parent is ts_jsx_element && jsx_trim_space(jsx_line_prefix) == "" && actual != expected
  report at {start: offset, end: parent.end_offset}
  warn "Expected indentation of {expected} {if selected == 'tab' then 'tab' else 'space'} {if expected == 1 then 'character' else 'characters'} but found {actual}."
}
in ts_node {
  let jsx_child_leading layer is ts_jsx_text && re_test(text, "^" jsx_space_regex() "*\n")
  let jsx_child_trailing layer is ts_jsx_text && re_test(text, "\n" jsx_space_regex() "*$")
  let jsx_child_row layer not ts_jsx_text || jsx_trim_space(text) != ""
  let jsx_child_first_line position(offset).js_line + (if jsx_child_leading then 1 else 0)
  let jsx_child_last_line position(end_offset).js_line - (if jsx_child_trailing then 1 else 0)
  let jsx_child_previous_row if previous == null then null else if previous.jsx_child_row then {first: previous.jsx_child_first_line, last: previous.jsx_child_last_line} else previous.jsx_child_previous_row
  let jsx_child_next_row if next == null then null else if next.jsx_child_row then {first: next.jsx_child_first_line, last: next.jsx_child_last_line} else next.jsx_child_next_row
  let jsx_child_multiline position(offset).js_line != position(end_offset).js_line
  let jsx_child_next_multiline if jsx_child_newline_eligible == true then jsx_child_multiline else if next != null then next.jsx_child_next_multiline else false
}
in ts_jsx_element {
  let jsx_child_inline_name if contains(["a", "abbr", "acronym", "b", "bdo", "big", "button", "cite", "code", "dfn", "em", "i", "img", "input", "kbd", "label", "map", "object", "q", "samp", "script", "select", "small", "span", "strong", "sub", "sup", "textarea", "tt", "var"], name) then name else null
  let jsx_child_descriptor if !re_test(name, /[.:]/) then name else replace(text, "\n", "")
  let jsx_child_newline_eligible true
}
in ts_jsx_expression let jsx_child_newline_eligible expression.layer not ts_spread && !starts_with(jsx_trim_space(text), "{{/*")
in ts_jsx_expression, ts_jsx_fragment, ts_jsx_text let jsx_child_descriptor replace(text, "\n", "")
in ts_jsx_text {
  let jsx_child_preceding_eligible previous.jsx_child_newline_eligible == true
  let jsx_child_preceding_multiline previous.jsx_child_multiline == true
}
in ts_jsx_element, ts_jsx_fragment {
  let jsx_child_rows map(filter([] body.node, item => item.jsx_child_row), item => {index: item.index, first: item.jsx_child_first_line, last: item.jsx_child_last_line})
  let jsx_child_one_group count(jsx_child_rows) > 0 && all(jsx_child_rows, row => row.first == first(jsx_child_rows).first && row.last == first(jsx_child_rows).first)
  let jsx_child_first first([] body.node)
  let jsx_child_last last([] body.node)
  let jsx_child_single_line_allowed (position(jsx_child_last.end_offset).js_line - position(jsx_child_first.offset).js_line == 0 && !jsx_child_first.jsx_child_leading && !jsx_child_last.jsx_child_trailing) || (position(jsx_child_last.end_offset).js_line - position(jsx_child_first.offset).js_line == 2 && jsx_child_first.jsx_child_leading && jsx_child_last.jsx_child_trailing)
  let jsx_child_single count(body) == 1 && jsx_child_first.jsx_child_multiline == false && position(offset).js_line == position(end_offset).js_line
  let jsx_child_literal count(body) == 1 && jsx_child_first.layer is ts_jsx_text
  let jsx_child_has_jsx any([] body.node, item => item.layer is (ts_jsx_element, ts_jsx_fragment))
}
fn jsx_child_group_contains(row, line) = row.first == line || row.last == line
in ts_node rule jsx-one-expression-per-line {
  option allow "none" | "literal" | "single-child" | "single-line" | "non-jsx" = "none" "allowed same-line children"
  let opening_line position(parent.jsx_syntax.opening.end).js_line
  let closing_line position(default(parent.jsx_syntax.closing.start, parent.jsx_syntax.opening.end)).js_line
  let first_line jsx_child_first_line
  let last_line jsx_child_last_line
  let first_wrong jsx_child_previous_row != null && jsx_child_group_contains(jsx_child_previous_row, first_line) || first_line == opening_line || first_line == closing_line && !(jsx_child_next_row != null && jsx_child_group_contains(jsx_child_next_row, first_line))
  let last_wrong jsx_child_previous_row != null && jsx_child_group_contains(jsx_child_previous_row, last_line) || last_line == opening_line || last_line == closing_line && !(jsx_child_next_row != null && jsx_child_group_contains(jsx_child_next_row, last_line))
  let single_group_wrong index == first(parent.jsx_child_rows).index && first_line == opening_line || index == last(parent.jsx_child_rows).index && last_line == closing_line
  when parent is (ts_jsx_element, ts_jsx_fragment) && field == "body" && jsx_child_row
  when !(allow == "non-jsx" && !parent.jsx_child_has_jsx || allow == "single-child" && parent.jsx_child_single || allow == "literal" && parent.jsx_child_single && parent.jsx_child_literal || allow == "single-line" && parent.jsx_child_single_line_allowed)
  when if allow == "single-line" && parent.jsx_child_one_group then single_group_wrong else first_wrong || last_wrong
  report at {start: offset, end: parent.end_offset}
  warn "`{jsx_child_descriptor}` must be placed on a new line"
}
in ts_node rule jsx-newline {
  option prevent boolean = false "prevent blank lines between children"
  option allowMultilines boolean = false "keep blank lines around multiline children"
  let multiline previous.jsx_child_preceding_multiline == true || jsx_child_next_multiline
  let blank re_test(previous.text, "\n" jsx_space_regex() "*\n")
  when parent is (ts_jsx_element, ts_jsx_fragment) && field == "body" && previous.layer is ts_jsx_text && previous.jsx_child_preceding_eligible
  when if allowMultilines && multiline then !blank else blank == prevent
  report at {start: offset, end: parent.end_offset}
  warn if allowMultilines && multiline then "Multiline JSX elements should start in a new line" else if prevent then "JSX element should not start in a new line" else "JSX element should start in a new line"
}
in ts_jsx_text rule jsx-child-element-spacing {
  let after re_test(text, "^" jsx_space_regex() "*\n") && jsx_trim_space(text) != ""
  let before jsx_trim_space(text) != "" && re_test(text, "\n" jsx_space_regex() "*$")
  let preceding after && previous != null
  when (previous != null || next != null) && (previous == null || previous.jsx_child_inline_name != null) && (next == null || next.jsx_child_inline_name != null)
  when preceding || before && next != null
  report at {start: if preceding then previous.end_offset else next.offset, end: parent.end_offset}
  warn "Ambiguous spacing {if preceding then 'after previous' else 'before next'} element {if preceding then previous.jsx_child_inline_name else next.jsx_child_inline_name}"
}
schema jsx_wrap_mode boolean | "ignore" | "parens" | "parens-new-line"
fn jsx_wrap_active(value) = value != false && value != "ignore"
in ts_jsx_element let jsx_wrap_element true
in ts_parenthesized let jsx_wrap_element expression.jsx_wrap_element == true
in ts_jsx_expression let jsx_prop_expression parent is ts_jsx_attribute
in ts_parenthesized, ts_jsx_element, ts_jsx_fragment, ts_conditional {
  let jsx_wrap_context if parent is ts_parenthesized then parent.jsx_wrap_context else if parent is ts_declarator && field == "init" then "declaration" else if parent is ts_assignment && field == "right" then "assignment" else if parent is ts_return && field == "argument" then "return" else if parent is ts_arrow && field == "body" then "arrow" else if parent is ts_logical && field == "right" then "logical" else if parent is ts_conditional && contains(["consequent", "alternate"], field) then "condition" else if parent is ts_jsx_expression && field == "expression" && parent.jsx_prop_expression then "prop" else if jsx_wrap_element && parent is ts_property && field == "value" then "propertyValue" else null
  let jsx_wrap_fallback if parent is ts_parenthesized then parent.jsx_wrap_fallback else if parent is ts_conditional then parent.jsx_wrap_context else null
  let jsx_call_argument if parent is ts_parenthesized then parent.jsx_call_argument else parent is (ts_call, ts_new) && field == "argument"
}
in ts_jsx_element, ts_jsx_fragment rule jsx-wrap-multilines {
  option declaration jsx_wrap_mode = "parens" "variable initializer wrapping"
  option assignment jsx_wrap_mode = "parens" "assignment wrapping"
  option return jsx_wrap_mode = "parens" "return expression wrapping"
  option arrow jsx_wrap_mode = "parens" "arrow body wrapping"
  option condition jsx_wrap_mode = "ignore" "conditional branch wrapping"
  option logical jsx_wrap_mode = "ignore" "logical right-hand side wrapping"
  option prop jsx_wrap_mode = "ignore" "JSX prop expression wrapping"
  option propertyValue jsx_wrap_mode = "ignore" "object property value wrapping"
  let context if jsx_wrap_context == "condition" && !jsx_wrap_active(condition) && contains(["declaration", "assignment"], jsx_wrap_fallback) then jsx_wrap_fallback else jsx_wrap_context
  let selected default(get({declaration: declaration, assignment: assignment, return: return, arrow: arrow, condition: condition, logical: logical, prop: prop, propertyValue: propertyValue}, context), "ignore")
  let parenthesized parent is ts_parenthesized
  when jsx_break(text) && jsx_wrap_active(selected)
  when !parenthesized || selected == "parens-new-line" && (!space_before.line_break || !space_after.line_break)
  warn if !parenthesized then "Missing parentheses around multilines JSX" else "Parentheses around JSX should be on separate lines"
}
in ts_jsx_element, ts_jsx_fragment rule jsx-function-call-newline {
  option mode "always" | "multiline" = "multiline" "call argument linebreak policy"
  when jsx_call_argument && (mode == "always" || jsx_break(text))
  when !space_before.line_break || next_token not ts_comma && !space_after.line_break
  warn "Missing line break around JSX"
}
fn jsx_presence_whitespace(value) = value != "" && jsx_trim_space(value) == ""
fn jsx_presence_edge(value) = re_test(value, "^" jsx_space_regex() "|" jsx_space_regex() "$")
fn jsx_presence_entities(value) = re_replace(value, /&[a-zA-Z0-9#]+;/, "")
in ts_parenthesized let jsx_presence_inner default(expression.jsx_presence_inner, expression.node)
in ts_jsx_expression {
  let jsx_presence_expression_inner default(expression.jsx_presence_inner, expression.node)
  let jsx_presence_comments count(descendants(ts_comment))
}
in ts_jsx_expression, ts_jsx_text, ts_string, ts_jsx_element, ts_jsx_fragment rule jsx-curly-brace-presence {
  option mode "always" | "never" | "ignore" = "never" "default brace policy"
  option props "always" | "never" | "ignore" | null = null "attribute literal brace policy"
  option children "always" | "never" | "ignore" | null = null "child literal brace policy"
  option propElementValues "always" | "never" | "ignore" = "ignore" "JSX element attribute brace policy"
  let attribute parent is ts_jsx_attribute && field == "value"
  let child parent is (ts_jsx_element, ts_jsx_fragment) && field == "body"
  let expression_node layer is ts_jsx_expression
  let inner jsx_presence_expression_inner
  let element_value attribute && (layer is ts_jsx_element || inner.layer is ts_jsx_element)
  let selected default(if attribute then props else children, mode)
  let string inner.layer is ts_string
  let template inner.layer is ts_template && count(inner.expression) == 0
  let value default(inner.literal_value.value, "")
  let spelling if template then slice(inner.text, 1, len(inner.text) - 1) else inner.text
  let escape contains(spelling, "\\") || jsx_presence_entities(spelling) != spelling || child && re_test(spelling, /[{}<>]/)
  let comment jsx_presence_comments > 0
  let removable if element_value then true else if !comment && string then !escape && !contains(value, "/*") && (!attribute || !jsx_presence_whitespace(value)) && (attribute || !jsx_presence_edge(value)) && (child || !re_test(value, /['"]/)) else if !comment && template then !escape && !contains(spelling, "\n") && !jsx_presence_edge(spelling) && !re_test(value, /['"]/) else !comment && inner.layer is (ts_jsx_element, ts_jsx_fragment)
  let adjacent previous.layer is ts_jsx_expression || next.layer is ts_jsx_expression
  let space_expression string && jsx_presence_whitespace(value)
  let unnecessary removable && !(child && (adjacent || space_expression && (count(parent.body) == 1 || previous.layer is ts_jsx_element || next.layer is ts_jsx_element)))
  let raw_line_break jsx_break(text) && jsx_trim_space(text) == ""
  let missing element_value || !raw_line_break && jsx_trim_space(jsx_presence_entities(text)) != ""
  when attribute || child
  when expression_node || element_value || layer is (ts_string, ts_jsx_text)
  when if element_value then (if expression_node then propElementValues == "never" else propElementValues != "ignore") else if expression_node then selected == "never" && unnecessary else selected == "always" && missing
  warn if expression_node then "Curly braces are unnecessary here." else "Need to wrap this literal in a JSX expression."
}

fn jsx_space_regex() = /[\t\n\u{b}\u{c}\r \u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}\u{feff}]/
fn jsx_js_space(text) = re_test(text, jsx_space_regex())
fn jsx_strip_space(text) = re_replace(text, jsx_space_regex(), "")
fn jsx_trim_space(text) = re_replace(re_replace(text, "^" jsx_space_regex() "*", ""), jsx_space_regex() "*$", "")
fn jsx_utf16_length(text) = len(text) + re_count(text, /[\u{10000}-\u{10ffff}]/)
fn jsx_break(text) = re_test(text, /[\n\r\u{2028}\u{2029}]/)
fn jsx_edge_space(text, opening) = default(re_find(text, if opening then "^" jsx_space_regex() "*" else jsx_space_regex() "*$"), "")
in ts_jsx_expression {
  let jsx_brace_container expression.layer not ts_spread
  let jsx_brace_attribute parent is ts_jsx_attribute
  let jsx_brace_single !jsx_break(default(expression, slice(text, 1, len(text) - 1)))
}
in ts_jsx_spread_attribute {
  let jsx_brace_container true
  let jsx_brace_attribute true
  let jsx_brace_single !jsx_break(argument)
}
in ts_jsx_expression, ts_jsx_spread_attribute {
  let jsx_brace_object starts_with(slice(text, 1 + len(jsx_edge_space(slice(text, 1), true))), "{{")
  let jsx_brace_left_break opener.ts_open_brace.space_after.line_break
}
in ts_open_brace, ts_close_brace {
  let jsx_brace_open layer is ts_open_brace
  let jsx_brace_gap if jsx_brace_open then space_after.text else space_before.text
  let jsx_brace_edge jsx_edge_space(jsx_brace_gap, jsx_brace_open)
  let jsx_brace_direction if jsx_brace_open then "after" else "before"
}
schema jsx_curly_config {when?: "always" | "never"; allowMultiline?: boolean; spacing?: {objectLiterals?: "always" | "never"}}
@macro jsx_curly_spacing_body {
  option options ("always" | "never" | {when?: "always" | "never"; allowMultiline?: boolean; spacing?: {objectLiterals?: "always" | "never"}; attributes?: boolean | jsx_curly_config; children?: boolean | jsx_curly_config})[] = [] "brace spacing and context overrides"
  let head first(options)
  let cfg if type_of(head) == "str" then default(first(slice(options, 1, 2)), {}) else default(head, {})
  let context_cfg if parent.jsx_brace_attribute then default(cfg.attributes, true) else default(cfg.children, false)
  let base_when if type_of(head) == "str" then head else default(cfg.when, "never")
  let scope_cfg if type_of(context_cfg) == "bool" then {} else context_cfg
  let object_spacing default(scope_cfg.spacing, default(cfg.spacing, {}))
  let spacing if parent.jsx_brace_object then default(object_spacing.objectLiterals, default(scope_cfg.when, base_when)) else default(scope_cfg.when, base_when)
  let multiline default(scope_cfg.allowMultiline, default(cfg.allowMultiline, true))
  when parent.jsx_brace_container && context_cfg != false
  when if spacing == "always" then jsx_brace_edge == "" || jsx_break(jsx_brace_edge) && !multiline else (if jsx_break(jsx_brace_edge) then !multiline else jsx_brace_edge != "")
  report at {start: offset, end: parent.end_offset}
  warn if jsx_break(jsx_brace_edge) then "There should be no newline {jsx_brace_direction} '{text}'" else if spacing == "always" then "A space is required {jsx_brace_direction} '{text}'" else "There should be no space {jsx_brace_direction} '{text}'"
}
in ts_open_brace rule jsx-curly-spacing:after {
  @jsx_curly_spacing_body
}
in ts_close_brace rule jsx-curly-spacing:before {
  @jsx_curly_spacing_body
}
@macro jsx_curly_newline_body {
  option mode "consistent" | "never" = "consistent" "default brace newline policy"
  option singleline "consistent" | "require" | "forbid" | null = null "single-line expression policy"
  option multiline "consistent" | "require" | "forbid" | null = null "multiline expression policy"
  let policy default(if parent.jsx_brace_single then singleline else multiline, if mode == "never" then "forbid" else "consistent")
  let needs if policy == "require" then true else if policy == "forbid" then false else parent.jsx_brace_left_break
  when parent is ts_jsx_expression && parent.jsx_brace_container
  when jsx_break(jsx_brace_gap) != needs
  report at {start: offset, end: parent.end_offset}
  warn "{if needs then 'Expected' else 'Unexpected'} newline {jsx_brace_direction} '{text}'."
}
in ts_open_brace rule jsx-curly-newline:after {
  @jsx_curly_newline_body
}
in ts_close_brace rule jsx-curly-newline:before {
  @jsx_curly_newline_body
}
in ts_jsx_attribute let jsx_tag_last_token_start if value.layer is ts_string then value.offset else end_offset
in ts_jsx_spread_attribute let jsx_tag_last_token_start end_offset
in ts_jsx_element {
  let jsx_tag_last_prop last([] property.node)
  let jsx_tag_name_line position(name.offset).js_line
}
in ts_open_angle, ts_close_angle, ts_punctuator {
  let jsx_tag_opening offset >= parent.jsx_syntax.opening.start && offset < parent.jsx_syntax.opening.end
  let jsx_tag_self_slash parent is ts_jsx_element && parent.jsx_syntax.self_closing && text == "/" && space_after.end == parent.jsx_syntax.opening.end - 1
  let jsx_tag_kind if parent not ts_jsx_element then null else if layer is ts_open_angle && offset == parent.jsx_syntax.opening.start then "afterOpening" else if layer is ts_open_angle && offset == parent.jsx_syntax.closing.start then "closingSlash" else if layer is ts_punctuator && text == "/" && space_before.start == parent.jsx_syntax.closing.start + 1 then "afterOpening" else if jsx_tag_self_slash then "closingSlash" else if layer is ts_close_angle && (end_offset == parent.jsx_syntax.opening.end && !parent.jsx_syntax.self_closing || end_offset == parent.jsx_syntax.closing.end) then "beforeClosing" else null
  let jsx_tag_gap_after layer is ts_open_angle || jsx_tag_kind == "afterOpening" || jsx_tag_self_slash
  let jsx_tag_gap if jsx_tag_gap_after then space_after else space_before
  let jsx_tag_span if jsx_tag_opening then parent.jsx_syntax.opening else parent.jsx_syntax.closing
}
@macro jsx_tag_spacing_body {
  option closingSlash "always" | "never" | "allow" = "never" "spacing beside the closing slash"
  option beforeSelfClosing "always" | "proportional-always" | "never" | "allow" = "always" "spacing before a self-closing slash"
  option afterOpening "always" | "allow-multiline" | "never" | "allow" = "never" "spacing after the opening bracket"
  option beforeClosing "always" | "proportional-always" | "never" | "allow" = "allow" "spacing before the closing bracket"
  let kind if jsx_tag_before_self then "beforeSelfClosing" else jsx_tag_kind
  let gap if jsx_tag_before_self then space_before else jsx_tag_gap
  let policy if kind == "closingSlash" then closingSlash else if kind == "beforeSelfClosing" then beforeSelfClosing else if kind == "afterOpening" then afterOpening else beforeClosing
  let single position(jsx_tag_span.start).js_line == position(jsx_tag_span.end).js_line
  let gap_newline position(gap.start).js_line != position(gap.end).js_line
  let start_newline if kind == "beforeClosing" && jsx_tag_opening && parent.jsx_tag_last_prop != null then position(parent.jsx_tag_last_prop.jsx_tag_last_token_start).js_line != position(offset).js_line else gap_newline
  let needs_newline policy == "proportional-always" && !single && !gap_newline
  let spaced jsx_js_space(gap.text)
  when if jsx_tag_before_self then jsx_tag_self_slash else jsx_tag_kind != null
  when policy != "allow"
  when if kind == "closingSlash" then spaced != (policy == "always") else if kind == "afterOpening" then spaced != (policy == "always") && !(policy == "allow-multiline" && gap_newline) else if needs_newline then true else if kind == "beforeSelfClosing" then !gap_newline && spaced != (policy != "never") else !start_newline && (if policy == "proportional-always" then jsx_tag_opening && spaced == single else spaced != (policy == "always"))
  report at {start: if needs_newline || kind == "beforeClosing" then gap.start else offset, end: parent.end_offset}
  warn if kind == "closingSlash" then (if jsx_tag_self_slash then (if policy == "always" then "Whitespace is required between `/` and `>`; write `/ >`" else "Whitespace is forbidden between `/` and `>`; write `/>`") else (if policy == "always" then "Whitespace is required between `<` and `/`; write `< /`" else "Whitespace is forbidden between `<` and `/`; write `</`")) else if needs_newline then "A newline is required before closing bracket" else if kind == "afterOpening" then (if policy == "always" then "A space is required after opening bracket" else "A space is forbidden after opening bracket") else if policy == "never" then "A space is forbidden before closing bracket" else if kind == "beforeSelfClosing" then "A space is required before closing bracket" else "Whitespace is required before closing bracket"
}
in ts_open_angle, ts_close_angle, ts_punctuator rule jsx-tag-spacing {
  let jsx_tag_before_self false
  @jsx_tag_spacing_body
}
in ts_punctuator rule jsx-tag-spacing:before-self-closing {
  let jsx_tag_before_self true
  @jsx_tag_spacing_body
}
schema jsx_bracket_location "after-props" | "props-aligned" | "tag-aligned" | "line-aligned"
in ts_close_angle, ts_punctuator rule jsx-closing-bracket-location {
  option mode jsx_bracket_location = "tag-aligned" "closing bracket alignment"
  option location jsx_bracket_location | null = null "alignment for both tag kinds"
  option nonEmpty jsx_bracket_location | boolean | null = null "alignment for paired opening tags"
  option selfClosing jsx_bracket_location | boolean | null = null "alignment for self-closing tags"
  let last_prop parent.jsx_tag_last_prop
  let last_line position(last_prop.end_offset).js_line
  let here position(offset)
  let opening position(parent.offset)
  let selected if last_prop == null then "after-tag" else if last_line == opening.js_line then "after-props" else default(if parent.jsx_syntax.self_closing then selfClosing else nonEmpty, default(location, mode))
  let aligned_column if selected == "props-aligned" then position(last_prop.offset).js_column else if selected == "tag-aligned" then opening.js_column else if selected == "line-aligned" then jsx_indent(parent.jsx_line_prefix) + 1 else null
  let aligned if selected == "after-tag" then parent.jsx_tag_name_line == here.js_line else if selected == "after-props" then last_line == here.js_line else aligned_column == here.js_column && (selected != "tag-aligned" || starts_with(parent.jsx_line_prefix, "\t") == starts_with(jsx_line_prefix, "\t"))
  let fallback !aligned && (contains(space_before.text, "/*") || contains(space_before.text, "//")) && contains(["after-tag", "after-props"], selected)
  let placement if fallback then "line-aligned" else selected
  let expected_column if fallback then jsx_indent(parent.jsx_line_prefix) + 1 else aligned_column
  when parent is ts_jsx_element && (jsx_tag_self_slash || layer is ts_close_angle && !parent.jsx_syntax.self_closing && end_offset == parent.jsx_syntax.opening.end)
  when type_of(selected) == "str" && !(if fallback then expected_column == here.js_column else aligned)
  report at {start: offset, end: parent.end_offset}
  warn "The closing bracket must be {if placement == 'after-tag' then 'placed after the opening tag' else if placement == 'after-props' then 'placed after the last prop' else if placement == 'props-aligned' then 'aligned with the last prop' else if placement == 'tag-aligned' then 'aligned with the opening tag' else 'aligned with the line containing the opening tag'}{if expected_column != null then ' (expected column ' expected_column (if last_prop != null && last_line == here.js_line then ' on the next line)' else ')') else ''}"
}
in ts_open_angle rule jsx-closing-tag-location {
  option mode "tag-aligned" | "line-aligned" = "tag-aligned" "closing-tag alignment"
  let here position(offset)
  let expected if mode == "tag-aligned" then position(parent.offset).js_column else jsx_indent(parent.jsx_line_prefix) + 1
  let own_line jsx_trim_space(jsx_line_prefix) == ""
  when parent is (ts_jsx_element, ts_jsx_fragment) && offset == parent.jsx_syntax.closing.start && position(parent.offset).js_line != here.js_line && here.js_column != expected
  report at {start: offset, end: parent.end_offset}
  warn if !own_line then "Closing tag of a multiline JSX expression must be on its own line." else if mode == "tag-aligned" then "Expected closing tag to match indentation of opening." else "Expected closing tag to be aligned with the line containing the opening tag"
}

fn jsx_items(value) = if type_of(value) == "list" then value else if value == null then [] else [value]
fn jsx_pascal(name) = re_test(name, /^\p{Uppercase}[\p{Uppercase}\p{Lowercase}0-9]*$/) && re_test(name, /[\p{Lowercase}0-9]/)
fn jsx_caps(name) = re_test(name, /^[\p{Uppercase}0-9](?:[\p{Uppercase}0-9_]*[\p{Uppercase}0-9])?$/)
in ts_jsx_element {
  let jsx_name_spelling jsx_strip_space(name)
  let jsx_intrinsic_name re_test(jsx_name_spelling, /^[a-z]/)
}
in ts_jsx_element rule jsx-self-closing-comp {
  option component boolean = true "check components"
  option html boolean = true "check intrinsic elements"
  let content jsx_items(body)
  let empty len(content) == 0 || len(content) == 1 && first(jsx_items(body.layer)) is ts_jsx_text && contains(first(content), "\n") && jsx_strip_space(first(content)) == "" && !re_test(first(content), /\u{a0}/)
  when closing != null && empty && (component && !jsx_intrinsic_name && !contains(jsx_name_spelling, ":") || html && jsx_intrinsic_name)
  warn "Empty components are self-closing"
}
in ts_jsx_element rule jsx-pascal-case {
  option allowAllCaps boolean = false "allow screaming snake case"
  option allowLeadingUnderscore boolean = false "allow one leading underscore"
  option allowNamespace boolean = false "check only the first namespace segment"
  option ignore string[] = [] "component-name globs to ignore"
  let parts split(replace(jsx_name_spelling, ":", "."), ".")
  let names if allowNamespace then slice(parts, 0, 1) else parts
  let bad find(names, n => jsx_utf16_length(n) == 1 || !(jsx_pascal(if allowLeadingUnderscore && starts_with(n, "_") then slice(n, 1) else n) || allowAllCaps && jsx_caps(if allowLeadingUnderscore && starts_with(n, "_") then slice(n, 1) else n) || any(ignore, p => re_test(n, "^" replace(replace(re_escape(p), "\\*", ".*"), "\\?", ".") "$"))))
  when !jsx_intrinsic_name && bad != null && jsx_utf16_length(bad) != 1
  warn "Imported JSX component {bad} must be in PascalCase{if allowAllCaps then ' or SCREAMING_SNAKE_CASE' else ''}"
}
in ts_jsx_element rule jsx-shorthand-fragment {
  when contains(["Fragment", "React.Fragment"], jsx_name_spelling) && property == null
  warn "Use shorthand fragment syntax `<>...</>` instead of `<{jsx_name_spelling}>...</{jsx_name_spelling}>`."
}
in ts_jsx_attribute rule jsx-shorthand-boolean {
  when value.layer is ts_jsx_expression && value.jsx_boolean_true == true
  warn "Omit the value for boolean attributes."
}
in ts_boolean let jsx_boolean_true text == "true"
in ts_parenthesized let jsx_boolean_true expression.jsx_boolean_true == true
in ts_jsx_expression let jsx_boolean_true expression.jsx_boolean_true == true
fn jsx_contains_quote(text, double) = contains(text, if double then '"' else "'") || re_test(text, if double then /&(?:quot|#\+?0*34|#[xX]\+?0*22);/ else /&(?:apos|#\+?0*39|#[xX]\+?0*27);/)
in ts_jsx_attribute.value rule jsx-quotes {
  option mode "prefer-double" | "prefer-single" = "prefer-double" "preferred attribute quote"
  let double mode == "prefer-double"
  when layer is ts_string
  when slice(text, 0, 1) != (if double then '"' else "'") && !jsx_contains_quote(slice(text, 1, len(text) - 1), double)
  warn "Unexpected usage of {if mode == 'prefer-double' then 'singlequote' else 'doublequote'}."
}
@macro jsx_equals_spacing_body {
  option mode "always" | "never" = "never" "spacing around equals"
  when parent is ts_jsx_attribute
  when jsx_js_space(if jsx_equals_before then space_before.text else space_after.text) != (mode == "always")
  report at {start: offset, end: parent.end_offset}
  warn if mode == "always" then "A space is required {if jsx_equals_before then 'before' else 'after'} '='" else "There should be no space {if jsx_equals_before then 'before' else 'after'} '='"
}
in ts_equals rule jsx-equals-spacing:before {
  let jsx_equals_before true
  @jsx_equals_spacing_body
}
in ts_equals rule jsx-equals-spacing:after {
  let jsx_equals_before false
  @jsx_equals_spacing_body
}
in ts_jsx_element {
  let jsx_opening_span jsx_syntax.opening
  let jsx_opening_single !jsx_break(byte_slice(text, 0, jsx_opening_span.end - offset))
  let jsx_property_count count(property)
  let jsx_first_prop_headline first([] property.jsx_prop_headline) == true
}
in ts_jsx_attribute, ts_jsx_spread_attribute {
  let jsx_prop_same !space_before.line_break
  let jsx_prop_headline !jsx_break(byte_slice(parent.text, 0, offset - parent.offset))
  let jsx_prop_first previous == null
  let jsx_prop_run if jsx_prop_same then 1 + default(previous.jsx_prop_run, 0) else 1
  let jsx_prop_group_index if jsx_prop_same && !jsx_prop_first then 1 + previous.jsx_prop_group_index else 0
}
in ts_jsx_attribute let jsx_prop_name jsx_strip_space(name)
in ts_parenthesized let jsx_unparenthesized_text default(expression.jsx_unparenthesized_text, expression)
in ts_jsx_spread_attribute let jsx_prop_name default(argument.jsx_unparenthesized_text, argument)
in ts_jsx_attribute, ts_jsx_spread_attribute rule jsx-first-prop-new-line {
  option mode "always" | "never" | "multiline" | "multiline-multiprop" | "multiprop" = "multiline-multiprop" "first prop placement"
  let should_wrap mode == "always" || mode == "multiline" && !parent.jsx_opening_single || mode == "multiline-multiprop" && !parent.jsx_opening_single && parent.jsx_property_count > 1 || mode == "multiprop" && parent.jsx_property_count > 1
  let should_inline mode == "never" || mode == "multiprop" && !parent.jsx_opening_single && parent.jsx_property_count <= 1
  when jsx_prop_first && (should_wrap && jsx_prop_headline || should_inline && !jsx_prop_headline)
  report at {start: offset, end: parent.end_offset}
  warn if should_wrap then "Property should be placed on a new line" else "Property should be placed on the same line as the component declaration"
}
in ts_jsx_attribute, ts_jsx_spread_attribute rule jsx-max-props-per-line {
  option maximum number(1..) | {single?: int(1..); multi?: int(1..)} = 1 "maximum props per line"
  option when "always" | "multiline" = "always" "which tags to check"
  let single_limit if type_of(maximum) == "num" then (if when == "multiline" then null else maximum) else maximum.single
  let multi_limit if type_of(maximum) == "num" then maximum else maximum.multi
  when jsx_prop_group_index == (if parent.jsx_opening_single && jsx_prop_headline then single_limit else multi_limit)
  report at {start: offset, end: parent.end_offset}
  warn "Prop `{jsx_prop_name}` must be placed on a new line"
}
in ts_jsx_attribute, ts_jsx_spread_attribute rule jsx-props-style {
  option singleLine {maxItems: int(0..) | null = null} = {} "single-line prop limit"
  option multiLine {minItems: int(0..) = 0; maxItemsPerLine: int(1..) = 1} = {} "multiline prop limits"
  let need_wrap if parent.jsx_opening_single then singleLine.maxItems != null && parent.jsx_property_count > singleLine.maxItems else parent.jsx_property_count >= multiLine.minItems && !parent.jsx_first_prop_headline
  when if need_wrap then jsx_prop_same && (jsx_prop_first || jsx_prop_run > multiLine.maxItemsPerLine && (jsx_prop_run - 1) % multiLine.maxItemsPerLine == 0) else !jsx_prop_same
  report at {start: offset, end: parent.end_offset}
  warn if need_wrap then "Prop `{jsx_prop_name}` must be placed on a new line" else "Prop `{jsx_prop_name}` should not be placed on a new line"
}

}
