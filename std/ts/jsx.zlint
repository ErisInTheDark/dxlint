# .ts/jsx: @stylistic's JSX rules (spacing, wrapping, props, closing tags),
# on the native `ts_jsx_*` layers.

define {

in ts_jsx_element rule jsx-indent-props {
  option mode int | "tab" | "first" = 4 "prop indent size or alignment"
  option indentMode int | "tab" | "first" | null = null "prop indent size or alignment"
  option ignoreTernaryOperator boolean = false "ignore ternary continuation indentation"
  let info jsx_prop_indent
  let selected default(indentMode, mode)
  let size if selected == "tab" then 1 else selected
  let base_indent if selected == "tab" then info.tabs else info.spaces
  each row in filter(info.props, p => p.first_in_line && (if selected == "first" then p.spaces != info.first_column else (if selected == "tab" then p.tabs else p.spaces) != base_indent + size * (if p.extra && !ignoreTernaryOperator then 2 else 1)))
  report at row.offset
  warn "Expected indentation of {if selected == 'first' then info.first_column else base_indent + size * (if row.extra && !ignoreTernaryOperator then 2 else 1)} {if selected == 'tab' then 'tab' else 'space'} {if (if selected == 'first' then info.first_column else base_indent + size * (if row.extra && !ignoreTernaryOperator then 2 else 1)) == 1 then 'character' else 'characters'} but found {if selected == 'tab' then row.tabs else row.spaces}."
}
in ts_jsx_element, ts_jsx_fragment rule jsx-one-expression-per-line {
  option allow "none" | "literal" | "single-child" | "single-line" | "non-jsx" = "none" "allowed same-line children"
  let info jsx_children
  when !(allow == "non-jsx" && !info.has_jsx || allow == "single-child" && info.single_child || allow == "literal" && info.single_child && info.literal_child || allow == "single-line" && info.single_line_allowed)
  each row in (if allow == "single-line" then info.single_line_reports else info.reports)
  report at row.offset
  warn "`{row.descriptor}` must be placed on a new line"
}
in ts_jsx_element, ts_jsx_fragment rule jsx-newline {
  option prevent boolean = false "prevent blank lines between children"
  option allowMultilines boolean = false "keep blank lines around multiline children"
  let info jsx_children
  each row in filter(info.newlines, p => if allowMultilines && p.multiline then !p.blank else p.blank == prevent)
  report at row.offset
  warn if allowMultilines && row.multiline then "Multiline JSX elements should start in a new line" else if prevent then "JSX element should not start in a new line" else "JSX element should start in a new line"
}
in ts_jsx_element, ts_jsx_fragment rule jsx-child-element-spacing {
  each row in jsx_children.spacing
  report at row.offset
  warn "Ambiguous spacing {if row.after then 'after previous' else 'before next'} element {row.name}"
}
schema jsx_wrap_mode boolean | "ignore" | "parens" | "parens-new-line"
fn jsx_wrap_active(value) = value != false && value != "ignore"
in ts_jsx_element let jsx_wrap_element true
in ts_parenthesized let jsx_wrap_element expression.jsx_wrap_element == true
in ts_jsx_expression let jsx_prop_expression parent is ts_jsx_attribute
in ts_parenthesized, ts_jsx_element, ts_jsx_fragment, ts_conditional {
  let jsx_wrap_context if parent is ts_parenthesized then parent.jsx_wrap_context else if parent is ts_declarator && field == "init" then "declaration" else if parent is ts_assignment && field == "right" then "assignment" else if parent is ts_return && field == "argument" then "return" else if parent is ts_arrow && field == "body" then "arrow" else if parent is ts_logical && field == "right" then "logical" else if parent is ts_conditional && contains(["consequent", "alternate"], field) then "condition" else if parent is ts_jsx_expression && field == "expression" && parent.jsx_prop_expression then "prop" else if jsx_wrap_element && parent is ts_property && field == "value" then "propertyValue" else null
  let jsx_wrap_fallback if parent is ts_parenthesized then parent.jsx_wrap_fallback else if parent is ts_conditional then parent.jsx_wrap_context else null
  let jsx_call_argument if parent is ts_parenthesized then parent.jsx_call_argument else parent is (ts_call, ts_new) && field == "argument"
}
in ts_jsx_element, ts_jsx_fragment rule jsx-wrap-multilines {
  option declaration jsx_wrap_mode = "parens" "variable initializer wrapping"
  option assignment jsx_wrap_mode = "parens" "assignment wrapping"
  option return jsx_wrap_mode = "parens" "return expression wrapping"
  option arrow jsx_wrap_mode = "parens" "arrow body wrapping"
  option condition jsx_wrap_mode = "ignore" "conditional branch wrapping"
  option logical jsx_wrap_mode = "ignore" "logical right-hand side wrapping"
  option prop jsx_wrap_mode = "ignore" "JSX prop expression wrapping"
  option propertyValue jsx_wrap_mode = "ignore" "object property value wrapping"
  let context if jsx_wrap_context == "condition" && !jsx_wrap_active(condition) && contains(["declaration", "assignment"], jsx_wrap_fallback) then jsx_wrap_fallback else jsx_wrap_context
  let selected default(get({declaration: declaration, assignment: assignment, return: return, arrow: arrow, condition: condition, logical: logical, prop: prop, propertyValue: propertyValue}, context), "ignore")
  let parenthesized parent is ts_parenthesized
  when jsx_break(text) && jsx_wrap_active(selected)
  when !parenthesized || selected == "parens-new-line" && (!space_before.line_break || !space_after.line_break)
  warn if !parenthesized then "Missing parentheses around multilines JSX" else "Parentheses around JSX should be on separate lines"
}
in ts_jsx_element, ts_jsx_fragment rule jsx-function-call-newline {
  option mode "always" | "multiline" = "multiline" "call argument linebreak policy"
  when jsx_call_argument && (mode == "always" || jsx_break(text))
  when !space_before.line_break || next_token not ts_comma && !space_after.line_break
  warn "Missing line break around JSX"
}
in ts_jsx_expression, ts_jsx_text, ts_string, ts_jsx_element, ts_jsx_fragment rule jsx-curly-brace-presence {
  option mode "always" | "never" | "ignore" = "never" "default brace policy"
  option props "always" | "never" | "ignore" | null = null "attribute literal brace policy"
  option children "always" | "never" | "ignore" | null = null "child literal brace policy"
  option propElementValues "always" | "never" | "ignore" = "ignore" "JSX element attribute brace policy"
  let info jsx_brace_presence
  let selected default(if info.scope == "props" then props else children, mode)
  when info != null && (if info.scope == "element" then (if info.expression then propElementValues == "never" else propElementValues != "ignore") else if info.expression then selected == "never" && info.unnecessary else selected == "always" && info.missing)
  warn if info.expression then "Curly braces are unnecessary here." else "Need to wrap this literal in a JSX expression."
}

fn jsx_space_regex() = /[\t\n\u{b}\u{c}\r \u{a0}\u{1680}\u{2000}-\u{200a}\u{2028}\u{2029}\u{202f}\u{205f}\u{3000}\u{feff}]/
fn jsx_js_space(text) = re_test(text, jsx_space_regex())
fn jsx_strip_space(text) = re_replace(text, jsx_space_regex(), "")
fn jsx_utf16_length(text) = len(text) + re_count(text, /[\u{10000}-\u{10ffff}]/)
fn jsx_break(text) = re_test(text, /[\n\r\u{2028}\u{2029}]/)
fn jsx_edge_space(text, opening) = default(re_find(text, if opening then "^" jsx_space_regex() "*" else jsx_space_regex() "*$"), "")
in ts_jsx_expression {
  let jsx_brace_container expression.layer not ts_spread
  let jsx_brace_attribute parent is ts_jsx_attribute
  let jsx_brace_single !jsx_break(default(expression, slice(text, 1, len(text) - 1)))
}
in ts_jsx_spread_attribute {
  let jsx_brace_container true
  let jsx_brace_attribute true
  let jsx_brace_single !jsx_break(argument)
}
in ts_jsx_expression, ts_jsx_spread_attribute {
  let jsx_brace_object starts_with(slice(text, 1 + len(jsx_edge_space(slice(text, 1), true))), "{{")
  let jsx_brace_left_break opener.ts_open_brace.space_after.line_break
}
in ts_open_brace, ts_close_brace {
  let jsx_brace_open layer is ts_open_brace
  let jsx_brace_gap if jsx_brace_open then space_after.text else space_before.text
  let jsx_brace_edge jsx_edge_space(jsx_brace_gap, jsx_brace_open)
  let jsx_brace_direction if jsx_brace_open then "after" else "before"
}
schema jsx_curly_config {when?: "always" | "never"; allowMultiline?: boolean; spacing?: {objectLiterals?: "always" | "never"}}
@macro jsx_curly_spacing_body {
  option options ("always" | "never" | {when?: "always" | "never"; allowMultiline?: boolean; spacing?: {objectLiterals?: "always" | "never"}; attributes?: boolean | jsx_curly_config; children?: boolean | jsx_curly_config})[] = [] "brace spacing and context overrides"
  let head first(options)
  let cfg if type_of(head) == "str" then default(first(slice(options, 1, 2)), {}) else default(head, {})
  let context_cfg if parent.jsx_brace_attribute then default(cfg.attributes, true) else default(cfg.children, false)
  let base_when if type_of(head) == "str" then head else default(cfg.when, "never")
  let scope_cfg if type_of(context_cfg) == "bool" then {} else context_cfg
  let object_spacing default(scope_cfg.spacing, default(cfg.spacing, {}))
  let spacing if parent.jsx_brace_object then default(object_spacing.objectLiterals, default(scope_cfg.when, base_when)) else default(scope_cfg.when, base_when)
  let multiline default(scope_cfg.allowMultiline, default(cfg.allowMultiline, true))
  when parent.jsx_brace_container && context_cfg != false
  when if spacing == "always" then jsx_brace_edge == "" || jsx_break(jsx_brace_edge) && !multiline else (if jsx_break(jsx_brace_edge) then !multiline else jsx_brace_edge != "")
  report at {start: offset, end: parent.end_offset}
  warn if jsx_break(jsx_brace_edge) then "There should be no newline {jsx_brace_direction} '{text}'" else if spacing == "always" then "A space is required {jsx_brace_direction} '{text}'" else "There should be no space {jsx_brace_direction} '{text}'"
}
in ts_open_brace rule jsx-curly-spacing:after {
  @jsx_curly_spacing_body
}
in ts_close_brace rule jsx-curly-spacing:before {
  @jsx_curly_spacing_body
}
@macro jsx_curly_newline_body {
  option mode "consistent" | "never" = "consistent" "default brace newline policy"
  option singleline "consistent" | "require" | "forbid" | null = null "single-line expression policy"
  option multiline "consistent" | "require" | "forbid" | null = null "multiline expression policy"
  let policy default(if parent.jsx_brace_single then singleline else multiline, if mode == "never" then "forbid" else "consistent")
  let needs if policy == "require" then true else if policy == "forbid" then false else parent.jsx_brace_left_break
  when parent is ts_jsx_expression && parent.jsx_brace_container
  when jsx_break(jsx_brace_gap) != needs
  report at {start: offset, end: parent.end_offset}
  warn "{if needs then 'Expected' else 'Unexpected'} newline {jsx_brace_direction} '{text}'."
}
in ts_open_brace rule jsx-curly-newline:after {
  @jsx_curly_newline_body
}
in ts_close_brace rule jsx-curly-newline:before {
  @jsx_curly_newline_body
}
macro jsx_tag_policy(p) (if p.kind == "closingSlash" then closingSlash else if p.kind == "beforeSelfClosing" then beforeSelfClosing else if p.kind == "afterOpening" then afterOpening else beforeClosing)
macro jsx_tag_newline(p) (jsx_tag_policy(p) == "proportional-always" && !p.single && !p.newline)
macro jsx_tag_wrong(p) (if p.kind == "closingSlash" then p.space != (jsx_tag_policy(p) == "always") else if p.kind == "afterOpening" then p.space != (jsx_tag_policy(p) == "always") && !(jsx_tag_policy(p) == "allow-multiline" && p.newline) else if jsx_tag_newline(p) then true else if p.kind == "beforeSelfClosing" then !p.newline && p.space != (jsx_tag_policy(p) != "never") else !p.start_newline && (if jsx_tag_policy(p) == "proportional-always" then p.opening && p.space == p.single else p.space != (jsx_tag_policy(p) == "always")))
in ts_jsx_element rule jsx-tag-spacing {
  option closingSlash "always" | "never" | "allow" = "never" "spacing beside the closing slash"
  option beforeSelfClosing "always" | "proportional-always" | "never" | "allow" = "always" "spacing before a self-closing slash"
  option afterOpening "always" | "allow-multiline" | "never" | "allow" = "never" "spacing after the opening bracket"
  option beforeClosing "always" | "proportional-always" | "never" | "allow" = "allow" "spacing before the closing bracket"
  each part in filter(jsx_tag_layout.parts, p => jsx_tag_policy(p) != "allow" && jsx_tag_wrong(p))
  report at if jsx_tag_newline(part) then part.left_end else part.offset
  warn if part.kind == "closingSlash" then (if part.self_closing then (if jsx_tag_policy(part) == "always" then "Whitespace is required between `/` and `>`; write `/ >`" else "Whitespace is forbidden between `/` and `>`; write `/>`") else (if jsx_tag_policy(part) == "always" then "Whitespace is required between `<` and `/`; write `< /`" else "Whitespace is forbidden between `<` and `/`; write `</`")) else if jsx_tag_newline(part) then "A newline is required before closing bracket" else if part.kind == "afterOpening" then (if jsx_tag_policy(part) == "always" then "A space is required after opening bracket" else "A space is forbidden after opening bracket") else if jsx_tag_policy(part) == "never" then "A space is forbidden before closing bracket" else if part.kind == "beforeSelfClosing" then "A space is required before closing bracket" else "Whitespace is required before closing bracket"
}
schema jsx_bracket_location "after-props" | "props-aligned" | "tag-aligned" | "line-aligned"
macro jsx_bracket_answer(c) (find(c.tag.locations, p => p.mode == c.placement))
in ts_jsx_element rule jsx-closing-bracket-location {
  option mode jsx_bracket_location = "tag-aligned" "closing bracket alignment"
  option location jsx_bracket_location | null = null "alignment for both tag kinds"
  option nonEmpty jsx_bracket_location | boolean | null = null "alignment for paired opening tags"
  option selfClosing jsx_bracket_location | boolean | null = null "alignment for self-closing tags"
  let checks map(filter(jsx_tag_layout.tags, t => t.opening), t => {tag: t, placement: if !t.has_props then "after-tag" else if t.last_on_open_line then "after-props" else default(if t.self_closing then selfClosing else nonEmpty, default(location, mode))})
  each check in filter(checks, c => jsx_bracket_answer(c) != null && !(jsx_bracket_answer(c)).correct)
  report at check.tag.bracket
  warn "The closing bracket must be {if (jsx_bracket_answer(check)).placement == 'after-tag' then 'placed after the opening tag' else if (jsx_bracket_answer(check)).placement == 'after-props' then 'placed after the last prop' else if (jsx_bracket_answer(check)).placement == 'props-aligned' then 'aligned with the last prop' else if (jsx_bracket_answer(check)).placement == 'tag-aligned' then 'aligned with the opening tag' else 'aligned with the line containing the opening tag'}{if (jsx_bracket_answer(check)).column != null then ' (expected column ' ((jsx_bracket_answer(check)).column + 1) (if check.tag.last_on_close_line then ' on the next line)' else ')') else ''}"
}
in ts_jsx_element, ts_jsx_fragment rule jsx-closing-tag-location {
  option mode "tag-aligned" | "line-aligned" = "tag-aligned" "closing-tag alignment"
  let info jsx_closing_tag
  when info != null && !info.single && info.column != (if mode == "tag-aligned" then info.open_column else info.indent)
  report at info.offset
  warn if !info.own_line then "Closing tag of a multiline JSX expression must be on its own line." else if mode == "tag-aligned" then "Expected closing tag to match indentation of opening." else "Expected closing tag to be aligned with the line containing the opening tag"
}

fn jsx_items(value) = if type_of(value) == "list" then value else if value == null then [] else [value]
fn jsx_pascal(name) = re_test(name, /^\p{Uppercase}[\p{Uppercase}\p{Lowercase}0-9]*$/) && re_test(name, /[\p{Lowercase}0-9]/)
fn jsx_caps(name) = re_test(name, /^[\p{Uppercase}0-9](?:[\p{Uppercase}0-9_]*[\p{Uppercase}0-9])?$/)
in ts_jsx_element {
  let jsx_name_spelling jsx_strip_space(name)
  let jsx_intrinsic_name re_test(jsx_name_spelling, /^[a-z]/)
}
in ts_jsx_element rule jsx-self-closing-comp {
  option component boolean = true "check components"
  option html boolean = true "check intrinsic elements"
  let content jsx_items(body)
  let empty len(content) == 0 || len(content) == 1 && first(jsx_items(body.layer)) is ts_jsx_text && contains(first(content), "\n") && jsx_strip_space(first(content)) == "" && !re_test(first(content), /\u{a0}/)
  when closing != null && empty && (component && !jsx_intrinsic_name && !contains(jsx_name_spelling, ":") || html && jsx_intrinsic_name)
  warn "Empty components are self-closing"
}
in ts_jsx_element rule jsx-pascal-case {
  option allowAllCaps boolean = false "allow screaming snake case"
  option allowLeadingUnderscore boolean = false "allow one leading underscore"
  option allowNamespace boolean = false "check only the first namespace segment"
  option ignore string[] = [] "component-name globs to ignore"
  let parts split(replace(jsx_name_spelling, ":", "."), ".")
  let names if allowNamespace then slice(parts, 0, 1) else parts
  let bad find(names, n => jsx_utf16_length(n) == 1 || !(jsx_pascal(if allowLeadingUnderscore && starts_with(n, "_") then slice(n, 1) else n) || allowAllCaps && jsx_caps(if allowLeadingUnderscore && starts_with(n, "_") then slice(n, 1) else n) || any(ignore, p => re_test(n, "^" replace(replace(re_escape(p), "\\*", ".*"), "\\?", ".") "$"))))
  when !jsx_intrinsic_name && bad != null && jsx_utf16_length(bad) != 1
  warn "Imported JSX component {bad} must be in PascalCase{if allowAllCaps then ' or SCREAMING_SNAKE_CASE' else ''}"
}
in ts_jsx_element rule jsx-shorthand-fragment {
  when contains(["Fragment", "React.Fragment"], jsx_name_spelling) && property == null
  warn "Use shorthand fragment syntax `<>...</>` instead of `<{jsx_name_spelling}>...</{jsx_name_spelling}>`."
}
in ts_jsx_attribute rule jsx-shorthand-boolean {
  when value.layer is ts_jsx_expression && value.jsx_boolean_true == true
  warn "Omit the value for boolean attributes."
}
in ts_boolean let jsx_boolean_true text == "true"
in ts_parenthesized let jsx_boolean_true expression.jsx_boolean_true == true
in ts_jsx_expression let jsx_boolean_true expression.jsx_boolean_true == true
fn jsx_contains_quote(text, double) = contains(text, if double then '"' else "'") || re_test(text, if double then /&(?:quot|#\+?0*34|#[xX]\+?0*22);/ else /&(?:apos|#\+?0*39|#[xX]\+?0*27);/)
in ts_jsx_attribute.value rule jsx-quotes {
  option mode "prefer-double" | "prefer-single" = "prefer-double" "preferred attribute quote"
  let double mode == "prefer-double"
  when layer is ts_string
  when slice(text, 0, 1) != (if double then '"' else "'") && !jsx_contains_quote(slice(text, 1, len(text) - 1), double)
  warn "Unexpected usage of {if mode == 'prefer-double' then 'singlequote' else 'doublequote'}."
}
@macro jsx_equals_spacing_body {
  option mode "always" | "never" = "never" "spacing around equals"
  when parent is ts_jsx_attribute
  when jsx_js_space(if jsx_equals_before then space_before.text else space_after.text) != (mode == "always")
  report at {start: offset, end: parent.end_offset}
  warn if mode == "always" then "A space is required {if jsx_equals_before then 'before' else 'after'} '='" else "There should be no space {if jsx_equals_before then 'before' else 'after'} '='"
}
in ts_equals rule jsx-equals-spacing:before {
  let jsx_equals_before true
  @jsx_equals_spacing_body
}
in ts_equals rule jsx-equals-spacing:after {
  let jsx_equals_before false
  @jsx_equals_spacing_body
}
in ts_jsx_element {
  let jsx_opening_span jsx_syntax.opening
  let jsx_opening_single !jsx_break(byte_slice(text, 0, jsx_opening_span.end - offset))
  let jsx_property_count count(property)
  let jsx_first_prop_headline first([] property.jsx_prop_headline) == true
}
in ts_jsx_attribute, ts_jsx_spread_attribute {
  let jsx_prop_same !space_before.line_break
  let jsx_prop_headline !jsx_break(byte_slice(parent.text, 0, offset - parent.offset))
  let jsx_prop_first previous == null
  let jsx_prop_run if jsx_prop_same then 1 + default(previous.jsx_prop_run, 0) else 1
  let jsx_prop_group_index if jsx_prop_same && !jsx_prop_first then 1 + previous.jsx_prop_group_index else 0
}
in ts_jsx_attribute let jsx_prop_name jsx_strip_space(name)
in ts_parenthesized let jsx_unparenthesized_text default(expression.jsx_unparenthesized_text, expression)
in ts_jsx_spread_attribute let jsx_prop_name default(argument.jsx_unparenthesized_text, argument)
in ts_jsx_attribute, ts_jsx_spread_attribute rule jsx-first-prop-new-line {
  option mode "always" | "never" | "multiline" | "multiline-multiprop" | "multiprop" = "multiline-multiprop" "first prop placement"
  let should_wrap mode == "always" || mode == "multiline" && !parent.jsx_opening_single || mode == "multiline-multiprop" && !parent.jsx_opening_single && parent.jsx_property_count > 1 || mode == "multiprop" && parent.jsx_property_count > 1
  let should_inline mode == "never" || mode == "multiprop" && !parent.jsx_opening_single && parent.jsx_property_count <= 1
  when jsx_prop_first && (should_wrap && jsx_prop_headline || should_inline && !jsx_prop_headline)
  report at {start: offset, end: parent.end_offset}
  warn if should_wrap then "Property should be placed on a new line" else "Property should be placed on the same line as the component declaration"
}
in ts_jsx_attribute, ts_jsx_spread_attribute rule jsx-max-props-per-line {
  option maximum number(1..) | {single?: int(1..); multi?: int(1..)} = 1 "maximum props per line"
  option when "always" | "multiline" = "always" "which tags to check"
  let single_limit if type_of(maximum) == "num" then (if when == "multiline" then null else maximum) else maximum.single
  let multi_limit if type_of(maximum) == "num" then maximum else maximum.multi
  when jsx_prop_group_index == (if parent.jsx_opening_single && jsx_prop_headline then single_limit else multi_limit)
  report at {start: offset, end: parent.end_offset}
  warn "Prop `{jsx_prop_name}` must be placed on a new line"
}
in ts_jsx_attribute, ts_jsx_spread_attribute rule jsx-props-style {
  option singleLine {maxItems: int(0..) | null = null} = {} "single-line prop limit"
  option multiLine {minItems: int(0..) = 0; maxItemsPerLine: int(1..) = 1} = {} "multiline prop limits"
  let need_wrap if parent.jsx_opening_single then singleLine.maxItems != null && parent.jsx_property_count > singleLine.maxItems else parent.jsx_property_count >= multiLine.minItems && !parent.jsx_first_prop_headline
  when if need_wrap then jsx_prop_same && (jsx_prop_first || jsx_prop_run > multiLine.maxItemsPerLine && (jsx_prop_run - 1) % multiLine.maxItemsPerLine == 0) else !jsx_prop_same
  report at {start: offset, end: parent.end_offset}
  warn if need_wrap then "Prop `{jsx_prop_name}` must be placed on a new line" else "Prop `{jsx_prop_name}` should not be placed on a new line"
}

}
