define {

# Returns of one function, for the inferred signature of a type parameter.
in ts_function, ts_arrow, ts_method let type_parameter_return_nodes descendants(ts_return)
# A `typeof` resolves to the queried value's type, which the value layer only
# reaches through the query itself.
in ts_function, ts_arrow, ts_method, ts_function_type, ts_method_signature, ts_call_signature let type_parameter_query_nodes descendants(ts_type_query)

fn type_parameter_usages(items) = {
  value { known: all(items, item => item.known), uses: flat_map(items, item => item.uses) }
}
fn type_parameter_handle_signature(signature, target, from_class, seen) =
  if signature.parameters == null || signature.has_receiver == null || signature.result == null
    then { known: false, uses: [] }
  else type_parameter_usages([
    type_parameter_usages(map(signature.parameters,
      parameter => type_parameter_handle(parameter, target, false, from_class, seen))),
    if signature.has_receiver == false then { known: true, uses: [] }
      else type_parameter_handle(signature.receiver, target, false, from_class, seen),
    type_parameter_handle(signature.result, target, true, from_class, seen),
  ])
fn type_parameter_object(part, target, from_class, seen) = {
  value children: if part.handle == null || contains(seen, part.handle) then null
    else value_children(part.handle, true, [])
  value signatures: if contains(part.traits, "callable") then value_signatures(part.handle) else []
  value if children == null then { known: false, uses: [] }
    else if signatures == null then { known: false, uses: [] }
    else type_parameter_usages([
      type_parameter_usages(map(children,
        edge => type_parameter_handle(edge.handle, target, false, from_class, seen [part.handle]))),
      type_parameter_usages(flat_map(signatures, arm => map(arm,
        signature => type_parameter_handle_signature(signature, target, from_class, seen [part.handle])))),
    ])
}
fn type_parameter_part(part, target, returned, from_class, seen) =
  if part.carrier.description.kind == "parameter" then {
    known: true,
    uses: if part.carrier.file == target.file && part.carrier.node == target.node then [true] else [],
  } else if part.carrier_known != true || part.product_known != true
    || count(part.uncertain_traits) > 0
    || any(part.traits, trait => contains(["any", "error", "unknown"], trait)) then { known: false, uses: [] }
  else if part.product != null && count(part.product.elements) == 0 then { known: true, uses: [] }
  else if count(part.carrier.arguments) > 0 && part.handle != null && contains(seen, part.handle)
    then { known: false, uses: [] }
  else if count(part.carrier.arguments) > 0 then {
    value multiple: from_class || (if part.carrier.description.kind == "template" then false
      else if part.product != null then returned && !part.product.readonly
      else if contains(["Array", "ReadonlyArray"], part.carrier.description.name)
        then returned && part.carrier.description.name == "Array" else true)
    value uses: type_parameter_usages(map(part.carrier.arguments,
      argument => if argument.value_handle != null
        then type_parameter_handle(argument, target, returned, from_class, seen [part.handle])
        else type_parameter_parts(argument, target, returned, from_class, seen [part.handle])))
    value { known: uses.known, uses: if multiple then uses.uses uses.uses else uses.uses }
  } else if any(part.traits, trait => contains(["structural", "callable"], trait))
    && !any(part.traits, trait => contains(["constructible", "intersection"], trait))
    then type_parameter_object(part, target, from_class, seen)
  else if any(part.traits, trait => contains(["structural", "callable", "constructible", "intersection"], trait))
    then { known: false, uses: [] }
  else { known: true, uses: [] }
fn type_parameter_arm(parts, target, returned, from_class, seen) =
  if any(parts, part => part.carrier.description.kind == "parameter")
    && any(parts, part => contains(part.traits, "structural")) then { known: false, uses: [] }
  else type_parameter_usages({
  value map(parts, part => {
    value usage: type_parameter_part(part, target, returned, from_class, seen)
    value { key: if part.carrier.description.kind == "named" then {
      description: part.carrier.description, arguments: part.carrier.arguments, usage: usage,
    } else part, usage: usage }
  })
  unique_by (part) part.key
  map (part) part.usage
})
fn type_parameter_parts(parts, target, returned, from_class, seen) =
  if parts == null || count(seen) > 8 then { known: false, uses: [] }
  else {
    value states: walk({ index: 0, known: true, uses: [] }, state =>
      if !state.known || state.index >= count(parts) then [] else {
        value arm: type_parameter_arm(get(parts, state.index), target, returned, from_class, seen)
        value [{
          index: state.index + 1,
          known: arm.known,
          uses: if count(arm.uses) > count(state.uses) then arm.uses else state.uses,
        }]
      })
    value result: last(states)
    value { known: result.known, uses: if result.known then result.uses else [] }
  }
fn type_parameter_value(parts, target, returned, from_class) = type_parameter_parts(parts, target, returned, from_class, [])
fn type_parameter_handle(source, target, returned, from_class, seen) = {
  value arms: value_parts(source)
  value if arms == null then { known: false, uses: [] }
    else type_parameter_parts(map(arms, arm => arm.parts), target, returned, from_class, seen)
}
fn type_parameter_written(source, parts, target, returned, from_class) = {
  value bare: ts_value_bare_type(source)
  value declaration: if bare is ts_type_reference && count(bare.type_argument.nodes) == 0
    && bare.name is ts_identifier then name_binding(bare.name.node).node.parent.node else null
  value if declaration is ts_type_parameter && declaration_identity(declaration) == target
    then { known: true, uses: [true] }
    else if source is (ts_type_literal, ts_function_type) then type_parameter_handle(source, target, returned, from_class, [])
    else type_parameter_value(parts, target, returned, from_class)
}
fn type_parameter_independent_parameter(parameter) =
  parameter.type is ts_type_keyword && contains(["any", "unknown"], parameter.type.text)
    || parameter.type == null && parameter.init == null
fn type_parameter_parameters(signature, target, from_class, declaration) = {
  value syntax: if declaration == null then null else declaration.calls_parameters
  value if syntax != null && all(syntax, parameter => type_parameter_independent_parameter(parameter))
    then { known: true, uses: [] }
    else if signature.parameters_known != true then { known: false, uses: [] }
    else type_parameter_usages(if syntax != null && count(signature.parameters) == count(syntax) then {
      value zip(signature.parameters, syntax)
      map (pair) if type_parameter_independent_parameter(last(pair)) then { known: true, uses: [] }
        else type_parameter_written(last(pair).type.node, first(pair), target, false, from_class)
    } else map(signature.parameters, parameter => type_parameter_value(parameter, target, false, from_class)))
}
fn type_parameter_signature(signature, target, from_class, result_type, declaration, inferred_result) = {
  value parameters: type_parameter_parameters(signature, target, from_class, declaration)
  value receiver: if signature.has_receiver == false then { known: true, uses: [] }
    else type_parameter_value(signature.receiver, target, false, from_class)
  value result: if result_type is ts_type_keyword && result_type.text == "unknown"
    then { known: true, uses: [] }
    else if declaration != null && result_type is ts_type_predicate && result_type.type != null
      then type_parameter_value(value_constituents(result_type.type.node), target, true, from_class)
    else if inferred_result != null then type_parameter_handle(inferred_result, target, true, from_class, [])
    else type_parameter_written(result_type, signature.result, target, true, from_class)
  value uses: type_parameter_usages([parameters, receiver, result])
  value {
    known: signature.receiver_known && signature.result_known && uses.known,
    uses: uses.uses,
  }
}
fn type_parameter_callable(n, target, from_class) = {
  value signatures: call_signatures(n)
  value declaration: if count(signatures) == 1 && count(first(signatures)) == 1 then n else null
  value lazy_signatures: if n.return_type == null && count(signatures) == 1 && count(first(signatures)) == 1
    then value_signatures(n) else null
  value inferred_result: if count(lazy_signatures) == 1 && count(first(lazy_signatures)) == 1
    then first(first(lazy_signatures)).result else null
  value if signatures == null || count(signatures) == 0 then { known: false, uses: [] }
    else type_parameter_usages({
      value signatures
      flat_map (arm) map(arm, signature => type_parameter_signature(signature, target, from_class,
        n.return_type.node, declaration, inferred_result))
    })
}
fn type_parameter_class(n, target) = type_parameter_usages(map(n.member.nodes,
  member => if member is ts_method then type_parameter_callable(member, target, true)
    else if member is ts_class_property then type_parameter_value(value_constituents(member), target, false, true)
    else { known: false, uses: [] }))

# Written signatures need no types: the references themselves say how often a
# parameter is used. One entry for the parameter, plus two for each use that is
# already repeated by its syntax (a generic argument, or a mutable array that
# is returned), which is how ESLint counts before it consults types.
fn type_parameter_type_reference(reference) =
  if reference.parent is ts_type_reference then reference.parent else null
fn type_parameter_argument_owner(reference) = {
  value reference_node: type_parameter_type_reference(reference)
  value if reference_node == null then null else find(
    walk(reference_node, item => if item.parent == null then null else item.parent.node),
    item => item.parent != null && item.parent is ts_type_reference
      && item.parent.type_argument != null
      && any(item.parent.type_argument.nodes, argument => argument.offset == item.offset))
}
fn type_parameter_array_owner(reference) = {
  value reference_node: type_parameter_type_reference(reference)
  value argument_owner: type_parameter_argument_owner(reference)
  value outer: if reference_node == null then null else
    last(walk(reference_node, item =>
      if item.parent is (ts_union, ts_intersection, ts_parenthesized_type) then item.parent else null))
  value if argument_owner != null then argument_owner
    else if outer != null && outer.parent is ts_array_type then outer.parent
    else null
}
fn type_parameter_repeated_reference(reference) = {
  value owner: type_parameter_argument_owner(reference)
  value owner != null && !(owner.name is ts_identifier && contains(["Array", "ReadonlyArray"], owner.name.text))
}
fn type_parameter_multiple_reference(reference, result) = {
  value owner: type_parameter_array_owner(reference)
  value array: if owner == null || result == null
    || !(result.offset <= owner.offset && owner.end_offset <= result.end_offset) then null else owner
  value array != null && !(array.parent is ts_type_operator && array.parent.operator == "readonly")
    && (array is ts_array_type || array.name is ts_identifier && array.name.text == "Array")
}
fn type_parameter_reference_uses(reference, result) =
  if type_parameter_repeated_reference(reference) || type_parameter_multiple_reference(reference, result)
    then [true, true] else [true]
fn type_parameter_return_owner(n) = {
  value child: last(walk(n, item =>
    if item is (ts_function, ts_arrow, ts_method) then null
    else if item.parent == null then null
    else if item.parent is (ts_function, ts_arrow, ts_method) then null
    else item.parent.node))
  value if child == null || child.parent == null then null else child.parent.node
}
fn type_parameter_result_layer(result, target) = {
  value bare: ts_value_bare_type(result)
  value declaration: if bare is ts_type_reference && count(bare.type_argument.nodes) == 0 && bare.name is ts_identifier
    && name_binding(bare.name.node) != null then name_binding(bare.name.node).node.parent.node else null
  # Another parameter's constraint already counts wherever that parameter is
  # written, so a bare `U` in the result adds nothing of its own.
  value other_parameter: declaration is ts_type_parameter && declaration_identity(declaration).node != target.node
  value if result is ts_type_keyword || other_parameter then { known: true, uses: [] }
    else type_parameter_handle(result, target, true, false, [])
}
fn type_parameter_inferred_usage(n, target, returns) = {
  value signatures: call_signatures(n)
  value known: count(signatures) == 1 && count(first(signatures)) == 1
  value result: if known then first(first(value_signatures(n))).result else null
  value body_values: if n is ts_arrow && n.body.node != null && n.body.node not ts_block then [n.body.node] else []
  value returned_values: map(returns, item => item.argument.node)
  value values: if result != null then [] else filter(body_values returned_values, value => value != null)
  value states: map(values, value => {
    value usage: type_parameter_handle(value, target, true, false, [])
    # A property read the layer cannot resolve (`x.length` on a constrained
    # parameter) yields a concrete member type, never an indexed `T[K]`.
    value if value is ts_member && !usage.known then { known: true, uses: [] } else usage
  })
  value if !known then { known: false, uses: [] }
    else if result != null then type_parameter_result_layer(result, target)
    else if any(states, state => !state.known) then { known: false, uses: [] }
    else type_parameter_usages(states)
}
fn type_parameter_written_usage(n, references, result, target, returns, queries) = {
  value result_references: if result == null then [] else filter(references, reference =>
    result.offset <= reference.offset && reference.end_offset <= result.end_offset)
  value other_references: if result == null then references else filter(references, reference =>
    !(result.offset <= reference.offset && reference.end_offset <= result.end_offset))
  value result_syntax: flat_map(result_references, reference => type_parameter_reference_uses(reference, result))
  value result_layer: if result == null then null else type_parameter_result_layer(result, target)
  value result_uses: if result_layer != null && result_layer.known && count(result_layer.uses) > count(result_syntax)
    then result_layer.uses else result_syntax
  value syntax_uses: ([true] flat_map(other_references, reference => type_parameter_reference_uses(reference, result))
    result_uses)
  value result_queries: if result == null then [] else
    filter(queries, query => result.offset <= query.offset && query.end_offset <= result.end_offset)
  value inferred: if result != null
    then { known: !(count(result_syntax) == 0 && result_layer != null && !result_layer.known && count(result_queries) > 0),
      uses: [] }
    else type_parameter_inferred_usage(n, target, returns)
  value if inferred.known then { known: true, uses: (syntax_uses inferred.uses) } else { known: false, uses: [] }
}

in ts_type_parameter rule es-no-unnecessary-type-parameters warn "Type parameter {name} is {type_parameter_uses} in the {type_parameter_descriptor} signature." {
  let type_parameter_owner parent.node
  when type_parameter_owner is (ts_function, ts_arrow, ts_method, ts_function_type,
    ts_method_signature, ts_call_signature, ts_class)
  when !(type_parameter_owner is ts_class)
    || (type_parameter_owner.extends == null && count(type_parameter_owner.implements) == 0)
  let type_parameter_descriptor if type_parameter_owner is ts_class then "class" else "function"
  let type_parameter_binding name_binding(name.node)
  when type_parameter_binding != null
  let type_parameter_boundary if type_parameter_owner is ts_arrow && type_parameter_owner.body.node not ts_block
    then type_parameter_owner.end_offset
    else type_parameter_owner.body.offset ?? type_parameter_owner.return_type.end_offset ?? type_parameter_owner.end_offset
  let type_parameter_references {
    value type_parameter_binding.references
    filter (reference) contains(name_role_classes(reference, "reference"), "type")
      && reference.offset <= type_parameter_boundary
      && (reference.offset >= node.end_offset || reference.end_offset <= node.offset)
  }
  let type_parameter_returns filter(type_parameter_owner.type_parameter_return_nodes ?? [],
    item => type_parameter_return_owner(item).offset == type_parameter_owner.offset)
  let type_parameter_result_queries if type_parameter_owner.return_type == null then []
    else type_parameter_owner.type_parameter_query_nodes ?? []
  let type_parameter_target declaration_identity(node)
  let type_parameter_usage if type_parameter_owner is ts_class
    then type_parameter_class(type_parameter_owner, type_parameter_target)
    else type_parameter_written_usage(type_parameter_owner, type_parameter_references,
      type_parameter_owner.return_type.node, type_parameter_target, type_parameter_returns, type_parameter_result_queries)
  when type_parameter_usage.known
    && count(type_parameter_usage.uses) < (if type_parameter_owner is ts_class then 2 else 3)
  let type_parameter_uses if type_parameter_owner is ts_class
    then if count(type_parameter_usage.uses) == 0 then "never used" else "used only once"
    else if count(type_parameter_usage.uses) < 2 then "never used" else "used only once"
}
}
