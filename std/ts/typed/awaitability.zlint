import .ts/scoping/usage

define {

fn ts_awaited_callback(callback) = {
  value signatures: value_signatures(callback)
  value headers: flat_map(signatures ?? [], arm => arm)
  value values: map(headers, header => first(header.parameters))
  value {
    known: signatures != null && all(headers, header => header.parameters != null)
      && all(values, value => value != null),
    values: values,
  }
}
fn ts_awaited_fulfilments(arm) = {
  value member: value_lookup(arm, "then").member
  value signatures: if member != null then value_signatures(member) else null
  value headers: flat_map(signatures ?? [], alternative => alternative)
  value callbacks: map(headers, header => value_alternatives(first(header.parameters)))
  value states: flat_map(callbacks, alternatives => map(alternatives ?? [], callback => ts_awaited_callback(callback)))
  value values: flat_map(states, state => state.values)
  value {
    known: signatures != null && count(headers) > 0 && all(callbacks, alternatives => alternatives != null)
      && all(states, state => state.known) && count(values) > 0,
    values: values,
  }
}
fn ts_awaited_step(entry) = {
  value arms: if contains(entry.seen, entry.source) then null else value_alternatives(entry.source)
  value states: map(arms ?? [], arm => {
    value parts: value_constituents(arm)
    value terminal: parts != null && count(parts) == 1 && count(first(parts)) == 1
      && any(first(parts), part => contains(part.traits, "any") || contains(part.traits, "unknown")
        || contains(part.traits, "object") && all(part.traits, trait => contains(["object", "truthy"], trait))
          && part.uncertain_traits == [] && part.carrier_known && part.carrier == null
          && part.product_known && part.product == null && part.identity_known && part.identity == null)
    value ordinary: if terminal then true else ts_value_nonthenable(arm)
    value fulfilment: if ordinary == false then ts_awaited_fulfilments(arm) else null
    value {
      known: ordinary == true || fulfilment.known == true,
      leaves: if ordinary == true then [arm] else [],
      children: if fulfilment.known == true then fulfilment.values else [],
    }
  })
  value {
    known: arms != null && all(states, state => state.known),
    leaves: if arms == [] then [value_union(entry.source, [])] else flat_map(states, state => state.leaves),
    children: map(flat_map(states, state => state.children), source =>
      {source: source, seen: entry.seen [entry.source]}),
  }
}
fn ts_awaited_union(values) = if count(values) == 0 then null else value_union(first(values), slice(values, 1))
fn ts_awaited_value(n, source) = {
  value limit: 64
  value states: walk({pending: [{source: source, seen: []}], leaves: [], steps: 0, known: true}, state =>
    if !state.known || count(state.pending) == 0 || state.steps >= limit then [] else {
      value step: ts_awaited_step(first(state.pending))
      value pending: slice(state.pending, 1) step.children
      value [{
        pending: pending,
        leaves: state.leaves step.leaves,
        steps: state.steps + 1,
        known: step.known && count(pending) <= limit,
      }]
    })
  value result: last(states)
  value if !result.known || count(result.pending) > 0 then null else ts_awaited_union(result.leaves)
}
fn ts_await_union_equivalent(n) = {
  value arms: value_alternatives(n)
  value states: map(arms ?? [], arm => {handle: arm, ordinary: ts_value_nonthenable(arm)})
  value ordinary: filter(states, state => state.ordinary == true)
  value asynchronous: filter(states, state => state.ordinary == false)
  value if arms == null || any(states, state => state.ordinary == null)
    || count(ordinary) == 0 || count(asynchronous) == 0 then null else {
    value awaited: ts_awaited_value(n, ts_awaited_union(map(asynchronous, state => state.handle)))
    value other: ts_awaited_union(map(ordinary, state => state.handle))
    value forward: if awaited != null && other != null then value_accepts(other, awaited, "value", "value") else null
    value reverse: if awaited != null && other != null then value_accepts(awaited, other, "value", "value") else null
    value if forward == null || reverse == null then null else forward && reverse
  }
}

fn ts_await_warning_site(n) = function_head_site(n)
fn ts_await_function_name(n) = {
  value name: n.function_name ?? "async function"
  value holder: outer_parenthesised_node(n).parent.node
  value if !n.ts_usage_typed then name
    else if n.name == null && holder is ts_declarator && holder.name is ts_identifier
      then name " '" holder.name.text "'"
    else if n is ts_method && n.key is ts_string && js_string(n.key.text) == ""
      then re_replace(name, / ''$/, "")
    else name
}

fn ts_awaitable_result(n) = n != null
  && unparenthesised_node(n) not (ts_null, ts_boolean, ts_number, ts_bigint, ts_string, ts_template)
  && n could thenable
fn ts_await_nonthenable_element(handle) = {
  value arms: value_parts(handle)
  value arms != null && any(arms, arm => ts_value_nonthenable(arm.handle) == true
    && all(arm.parts, part => !contains(part.traits, "any") && !contains(part.traits, "unknown")))
}
fn ts_await_iterable_elements(part, n) = {
  value shape: ts_value_array_part(part, n)
  value if shape.tuple then value_children(part.handle, true, [])
    else if shape.array then value_children(part.handle, false, [0])
    else if part.carrier == null then [] else {
      value ancestry: ts_value_ancestry(part)
      value bases: filter(ancestry.parts, base => base.carrier.description.kind == "named"
        && contains(["Iterable", "IterableIterator", "Generator", "Set", "ReadonlySet"], base.carrier.description.name)
        && ts_value_builtin_part(base, n, [base.carrier.description.name]) == true)
      value flat_map(bases, base => value_children(base.handle, false, [0]) ?? [])
    }
}
fn ts_await_nonawaitable_iterable(n) = {
  value arms: value_parts(n)
  value arms != null && any(arms, arm => any(arm.parts, part =>
    any(ts_await_iterable_elements(part, n) ?? [], element => element.member.optional == true
      || ts_await_nonthenable_element(element.handle))))
}
group ts_await_sites ts_await, ts_for_of, ts_variable_declaration, ts_return, ts_yield
in ts_node let ts_await_owner parent.ts_await_owner
in ts_function, ts_arrow, ts_method let ts_await_owner node
in ts_node let ts_await_descendants descendants(ts_await_sites)
fn ts_missing_await(n) = {
  value if !contains(n.modifier, "async") || n.body == null
    || n.body.node is ts_block && count(n.body.body.nodes) == 0 then null else {
    value body: n.body.node
    value generator: contains(n.modifier, "*")
    value sites: {
      value [body] body.ts_await_descendants
      filter (current) current is ts_await_sites && current.ts_await_owner == n
    }
    value awaited: any(sites, site => site is ts_await
      || site is ts_for_of && contains(site.modifier, "await")
      || site is ts_variable_declaration && site.kind == "await using")
    value if awaited then null else {
      value typed: n.ts_usage_typed
      value if !typed && generator then null else {
        value asynchronous: typed && (body not ts_block && ts_awaitable_result(body)
          || any(sites, site => site is ts_return && ts_awaitable_result(site.argument.node)
            || generator && site is ts_yield && site.argument != null
              && (if site.operator == "*" then value_has_member(site.argument.node,
                { global: "Symbol", class: "value", path: ["asyncIterator"] }, null) == true
                else ts_awaitable_result(site.argument.node))))
        value if asynchronous then null else {
          value name: ts_await_function_name(n)
          value { name: upper(slice(name, 0, 1)) slice(name, 1) }
        }
      }
    }
  }
}
in ts_function, ts_arrow, ts_method let missing_await ts_missing_await(node)

}
