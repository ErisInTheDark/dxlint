import .ts/scoping/usage

define {

fn ts_missing_await(n) = {
  value if !contains(n.modifier, "async") || n.body == null
    || n.body.node is ts_block && count(n.body.body.nodes) == 0 then null else {
    value body: n.body.node
    value generator: contains(n.modifier, "*")
    value typed: n.ts_usage_typed
    value if !typed && generator then null else {
      value sites: {
        value [body]
        walk (current) if current is (ts_function, ts_arrow, ts_method) then null else current.children.nodes
        filter (current) current is (ts_await, ts_for_of, ts_variable_declaration, ts_return, ts_yield)
      }
      value awaited: any(sites, site => site is ts_await
        || site is ts_for_of && contains(site.modifier, "await")
        || site is ts_variable_declaration && site.kind == "await using")
      value if awaited then null else {
        value asynchronous: typed && (body not ts_block && body could thenable
          || any(sites, site => site is ts_return && site.argument.node could thenable
            || generator && site is ts_yield && site.argument != null
              && (if site.operator == "*" then value_has_member(site.argument.node,
                { global: "Symbol", class: "value", path: ["asyncIterator"] }) == true
                else site.argument.node could thenable)))
        value if asynchronous then null else {
          value name: n.function_name ?? "async function"
          value { name: upper(slice(name, 0, 1)) slice(name, 1) }
        }
      }
    }
  }
}
in ts_function, ts_arrow, ts_method let missing_await ts_missing_await(node)

}
