import .ts/type-specifiers

define {

fn readonly_parameter_marker(part) = count(part.traits) == 1 && contains(part.traits, "intersection")
fn readonly_parameter_uncertain(part) = !readonly_parameter_marker(part)
  && any(part.uncertain_traits, trait => !contains(["thenable", "nonthenable"], trait))
fn readonly_parameter_array(part) = contains(["Array", "ReadonlyArray"], part.carrier.description.name)
fn readonly_parameter_scalar(part) =
  !any(part.traits, trait => contains(["object", "structural", "callable", "constructible"], trait))
  && any(part.traits, trait => contains(["any", "unknown", "undefined", "null", "boolean", "number", "string", "bigint", "symbol", "void"], trait))
fn readonly_parameter_allowed(part, settings) = {
  value carrier: part.carrier
  value name: carrier.description.name
  value origin: if part.carrier_known && name != null && count(settings.allow) > 0
    then declaration_origin(settings.node, {file: carrier.file, node: carrier.node}) else null
  value gate: {name: name, from: if origin.kind == "library" then "lib" else origin.kind,
    path: origin.path, package: origin.package}
  value any(settings.allow, entry => type_specifier_matches(entry, gate, settings.directory))
}
fn readonly_parameter_annotation_allowed(annotation, allow) = if annotation == null || count(allow) == 0 then false else {
  value sources: value_sources(annotation)
  value alias: if count(sources.sites) == 1 then first(sources.sites) else null
  value origin: if alias.kind == "ts_type_alias" then declaration_origin(annotation, alias) else null
  value gate: {name: alias.name, from: if origin.kind == "library" then "lib" else origin.kind,
    path: origin.path, package: origin.package}
  value alias.kind == "ts_type_alias"
    && any(allow, entry => type_specifier_matches(entry, gate, program_directory(annotation)))
}
fn readonly_parameter_indexer_sources(part) =
  flat_map([{domain: "text"}, {domain: "ordinal"}], key => {
    value lookup: value_lookup(part.handle, key)
    value if lookup == null then [] else filter(flat_map(lookup.alternatives, arm => arm.sources), source => source.kind == "indexer")
  })
fn readonly_parameter_indexer_mutable(part) =
  any(readonly_parameter_indexer_sources(part), source => !contains(source.flags, "readonly"))
fn readonly_parameter_branded(arm) = {
  value parts: filter(arm.parts, part => !readonly_parameter_marker(part))
  value count(parts) > 1
  && !any(parts, part => readonly_parameter_uncertain(part))
  && any(parts, part => any(part.traits, trait => contains(["string", "number", "bigint"], trait)))
  && any(parts, part => contains(part.traits, "object_literal"))
  && all(parts, part =>
    any(part.traits, trait => contains(["string", "number", "bigint"], trait))
    || contains(part.traits, "object_literal")
      && !contains(part.traits, "callable") && !contains(part.traits, "constructible"))
}
fn readonly_parameter_children(handle, members, arguments, unchecked) = {
  value children: value_children(handle, members, arguments)
  value {
    answer: if children == null then null else true,
    children: map(children ?? [], edge => if unchecked then {kind: "source", source: edge.handle, root: false}
      else {kind: "edge", edge: edge}),
  }
}
fn readonly_parameter_step(entry, settings) = if entry.kind == "source" then {
  value arms: value_parts(entry.source)
  value skipped: entry.root && count(arms) > 0 && all(arms, arm => readonly_parameter_branded(arm))
  value {
    answer: if arms == null then null else true,
    children: if skipped then [] else map(arms ?? [], arm => {kind: "arm", arm: arm}),
  }
} else if entry.kind == "edge" then {
  value edge: entry.edge
  value writable: edge.member != null && !any(edge.member.sources, source => contains(source.flags, "readonly")
    || contains(source.flags, "private") || settings.methods && contains(source.flags, "method"))
  value {answer: !writable, children: if writable then [] else [{kind: "source", source: edge.handle, root: false}]}
} else if entry.kind == "part" then {
  value part: entry.part
  value branch: if readonly_parameter_marker(part) then {answer: true, children: []}
    else if contains(part.traits, "error") then {answer: null, children: []}
    else if readonly_parameter_array(part) then
      if part.carrier.description.name == "Array" then {answer: false, children: []}
      else readonly_parameter_children(part.handle, false, map(part.carrier.arguments, (argument, index) => index), false)
    else if part.product != null then
      if part.product.readonly then readonly_parameter_children(part.handle, true, [], true)
      else {answer: false, children: []}
    else readonly_parameter_children(part.handle, true, [], false)
  value {answer: if branch.answer == false then false else if readonly_parameter_uncertain(part) then null else branch.answer,
    children: branch.children}
} else {
  value arm: entry.arm
  value allowed: !any(arm.parts, part => contains(part.traits, "error"))
    && any(arm.parts, part => readonly_parameter_allowed(part, settings))
  value branch: if allowed then {answer: true, children: []}
    else if any(arm.parts, part => contains(part.traits, "error")) then {answer: null, children: []}
    else if any(arm.parts, part => part.carrier.description.kind == "parameter")
        && !any(arm.parts, part => readonly_parameter_marker(part))
      || all(arm.parts, part => readonly_parameter_scalar(part)) then {answer: true, children: []}
    else if any(arm.parts, part => readonly_parameter_indexer_mutable(part)) then {answer: false, children: []}
    else if any(arm.parts, part => readonly_parameter_array(part) || part.product != null) then
      {answer: true, children: map(arm.parts, part => {kind: "part", part: part})}
    else readonly_parameter_children(arm.handle, true, [], false)
  value {answer: if allowed then true else if branch.answer == false then false
      else if any(arm.parts, part => readonly_parameter_uncertain(part)) then null else branch.answer,
    children: branch.children}
}
fn readonly_parameter_has_mutable(source, methods, allow) = {
  value settings: {node: source, methods: methods, allow: allow,
    directory: if count(allow) > 0 then program_directory(source) else null}
  value states: walk({kind: "source", source: source, root: true}, entry => readonly_parameter_step(entry, settings).children)
  value any(states, entry => readonly_parameter_step(entry, settings).answer == false)
}

in ts_parameter rule prefer-readonly-parameter-types {
  option allow (string | type_specifier_file | type_specifier_lib | type_specifier_package)[] = [] "Allowed type names and declaration origins"
  option checkParameterProperties boolean = true "Check constructor parameter properties"
  option ignoreInferredTypes boolean = false "Check only parameters with written types"
  option treatMethodsAsReadonly boolean = false "Ignore method writability"
  when parent is (ts_function, ts_arrow, ts_method, ts_function_type, ts_method_signature, ts_call_signature)
  when checkParameterProperties || !any([] modifier, modifier => contains(["private", "public", "protected", "readonly"], modifier))
  when !ignoreInferredTypes || type != null
  when type not ts_type_keyword
    || !contains(["any", "unknown", "undefined", "null", "void", "never", "boolean", "number", "string", "bigint", "symbol"], type.text)
  let readonly_parameter_source type.node ?? init.node ?? node
  when !readonly_parameter_annotation_allowed(type.node, allow)
  when readonly_parameter_has_mutable(readonly_parameter_source, treatMethodsAsReadonly, allow)
  report at { start: name.offset, end: end_offset }
  warn "Parameter should be a read only type."
}
}
