# Unnecessary template interpolations and raw-escape-preserving fixes.
import .ts/expression-fixes
import .ts/template-fixes

define {

fn template_expression_subject(n) = if n is ts_literal_type then n.value.node else unparenthesised_node(n)
fn template_expression_whitespace(n) = if n is ts_string then n.literal_value.type == "string" && re_test(n.literal_value.value, /^[\t\v\f \r\n\uFEFF\p{Zs}\u2028\u2029]*$/) else n is (ts_template, ts_template_type) && count(n.quasi) == 1 && {
  value n.quasi
  first_quasi: first
  value result: { value n.quasi; first; byte_len } - 1
  value byte_slice(first_quasi, 1, result)
  re_test /^[\t\v\f \r\n\uFEFF\p{Zs}\u2028\u2029]*$/
}
fn template_expression_literal(n, type_syntax) = n is ts_literal || n is (ts_template, ts_template_type) || (if type_syntax then n is ts_type_keyword && contains(["null", "undefined"], n.text) else n is ts_identifier && contains(["undefined", "Infinity", "NaN"], n.text))
fn template_expression_string(n, single, type_syntax) = single && n.type_is_string_like && (!type_syntax || !n.type_is_parameter && !ts_value_has_enum(n))

fn template_regex_text(n) = {
  value flags: re_find(n.text, /[a-z]*$/)
  value body: re_replace(n.text, /[a-z]*$/, "")
  value split("dgimsuvy", "")
  filter (flag) contains(flags, flag)
  canonical_flags: join ""
  value body canonical_flags
}
fn template_interpolation_raw(n) = if n is ts_string then { value slice(n.text, 1, -1); template_literal_raw (["'", '"']) }
  else if n is (ts_template, ts_template_type) then slice(n.text, 1, -1)
  else if n is ts_regex then { value template_regex_text(n); re_replace /\\/ "\\\\"; template_literal_raw (["'", '"']) }
  else n.literal_value.value.nonempty ?? n.text
fn template_unescaped_dollar(text) = re_test(text, /(^|[^\\])(?:\\\\)*\$$/)
fn template_interpolation_fix(source, n, interpolation) = if interpolation.string_only then {
  value operand: interpolation.expression
  value parens: expression_fix_parens(source, n, operand)
  value wrapped: expression_fix_wrap(operand.text, parens > 0)
  value if parens == null then null else {
    target: n,
    text: expression_fix_edges(n, wrapped)
  }
} else if interpolation.subject is ts_string && re_test(interpolation.subject.text, /(^|[^\\])(?:\\\\)*\\(?:[1-9]|0[0-9])/) then null else {
  value raw_text: template_interpolation_raw(interpolation.subject)
  value previous: byte_slice(source, interpolation.previous.offset, interpolation.previous.end_offset - 2)
  value following: slice(interpolation.following.text, 1)
  # A valid string NUL escape must not become a legacy octal escape on joining.
  value raw: if re_test(raw_text, /(^|[^\\])(?:\\\\)*\\0$/) && re_test(following, /^[0-9]/) then slice(raw_text, 0, -2) "\\x00" else raw_text
  value protect_previous: template_unescaped_dollar(previous) && (starts_with(raw, "{{") || raw == "" && starts_with(following, "{{"))
  value protect_next: template_unescaped_dollar(raw) && starts_with(following, "{{")
  value {
    target: { start: interpolation.previous.end_offset - 2 - (if protect_previous then 1 else 0), end: interpolation.following.offset + 1 },
    text: (if protect_previous then "\\$" else "") (if protect_next then slice(raw, 0, -1) "\\$" else raw)
  }
}

in ts_template let template_expression_nodes expression.nodes
in ts_template_type let template_expression_nodes type.nodes
in ts_template, ts_template_type rule no-unnecessary-template-expression {
  when parent not ts_tagged_template
  let single count(template_expression_nodes) == 1 && first([] quasi.text) == "`${{" && last([] quasi.text) == "}}`"
  let comments descendants(ts_comment)
  let type_syntax is ts_template_type
  let interpolation_pairs {
    value quasi.nodes
    following_quasi: drop 1
    value quasi.nodes
    quasi_pairs: zip following_quasi
    value template_expression_nodes
    zip quasi_pairs
    map (pair) {
      expression: { value pair; first; unparenthesised_node },
      subject: { value pair; first; template_expression_subject },
      previous: { value pair; last; first },
      following: { value pair; last; last },
      string_only: {
        value pair
        first
        unparenthesised_node
        template_expression_string single type_syntax
      }
    }
    map (interpolation) {
      data: interpolation,
      fix: template_interpolation_fix(source, node, interpolation)
    }
  }
  each interpolation in interpolation_pairs
  when !any(comments, comment => comment.offset >= interpolation.data.previous.end_offset && comment.end_offset <= interpolation.data.following.offset)
  when interpolation.data.string_only || template_expression_literal(interpolation.data.subject, type_syntax) && !(re_test(interpolation.data.following.text, /^}[\r\n\u2028\u2029]/) && template_expression_whitespace(interpolation.data.subject))
  report at if interpolation.data.string_only then {start: interpolation.data.expression.offset - 2, end: interpolation.data.expression.end_offset + 1} else {start: interpolation.data.previous.end_offset - 2, end: interpolation.data.following.offset + 1}
  warn "Template literal expression is unnecessary and can be simplified."
  fix at interpolation.fix.target if interpolation.fix != null as interpolation.fix.text
}

}
