import .ts/expression-fixes

define {

in ts_node let strict_void_kind type_structure([], ["kind"]).kind
fn strict_void_allowed(kind, any) = contains(["void", "undefined", "never"], kind) || any && kind == "any"
fn strict_void_signature_allowed(signature) = all(signature.result, arm =>
  any(arm, part => contains(part.traits, "undefined")))
fn strict_void_signatures_known(signatures) = count(signatures) > 0
  && all(signatures, signature => signature.result_known
    && all(signature.result, arm => all(arm, part => !contains(part.uncertain_traits, "undefined"))))
fn strict_void_source_allowed(signatures, source, allow_any) =
  if strict_void_signatures_known(signatures)
  then all(signatures, signature => strict_void_signature_allowed(signature))
  else all(source, result => strict_void_allowed(result.kind, allow_any))
fn strict_void_only_void(returns) = count(returns ?? []) > 0 && all(returns, result => result.kind == "void")
fn strict_void_permissive(returns) = any(returns ?? [], result => result.kind == "void")
  && all(returns, result => contains(["void", "undefined", "null", "any", "never"], result.kind))
fn strict_void_transfer(contract) = {
  value expected: if contract.origin == "heritage" then contract.target else contract.contextual_returns ?? contract.target
  value contract.complete && count(contract.source) > 0
    && (if contract.origin == "argument" then strict_void_permissive(contract.target)
      || strict_void_permissive(contract.declared_target) else strict_void_only_void(expected))
}
fn strict_void_fields(n) = if n.parent is (ts_call, ts_new) then ["declared_target"] else ["declared_target", "contextual_returns"]
fn strict_void_source(n) = if n is ts_property then n.value.node ?? n.key.node else n
fn strict_void_site(n) = if n is (ts_property, ts_method) then n else n.parent.node
fn strict_void_outer(n) = {
  value n
  walk (current) if current.parent is ts_parenthesized then current.parent.node else null
  last
}
fn strict_void_head(n) = {
  value outer: strict_void_outer(n)
  value member: if n is ts_method then n else if outer.parent is (ts_property, ts_class_property) then outer.parent.node else null
  value if member == null && n is ts_arrow then n.operator.node else {
    value from: last(n.type_parameter.nodes).end_offset ?? n.name.end_offset ?? n.key.end_offset ?? n.offset
    value until: first(n.parameter.nodes).offset ?? n.return_type.offset ?? n.body.offset ?? n.end_offset
    value openings: overlapping(ts_open_paren, from, until)
    value opening: first(openings)
    value {
      start: last(member.decorator.nodes).token_neighbours.after.start ?? member.offset ?? n.offset,
      end: opening.offset ?? first(n.parameter.nodes).offset ?? n.body.offset
    }
  }
}
fn strict_void_reports(n, any) = if n not (ts_function, ts_arrow, ts_method) then [{site: n, mode: "function"}]
  else if contains(n.modifier, "*") then [{site: strict_void_head(n), mode: "function"}]
  else if contains(n.modifier, "async") then [{site: strict_void_head(n), mode: "async"}]
  else if n.body not ts_block then [{site: unparenthesised_node(n.body.node), mode: "return"}]
  else if n.return_type != null && n.return_type.text != "void" then [{site: n.return_type.node, mode: "function"}]
  else {
    value invalid: filter(n.scoping_own_returns, returned => returned.argument != null
      && !strict_void_allowed(returned.argument.strict_void_kind, any))
    value map(invalid, returned => {site: {start: returned.offset, end: returned.offset + 6}, mode: "return"})
  }
fn strict_void_static_contracts(n) = {
  value member: if n is ts_method then n else n.parent.node
  value owner: member.parent.node
  value if member is (ts_method, ts_class_property) && owner is ts_class
    && contains(member.modifier, "static") && member.static_name != null
    then {
      value fields: strict_void_fields(owner)
      value owner.node.callable_contracts(owner.parent.node, owner, [member.static_name], fields)
    } else []
}

in ts_call.argument, ts_new.argument, ts_declarator.init, ts_assignment.right, ts_property, ts_method, ts_class_property.init, ts_return.argument, ts_arrow.body, ts_array.element, ts_jsx_expression.expression rule strict-void-return {
  option allowReturnAny boolean = false "Allow callbacks returning any"
  when not (ts_spread, ts_block)
  when parent not ts_assignment || contains(["=", "&&=", "||=", "??="], parent.operator)
  when parent not ts_jsx_expression || parent.parent is ts_jsx_attribute
  when not ts_method || node.body != null
  when not ts_method || node.kind != "get" && node.kind != "set"
  when !(is ts_method && parent is ts_object && node.key.token_neighbours.before.text == "[")
  let actual strict_void_source(node)
  when actual could callable
  let signatures { value call_signatures(actual) ?? []; flat_map (arm) arm }
  let site strict_void_site(node)
  let fields strict_void_fields(actual)
  let contracts callable_contracts(site, actual, [], fields) strict_void_static_contracts(actual)
  when any(contracts, contract => strict_void_transfer(contract)
    && !strict_void_source_allowed(signatures, contract.source, allowReturnAny))
    || actual.expected could callable && actual.expected.result always void && strict_void_signatures_known(signatures)
      && !all(signatures, signature => strict_void_signature_allowed(signature))
  let unwrapped unparenthesised_node(actual)
  each report in strict_void_reports(unwrapped, allowReturnAny)
  report at report.site
  warn if report.mode == "function" then "Value-returning function used in a context where a void function is expected."
    else if report.mode == "async" then "Async function used in a context where a void function is expected."
    else "Value returned in a context where a void return is expected."
}

}
