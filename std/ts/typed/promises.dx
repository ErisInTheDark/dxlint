import .ts/constants
import .ts/values/inspection
import .ts/typed/awaitability

define {

in ts_node let promise_boolean_test
  is (ts_if.test, ts_while.test, ts_do_while.test, ts_for.test, ts_conditional.test)
  || is ts_unary.argument && node.parent.operator == "!"
  || (parent is (ts_parenthesized, ts_logical) || parent is ts_conditional && not ts_conditional.test)
    && parent.promise_boolean_test == true
in ts_node let promise_boolean_left
  is ts_logical.left && node.parent.operator != "??"
  || (parent is ts_parenthesized || is ts_logical.left && node.parent.operator != "??"
    || parent is ts_conditional && not ts_conditional.test)
    && parent.promise_boolean_left == true

in ts_parenthesized.expression, ts_logical.left, ts_logical.right, ts_conditional.test, ts_conditional.consequent, ts_conditional.alternate, ts_if.test, ts_while.test, ts_do_while.test, ts_for.test, ts_unary.argument rule es-no-misused-promises:conditionals {
  option flagUnions "none" | "strict" | "all" = "none" "Which mixed promise unions to flag"
  when not (ts_parenthesized, ts_logical, ts_conditional, ts_null, ts_boolean, ts_number, ts_bigint, ts_string)
  when !(is ts_unary && node.operator == "!")
  when parent is (ts_parenthesized, ts_logical, ts_conditional)
    || is (ts_if.test, ts_while.test, ts_do_while.test, ts_for.test)
    || is ts_unary.argument && node.parent.operator == "!"
  when promise_boolean_test || promise_boolean_left
  # Comparisons and these unary operators make primitives: never thenable.
  when !(is ts_binary && contains(["===", "!==", "==", "!=", "<", "<=", ">", ">=", "in", "instanceof"], node.operator))
  when !(is ts_unary && contains(["typeof", "void", "delete", "+", "~"], node.operator))
  when node could thenable && (flagUnions == "all" || node always thenable || flagUnions == "strict" && ts_await_union_equivalent(node) == true)
  warn "Expected non-Promise value in a boolean conditional."
}

in ts_spread rule es-no-misused-promises:spreads {
  when parent is ts_object
  when argument could thenable
  report at unparenthesised_node(argument.node)
  warn "Expected a non-Promise value to be spread in an object."
}

fn promise_return_arms(signatures) = {
  value headers: flat_map(signatures ?? [], arm => arm)
  value returns: map(headers, header => if header.result == null then null else value_constituent_traits(header.result, ["intersection", "any", "unknown", "error", "thenable", "void"]))
  value if signatures == null || count(headers) == 0 || any(returns, arms => arms == null) then null
    else flat_map(returns, arms => arms)
}
fn promise_returns_known(arms) = arms != null && all(arms, arm => all(arm, part =>
  contains(part.traits, "intersection") || !any(["any", "unknown", "error"], trait => contains(part.traits, trait))
    && !contains(part.uncertain_traits, "thenable") && !contains(part.uncertain_traits, "void")))
fn promise_returns_thenable(arms) = promise_returns_known(arms)
  && any(arms, arm => any(arm, part => contains(part.traits, "thenable")))
fn promise_returns_void(arms) = promise_returns_known(arms) && count(arms) > 0
  && any(arms, arm => any(arm, part => contains(part.traits, "void")))
  && !any(arms, arm => any(arm, part => contains(part.traits, "thenable")))
fn promise_void_context(n) = {
  value source: promise_return_arms(value_signatures(n))
  value if !promise_returns_thenable(source) then false else {
    value targets: expected_call_signatures(n)
    value headers: flat_map(targets ?? [], arm => arm)
    value target: flat_map(headers, header => header.result)
    value targets != null && count(headers) > 0
      && all(headers, header => header.result_known) && promise_returns_void(target)
  }
}
# ESLint unions every call signature and drops an argument index when any
# signature's parameter at that index accepts a thenable-returning function.
fn promise_void_overload_accepts(n) = if n.parent.node not (ts_call, ts_new) then false else {
  value call: n.parent.node
  value signatures: if call is ts_new then value_constructors(call.callee.node) else value_signatures(call.callee.node)
  value headers: flat_map(signatures ?? [], arm => arm)
  value index: index_of(call.argument.nodes, n)
  value chosen: map(headers, header => first(slice(header.parameters ?? [], index, index + 1)))
  value found: any(chosen, item => item != null && promise_returns_thenable(promise_return_arms(value_signatures(item))))
}
fn promise_dispose_void_context(n) = {
  value key: {global: "Symbol", class: "value", path: ["dispose"]}
  # A disposal contract is only asked of `using` bindings and of targets whose
  # declared type can hold one; anything else answers without a value lookup.
  value using: n is ts_declarator.init && n.parent.parent.kind == "using"
  value expected: if using then null else value_expected_handle(n)
  value if !using && expected == null then false else {
    value source: value_lookup(n, key).member
    value source != null && promise_returns_thenable(promise_return_arms(value_signatures(source)))
      && (using || {
        value target: value_lookup(expected, key).member
        value target != null && promise_returns_void(promise_return_arms(value_signatures(target)))
      })
  }
}
fn promise_property_source(n) = if n is ts_property then n.value.node ?? n else n
fn promise_property_site(n) = {
  value n: unparenthesised_node(n)
  value if n is (ts_arrow, ts_function, ts_method) then n.return_type.node ?? function_head_site(n) else n
}
in ts_node let promise_builtin_instance ts_value_builtin_type(node, ["Promise"]) == true
fn promise_finally_member(n) = n is (ts_member, ts_index)
  && (n.static_name.nonempty ?? ts_runtime_string(n.index.node)) == "finally"
  && n.object.promise_builtin_instance
in ts_call let promise_finally_callback { value callee.node; unparenthesised_node; promise_finally_member }

fn promise_async_policy(n, names) = {
  value source: if n is ts_function && n.name != null then name_binding(n.name.node).node ?? n.name.node else n
  value signatures: value_signatures(source)
  value headers: flat_map(signatures ?? [], arm => arm)
  value returns: map(headers, header => {
    value arms: if header.result == null then null else value_parts(header.result)
    value matches: map(arms ?? [], arm => {
      value parts: filter(arm.parts, part => !contains(part.traits, "intersection"))
      value named: map(parts, part => part.carrier != null
        && any(ts_value_ancestry(part).parts, base => contains(names, base.carrier.description.name)))
      value {every: count(named) > 0 && all(named, found => found), some: any(named, found => found)}
    })
    value {
      known: arms != null && all(arms, arm => all(arm.parts, part => part.carrier_known)),
      dynamic: any(arms ?? [], arm => any(arm.parts, part =>
        contains(part.traits, "any") || contains(part.traits, "unknown"))),
      every: count(matches) > 0 && all(matches, result => result.every),
      some: any(matches, result => result.some),
      mixed: count(arms) > 1 && !all(matches, result => result.every),
    }
  })
  value {
    known: signatures != null && count(returns) > 0 && all(returns, result => result.known),
    dynamic: any(returns, result => result.dynamic),
    required: all(returns, result => if n.return_type != null then result.every else result.some),
    mixed: any(returns, result => result.mixed),
  }
}

in ts_call.argument, ts_new.argument, ts_template.expression rule es-no-misused-promises:void-arguments {
  when parent not ts_call || node.index != 0 || !parent.promise_finally_callback
  when promise_void_context(node)
  when !promise_void_overload_accepts(node)
  report at unparenthesised_node(node)
  warn "Promise returned in function argument where a void return was expected."
}

in ts_call.argument rule es-no-misused-promises:predicates {
  when node.index == 0 && condition_array_callback(parent)
  when promise_returns_thenable(promise_return_arms(value_signatures(node)))
  report at unparenthesised_node(node)
  warn "Expected a non-Promise value to be returned."
}

in ts_declarator.init, ts_parameter.init, ts_assignment.right rule es-no-misused-promises:void-variables {
  # An unannotated declarator gives its initializer no expected type.
  when ((!(is ts_declarator.init) || parent.type != null) && promise_void_context(node))
    || promise_dispose_void_context(node)
  report at unparenthesised_node(node)
  warn "Promise-returning function provided to variable where a void return was expected."
}

in ts_property, ts_method, ts_class_property.init rule es-no-misused-promises:void-properties {
  when not ts_method || parent is ts_object
  when not ts_class_property.init || node.parent.type != null
  let promise_source promise_property_source(node)
  when promise_void_context(promise_source)
  report at promise_property_site(promise_source)
  warn "Promise-returning function provided to property where a void return was expected."
}

in ts_return.argument, ts_arrow.body rule es-no-misused-promises:void-returns {
  when promise_void_context(node)
  report at unparenthesised_node(node)
  warn "Promise-returning function provided to return value where a void return was expected."
}

in ts_jsx_expression.expression rule es-no-misused-promises:void-attributes {
  when parent.parent is ts_jsx_attribute
  when promise_void_context(node)
  report at parent.node
  warn "Promise-returning function provided to attribute where a void return was expected."
}

fn promise_inherited_void_targets(n) = {
  value owner: n.parent.node
  value declared: owner.implements.nodes (if owner is ts_interface then owner.extends.nodes else [])
  value constructed: if owner is ts_class && owner.extends != null then {
    value headers: value_constructors(owner.extends.node)
    value map(flat_map(headers ?? [], arm => arm), header => {heritage: owner.extends.node, value: header.result})
  } else []
  # An interface extending a constructor type (`typeof C`) is checked
  # against the instances it constructs too, as TypeScript ESLint does.
  value instances: if owner is ts_interface then flat_map(owner.extends.nodes, heritage => {
    value headers: value_constructors(heritage)
    value map(flat_map(headers ?? [], arm => arm), header => {heritage: heritage, value: header.result})
  }) else []
  value targets: map(declared, heritage => {heritage: heritage, value: heritage}) constructed instances
  value filter(targets, target => target.value != null && {
    value lookup: value_lookup(target.value, n.static_name)
    value lookup.member != null && any(lookup.alternatives, alternative => alternative.matched
      && any(alternative.sources, source => source.kind == "named"))
      && promise_returns_void(promise_return_arms(value_signatures(lookup.member)))
  })
}
in ts_method, ts_method_signature, ts_class_property, ts_property_signature rule es-no-misused-promises:void-inherited-methods {
  when !is_static
  when static_name != null && parent is (ts_class, ts_interface)
  when promise_returns_thenable(promise_return_arms(value_signatures(node)))
  each target in promise_inherited_void_targets(node) {
    report at { start: offset, end: if byte_slice(source, end_offset, end_offset + 1) == ";" then end_offset + 1 else end_offset }
    warn "Promise-returning method provided where a void return was expected by extended/implemented type '" target.heritage.text "'."
  }
}

}
