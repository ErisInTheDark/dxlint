# Private member reassignment and fixes that preserve constructor types.

define {

group readonly_write_access ts_member, ts_index
in ts_program let readonly_write_index {
  value accesses: {
    value descendants(readonly_write_access)
    filter (access) access.write_site != null
  }
  # A numeric index writes an element, never a member: only numeric member keys
  # can be targeted that way, and resolving element types is expensive.
  value numeric_keys: {
    value descendants(ts_class_property)
    filter (property) property.key is ts_number
    map (property) ts_value_key(property.key.node)
    unique
  }
  value relevant: filter(accesses, access => !(access is ts_index && access.index is ts_number
    && !contains(numeric_keys, access.readonly_write_name)))
  # A constructor write never blocks `readonly`: a readonly member may be assigned there.
  value blocking: {
    value relevant
    filter (access) !access.readonly_write_constructor
  }
  value if any(blocking, access => access.readonly_write_name == null && access.readonly_write_sources == null)
    then { unnamable: true, unknown_writes: [], writes: [] } else {
    value unknown_writes: {
      value blocking
      filter (access) access.readonly_write_sources == null
      map (access) { name: access.readonly_write_name, class: access.readonly_write_class }
    }
    value writes: {
      value relevant
      flat_map (access) {
        value access.readonly_write_sources
        map (source) source.site
        unique
        map (site) { site: site, access: access }
      }
      group_by (write) write.site
    }
    value { unnamable: false, unknown_writes: unknown_writes, writes: writes }
  }
}
in ts_member, ts_index {
  let readonly_write_key if is ts_member then ts_value_key(property.node) else index.node
  let readonly_write_name if is ts_member then ts_value_key(property.node)
    else if index is (ts_string, ts_number, ts_bigint) then ts_value_key(index.node) else null
  let readonly_write_sources {
    value lookup: value_lookup(object.node, readonly_write_key)
    value if lookup.alternatives == null then null else {
      value lookup.alternatives
      flat_map (alternative) alternative.sources
    }
  }
  let readonly_write_function {
    value walk(node, item => item.parent.node)
    find (item) item is (ts_function, ts_arrow, ts_method)
  }
  let readonly_write_constructor {
    value owner: readonly_write_function
    value owner is ts_method && owner.calls_constructor
  }
  let readonly_write_class {
    value walk(node, item => item.parent.node)
    find (item) item is ts_class
  }
}
fn readonly_writes(n) = {
  value identity: declaration_identity(n)
  value raw_key: if n is ts_parameter then n.name.node else n.key.node
  value key: if raw_key is ts_computed_key then raw_key.expression.node else raw_key
  value name: ts_value_key(key)
  value program: last(walk(n, item => item.parent.node))
  value index: program.readonly_write_index
  value class: find(walk(n, item => item.parent.node), item => item is ts_class)
  # A write whose receiver type is unknown can only target a member of the class it sits in.
  value unknown: index.unnamable || any(index.unknown_writes,
    write => write.name == name && (write.class == null || write.class == class))
  value if unknown then null else map(find(index.writes, group => group.key == identity).items ?? [], write => write.access)
}
fn readonly_constructor_write(n, access) = {
  value owner: access.readonly_write_function
  value class: find(walk(n, item => item.parent.node), item => item is ts_class)
  value owner is ts_method && owner.calls_constructor && owner.parent.node == class
    && !ts_value_static(n.modifier.nodes)
}
in ts_class_property, ts_parameter {
  let readonly_writes readonly_writes(node)
  let readonly_constructor_writes filter(readonly_writes, access => readonly_constructor_write(node, access))
  let readonly_member_writes count(readonly_writes) - count(readonly_constructor_writes)
  let readonly_constructor_indirect_writes count(filter(readonly_constructor_writes, access => access.object not ts_this))
}
fn readonly_member_key(key) =
  key is (ts_identifier, ts_private_name, ts_string, ts_number)
  || key is ts_template && count(key.expression) == 0
  || key is ts_computed_key && (key.expression is ts_number
    || key.expression is ts_member && key.expression.object == "Symbol")
fn readonly_write_value(access) = {
  value parent: access.parent.node
  value if parent is ts_assignment && parent.left.node == access then parent.right.node else null
}
fn readonly_same_value(a, b) = {
  value identity: declaration_identity(a)
  value if identity != null && identity == declaration_identity(b) then true
  else if a is (ts_number, ts_string, ts_boolean, ts_bigint) && b is (ts_number, ts_string, ts_boolean, ts_bigint)
    then a.kind == b.kind && a.text == b.text
  else false
}
fn readonly_primitive_annotation(initializer) = {
  value names: filter(["string", "number", "boolean", "bigint"], name => ts_value_has_trait(initializer, name) == true)
  value if count(names) > 0 then join(names, " | ") else null
}
fn readonly_enum_annotation(initializer) = {
  value parts: value_constituents(initializer)
  value carriers: {
    value parts
    flat_map (arm) arm
    filter (part) part.carrier_known && part.carrier.description.kind == "enum"
    map (part) part.carrier
    unique
  }
  value carrier: first(carriers)
  value scopes: if count(carriers) == 1 then name_scopes(initializer, "lexical") else null
  value rows: map(scopes, scope => {declarations: name_scope_declarations(initializer, scope.id, carrier.description.name)})
  value row: find(rows, row => row.declarations == null || count(row.declarations) > 0)
  value identity: {file: carrier.file, node: carrier.node}
  value if parts != null && scopes != null && row.declarations != null && count(row.declarations) > 0
    && all(row.declarations, declaration => declaration_identity(declaration.node) == identity)
    then carrier.description.name else null
}
fn readonly_initializer_annotation(initializer) = {
  value if ts_value_has_trait(initializer, "any") == true then "any"
  else if ts_value_has_enum(initializer) then readonly_enum_annotation(initializer)
  else readonly_primitive_annotation(initializer)
}

in ts_class_property rule prefer-readonly {
  option onlyInlineLambdas boolean = false "Limit initialised members to direct arrow functions"
  when !onlyInlineLambdas || init == null || init is ts_arrow
  when (contains([] modifier, "private") || key is ts_private_name)
    && !contains([] modifier, "readonly") && !contains([] modifier, "accessor")
    && readonly_member_key(key.node)
  when readonly_writes != null && readonly_member_writes == 0
  report at {start: style_head_offset, end: key.end_offset}
  let readonly_message_name if key is ts_computed_key then key.expression.text else key.text
  warn "Member '{readonly_message_name}' is never reassigned; mark it as `readonly`."
  let preserve_inference type.node == null && init != null && count(readonly_constructor_writes) > 0
  # A constructor write of the same value cannot widen the inferred literal type.
  let readonly_widening init != null && any(readonly_constructor_writes, write => {
    value written: readonly_write_value(write)
    value written == null || !readonly_same_value(written, init.node)
  })
  let needs_annotation preserve_inference && readonly_widening && (ts_value_has_enum(init.node) || ts_value_has_trait(init.node, "literal") == true && ts_value_has_trait(node, "literal") != true)
  let annotation if needs_annotation then readonly_initializer_annotation(init.node) else null
  let fixable readonly_constructor_indirect_writes == 0 && (!preserve_inference || !ts_value_opaque(init.node) && ts_value_has_trait(init.node, "unknown") == false && (!needs_annotation || annotation != null))
  fix at key.node if fixable as "readonly " key (if annotation != null then ": " annotation else "")
}

in ts_parameter rule prefer-readonly:parameter {
  option onlyInlineLambdas boolean = false "Limit initialised members to direct arrow functions"
  when !onlyInlineLambdas || init == null || init is ts_arrow
  when contains([] modifier, "private") && !contains([] modifier, "readonly")
  when readonly_writes != null && readonly_member_writes == 0
  report at {start: style_head_offset, end: name.end_offset}
  warn "Member '{name}' is never reassigned; mark it as `readonly`."
  fix at name.node if readonly_constructor_indirect_writes == 0 as "readonly " name
}

}
