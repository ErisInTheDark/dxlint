# Floating promise values and immediate promise elements in arrays or tuples.

define {

in ts_node let floating_promise_type type_structure([], ["kind", "parts", "aliases", "declarations", "callable"])
in ts_node let floating_thenable_type type_structure(["then"], ["kind", "parts", "aliases", "declarations", "member_types", "call_signatures", "callable"])
in ts_node let floating_promise_safe_call false
in ts_node let floating_promise_allowed_types []
in ts_node let floating_promises_checked true
fn floating_promise_safe(n, safe_calls) = {
  value expression: unparenthesised_node(n)
  value callee: unparenthesised_node(expression.callee.node)
  value expression.floating_promise_safe_call
    || expression is ts_call && callee is ts_identifier && contains(safe_calls, callee.text)
}
fn floating_promise_subject_checked(n, ignore_iife) = {
  value expression: unparenthesised_node(n)
  value callee: unparenthesised_node(expression.callee.node)
  value n.floating_promises_checked
  && (!(n.parent.node is ts_arrow) || n is ts_unary)
  && !(ignore_iife && n.parent.node is ts_expression_statement
    && expression is ts_call && callee is (ts_function, ts_arrow))
}
fn floating_rejection_handler(n) = {
  value callee: unparenthesised_node(n.callee.node)
  value position: if callee.static_name == "catch" then 0
    else if callee.static_name == "then" then 1 else -1
  value handler: if callee.static_name == "catch" then first(n.argument.nodes)
    else if callee.static_name == "then" then { value n.argument.nodes; slice 1 2; first } else null
  value checked_count: position + 1
  value preceding: slice(n.argument.nodes, 0, checked_count)
  value if handler == null || any(preceding, argument => argument is ts_spread) then "missing"
    else if handler.floating_promise_type.callable then "handled" else "useless"
}
fn floating_promise_nonnull(n) = {
  value arms: value_constituents(n)
  value arms != null && len(arms) > 0
    && all(arms, arm => any(arm, part => any(part.traits, trait =>
      contains(["boolean", "number", "string", "bigint", "symbol", "object", "truthy"], trait))))
}
fn floating_promise_logical_leaves(n) =
  if n.operator == "&&" && n.left.node could falsy && n.left.node always falsy
    || n.operator == "||" && n.left.node could truthy && n.left.node always truthy
    || n.operator == "??" && floating_promise_nonnull(n.left.node) then [n.left.node]
  else [n.left.node, n.right.node]
fn floating_promise_leaves(n, ignore_void) = {
  value unparenthesised_node(n)
  walk (current) if current is ts_parenthesized then current.expression.node
    else if current is ts_sequence then current.expression.nodes
    else if current is ts_logical then floating_promise_logical_leaves(current)
    else if current is ts_conditional then [current.consequent.node, current.alternate.node]
    else if !ignore_void && current is ts_unary && current.operator == "void" then current.argument.node
    else if current is ts_call && current.callee.node.static_name == "finally" then current.callee.node.object.node else null
  filter (part) part not (ts_parenthesized, ts_sequence, ts_logical, ts_conditional)
    && !(part is ts_call && part.callee.node.static_name == "finally")
    && !(!ignore_void && part is ts_unary && part.operator == "void")
}
fn floating_promise_named(t, safe_promises) =
  any(t.aliases, name => contains(safe_promises, name))
    || any(t.declarations, declaration => contains(safe_promises, declaration.name))
fn floating_promise_allowed(t, safe_promises) = {
  value t
  walk (part) if floating_promise_named(part, safe_promises) then [] else part.parts
  filter (part) floating_promise_named(part, safe_promises)
}
fn floating_promise_failure(n, check_thenables, ignore_void, safe_promises, safe_calls) = {
  value floating_promise_leaves(n, ignore_void)
  map (part) if part is ts_assignment || floating_promise_safe(part, safe_calls) then null else {
      value part_type: if check_thenables then part.floating_thenable_type else part.floating_promise_type
      value allowed: concat(part.floating_promise_allowed_types, floating_promise_allowed(part_type, safe_promises))
      value if floating_promise_array(part_type, check_thenables, allowed) then "array"
        else if part not ts_await
          && floating_promise_element(part_type, check_thenables, allowed)
          then if part is ts_call then {
            value handler: floating_rejection_handler(part)
            value if handler == "handled" then null else if handler == "useless" then "useless" else "promise"
          } else "promise" else null
    }
  filter (failure) failure != null
  first
}
in ts_expression_statement.expression, ts_arrow.body rule no-floating-promises {
  option checkThenables boolean = false "Check promise-like types with fulfilment and rejection callbacks"
  option ignoreVoid boolean = true "Treat the void operator as explicit promise handling"
  option ignoreIIFE boolean = false "Ignore a directly invoked function expression"
  option allowForKnownSafePromises string[] = [] "Promise type names whose rejection is handled elsewhere"
  option allowForKnownSafeCalls string[] = [] "Function names whose returned promise is handled elsewhere"
  when floating_promise_subject_checked(node, ignoreIIFE)
  when contains(["promise", "useless"], floating_promise_failure(node, checkThenables, ignoreVoid, allowForKnownSafePromises, allowForKnownSafeCalls))
  report at if parent.node is ts_expression_statement then parent.node else node
  warn (if ignoreVoid then "Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator."
    else "Promises must be awaited, end with a call to .catch, or end with a call to .then with a rejection handler.") (if floating_promise_failure(node, checkThenables, ignoreVoid, allowForKnownSafePromises, allowForKnownSafeCalls) == "useless"
      then " A rejection handler that is not a function will be ignored." else "")
}

fn floating_callable_arm(t) = {
  value t
  walk (part) if part.kind == "union" then part.parts else []
  any (part) part.kind != "union" && part.callable
}
fn floating_promise_element(t, check_thenables, allowed) = {
  value t
  walk (part) if !contains(allowed, part) && contains(["union", "intersection"], part.kind) then part.parts else []
  any (part) !contains(allowed, part) && !contains(["union", "intersection"], part.kind)
    && (any(part.declarations, declaration => declaration.name == "Promise" && declaration.from == "lib")
    || check_thenables && any(part.member_types, member => member.name == "then"
      && any(member.type.call_signatures, signature => count(signature.parameters) >= 2
        && {
          value signature.parameters
          slice 0 2
          all (parameter) floating_callable_arm(parameter)
        })))
}
fn floating_promise_array(t, check_thenables, allowed) = {
  value t
  walk (part) if !contains(allowed, part) && part.kind == "union" then part.parts else []
  any (part) !contains(allowed, part) && contains(["array", "tuple"], part.kind)
    && any(part.parts, element => floating_promise_element(element, check_thenables, allowed))
}

in ts_expression_statement.expression, ts_arrow.body rule no-floating-promises:array {
  option checkThenables boolean = false "Check promise-like types with fulfilment and rejection callbacks"
  option ignoreVoid boolean = true "Treat the void operator as explicit promise handling"
  option ignoreIIFE boolean = false "Ignore a directly invoked function expression"
  option allowForKnownSafePromises string[] = [] "Promise type names whose rejection is handled elsewhere"
  option allowForKnownSafeCalls string[] = [] "Function names whose returned promise is handled elsewhere"
  when floating_promise_subject_checked(node, ignoreIIFE)
  when floating_promise_failure(node, checkThenables, ignoreVoid, allowForKnownSafePromises, allowForKnownSafeCalls) == "array"
  report at if parent.node is ts_expression_statement then parent.node else node
  warn if ignoreVoid then "An array of Promises may be unintentional. Consider handling the promises' fulfillment or rejection with Promise.all or similar, or explicitly marking the expression as ignored with the `void` operator."
    else "An array of Promises may be unintentional. Consider handling the promises' fulfillment or rejection with Promise.all or similar."
}

}
