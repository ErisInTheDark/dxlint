# Floating promise values and immediate promise elements in arrays or tuples.

define {

in ts_node let floating_promise_type type_structure([], ["kind", "parts", "declarations", "callable"])
fn floating_rejection_handler(n) = {
  value callee: unparenthesised_node(n.callee.node)
  value handler: if callee.static_name == "catch" then first(n.argument.nodes)
    else if callee.static_name == "then" then { value n.argument.nodes; slice 1 2; first } else null
  value handler != null && handler.floating_promise_type.callable
}
fn floating_promise_leaves(n) = {
  value unparenthesised_node(n)
  walk (current) if current is ts_parenthesized then current.expression.node
    else if current is ts_sequence then current.expression.nodes
    else if current is ts_logical then [current.left.node, current.right.node]
    else if current is ts_conditional then [current.consequent.node, current.alternate.node]
    else if current is ts_call && current.callee.node.static_name == "finally" then current.callee.node.object.node else null
  filter (part) part not (ts_parenthesized, ts_sequence, ts_logical, ts_conditional)
    && !(part is ts_call && part.callee.node.static_name == "finally")
}
fn floating_unhandled_promise(n) = {
  value floating_promise_leaves(n)
  any (part) part not (ts_assignment, ts_await)
    && floating_promise_element(part.floating_promise_type)
    && !(part is ts_call && floating_rejection_handler(part))
}
in ts_expression_statement.expression rule no-floating-promises {
  when floating_unhandled_promise(node)
  warn "Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator."
}

fn floating_promise_element(t) =
  if contains(["union", "intersection"], t.kind) then any(t.parts, part => floating_promise_element(part))
  else any(t.declarations, declaration => declaration.name == "Promise" && declaration.from == "lib")
fn floating_promise_array(t) =
  if t.kind == "union" then any(t.parts, part => floating_promise_array(part))
  else contains(["array", "tuple"], t.kind) && any(t.parts, part => floating_promise_element(part))

in ts_expression_statement.expression rule no-floating-promises:array {
  when not (ts_assignment, ts_await) && !(is ts_unary && node.operator == "void")
  let floating_type type_structure([], ["kind", "parts", "declarations"])
  when floating_promise_array(floating_type)
  report at parent.node
  warn "An array of Promises may be unintentional. Consider handling the promises' fulfillment or rejection with Promise.all or similar, or explicitly marking the expression as ignored with the `void` operator."
}

}
