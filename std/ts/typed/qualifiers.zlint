define {
fn qualifier_entity(n) = n is ts_identifier
  || (n is ts_member && n.optional == null && qualifier_entity(n.object.node))
fn qualifier_identity(n) = if n is ts_member then {
  value lookup: value_lookup(n.object.node, n.property.text)
  value rows: lookup.alternatives
  value sources: if count(rows) == 1 then first(rows).sources else []
  value if lookup != null && first(rows).matched && count(sources) == 1 then first(sources).site else null
} else declaration_identity(n)
fn qualifier_local(n, key) = {
  value scopes: name_scopes(n, "lexical")
  value rows: map(scopes, scope => {
    value declarations: name_scope_declarations(n, scope.id, key)
    value { known: declarations != null, declarations: filter(declarations, declaration => contains(declaration.classes, "value")) }
  })
  value row: find(rows, row => !row.known || count(row.declarations) > 0)
  value if scopes == null || row == null || !row.known then null
    else map(row.declarations, declaration => declaration_identity(declaration.node))
}
fn qualifier_unnecessary(n) = {
  value receiver: n.object.node
  value name: n.property.node
  value identity: qualifier_identity(receiver)
  value owners: {
    value n
    walk (item) item.parent.node
    filter (item) item is (ts_namespace, ts_enum)
  }
  value active: identity != null && any(owners, owner => declaration_identity(owner.name.node) == identity)
  value accessed: qualifier_identity(n)
  value local: qualifier_local(n, name.text)
  value qualifier_entity(receiver) && n.optional == null && active && accessed != null && local != null
    && count(local) > 0 && all(local, declaration => declaration == accessed)
}
fn qualifier_outer(n) = if n.parent is ts_member && n.parent.object.node == n then n.parent.node else null
in ts_member rule no-unnecessary-qualifier {
  when qualifier_unnecessary(node)
  when !{
    value qualifier_outer(node)
    walk (item) qualifier_outer(item)
    any (item) qualifier_unnecessary(item)
  }
  let qualifier_node object.node
  let qualifier_key property.node
  let qualifier_comments {
    value descendants(ts_comment)
    filter (comment) comment.offset >= qualifier_node.offset && comment.end_offset <= qualifier_key.offset
    map (comment) comment.text (if starts_with(comment.text, "//") then "\n" else " ")
    join ""
  }
  report at qualifier_node
  fix at { start: qualifier_node.offset, end: qualifier_key.offset } as qualifier_comments
  warn "Qualifier is unnecessary since '{qualifier_key}' is in scope."
}
}
