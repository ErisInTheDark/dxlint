import .ts/constants
import .ts/values/inspection

define {

fn promise_boolean_parent(n) =
  when {
    n.parent is (ts_parenthesized, ts_logical) then n.parent
    n.parent is ts_conditional && n.parent.test.node != n then n.parent
    else then null
  }
fn promise_boolean_left_parent(n) =
  if n.parent is ts_logical && (n.parent.operator == "??" || n.parent.left.node != n) then null
  else promise_boolean_parent(n)
fn promise_boolean_use(n) = {
  value n
  walk (current) promise_boolean_parent(current)
  any (current) current.parent is (ts_if, ts_while, ts_do_while, ts_for, ts_conditional) && current.parent.test.node == current
  || current.parent is ts_unary && current.parent.operator == "!" && current.parent.argument.node == current
}
  || {
    value n
    walk (current) promise_boolean_left_parent(current)
    any (current) current.parent is ts_logical && current.parent.operator != "??" && current.parent.left.node == current
  }

in ts_node rule no-misused-promises:conditionals {
  option flagUnions "none" | "strict" | "all" = "none" "Which mixed promise unions to flag"
  when not (ts_parenthesized, ts_logical, ts_conditional)
  when !(is ts_unary && node.operator == "!")
  when promise_boolean_use(node)
  when node could thenable && (node always thenable || flagUnions == "all" || flagUnions == "strict" && type_awaitability.union_equivalent == true)
  warn "Expected non-Promise value in a boolean conditional."
}

in ts_spread rule no-misused-promises:spreads {
  when parent is ts_object
  when argument could thenable
  report at argument.node
  warn "Expected a non-Promise value to be spread in an object."
}

fn promise_void_transfer(contract) = contract.complete
  && any(contract.source, result => result.thenable)
  && any(contract.target, result => result.kind == "void")
  && !any(contract.target, result => result.thenable)
fn promise_contract_site(n) = if n is (ts_property, ts_method, ts_method_signature, ts_class_property, ts_property_signature) then n else n.parent
fn promise_property_source(n) = if n is ts_property then n.value.node ?? n.key.node else n
fn promise_property_site(n) = {
  value n: unparenthesised_node(n)
  value if n is (ts_arrow, ts_function, ts_method) then n.return_type.node ?? function_head_site(n) else n
}
in ts_node let promise_builtin_instance ts_value_builtin_type(node, ["Promise"]) == true
fn promise_finally_member(n) = n is (ts_member, ts_index)
  && (n.static_name.nonempty ?? ts_runtime_string(n.index.node)) == "finally"
  && n.object.promise_builtin_instance
in ts_call let promise_finally_callback { value callee.node; unparenthesised_node; promise_finally_member }

in ts_call.argument, ts_new.argument, ts_template.expression rule no-misused-promises:void-arguments {
  when parent not ts_call || node.index != 0 || !parent.promise_finally_callback
  each promise_contract in callable_contracts(parent, node) {
    when promise_void_transfer(promise_contract)
    report at unparenthesised_node(node)
    warn "Promise returned in function argument where a void return was expected."
  }
}

in ts_call.argument rule no-misused-promises:predicates {
  when node.index == 0 && condition_array_callback(parent)
  each promise_contract in callable_contracts(parent, node) {
    when any(promise_contract.source, result => result.thenable)
    report at unparenthesised_node(node)
    warn "Expected a non-Promise value to be returned."
  }
}

in ts_declarator.init, ts_parameter.init, ts_assignment.right rule no-misused-promises:void-variables {
  each promise_contract in callable_contracts(parent, node) callable_contracts(parent, node, ["[Symbol.dispose]"]) {
    when promise_contract.origin != "heritage"
    when promise_void_transfer(promise_contract)
    report at unparenthesised_node(node)
    warn "Promise-returning function provided to variable where a void return was expected."
  }
}

in ts_property, ts_method, ts_class_property.init rule no-misused-promises:void-properties {
  when not ts_method || parent is ts_object
  let promise_source promise_property_source(node)
  each promise_contract in { value node; promise_contract_site; callable_contracts promise_source } {
    when promise_contract.origin != "heritage"
    when promise_void_transfer(promise_contract)
    report at promise_property_site(promise_source)
    warn "Promise-returning function provided to property where a void return was expected."
  }
}

in ts_return.argument, ts_arrow.body rule no-misused-promises:void-returns {
  each promise_contract in callable_contracts(parent, node) {
    when promise_void_transfer(promise_contract)
    report at unparenthesised_node(node)
    warn "Promise-returning function provided to return value where a void return was expected."
  }
}

in ts_jsx_expression.expression rule no-misused-promises:void-attributes {
  when parent.parent is ts_jsx_attribute
  each promise_contract in callable_contracts(parent, node) {
    when promise_void_transfer(promise_contract)
    report at parent.node
    warn "Promise-returning function provided to attribute where a void return was expected."
  }
}

in ts_method, ts_method_signature, ts_class_property, ts_property_signature rule no-misused-promises:void-inherited-methods {
  when !is_static
  each promise_contract in { value node; promise_contract_site; callable_contracts node } {
    when promise_contract.origin == "heritage"
    when promise_void_transfer(promise_contract)
    report at node
    warn "Promise-returning method provided where a void return was expected by extended/implemented type '" promise_contract.heritage.text "'."
  }
}

}
