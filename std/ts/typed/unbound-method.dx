# Receiver-preserving method extraction.

define {
fn unbound_safe_use(n) = {
  value n
  walk (current) if current.parent is (ts_parenthesized, ts_non_null, ts_as, ts_type_assertion, ts_logical)
    then current.parent.node else null
  any (current) current.parent is (ts_if, ts_for, ts_member, ts_index, ts_switch, ts_update, ts_while)
    || current is (ts_call.callee, ts_conditional.test, ts_tagged_template.tag)
    || current.parent is ts_unary && contains(["!", "delete", "typeof", "void"], current.parent.operator)
    || current.parent is ts_binary && contains(["!=", "!==", "==", "===", "instanceof"], current.parent.operator)
    || current.parent is ts_assignment && current.parent.operator == "=" && (current is ts_assignment.left
      || current.object is ts_super && current.parent.left is ts_member && current.parent.left.object is ts_this)
    || current.parent is ts_logical && current.parent.operator == "&&" && current is ts_logical.left
}

fn unbound_type_only(n) = {
  value n
  walk (current) current.parent.node
  any (current) current is (ts_interface, ts_type_alias, ts_function_type, ts_method_signature, ts_call_signature)
    || current is (ts_class, ts_function, ts_variable_declaration) && contains([] current.modifier, "declare")
    || current is ts_method && contains([] current.modifier, "abstract")
}

fn unbound_source(n, path, bound) = if n == null then [] else [{node: n, path: path, bound: bound}]
fn unbound_literal_keys(n) = {
  value arms: value_constituents(n)
  value keys: flat_map(arms ?? [], arm => map(filter(arm, part =>
    part.identity_known && part.identity.kind == "value"
      && contains(["str", "num"], type_of(part.identity.value))
      && (contains(part.traits, "string") || contains(part.traits, "number"))),
    part => part.identity.value))
  value unique(keys)
}
fn unbound_pattern_sources(n) = {
  value {node: n, path: []}
  walk (current) if current.node is ts_assignment_pattern.left then {node: current.node.parent.node, path: current.path}
    else if current.node is ts_pattern_property.value then
      {node: current.node.parent.parent.node, path: [current.node.parent.static_name] current.path}
    else null
  flat_map (current) if current.node is (ts_declarator.name, ts_parameter.name) then {
    value owner: current.node.parent
    value annotated: owner.type.node ?? owner.node
    value declared: unbound_source(owner.init.node, current.path, owner is ts_declarator)
    value declared unbound_source(annotated, current.path, false)
  } else if current.node is ts_assignment.left then unbound_source(current.node.parent.right.node, current.path, true)
    else if current.node is ts_assignment_pattern.left then unbound_source(current.node.parent.right.node, current.path, false)
    else []
}

fn unbound_profiles(n, path) = {
  value subject: fold(path, n, (subject, key) => value_lookup(subject, key).member)
  value arms: value_parts(subject) ?? []
  value filter(arms, arm => any(arm.parts, part => !contains(part.traits, "parameter")
    && !(contains(part.traits, "intersection") && count(part.traits) == 1
      && part.carrier_known && part.carrier == null)))
}
fn unbound_member(arm, key) = {
  value value_lookup(arm.handle, key).alternatives ?? []
  flat_map (alternative) alternative.sources
  first
}
fn unbound_library_name(part, n, names) = part.carrier_known && part.carrier != null
  && contains(names, part.carrier.description.name)
  && declaration_origin(n, {file: part.carrier.file, node: part.carrier.node}).kind == "library"
fn unbound_builtin_type(arm, n, key) = {
  value member: unbound_member(arm, key)
  value member_library: declaration_origin(n, member.site).kind == "library"
  value key == "compare" && any(arm.parts, item => unbound_library_name(item, n, ["Collator"]))
    || member_library && contains(member.flags, "array_constructor_member")
    || member_library && any(arm.parts, item => unbound_library_name(item, n,
      ["NumberConstructor", "ObjectConstructor", "StringConstructor", "SymbolConstructor", "ArrayConstructor",
        "Array", "ProxyConstructor", "Console", "DateConstructor", "Atomics", "Math", "JSON"]))
}
fn unbound_global(n, key) = {
  value spelling: join([n.text, key.text], ".")
  value listed: n is ts_identifier && key is ts_identifier && n.declaration == null && contains([
    "Number.isFinite", "Number.isInteger", "Number.isNaN", "Number.isSafeInteger", "Number.parseFloat", "Number.parseInt",
    "Object.assign", "Object.getOwnPropertyDescriptor", "Object.getOwnPropertyDescriptors", "Object.getOwnPropertyNames",
    "Object.getOwnPropertySymbols", "Object.hasOwn", "Object.is", "Object.preventExtensions", "Object.seal", "Object.create",
    "Object.defineProperties", "Object.defineProperty", "Object.freeze", "Object.getPrototypeOf", "Object.setPrototypeOf",
    "Object.isExtensible", "Object.isFrozen", "Object.isSealed", "Object.keys", "Object.entries", "Object.fromEntries",
    "Object.values", "Object.groupBy", "String.fromCharCode", "String.fromCodePoint", "String.raw", "RegExp.escape",
    "Symbol.for", "Symbol.keyFor", "Array.isArray", "Array.from", "Array.fromAsync", "Array.of", "Proxy.revocable",
    "Date.now", "Date.parse", "Date.UTC", "Atomics.load", "Atomics.store", "Atomics.add", "Atomics.sub", "Atomics.and",
    "Atomics.or", "Atomics.xor", "Atomics.exchange", "Atomics.compareExchange", "Atomics.isLockFree", "Atomics.wait",
    "Atomics.waitAsync", "Atomics.notify", "Atomics.pause", "Reflect.defineProperty", "Reflect.deleteProperty", "Reflect.apply",
    "Reflect.construct", "Reflect.get", "Reflect.getOwnPropertyDescriptor", "Reflect.getPrototypeOf", "Reflect.has",
    "Reflect.isExtensible", "Reflect.ownKeys", "Reflect.preventExtensions", "Reflect.set", "Reflect.setPrototypeOf",
    "console.log", "console.info", "console.debug", "console.warn", "console.error", "console.dir", "console.time",
    "console.timeEnd", "console.timeLog", "console.trace", "console.assert", "console.clear", "console.count",
    "console.countReset", "console.group", "console.groupEnd", "console.table", "console.dirxml", "console.groupCollapsed",
    "console.Console", "console.profile", "console.profileEnd", "console.timeStamp", "console.context", "console.createTask",
    "Math.abs", "Math.acos", "Math.acosh", "Math.asin", "Math.asinh", "Math.atan", "Math.atanh", "Math.atan2", "Math.ceil",
    "Math.cbrt", "Math.expm1", "Math.clz32", "Math.cos", "Math.cosh", "Math.exp", "Math.floor", "Math.f16round", "Math.fround",
    "Math.hypot", "Math.imul", "Math.log", "Math.log1p", "Math.log2", "Math.log10", "Math.max", "Math.min", "Math.pow",
    "Math.random", "Math.round", "Math.sign", "Math.sin", "Math.sinh", "Math.sqrt", "Math.tan", "Math.tanh", "Math.trunc",
    "JSON.parse", "JSON.stringify", "JSON.rawJSON", "JSON.isRawJSON", "Intl.getCanonicalLocales", "Intl.supportedValuesOf",
    "Intl.DateTimeFormat", "Intl.NumberFormat", "Intl.Collator", "Intl.PluralRules", "Intl.RelativeTimeFormat", "Intl.ListFormat",
    "Intl.Locale", "Intl.DisplayNames", "Intl.Segmenter", "Intl.DurationFormat",
  ], spelling)
  value globals: if listed then global_declarations(n, n.text, "value") else []
  value identity: if listed then declaration_identity(n) else null
  value origins: map(globals ?? [], site => declaration_origin(n, site))
  value if !listed then false else if globals == null || identity == null then null
    else if !contains(globals, identity) then false
    else if any(origins, origin => contains(["library", "package"], origin.kind)) then true
    else if any(origins, origin => origin == null) then null else false
}

fn unbound_danger(arm, key, ignore_static) = {
  value declaration: unbound_member(arm, key)
  value flags: declaration.flags ?? []
  value if declaration == null || ignore_static && contains(flags, "static")
    || !contains(flags, "method") && !contains(flags, "function_initializer")
    || contains(flags, "void_receiver") then null
    else {without_this: !contains(flags, "explicit_receiver")}
}
fn unbound_warning(danger) = {
  value [
    "A method that is not declared with `this: void` may cause unintentional scoping of `this` when separated from its object.\nConsider using an arrow function or explicitly `.bind()`ing the method to avoid calling the method with an unintended `this` value. ",
    if danger.without_this then "\nIf a function does not access `this`, it can be annotated with `this: void`." else "",
  ]
  join ""
}

in ts_member, ts_index, ts_pattern_property.key, ts_property.key, ts_computed_key.expression rule es-unbound-method {
  option ignoreStatic boolean = false "Allow extracting static methods"
  let pattern_property if is ts_pattern_property.key then parent.node
    else if is ts_property.key && parent.parent is ts_assignment.left then parent.node
    else if is ts_computed_key.expression && parent.parent is ts_pattern_property then parent.parent.node else null
  let pattern pattern_property != null
  when pattern || is (ts_member, ts_index)
  when if pattern then is ts_identifier && !unbound_type_only(node) else !unbound_safe_use(node)
  when pattern || !(is ts_member) || property.node is ts_identifier
  let keys if pattern then [if parent is ts_computed_key then text else pattern_property.static_name] else if is ts_member then [static_name]
    else unbound_literal_keys(node.index.node)
  when count(keys) > 0
  let key_node if pattern then node else if is ts_member then property.node else node.index.node
  let sources if pattern then unbound_pattern_sources(pattern_property.parent.node) else unbound_source(object.node, [], true)
  let profiles {
    value sources
    map (source) {
      value {
        node: source.node,
        bound: source.bound,
        direct: count(source.path) == 0,
        profiles: unbound_profiles(source.node, source.path),
      }
    }
  }
  let danger {
    value keys
    flat_map (key) if any(profiles, source => source.bound && (source.direct && unbound_global(source.node, key_node) != false
      || count(source.profiles) > 0 && all(source.profiles, profile => unbound_builtin_type(profile, source.node, key)))) then []
      else {
        value profiles
        flat_map (source) source.profiles
        map (profile) unbound_danger(profile, key, ignoreStatic)
        filter (danger) danger != null
      }
    first
  }
  when danger != null
  warn unbound_warning(danger)
}
}
