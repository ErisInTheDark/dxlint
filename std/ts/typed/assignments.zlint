import .ts/values/inspection

define {

fn assignment_carrier(parts) = {
  value arm: first(parts)
  value carriers: filter(arm, part => part.carrier_known && part.carrier != null)
  value carrier: first(carriers).carrier
  value if parts != null && len(parts) == 1 && len(carriers) > 0
    && all(carriers, part => part.carrier.description == carrier.description && part.carrier.arguments == carrier.arguments)
    && all(carriers, part => part.product_known && part.product == first(carriers).product)
    then carrier else null
}
fn assignment_array(parts, source) = {
  value shape: ts_value_array_parts(parts, source)
  value shape.known && shape.array
}
fn assignment_unsafe(sender, receiver, n) = {
  value {sender: sender, receiver: receiver}
  walk (pair) if ts_value_trait(pair.sender, "any") || pair.sender == null || pair.receiver == null
    || len(pair.sender) != 1 || len(pair.receiver) != 1 then [] else {
      value first(pair.sender)
      flat_map (source) {
        value first(pair.receiver)
        flat_map (target) {
          value assignment_carrier_arguments(source, target, n)
          map (arguments) {sender: first(arguments), receiver: last(arguments)}
        }
      }
    }
  any (pair) ts_value_trait(pair.sender, "any") && pair.receiver != null && len(pair.receiver) > 0
    && !ts_value_trait(pair.receiver, "any") && !ts_value_trait(pair.receiver, "unknown")
}
fn assignment_carrier_arguments(source, target, n) = {
  value a: source.carrier
  value b: target.carrier
  value tuples: a.description.kind == "tuple" && b.description.kind == "tuple"
    && source.product_known && target.product_known && source.product != null
    && source.product == target.product
  value source_readonly: if a.description.kind == "array" then source.product.readonly == true
    else a.description.name == "ReadonlyArray"
  value target_readonly: if b.description.kind == "array" then target.product.readonly == true
    else b.description.name == "ReadonlyArray"
  value arrays: ts_value_array_part(source, n).array && ts_value_array_part(target, n).array
    && source_readonly == target_readonly
  value same: arrays || tuples || a.description.kind == "named" && b.description.kind == "named"
    && a.file == b.file && a.node == b.node
  value arguments: zip(a.arguments ?? [], b.arguments ?? [])
  value if source.carrier_known && target.carrier_known && a != null && b != null
    && same && len(a.arguments) == len(b.arguments) then arguments else []
}
fn assignment_finding(site, mode, parts, receiver) = {
  site: site, mode: mode, error: ts_value_category(parts) == "error",
  sender: if mode == "generic" then ts_value_print(parts) else "any",
  receiver: if mode == "generic" then ts_value_print(receiver) else null
}
fn assignment_destructure_step(entry, source) = {
  value receiver: entry.receiver
  value sender: value_at(source, entry.path)
  value if entry.mode != null && ts_value_category(sender) != null then
    {finding: assignment_finding(receiver, entry.mode, sender, null), children: []}
  else {
    value carrier: assignment_carrier(sender)
    value array: assignment_array(sender, source)
    value element: first(carrier.arguments)
    value if receiver is (ts_array, ts_array_pattern) then
      if array && ts_value_trait(element, "any") then
        {finding: assignment_finding(receiver, "array", element, null), children: []}
      else if carrier.description.kind == "tuple" then {
        value items: receiver.element.nodes
        value selected: filter(items, item => item not (ts_hole, ts_rest))
        value {finding: null, children: map(selected, item => {
          value position: index_of(items, item)
          value {receiver: item, path: [] entry.path position, mode: "tuple"}
        })}
      } else {finding: null, children: []}
    else if receiver is (ts_object, ts_object_pattern) && ts_value_category(sender) == null
        && !ts_value_trait(sender, "unknown") then {
      value properties: filter(receiver.property.nodes, property => property not ts_rest && ts_value_key(property.key.node) != null)
      value {finding: null, children: map(properties, property => {
        value key: ts_value_key(property.key.node)
        value target: property.value.node ?? property.key.node
        value {receiver: target, path: [] entry.path key, mode: "object"}
      })}
    } else {finding: null, children: []}
  }
}
fn assignment_destructure(receiver, source, path) = {
  value {receiver: receiver, path: path, mode: null}
  walk (entry) assignment_destructure_step(entry, source).children
  map (entry) assignment_destructure_step(entry, source).finding
  filter (finding) finding != null
  sort_by (finding) finding.site.offset
}
fn assignment_empty_map(source) = {
  value bare: unparenthesised_node(source)
  value bare is ts_new && bare.callee is ts_identifier && bare.callee.text == "Map"
    && count(bare.argument.nodes) == 0 && count(bare.type_argument.nodes) == 0
}
fn assignment_receiver(n) = if n is (ts_declarator, ts_parameter) then n.name.node
  else if n is (ts_class_property, ts_property) then n.key.node
  else if n is (ts_assignment, ts_assignment_pattern) then n.left.node
  else if n is ts_jsx_attribute then n.name.node else null
fn assignment_sender(n) = if n is (ts_declarator, ts_parameter, ts_class_property) then n.init.node
  else if n is (ts_assignment, ts_assignment_pattern) then n.right.node
  else if n is ts_property then n.value.node ?? n.key.node
  else if n is ts_jsx_attribute && n.value is ts_jsx_expression then n.value.expression.node else null
fn assignment_transfers_value(n) = {
  value source: assignment_sender(n)
  value target: assignment_receiver(n)
  value compare: n not (ts_declarator, ts_parameter, ts_class_property) || n.type != null
  value report: if n is ts_parameter then { start: target.offset, end: source.end_offset }
    else if n is ts_jsx_attribute then source else n
  value sender: if source != null then value_constituents(source) else null
  value receiver: if n.type != null then value_constituents(n.type.node)
    else if n is ts_property then {
      value key: ts_value_key(n.key.node)
      value path: [key]
      value value_expected_at(n.parent.node, path) ?? value_constituents(target)
    } else if target != null then value_constituents(target) else null
  value category: ts_value_category(sender)
  value known_unknown: ts_value_trait(receiver, "unknown")
    && (n.type != null || target not (ts_array, ts_array_pattern, ts_object, ts_object_pattern))
  value if source == null || target == null || n is ts_assignment && n.operator != "="
    || n is ts_property && (n.parent.flow_destructuring_target || source is ts_assignment_pattern) then []
    else if category != null && !known_unknown then [assignment_finding(report, "any", sender, null)]
    else if compare && !assignment_empty_map(source) && assignment_unsafe(sender, receiver, n)
      then [assignment_finding(report, "generic", sender, receiver)]
    else assignment_destructure(target, source, [])
}
fn assignment_spread(n) = {
  value source: n.argument.node
  value sender: value_constituents(source)
  value carrier: assignment_carrier(sender)
  value element: first(carrier.arguments)
  value if n.parent is ts_array && (ts_value_category(sender) != null
    || assignment_array(sender, source) && ts_value_trait(element, "any"))
    then [assignment_finding(n, "spread", sender, null)] else []
}

in ts_declarator, ts_parameter, ts_class_property, ts_assignment, ts_assignment_pattern, ts_property, ts_jsx_attribute {
  let assignment_value_transfers assignment_transfers_value(node)
}
in ts_spread { let assignment_value_transfers assignment_spread(node) }

}
