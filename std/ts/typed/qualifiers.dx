define {
fn qualifier_receiver(n) = if n is ts_qualified_name then n.left.node else n.object.node
fn qualifier_key(n) = if n is ts_qualified_name then n.right.node else n.property.node
fn qualifier_entity(n) = {
  value terminal: {
    value n
    walk (current) if current is (ts_member, ts_qualified_name) && current.optional == null
      then qualifier_receiver(current) else null
    last
  }
  value terminal is ts_identifier
}
fn qualifier_owner_path(n, names, index) = {
  value name: { value names; drop index; first }
  value if index == 0 then {
    value identity: declaration_identity(name)
    value identity != null && qualifier_identity(n) == identity
  } else n is (ts_member, ts_qualified_name)
    && qualifier_key(n).identifier_name == name.identifier_name
    && qualifier_owner_path(qualifier_receiver(n), names, index - 1)
}
fn qualifier_module_import(n, owner) = {
  value declaration: qualifier_receiver(n).scope_declaration
  value imports: {
    value declaration
    walk (item) item.parent.node
    filter (item) item is ts_import
  }
  value own: first(imports)
  value source: own.from.node
  value matches: own != null && own.namespace.node == declaration && source is ts_string && owner is ts_namespace && owner.name is ts_string && source.literal_value.value == owner.name.literal_value.value
  value matches
}
fn qualifier_ambient_module(n, owner) = owner is ts_namespace && owner.name is ts_string && ts_module_program(owner).ts_module_external_file && qualifier_module_import(n, owner)
fn qualifier_ambient_owner(owner) = owner is ts_namespace && owner.name is ts_string && ts_module_program(owner).ts_module_external_file
fn qualifier_owner(n) = {
  value owners: {
    value n
    walk (item) item.parent.node
    filter (item) item is (ts_namespace, ts_enum)
  }
  value find(owners, owner => {
    value names: if owner is ts_namespace then ts_module_names(owner) else [owner.name.node]
    value count(names) > 0 && qualifier_owner_path(qualifier_receiver(n), names, count(names) - 1) || qualifier_ambient_module(n, owner)
  })
}
fn qualifier_owned_identity(n) = {
  value owner: qualifier_owner(n)
  value scopes: if owner == null then [] else name_scopes(owner.body.node ?? owner, "lexical")
  value declarations: {
    value scopes
    filter (scope) scope.owner == owner || scope.owner == owner.body.node
    flat_map (scope) name_scope_declarations(n, scope.id, qualifier_key(n).text)
  }
  value identities: map(declarations, declaration => declaration_identity(declaration.node))
  value if count(identities) > 0 && all(identities, identity => identity == first(identities))
    then first(identities) else null
}
fn qualifier_identity(n) = if n is (ts_member, ts_qualified_name) then {
  value lookup: value_lookup(qualifier_receiver(n), qualifier_key(n).text)
  value rows: lookup.alternatives
  value sources: if count(rows) == 1 then first(rows).sources else []
  value if lookup != null && first(rows).matched && count(sources) == 1 then first(sources).site
    else qualifier_owned_identity(n)
} else declaration_identity(n)
fn qualifier_local(n, key) = {
  value scopes: name_scopes(n, "lexical")
  value rows: map(scopes, scope => {
    value declarations: name_scope_declarations(n, scope.id, key)
    value { known: declarations != null, declarations: filter(declarations, declaration =>
      if n is ts_qualified_name then contains(declaration.classes, "type")
      else contains(declaration.classes, "value") || contains(scope.classes, "statics") && contains(declaration.classes, "member")) }
  })
  value row: find(rows, row => !row.known || count(row.declarations) > 0)
  value if scopes == null || row == null || !row.known then null
    else map(row.declarations, declaration => declaration_identity(declaration.node))
}
fn qualifier_unnecessary(n) = {
  value receiver: qualifier_receiver(n)
  value owner: qualifier_owner(n)
  value if !qualifier_entity(receiver) || n.optional != null || owner == null then false else {
    value accessed: qualifier_identity(n)
    value local: qualifier_local(n, qualifier_key(n).text)
    value matches: if local == null then qualifier_ambient_owner(owner) else count(local) > 0 && all(local, declaration => declaration == accessed)
    value accessed != null && matches
  }
}
fn qualifier_outer(n) = if n.parent is (ts_member, ts_qualified_name) && qualifier_receiver(n.parent.node) == n then n.parent.node else null
in ts_member, ts_qualified_name rule no-unnecessary-qualifier {
  when qualifier_unnecessary(node)
  when !{
    value qualifier_outer(node)
    walk (item) qualifier_outer(item)
    any (item) qualifier_unnecessary(item)
  }
  let qualifier_node qualifier_receiver(node)
  let qualifier_key qualifier_key(node)
  let qualifier_comments {
    value descendants(ts_comment)
    filter (comment) comment.offset >= qualifier_node.offset && comment.end_offset <= qualifier_key.offset
    map (comment) comment.text (if starts_with(comment.text, "//") then "\n" else " ")
    join ""
  }
  report at qualifier_node
  fix at { start: qualifier_node.offset, end: qualifier_key.offset } as qualifier_comments
  warn "Qualifier is unnecessary since '{qualifier_key}' is in scope."
}
}
