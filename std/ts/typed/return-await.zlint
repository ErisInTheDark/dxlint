# Returned-await policy and source-preserving fixes.
import .ts/expression-fixes

define {

fn return_await_leaves(n) = {
  value unparenthesised_node(n)
  walk (current) {
    value branch: unparenthesised_node(current)
    value if branch is ts_conditional then [branch.consequent.node, branch.alternate.node] else null
  }
  map (current) unparenthesised_node(current)
  filter (current) current not ts_conditional
}
fn return_await_scope(n) = {
  value n
  walk (current) current.parent.node
  find (current) current is (ts_block, ts_program, ts_function, ts_arrow, ts_method, ts_for, ts_for_in, ts_for_of, ts_switch)
}
fn return_await_handling(n, owner, resources) = {
  value ancestors: walk(n, current => if current == owner then null else current.parent.node)
  value any(ancestors, child => child.parent is ts_try
    && (child is ts_try.block || child is ts_try.handler && child.parent.finalizer != null))
    || any(resources, resource => {
      value scope: return_await_scope(resource)
      value resource.end_offset < n.offset && contains(ancestors, scope)
    })
}
fn return_await_certainty(n) = {
  value parts: value_constituents(n)
  value complete: parts != null && len(parts) > 0
    && all(parts, arm => len(arm) > 0 && all(arm, part => !contains(part.uncertain_traits, "thenable")
      && !contains(part.traits, "any") && !contains(part.traits, "unknown")))
  value if complete && n could thenable then "always" else if ts_value_nonthenable(n) == true then "never" else "may"
}
fn return_await_result(n, owner, resources) = {
  value awaited: n is ts_await
  value argument: if awaited then n.argument.node else n
  value {
    expression: n,
    awaited: awaited,
    certainty: return_await_certainty(argument),
    handling: return_await_handling(n, owner, resources),
  }
}
in ts_declarator let return_await_resource parent is ts_variable_declaration && re_test(parent.kind, /(?:^|\s)using$/)

fn return_await_remove(source, n) = {
  value argument: n.argument.node
  value operand: unparenthesised_node(argument)
  value prefix: { value byte_slice(source, n.offset, argument.offset); re_replace /^await[\s\u{FEFF}]*/ "" }
  value parens: if argument is ts_parenthesized || n.parent is ts_return then 0 else expression_fix_parens(source, n, operand)
  value if parens == null then null else {
    # Return must see an opening paren before a retained multiline comment.
    value replacement: if n.parent is ts_return && re_test(prefix, /[\r\n\u{2028}\u{2029}]/) then "(" prefix argument.text ")"
      else prefix expression_fix_wrap(argument.text, parens > 0)
    value expression_fix_edges(n, replacement)
  }
}
fn return_await_add(n) = {
  value parens: n.precedence < 15 || n is structure_assertion
  value replacement: "await " expression_fix_wrap(n.text, parens)
  value expression_fix_edges(n, replacement)
}
fn return_await_selected(result, mode) = result.certainty == "never" && result.awaited || result.certainty == "always"
  && (if mode == "always" || mode != "never" && result.handling then !result.awaited else if mode == "error-handling-correctness-only" then false else result.awaited)

in ts_function, ts_arrow, ts_method rule return-await {
  option mode ("always" | "error-handling-correctness-only" | "in-try-catch" | "never") = "in-try-catch" "Await policy for returned promises"
  when contains([] modifier, "async") && body != null
  let owner node
  let resources {
    value body.node
    value descendants(ts_declarator)
    filter (declaration) declaration.return_await_resource == true
  }
  let expressions if body is ts_block then {
    value flow_declared_effects(body.node, "returned")
    filter (effect) effect.site is ts_return && effect.value != null
    map (effect) effect.site.argument.node
  } else [body.node]
  let results {
    value expressions
    flat_map (expression) return_await_leaves(expression)
    map (expression) return_await_result(expression, owner, resources)
    filter (result) return_await_selected(result, mode)
    map (result) {
      data: result,
      # Promise awaits change rejection handling; keep those reports manual.
      replacement: if result.certainty == "always" && result.handling then null
        else if result.awaited then return_await_remove(source, result.expression) else return_await_add(result.expression)
    }
  }
  each result in results
  report at result.data.expression
  warn if result.data.certainty == "never" then "Returning an awaited value that is not a promise is not allowed." else if result.data.awaited then "Returning an awaited promise is not allowed in this context." else "Returning an awaited promise is required in this context."
  fix at result.data.expression if result.replacement != null as result.replacement
}

}
