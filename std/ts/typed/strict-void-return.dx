import .ts/expression-fixes

define {

fn strict_void_unsafe_parts(parts, allow_any) = parts != null && !all(parts, arm =>
  count(arm) == 0 || any(arm, part => contains(part.traits, "void")
    || contains(part.traits, "undefined") || contains(part.traits, "never")
    || allow_any && contains(part.traits, "any")))
fn strict_void_signature_allowed(signature, allow_any) = all(signature.result, arm =>
  any(arm, part => contains(part.traits, "undefined") || allow_any && contains(part.traits, "any")))
fn strict_void_signatures_known(signatures) = count(signatures) > 0
  && all(signatures, signature => signature.result_known)
fn strict_void_source_allowed(signatures, allow_any) = strict_void_signatures_known(signatures)
  && all(signatures, signature => strict_void_signature_allowed(signature, allow_any))
fn strict_void_handle_result(handle) = {
  value parts: value_trait_parts(handle, ["void", "undefined", "any", "null", "parameter"])
  value if parts == null then null else map(parts, arm => arm.parts)
}
fn strict_void_signature(header) = {
  value result: strict_void_handle_result(header.result)
  value {result: result, result_known: result != null}
}
fn strict_void_expected_transfer(signatures, argument) =
  if argument then any(signatures, signature => any(signature.result, arm =>
    any(arm, part => contains(part.traits, "void"))))
    && all(signatures, signature => all(signature.result, arm => any(arm, part =>
      any(["void", "undefined", "null", "any"], trait => contains(part.traits, trait)))))
  else count(signatures) > 0 && all(signatures, signature => count(signature.result) > 0
    && all(signature.result, arm => any(arm, part => contains(part.traits, "void"))))
fn strict_void_argument_transfer(n) = {
  value outer: outer_parenthesised_node(n)
  value call: outer.parent.node
  value if call not (ts_call, ts_new) then null else {
    value alternatives: if call is ts_new then value_constructors(call.callee.node) else value_signatures(call.callee.node)
    value headers: flat_map(alternatives ?? [], arm => arm)
    value index: index_of(call.argument.nodes, outer)
    value groups: map(headers, header => {
      value parameter: first(slice(header.parameters, index, index + 1))
      value callbacks: if parameter == null then [] else value_signatures(parameter)
      value if callbacks == null then null else map(callbacks, arm => map(arm, callback => {
        value result: strict_void_handle_result(callback.result)
        value {result: result, result_known: result != null}
      }))
    })
    value signatures: { value groups; flat_map (group) group ?? []; flat_map (arm) arm }
    value known: alternatives != null && count(headers) > 0 && count(signatures) > 0 && index != null
      && all(groups, group => group != null) && all(signatures, signature => signature.result_known)
    value contextual: { value expected_call_signatures(n) ?? []; flat_map (arm) arm }
    value use_context: count(headers) == 1 || all(signatures, signature => all(signature.result, arm =>
      any(arm, part => any(["void", "undefined", "null", "any", "parameter"], trait => contains(part.traits, trait)))))
    value if !known then null else use_context && strict_void_expected_transfer(contextual, true)
      || strict_void_expected_transfer(signatures, true)
  }
}
fn strict_void_source(n) = if n is ts_property then n.value.node ?? n.key.node else n
fn strict_void_reports(n, allow_any) = when {
  n not (ts_function, ts_arrow, ts_method) then [{site: n, mode: "function"}]
  contains(n.modifier, "*") then [{site: function_head_site(n), mode: "function"}]
  contains(n.modifier, "async") then [{site: function_head_site(n), mode: "async"}]
  n.body not ts_block then {
    value body: unparenthesised_node(n.body.node)
    value eager: value_constituent_traits(body, ["void", "undefined", "any", "null", "parameter"])
    value parts: if eager != null then eager else {
      value arms: value_trait_parts(body, ["void", "undefined", "any", "null", "parameter"])
      value if arms == null then null else map(arms, arm => arm.parts)
    }
    value if strict_void_unsafe_parts(parts, allow_any) then [{site: body, mode: "return"}] else []
  }
  n.return_type != null && n.return_type.text != "void" then [{site: n.return_type.node, mode: "function"}]
  else then {
    value invalid: filter(n.scoping_own_returns, returned => {
      value eager: value_constituent_traits(returned.argument, ["void", "undefined", "any", "null", "parameter"])
      value parts: if eager != null then eager else {
        value arms: value_trait_parts(returned.argument, ["void", "undefined", "any", "null", "parameter"])
        value if arms == null then null else map(arms, arm => arm.parts)
      }
      value returned.argument != null && strict_void_unsafe_parts(parts, allow_any)
    })
    value map(invalid, returned => {site: {start: returned.offset, end: returned.offset + 6}, mode: "return"})
  }
}

in ts_call.argument, ts_new.argument, ts_declarator.init, ts_assignment.right, ts_property, ts_method, ts_class_property.init, ts_return.argument, ts_arrow.body, ts_array.element, ts_jsx_expression.expression rule strict-void-return {
  option allowReturnAny boolean = false "Allow callbacks returning any"
  when not (ts_spread, ts_block)
  when not ts_property || node.value not ts_assignment_pattern
  when parent not ts_assignment || contains(["=", "&&=", "||=", "??="], parent.operator)
  when parent not ts_jsx_expression || parent.parent is ts_jsx_attribute
  when not ts_method || node.body != null
  when !(is ts_method && parent is ts_object && node.key.token_neighbours.before.text == "[")
  let actual strict_void_source(node)
  when actual could callable
  let unwrapped unparenthesised_node(actual)
  let signatures {
    value value_signatures(actual) ?? []
    flat_map (arm) arm
    map (header) strict_void_signature(header)
  }
  let expected expected_call_signatures(actual)
  let expected_signatures { value expected ?? []; flat_map (arm) arm }
  let expected_known expected != null && all(expected_signatures, signature => signature.result_known)
  let argument_transfer strict_void_argument_transfer(actual)
  when strict_void_signatures_known(signatures) || unwrapped is (ts_function, ts_arrow, ts_method)
    && (contains([] unwrapped.modifier, "async") || contains([] unwrapped.modifier, "*") || unwrapped.return_type == null)
  when if argument_transfer != null
    then argument_transfer
      && !strict_void_source_allowed(signatures, allowReturnAny)
    else expected_known
      && strict_void_expected_transfer(expected_signatures, outer_parenthesised_node(actual).parent is (ts_call, ts_new))
      && !strict_void_source_allowed(signatures, allowReturnAny)
  each report in strict_void_reports(unwrapped, allowReturnAny) {
    report at report.site
    warn when {
      report.mode == "function" then "Value-returning function used in a context where a void function is expected."
      report.mode == "async" then "Async function used in a context where a void function is expected."
      else then "Value returned in a context where a void return is expected."
    }
  }
}

}
