import .ts/values/inspection
import .ts/typed/assignments
import .ts/typed/awaitability

define {

fn argument_value_finding(site, mode, sender, receiver, display) = {
  site: {start: site.offset, end: site.end_offset}, mode: mode, error: ts_value_category(sender) == "error",
  sender: ts_value_print(display ?? sender), receiver: ts_value_print(receiver)
}
# An unsafe transfer needs an `any` somewhere the walk can reach: its own parts,
# or the arguments of their carriers (the only children the walk descends into).
fn assignment_may_be_unsafe(parts) = parts != null && any(parts, arm => any(arm, part =>
  contains(part.traits, "any")
  || part.carrier_known && part.carrier != null && count(part.carrier.arguments ?? []) > 0))
# The lone signature a call with spread arguments relates to, and whether its
# last parameter is a rest parameter.
fn argument_header(call) = {
  value arms: if call is ts_new then value_constructors(call.callee.node) else value_signatures(call.callee.node)
  value header: if arms != null && count(arms) == 1 && count(first(arms)) == 1 then first(first(arms)) else null
  value parameters: if header != null then site_field(call, header.site, "parameter") ?? [] else []
  value names: if count(parameters) > 0 then site_field(call, last(parameters), "name") ?? [] else []
  value if header == null || header.parameters == null then null
    else {parameters: header.parameters, rest: count(names) == 1 && first(names).kind == "ts_rest"}
}
# The parameter an argument at `position` meets (a rest parameter's element past the others).
fn argument_parameter_at(header, position) = {
  value fixed: if header.rest then count(header.parameters) - 1 else count(header.parameters)
  value if position < fixed then get(header.parameters, position)
    else if header.rest then value_lookup(last(header.parameters), position - fixed).member else null
}
# A spread tuple's element handles (`f(...pair)` passes each); null for anything else.
fn argument_tuple_elements(source) = {
  value arms: value_parts(source)
  value part: if arms != null && count(arms) == 1 && count(first(arms).parts) == 1 then first(first(arms).parts) else null
  value tuple: part != null && part.product_known && part.product != null && part.carrier.description.kind == "tuple"
    && !any(part.product.elements, element => element.values || element.optional)
  value if tuple then map(part.product.elements, (element, index) => value_lookup(part.handle, index).member) else null
}
fn argument_tuple_findings(argument, header, elements, position) = filter(map(elements, (element, index) => {
  value sender: value_constituents(element)
  value parameter: argument_parameter_at(header, position + index)
  value receiver: if parameter != null then value_constituents(parameter) else null
  value if parameter != null && ts_value_category(sender) != null && receiver != null
    && !ts_value_trait(receiver, "unknown") && !ts_value_trait(receiver, "any")
    then argument_value_finding(argument, "tuple", sender, receiver, null) else null
}), finding => finding != null)
# Arguments in order: a spread tuple passes its elements to the next parameters
# (TypeScript ESLint), so later arguments meet the parameters after them.
fn argument_value_findings(call) = if call not (ts_call, ts_new, ts_tagged_template) then [] else {
  value arguments: if call is ts_tagged_template then call.quasi.expression.nodes else call.argument.nodes
  value header: if any(arguments, argument => argument is ts_spread) then argument_header(call) else null
  value walked: fold(arguments, {position: 0, shifted: false, lost: false, findings: []}, (state, argument) => {
    value spread: argument is ts_spread
    value source: if spread then argument.argument.node else argument
    value sender: value_constituents(source)
    value tuple: if spread && header != null && !state.lost && ts_value_category(sender) == null
      then argument_tuple_elements(source) else null
    value parameter: if !spread && state.shifted && !state.lost && header != null && assignment_may_be_unsafe(sender)
      then argument_parameter_at(header, state.position) else null
    value expected: if spread || parameter != null || !assignment_may_be_unsafe(sender) then null else value_expected(argument)
    value receiver: if parameter != null then value_constituents(parameter) else expected.value
    value carrier: assignment_carrier(sender)
    value element: first(carrier.arguments)
    value found: when {
      spread && ts_value_category(sender) != null then
        [argument_value_finding(argument, "spread", sender, null, null)]
      tuple != null then argument_tuple_findings(argument, header, tuple, state.position)
      spread && assignment_array(sender, source) && ts_value_category(element) != null then
        [argument_value_finding(argument, "array", element, null, sender)]
      !spread && (expected.present == true || parameter != null) && receiver != null
        && !assignment_empty_map(source) && assignment_unsafe(sender, receiver, call) then
        [argument_value_finding(argument, "argument", sender, receiver, null)]
      else then []
    }
    value {
      position: state.position + (if tuple != null then count(tuple) else 1),
      shifted: state.shifted || tuple != null,
      lost: state.lost || spread && tuple == null,
      findings: concat(state.findings, found),
    }
  })
  value walked.findings
}
fn return_value_owner(n) = {
  value n.parent.node
  walk (current) current.parent.node
  find (current) current is (ts_function, ts_arrow, ts_method)
}
fn return_value_finding(n) = {
  value source: if n is ts_return then n.argument.node
    else if n.parent is ts_arrow && n is ts_arrow.body && n not ts_block then n else null
  value owner: if source != null then return_value_owner(n) else null
  value sender: if source != null then value_constituents(source) else null
  value expected: if source != null then value_expected(source) else null
  value receiver: if owner.return_type != null then value_constituents(owner.return_type.node) else expected.value
  value known: owner != null && (owner.return_type != null && receiver != null
    || expected != null && (!expected.present || receiver != null))
  value carrier: assignment_carrier(sender)
  value target_carrier: assignment_carrier(receiver)
  value element: first(carrier.arguments)
  value target_element: first(target_carrier.arguments)
  value asynchronous: contains([] owner.modifier, "async")
  value promise: source != null && source could thenable && ts_value_category(sender) == null
    && !assignment_array(sender, source)
  value awaited_handle: if promise then ts_awaited_value(source, source) else null
  value awaited: if awaited_handle != null then value_constituents(awaited_handle) else null
  value async_target: asynchronous && owner.return_type != null && owner.return_type.node could thenable
  value target_handle: if promise && owner.return_type == null && expected.present == true
    then value_expected_handle(source) else null
  value target_awaited_handle: if !promise && !async_target || receiver == null then null
    else if owner.return_type != null then ts_awaited_value(owner.return_type.node, owner.return_type.node)
    else if target_handle != null then ts_awaited_value(target_handle, target_handle) else null
  value target_awaited: if target_awaited_handle != null then value_constituents(target_awaited_handle) else null
  value mode: when {
    ts_value_category(sender) != null then "value"
    assignment_array(sender, source) && ts_value_trait(element, "any") then "array"
    ts_value_trait(awaited, "any") then "promise"
    else then "generic"
  }
  value allowed: ts_value_trait(receiver, "unknown") || owner.return_type != null
    && ts_value_trait(receiver, "any")
    || async_target && (ts_value_trait(target_awaited, "any") || ts_value_trait(target_awaited, "unknown"))
    || mode == "promise" && (ts_value_trait(target_awaited, "unknown")
      || owner.return_type != null && ts_value_trait(target_awaited, "any"))
    || mode == "array" && assignment_array(receiver, source)
      && (ts_value_trait(target_element, "unknown") || owner.return_type != null && ts_value_trait(target_element, "any"))
  value if !known || sender == null || allowed || source == null
    || async_target && target_awaited == null
    || promise && (awaited == null || receiver != null && target_awaited == null)
    || mode == "promise" && !asynchronous then null
    else if mode != "generic" then assignment_finding(n, mode, sender, receiver, assignment_this_any(source, n))
    else if !assignment_empty_map(source) && assignment_unsafe(sender, receiver, source)
      then assignment_finding(n, mode, sender, receiver, false) else null
}
in ts_call, ts_new, ts_tagged_template { let argument_value_transfers argument_value_findings(node) }
in ts_node { let return_value_transfer return_value_finding(node) }

fn typed_accessor_key(method) = ts_value_key(method.key.node) ?? join(token_list(method.key.node), "")
fn typed_accessor_type_mismatch(annotation) = {
  value getter: annotation.parent.node
  value owner: getter.parent.node
  value key: typed_accessor_key(getter)
  value setter: if getter is (ts_method, ts_method_signature) && getter.kind == "get"
    && owner is (ts_class, ts_interface, ts_type_literal)
    then find_last(owner.member.nodes, member => member.kind == "set" && typed_accessor_key(member) == key)
    else null
  value parameter: first(setter.parameter.nodes)
  value setter != null && count(setter.parameter.nodes) == 1 && parameter.type != null
    && value_accepts(parameter.type.node, annotation, "value", "value") == false
}

}
