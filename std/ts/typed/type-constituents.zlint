# Type identity selects redundant components; source tokens own removal.

define {

group duplicate_type_constituent ts_union, ts_intersection
in duplicate_type_constituent let duplicate_type_constituents_checked true
fn constituent_arm_key(arm) = {
  value part: if count(arm.parts) == 1 then first(arm.parts) else null
  value scalar: find(["void", "null", "undefined", "string", "number", "boolean", "bigint"],
    trait => contains(part.traits, trait))
  value if part != null && scalar != null && part.identity_known && part.identity.kind == "value"
    then {scalar: scalar, identity: part.identity} else arm.handle
}
fn constituent_explicit_undefined(arms) = {
  value part: if count(arms) == 1 && count(first(arms).parts) == 1 then first(first(arms).parts) else null
  value part != null && part.identity_known && part.identity.kind == "value"
    && part.identity.value.type == "undefined" && contains(part.traits, "undefined")
    && !contains(part.traits, "void") && part.carrier.description.kind != "parameter"
}
fn constituent_collect(n, group, union, entries) = {
  value bare: { value n; walk (item) if item is ts_parenthesized_type then item.type.node else null; last }
  value arms: value_parts(bare)
  value keys: if arms == null then null else unique(map(arms, arm => constituent_arm_key(arm)))
  value complete: arms != null && !any(arms, arm => any(arm.parts, part => contains(part.traits, "error")))
  value tokens: bare.token_texts
  value previous_syntax: find(entries, entry => entry.complete && entry.tokens == tokens).node
  value previous_identity: if complete then find(entries, entry => entry.complete
    && count(entry.keys) == count(keys) && all(keys, key => contains(entry.keys, key))).node else null
  value next: entries [{
    node: bare, group: group, previous_syntax: previous_syntax, previous_identity: previous_identity,
    complete: complete, tokens: tokens, keys: keys, explicit_undefined: constituent_explicit_undefined(arms),
  }]
  value if union && bare is ts_union || !union && bare is ts_intersection then
    fold(bare.type.nodes, next, (state, child) => constituent_collect(child, bare, union, state))
    else next
}
fn constituent_components(n, union) = fold(n.type.nodes, [],
  (entries, child) => constituent_collect(child, n, union, entries))

fn constituent_wrappers(source, n) = {
  value parent: n.parent
  value if parent is ts_parenthesized_type then {
    value outer: constituent_wrappers(source, parent)
    value before: byte_slice(source, parent.first_token.end, n.offset)
    value after: byte_slice(source, n.end_offset, parent.last_token.start)
    value {node: outer.node, before: outer.before before, after: after outer.after}
  } else {node: n, before: "", after: ""}
}
fn constituent_equivalent(part) = part.previous_syntax ?? part.previous_identity
fn constituent_optional(part, optional) = {
  value optional && part.explicit_undefined
}
fn constituent_removed(part, optional) =
  part.complete && (constituent_equivalent(part) != null || constituent_optional(part, optional))
fn constituent_hidden(part, parts) =
  any(parts, other => other.complete && constituent_equivalent(other) != null
    && other.node.offset <= part.node.offset && other.node.end_offset >= part.node.end_offset
    && (other.node.offset != part.node.offset || other.node.end_offset != part.node.end_offset))
fn constituent_replacement(source, part, wrapped, parts, optional) = {
  value before: wrapped.node.token_neighbours.before
  value after: wrapped.node.token_neighbours.after
  value remains: any(parts, other => other.group.offset == part.group.offset
    && !constituent_removed(other, optional))
  value if !remains then null
  else if contains(["|", "&"], before.text) && before.start >= part.group.offset then {
    value gap: byte_slice(source, before.end, wrapped.node.offset)
    value {start: before.start, end: wrapped.node.end_offset, text: gap wrapped.before wrapped.after}
  } else if contains(["|", "&"], after.text) && after.end <= part.group.end_offset then {
    value gap: byte_slice(source, wrapped.node.end_offset, after.start)
    value {start: wrapped.node.offset, end: after.end, text: wrapped.before wrapped.after gap}
  } else null
}
fn constituent_candidate(source, part, parts, optional) = {
  value wrapped: constituent_wrappers(source, part.node)
  value previous: constituent_equivalent(part)
  value replacement: constituent_replacement(source, part, wrapped, parts, optional)
  value {node: part.node, wrapped: wrapped.node, previous: previous, replacement: replacement}
}

in duplicate_type_constituent {
  let constituent_root constituent_wrappers(source, node)
  let constituent_top if is ts_union then constituent_root.node.parent not ts_union
    else constituent_root.node.parent not ts_intersection
  let constituent_kind if is ts_union then "Union" else "Intersection"
  let constituent_parts if constituent_top then constituent_components(node, is ts_union) else []
  let constituent_optional_parameter is ts_union
    && constituent_root.node.parent is ts_parameter
    && constituent_root.node.parent.optional != null
  let constituent_candidates {
    value selected: filter(constituent_parts, part => constituent_removed(part, constituent_optional_parameter)
      && !constituent_hidden(part, constituent_parts))
    value map(selected, part => constituent_candidate(source, part, constituent_parts, constituent_optional_parameter))
  }

  rule no-duplicate-type-constituents {
    when duplicate_type_constituents_checked
    each part in constituent_candidates
    when part.previous != null
    report at {start: part.node.offset, end: part.wrapped.end_offset}
    warn "{constituent_kind} type constituent is duplicated with {part.previous}."
    fix at part.replacement if part.replacement != null as part.replacement.text
  }
  rule no-duplicate-type-constituents:optional {
    when duplicate_type_constituents_checked && constituent_optional_parameter
    each part in constituent_candidates
    when part.previous == null
    report at {start: part.node.offset, end: part.wrapped.end_offset}
    warn "Explicit undefined is unnecessary on an optional parameter."
    fix at part.replacement if part.replacement != null as part.replacement.text
  }
}

}
