# Optional-chain selection, guard semantics and atomic edits.
import .ts/expression-fixes

define {

in ts_identifier, ts_private_name, ts_this, ts_super, ts_literal let optional_shape [kind_name(node), text]
in ts_parenthesized let optional_shape if expression.in_optional_chain == true && parent is (ts_member, ts_index, ts_call) then ["boundary", expression.optional_shape] else expression.optional_shape
in ts_non_null let optional_shape expression.optional_shape
in ts_as, ts_type_assertion let optional_shape if expression.optional_shape != null then [kind_name(node), expression.optional_shape, type.token_texts] else null
in ts_meta_property let optional_shape ["meta", text]
in ts_await let optional_shape if argument.optional_shape != null then ["await", argument.optional_shape] else null
in ts_member let optional_shape if object.optional_shape != null && property.optional_shape != null then ["member", object.optional_shape, property.optional_shape] else null
in ts_index let optional_shape if object.optional_shape != null && index.optional_shape != null then ["index", object.optional_shape, index.optional_shape] else null
in ts_call let optional_shape {
  value args: { value argument.nodes; map (arg) arg.optional_shape }
  value types: { value type_argument.nodes; map (type) type.text }
  value if callee.optional_shape != null && { value args; all (shape) shape != null }
    then ["call", callee.optional_shape, args, types] else null
}
in ts_unary let optional_shape if argument.optional_shape != null then ["unary", operator, argument.optional_shape] else null
in ts_binary let optional_shape if left.optional_shape != null && right.optional_shape != null then ["binary", operator, left.optional_shape, right.optional_shape] else null
in ts_template let optional_shape {
  value quasis: { value quasi.nodes; map (quasi) quasi.text }
  value expressions: { value expression.nodes; map (expression) expression.optional_shape }
  value ["template", quasis, expressions]
}
in ts_parenthesized let optional_operands expression.optional_operands
fn optional_side(n, op) = if n is ts_logical && n.operator == op then n.optional_operands else [n]
in ts_logical let optional_operands {
  value lhs: unparenthesised_node(left.node)
  value rhs: unparenthesised_node(right.node)
  value optional_side(lhs, operator) optional_side(rhs, operator)
}
fn optional_base(n) = if n is (ts_member, ts_index) && n.property not ts_private_name then n.object.node
  else if n is ts_call then n.callee.node
  else if n is ts_non_null then n.expression.node
  else if n is ts_parenthesized && n.expression.in_optional_chain != true then n.expression.node else null
fn optional_same(a, b) = a.optional_shape != null && a.optional_shape == b.optional_shape
fn optional_extends(a, b) = { value a; walk (n) if n is ts_non_null then n.expression.node else null; last } is (ts_identifier, ts_member, ts_index, ts_call, ts_meta_property)
  && !optional_same(a, b) && { value b; walk (n) optional_base(n); slice 1; any (n) optional_same(a, n) }
fn optional_nullish(n) = if n is ts_null then "null" else if n is ts_identifier && n.text == "undefined" then "undefined"
  else if n is ts_string && n.literal_value.value == "undefined" then "typeof" else null
fn optional_subject(n, value) = if value == "typeof" && n is ts_unary && n.operator == "typeof" && !(n.argument is ts_identifier && n.argument.resolved == "global") then n.argument.node
  else if value != "typeof" then n else null
fn optional_comparison_kind(value, comparison, op) = if value != "typeof" && starts_with(comparison, "!") != (op == "&&") then "last"
  else if comparison == "==" || comparison == "!=" then "nullish" else if value == "typeof" then "undefined" else value
fn optional_binary_operand(n, op) = {
  value right: optional_nullish(n.right.node)
  value left: optional_nullish(n.left.node)
  value yoda: right == null && left != null
  value compared: if yoda then n.right.node else n.left.node
  value value_kind: if yoda then left else right
  value {node: n, subject: if value_kind != null then optional_subject(compared, value_kind) else null,
    kind: if value_kind != null then optional_comparison_kind(value_kind, n.operator, op) else "last",
    matches: value_kind != null && starts_with(n.operator, "!") == (op == "&&"), yoda: yoda, terminal: false}
}
fn optional_operand(n, op) = if n is ts_binary then optional_binary_operand(n, op)
  else if n is ts_unary && n.operator == "!" then {node: n, subject: unparenthesised_node(n.argument.node), kind: "not", matches: op == "||", terminal: false}
  else {node: n, subject: unparenthesised_node(n), kind: "plain", matches: op == "&&", terminal: false}
fn optional_falsy_literal(n) = {
  value arms: value_constituents(n)
  value any(arms, arm => any(arm, part => part.identity.kind == "value")
    && any(arm, part => contains(part.traits, "falsy")
      && any(part.traits, trait => contains(["boolean", "number", "string", "bigint"], trait))))
}
fn optional_type_allowed(n, opts) = !n.type_has_void && { value n.type_flags.nonempty ?? ["unknown"]; all (flag)
  !contains(["any", "unknown", "string", "number", "boolean", "bigint"], flag) || get(opts, flag) }
fn optional_uncertain(n, flag) = { value n.type_flags.nonempty ?? ["unknown"]; any (part) contains([flag, "any", "unknown"], part) }
fn optional_span(items, opts) = {
  value head: first(items).subject
  value tail: last(items).subject
  value if len(items) > 1 && !optional_same(head, tail)
    && (!opts.requireNullish || { value items; slice 0 -1; any (item) item.subject could nullable }) then {
    start: if { value prefix: first(items).node.offset - opts.boundary.offset; value opts.boundary; byte_slice 0 prefix; re_test /^(?:\s|\(|\/\*[\s\S]*?\*\/|\/\/[^\n]*\n)*$/ }
      then opts.boundary.offset else first(items).node.offset,
    end: last(items).end + { value suffix: last(items).end - opts.boundary.offset; value opts.boundary; byte_slice suffix;
      re_find /^(?:(?:\s|\/\*[\s\S]*?\*\/|\/\/[^\n]*\n)*\))+/; then (closers) byte_len(closers ?? "") }
  } else null
}
fn optional_flush(state, opts) = {
  value span: optional_span(state.items, opts)
  value if span != null then state.reports [{span: span, items: state.items}] else state.reports
}
fn optional_group(current, next) = current.matches && next.matches && contains(["null", "undefined"], current.kind)
  && contains(["null", "undefined"], next.kind) && current.kind != next.kind && optional_same(current.subject, next.subject)
fn optional_valid(current, next, op, last, opts) = current.subject != null && current.matches && (
  if contains(["plain", "not"], current.kind) then last || optional_type_allowed(current.subject, opts)
    && !(current.kind == (if op == "&&" then "plain" else "not") && optional_falsy_literal(current.subject))
  else current.kind == "nullish" || optional_group(current, next)
    || current.kind == "null" && (op == "||" || next != null) && !optional_uncertain(current.subject, "undefined")
    || current.kind == "undefined" && !optional_uncertain(current.subject, "null"))
fn optional_terminal_allowed(n, comparison, op) = if comparison == (if op == "&&" then "===" else "!==") then !optional_uncertain(n, "undefined")
  else if comparison == (if op == "&&" then "==" else "!=") then !optional_uncertain(n, "null") && !optional_uncertain(n, "undefined")
  else if comparison == (if op == "&&" then "!==" else "===") then { value n.type_flags.nonempty ?? ["unknown"]; all (flag) contains(["undefined", "nullable", "union"], flag) }
  else if comparison == (if op == "&&" then "!=" else "==") then { value n.type_flags.nonempty ?? ["unknown"]; all (flag) contains(["null", "undefined", "nullable", "union"], flag) } else false
fn optional_item(current) = {node: current.node, subject: current.subject, kind: current.kind, yoda: current.yoda,
  terminal: current.terminal, end: current.node.end_offset}
fn optional_member_based(n) = {
  value bare: unparenthesised_node(n)
  value callee: if bare is ts_call then unparenthesised_node(bare.callee.node) else null
  value bare.in_optional_chain != true && (bare is (ts_member, ts_index) || callee is (ts_member, ts_index))
}
fn optional_terminal(state, current, op, opts) = {
  value previous: last(state.items).subject
  value left: optional_member_based(current.node.left.node) && optional_extends(previous, current.node.left.node)
  value right: optional_member_based(current.node.right.node) && optional_extends(previous, current.node.right.node)
  value compared: if right then current.node.right.node else current.node.left.node
  value other: if right then current.node.left.node else current.node.right.node
  value accepted: len(state.items) > 0 && left != right && optional_terminal_allowed(other, current.node.operator, op)
  value if accepted then optional_flush({items: state.items [{node: current.node, subject: compared, kind: "last",
    yoda: right, terminal: true, end: current.node.end_offset}], reports: state.reports}, opts) else optional_flush(state, opts)
}
fn optional_accept(state, current, next, opts) = {
  value grouped: optional_group(current, next)
  value extends: len(state.items) > 0 && { value last(state.items).subject; optional_extends current.subject }
  value same: len(state.items) > 0 && { value last(state.items).subject; optional_same current.subject }
  # A paired seed retains both checks. Extending a chain retains only the first;
  # the second check validates the guard but is not part of the replacement.
  value seed: if grouped then [optional_item(current), optional_item(next)] else [optional_item(current)]
  value if extends then {items: state.items [optional_item(current)], reports: state.reports, skip: grouped}
    else if same then {items: state.items, reports: state.reports, skip: grouped}
    else {items: seed, reports: optional_flush(state, opts), skip: grouped}
}
fn optional_step(state, current, next, op, last, opts) = if state.skip then {items: state.items, reports: state.reports, skip: false}
  else if current.kind == "last" then {items: [], reports: optional_terminal(state, current, op, opts), skip: false}
  else if optional_valid(current, next, op, last, opts) then optional_accept(state, current, next, opts)
  else {
    value extended: {items: state.items [{node: current.node, subject: current.subject, kind: current.kind,
      yoda: current.yoda, terminal: true, end: current.node.end_offset}], reports: state.reports}
    value {items: [], reports: if current.kind == "undefined" && len(state.items) > 0 && { value last(state.items).subject; optional_extends current.subject }
      then optional_flush(extended, opts) else optional_flush(state, opts), skip: false}
  }

fn optional_part(n) = if n is (ts_member, ts_index) then {
  text: if n is ts_index then "[" n.index.text "]" else n.property.text,
  dot: n is ts_member, optional: n.optional != null, nonNull: n.object is ts_non_null
} else if n is ts_call then {
  text: { value start: n.callee.end_offset - n.offset; value n; byte_slice start; trim_start; re_replace /^\?\.\s*/ "" },
  dot: false, optional: n.optional != null, nonNull: false
} else {text: expression_fix_wrap(n.text, n.precedence < 19), dot: false, optional: false, nonNull: false}
fn optional_parts(n) = {
  value n
  walk (part) optional_base(part)
  reverse
  filter (part) part not (ts_parenthesized, ts_non_null)
  map (part) optional_part(part)
}
fn optional_render_part(part, guarded) = (if guarded || part.optional then "?." else (if part.nonNull then "!" else "") (if part.dot then "." else "")) part.text
fn optional_render(items) = {
  value items
  fold ({count: 0, text: ""}) (result, item) {
    value parts: optional_parts(item.subject)
    value count: len(parts)
    value appended: { value parts; slice result.count; map (part, index) optional_render_part(part, result.count > 0 && index == 0); join "" }
    value {count: max(result.count, count), text: result.text appended}
  }
  then (result) result.text
}
fn optional_output(items) = {
  value text: optional_render(items)
  value terminal: last(items)
  value compared: if terminal.yoda then terminal.node.right.node else terminal.node.left.node
  value unary: if compared is ts_unary then compared.operator " " else ""
  value if terminal.node is ts_binary then
    if terminal.yoda then terminal.node.left.text " " terminal.node.operator " " unary text
    else unary text " " terminal.node.operator " " terminal.node.right.text
  else if terminal.kind == "not" then "!" text else text
}
fn optional_safe(items, op, unsafe) = {
  value terminal: last(items)
  value unsafe || !terminal.terminal && (contains(["nullish", "undefined"], terminal.kind)
    || op == "||" && terminal.kind == "not"
    || { value items; any (item) optional_uncertain(item.node, "undefined") })
}
fn optional_tail(source, span, boundary) = {
  # Paired code tokens, not character counts: parentheses in comments and strings
  # cannot consume or manufacture an unmatched delimiter.
  value removed: { value overlapping(ts_close_paren, span.end, boundary.end_offset);
    filter (token) token.paired_token.start >= span.start && token.paired_token.start < span.end }
  value removed
  fold ({offset: span.end, text: ""}) (tail, token) {
    text: tail.text byte_slice(source, tail.offset, token.offset), offset: token.end_offset
  }
  then (tail) tail.text byte_slice(source, tail.offset, boundary.end_offset)
}
fn optional_fix_output(boundary, target, text) = {
  value head_node: node_at(target.start)
  value tail_node: node_at(target.end - 1)
  value edges: {offset: target.start, end_offset: target.end,
    token_neighbours: {before: head_node.token_neighbours.before, after: tail_node.token_neighbours.after}}
  value statement: if target.start == boundary.offset then expression_fix_statement(boundary) else null
  value head: { value text; trim_start; slice 0 1 }
  value owners: expression_fix_before_nodes(boundary)
  value asi: if statement != null && contains(["(", "[", "/", "`"], head)
    then expression_fix_asi(statement, boundary.token_neighbours.before, owners, text) else false
  value if asi == null then null else {target: target,
    text: (if asi then ";" else "") expression_fix_edges(edges, text)}
}
fn optional_edit(source, report, boundary) = {
  value text: optional_output(report.items)
  value open: { value overlapping(ts_open_paren, report.span.start, report.span.end);
    any (token) token.paired_token.end > report.span.end && token.paired_token.end <= boundary.end_offset }
  value target: if open then {start: report.span.start, end: boundary.end_offset} else report.span
  value replacement: if open then text optional_tail(source, report.span, boundary) else text
  value optional_fix_output(boundary, target, replacement)
}
fn optional_report(source, report, boundary, op, unsafe) = {
  span: report.span, edit: if optional_safe(report.items, op, unsafe) then optional_edit(source, report, boundary) else null
}

in ts_logical rule prefer-optional-chain {
  option checkAny boolean = true "Check any values"
  option checkUnknown boolean = true "Check unknown values"
  option checkString boolean = true "Check string values"
  option checkNumber boolean = true "Check number values"
  option checkBoolean boolean = true "Check boolean values"
  option checkBigInt boolean = true "Check bigint values"
  option requireNullish boolean = false "Require a nullable checked operand"
  option allowPotentiallyUnsafeFixesThatModifyTheReturnTypeIKnowWhatImDoing boolean = false "Allow fixes that may add undefined to the return type"
  let enclosing { value node; walk (n) if n.parent is ts_parenthesized then n.parent.node else null; last }
  when operator != "??" && !(enclosing.parent is ts_logical && enclosing.parent.operator == operator)
  let opts {any: checkAny, unknown: checkUnknown, string: checkString, number: checkNumber, boolean: checkBoolean,
    bigint: checkBigInt, requireNullish: requireNullish, boundary: node}
  let operands { value optional_operands; map (operand) { value operand; unparenthesised_node; optional_operand operator } }
  let state {
    value following: { value operands; slice 1 } [null]
    value operands
    zip following
    fold ({items: [], reports: [], skip: false}) (state, pair) {
      value current: first(pair)
      value next: last(pair)
      value optional_step(state, current, next, operator, next == null, opts)
    }
  }
  each chain in { value state; optional_flush opts;
    map (report) optional_report(source, report, node, operator, allowPotentiallyUnsafeFixesThatModifyTheReturnTypeIKnowWhatImDoing) }
  report at chain.span
  warn "Prefer using an optional chain expression instead, as it's more concise and easier to read."
  fix at chain.edit.target if chain.edit != null as chain.edit.text
}
in ts_logical rule prefer-optional-chain:empty-object {
  option requireNullish boolean = false "Require a nullable checked operand"
  when contains(["||", "??"], operator) && unparenthesised_node(right.node) is ts_object && { value unparenthesised_node(right.node).property.nodes; count } == 0
  let enclosing { value node; walk (n) if n.parent is ts_parenthesized then n.parent.node else null; last }
  when enclosing.parent is (ts_member, ts_index) && enclosing.parent.optional == null
  when !requireNullish || left could nullable
  report at enclosing.parent
  warn "Prefer using an optional chain expression instead, as it's more concise and easier to read."
}

}
