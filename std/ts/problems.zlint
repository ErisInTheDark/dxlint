# .ts/problems: ESLint core "possible problems" and typescript-eslint rules
# on the native TypeScript layers. Messages and positions follow ESLint's.

import .ts/helpers
import .ts/scoping/member-uses

define {

@macro normalize_space(x) re_replace(x, /\s+/, " ")
group ts_literal ts_string, ts_number, ts_boolean, ts_null, ts_bigint, ts_regex

# ---- for-direction -------------------------------------------------------------
# `i < n; i--` and friends: the update moves the counter away from the end.
in ts_for rule for-direction {
  when wrong_direction
  warn "The update clause in this loop moves the variable in the wrong direction."
}

# ---- banned things ---------------------------------------------------------
in ts_debugger rule no-debugger warn "Unexpected 'debugger' statement."

# A global (not shadowed, not switched off) of this name.
@macro is_global(name) (text == name && (global == "readonly" || global == "writable"))

# `new Promise(async () => ...)`, also inside parentheses.
in ts_new let promise_constructor callee.is_real_promise == true
in ts_identifier let is_real_promise @is_global("Promise")
in ts_parenthesized let promise_executor_slot parent is ts_new && index == 0 && parent.promise_constructor || parent is ts_parenthesized && parent.promise_executor_slot == true
in ts_arrow, ts_function rule no-async-promise-executor {
  when contains(modifier, "async")
  when parent is ts_new && index == 0 && parent.promise_constructor || parent is ts_parenthesized && parent.promise_executor_slot == true
  warn "Promise executor functions should not be async."
}

# ---- small expression mistakes ---------------------------------------------
in ts_member rule no-caller {
  when object == "arguments" && property ~ /callee|caller/
  warn "Avoid arguments.{property}."
}

in ts_binary rule no-compare-neg-zero {
  when operator ~ /===?|!==?|<=?|>=?/ && (re_test(left, /^-\s*0$/) || re_test(right, /^-\s*0$/))
  warn "Do not use the '{operator}' operator to compare against -0."
}

# Assignments as conditions, unless wrapped in their own parentheses (a `?:`
# test needs two pairs: it has none of its own). With "always", any
# assignment inside a condition.
in ts_assignment let is_assignment true
in ts_parenthesized let wraps_assignment expression.is_assignment == true
in ts_if.test, ts_while.test, ts_do_while.test, ts_for.test, ts_conditional.test rule no-cond-assign {
  option mode "except-parens" | "always" = "except-parens"
  when mode == "except-parens"
  when is ts_assignment || parent is ts_conditional && is ts_parenthesized && wraps_assignment == true
  report at unparen_offset
  warn "Expected a conditional expression and instead saw an assignment."
}
in ts_assignment rule no-cond-assign:always {
  option mode "except-parens" | "always" = "except-parens"
  let where if conditional_ancestor is ts_if then "an 'if' statement" else if conditional_ancestor is ts_while then "a 'while' statement" else if conditional_ancestor is ts_do_while then "a 'do...while' statement" else if conditional_ancestor is ts_for then "a 'for' statement" else "ConditionalExpression"
  when mode == "always" && conditional_ancestor != null
  warn "Unexpected assignment within {where}."
}

# Comparisons with `NaN` (or `Number.NaN`, or a sequence ending in it).
in ts_identifier let is_nan text == "NaN" && is_real_global
in ts_member, ts_index let is_nan object == "Number" && object.is_real_global == true && static_name == "NaN"
in ts_parenthesized let is_nan expression.is_nan == true
in ts_sequence let is_nan last([] expression.is_nan) == true
in ts_binary rule use-isnan {
  when operator ~ /(?:[<>]|[!=]=)=?/ && (left.is_nan == true || right.is_nan == true)
  warn "Use the isNaN function to compare with NaN."
}
group use_isnan_searches
in ts_switch rule use-isnan:switch {
  when discriminant.is_nan == true
  warn "'switch(NaN)' can never match a case clause. Use Number.isNaN instead of the switch."
}
in ts_case rule use-isnan:case {
  when test.is_nan == true
  warn "'case NaN' can never match. Use Number.isNaN before the switch."
}
in use_isnan_searches rule use-isnan:index-of {
  when (callee.static_name == "indexOf" || callee.static_name == "lastIndexOf") && count(argument) <= 2 && first([] argument.is_nan) == true
  warn "Array prototype method '{callee.static_name}' cannot find NaN."
}

# `typeof x === "strnig"`, either way round.
in ts_unary let is_typeof operator == "typeof"
in ts_parenthesized let is_typeof expression.is_typeof == true
in ts_binary {
  let left_is_typeof left.is_typeof == true
  let right_is_typeof right.is_typeof == true
}
@macro valid_typeof_names ["symbol", "undefined", "object", "boolean", "number", "string", "function", "bigint"]
in ts_binary.left, ts_binary.right rule valid-typeof {
  option requireStringLiterals boolean = false "compare only with string literals"
  let compared_with_typeof parent.operator ~ /[=!]==?/ && (if is ts_node.left then parent.right_is_typeof else parent.left_is_typeof)
  when compared_with_typeof
  when literal_value != null && (literal_value.type != "string" || !contains(@valid_typeof_names, literal_value.value))
    || is_global_undefined
    || requireStringLiterals && literal_value == null && is_typeof != true
  report at unparen_offset
  warn if requireStringLiterals && literal_value == null then "Typeof comparisons should be to string literals." else "Invalid typeof comparison value."
}
in ts_identifier let is_global_undefined text == "undefined" && global == "readonly"
in ts_parenthesized let is_global_undefined expression.is_global_undefined == true

# `a = a`, also inside destructuring and members (`a.b = a.b`).
in ts_assignment let self_assignment_findings self_assignments
in ts_assignment rule no-self-assign {
  each self in self_assignment_findings
  report at self.offset
  warn "'{self.name}' is assigned to itself."
}

# `if (true)`, `while (1)`, `do ... while (false)`, `false ? a : b`.
in ts_if.test, ts_conditional.test rule no-constant-condition {
  when constant_truthiness
  warn "Unexpected constant condition."
}
# Loops that `yield` (generators) may loop forever on purpose.
in ts_while, ts_do_while, ts_for let constant_loop_condition_checked !(is ts_while && re_test(test, /^[(\s]*true[)\s]*$/))
in ts_while.test, ts_do_while.test, ts_for.test rule no-constant-condition:loop {
  when constant_truthiness && parent.constant_loop_condition_checked && !parent.contains_yield
  warn "Unexpected constant condition."
}

# Comparisons and short circuits whose result cannot change.
in ts_binary, ts_logical let constant_relation_checked false
in ts_binary, ts_logical rule no-constant-binary-expression {
  let c constant_comparison
  when c != null || constant_relation_checked && constant_relation
  report at if c != null then c.offset else offset
  warn if c == null then "Unexpected constant relational comparison. Both sides of the `{operator}` are literal values."
    else if c.kind == "constantShortCircuit" then "Unexpected constant {c.detail} on the left-hand side of a `{operator}` expression."
    else if c.kind == "constantBinaryOperand" then "Unexpected constant binary expression. Compares constantly with the {c.detail}-hand side of the `{operator}`."
    else if c.kind == "alwaysNew" then "Unexpected comparison to newly constructed object. These two values can never be equal."
    else "Unexpected comparison of two newly constructed objects. These two values can never be equal."
}

in ts_unary rule no-delete-var {
  when operator == "delete" && is_identifier(argument)
  warn "Variables should not be deleted."
}

# A condition every one of whose `||` parts an earlier branch already tested.
in ts_if.test rule no-dupe-else-if {
  when parent.duplicate_condition
  report at unparen_offset
  warn "This branch can never execute. Its condition is a duplicate or covered by previous conditions in the if-else-if chain."
}

in ts_case rule no-duplicate-case {
  when duplicate_case
  warn "Duplicate case label."
}

in ts_object_pattern let empty_object_pattern_checked true
in ts_object_pattern rule no-empty-pattern:object {
  when count(property) == 0 && rest == null
  when empty_object_pattern_checked
  warn "Unexpected empty object pattern."
}
in ts_array_pattern rule no-empty-pattern:array {
  when count(element) == 0
  warn "Unexpected empty array pattern."
}

in ts_static_block.body rule no-empty-static-block {
  when re_test(text, /^\{\s*\}$/)
  warn "Unexpected empty static block."
}

# ---- writes to what cannot (or should not) change ------------------------
@macro is_write (access == "write" || access == "read_write")
in ts_identifier rule no-ex-assign {
  when reference_kind == "catch" && @is_write
  warn "Do not assign to the exception parameter."
}
in ts_identifier rule no-const-assign {
  when (reference_kind == "const" || reference_kind == "using") && @is_write
  warn "'{text}' is constant."
}
in ts_identifier rule no-class-assign {
  when (reference_kind == "class" || reference_kind == "class_name") && @is_write
  warn "'{text}' is a class."
}
in ts_identifier rule no-func-assign {
  when (reference_kind == "function" || reference_kind == "function_name") && @is_write
  warn "'{text}' is a function."
}
in ts_identifier rule no-import-assign {
  when reference_kind == "import" && @is_write
  report at write_site
  warn "'{text}' is read-only."
}
# Members of a namespace import: `ns.x = 1`, `ns.x++`, `delete ns.x`.
in ts_member, ts_index rule no-import-assign:member {
  when write_site != null && object.imported_name == "*"
  report at write_site
  warn "The members of '{object}' are read-only."
}
# `Object.assign(ns, ...)`, `Reflect.set(ns, ...)` and the like.
in ts_identifier let is_real_global global == "readonly" || global == "writable"
in ts_member let on_real_global object.is_real_global == true || object.on_real_global == true
in ts_parenthesized, ts_non_null let on_real_global expression.on_real_global == true
in ts_call rule no-import-assign:call {
  when callee.on_real_global == true
  when {
    value callee
    re_replace /[\s()]/ ""
    re_test /^(?:Object\??\.(?:assign|defineProperty|defineProperties|freeze|setPrototypeOf)|Reflect\??\.(?:defineProperty|deleteProperty|set|setPrototypeOf))$/
  }
  when first([] argument.imported_name) == "*"
  warn "The members of '{first(argument)}' are read-only."
}

# ---- duplicates ----------------------------------------------------------------
# Getters and setters of one name pair up; anything else of the same name
# (in the same object, or the same static-ness of a class) is a duplicate.
in ts_method let accessor_kind if kind == "get" || kind == "set" then kind else "init"
in ts_property, ts_class_property let accessor_kind "init"
@macro duplicate_of(e) (e != null && e.name == static_name && (accessor_kind == "init" || e.kind == "init" || e.kind == accessor_kind))
# (`""` is a name: `type_of` tells it from null.)
@macro has_static_name (type_of(static_name) == "str")
# `__proto__: x` sets the prototype rather than defining a key.
in ts_property let proto_setter static_name == "__proto__" && value != null && !starts_with(key, "[")
in ts_method let proto_setter false
in ts_property, ts_method let key_entry if !@has_static_name || proto_setter then null else { name: static_name, kind: accessor_kind }
in ts_object let keyed [] property.key_entry
in ts_property, ts_method let duplicate_key parent is ts_object && parent.flow_destructuring_target != true && key_entry != null && { value parent.keyed; slice 0 index; any (e) @duplicate_of(e) }
# At the name: inside the brackets of a computed key.
@macro at_key_name (offset + { value text; re_find /^\[\s*/; len })
in ts_property.key, ts_method.key rule no-dupe-keys {
  when parent.duplicate_key
  report at @at_key_name
  warn "Duplicate key '{parent.static_name}'."
}

# Overload signatures (no body) are not members of their own. (`is_static`
# comes from .ts/style.)
in ts_method let member_entry if !@has_static_name || body == null || static_name == "constructor" && !is_static && !starts_with(key, "[") then null else { name: static_name, kind: accessor_kind, static: is_static }
in ts_class_property let member_entry if !@has_static_name then null else { name: static_name, kind: accessor_kind, static: is_static }
in ts_class let member_entries [] member.member_entry
in ts_method, ts_class_property let duplicate_member parent is ts_class && member_entry != null && { value parent.member_entries; slice 0 index; any (e) @duplicate_of(e) && e.static == is_static }
in ts_method.key, ts_class_property.key rule no-dupe-class-members {
  when parent.duplicate_member
  report at @at_key_name
  warn "Duplicate name '{parent.static_name}'."
}

# Once per name, at the parameter list.
in ts_function rule no-dupe-args {
  each duplicate_param in duplicate_parameters
  report at offset + { value text; re_find /^[^(]*/; len }
  warn "Duplicate param '{duplicate_param}'."
}

in ts_enum_member let enum_value init.literal_value
in ts_enum let enum_values [] member.enum_value
in ts_enum_member rule no-duplicate-enum-values {
  when enum_value != null && {
    value parent.enum_values
    slice 0 index
    any (v) v != null && v.type == enum_value.type && v.value == enum_value.value
  }
  warn "Duplicate enum member value {if enum_value.value == '-0' then '0' else enum_value.value}."
}

in ts_class.name, ts_interface.name rule no-unsafe-declaration-merging {
  when contains(declaration_kinds, "class") && contains(declaration_kinds, "interface")
  warn "Unsafe declaration merging between classes and interfaces."
}

# ---- @ts- directives (ban-ts-comment) -----------------------------------------------
# The directive and its description, as TypeScript reads them: `// @ts-x`
# (`///` too for check/nocheck) or the last line of a block comment.
in ts_comment let ts_comment_body if is ts_line_comment then slice(text, 2) else { value result: len(text) - 2; value slice(text, 2, result); re_replace /^[\s\S]*(?:\r\n|[\r\n\u{2028}\u{2029}])/ "" }
in ts_comment let ts_pragma is ts_line_comment && re_test(text, /^\/\/\/?\s*@ts-(?:check|nocheck)/)
in ts_comment let ts_suppress if is ts_line_comment then re_test(ts_comment_body, /^\/*\s*@ts-(?:expect-error|ignore)/) else re_test(ts_comment_body, /^\s*(?:\/|\*)*\s*@ts-(?:expect-error|ignore)/)
in ts_comment let ts_directive if ts_pragma then re_replace(text, /^\/\/\/?\s*@ts-(check|nocheck)[\s\S]*$/, "$1") else if ts_suppress then re_replace(ts_comment_body, /^[\/*\s]*@ts-(expect-error|ignore)[\s\S]*$/, "$1") else null
in ts_comment let ts_directive_description if ts_pragma then re_replace(text, /^\/\/\/?\s*@ts-(?:check|nocheck)([^\r\n\u{2028}\u{2029}]*)[\s\S]*$/, "$1") else re_replace(ts_comment_body, /^[\/*\s]*@ts-(?:expect-error|ignore)([^\r\n\u{2028}\u{2029}]*)[\s\S]*$/, "$1")
# `@ts-nocheck` only counts before the first statement.
in ts_comment let ts_directive_effective ts_directive != "nocheck" || { value overlapping(ts_program); first }.first_token.start == null || offset < { value overlapping(ts_program); first }.first_token.start
fn ts_directive_message(directive, description, mode, minimum, pattern) = (
  if mode == "allow" then null
  else if mode == "deny" && directive == "ignore" then "Use \"@ts-expect-error\" instead of \"@ts-ignore\", as \"@ts-ignore\" will do nothing if the following line is error-free."
  else if mode == "deny" then "Do not use \"@ts-{directive}\" because it alters compilation errors."
  else if { value description; trim; graphemes } < minimum then "Include a description after the \"@ts-{directive}\" directive to explain why the @ts-{directive} is necessary. The description must be {minimum} characters or longer."
  else if pattern != null && !re_test(description, pattern) then "The description for the \"@ts-{directive}\" directive must match the {pattern} format."
  else null
)
@macro ban_ts_directive(name, mode_default) {
  default option mode enum(allow, deny, require-description) = mode_default
  option descriptionPattern regex | null = null
  option minimumDescriptionLength int(0..) = 3
  when ts_directive == name && ts_directive_effective
  let message ts_directive_message(ts_directive, ts_directive_description, mode, minimumDescriptionLength, descriptionPattern)
  when message != null
  warn message
}
in ts_comment rule ban-ts-comment:expect-error { @ban_ts_directive("expect-error", require-description) }
in ts_comment rule ban-ts-comment:ignore { @ban_ts_directive("ignore", deny) }
in ts_comment rule ban-ts-comment:nocheck { @ban_ts_directive("nocheck", deny) }
in ts_comment rule ban-ts-comment:check { @ban_ts_directive("check", allow) }

# `Function` as a type (not a local type of that name), also `implements
# Function`.
in ts_type_reference rule no-unsafe-function-type {
  when name == "Function" && name.resolved == null && name.reference_kind == null
  warn "The `Function` type accepts any function-like value.\nPrefer explicitly defining any function parameters and return type."
}

# ---- non-null assertions -----------------------------------------------------------
in ts_parenthesized let under_non_null parent is ts_non_null || parent is ts_parenthesized && parent.under_non_null == true
# The object or callee of `?.`, through parentheses.
group optional_chain_head ts_non_null, ts_parenthesized
in optional_chain_head let heads_optional_chain is (ts_member.object, ts_index.object) && parent.optional != null
  || is ts_call.callee && parent.optional != null
  || parent is ts_parenthesized && parent.heads_optional_chain == true
in ts_non_null rule no-extra-non-null-assertion {
  when parent is ts_non_null || parent is ts_parenthesized && parent.under_non_null == true || heads_optional_chain
  fix as { value result: len(text) - 1; value slice(text, 0, result) }
  warn "Forbidden extra non-null assertion."
}
# `x?.y!` (at the end of the chain), `(x?.y)!`.
@macro non_null_chain_message "Optional chain expressions can return undefined by design - using a non-null assertion is unsafe and wrong."
in ts_non_null rule no-non-null-asserted-optional-chain {
  when expression.in_optional_chain == true
  when not (ts_member.object, ts_index.object, ts_call.callee)
  warn @non_null_chain_message
}
in ts_non_null.expression rule no-non-null-asserted-optional-chain:paren {
  when is ts_parenthesized && wraps_optional_chain == true
  report at unparen_offset
  warn @non_null_chain_message
}

# ---- accessors -------------------------------------------------------------------
in ts_return rule no-setter-return {
  when argument != null && enclosing_accessor == "set"
  warn "Setter cannot return a value."
}
# `{ set: v => value }`: the arrow's value is its return.
in ts_arrow.body rule no-setter-return:arrow {
  when parent.accessor == "set" && not ts_block
  warn "Setter cannot return a value."
}

# ---- calls that cannot work --------------------------------------------------------
in ts_call, ts_new rule no-obj-calls {
  when contains(["Atomics", "JSON", "Math", "Reflect", "Intl", "Temporal"], callee.global_value)
  let called { value callee; re_replace /^[\s(]+|[\s)!]+$/ ""; re_replace /^.*[.\[]\s*['"`]?|['"`]?\s*\]$/ "" }
  warn if called == callee.global_value then "'{called}' is not a function." else "'{called}' is reference to '{callee.global_value}', which is not a function."
}
in ts_new rule no-new-native-nonconstructor {
  when (callee == "Symbol" || callee == "BigInt") && callee.is_real_global == true
  warn "`{callee}` cannot be called as a constructor."
}

# `x.hasOwnProperty(k)` borrows a method the object may not have.
in ts_member.property, ts_index.index rule no-prototype-builtins {
  when parent.called_member == true && contains(["hasOwnProperty", "isPrototypeOf", "propertyIsEnumerable"], parent.static_name)
  warn "Do not access Object.prototype method '{parent.static_name}' from target object."
}
in ts_member, ts_index, ts_parenthesized let called_member is ts_call.callee || parent is ts_parenthesized && parent.called_member == true

# `!a in b`: the `!` applies to `a` alone.
in ts_binary let unsafe_negation_checked contains(["in", "instanceof"], operator)
in ts_binary.left rule no-unsafe-negation {
  when is ts_unary && re_test(text, /^!/)
  when parent.unsafe_negation_checked
  warn "Unexpected negating the left operand of '{parent.operator}' operator."
}

# `let x;` that is read but never written.
in ts_declarator rule no-unassigned-vars {
  when init == null && is_identifier(name) && ts_variable_declaration.kind != "const"
  when name.writes == 0 && name.uses > 0 && name.ambient == false && parent.declares_loop_variable != true
  warn "'{name}' is always 'undefined' because it's never assigned."
}

# Writes to the built-in globals.
in ts_identifier rule no-global-assign {
  option exceptions string[] = [] "read-only globals that may be modified"
  when global == "readonly" && @is_write && !contains(exceptions, identifier_name)
  warn "Read-only global '{text}' should not be modified."
}

in ts_identifier rule no-undef {
  option typeof boolean = false "also report `typeof x` of an undeclared `x`"
  when resolved == "global" && (global == null || global == "off") && access != "type"
  when typeof || !under_typeof
  warn "'{text}' is not defined."
}
# The operand of `typeof`, through parentheses.
in ts_identifier, ts_parenthesized let under_typeof parent is ts_unary && parent.operator == "typeof" || parent is ts_parenthesized && parent.under_typeof == true

in ts_number rule no-octal {
  when re_test(text, /^0[0-9]/)
  warn "Octal literals should not be used."
}

# Every hole, at its comma.
in ts_array let is_assignment_target parent is ts_assignment && parent.left == text || parent is (ts_for_of, ts_for_in)
in ts_hole rule no-sparse-arrays {
  when parent is ts_array && !parent.is_assignment_target
  warn "Unexpected comma in middle of array."
}

# `return`/`throw`/`break`/`continue` that leave a `finally` block.
in ts_return, ts_throw, ts_break, ts_continue rule no-unsafe-finally {
  when leaves_finally
  warn "Unsafe usage of {if is ts_return then 'ReturnStatement' else if is ts_throw then 'ThrowStatement' else if is ts_break then 'BreakStatement' else 'ContinueStatement'}."
}

fn problem_label_context(n) = { value n; walk (current) if current is ts_labeled then current.parent else null; last }
group problem_label_jump ts_break, ts_continue
fn problem_jump_label(jump) = {
  value jump.parent
  walk (current) if current is (ts_function_like, ts_static_block) then null else current.parent
  filter (current) current is ts_labeled && current.label.identifier_name == jump.label.identifier_name
  first
}
in problem_label_jump let problem_label_target if label != null then problem_jump_label(node) else null
in ts_labeled let problem_label_used { value descendants(problem_label_jump); any (jump) jump.problem_label_target.offset == offset }
in ts_labeled.label rule no-unused-labels {
  when !parent.problem_label_used
  let label_body parent.body.node
  let label_context problem_label_context(parent.parent)
  let label_expression unparenthesised_node(label_body.expression.node)
  let label_directive label_body is ts_expression_statement
    && (label_expression is ts_string || label_expression is ts_template && count(label_expression.expression) == 0)
    && (label_context is ts_program || label_context is ts_block && label_context.parent is ts_function_like)
  let label_previous parent.token_neighbours.before
  let label_asi label_previous != null && !contains([":", ";", "{{"], label_previous.text) && re_test(label_body.text, /^[\[(+\-\/`]/)
  fix at { start: offset, end: label_body.offset } if !space_after.comments && !label_body.space_before.comments && !label_directive && !label_asi as ""
  warn "'{text}:' is defined but never used."
}

in ts_function, ts_method rule require-yield {
  let declared_yields flow_declared_effects(body.node, "yielded")
  when contains(modifier, "*") && declared_yields != null && count(declared_yields) == 0 && !{ value body.nonempty ?? ""; re_test /^\{\s*\}$/ }
  warn "This generator function does not have 'yield'."
}

in ts_number rule no-loss-of-precision {
  when precision_lost
  warn "This number literal will lose precision at runtime."
}

# ---- code paths ------------------------------------------------------------------
in ts_node let problem_constructor_call_count
  if is ts_method && node.key == "constructor" then 0
  else {
    value count: { value [] children.problem_constructor_call_count; sum }
    value count + (if is ts_call && node.callee is ts_super then 1 else 0)
  }
fn problem_never_constructed(cls) = {
  value constructors: filter(cls.member.nodes, member => member is ts_method && member.key == "constructor")
  value constructor: first(constructors)
  value constructor != null && constructor.body.problem_constructor_call_count == 0
}
in ts_method let problem_super_calls {
  value missing: flow_complete_without(body.node, "constructed", ["returned"])
  value called: flow_complete_with(body.node, "constructed", ["returned"])
  value if missing == false then "all" else if missing == true then if called == true then "some" else if called == false then "none" else null else null
}
in ts_node let problem_in_try
  if is (ts_program, ts_function, ts_arrow, ts_method, ts_static_block) then false
  else if is ts_try.block then true else parent.problem_in_try
in ts_node let problem_assignment_export_read
  any(references, reference => reference is ts_export_specifier.local)
  || ts_usage_global(ts_usage_binding, scoping_program) && contains(ts_exported_names(scoping_program), identifier_name)
in ts_node let problem_expression_value_used
  if parent == null || is (ts_expression_statement.expression, ts_for.init, ts_for.update) then false
  else if is (ts_parenthesized.expression, ts_as.expression, ts_satisfies.expression, ts_non_null.expression, ts_type_assertion.expression, ts_instantiation.expression) then parent.problem_expression_value_used
  else if is ts_sequence.expression then index == count(parent.expression) - 1 && parent.problem_expression_value_used
  else if is (ts_logical.right, ts_conditional.consequent, ts_conditional.alternate) then parent.problem_expression_value_used
  else if is ts_unary.argument && parent.operator == "void" then false
  else true
in ts_node let problem_assignment_expression
  if is (ts_parenthesized.expression, ts_as.expression, ts_satisfies.expression, ts_non_null.expression, ts_type_assertion.expression, ts_instantiation.expression) then parent.problem_assignment_expression
  else if is ts_assignment.left && parent.flow_destructuring_target != true && parent.left.flow_assignment_scalar == true then parent.node
  else if is ts_update.argument then parent.node
  else null
group code_path_statement ts_block, ts_break, ts_class, ts_continue, ts_debugger, ts_do_while, ts_expression_statement, ts_for_in, ts_for_of, ts_for, ts_if, ts_labeled, ts_return, ts_switch, ts_throw, ts_try, ts_while, ts_with, ts_export, ts_variable_declaration, ts_class_property
fn problem_unreachable_statement(n) = n not ts_class_property
  && (n not ts_variable_declaration || n.kind != "var" || any(n.declaration.nodes, declaration => declaration.init != null))
fn problem_unreachable_step(state, statement, dead) = {
  value range: state.range
  value inside: range != null && statement.offset >= range.offset && statement.end_offset <= range.end_offset
  value adjacent: range != null && statement.token_neighbours.before.start >= range.offset && statement.token_neighbours.before.start < range.end_offset
  value if dead && inside then state
    else if dead && adjacent then { range: { node: range.node, offset: range.offset, end_offset: max(range.end_offset, statement.end_offset) }, reports: state.reports }
    else {
      range: if dead then { node: statement, offset: statement.offset, end_offset: statement.end_offset } else null,
      reports: state.reports (if range != null then [{ start: range.offset, end: range.end_offset }] else [])
    }
}
fn problem_unreachable_ranges(statements, always_dead) = {
  value state: {
    value statements
    sort_by (statement) statement.offset
    fold ({ range: null, reports: [] }) (state, statement) {
      value dead: always_dead || reachable(statement) == false
      value problem_unreachable_step(state, statement, dead)
    }
  }
  value state.reports (if state.range != null then [{ start: state.range.offset, end: state.range.end_offset }] else [])
}
in ts_program let problem_unreachable_runs {
  value statements: { value descendants(code_path_statement); filter (statement) problem_unreachable_statement(statement) }
  value problem_unreachable_ranges(statements, false)
}
in ts_program rule no-unreachable {
  each statement in problem_unreachable_runs
  report at statement
  warn "Unreachable code."
}
in ts_class rule no-unreachable:derived {
  when extends != null && problem_never_constructed(node)
  let statements filter(member.nodes, property => {
    value modifiers: [] property.modifier
    value property is ts_class_property && !contains(modifiers, "static")
  })
  each statement in problem_unreachable_ranges(statements, true)
  report at statement
  warn "Unreachable code."
}

in ts_method, ts_function, ts_arrow rule getter-return {
  option allowImplicit boolean = false "a bare `return;` counts as returning"
  when accessor == "get" && flow_normal(body.node) == true
  report at function_warning_site(node)
  warn if count(scoping_own_returns) == 0 || !allowImplicit && all(scoping_own_returns, returned => returned.argument == null) then "Expected to return a value in {function_name}." else "Expected {function_name} to always return a value."
}
in ts_return rule getter-return:bare {
  option allowImplicit boolean = false "a bare `return;` counts as returning"
  when argument == null && !allowImplicit && enclosing_accessor == "get"
  warn "Expected to return a value in {enclosing_function_name}."
}

# `case` statements whose end is reachable run into the next case.
in ts_case let case_path if reachable(node) == true then if flow_normal(node) == true then "falls_through" else if flow_normal(node) == false then "leaves" else null else null
in ts_case let has_body count(body) > 0
in ts_switch {
  let case_paths [] case.case_path
  let case_bodies [] case.has_body
}
# The last comment before this case, or before the closing brace of a case
# whose only statement is a block.
@macro last_comment(t) re_find(t, /(?:\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\/|\/\/[^\r\n]*)\s*$/)
@macro block_case /^\s*(?:case\b[\s\S]*?|default\s*):\s*\{([\s\S]*)\}\s*$/
in ts_case let case_comment_in_block { value previous_sibling.nonempty ?? ""; re_test @block_case }
in ts_case let case_comment_block_source
  if case_comment_in_block then re_replace(previous_sibling, /\}\s*$/, "")
  else ""
in ts_case let case_comment_in_block_text @last_comment(case_comment_block_source)
in ts_case let case_comment_source
  if case_comment_in_block_text != null then case_comment_block_source else gap_before.nonempty ?? ""
in ts_case let case_comment @last_comment(case_comment_source)
in ts_case let case_comment_offset offset - len(gap_before.nonempty ?? "") - (if case_comment_in_block_text != null then len(previous_sibling) else 0) + len(case_comment_source) - len(case_comment.nonempty ?? "")
in ts_case rule no-fallthrough {
  option allowEmptyCase boolean = false "allow empty cases separated by blank lines"
  option commentPattern regex | null = null "comments that allow falling through (default: /falls?\\s?through/i)"
  option reportUnusedFallthroughComment boolean = false "report such comments where nothing falls through"
  let previous_path { value parent.case_paths; slice 0 index; last }
  let previous_has_body { value parent.case_bodies; slice 0 index; last }
  let comment_body { value case_comment.nonempty ?? ""; re_replace /^\/[*\/]|\*\/$/ ""; trim }
  let allowing case_comment != null && { value default: commentPattern.nonempty ?? "(?i)falls?\\s?through"; value re_test(comment_body, default) } && !re_test(comment_body, /^(?:eslint[- ]|(?:globals?|exported) )/)
  when index > 0 && previous_path == "falls_through" && (previous_has_body || !allowEmptyCase && { value gap_before.nonempty ?? ""; re_count /\n/ } >= 2)
  when !allowing
  warn "Expected a 'break' statement before '{if test == null then 'default' else 'case'}'."
}
in ts_case rule no-fallthrough:unused-comment {
  option reportUnusedFallthroughComment boolean = false "report such comments where nothing falls through"
  option commentPattern regex | null = null "comments that allow falling through (default: /falls?\\s?through/i)"
  let comment_body { value case_comment.nonempty ?? ""; re_replace /^\/[*\/]|\*\/$/ ""; trim }
  when reportUnusedFallthroughComment && index > 0 && case_comment != null
  when { value parent.case_paths; slice 0 index; last } == "leaves"
  when { value default: commentPattern.nonempty ?? "(?i)falls?\\s?through"; value re_test(comment_body, default) } && !re_test(comment_body, /^(?:eslint[- ]|(?:globals?|exported) )/)
  report at case_comment_offset
  warn "Found a comment that would permit fallthrough, but case cannot fall through."
}

# ---- classes -------------------------------------------------------------------
in ts_method.key rule constructor-super {
  when text == "constructor" && ts_class.extends != null
  when parent.problem_super_calls == "none" || parent.problem_super_calls == "some"
  warn if parent.problem_super_calls == "none" then "Expected to call 'super()'." else "Lacked a call of 'super()' in some code paths."
}
in ts_call rule constructor-super:call {
  when callee is ts_super && flow_constructor != null && reachable(node) == true && (flow_prior_event(node, "constructed") == true || flow_constructor.parent.extends.flow_constructor_heritage == false)
  warn if flow_prior_event(node, "constructed") == true then "Unexpected duplicate 'super()'." else "Unexpected 'super()' because 'super' is not a constructor."
}
in ts_this rule no-this-before-super {
  when flow_constructor != null && reachable(node) == true && flow_required(node, "constructed") == false
  warn "'this' is not allowed before 'super()'."
}
in ts_member, ts_index rule no-this-before-super:super {
  when object is ts_super && flow_constructor != null && reachable(node) == true && flow_required(node, "constructed") == false
  warn "'super' is not allowed before 'super()'."
}

# Disallow variable assignments when the value is not used
in ts_identifier rule no-useless-assignment {
  when declaration != null && declaration.exported != true && !problem_in_try
  when name_write_owner != null || is ts_declarator.name && parent.init != null
  when declaration.scoping_binding_execution_scope.id != null && declaration.scoping_binding_execution_scope.id == scoping_execution_scope.id
  when problem_assignment_expression == null || problem_assignment_expression.problem_expression_value_used != true
  when !declaration.problem_assignment_export_read && flow_has_reads(declaration.node) == true && flow_value_used(node) == false
  warn "The value assigned to '{text}' is not used in subsequent statements."
}

# ---- optional chaining where a short circuit throws -----------------------------
in ts_member, ts_index let in_optional_chain optional != null || object.in_optional_chain == true
in ts_call let in_optional_chain optional != null || callee.in_optional_chain == true
in ts_non_null let in_optional_chain expression.in_optional_chain == true
in ts_parenthesized let wraps_optional_chain expression.in_optional_chain == true || expression.wraps_optional_chain == true
# Each optional chain whose `undefined` the node would trip on, at the chain.
group optional_chain_user ts_assignment, ts_assignment_pattern, ts_declarator, ts_class, ts_call, ts_new, ts_member, ts_index, ts_tagged_template, ts_for_of, ts_spread, ts_binary, ts_with, ts_unary
in optional_chain_user let optional_chain_findings filter(optional_chain_risks, finding => !finding.arithmetic)
in optional_chain_user rule no-unsafe-optional-chaining {
  each r in optional_chain_findings
  report at r.offset
  warn if r.arithmetic then "Unsafe arithmetic operation on optional chaining. It can result in NaN." else "Unsafe usage of optional chaining. If it short-circuits with 'undefined' the evaluation will throw TypeError."
}

in ts_variable_declaration let declares_loop_variable parent is (ts_for_of, ts_for_in)

in ts_import rule no-unassigned-import {
  when default_import == null && namespace == null && count(specifier) == 0
  warn "Imported module should be assigned"
}

in ts_identifier rule no-unused-imports {
  when declaration_kind == "import" && uses == 0
  # TypeScript counts `{@link X}` in JSDoc as a use.
  when !{ value result: "\\x7B@link(?:code|plain)?\\s+" re_escape(text) "\\b"; value re_test(source, result) }
  warn "'{text}' is defined but never used."
}

# ---- regular expressions ---------------------------------------------------------
fn backreference_reason(kind) = (if kind == "nested" then "from within that group" else if kind == "forward" then "which appears later in the pattern" else if kind == "backward" then "which appears before in the same lookbehind" else if kind == "disjunctive" then "which is in another alternative" else "which is in a negative lookaround")
fn misleading_message(kind) = (if kind == "surrogatePairWithoutUFlag" then "Unexpected surrogate pair in character class. Use 'u' flag." else if kind == "surrogatePair" then "Unexpected surrogate pair in character class." else if kind == "combiningClass" then "Unexpected combined character in character class." else if kind == "emojiModifier" then "Unexpected modified Emoji in character class." else if kind == "regionalIndicatorSymbol" then "Unexpected national flag in character class." else "Unexpected joined character sequence in character class.")

in ts_regex rule no-empty-character-class {
  each f in regexp_empty_class_findings
  warn "Empty class."
}

# On literals, and on plain string patterns of `RegExp(...)` (at the string).
in regexp_site rule no-control-regex {
  each f in regexp_control_findings
  when is ts_regex || regexp_input.written == "string"
  report at regexp_input.offset
  warn "Unexpected control character(s) in regular expression: {first(f.data)}."
}

in regexp_site rule no-useless-backreference {
  each f in regexp_backreference_findings
  warn "Backreference '{first(f.data)}' will be ignored. It references group '{ { value f.data; slice 1; first } }'{last(f.data)} {backreference_reason(f.kind)}."
}

# Each sequence where it is written (or at the pattern when it is
# computed). With computed flags, nothing is known.
in regexp_site let misleading_character_class_findings regexp_misleading_findings
in regexp_site rule no-misleading-character-class {
  each f in misleading_character_class_findings
  when type_of(regexp_input.flags) == "str" || is ts_regex
  report at { start: f.offset, end: f.end }
  warn misleading_message(f.kind)
}

# Literals, and `RegExp` calls with a string literal pattern and flags.
in regexp_site rule no-regex-spaces {
  let spaces_argument if is (ts_call, ts_new) then { value argument.nodes; first; unparenthesised_node } else null
  let spaces_fixable is ts_regex || regexp_input.source == slice(spaces_argument.text, 1, -1)
  each f in regexp_space_findings
  when is ts_regex || regexp_input.written == "string" && type_of(regexp_flags) == "str"
  fix at { start: f.offset, end: f.end } if spaces_fixable as " {{{f.kind}}}"
  warn "Spaces are hard to count. Use {{{f.kind}}}."
}

# The flags first (`RegExp` checks them first), then the pattern.
in ts_call, ts_new rule no-invalid-regexp {
  option allowConstructorFlags string[] = [] "flags beyond the standard ones that are allowed"
  let flags_problem if regexp_flags == null then null else regex_flags_error(regexp_flags, allowConstructorFlags)
  when callee.global_value == "RegExp"
  when flags_problem != null || regexp_pattern_error != null
  warn "{ flags_problem.nonempty ?? regexp_pattern_error }."
}

# ---- whitespace and line breaks -------------------------------------------------
# Runs of irregular spaces, and each irregular line terminator. A BOM
# starting the file is not one.
group problem_template ts_template, ts_template_type
in ts_program layer text match problem_irregular_ws /[\u{000B}\u{000C}\u{0085}\u{00A0}\u{1680}\u{180E}\u{2000}-\u{200B}\u{202F}\u{205F}\u{3000}\u{FEFF}]+|[\u{2028}\u{2029}]/
in problem_irregular_ws let irregular_whitespace_checked { value overlapping(ts_string); count } == 0
in problem_irregular_ws rule no-irregular-whitespace {
  when !(offset == 0 && text == "\u{FEFF}")
  when irregular_whitespace_checked
  warn "Irregular whitespace not allowed."
}

# At the `(`, `[`, template or `/` on the new line.
in ts_call, ts_index, ts_tagged_template, ts_binary rule no-unexpected-multiline {
  let m unexpected_multiline
  when m != null
  report at m.offset
  warn if m.kind == "function" then "Unexpected newline between function and ( of function call."
    else if m.kind == "property" then "Unexpected newline between object and [ of property access."
    else if m.kind == "taggedTemplate" then "Unexpected newline between template tag and template literal."
    else "Unexpected newline between numerator and division operator."
}

# ---- strings and interfaces -----------------------------------------------

in ts_string rule no-template-curly-in-string warn "Unexpected template string expression." {
  when text ~ /.*\$\{[^}\r\n]+\}.*/
}


in ts_interface rule no-empty-interface warn "{if count(extends) > 0 then 'An interface declaring no members is equivalent to its supertype.' else 'An empty interface is equivalent to `{{}}`.'}" {
  when count(member) == 0
  # Several supertypes make a useful intersection.
  when count(extends) <= 1
  report at { start: opener.ts_open_brace.offset, end: closer.ts_close_brace.end_offset }
}

}
