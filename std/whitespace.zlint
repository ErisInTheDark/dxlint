# .whitespace: language-agnostic hygiene, brought by every language (through
# `.core`), all off. Overlays on `.*` run over the text of every declared
# language without hiding anything from other layers.

define {

over .* match trailing_whitespace /[ \t]+$/ {
  rule trailing-whitespace warn "no trailing whitespace" fix as ""
}

over .* match line_text /^[^\r\n]+/ {
  rule max-line-length warn "line is {len(text)} characters long (max {max})" {
    option max 120 "maximum line length, in characters"
    when len(text) > max
  }
}

over .* match tab_indent /^ *\t[ \t]*/ {
  rule tab-indent warn "indent with spaces, not tabs" {
    option width 4 "spaces per tab"
    fix as replace(text, "\t", repeat(" ", width))
  }
}

over .* match blank_run /\n(?:[ \t]*\r?\n){2,}/ {
  rule blank-lines warn "at most {max} blank lines in a row" {
    option max 2 "blank lines allowed in a row"
    when len(split(text, "\n")) - 2 > max
    fix as "\n" repeat("\n", max)
  }
}

over .* match file_end /[^\n]\z|\n(?:\r?\n)+\z/ {
  rule final-newline warn "files end with exactly one newline" fix as if ends_with(text, "\n") then "\n" else text "\n"
}

}
