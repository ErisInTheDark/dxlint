# .ts: JavaScript and TypeScript, two ways.
# - zlint's native parser: every node kind is a `ts_*` layer with
#   ESTree-style fields (`ts_if.test`, `ts_call.callee`,
#   `ts_binary.operator`); `zlint tree file.ts` shows them. Files are only
#   parsed this way when a rule targets a `ts_*` layer.
# - `js_*` text layers: brackets, strings, template literals (whose `${...}`
#   holes are code again), comments and regex literals, found by regexes.
#   `js_code` names every layer that holds code.
#
# Brings every JS/TS rule definition, all off: turn on what you want with
# `rule name` lines, or a ruleset (`import rules:recommended`).

import .core

lang js "*.js" "*.mjs" "*.cjs" "*.jsx" "*.ts" "*.tsx" "*.mts" "*.cts"

group js_code .js, parentheses, brackets, braces, js_interpolation

in js_code {
  match parentheses
  match brackets
  match braces

  match js_line_comment /\/\// until /$/
  match js_block_comment /\/\*/ until /\*\//

  match js_string /"/ until /"|$/
  match js_single_string /'/ until /'|$/
  match js_template /`/ until /`/ {
    match js_interpolation /\$\{/ until /\}/
  }
}
in js_string, js_single_string, js_template match js_escape /\\(?:\r\n|.|\n)/

# A `/` starts a regex literal only where an expression can start: after an
# operator, an opening bracket, or a keyword like `return`. Everywhere else
# it is division.
in js_code match js_regex (
  /(?<=(?:^|[=(,:;!&|?{}\[+\-*%<>~^]|\b(?:return|typeof|case|do|else|in|of|new|delete|void|throw|yield|await))[ \t]*)/
  /\/(?![*\/])/ until /\/[dgimsuyv]*|$/
) {
  match js_regex_class /\[/ until /\]|$/
}
in js_regex, js_regex_class match js_regex_escape /\\./

native ts

group ts_function_like ts_function, ts_arrow, ts_method
group ts_loop ts_for, ts_for_in, ts_for_of, ts_while, ts_do_while
# Every layer that can be a statement. `ts_function` and `ts_class` are also
# expressions (`const f = function () {}`): check the parent when it matters.
group ts_statement ts_expression_statement, ts_variable_declaration, ts_return, ts_throw, ts_break,
  ts_continue, ts_if, ts_switch, ts_try, ts_block, ts_labeled, ts_empty, ts_debugger, ts_with, ts_loop,
  ts_function, ts_class, ts_export, ts_import, ts_import_equals, ts_export_assignment, ts_type_alias,
  ts_interface, ts_enum, ts_namespace
# Tokens: punctuation and keywords, under the node that owns them (field
# `token`). Files get them only when a rule targets one.
# A node's own brackets: `opener.x` / `closer.x` read its first opener and
# last closer.
group opener ts_open_paren, ts_open_bracket, ts_open_brace, ts_open_angle
group closer ts_close_paren, ts_close_bracket, ts_close_brace, ts_close_angle
group ts_token ts_comma, ts_semicolon, ts_colon, ts_dot, ts_question, ts_ellipsis, ts_equals, opener,
  closer, ts_keyword, ts_punctuator

import .ts/format
import .ts/license
import .ts/scopes
import .ts/problems
import .ts/style
import .ts/typed
import .ts/layout
import .ts/structure
import .ts/scoping
import .ts/suggestions
import .ts/restrictions
import .ts/jsx
