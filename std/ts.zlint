# .ts: JavaScript and TypeScript. zlint's native parser owns the syntax:
# every node kind is a `ts_*` layer with ESTree-style fields (`ts_if.test`,
# `ts_call.callee`, `ts_binary.operator`); `zlint tree file.ts` shows them.
# Textual parts (comments, lines) are pattern layers in the same tree.
#
# Brings every JS/TS rule definition, all off: turn on what you want with
# `rule name` lines, or a ruleset (`import rules:recommended`).

import .core

lang js "*.js" "*.mjs" "*.cjs" "*.jsx" "*.ts" "*.tsx" "*.mts" "*.cts"

native ts

group ts_function_like ts_function, ts_arrow, ts_method
group ts_loop ts_for, ts_for_in, ts_for_of, ts_while, ts_do_while
# Every layer that can be a statement. `ts_function` and `ts_class` are also
# expressions (`const f = function () {}`): check the parent when it matters.
group ts_statement ts_expression_statement, ts_variable_declaration, ts_return, ts_throw, ts_break,
  ts_continue, ts_if, ts_switch, ts_try, ts_block, ts_labeled, ts_empty, ts_debugger, ts_with, ts_loop,
  ts_function, ts_class, ts_export, ts_import, ts_import_equals, ts_export_assignment, ts_type_alias,
  ts_interface, ts_enum, ts_namespace
# Tokens: punctuation and keywords, under the node that owns them (field
# `token`). Files get them only when a rule targets one.
# A node's own brackets: `opener.x` / `closer.x` read its first opener and
# last closer.
group opener ts_open_paren, ts_open_bracket, ts_open_brace, ts_open_angle
group closer ts_close_paren, ts_close_bracket, ts_close_brace, ts_close_angle
group ts_token ts_comma, ts_semicolon, ts_colon, ts_dot, ts_question, ts_ellipsis, ts_equals, opener,
  closer, ts_keyword, ts_punctuator
define {
  # Comments: children of the code layer whose text they sit in (between
  # its other children, so never inside a string, regex or template text).
  in ts_code {
    match ts_line_comment /\/\/[^\n\r\u{2028}\u{2029}]*/
    match ts_block_comment /\/\*/ until /\*\//
  }
  # Each line, its line break included (the last may have none): over the
  # file, across whatever nodes it runs through.
  in .js layer lines match ts_line /[^\n\r\u{2028}\u{2029}]*(?:\r\n|[\n\r\u{2028}\u{2029}])|[^\n\r\u{2028}\u{2029}]+/
}
group ts_comment ts_line_comment, ts_block_comment

import .ts/format
import .ts/license
import .ts/scopes
import .ts/problems
import .ts/style
import .ts/typed
import .ts/conditions
import .ts/assertions
import .ts/enums
import .ts/layout
import .ts/indentation
import .ts/structure
import .ts/scoping
import .ts/suggestions
import .ts/restrictions
import .ts/jsx
