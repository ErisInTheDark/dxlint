# .whitespace: language-agnostic hygiene, brought by every language (through
# `.core`), all off. Overlays on `.*` run over the text of every declared
# language without hiding anything from other layers.

define {

in .* layer text match trailing_whitespace /[ \t]+$/ {
  rule shared-trailing-whitespace warn "no trailing whitespace" fix as ""
}

in .* layer text match line_text /^[^\r\n]+/ {
  rule shared-max-line-length warn "line is {len(text)} characters long (max {max})" {
    default option max int(1..) = 120 "maximum line length, in characters"
    when len(text) > max
  }
}

in .* layer text match tab_indent /^ *\t[ \t]*/ {
  rule shared-tab-indent warn "indent with spaces, not tabs" {
    option width int(1..) = 4 "spaces per tab"
    fix as { value " "; repeat: repeat width; value replace(text, "\t", repeat) }
  }
}

in .* layer text match blank_run /\n(?:[ \t]*\r?\n){2,}/ {
  rule shared-blank-lines warn "at most {max} blank lines in a row" {
    default option max int(0..) = 2 "blank lines allowed in a row"
    when { value text; split "\n"; len } - 2 > max
    fix as "\n" repeat("\n", max)
  }
}

in .* layer text match file_end /[^\n]\z|\n(?:\r?\n)+\z/ {
  rule shared-final-newline warn "files end with exactly one newline" fix as if ends_with(text, "\n") then "\n" else text "\n"
}

}
