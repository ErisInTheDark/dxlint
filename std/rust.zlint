# std/rust: Rust's structure. Strings, chars and comments are layers, so
# brackets, quotes and comments inside them never confuse anything else.

import "std/core"

lang rust "*.rs" {
  match parentheses
  match brackets
  match braces
}

group rs_code .rust, parentheses, brackets, braces

in rs_code {
  match rs_line_comment /\/\// until /$/
  match rs_block_comment /\/\*/ until /\*\// {
    match rs_block_comment
  }

  match rs_string /(?:\bb)?"/ until /"/ {
    match rs_escape /\\(?:.|\n)/
  }

  # Raw strings cannot escape anything, so they have no children.
  match rs_raw_string /\bb?r"/ until /"/
  match rs_raw_string_hash /\bb?r#"/ until /"#/
  match rs_raw_string_double_hash /\bb?r##"/ until /"##/

  # 'a' and '\n' are chars; 'a on its own is a lifetime and stays code.
  match rs_char /(?:\bb)?'(?:\\(?:u\{[0-9a-fA-F]{1,6}\}|x[0-9a-fA-F]{2}|.)|[^\\'\n])'/
}
