# std/zlint: the structure of .zlint files themselves, so zlint can lint
# its own rules.

import "std/core"

lang zlint "*.zlint" {
  match parentheses
  match brackets
  match braces
}

group zlint_code .zlint, parentheses, brackets, braces

in zlint_code {
  match zlint_comment /#/ until /$/
  # Longer than `""` at the same spot, so it wins.
  match zlint_block_string /"""/ until /"""/
  match zlint_string /"/ until /"/
  match zlint_single_string /'/ until /'/
}
in zlint_string, zlint_single_string, zlint_block_string match zlint_escape /\\(?:.|\n)/

# Regex literals: `/` never means division in zlint.
in zlint_code match zlint_regex /\// until /\/|$/ {
  match zlint_regex_escape /\\./
  match zlint_regex_class /\[/ until /\]/ {
    match zlint_regex_escape
  }
}
