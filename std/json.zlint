# .json: JSON/JSONC values, nested lists and comments.

import .core

lang json "*.json" "*.jsonc" {
  match json_value
  match json_line_comment
  match json_block_comment
}

define {
  match json_line_comment like core_line_comment @core_line_comment_pattern
  match json_block_comment like core_block_comment @core_block_comment_pattern
  match json_string /"/ until /"/
  in json_string match json_escape /\\[\s\S]/
  match json_number /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?/
  match json_keyword /\b(?:true|false|null)\b/
  match json_trivia (space or json_line_comment or json_block_comment)+
  match json_value (:json_object or :json_array or :json_string or :json_number or :json_keyword)
  match json_property key:json_string json_trivia? /:/ json_trivia? value:json_value
  match json_object /\{/ until /\}/
  match json_array /\[/ until /\]/
  in json_object {
    match json_property
    match json_comma /,/
    match json_line_comment
    match json_block_comment
  }
  in json_array {
    match json_value
    match json_comma
    match json_line_comment
    match json_block_comment
  }

  group json_list json_object, json_array
  group core_list json_list
  group json_comment json_line_comment, json_block_comment
  fn json_edge(value, tail) = {
    start: if tail && contains(["[", "{{"], slice(value.text, 0, 1)) then value.end_offset - 1 else value.offset,
    end: if !tail && contains(["[", "{{"], slice(value.text, 0, 1)) then value.offset + 1 else value.end_offset,
    text: if contains(["[", "{{"], slice(value.text, 0, 1)) then (if tail then slice(value.text, len(value.text) - 1) else slice(value.text, 0, 1)) else value.text,
    comment: false,
  }
  in json_property let json_child_edges [json_edge(key.node, false), json_edge(value.node, true)]
  in json_value let json_child_edges [json_edge(node, false), json_edge(node, true)]
  in json_comma, json_comment let json_child_edges [{ start: offset, end: end_offset, text: text, comment: is json_comment }]
  fn json_gap_parts(source, from, to, comments) = reduce(filter(comments, comment => comment.offset >= from && comment.end_offset <= to), { cursor: from, text: "" }, (state, comment) => {
    cursor: comment.end_offset, text: state.text byte_slice(source, state.cursor, comment.offset),
  })
  fn json_gap_text(source, to, parts) = parts.text byte_slice(source, parts.cursor, to)
  fn json_layout_site(source, context, mode, before, after, comments) = {
    kind: context.kind, brackets: context.brackets, count: context.count,
    single: context.single, node_single: context.single,
    first_broken: context.first_broken, empty_comments: context.empty_comments,
    mode: mode, offset: before.end, prev: before.text, next: after.text,
    spaced: re_test(json_gap_text(source, after.start, json_gap_parts(source, before.end, after.start, comments)), /\s/),
    broken: re_test(byte_slice(source, before.end, after.start), /[\n\r\u{2028}\u{2029}]/),
  }
  in json_list let json_items filter(children.node, child => child is (json_property, json_value))
  in json_list let json_edges reduce(children.node, [], (edges, child) => edges child.json_child_edges)
  in json_list let json_plain filter(json_edges, edge => !edge.comment)
  in json_list let json_open { start: offset, end: offset + 1, text: slice(text, 0, 1) }
  in json_list let json_close { start: end_offset - 1, end: end_offset, text: slice(text, len(text) - 1) }
  in json_list let json_first default(first(json_edges), json_close)
  in json_list let json_last default(last(json_edges), json_open)
  in json_list let json_layout_context {
    kind: if is json_object then "JSONObjectExpression" else "JSONArrayExpression",
    brackets: if is json_object then "{{}}" else "[]",
    count: count(json_items), single: !re_test(text, /[\n\r\u{2028}\u{2029}]/),
    first_broken: count(json_items) > 0 && re_test(byte_slice(source, offset + 1, first(json_items).offset), /[\n\r\u{2028}\u{2029}]/),
    empty_comments: count(json_edges) > 0,
  }
  in json_list let json_spacing_pairs [[json_open, json_first]] (if count(json_edges) == 0 then [] else [[json_last, json_close]])
  in json_list let json_wrapping_pairs ([[json_open, default(first(json_plain), json_close)]]
    map(slice(json_items, 1), item => [last(filter(json_plain, edge => edge.end <= item.offset)), json_edge(if item is json_property then item.key.node else item, false)])
    [[default(last(json_plain), json_open), json_close]])
  in json_list let json_layout_comments descendants(json_comment)
  in json_list let core_list_layout (
    map(json_spacing_pairs, pair => json_layout_site(source, json_layout_context, "spacing", first(pair), last(pair), json_layout_comments))
    map(json_wrapping_pairs, pair => json_layout_site(source, json_layout_context, "wrapping", first(pair), last(pair), json_layout_comments))
    map(json_spacing_pairs, pair => json_layout_site(source, json_layout_context, "empty_wrapping", first(pair), last(pair), json_layout_comments)))
}
