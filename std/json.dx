# .json: JSON/JSONC values, nested lists and comments.

import .core

lang json "*.json" "*.jsonc" {
  match json_value
  match json_line_comment
  match json_block_comment
}

define {
  match json_line_comment like core_line_comment @core_line_comment_pattern
  match json_block_comment like core_block_comment @core_block_comment_pattern
  match json_string /"/ until /"/
  in json_string match json_escape /\\[\s\S]/
  match json_number /-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?/
  match json_keyword /\b(?:true|false|null)\b/
  match json_trivia (space or json_line_comment or json_block_comment)+
  match json_value (:json_object or :json_array or :json_string or :json_number or :json_keyword)
  match json_property key:json_string json_trivia? /:/ json_trivia? value:json_value
  match json_object /\{/ until /\}/
  match json_array /\[/ until /\]/
  in json_object {
    match json_property
    match json_comma /,/
    match json_line_comment
    match json_block_comment
  }
  in json_array {
    match json_value
    match json_comma
    match json_line_comment
    match json_block_comment
  }

  group json_list json_object, json_array
  group core_list json_list
  group json_comment json_line_comment, json_block_comment
  fn json_edge(item, tail) = {
    value head: slice(item.text, 0, 1)
    value bracketed: contains(["[", "{{"], head)
    value {
      start: if tail && bracketed then item.end_offset - 1 else item.offset,
      end: if !tail && bracketed then item.offset + 1 else item.end_offset,
      text: if !bracketed then item.text else if !tail then head else {
        value tail_start: len(item.text) - 1
        value item.text
        slice tail_start
      },
      comment: false,
    }
  }
  in json_property let json_child_edges [json_edge(key.node, false), json_edge(value.node, true)]
  in json_value let json_child_edges [json_edge(node, false), json_edge(node, true)]
  in json_comma, json_comment let json_child_edges [{ start: offset, end: end_offset, text: text, comment: is json_comment }]
  in json_list let json_items filter(children.node, child => child is (json_property, json_value))
  in json_list let json_edges { value children.node; fold ([]) (edges, child) edges child.json_child_edges }
  in json_list let json_plain filter(json_edges, edge => !edge.comment)
  in json_list let json_open { start: offset, end: offset + 1, text: slice(text, 0, 1) }
  in json_list let json_close { start: end_offset - 1, end: end_offset, text: { value result: len(text) - 1; value slice(text, result) } }
  in json_list let json_first { value json_edges; first; nonempty } ?? json_close
  in json_list let json_last { value json_edges; last; nonempty } ?? json_open
  in json_list let json_layout_context {
    kind: if is json_object then "JSONObjectExpression" else "JSONArrayExpression",
    brackets: if is json_object then "{{}}" else "[]",
    count: count(json_items), single: !re_test(text, /[\n\r\u{2028}\u{2029}]/),
    first_broken: count(json_items) > 0 && {
      value offset_2: first(json_items).offset
      value byte_slice(source, offset + 1, offset_2)
      re_test /[\n\r\u{2028}\u{2029}]/
    },
    empty_comments: count(json_edges) > 0,
  }
  in json_list let json_spacing_pairs [[json_open, json_first]] (if count(json_edges) == 0 then [] else [[json_last, json_close]])
  in json_list let json_wrapping_pairs ([[json_open, { value json_plain; first; nonempty } ?? json_close]]
    {
      value json_items
      slice 1
      map (item) [{ value json_plain; filter (edge) edge.end <= item.offset; last }, { value if item is json_property then item.key.node else item; json_edge false }]
    }
    [[{ value json_plain; last; nonempty } ?? json_open, json_close]])
  in json_list let json_layout_comments descendants(json_comment)
  in json_list let core_list_layout (
    map(json_spacing_pairs, pair => {
      value pair
      before: first
      value pair
      after: last
      value core_list_site(source, json_layout_context, "spacing", before, after, json_layout_comments)
    })
    (if json_layout_context.count > 0 then map(json_wrapping_pairs, pair => {
      value pair
      before_2: first
      value pair
      after_2: last
      value core_list_site(source, json_layout_context, "wrapping", before_2, after_2, json_layout_comments)
    }) else map(json_spacing_pairs, pair => {
      value pair
      before_3: first
      value pair
      after_3: last
      value core_list_site(source, json_layout_context, "empty_wrapping", before_3, after_3, json_layout_comments)
    })))
}
