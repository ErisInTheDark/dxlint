# .js/flow: control flow, operators and statement layout, modelled on
# eslint's rules. Imported by .js/format (uses its statement layer and
# macros).

define {

# ---- control flow ----------------------------------------------------------
# curly, new-parens, no-constant-condition and semi:always live in
# .ts/problems, on the native layers.

# Binary operators start the continuation line, assignments end the first.
in js_code match js_operator_line_end /(?:&&|\|\||\?\?|===?|!==?|<=|>=|(?<!\+)\+(?!\+)|(?<!-)-(?![-=])|[*%\/]|\binstanceof|\bin|(?<![|&])[|&](?![|&=]))(?=[ \t]*(?:\/\/[^\r\n]*)?\r?\n)/
in js_operator_line_end rule operator-linebreak:before warn "'{text}' should be placed at the beginning of the line." {
  option style "before" | "none" = "before"
  when style == "before"
}

# ---- statement padding (padding-line-between-statements) --------------------

macro statement_head trim_start(text)
macro starts(re) re_test(trim_start(text), re)
macro previous_starts(re) re_test(trim_start(previous_sibling), re)
macro previous_code re_replace(previous_sibling, /[ \t]+\/\/[^\r\n]*$|[ \t]+$/, "")
macro previous_multiline re_test(trim(previous_sibling), /\n/)
macro previous_declaration previous_starts(/^(?:const|let|var)\b/)
macro next_declaration starts(/^(?:const|let|var)\b/)
macro next_control starts(/^(?:if|switch|for|do|while)\b/)
macro previous_control previous_starts(/^(?:if|switch|for|do|while|break|continue|throw)\b/)
# Block-like: the last `}` closes a code block or a switch, not a class,
# interface, enum, namespace or object.
macro previous_block_like (ends_with(previous_code, "}}") && !previous_starts(/^(?:export[ \t]+(?:default[ \t]+)?)?(?:declare[ \t]+)?(?:abstract[ \t]+)?(?:const|let|var|type|return|throw|class|interface|enum|namespace|module|global)\b|^[\w$.#\[\]'"]+[ \t]*(?:[+\-*\/%&|^]|\?\?|&&|\|\|)?=[^=>]/))
# `if (x)⏎ body`: the statement after an unbraced header is its body.
macro previous_unbraced_header re_test(previous_sibling, /^\s*(?:\}\s*)?(?:else\s+)?(?:if|while|for)\b[\s\S]*\)\s*$|^\s*(?:\}\s*)?else\s*$/)
macro previous_expression !previous_starts(/^(?:if|switch|for|do|while|break|continue|throw|return|const|let|var|type|import|export|function|async[ \t]+function|class|abstract|interface|enum|namespace|module|declare|try|\{)\b/)

# The last matching configuration wins, like eslint.
macro padding_always (
  if previous_declaration && next_control then false
  else if next_control then true
  else if previous_declaration && !previous_multiline && next_declaration then false
  else if next_declaration then true
  else if previous_multiline && (previous_declaration || previous_expression) then true
  else if previous_control || previous_block_like then true
  else false
)

in js_statement rule padding-line-between-statements warn "Expected blank line before this statement." {
  # eslint's core rule never looks inside class or namespace bodies.
  when previous_sibling != null && parent != "js_class_body" && parent != "js_namespace_body" && parent != "js_global_body" && !previous_unbraced_header
  when !re_test(previous_gap, /\n[ \t]*\r?\n/) && !re_test(previous_gap, /\b(?:case|default)\b/)
  when padding_always
  fix as newline text
}

}
