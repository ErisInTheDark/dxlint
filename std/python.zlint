# std/python: Python structure. Triple-quoted strings win over plain ones
# because the longest match at a position wins.

import "std/core"

lang python "*.py" or "*.pyi" {
  match paren
  match brack
  match brace
}

group py_code .python or paren or brack or brace

in py_code {
  match py_comment /#/ until /$/
  match py_string3 /(?:\b[rRbBuUfF]{1,2})?"""/ until /"""/
  match py_sstring3 /(?:\b[rRbBuUfF]{1,2})?'''/ until /'''/
  match py_string /(?:\b[rRbBuUfF]{1,2})?"/ until /"|$/
  match py_sstring /(?:\b[rRbBuUfF]{1,2})?'/ until /'|$/
}
in py_string or py_sstring or py_string3 or py_sstring3 match py_escape /\\(?:.|\n)/
