# std/python: Python structure. Triple-quoted strings win over plain ones
# because the longest match at a position wins.

import "std/core"

lang python "*.py" "*.pyi" {
  match parentheses
  match brackets
  match braces
}

group py_code .python, parentheses, brackets, braces

in py_code {
  match py_comment /#/ until /$/
  match py_triple_string /(?:\b[rRbBuUfF]{1,2})?"""/ until /"""/
  match py_triple_single_string /(?:\b[rRbBuUfF]{1,2})?'''/ until /'''/
  match py_string /(?:\b[rRbBuUfF]{1,2})?"/ until /"|$/
  match py_single_string /(?:\b[rRbBuUfF]{1,2})?'/ until /'|$/
}
in py_string, py_single_string, py_triple_string, py_triple_single_string match py_escape /\\(?:.|\n)/
