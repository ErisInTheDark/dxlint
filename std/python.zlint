# std/python: Python structure. Triple-quoted strings win over plain ones
# because the longest match at a position wins.

import "std/core"

lang python = "*.py" | "*.pyi"

in .python match paren
in .python match brack
in .python match brace

group py_code = .python | paren | brack | brace

in py_code match py_comment = /#/ * /$/
in py_code match py_string3 = /(?:\b[rRbBuUfF]{1,2})?"""/ * /"""/
in py_code match py_sstring3 = /(?:\b[rRbBuUfF]{1,2})?'''/ * /'''/
in py_code match py_string = /(?:\b[rRbBuUfF]{1,2})?"/ * /"|$/
in py_code match py_sstring = /(?:\b[rRbBuUfF]{1,2})?'/ * /'|$/
in py_string | py_sstring | py_string3 | py_sstring3 match py_escape = /\\(?:.|\n)/
