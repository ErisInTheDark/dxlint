# std/toml: TOML structure.

import "std/core"

lang toml "*.toml" {
  match brack
  match brace
}

group toml_code .toml or brack or brace

in toml_code {
  match toml_comment /#/ until /$/
  match toml_string3 /"""/ until /"""/
  match toml_literal3 /'''/ until /'''/
  match toml_string /"/ until /"|$/
  match toml_literal /'/ until /'|$/
}
in toml_string or toml_string3 match toml_escape /\\(?:.|\n)/
