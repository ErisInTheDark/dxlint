# std/toml: TOML structure.

import .core

lang toml "*.toml" {
  match brackets
  match braces
}

group toml_code .toml, brackets, braces

in toml_code {
  match toml_comment /#/ until /$/
  match toml_multiline_string /"""/ until /"""/
  match toml_multiline_literal /'''/ until /'''/
  match toml_string /"/ until /"|$/
  match toml_literal /'/ until /'|$/
}
in toml_string, toml_multiline_string match toml_escape /\\(?:.|\n)/
