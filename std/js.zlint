# std/js: JavaScript and TypeScript structure, including template
# literals whose `${...}` holes are code again.

import "std/core"

lang js = "*.js" | "*.mjs" | "*.cjs" | "*.jsx" | "*.ts" | "*.tsx" | "*.mts" | "*.cts"

in .js | js_interp match paren
in .js | js_interp match brack
in .js | js_interp match brace

macro js_code = .js | paren | brack | brace | js_interp

in js_code match js_line_comment = /\/\// * /$/
in js_code match js_block_comment = /\/\*/ * /\*\//

in js_code match js_string = /"/ * /"|$/
in js_code match js_sstring = /'/ * /'|$/
in js_code match js_template = /`/ * /`/
in js_template match js_interp = /\$\{/ * /\}/
in js_string | js_sstring | js_template match js_escape = /\\(?:.|\n)/
