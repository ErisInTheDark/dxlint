# std/js: JavaScript and TypeScript structure: brackets, strings, template
# literals (whose `${...}` holes are code again), comments and regex
# literals. `js_code` names every layer that holds code.

import "std/core"

lang js "*.js" or "*.mjs" or "*.cjs" or "*.jsx" or "*.ts" or "*.tsx" or "*.mts" or "*.cts"

group js_code .js or paren or brack or brace or js_interp

in js_code {
  match paren
  match brack
  match brace

  match js_line_comment /\/\// until /$/
  match js_block_comment /\/\*/ until /\*\//

  match js_string /"/ until /"|$/
  match js_sstring /'/ until /'|$/
  match js_template /`/ until /`/ {
    match js_interp /\$\{/ until /\}/
  }
}
in js_string or js_sstring or js_template match js_escape /\\(?:\r\n|.|\n)/

# A `/` starts a regex literal only where an expression can start: after an
# operator, an opening bracket, or a keyword like `return`. Everywhere else
# it is division.
in js_code match js_regex (
  /(?<=(?:^|[=(,:;!&|?{}\[+\-*%<>~^]|\b(?:return|typeof|case|do|else|in|of|new|delete|void|throw|yield|await))[ \t]*)/
  /\/(?![*\/])/ until /\/[dgimsuyv]*|$/
) {
  match js_regex_class /\[/ until /\]|$/
}
in js_regex or js_regex_class match js_regex_escape /\\./
