# dxlint lints itself with this file.

import .rs
import .dx
import .md
import .toml

# Examples are deliberately broken; they have their own configs.
ignore "examples"
ignore "fixtures"

# Hygiene everywhere, except the rule pages showing what these rules report.
# Long lines are a judgement call here, not a rule.
rule shared-trailing-whitespace
rule shared-tab-indent
rule shared-blank-lines
rule shared-final-newline
files "docs/rules/**" {
  rule shared-trailing-whitespace off
  rule shared-tab-indent off
  rule shared-blank-lines off
}

# ---- rust ---------------------------------------------------------------

in rs_code {
  match rs_dbg /\bdbg!/ {
    rule no-dbg error "remove `dbg!` before committing"
  }
  match rs_unfinished /\b(?:todo|unimplemented)!/ {
    rule no-unfinished error "`{text}` panics at runtime; finish this code"
  }
}

# Test modules are a layer, so rules can ask whether they are inside one.
in .rust, braces match rs_test_module /#\[cfg\(test\)\]\s*mod\s+\w+\s*/ body:braces
in rs_code match rs_unwrap /\.unwrap\(\)/ {
  rule no-unwrap {
    when rs_test_module == null
    warn "`.unwrap()` outside tests; use `?` or `.expect(\"why\")`"
    ignore "tests.rs" "*_tests.rs" "tests/**"
  }
}

# `.dxcache` reuses a result while everything its lint read is unchanged,
# so native code must read the filesystem through the one door that records it.
in rs_code match rs_filesystem /\bstd::fs\b|\bfs::\w+|\.(?:is_file|is_dir|exists|metadata)\(\)|\bread_dir\b|\bWalkBuilder\b/ {
  rule native-reads-through-door error "native code reads the filesystem through `engine/reads.rs`, which records the read for the cache" {
    files "src/native/**"
    # These tests write fixture files to disk.
    ignore "src/native/ts/reads.rs" "src/native/ts/tests.rs"
  }
}

# Front ends plug into the engine through `engine/frontend.rs`; only
# `lib.rs` names them (`FRONTENDS`). Tests may use the real ones.
in rs_code match rs_front_end_path /\bnative::(?:ts\b|\{)/ {
  rule engine-names-no-front-end error "the engine reaches front ends only through `engine/frontend.rs`; list them in `FRONTENDS` (lib.rs)" {
    when rs_test_module == null
    ignore "src/native/**" "src/lib.rs" "tests.rs" "tests/**"
  }
}

# Foreign functions keep the name their library exports.
in .rust, braces match rs_extern_block /\bextern[ \t]+"[^"]*"\s*/ body:braces
in rs_code match rs_function /\bfn[ \t]+/ name:identifier
in rs_function.name rule fn-snake-case warn "function names are snake_case" fix as snake_case(text) {
  when rs_extern_block == null
}

in rs_line_comment, rs_block_comment match todo_note /\b(?:TODO|FIXME|XXX)\b/ {
  rule todo-comment info "{text} left in a comment"
}

# ---- dxlint --------------------------------------------------------------

in dx_code {
  # Globs (`rule rs-*`) are not names.
  match dx_rule /\brule[ \t]+/ name:/[\w-]+(?![\w*-])/
  match dx_matcher /\bmatch[ \t]+/ name:/\w+/
}
in dx_rule.name rule rule-names warn "rule names are kebab-case" fix as kebab_case(text)
in dx_matcher.name rule matcher-names warn "matcher names are snake_case" fix as snake_case(text)
