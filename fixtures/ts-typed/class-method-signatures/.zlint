import .ts

in ts_call rule method-signatures {
  when callee is ts_member && contains(["pick", "plain"], callee.property.text)
  let headers { value value_signatures(callee.node) ?? []; flat_map (arm) arm }
  report at callee.property.node
  info "{ count(headers) }/{ count(call_binding(node).choices) }"
}
rule method-signatures
