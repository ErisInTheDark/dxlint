import .ts
rule switch-exhaustiveness-check
in ts_index rule index-value-contract {
  when contains(["arrayRead", "recordRead", "namedRead", "fixedRead", "optionalRead",
    "dynamicRead", "variadicRead", "dynamicRecordRead", "unionRead"], parent.name.text)
  let parts value_constituents(node)
  let actual parts != null && any(parts, arm => any(arm, part => contains(part.traits, "undefined")))
  let expected parent.name.text == "optionalRead"
    || ts_compiler_option(node, "noUncheckedIndexedAccess") == true
      && contains(["arrayRead", "recordRead", "dynamicRead", "variadicRead", "dynamicRecordRead"], parent.name.text)
  when parts == null || actual != expected
  warn "index value contract failed"
}
in ts_index rule index-origin-contract {
  when contains(["arrayRead", "recordRead", "namedRead", "fixedRead", "optionalRead",
    "dynamicRead", "variadicRead", "dynamicRecordRead"], parent.name.text)
  let indexed contains(["arrayRead", "recordRead", "dynamicRead", "variadicRead", "dynamicRecordRead"], parent.name.text)
  when condition_access(node).from_index != indexed
  warn "index origin contract failed"
}
