import .ts
in ts_comma rule context {
  let list layout_comma_context(node)
  when list.owner is ts_call
  let previous list.previous
  warn "{list.field}:{previous.text}"
}
in ts_comma rule holes {
  let list layout_comma_context(node)
  when list.owner is ts_array
  let previous list.previous
  warn if previous == null then "absent" else previous.text
}
