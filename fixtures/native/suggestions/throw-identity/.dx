import .ts
in ts_throw rule probe {
  let caught catch_throw
  each property in (last(caught.arguments).property.nodes ?? [])
  when property is ts_spread || {
    value operand: caught_throw_property_value(property)
    value property.static_name == "cause" && operand is ts_identifier && operand.text == get(caught, "parameter").text && operand.declaration.node != get(caught, "parameter")
  }
  report at property.offset
  warn "binding"
}
