
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


            in .t match pair /\w+ +\w+/
            in pair rule one-space warn "x" {
              report change
              fix as re_replace(text, / +/, " ")
            }
