
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        match snake /[a-z_][a-z0-9_]*/
        in .t match word /\w+/ {
          rule not-snake warn "x" { when !(text ~ snake) }
          rule has-digit warn "y" { when text ~ /.*\d.*/ }
        }
