
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t match word /\b[a-z]+\b/ {
          rule j warn "{text len(text) null '!'}|{join([text] ['b'] 'c', '-')}|{len(text) + 1}"
        }
