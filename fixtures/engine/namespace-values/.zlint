import .ts

fn namespace_scalar(n, expected) = {
  value parts: value_constituents(n)
  value parts != null && len(parts) > 0 && all(parts, arm => any(arm, part =>
    part.identity_known && part.identity.kind == "value" && part.identity.value == expected))
}
in ts_identifier rule namespace-runtime {
  when text == "NS" && is ts_member.object
  when !(node always object) || !(node always truthy)
    || value_has_member(node, "present") != true
    || value_has_member(node, "privateName") != false
    || value_has_member(node, "TypeOnly") != false
    || value_has_member(node, "missing") != false
  warn "a module namespace lost published values or exposed private/type-only names"
}
in ts_member rule selected-value {
  when text == "NS.present" && !namespace_scalar(node, 1)
    || text == "NS.Nested.leaf" && !namespace_scalar(node, "ok")
    || text == "NS.E.Zero" && !namespace_scalar(node, 0)
  warn "a selected namespace value lost its real source value"
}
in ts_member rule nested-visibility {
  when text == "NS.Nested"
  when value_has_member(node, "leaf") != true || value_has_member(node, "hidden") != false
  warn "a nested namespace exposed a private declaration"
}
in ts_identifier rule incomplete-publication {
  when text == "Missing" && is ts_member.object
  when value_has_member(node, "present") != null
  warn "an unresolved namespace pretended its exports were known"
}
in ts_index rule dynamic-publication {
  when object == "NS"
  when value_has_member(object.node, index.node) != null
  warn "a dynamic namespace key pretended its export presence was known"
}
in ts_type_reference rule qualified-type-selection {
  when name == "NS.E.One" && !namespace_scalar(node, 1)
    || name == "NS.Nested.Inner.Zero" && !namespace_scalar(node, 0)
    || name == "Alias.One" && !namespace_scalar(node, 1)
    || name == "NS.E.Text" && !namespace_scalar(node, "merged")
    || name == "NS.Box" && !namespace_scalar(node, "box")
  warn "a qualified type lost its selected declaration or bound argument"
}
in ts_type_reference rule namespace-enum-type {
  when name == "NS.E"
  when !(node could number) || !(node always enum)
  warn "a namespace enum type lost its member union"
}
in ts_type_query rule namespace-enum-query {
  when name == "NS.E"
  when !(node always object) || !(node always truthy) || node could enum
  warn "a namespace enum query selected a type instead of its runtime object"
}
in ts_identifier rule empty-namespace-binding {
  when text == "Empty" && is ts_declarator.init
  when declaration_kind != null || reference_kind != "namespace" || value_constituents(node) != null
  warn "an empty namespace lost its binding or invented a runtime value"
}
