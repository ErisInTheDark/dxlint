
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        lang u "*.u"
        in .u, paren match ustr /'/ until /'/
        in .t, .u match word /\bword\b/ {
          rule w warn "word"
        }
