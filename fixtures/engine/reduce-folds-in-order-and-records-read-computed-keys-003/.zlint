
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}

in .t match word /[a-z0-9]+/ { rule c info "{js_compare('10', '9')}/{js_compare(10, '9')}/{js_compare('', 0)}/{js_compare('x', 1)}/{js_compare({ type: 'bigint', value: '-1' }, -2)}" }
