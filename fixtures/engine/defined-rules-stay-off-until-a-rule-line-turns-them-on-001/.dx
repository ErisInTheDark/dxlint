
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        define {
          in .t match word /[a-z]+/
          in word rule quiet error "quiet {text}"
          in word rule shy warn "shy {text}"
          in word rule loud:a info "a"
          in word rule loud:b info "b"
        }
        rule loud:*
        rule shy
        rule shy hint
        rule quiet
        rule quiet off
        rule quiet
