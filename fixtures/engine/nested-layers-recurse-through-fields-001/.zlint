
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t, args match call name:/\w+/ args:args
        match args /\(/ until /\)/
        in call.name rule each-call warn "{text}"
