
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t, paren layer lines match line /^[ \t]*\S/ {
          rule with warn "{indented}" { indent in paren }
          rule without warn "{indented}"
        }
