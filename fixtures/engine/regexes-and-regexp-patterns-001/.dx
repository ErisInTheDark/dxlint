import .ts

        in ts_regex, ts_call, ts_new rule r info "{f.check}:{f.kind}@{f.offset}" {
          each f in regexp_findings.nonempty ?? []
        }
        in ts_call, ts_new rule e info "{ { value regexp_flags.nonempty ?? ''; regex_flags_error ([]); nonempty } ?? regexp_pattern_error }" {
          when regexp_pattern_error != null || { value regexp_flags.nonempty ?? ''; regex_flags_error ([]) } != null
        }
