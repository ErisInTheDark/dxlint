
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t match word /\b[a-z]+\b/ {
          rule ctx {
            when { value next_line.nonempty ?? ''; re_test "^end" } || previous_line == null
            warn "{text}|{before}|{after}|{re_replace(text, '([aeiou])', '<$1>')}"
          }
        }
