
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t match word /[a-z]+/ {
          rule long {
            let size len(text)
            let big size > 3
            when big
              && starts_with(text, "a")
              || text == "zz"
            warn "{size} letters"
          }
        }
