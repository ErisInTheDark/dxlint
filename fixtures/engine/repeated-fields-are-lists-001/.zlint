
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t match use /use \{/ item:/\w+/ (/, */ item:/\w+/)* /\}/ {
          rule sorted warn "sorted imports" fix as "use {{{ { value item; sort; join ', ' } }}}"
        }
