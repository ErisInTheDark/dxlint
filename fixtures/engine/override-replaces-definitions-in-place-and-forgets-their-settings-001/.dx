
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t match word /\b[a-z]+\b/
        in word rule shout warn "old {text}"
        rule shout error
        @macro twice(x) x x
        override in word rule shout info "new {@twice(text)}"
        override @macro twice(x) x "+" x
        in word rule echo warn "{@twice(text)}"
        override in .t match word /\b[a-z]{2}\b/
