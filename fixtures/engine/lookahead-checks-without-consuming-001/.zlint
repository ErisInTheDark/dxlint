
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t layer text match semi_line /;(?=[ \t]*\r?\n[ \t]*\S)/ {
          rule no-semi warn "semicolon before code" fix as ""
        }
