import .ts
in ts_identifier rule d {
  let sources value_sources(node)
  let sites walk(sources.sites ?? [], site => site_sources(node, site).sites ?? [])
  let doc first(map(sites, site => deprecation_doc(node, site)))
  when imported_name != null && doc != null
  info "{text}: {doc}"
}

# Project inputs remain readable, but the original Rust test linted only this main file.
ignore "a.ts"
ignore "index.ts"
