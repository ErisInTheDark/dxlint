lang js "*.ts"
native ts
group opener ts_open_paren, ts_open_bracket, ts_open_brace, ts_open_angle

                in .js layer lines match line /[^\n]+\n?/
                in line let ready { value overlapping(ts_if); count }
fn inner(n) = n.ready
fn outer(n) = inner(n)
                in line rule text info "text"
                in line rule dependent info "{outer(node)}" {
                    
                    fix as ""
                }
