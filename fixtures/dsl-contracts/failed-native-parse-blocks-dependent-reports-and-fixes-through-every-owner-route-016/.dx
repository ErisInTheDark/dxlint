lang js "*.ts"
native ts
group opener ts_open_paren, ts_open_bracket, ts_open_brace, ts_open_angle

                in .js layer lines match line /[^\n]+\n?/
                
                in line rule text info "text"
                in line rule dependent info "dependent" {
                    report at ({ value overlapping(ts_if); first }.offset.nonempty ?? offset)
                    fix as ""
                }
