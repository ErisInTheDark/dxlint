
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


            in .t match word /[a-z]+/ {
                rule shadows {
                    let stored 7
                    let result { value stored: stored + 1; then (value) value == stored }
                    when result && stored == 7
                    warn "scoped"
                }
            }
