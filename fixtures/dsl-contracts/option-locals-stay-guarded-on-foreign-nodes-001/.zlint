
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


            in .t match word /[a-z]+/ {
                rule guarded {
                    option limit number = 7
                    let policy { limit: limit }
                    when parent.policy != null
                      || previous.policy != null && previous.policy.limit != limit
                      || policy.limit != limit
                    warn "local escaped its target"
                }
            }
