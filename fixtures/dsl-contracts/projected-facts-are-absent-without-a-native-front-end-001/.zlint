
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


            in paren rule projections {
                when space_before != null || null != space_after
                  || !(space_before == null) || !(null == space_after)
                  || space_before.spaced != null
                warn "non-native projection differs"
            }
