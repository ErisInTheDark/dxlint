
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


        in .t match word /[a-z]+/ {
            rule point warn "point" {
                report at offset + 1
                fix as upper(text)
            }
        }
