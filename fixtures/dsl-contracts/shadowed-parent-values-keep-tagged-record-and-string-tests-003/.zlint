
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


                fn accepts(parent) = parent is word
                in .t match word /[a-z]+/ {
                    rule shadows {
                        let parent {node: node, kind: "paren"}
                        when !(parent is word) || !accepts("word") || !accepts({kind: "word"})
                          || !accepts({node: node, kind: "paren"})
                        warn "shadowed parent changed"
                    }
                }
