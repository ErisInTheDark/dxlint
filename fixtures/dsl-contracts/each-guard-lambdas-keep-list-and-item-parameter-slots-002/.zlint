
lang t "*.t"
match paren /\(/ until /\)/
in .t, paren {
  match paren
  match str /"/ until /"/ {
    match escape /\\./
  }
  match comment /\/\// until /$/
}


            in .t match word /[a-z]+/ {
                rule r {
                    each item in map([2, 3], number => number * 10)
                    when any([true], allowed => allowed)
                    when any([item], copy => copy == item)
                    info "{item}"
                }
            }
