import .ts
rule es-no-deprecated 
override in ts_node let no_deprecated_checked {
  value symbols: deprecation_symbols(node)
  value origins: map(symbols.sites, site => declaration_origin(node, site))
  value symbols.complete && all(origins, origin => origin != null)
    && !(symbols.name == "other" && any(origins, origin => origin.kind == "project"))
}
