import .ts
rule only-throw-error 
override in ts_node let only_throw_error_checked !{ value type_specifier_groups; all (group) any(group, gate => gate.name == 'Allowed' && gate.from == 'file' && ends_with(gate.path, 'main.ts')) }

# Project inputs remain readable, but the original Rust test linted only this main file.
ignore "node_modules/typescript/lib/lib.es5.d.ts"
ignore "tsconfig.json"
