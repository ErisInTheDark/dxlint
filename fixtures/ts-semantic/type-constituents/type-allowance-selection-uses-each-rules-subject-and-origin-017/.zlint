import .ts
rule no-misused-spread 
override in ts_spread, ts_jsx_spread_attribute let no_misused_spread_checked type_value_allowed([{from: "file", name: "Allowed", path: "main.ts"}], argument.node) == false

# Project inputs remain readable, but the original Rust test linted only this main file.
ignore "node_modules/typescript/lib/lib.es5.d.ts"
ignore "tsconfig.json"
