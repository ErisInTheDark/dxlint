import .ts

            in ts_program rule custom-naming {
                let failure naming_failure("IS_ready", false, {
                    formats: ["camelCase", "UPPER_CASE"], leadingUnderscore: "allow",
                    trailingUnderscore: "allow", prefix: ["IS_"]
                })
                when failure != null
                warn naming_message("IS_ready", failure)
            }
