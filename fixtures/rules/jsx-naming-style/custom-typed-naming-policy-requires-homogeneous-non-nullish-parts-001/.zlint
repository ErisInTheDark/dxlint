import .ts

        fn boolean_domain(n) = {
            value parts: value_constituents(n)
            value present: filter(parts ?? [], arm => !any(arm, part =>
                contains(part.traits, "null") || contains(part.traits, "undefined")))
            value count(present) > 0 && all(present, arm => {
                value concrete: filter(arm, part => !contains(part.traits, "parameter"))
                value count(concrete) == 1 && contains(first(concrete).traits, "boolean")
            })
        }
        in ts_identifier rule boolean-names {
            when naming_context == "variable" && boolean_domain(node)
            let failure naming_failure(naming_name, false, { formats: ["UPPER_CASE"], prefix: ["IS_"] })
            when failure != null
            warn naming_message(naming_name, failure)
        }
