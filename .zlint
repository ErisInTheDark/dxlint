# zoomie-lint lints itself with this file.

import .rs
import .zlint
import .md
import .toml

# Examples are deliberately broken; they have their own configs.
ignore "examples"
ignore "fixtures"

# Hygiene everywhere. Long lines are a judgement call here, not a rule.
rule trailing-whitespace
rule tab-indent
rule blank-lines
rule final-newline

# ---- rust ---------------------------------------------------------------

in rs_code {
  match rs_dbg /\bdbg!/ {
    rule no-dbg error "remove `dbg!` before committing"
  }
  match rs_unfinished /\b(?:todo|unimplemented)!/ {
    rule no-unfinished error "`{text}` panics at runtime; finish this code"
  }
}

# Test modules are a layer, so rules can ask whether they are inside one.
in .rust, braces match rs_test_module /#\[cfg\(test\)\]\s*mod\s+\w+\s*/ body:braces
in rs_code match rs_unwrap /\.unwrap\(\)/ {
  rule no-unwrap {
    when rs_test_module == null
    warn "`.unwrap()` outside tests; use `?` or `.expect(\"why\")`"
    ignore "tests.rs" "tests/**"
  }
}

# `.zlintcache` reuses a result while everything its lint read is unchanged,
# so native code must read the filesystem through the one door that records it.
in rs_code match rs_filesystem /\bstd::fs\b|\bfs::\w+|\.(?:is_file|is_dir|exists|metadata)\(\)|\bread_dir\b|\bWalkBuilder\b/ {
  rule native-reads-through-door error "native code reads the filesystem through `reads.rs`, which records the read for the cache" {
    files "src/native/**"
    ignore "src/native/ts/reads.rs" "src/native/ts/tests.rs"
  }
}

in rs_code match rs_function /\bfn[ \t]+/ name:identifier
in rs_function.name rule fn-snake-case warn "function names are snake_case" fix as snake_case(text)

in rs_line_comment, rs_block_comment match todo_note /\b(?:TODO|FIXME|XXX)\b/ {
  rule todo-comment info "{text} left in a comment"
}

# ---- zlint --------------------------------------------------------------

in zlint_code {
  # Globs (`rule rs-*`) are not names.
  match zlint_rule /\brule[ \t]+/ name:/[\w-]+(?![\w*-])/
  match zlint_matcher /\bmatch[ \t]+/ name:/\w+/
}
in zlint_rule.name rule rule-names warn "rule names are kebab-case" fix as kebab_case(text)
in zlint_matcher.name rule matcher-names warn "matcher names are snake_case" fix as snake_case(text)
